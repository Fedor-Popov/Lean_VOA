import VOA.AffineGeneral.RootSpaceSimple
import VOA.Moonshine.LatticeMorphRigid
import VOA.Moonshine.LatticeGradedDim
import VOA.Moonshine.TrialitySl2

/-!
# The weight-one Lie algebra of a lattice VOA is simple

For an even positive-definite lattice `L` whose roots (`⟨α,α⟩ = 2`) are generated by a connected
family of simple roots, the Lie algebra `(V_L)₁` (bracket `u₍₀₎v`) is simple
(`isSimple_of_simpleRoots`).  The proof checks the hypotheses of the abstract root-space criterion
`RootSpace.isSimple_of_roots` with

* root vectors `eV β = e^β` and coroots `hV β = β(-1)𝟙` (`β` a root);
* `⁅hV α, eV β⁆ = ⟨α,β⟩ eV β` (`smul_hSt_zero_latStateGen`), `⁅hV α, hV β⁆ = 0`,
  `⁅eV α, eV (-α)⁆ = ε(α,-α) hV α` (`Qscr_latChargeGen_neg`);
* spanning: `(V_L)₁ = (Fock)₁ ⊗ e⁰ ⊕ ⨁_{roots} ℂ e^α`, and `(Fock)₁` is spanned by the
  `h_a(-1)𝟙`, which lie in the span of the root `hSt`s (`gradingLatGen_one_le`);
* the center condition from invertibility of the orthonormal frame (`chargeCoord_dual_eq_zero`).
-/

namespace VOA.AffineGeneral.LatticeLie

open VOA VOA.LatGen VOA.LatGen.Screen VOA.IntegralLattice HeisenbergN MvPolynomial Submodule
open scoped Matrix

noncomputable section

variable (L : IntegralLattice) (hEven : L.Even) (hPos : L.PosDef)

theorem form_comm (v w : L.carrier) : L.form v w = L.form w v :=
  LinearMap.BilinForm.isSymm_def.mp L.isSymm v w

/-- The roots of `L`, as a finite type. -/
abbrev Root : Type _ := ↥(normEq L hPos 2)

variable {L hPos} in
theorem root_form (β : Root L hPos) : L.form β.1 β.1 = 2 := (mem_normEq L hPos).mp β.2

/-- The negative of a root. -/
def Root.neg (β : Root L hPos) : Root L hPos :=
  ⟨-β.1, (mem_normEq L hPos).mpr (by simp [root_form β])⟩

/-! ## Weight-one states -/

theorem heisSt_mem_gradingLatGen (a : Fin (rank L)) : heisSt L a ∈ gradingLatGen L 1 := by
  have hX : (X ((0 : ℕ), a) : FockN (rank L)) ∈ gradingZN (rank L) (1 - halfNorm L 0) := by
    rw [halfNorm_zero, sub_zero, gradingZN_of_nonneg (by norm_num)]
    show IsWeightedHomogeneous weightFnN (X ((0 : ℕ), a)) 1
    have := isWeightedHomogeneous_X ℂ weightFnN ((0 : ℕ), a)
    rwa [weightFnN_apply] at this
  have hb : heisSt L a ∈ bigradα L (1 - halfNorm L 0, 0) := by
    refine ⟨X ((0 : ℕ), a), hX, ?_⟩
    rw [heisSt, wordStateLatGen_eq, wordStateN_cons, wordStateN_nil, mul_one, mkEα_apply]
  exact (le_iSup (fun α => bigradα L ((1 : ℤ) - halfNorm L α, α)) 0) hb

theorem hSt_mem_gradingLatGen (α : L.carrier) : hSt L α ∈ gradingLatGen L 1 := by
  rw [hSt_eq_sum]
  exact sum_mem fun a _ => smul_mem _ _ (heisSt_mem_gradingLatGen L a)

/-- The weight-one Lie algebra `(V_L)₁`. -/
abbrev V1 : Type _ := ↥((latticeVOAGen L hEven hPos).grading 1)

/-- The root vector `e^β`. -/
def eV (β : Root L hPos) : V1 L hEven hPos :=
  ⟨latChargeGen L β.1, latChargeGen_mem_grading_one L hEven hPos (root_form β)⟩

/-- The coroot `β(-1)𝟙`. -/
def hV (β : Root L hPos) : V1 L hEven hPos :=
  ⟨hSt L β.1, hSt_mem_gradingLatGen L β.1⟩

/-! ## Brackets -/

theorem hV_eV (α β : Root L hPos) :
    ⁅hV L hEven hPos α, eV L hEven hPos β⁆ = ((L.form α.1 β.1 : ℤ) : ℂ) • eV L hEven hPos β := by
  apply Subtype.ext
  show (latticeVOAGen L hEven hPos).smul (hSt L α.1) 0 (latStateGen L (vacuumN (rank L)) β.1) = _
  rw [smul_hSt_zero_latStateGen]
  rfl

theorem hV_hV (α β : Root L hPos) : ⁅hV L hEven hPos α, hV L hEven hPos β⁆ = 0 := by
  apply Subtype.ext
  show (latticeVOAGen L hEven hPos).smul (hSt L α.1) 0 (latStateGen L (vSchur L β.1 1) 0) = 0
  rw [smul_hSt_zero_latStateGen, map_zero, Int.cast_zero, zero_smul]

theorem eV_eV_neg (α : Root L hPos) :
    ⁅eV L hEven hPos α, eV L hEven hPos (Root.neg L hPos α)⁆
      = latticeCocycle L α.1 (-α.1) • hV L hEven hPos α := by
  apply Subtype.ext
  show mode (YfullGen L hEven hPos (latChargeGen L α.1)) 0 (latChargeGen L (-α.1)) = _
  rw [← Qscr_eq_mode_YfullGen L hEven hPos, Qscr_latChargeGen_neg L (root_form α)]
  rfl

theorem eV_ne_zero (β : Root L hPos) : eV L hEven hPos β ≠ 0 := by
  intro h
  have := congrArg Subtype.val h
  exact Screen.latStateGen_ne_zero L one_ne_zero β.1 this

/-! ## Generation by roots -/

/-- The roots generate `L`. -/
def RootsGenerate : Prop := AddSubgroup.closure {v : L.carrier | L.form v v = 2} = ⊤

variable {L hPos}

theorem closure_induction' (hgen : RootsGenerate L) {p : L.carrier → Prop}
    (root : ∀ v, L.form v v = 2 → p v) (zero : p 0) (add : ∀ v w, p v → p w → p (v + w))
    (neg : ∀ v, p v → p (-v)) (v : L.carrier) : p v := by
  have hv : v ∈ AddSubgroup.closure {v : L.carrier | L.form v v = 2} := by
    rw [hgen]; exact AddSubgroup.mem_top v
  induction hv using AddSubgroup.closure_induction with
  | mem x hx => exact root x hx
  | zero => exact zero
  | add x y _ _ hx hy => exact add x y hx hy
  | neg x _ hx => exact neg x hx

theorem hSt_mem_span_roots (hgen : RootsGenerate L) (α : L.carrier) :
    hSt L α ∈ span ℂ (Set.range fun β : Root L hPos => hSt L β.1) := by
  refine closure_induction' hgen (p := fun α => hSt L α ∈ span ℂ _) ?_ ?_ ?_ ?_ α
  · intro v hv
    exact subset_span ⟨⟨v, (mem_normEq L hPos).mpr hv⟩, rfl⟩
  · show hSt L 0 ∈ _; rw [hSt_zero]; exact zero_mem _
  · intro v w hv hw; show hSt L (v + w) ∈ _; rw [hSt_add]; exact add_mem hv hw
  · intro v hv; show hSt L (-v) ∈ _; rw [hSt_neg]; exact neg_mem hv

theorem form_eq_zero_of_roots (hPos : L.PosDef) (hgen : RootsGenerate L) {x : L.carrier}
    (h : ∀ v, L.form v v = 2 → L.form v x = 0) : x = 0 := by
  have hall : ∀ v, L.form v x = 0 := closure_induction' hgen h (by simp)
    (fun v w hv hw => by simp [hv, hw]) (fun v hv => by simp [hv])
  by_contra hx
  have := hPos x hx
  rw [hall x] at this
  exact lt_irrefl 0 this

/-! ## Spanning -/

variable (L hPos)

theorem gradingWN_one_le :
    gradingWN (rank L) 1 ≤ span ℂ (Set.range fun a : Fin (rank L) => (X ((0 : ℕ), a) : FockN (rank L))) := by
  intro p hp
  have hp' : p ∈ Finsupp.supported ℂ ℂ {d : (ℕ × Fin (rank L)) →₀ ℕ | Finsupp.weight weightFnN d = 1} := by
    rw [← weightedHomogeneousSubmodule_eq_finsupp_supported]; exact hp
  rw [Finsupp.supported_eq_span_single] at hp'
  refine (span_le.mpr ?_) hp'
  rintro _ ⟨d, hd, rfl⟩
  obtain ⟨a, rfl⟩ := weight_eq_one (rank L) d hd
  exact subset_span ⟨a, rfl⟩

variable {L hPos}

include hEven in
theorem gradingLatGen_one_le (hgen : RootsGenerate L) :
    gradingLatGen L 1 ≤ span ℂ (Set.range (fun β : Root L hPos => latChargeGen L β.1) ∪
      Set.range (fun β : Root L hPos => hSt L β.1)) := by
  refine iSup_le fun α => ?_
  by_cases h0 : α = 0
  · subst h0
    rw [halfNorm_zero, sub_zero]
    rintro _ ⟨p, hp, rfl⟩
    rw [gradingZN_of_nonneg (by norm_num)] at hp
    have hp1 := gradingWN_one_le L (show p ∈ gradingWN (rank L) 1 from hp)
    have hle : span ℂ (Set.range fun a : Fin (rank L) => (X ((0 : ℕ), a) : FockN (rank L))) ≤
        (span ℂ (Set.range (fun β : Root L hPos => latChargeGen L β.1) ∪
          Set.range (fun β : Root L hPos => hSt L β.1))).comap (mkEα L 0) := by
      rw [span_le]
      rintro _ ⟨a, rfl⟩
      rw [SetLike.mem_coe, mem_comap]
      have : mkEα L 0 (X ((0 : ℕ), a)) = heisSt L a := by
        rw [heisSt, wordStateLatGen_eq, wordStateN_cons, wordStateN_nil, mul_one, mkEα_apply]
      rw [this]
      refine span_mono Set.subset_union_right ?_
      have hle2 : span ℂ (Set.range (hSt L)) ≤ span ℂ (Set.range fun β : Root L hPos => hSt L β.1) := by
        rw [span_le]
        rintro _ ⟨γ, rfl⟩
        exact hSt_mem_span_roots hgen γ
      exact hle2 (heisSt_mem_span_hSt L hPos a)
    exact hle hp1
  · have hpos := halfNorm_pos L hEven hPos h0
    by_cases h1 : halfNorm L α = 1
    · have hroot : L.form α α = 2 := by rw [← two_halfNorm L hEven, h1]; rfl
      rw [h1, sub_self]
      rintro _ ⟨p, hp, rfl⟩
      rw [gradingZN_of_nonneg le_rfl, show (0 : ℤ).toNat = 0 from rfl,
        gradingWN_zero_eq_span_one, SetLike.mem_coe, mem_span_singleton] at hp
      obtain ⟨c, rfl⟩ := hp
      rw [map_smul]
      refine smul_mem _ _ (subset_span (Or.inl ⟨⟨α, (mem_normEq L hPos).mpr hroot⟩, ?_⟩))
      rw [mkEα_apply]; rfl
    · rw [bigradα_eq_bot_of_neg L α (by omega)]; exact bot_le

include hEven in
/-- **`e^β` and `β(-1)𝟙` (`β` a root) span `(V_L)₁`.** -/
theorem span_eV_hV (hgen : RootsGenerate L) :
    span ℂ (Set.range (eV L hEven hPos) ∪ Set.range (hV L hEven hPos)) = ⊤ := by
  apply Submodule.map_injective_of_injective ((latticeVOAGen L hEven hPos).grading 1).injective_subtype
  rw [Submodule.map_subtype_top, Submodule.map_span, Set.image_union, ← Set.range_comp,
    ← Set.range_comp]
  apply le_antisymm
  · rw [span_le]
    rintro _ (⟨β, rfl⟩ | ⟨β, rfl⟩)
    · exact (eV L hEven hPos β).2
    · exact (hV L hEven hPos β).2
  · exact gradingLatGen_one_le hEven hgen

include hEven in
/-- `(V_L)₁` is finite-dimensional (spanned by finitely many `e^β`, `β(-1)𝟙`). -/
theorem finiteDimensional_V1 (hgen : RootsGenerate L) : FiniteDimensional ℂ (V1 L hEven hPos) :=
  Module.finite_def.mpr (Submodule.fg_def.mpr
    ⟨_, (Set.finite_range _).union (Set.finite_range _), span_eV_hV hEven hgen⟩)

/-! ## The center condition -/

/-- The charge coordinates of `L` separate linear functionals: if `∑ₐ wₐ cc(β)ₐ = 0` for every
`β ∈ L` then `w = 0` (the orthonormal frame is invertible). -/
theorem chargeCoord_dual_eq_zero (L : IntegralLattice) (hPos : L.PosDef) (w : Fin (rank L) → ℂ)
    (h : ∀ β : L.carrier, ∑ a, w a * chargeCoord L β a = 0) : w = 0 := by
  classical
  set F : Matrix (Fin (latRank L)) (Fin (latRank L)) ℂ := (frame L).map Complex.ofRealHom
  have hF : IsUnit F.det := by
    rw [show F.det = Complex.ofRealHom (frame L).det from (RingHom.map_det _ _).symm]
    exact (frame_det_isUnit L hPos).map _
  have hcc : ∀ (i : Fin (latRank L)) (b : Fin (rank L)),
      chargeCoord L (latticeBasis L i) b = F (rankEquiv L b) i := by
    intro i b
    rw [chargeCoord, orthCoord, coordR_basis]
    simp [F, Matrix.mulVec, dotProduct, Pi.single_apply]
  set w' : Fin (latRank L) → ℂ := fun j => w ((rankEquiv L).symm j)
  have hv : w' ᵥ* F = 0 := by
    funext i
    have := h (latticeBasis L i)
    simp only [hcc] at this
    rw [Matrix.vecMul, dotProduct, Pi.zero_apply, ← this]
    rw [← (rankEquiv L).sum_comp (fun j => w' j * F j i)]
    simp [w']
  have hw' : w' = 0 := by
    have := congrArg (fun v => v ᵥ* F⁻¹) hv
    simpa [Matrix.vecMul_vecMul, Matrix.mul_nonsing_inv _ hF] using this
  funext b
  have := congrFun hw' (rankEquiv L b)
  simpa [w'] using this

theorem center_hV (hgen : RootsGenerate L) (y : V1 L hEven hPos)
    (hy : y ∈ span ℂ (Set.range (hV L hEven hPos)))
    (h : ∀ β, ⁅y, eV L hEven hPos β⁆ = 0) : y = 0 := by
  classical
  obtain ⟨c, rfl⟩ := (mem_span_range_iff_exists_fun ℂ).mp hy
  set w : Fin (rank L) → ℂ := fun a => ∑ γ, c γ * chargeCoord L γ.1 a with hwdef
  have hpair : ∀ β : L.carrier,
      ∑ a, w a * chargeCoord L β a = ∑ γ, c γ * ((L.form γ.1 β : ℤ) : ℂ) := by
    intro β
    simp only [w, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun γ _ => ?_
    rw [← sum_chargeCoord L hPos, Finset.mul_sum]
    exact Finset.sum_congr rfl fun a _ => by ring
  have hroot : ∀ β : Root L hPos, ∑ a, w a * chargeCoord L β.1 a = 0 := by
    intro β
    have hb := h β
    rw [sum_lie] at hb
    simp only [smul_lie, hV_eV, smul_smul] at hb
    rw [← Finset.sum_smul] at hb
    rw [hpair]
    exact (smul_eq_zero.mp hb).resolve_right (eV_ne_zero L hEven hPos β)
  have hall : ∀ β : L.carrier, ∑ a, w a * chargeCoord L β a = 0 := by
    refine closure_induction' hgen ?_ ?_ ?_ ?_
    · intro v hv; exact hroot ⟨v, (mem_normEq L hPos).mpr hv⟩
    · simp [chargeCoord_zero]
    · intro v w' hv hw
      simp only [chargeCoord_add, mul_add, Finset.sum_add_distrib, hv, hw, add_zero]
    · intro v hv
      simp only [WpC2.chargeCoord_neg', mul_neg, Finset.sum_neg_distrib, hv, neg_zero]
  have hw0 := chargeCoord_dual_eq_zero L hPos w hall
  apply Subtype.ext
  rw [Submodule.coe_sum, ZeroMemClass.coe_zero]
  simp only [Submodule.coe_smul, hV, hSt_eq_sum, Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun a _ => ?_
  rw [← Finset.sum_smul]
  have : ∑ γ : Root L hPos, c γ * chargeCoord L γ.1 a = 0 := congrFun hw0 a
  rw [this, zero_smul]

/-! ## Separation and connectivity -/

theorem sep_roots (hgen : RootsGenerate L) (α β : Root L hPos) (hne : α ≠ β) :
    ∃ γ : Root L hPos, ((L.form γ.1 α.1 : ℤ) : ℂ) ≠ ((L.form γ.1 β.1 : ℤ) : ℂ) := by
  by_contra hcon
  push Not at hcon
  apply hne
  have : α.1 - β.1 = 0 := form_eq_zero_of_roots hPos hgen fun v hv => by
    have := hcon ⟨v, (mem_normEq L hPos).mpr hv⟩
    rw [map_sub, sub_eq_zero]
    exact_mod_cast this
  exact Subtype.ext (sub_eq_zero.mp this)

theorem rootsGenerate_of_simple {ι : Type*} (s : ι → Root L hPos)
    (hsgen : AddSubgroup.closure (Set.range fun i => (s i).1) = ⊤) : RootsGenerate L := by
  rw [RootsGenerate, eq_top_iff, ← hsgen]
  apply AddSubgroup.closure_mono
  rintro _ ⟨i, rfl⟩
  exact root_form (s i)

theorem conn_of_simple {ι : Type*} (s : ι → Root L hPos)
    (hsgen : AddSubgroup.closure (Set.range fun i => (s i).1) = ⊤)
    (hsconn : ∀ i j, Relation.ReflTransGen (fun i j => L.form (s i).1 (s j).1 ≠ 0) i j)
    (α β : Root L hPos) :
    Relation.ReflTransGen (fun a b : Root L hPos => ((L.form a.1 b.1 : ℤ) : ℂ) ≠ 0) α β := by
  have hadj : ∀ γ : Root L hPos, ∃ i, L.form γ.1 (s i).1 ≠ 0 := by
    intro γ
    by_contra hcon
    push Not at hcon
    have hall : ∀ v, L.form γ.1 v = 0 := by
      intro v
      have hv : v ∈ AddSubgroup.closure (Set.range fun i => (s i).1) := by
        rw [hsgen]; exact AddSubgroup.mem_top v
      induction hv using AddSubgroup.closure_induction with
      | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hcon i
      | zero => simp
      | add x y _ _ hx hy => simp [hx, hy]
      | neg x _ hx => simp [hx]
    have := hall γ.1
    rw [root_form γ] at this
    exact two_ne_zero this
  obtain ⟨i, hi⟩ := hadj α
  obtain ⟨j, hj⟩ := hadj β
  have hmid : Relation.ReflTransGen (fun a b : Root L hPos => ((L.form a.1 b.1 : ℤ) : ℂ) ≠ 0)
      (s i) (s j) :=
    Relation.ReflTransGen.lift s (fun a b h => by exact_mod_cast h) (hsconn i j)
  have h1 : ((L.form α.1 (s i).1 : ℤ) : ℂ) ≠ 0 := by exact_mod_cast hi
  have h3 : ((L.form (s j).1 β.1 : ℤ) : ℂ) ≠ 0 := by rw [form_comm]; exact_mod_cast hj
  exact Relation.ReflTransGen.head h1 (Relation.ReflTransGen.tail hmid h3)

/-! ## Dimension -/

variable (L hPos) in
theorem normEq_zero : normEq L hPos 0 = {0} := by
  ext α
  rw [mem_normEq, Finset.mem_singleton]
  constructor
  · intro h
    by_contra hα
    have := hPos α hα
    omega
  · rintro rfl
    simp

include hEven in
/-- **`dim (V_L)₁ = rank L + #roots`.** -/
theorem finrank_V1 : Module.finrank ℂ (V1 L hEven hPos) = rank L + (normEq L hPos 2).card := by
  have h := finrank_gradingLatGen_eq_sum_theta L hPos hEven 1
  rw [Finset.sum_range_succ, Finset.sum_range_one] at h
  simp only [mul_one, Nat.sub_zero, Nat.sub_self, fockCount_zero, fockCount_one] at h
  change Module.finrank ℂ (gradingLatGen L ((1 : ℕ) : ℤ)) = _
  rw [h, show (2 * ((0 : ℕ) : ℤ)) = 0 by norm_num, show (2 * ((1 : ℕ) : ℤ)) = 2 by norm_num,
    normEq_zero, Finset.card_singleton, one_mul]

/-! ## The theorem -/

/-- **`(V_L)₁` is a simple Lie algebra** when the roots of `L` contain a connected generating family
of simple roots. -/
theorem isSimple_of_simpleRoots {ι : Type*} [Nonempty ι] (s : ι → Root L hPos)
    (hsgen : AddSubgroup.closure (Set.range fun i => (s i).1) = ⊤)
    (hsconn : ∀ i j, Relation.ReflTransGen (fun i j => L.form (s i).1 (s j).1 ≠ 0) i j) :
    LieAlgebra.IsSimple ℂ (V1 L hEven hPos) := by
  classical
  have hgen := rootsGenerate_of_simple s hsgen
  haveI : Nonempty (Root L hPos) := ⟨s (Classical.arbitrary ι)⟩
  exact RootSpace.isSimple_of_roots (eV L hEven hPos) (hV L hEven hPos)
    (fun α β => ((L.form α.1 β.1 : ℤ) : ℂ))
    (span_eV_hV hEven hgen) (eV_ne_zero L hEven hPos) (hV_eV L hEven hPos) (hV_hV L hEven hPos)
    (fun α => by simp [root_form α]) (sep_roots hgen) (Root.neg L hPos)
    (fun α => ⟨_, LatGen.latticeCocycle_ne_zero L _ _, eV_eV_neg L hEven hPos α⟩)
    (center_hV hEven hgen) (conn_of_simple s hsgen hsconn)

end

end VOA.AffineGeneral.LatticeLie
