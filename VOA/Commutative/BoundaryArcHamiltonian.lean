import VOA.Commutative.BoundaryAuxiliaryInitial
import VOA.Commutative.InfiniteJetHamiltonianLaws

/-!
# Intrinsic boundary-arc Hamiltonians

The standard sl2 Poisson brackets define actual polynomial derivations. They preserve
the Casimir and the ideal generated by e Q^m, h Q^m, f Q^m. Their shifted prolongations
therefore act directly on the corresponding represented arc algebra.
-/
namespace VOA.BoundaryAuxiliary
noncomputable section
variable {R : Type*} [CommRing R]

/-- The standard sl2 Lie--Poisson bracket table in coordinate order e,h,f. -/
def currentPoissonBracket (i j : Fin 3) : BasePoly R :=
  ![![0, -2 * MvPolynomial.X 0, MvPolynomial.X 1],
    ![2 * MvPolynomial.X 0, 0, -2 * MvPolynomial.X 2],
    ![-MvPolynomial.X 1, 2 * MvPolynomial.X 2, 0]] i j

/-- The three intrinsic Hamiltonian derivations of the polynomial base algebra. -/
def currentHamiltonian (i : Fin 3) : Derivation R (BasePoly R) (BasePoly R) :=
  MvPolynomial.mkDerivation R (currentPoissonBracket (R := R) i)

@[simp] theorem currentHamiltonian_X (i j : Fin 3) :
    currentHamiltonian (R := R) i (MvPolynomial.X j) = currentPoissonBracket i j := by
  simp [currentHamiltonian]

/-- The quadratic Casimir is invariant under all three actual Hamiltonians. -/
theorem currentHamiltonian_casimir (i : Fin 3) :
    currentHamiltonian (R := R) i casimir = 0 := by
  have hc : ∀ i, currentHamiltonian (R := R) i (4 : BasePoly R) = 0 :=
    fun i => Derivation.map_natCast _ 4
  fin_cases i <;>
    simp [casimir, hc, Derivation.leibniz, Derivation.leibniz_pow, currentPoissonBracket,
      smul_eq_mul, currentHamiltonian_X] <;> ring

/-- On the defining relations, the invariant Casimir factor is unchanged. -/
theorem currentHamiltonian_baseRelation (m : ℕ) (i j : Fin 3) :
    currentHamiltonian (R := R) i (baseRelation m j) =
      currentPoissonBracket i j * casimir^m := by
  simp [baseRelation, Derivation.leibniz, Derivation.leibniz_pow,
    currentHamiltonian_casimir, currentHamiltonian_X, smul_zero, zero_add, smul_eq_mul, mul_comm]

/-- The true boundary base ideal is Poisson stable in every sl2 generator direction. -/
theorem currentHamiltonian_baseIdeal_stable (m : ℕ) (i : Fin 3) :
    ∀ f ∈ baseIdeal (R := R) m, currentHamiltonian i f ∈ baseIdeal m := by
  intro f hf
  induction hf using Submodule.span_induction with
  | mem f hf =>
      obtain ⟨j,rfl⟩ := hf
      rw [currentHamiltonian_baseRelation]
      have hgen : ∀ k : Fin 3, baseRelation (R := R) m k ∈ baseIdeal m :=
        fun k => Ideal.subset_span ⟨k,rfl⟩
      fin_cases i <;> fin_cases j
      · simpa [currentPoissonBracket] using (baseIdeal (R := R) m).zero_mem
      · convert (baseIdeal (R := R) m).mul_mem_left (-2) (hgen 0) using 1 <;>
          simp [currentPoissonBracket,baseRelation,mul_assoc]
      · simpa [currentPoissonBracket,baseRelation] using hgen 1
      · convert (baseIdeal (R := R) m).mul_mem_left 2 (hgen 0) using 1 <;>
          simp [currentPoissonBracket,baseRelation,mul_assoc]
      · simpa [currentPoissonBracket] using (baseIdeal (R := R) m).zero_mem
      · convert (baseIdeal (R := R) m).mul_mem_left (-2) (hgen 2) using 1 <;>
          simp [currentPoissonBracket,baseRelation,mul_assoc]
      · simpa [currentPoissonBracket,baseRelation] using (baseIdeal (R := R) m).neg_mem (hgen 1)
      · convert (baseIdeal (R := R) m).mul_mem_left 2 (hgen 2) using 1 <;>
          simp [currentPoissonBracket,baseRelation,mul_assoc]
      · simpa [currentPoissonBracket] using (baseIdeal (R := R) m).zero_mem
  | zero => rw [map_zero]; exact Ideal.zero_mem _
  | add f g _ _ hf hg => rw [map_add]; exact Ideal.add_mem _ hf hg
  | smul a f hf hDf =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hDf) (Ideal.mul_mem_right _ _ hf)

/-- Canonical nonnegative Hamiltonian modes on the genuine boundary arc algebra. -/
def arcCurrentHamiltonian (m : ℕ) (i : Fin 3) (n : ℕ) :
    Derivation R (VOA.InfiniteJet.PresentedJet (baseIdeal (R := R) m))
      (VOA.InfiniteJet.PresentedJet (baseIdeal (R := R) m)) :=
  VOA.InfiniteJet.prolongation (currentHamiltonian i) (baseIdeal m)
    (currentHamiltonian_baseIdeal_stable m i) n

end
end VOA.BoundaryAuxiliary
