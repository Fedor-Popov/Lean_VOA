import VOA.Commutative.CollisionCommonFactors
import Mathlib.LinearAlgebra.StdBasis

/-!
# The two-point carrier of quadratic current relations

In a tensor basis adapted to exchange symmetry, the two-current carrier has
three kinds of coordinates: Cartan-product coordinates are symmetric,
exterior-square coordinates are antisymmetric, and quadratic-relation
coordinates are symmetric and vanish on the collision diagonal.

Over the ring fixed by exchanging the two roots, these coordinates are
respectively a free copy generated by `1`, the root difference, and its square.
The proofs work with arbitrary spectator variables. They retain the second-order
collision condition; no reduced-point replacement is made.

This is the commutative-algebra part of the Deligne two-point calculation.
Identifying the three tensor summands for a particular Lie algebra and comparing
with its fusion module are separate tasks.
-/

namespace VOA.QuadraticTwoPointCarrier

open VOA.CollisionCommonFactors

noncomputable section

universe u v w

variable {K : Type u} [Field K] [CharZero K]
variable {I : Type v} [DecidableEq I]

/-- The three tensor-coordinate types in the two-current calculation. -/
inductive ComponentKind
  | cartan
  | alternating
  | relation
  deriving DecidableEq

/-- The required order of the root difference in each tensor component. -/
def ComponentKind.order : ComponentKind → ℕ
  | .cartan => 0
  | .alternating => 1
  | .relation => 2

/-- Scalar polynomials invariant under exchanging the colliding pair. All
spectator variables remain available as coefficients. -/
def pairScalars (i j : I) : Subalgebra K (MvPolynomial I K) :=
  AlgHom.equalizer (swapVariables (K := K) i j) (AlgHom.id K _)

omit [CharZero K] in
@[simp]
theorem mem_pairScalars (i j : I) (p : MvPolynomial I K) :
    p ∈ pairScalars (K := K) i j ↔ swapVariables (K := K) i j p = p :=
  Iff.rfl

/-- A tensor coordinate has the exchange parity of its kind. Only the
quadratic-relation component is additionally required to vanish on the diagonal. -/
def componentCarrier (i j : I) (hji : j ≠ i) (kind : ComponentKind) :
    Submodule (pairScalars (K := K) i j) (MvPolynomial I K) where
  carrier := {p | swapVariables (K := K) i j p = (-1) ^ kind.order * p ∧
    (kind = .relation → collisionMap (K := K) i j hji p = 0)}
  zero_mem' := by simp
  add_mem' := by
    intro p q hp hq
    constructor
    · simp only [map_add, hp.1, hq.1, mul_add]
    · intro hk
      simp only [map_add, hp.2 hk, hq.2 hk, add_zero]
  smul_mem' := by
    intro r p hp
    change swapVariables (K := K) i j ((r : MvPolynomial I K) * p) =
        (-1) ^ kind.order * ((r : MvPolynomial I K) * p) ∧ _
    constructor
    · have hr : swapVariables (K := K) i j (r : MvPolynomial I K) = r := r.property
      rw [map_mul, hr, hp.1]
      ring
    · intro hk
      change collisionMap (K := K) i j hji ((r : MvPolynomial I K) * p) = 0
      rw [map_mul, hp.2 hk, mul_zero]

/-- Antisymmetry forces first-order diagonal vanishing in characteristic zero. -/
theorem collisionMap_eq_zero_of_antisymmetric (i j : I) (hji : j ≠ i)
    (p : MvPolynomial I K) (hp : swapVariables (K := K) i j p = -p) :
    collisionMap (K := K) i j hji p = 0 := by
  have heq := congrArg (collisionMap (K := K) i j hji) hp
  rw [collisionMap_swapVariables, map_neg] at heq
  have htwo : (2 : K) • collisionMap (K := K) i j hji p = 0 := by
    rw [two_smul K]
    exact add_eq_zero_iff_eq_neg.mpr heq
  exact (smul_eq_zero.mp htwo).resolve_left (by norm_num)

/-- Every carrier coordinate has its prescribed collision divisor. -/
theorem collisionFactor_pow_dvd_of_mem (i j : I) (hji : j ≠ i)
    (kind : ComponentKind) (p : MvPolynomial I K)
    (hp : p ∈ componentCarrier (K := K) i j hji kind) :
    collisionFactor (K := K) i j ^ kind.order ∣ p := by
  obtain ⟨hswap, hdiag⟩ := hp
  cases kind with
  | cartan => simp [ComponentKind.order]
  | alternating =>
      simp only [ComponentKind.order, pow_one, neg_one_mul] at hswap ⊢
      exact (collisionFactor_dvd_iff i j hji p).mpr
        (collisionMap_eq_zero_of_antisymmetric i j hji p hswap)
  | relation =>
      apply collisionFactor_sq_dvd_of_swap_invariant i j hji p
      · simpa [ComponentKind.order] using hswap
      · exact hdiag rfl

omit [CharZero K] in
/-- Dividing a coordinate by the collision factor of its prescribed order leaves
an exchange-invariant scalar. -/
theorem quotient_mem_pairScalars (i j : I) (hji : j ≠ i)
    (kind : ComponentKind) (p q : MvPolynomial I K)
    (hp : p ∈ componentCarrier (K := K) i j hji kind)
    (hfac : p = collisionFactor (K := K) i j ^ kind.order * q) :
    q ∈ pairScalars (K := K) i j := by
  have heq := hp.1
  rw [hfac, map_mul, map_pow, swapVariables_collisionFactor, neg_pow] at heq
  apply mul_left_cancel₀
    (mul_ne_zero (pow_ne_zero kind.order (neg_ne_zero.mpr one_ne_zero))
      (pow_ne_zero kind.order (collisionFactor_prime (K := K) i j hji).ne_zero))
  simpa only [mul_assoc] using heq

omit [CharZero K] in
/-- Multiplying an invariant scalar by the correct power of the root difference
produces exactly the required parity and diagonal condition. -/
theorem collisionFactor_mul_mem (i j : I) (hji : j ≠ i)
    (kind : ComponentKind) (q : pairScalars (K := K) i j) :
    collisionFactor (K := K) i j ^ kind.order * (q : MvPolynomial I K) ∈
      componentCarrier (K := K) i j hji kind := by
  constructor
  · have hq : swapVariables (K := K) i j (q : MvPolynomial I K) = q := q.property
    rw [map_mul, map_pow, swapVariables_collisionFactor, neg_pow, hq, mul_assoc]
  · intro hk
    subst kind
    rw [map_mul, map_pow]
    have hzero : collisionMap (K := K) i j hji (collisionFactor (K := K) i j) = 0 :=
      (collisionFactor_dvd_iff i j hji _).mp (dvd_refl _)
    simp [hzero, ComponentKind.order]

/-- The explicit free generator of a single tensor coordinate. -/
def componentMap (i j : I) (hji : j ≠ i) (kind : ComponentKind) :
    pairScalars (K := K) i j →ₗ[pairScalars (K := K) i j]
      componentCarrier (K := K) i j hji kind where
  toFun q := ⟨_, collisionFactor_mul_mem i j hji kind q⟩
  map_add' q r := by
    apply Subtype.ext
    change _ * ((q : MvPolynomial I K) + (r : MvPolynomial I K)) = _
    exact mul_add _ _ _
  map_smul' r q := by
    apply Subtype.ext
    change _ * ((r : MvPolynomial I K) * (q : MvPolynomial I K)) =
      (r : MvPolynomial I K) * (_ * (q : MvPolynomial I K))
    ring

/-- The prescribed generator identifies every component with one free scalar copy. -/
theorem componentMap_bijective (i j : I) (hji : j ≠ i) (kind : ComponentKind) :
    Function.Bijective (componentMap (K := K) i j hji kind) := by
  constructor
  · intro q r h
    apply Subtype.ext
    apply mul_left_cancel₀ (pow_ne_zero kind.order
      (collisionFactor_prime (K := K) i j hji).ne_zero)
    exact congrArg Subtype.val h
  · intro p
    obtain ⟨q, hfac⟩ := collisionFactor_pow_dvd_of_mem i j hji kind
      (p : MvPolynomial I K) p.property
    refine ⟨⟨q, quotient_mem_pairScalars i j hji kind
      (p : MvPolynomial I K) q p.property hfac⟩, ?_⟩
    apply Subtype.ext
    exact hfac.symm

/-- The two-current normal form for one component, over the unordered-pair ring. -/
def componentEquiv (i j : I) (hji : j ≠ i) (kind : ComponentKind) :
    pairScalars (K := K) i j ≃ₗ[pairScalars (K := K) i j]
      componentCarrier (K := K) i j hji kind :=
  LinearEquiv.ofBijective (componentMap i j hji kind) (componentMap_bijective i j hji kind)

/-- An arbitrary tensor basis, with every coordinate assigned its exchange type.
This is the coordinate form of `V(2θ) ⊕ Λ² g ⊕ I₂`. -/
abbrev Carrier (i j : I) (hji : j ≠ i) {ι : Type w} (kind : ι → ComponentKind) :=
  ∀ a, componentCarrier (K := K) i j hji (kind a)

/-- The full two-current carrier is free over the unordered-pair scalar ring,
with generators in collision orders zero, one, and two. -/
def carrierEquiv (i j : I) (hji : j ≠ i) {ι : Type w} (kind : ι → ComponentKind) :
    (ι → pairScalars (K := K) i j) ≃ₗ[pairScalars (K := K) i j]
      Carrier (K := K) i j hji kind :=
  LinearEquiv.piCongrRight fun a => componentEquiv i j hji (kind a)

/-- The explicit basis of the two-current carrier, including arbitrary spectators. -/
def carrierBasis (i j : I) (hji : j ≠ i) {ι : Type w} [Fintype ι]
    (kind : ι → ComponentKind) :
    Module.Basis ι (pairScalars (K := K) i j) (Carrier (K := K) i j hji kind) :=
  (Pi.basisFun (pairScalars (K := K) i j) ι).map (carrierEquiv i j hji kind)

end

end VOA.QuadraticTwoPointCarrier

section AxiomAudit
#print axioms VOA.QuadraticTwoPointCarrier.componentMap_bijective
#print axioms VOA.QuadraticTwoPointCarrier.carrierEquiv
#print axioms VOA.QuadraticTwoPointCarrier.carrierBasis
end AxiomAudit
