import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Tactic

/-!
# Finite-weight linear algebra for weighted initial ideals

The auxiliary filtration consists of actual polynomials with no components at or
above a specified degree. The initial relation spaces are actual images of the
top homogeneous projection on filtered ideal elements.
-/

namespace VOA.WeightedInitial
open scoped BigOperators
noncomputable section
variable {K σ : Type*} [Field K]

/-- Polynomials with auxiliary degree strictly less than `d`. -/
def below (w : σ → ℕ) (d : ℕ) : Submodule K (MvPolynomial σ K) where
  carrier := {f | ∀ k, d ≤ k → MvPolynomial.weightedHomogeneousComponent w k f = 0}
  zero_mem' := by intro k hk; exact map_zero _
  add_mem' := by
    intro f g hf hg k hk
    rw [map_add, hf k hk, hg k hk, add_zero]
  smul_mem' := by
    intro c f hf k hk
    rw [map_smul, hf k hk, smul_zero]

@[simp] theorem mem_below (w : σ → ℕ) (d : ℕ) (f : MvPolynomial σ K) :
    f ∈ below w d ↔ ∀ k, d ≤ k → MvPolynomial.weightedHomogeneousComponent w k f = 0 := Iff.rfl

theorem below_mono (w : σ → ℕ) : Monotone (below (K := K) w) := by
  intro d e hde f hf k hk
  exact hf k (le_trans hde hk)

@[simp] theorem below_zero (w : σ → ℕ) : below (K := K) w 0 = ⊥ := by
  apply le_antisymm _ bot_le
  intro f hf
  rw [Submodule.mem_bot, ← MvPolynomial.sum_weightedHomogeneousComponent w f]
  exact finsum_eq_zero_of_forall_eq_zero (fun d => hf d (Nat.zero_le _))

/-- Within the next filtration piece, vanishing of the top projection cuts out the previous one. -/
theorem mem_below_iff_top_zero (w : σ → ℕ) (d : ℕ) (f : MvPolynomial σ K)
    (hf : f ∈ below w (d + 1)) :
    f ∈ below w d ↔ MvPolynomial.weightedHomogeneousComponent w d f = 0 := by
  constructor
  · intro h; exact h d le_rfl
  · intro h k hk
    rcases eq_or_lt_of_le hk with rfl | hdk
    · exact h
    · exact hf k (by omega)

/-- Initial ideal generated by top components of all actual ideal elements. -/
def initialIdeal (w : σ → ℕ) (I : Ideal (MvPolynomial σ K)) : Ideal (MvPolynomial σ K) :=
  Ideal.span {p | ∃ g ∈ I, ∃ d : ℕ,
    (∀ k, d < k → MvPolynomial.weightedHomogeneousComponent w k g = 0) ∧
      MvPolynomial.weightedHomogeneousComponent w d g = p}

/-- The filtered relation space inside a specified polynomial slice. -/
def relationBelow (w : σ → ℕ) (I : Submodule K (MvPolynomial σ K))
    (V : Submodule K (MvPolynomial σ K)) (d : ℕ) : Submodule K (MvPolynomial σ K) :=
  (I ⊓ V) ⊓ below w d

/-- The actual top-component projection on filtered relations. -/
def topProjection (w : σ → ℕ) (I V : Submodule K (MvPolynomial σ K)) (d : ℕ) :
    relationBelow w I V (d + 1) →ₗ[K] MvPolynomial σ K :=
  (MvPolynomial.weightedHomogeneousComponent w d).comp (relationBelow w I V (d + 1)).subtype

/-- Initial relations in degree `d` are the range of the actual top projection. -/
def initialRelation (w : σ → ℕ) (I V : Submodule K (MvPolynomial σ K)) (d : ℕ) :
    Submodule K (MvPolynomial σ K) := LinearMap.range (topProjection w I V d)

theorem relationBelow_mono (w : σ → ℕ) (I V : Submodule K (MvPolynomial σ K)) :
    Monotone (relationBelow w I V) := by
  intro d e hde
  exact inf_le_inf_left _ (below_mono w hde)

/-- The kernel is precisely the preceding actual filtered relation space. -/
theorem topProjection_ker (w : σ → ℕ) (I V : Submodule K (MvPolynomial σ K)) (d : ℕ) :
    LinearMap.ker (topProjection w I V d) =
      (relationBelow w I V d).comap (relationBelow w I V (d + 1)).subtype := by
  ext f
  change MvPolynomial.weightedHomogeneousComponent w d f.1 = 0 ↔
    f.1 ∈ (I ⊓ V) ⊓ below w d
  rw [Submodule.mem_inf]
  exact ⟨fun h => ⟨f.2.1, (mem_below_iff_top_zero w d f.1 f.2.2).mpr h⟩,
    fun h => (mem_below_iff_top_zero w d f.1 f.2.2).mp h.2⟩

/-- Rank-nullity gives the actual increase in the filtered relation dimension. -/
theorem initialRelation_finrank_add_previous (w : σ → ℕ)
    (I V : Submodule K (MvPolynomial σ K)) [FiniteDimensional K V] (d : ℕ) :
    Module.finrank K (initialRelation w I V d) + Module.finrank K (relationBelow w I V d) =
      Module.finrank K (relationBelow w I V (d + 1)) := by
  haveI : FiniteDimensional K (relationBelow w I V (d + 1)) :=
    Submodule.finiteDimensional_of_le (show relationBelow w I V (d + 1) ≤ V from
      inf_le_left.trans inf_le_right)
  have h := LinearMap.finrank_range_add_finrank_ker (topProjection w I V d)
  rw [topProjection_ker] at h
  have heq := (Submodule.comapSubtypeEquivOfLe
    (relationBelow_mono w I V (Nat.le_succ d))).finrank_eq
  simpa only [initialRelation, heq] using h

/-- Telescoping the dimensions of the explicitly projected initial relations. -/
theorem sum_initialRelation_finrank (w : σ → ℕ)
    (I V : Submodule K (MvPolynomial σ K)) [FiniteDimensional K V] (D : ℕ) :
    (∑ d ∈ Finset.range D, Module.finrank K (initialRelation w I V d)) =
      Module.finrank K (relationBelow w I V D) := by
  induction D with
  | zero =>
      have hz : relationBelow w I V 0 = ⊥ := by
        unfold relationBelow
        rw [below_zero, inf_bot_eq]
      rw [hz]
      simp
  | succ D ih =>
      rw [Finset.sum_range_succ, ih, add_comm]
      exact initialRelation_finrank_add_previous w I V D

/-- In an auxiliary-degree-bounded finite slice, the initial relation dimensions sum
to the original relation dimension. The bound is on polynomials, not quotient dimensions. -/
theorem sum_initialRelation_finrank_eq (w : σ → ℕ)
    (I V : Submodule K (MvPolynomial σ K)) [FiniteDimensional K V] (D : ℕ)
    (hbound : V ≤ below w (D + 1)) :
    (∑ d ∈ Finset.range (D + 1), Module.finrank K (initialRelation w I V d)) =
      Module.finrank K ↥(I ⊓ V) := by
  rw [sum_initialRelation_finrank]
  have heq : relationBelow w I V (D + 1) = I ⊓ V :=
    inf_eq_left.mpr (inf_le_right.trans hbound)
  rw [heq]

end
end VOA.WeightedInitial
