import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.RingTheory.Polynomial.Ideal

/-!
# Collision prime factors for Gordon divisibility

This file isolates the finite commutative-algebra argument behind the collision factors in the
boundary-affine particle model.  Identifying two variables is presented as evaluation in one
distinguished variable.  Its kernel is generated by their difference.  If a polynomial is
invariant under transposing the two variables, then first-order vanishing on their diagonal is
automatically second-order vanishing (over a ring in which `2` is not a zero divisor).

After the one-pair theorem, a finite prime-factor argument assembles the squares over all
canonical pairs.  It uses pairwise nonassociation of distinct linear collision factors, not
comaximality of the corresponding principal ideals (which would be false).  The file does not
construct the boundary-affine carrier.
-/

namespace VOA.GordonCommonFactors

open MvPolynomial

noncomputable section

universe u v

variable {K : Type u} [Field K]
variable {I : Type v} [DecidableEq I]

/-- The linear equation of the collision hyperplane `x_i = x_j`. -/
def collisionFactor (i j : I) : MvPolynomial I K :=
  X i - X j

/-- Separate the variable `i` from all the remaining variables. -/
def isolateVariable (i : I) :
    MvPolynomial I K ≃ₐ[K] Polynomial (MvPolynomial {a : I // a ≠ i} K) :=
  (MvPolynomial.renameEquiv K (Equiv.optionSubtypeNe i).symm).trans
    (MvPolynomial.optionEquivLeft K {a : I // a ≠ i})

@[simp]
theorem isolateVariable_X_self (i : I) :
    isolateVariable (K := K) i (X i) = Polynomial.X := by
  simp [isolateVariable, MvPolynomial.renameEquiv_apply]

@[simp]
theorem isolateVariable_X_other (i j : I) (hji : j ≠ i) :
    isolateVariable (K := K) i (X j) =
      Polynomial.C (X (⟨j, hji⟩ : {a : I // a ≠ i})) := by
  simp [isolateVariable, MvPolynomial.renameEquiv_apply, hji]

/-- Identify `i` with `j` while retaining every variable other than `i`. -/
def collisionIndex (i j : I) (hji : j ≠ i) (a : I) : {b : I // b ≠ i} :=
  if h : a = i then ⟨j, hji⟩ else ⟨a, h⟩

@[simp]
theorem collisionIndex_self (i j : I) (hji : j ≠ i) :
    collisionIndex i j hji i = ⟨j, hji⟩ := by
  simp [collisionIndex]

@[simp]
theorem collisionIndex_other (i j : I) (hji : j ≠ i) (a : I) (hai : a ≠ i) :
    collisionIndex i j hji a = ⟨a, hai⟩ := by
  simp [collisionIndex, hai]

/-- The literal collision substitution which identifies `x_i` with `x_j`. -/
def collisionMap (i j : I) (hji : j ≠ i) :
    MvPolynomial I K →ₐ[K] MvPolynomial {a : I // a ≠ i} K :=
  MvPolynomial.rename (collisionIndex i j hji)

@[simp]
theorem collisionMap_X_self (i j : I) (hji : j ≠ i) :
    collisionMap (K := K) i j hji (X i) = X ⟨j, hji⟩ := by
  simp [collisionMap]

@[simp]
theorem collisionMap_X_other (i j : I) (hji : j ≠ i) (a : I) (hai : a ≠ i) :
    collisionMap (K := K) i j hji (X a) = X ⟨a, hai⟩ := by
  simp [collisionMap, hai]

/-- The collision substitution is evaluation of the isolated `i` variable at `x_j`. -/
theorem collisionMap_eq_eval_isolateVariable (i j : I) (hji : j ≠ i)
    (p : MvPolynomial I K) :
    collisionMap (K := K) i j hji p =
      Polynomial.eval (X (⟨j, hji⟩ : {a : I // a ≠ i}))
        (isolateVariable (K := K) i p) := by
  suffices hhom :
      (collisionMap (K := K) i j hji).toRingHom =
        (Polynomial.evalRingHom (X (⟨j, hji⟩ : {a : I // a ≠ i}))).comp
          (isolateVariable (K := K) i).toRingEquiv.toRingHom by
    exact DFunLike.congr_fun hhom p
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [isolateVariable]
  intro a
  by_cases hai : a = i
  · subst a
    simp
  · simp [hai]

/-- Divisibility is reflected by a ring equivalence. -/
theorem dvd_iff_map_dvd {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (a b : R) :
    a ∣ b ↔ e a ∣ e b := by
  constructor
  · exact map_dvd e
  · intro h
    have := map_dvd e.symm h
    simpa using this

/-- A polynomial vanishes after identifying `x_i` and `x_j` exactly when their difference is a
factor.  This is the algebraic form of a cross-species or same-species collision condition. -/
theorem collisionFactor_dvd_iff (i j : I) (hji : j ≠ i)
    (p : MvPolynomial I K) :
    collisionFactor (K := K) i j ∣ p ↔ collisionMap (K := K) i j hji p = 0 := by
  rw [collisionMap_eq_eval_isolateVariable]
  rw [← Polynomial.IsRoot.def, ← Polynomial.dvd_iff_isRoot]
  rw [dvd_iff_map_dvd (isolateVariable (K := K) i).toRingEquiv]
  change isolateVariable (K := K) i (collisionFactor (K := K) i j) ∣
      isolateVariable (K := K) i p ↔
    Polynomial.X - Polynomial.C (X (⟨j, hji⟩ : {a : I // a ≠ i})) ∣
      isolateVariable (K := K) i p
  rw [collisionFactor, map_sub, isolateVariable_X_self,
    isolateVariable_X_other i j hji]

/-- Relabel a polynomial by transposing two variables. -/
def swapVariables (i j : I) : MvPolynomial I K →ₐ[K] MvPolynomial I K :=
  MvPolynomial.rename (Equiv.swap i j)

@[simp]
theorem swapVariables_X_left (i j : I) :
    swapVariables (K := K) i j (X i) = X j := by
  simp [swapVariables]

@[simp]
theorem swapVariables_X_right (i j : I) :
    swapVariables (K := K) i j (X j) = X i := by
  simp [swapVariables]

@[simp]
theorem swapVariables_collisionFactor (i j : I) :
    swapVariables (K := K) i j (collisionFactor (K := K) i j) =
      -collisionFactor (K := K) i j := by
  simp [swapVariables, collisionFactor]

/-- Once `i` and `j` have been identified, transposing them has no effect. -/
theorem collisionMap_swapVariables (i j : I) (hji : j ≠ i)
    (p : MvPolynomial I K) :
    collisionMap (K := K) i j hji (swapVariables (K := K) i j p) =
      collisionMap (K := K) i j hji p := by
  suffices hhom :
      (collisionMap (K := K) i j hji).comp (swapVariables (K := K) i j) =
        collisionMap (K := K) i j hji by
    exact DFunLike.congr_fun hhom p
  apply MvPolynomial.algHom_ext
  intro a
  by_cases hai : a = i
  · subst a
    simp [collisionMap_X_other (K := K) i j hji j hji]
  by_cases haj : a = j
  · subst a
    simp [collisionMap_X_other (K := K) i j hji j hji]
  · simp [swapVariables, collisionMap, collisionIndex, hai,
      Equiv.swap_apply_of_ne_of_ne hai haj]

/-- A polynomial and its transposed branch agree on the collision diagonal, so their
difference has one copy of the collision factor. -/
theorem collisionFactor_dvd_sub_swapVariables
    (i j : I) (hji : j ≠ i) (p : MvPolynomial I K) :
    collisionFactor (K := K) i j ∣
      p - swapVariables (K := K) i j p := by
  apply (collisionFactor_dvd_iff i j hji _).2
  rw [map_sub, collisionMap_swapVariables, sub_self]

/-- For a polynomial symmetric in `i,j`, vanishing on `x_i=x_j` forces a square collision
factor.  The proof divides once, observes that the quotient is antisymmetric, and then divides a
second time. -/
theorem collisionFactor_sq_dvd_of_swap_invariant [CharZero K]
    (i j : I) (hji : j ≠ i)
    (p : MvPolynomial I K)
    (hsymm : swapVariables (K := K) i j p = p)
    (hvanish : collisionMap (K := K) i j hji p = 0) :
    collisionFactor (K := K) i j ^ 2 ∣ p := by
  have hdvd : collisionFactor (K := K) i j ∣ p :=
    (collisionFactor_dvd_iff i j hji p).2 hvanish
  rcases hdvd with ⟨q, hpq⟩
  have hfactor_ne : collisionFactor (K := K) i j ≠ 0 := by
    intro hzero
    have himage := congrArg (isolateVariable (K := K) i) hzero
    rw [map_zero, collisionFactor, map_sub, isolateVariable_X_self,
      isolateVariable_X_other i j hji] at himage
    exact Polynomial.X_sub_C_ne_zero _ himage
  have hanti : swapVariables (K := K) i j q = -q := by
    have hsymm' := hsymm
    rw [hpq, map_mul, swapVariables_collisionFactor] at hsymm'
    have hcancel :
        collisionFactor (K := K) i j * (-swapVariables (K := K) i j q) =
          collisionFactor (K := K) i j * q := by
      simpa [neg_mul] using hsymm'
    have := mul_left_cancel₀ hfactor_ne hcancel
    simpa using congrArg Neg.neg this
  have hqvanish : collisionMap (K := K) i j hji q = 0 := by
    have hdiag := congrArg (collisionMap (K := K) i j hji) hanti
    rw [map_neg, collisionMap_swapVariables] at hdiag
    have htwo : (2 : K) • collisionMap (K := K) i j hji q = 0 := by
      calc
        (2 : K) • collisionMap (K := K) i j hji q =
            collisionMap (K := K) i j hji q +
              collisionMap (K := K) i j hji q := two_smul K _
        _ = -collisionMap (K := K) i j hji q +
              collisionMap (K := K) i j hji q :=
            congrArg (fun x ↦ x + collisionMap (K := K) i j hji q) hdiag
        _ = 0 := neg_add_cancel _
    exact (smul_eq_zero.mp htwo).resolve_left (by norm_num)
  rcases (collisionFactor_dvd_iff i j hji q).2 hqvanish with ⟨r, hqr⟩
  refine ⟨r, ?_⟩
  rw [pow_two, hpq, hqr, mul_assoc]

/-- Every collision difference of two distinct variables is a prime element. -/
theorem collisionFactor_prime (i j : I) (hji : j ≠ i) :
    Prime (collisionFactor (K := K) i j) := by
  refine (MulEquiv.prime_iff
    (isolateVariable (K := K) i).toRingEquiv.toMulEquiv).mp ?_
  change Prime (isolateVariable (K := K) i
    (collisionFactor (K := K) i j))
  rw [collisionFactor, map_sub, isolateVariable_X_self,
    isolateVariable_X_other i j hji]
  exact Polynomial.prime_X_sub_C _

/-- The only distinct variables identified by one collision substitution are the two variables
being collapsed. -/
theorem eq_pair_or_swap_of_collisionIndex_eq
    {a b c d : I} (hba : b ≠ a) (hcd : c ≠ d)
    (hindex : collisionIndex a b hba c = collisionIndex a b hba d) :
    (c = a ∧ d = b) ∨ (c = b ∧ d = a) := by
  have hvalue := congrArg Subtype.val hindex
  by_cases hca : c = a
  · subst c
    have hda : d ≠ a := fun hda ↦ hcd hda.symm
    simp [collisionIndex, hda] at hvalue
    exact Or.inl ⟨rfl, hvalue.symm⟩
  · by_cases hda : d = a
    · subst d
      simp [collisionIndex, hca] at hvalue
      exact Or.inr ⟨hvalue, rfl⟩
    · simp [collisionIndex, hca, hda] at hvalue
      exact False.elim (hcd hvalue)

/-- Collision factors attached to two genuinely different unordered pairs do not divide one
another. -/
theorem collisionFactor_not_dvd_of_unordered_pairs_ne
    {a b c d : I} (hba : b ≠ a) (hcd : c ≠ d)
    (hdirect : ¬(c = a ∧ d = b)) (hreverse : ¬(c = b ∧ d = a)) :
    ¬collisionFactor (K := K) a b ∣ collisionFactor (K := K) c d := by
  intro hdvd
  have hzero :=
    (collisionFactor_dvd_iff a b hba
      (collisionFactor (K := K) c d)).1 hdvd
  have hvariables :
      (X (collisionIndex a b hba c) : MvPolynomial {x : I // x ≠ a} K) =
        X (collisionIndex a b hba d) := by
    apply sub_eq_zero.mp
    simpa [collisionFactor, collisionMap] using hzero
  have hindex := MvPolynomial.X_injective hvariables
  exact (eq_pair_or_swap_of_collisionIndex_eq hba hcd hindex).elim hdirect hreverse

section OrderedVariables

variable [LinearOrder I]

/-- If two increasing pairs become equal after collapsing the first pair, then the pairs were
already equal.  This is the elementary separation fact behind nonassociation of distinct
collision factors. -/
theorem eq_pair_of_collisionIndex_eq
    {a b c d : I} (hab : a < b) (hcd : c < d)
    (hindex : collisionIndex a b (ne_of_gt hab) c =
      collisionIndex a b (ne_of_gt hab) d) :
    c = a ∧ d = b := by
  have hvalue := congrArg Subtype.val hindex
  by_cases hca : c = a
  · subst c
    have hda : d ≠ a := ne_of_gt hcd
    simp [collisionIndex, hda] at hvalue
    exact ⟨rfl, hvalue.symm⟩
  · by_cases hda : d = a
    · subst d
      simp [collisionIndex, hca] at hvalue
      have hba : b < a := by simpa [hvalue] using hcd
      exact False.elim ((not_lt_of_ge hab.le) hba)
    · simp [collisionIndex, hca, hda] at hvalue
      exact False.elim (hcd.ne hvalue)

/-- Distinct increasing pairs define nonassociated prime factors.  The orientation convention is
essential: reversing a pair merely changes the factor by the unit `-1`. -/
theorem collisionFactor_not_dvd_of_pairs_ne
    {a b c d : I} (hab : a < b) (hcd : c < d)
    (hne : (a, b) ≠ (c, d)) :
    ¬collisionFactor (K := K) a b ∣ collisionFactor (K := K) c d := by
  intro hdvd
  have hzero :=
    (collisionFactor_dvd_iff a b (ne_of_gt hab)
      (collisionFactor (K := K) c d)).1 hdvd
  have hvariables :
      (X (collisionIndex a b (ne_of_gt hab) c) :
        MvPolynomial {x : I // x ≠ a} K) =
        X (collisionIndex a b (ne_of_gt hab) d) := by
    apply sub_eq_zero.mp
    simpa [collisionFactor, collisionMap] using hzero
  have hindex := MvPolynomial.X_injective hvariables
  have hpairs := eq_pair_of_collisionIndex_eq hab hcd hindex
  exact hne (Prod.ext hpairs.1.symm hpairs.2.symm)

end OrderedVariables

/-- Pairwise distinct prime powers can be multiplied inside a common divisor.  This is stated for
an arbitrary finite family because it is useful beyond Vandermonde products. -/
theorem prod_pow_dvd_of_pairwise_prime
    {A M : Type*} [DecidableEq A] [CommMonoidWithZero M] [IsCancelMulZero M]
    (s : Finset A) (f : A → M) (n : ℕ) (p : M)
    (hprime : ∀ a ∈ s, Prime (f a))
    (hseparate : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → ¬f a ∣ f b)
    (heach : ∀ a ∈ s, f a ^ n ∣ p) :
    (∏ a ∈ s, f a) ^ n ∣ p := by
  classical
  have hproduct : (∏ a ∈ s, f a ^ n) ∣ p := by
    induction s using Finset.induction_on generalizing p with
    | empty =>
        simp
    | @insert a s ha ih =>
        have hadiv : f a ^ n ∣ p := heach a (Finset.mem_insert_self a s)
        rcases hadiv with ⟨q, hpq⟩
        have htail : ∀ b ∈ s, f b ^ n ∣ q := by
          intro b hb
          have hbprime : Prime (f b) := hprime b (Finset.mem_insert_of_mem hb)
          have hbnot : ¬f b ∣ f a ^ n := by
            intro hbaPow
            have hba : f b ∣ f a := hbprime.dvd_of_dvd_pow hbaPow
            have hba_ne : b ≠ a := fun h ↦ ha (h ▸ hb)
            exact hseparate b (Finset.mem_insert_of_mem hb) a
              (Finset.mem_insert_self a s) hba_ne hba
          exact hbprime.pow_dvd_of_dvd_mul_left n hbnot (by
            rw [← hpq]
            exact heach b (Finset.mem_insert_of_mem hb))
        have htailProduct : (∏ b ∈ s, f b ^ n) ∣ q :=
          ih q (fun b hb ↦ hprime b (Finset.mem_insert_of_mem hb))
            (fun b hb c hc hbc ↦ hseparate b (Finset.mem_insert_of_mem hb)
              c (Finset.mem_insert_of_mem hc) hbc)
            htail
        rw [Finset.prod_insert ha, hpq]
        exact mul_dvd_mul_left (f a ^ n) htailProduct
  simpa [Finset.prod_pow] using hproduct

section CrossSpecies

variable {L R : Type*} [Fintype L] [Fintype R]

/-- Product of all collision hyperplanes between two labelled species. -/
def crossCollisionProduct (left : L → I) (right : R → I) :
    MvPolynomial I K :=
  ∏ lr : L × R, collisionFactor (K := K) (left lr.1) (right lr.2)

/-- If two species have injective, disjoint label embeddings, vanishing on every cross-species
collision diagonal gives the product of all cross-species collision factors. -/
theorem crossCollisionProduct_dvd_of_diagonal_vanishing
    (left : L → I) (right : R → I)
    (hleft : Function.Injective left) (hright : Function.Injective right)
    (hdisjoint : ∀ l r, left l ≠ right r)
    (p : MvPolynomial I K)
    (hvanish : ∀ l r, ∀ hrl : right r ≠ left l,
      collisionMap (K := K) (left l) (right r) hrl p = 0) :
    crossCollisionProduct (K := K) left right ∣ p := by
  classical
  let factor : L × R → MvPolynomial I K := fun lr ↦
    collisionFactor (K := K) (left lr.1) (right lr.2)
  have hproduct := prod_pow_dvd_of_pairwise_prime Finset.univ factor 1 p
    (fun lr _ ↦ collisionFactor_prime (left lr.1) (right lr.2)
      (hdisjoint lr.1 lr.2).symm)
    (fun lr _ st _ hne ↦ by
      apply collisionFactor_not_dvd_of_unordered_pairs_ne
        (hdisjoint lr.1 lr.2).symm (hdisjoint st.1 st.2)
      · rintro ⟨hleftEq, hrightEq⟩
        apply hne
        exact Prod.ext (hleft hleftEq).symm (hright hrightEq).symm
      · rintro ⟨hcross, _⟩
        exact hdisjoint st.1 lr.2 hcross)
    (fun lr _ ↦ by
      simpa using (collisionFactor_dvd_iff (left lr.1) (right lr.2)
        (hdisjoint lr.1 lr.2).symm p).2
          (hvanish lr.1 lr.2 (hdisjoint lr.1 lr.2).symm))
  simpa [crossCollisionProduct, factor] using hproduct

end CrossSpecies

section Vandermonde

variable [Fintype I] [LinearOrder I]

/-- Canonically oriented unordered pairs of particle labels. -/
abbrev IncreasingPair (I : Type v) [LinearOrder I] :=
  {ij : I × I // ij.1 < ij.2}

/-- The Vandermonde product in the variables indexed by `I`. -/
def vandermonde : MvPolynomial I K :=
  ∏ ij : IncreasingPair I,
    collisionFactor (K := K) ij.1.1 ij.1.2

/-- A symmetric polynomial which vanishes on every same-species diagonal is divisible by the
square of the Vandermonde.  This is the exact finite common-factor statement used by the
particle-polynomial strategy. -/
theorem vandermonde_sq_dvd_of_symmetric_diagonal_vanishing [CharZero K]
    (p : MvPolynomial I K)
    (hsymm : ∀ i j : I, swapVariables (K := K) i j p = p)
    (hvanish : ∀ i j : I, ∀ hji : j ≠ i,
      collisionMap (K := K) i j hji p = 0) :
    vandermonde (K := K) (I := I) ^ 2 ∣ p := by
  classical
  let factor : IncreasingPair I → MvPolynomial I K := fun ij ↦
    collisionFactor (K := K) ij.1.1 ij.1.2
  apply prod_pow_dvd_of_pairwise_prime Finset.univ factor 2 p
  · intro ij _
    exact collisionFactor_prime ij.1.1 ij.1.2 (ne_of_gt ij.2)
  · intro ij _ kl _ hne
    exact collisionFactor_not_dvd_of_pairs_ne ij.2 kl.2 (by
      intro hpairs
      apply hne
      exact Subtype.ext hpairs)
  · intro ij _
    exact collisionFactor_sq_dvd_of_swap_invariant ij.1.1 ij.1.2
      (ne_of_gt ij.2) p (hsymm ij.1.1 ij.1.2)
      (hvanish ij.1.1 ij.1.2 (ne_of_gt ij.2))

end Vandermonde

section InjectedLabels

variable {L : Type*} [Fintype L] [LinearOrder L]

/-- Vandermonde in a selected family of variables.  In a multispecies polynomial ring, `label`
can be the inclusion of the labels belonging to one species. -/
def vandermondeAlong (label : L → I) : MvPolynomial I K :=
  ∏ ij : IncreasingPair L,
    collisionFactor (K := K) (label ij.1.1) (label ij.1.2)

/-- Same-species symmetry and same-species diagonal vanishing give the squared Vandermonde factor
inside an ambient multispecies polynomial ring.  No symmetry involving labels outside the image
of `label` is required. -/
theorem vandermondeAlong_sq_dvd_of_symmetric_diagonal_vanishing [CharZero K]
    (label : L → I) (hlabel : Function.Injective label)
    (p : MvPolynomial I K)
    (hsymm : ∀ i j : L,
      swapVariables (K := K) (label i) (label j) p = p)
    (hvanish : ∀ i j : L, ∀ hji : label j ≠ label i,
      collisionMap (K := K) (label i) (label j) hji p = 0) :
    vandermondeAlong (K := K) label ^ 2 ∣ p := by
  classical
  let factor : IncreasingPair L → MvPolynomial I K := fun ij ↦
    collisionFactor (K := K) (label ij.1.1) (label ij.1.2)
  apply prod_pow_dvd_of_pairwise_prime Finset.univ factor 2 p
  · intro ij _
    exact collisionFactor_prime (label ij.1.1) (label ij.1.2)
      (hlabel.ne (ne_of_gt ij.2))
  · intro ij _ kl _ hne
    apply collisionFactor_not_dvd_of_unordered_pairs_ne
      (hlabel.ne (ne_of_gt ij.2)) (hlabel.ne (ne_of_lt kl.2))
    · rintro ⟨hleft, hright⟩
      apply hne
      apply Subtype.ext
      apply Prod.ext
      · exact (hlabel hleft).symm
      · exact (hlabel hright).symm
    · rintro ⟨hleft, hright⟩
      have hleft' : kl.1.1 = ij.1.2 := hlabel hleft
      have hright' : kl.1.2 = ij.1.1 := hlabel hright
      have hreverse : ij.1.2 < ij.1.1 := by
        simpa [hleft', hright'] using kl.2
      exact (not_lt_of_ge ij.2.le) hreverse
  · intro ij _
    exact collisionFactor_sq_dvd_of_swap_invariant
      (label ij.1.1) (label ij.1.2) (hlabel.ne (ne_of_gt ij.2)) p
      (hsymm ij.1.1 ij.1.2)
      (hvanish ij.1.1 ij.1.2 (hlabel.ne (ne_of_gt ij.2)))

end InjectedLabels

end

end VOA.GordonCommonFactors
