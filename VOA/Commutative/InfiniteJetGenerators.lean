import VOA.Commutative.InfiniteJetArc

/-!
# Infinite jet relations from a chosen generating set

The arc ideal of `(S)` is generated by the ordinary series coefficients of the
members of `S`. All polynomial multiples of the original relations follow
from these coefficient relations, rather than being assumed separately.
-/

namespace VOA.InfiniteJet
open scoped BigOperators
noncomputable section
variable {R σ : Type*} [CommRing R]

/-- The universal generator series in the infinite polynomial ring. -/
def generatorSeries (i : σ) : PowerSeries (JetPoly R σ) :=
  PowerSeries.mk fun n => MvPolynomial.X (i, n)

@[simp] theorem coeff_generatorSeries (i : σ) (n : ℕ) :
    PowerSeries.coeff n (generatorSeries (R := R) i) = MvPolynomial.X (i, n) :=
  PowerSeries.coeff_mk _ _

/-- Universal ordinary relation coefficient. -/
def relationCoefficient (f : MvPolynomial σ R) (n : ℕ) : JetPoly R σ :=
  PowerSeries.coeff n (MvPolynomial.aeval generatorSeries f)

/-- Universal generator evaluation is the identity on the infinite polynomial ring. -/
theorem seriesJetEval_generatorSeries :
    seriesJetEval (R := R) (generatorSeries (R := R)) = AlgHom.id R (JetPoly R σ) := by
  apply MvPolynomial.algHom_ext
  intro v
  simp [seriesJetEval]

/-- The infinite coefficient agrees with a sufficient finite jet stage. -/
theorem relationCoefficient_eq_ofFinite (f : MvPolynomial σ R) (n : ℕ) :
    relationCoefficient f n = ofFinite (R := R) n (FiniteJet.relationCoeff n n f) := by
  have h := seriesJetEval_ofFinite_relationCoeff (R := R) (generatorSeries (R := R))
    n n le_rfl f
  rw [seriesJetEval_generatorSeries] at h
  exact h.symm

/-- Coefficients of original ideal relations belong to the genuine infinite jet ideal. -/
theorem relationCoefficient_mem_jetIdeal (I : Ideal (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ I) (n : ℕ) :
    relationCoefficient f n ∈ jetIdeal I := by
  rw [relationCoefficient_eq_ofFinite]
  apply ofFinite_mem_jetIdeal
  exact FiniteJet.relationCoeff_mem_jetIdeal n n I f hf le_rfl

/-- The explicit coefficient-generated ideal attached to a chosen relation set. -/
def coefficientIdeal (S : Set (MvPolynomial σ R)) : Ideal (JetPoly R σ) :=
  Ideal.span {p | ∃ f ∈ S, ∃ n : ℕ, relationCoefficient f n = p}

/-- Coefficients of a chosen generating relation belong to its coefficient ideal. -/
theorem relationCoefficient_mem_coefficientIdeal (S : Set (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ S) (n : ℕ) :
    relationCoefficient f n ∈ coefficientIdeal S :=
  Ideal.subset_span ⟨f, hf, n, rfl⟩

/-- Explicit generator coefficients are contained in the full infinite relation ideal. -/
theorem coefficientIdeal_le_jetIdeal (S : Set (MvPolynomial σ R)) :
    coefficientIdeal S ≤ jetIdeal (Ideal.span S) := by
  rw [coefficientIdeal, Ideal.span_le]
  rintro p ⟨f, hf, n, rfl⟩
  exact relationCoefficient_mem_jetIdeal _ f (Ideal.subset_span hf) n

/-- A coefficient quotient makes all original generating series vanish. -/
theorem coefficientIdeal_generator_vanish (S : Set (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ S) :
    MvPolynomial.aeval
      (fun i => PowerSeries.mk fun n =>
        Ideal.Quotient.mk (coefficientIdeal S) (MvPolynomial.X (i, n))) f = 0 := by
  apply PowerSeries.ext
  intro n
  have hmap :
      (MvPolynomial.aeval (fun i => PowerSeries.mk fun n =>
        Ideal.Quotient.mk (coefficientIdeal S) (MvPolynomial.X (i, n))) :
        MvPolynomial σ R →ₐ[R] PowerSeries (JetPoly R σ ⧸ coefficientIdeal S)) =
      (PowerSeries.mapAlgHom (Ideal.Quotient.mkₐ R (coefficientIdeal S))).comp
        (MvPolynomial.aeval (generatorSeries (R := R))) := by
    apply MvPolynomial.algHom_ext
    intro i
    apply PowerSeries.ext
    intro j
    simp [PowerSeries.mapAlgHom_apply]
  rw [hmap]
  simp only [AlgHom.comp_apply, PowerSeries.mapAlgHom_apply, PowerSeries.coeff_map,
    map_zero]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (relationCoefficient_mem_coefficientIdeal S f hf n)

/-- The generating coefficient ideal is the whole infinite arc ideal. -/
theorem jetIdeal_span_eq_coefficientIdeal (S : Set (MvPolynomial σ R)) :
    jetIdeal (Ideal.span S) = coefficientIdeal S := by
  apply le_antisymm
  · let J := coefficientIdeal S
    let x : σ → PowerSeries (JetPoly R σ ⧸ J) := fun i =>
      PowerSeries.mk fun n => Ideal.Quotient.mk J (MvPolynomial.X (i, n))
    have hbase : Ideal.span S ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom := by
      rw [Ideal.span_le]
      intro f hf
      exact RingHom.mem_ker.mpr (coefficientIdeal_generator_vanish S f hf)
    have hjet := seriesJetEval_jetIdeal_le_ker (R := R) x (Ideal.span S)
      (fun f hf => RingHom.mem_ker.mp (hbase hf))
    have heval : seriesJetEval x = Ideal.Quotient.mkₐ R J := by
      apply MvPolynomial.algHom_ext
      intro v
      simp [seriesJetEval, x]
    intro p hp
    have hz := RingHom.mem_ker.mp (hjet hp)
    rw [heval] at hz
    exact Ideal.Quotient.eq_zero_iff_mem.mp hz
  · exact coefficientIdeal_le_jetIdeal S

end
end VOA.InfiniteJet
