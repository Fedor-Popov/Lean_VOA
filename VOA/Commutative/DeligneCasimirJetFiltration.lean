import VOA.Commutative.CasimirCostFiltration
import VOA.Commutative.FiniteWeightedJetRelations

/-!
# Quadratic Casimir filtrations on finite jet presentations

This file specializes the generic finite-weight ideal-power filtration to
the jet ideal generated by one quadratic Casimir relation.  If `Q` is
weighted homogeneous of degree two, its retained Hasse--Schmidt coefficient
of order `r` has conformal weight `r + 2`.  Hence the entire finite-jet
Casimir ideal starts in weight two, and its `d`th power vanishes on every
homogeneous quotient piece of weight less than `2 * d`.

The quotient map below is deliberately arbitrary.  In the Deligne
application it is the map from homogeneous finite-jet polynomials onto the
corresponding homogeneous piece of the presented jet algebra.  No
representation-theoretic relation, character formula, or assertion that a
candidate initial relation list is exhaustive enters these results.
-/

namespace VOA.DeligneCasimirJetFiltration

open VOA.CasimirCostFiltration
open VOA.FiniteJet
open VOA.FiniteCostDegeneration
open VOA.MvPolynomialMinimumWeight

noncomputable section

universe uK uσ uV

variable {K : Type uK} [Field K]
variable {σ : Type uσ}
variable {V : Type uV} [AddCommGroup V] [Module K V]

/-- The finite-jet ideal generated by all retained coefficients of one
Casimir polynomial. -/
def casimirJetIdeal (m : ℕ) (Q : MvPolynomial σ K) :
    Ideal (FiniteJet.JetPoly K σ m) :=
  FiniteJet.jetIdeal (R := K) m (Ideal.span {Q})

/-- Every retained coefficient of a quadratic weighted-homogeneous Casimir
has conformal weight at least two. -/
theorem casimirJetIdeal_le_minimumWeightTwo
    (baseWeight : σ → ℕ) (m : ℕ) (Q : MvPolynomial σ K)
    (hQ : Q.IsWeightedHomogeneous baseWeight 2) :
    casimirJetIdeal (K := K) m Q ≤
      minimumWeightIdeal (FiniteJet.jetWeight baseWeight m) 2 := by
  rw [casimirJetIdeal, FiniteJet.jetIdeal_span_eq_jetIdealOfSet]
  rw [FiniteJet.jetIdealOfSet, Ideal.span_le]
  rintro g ⟨f, hf, j, rfl⟩
  simp only [Set.mem_singleton_iff] at hf
  subst f
  intro d hd
  have hdegree := FiniteJet.relationCoeff_isWeightedHomogeneous
    (R := K) baseWeight m 2 j hQ
      (MvPolynomial.mem_support_iff.mp hd)
  change 2 ≤ Finsupp.weight (FiniteJet.jetWeight baseWeight m) d
  omega

/-- The exact conformal-weight `N` polynomial source at jet order `m`. -/
abbrev JetWeightSource (baseWeight : σ → ℕ) (m N : ℕ) :=
  HomogeneousSource (K := K) (FiniteJet.jetWeight baseWeight m) N

/-- The literal depth-`d` Casimir-adic representatives in conformal weight
`N`. -/
abbrev polynomialPiece
    (baseWeight : σ → ℕ) (m N : ℕ) (Q : MvPolynomial σ K) (d : ℕ) :=
  polynomialCostPiece (K := K) (FiniteJet.jetWeight baseWeight m) N
    (casimirJetIdeal (K := K) m Q) d

/-- Finite-weight nilpotence for the quadratic Casimir jet ideal. -/
theorem polynomialPiece_eq_bot_of_lt
    (baseWeight : σ → ℕ) (m N : ℕ) (Q : MvPolynomial σ K)
    (hQ : Q.IsWeightedHomogeneous baseWeight 2)
    (d : ℕ) (hN : N < 2 * d) :
    polynomialPiece (K := K) baseWeight m N Q d = ⊥ := by
  exact polynomialCostPiece_eq_bot_of_lt
    (FiniteJet.jetWeight baseWeight m) N (casimirJetIdeal (K := K) m Q)
      (casimirJetIdeal_le_minimumWeightTwo baseWeight m Q hQ) d hN

/-- The finite Casimir-adic filtration on any homogeneous quotient of the
finite jet polynomial ring. -/
def filtration
    (baseWeight : σ → ℕ) (m N : ℕ) (Q : MvPolynomial σ K)
    (hQ : Q.IsWeightedHomogeneous baseWeight 2)
    (q : JetWeightSource (K := K) baseWeight m N →ₗ[K] V)
    (hq : Function.Surjective q) :
    FiniteCostFiltration K (ModuleCat.of K V) (maxCost N) :=
  CasimirCostFiltration.filtration
    (K := K) (FiniteJet.jetWeight baseWeight m) N
      (casimirJetIdeal (K := K) m Q)
      (casimirJetIdeal_le_minimumWeightTwo baseWeight m Q hQ) q hq

/-- The first depth beyond `N / 2` is zero in the literal quotient
filtration. -/
theorem quotientPiece_succ_max_eq_bot
    (baseWeight : σ → ℕ) (m N : ℕ) (Q : MvPolynomial σ K)
    (hQ : Q.IsWeightedHomogeneous baseWeight 2)
    (q : JetWeightSource (K := K) baseWeight m N →ₗ[K] V) :
    quotientCostPiece (K := K) (FiniteJet.jetWeight baseWeight m) N
      (casimirJetIdeal (K := K) m Q) q (maxCost N + 1) = ⊥ := by
  exact quotientCostPiece_succ_max_eq_bot
    (FiniteJet.jetWeight baseWeight m) N (casimirJetIdeal (K := K) m Q)
      (casimirJetIdeal_le_minimumWeightTwo baseWeight m Q hQ) q

/-- Homogeneous Casimir-ideal-power representatives surject onto every true
associated layer of the quotient filtration. -/
theorem polynomialToAssociated_surjective
    (baseWeight : σ → ℕ) (m N : ℕ) (Q : MvPolynomial σ K)
    (hQ : Q.IsWeightedHomogeneous baseWeight 2)
    (q : JetWeightSource (K := K) baseWeight m N →ₗ[K] V)
    (hq : Function.Surjective q) (d : ℕ) :
    Function.Surjective
      (polynomialCostToAssociated (K := K)
        (FiniteJet.jetWeight baseWeight m) N
        (casimirJetIdeal (K := K) m Q)
        (casimirJetIdeal_le_minimumWeightTwo baseWeight m Q hQ)
        q hq d) :=
  polynomialCostToAssociated_surjective
    (K := K) (FiniteJet.jetWeight baseWeight m) N
      (casimirJetIdeal (K := K) m Q)
      (casimirJetIdeal_le_minimumWeightTwo baseWeight m Q hQ) q hq d

/-- In finitely many current coordinates with positive base weights, the
associated Casimir-cost layers telescope exactly to the quotient dimension.
-/
theorem sum_associated_finrank [Finite σ]
    (baseWeight : σ → ℕ) (hbase : ∀ i, baseWeight i ≠ 0)
    (m N : ℕ) (Q : MvPolynomial σ K)
    (hQ : Q.IsWeightedHomogeneous baseWeight 2)
    (q : JetWeightSource (K := K) baseWeight m N →ₗ[K] V)
    (hq : Function.Surjective q) :
    (∑ d : Fin (maxCost N + 1),
        Module.finrank K
          (FiniteCostFiltration.CostAssociated
            (K := K) (Source := ModuleCat.of K V)
            (filtration (K := K) baseWeight m N Q hQ q hq) d.1)) =
      Module.finrank K V := by
  letI : Finite (FiniteJet.JetVar σ m) :=
    Finite.of_injective (fun v => (v.generator, v.order)) (by
      intro v z h
      exact FiniteJet.JetVar.ext (congrArg Prod.fst h) (congrArg Prod.snd h))
  apply CasimirCostFiltration.sum_associated_finrank
  intro v
  simp only [FiniteJet.jetWeight]
  have hv := hbase v.1
  omega

end

end VOA.DeligneCasimirJetFiltration

section AxiomAudit
open VOA.DeligneCasimirJetFiltration
#print axioms casimirJetIdeal_le_minimumWeightTwo
#print axioms polynomialPiece_eq_bot_of_lt
#print axioms quotientPiece_succ_max_eq_bot
#print axioms polynomialToAssociated_surjective
#print axioms sum_associated_finrank
end AxiomAudit
