import Mathlib.Algebra.MvPolynomial.Polynomial
import Mathlib.Algebra.MvPolynomial.Rename
import Mathlib.Algebra.Polynomial.Coeff
import Mathlib.Algebra.BigOperators.NatAntidiagonal
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Presentation-level finite jets

This file defines the polynomial ring on jet variables of orders at most `m` and the truncated
polynomial series attached to each original generator.  Substituting these series into a
multivariable polynomial relation produces its finite jet-relation series; coefficient extraction
then gives the individual Hasse--Schmidt relations.

The finite jet-relation ideal is generated by the coefficients of orders `0` through `m` of every
relation in the input ideal.  Its quotient is the presentation-level order-`m` jet algebra.

No transition map, infinite arc algebra, or localization theorem is asserted here.
-/

namespace VOA.FiniteJet

open scoped BigOperators

universe uσ uR

/-- A jet variable consists of an original generator and an order between `0` and `m`. -/
@[ext]
structure JetVar (σ : Type uσ) (m : ℕ) where
  generator : σ
  order : Fin (m + 1)

/-- The polynomial ring on jet variables of orders at most `m`. -/
abbrev JetPoly (R : Type uR) [CommSemiring R] (σ : Type uσ) (m : ℕ) :=
  MvPolynomial (JetVar σ m) R

section

variable {R : Type uR} {σ : Type uσ} [CommSemiring R]

/-- The jet variable `x_i^(r)`, extended by zero when `r > m`. -/
noncomputable def jetVariable (m : ℕ) (i : σ) (r : ℕ) : JetPoly R σ m :=
  if h : r ≤ m then
    MvPolynomial.X ⟨i, ⟨r, Nat.lt_succ_iff.mpr h⟩⟩
  else
    0

@[simp]
theorem jetVariable_of_le (m : ℕ) (i : σ) (r : ℕ) (h : r ≤ m) :
    jetVariable (R := R) m i r =
      MvPolynomial.X ⟨i, ⟨r, Nat.lt_succ_iff.mpr h⟩⟩ := by
  simp [jetVariable, h]

@[simp]
theorem jetVariable_of_lt (m : ℕ) (i : σ) (r : ℕ) (h : m < r) :
    jetVariable (R := R) m i r = 0 := by
  simp [jetVariable, Nat.not_le_of_gt h]

/-- The truncated series `x_i(t) = sum_{r=0}^m x_i^(r) t^r`. -/
noncomputable def jetSeries (m : ℕ) (i : σ) : Polynomial (JetPoly R σ m) :=
  ∑ r ∈ Finset.range (m + 1), Polynomial.monomial r (jetVariable (R := R) m i r)

@[simp]
theorem jetSeries_coeff (m : ℕ) (i : σ) (n : ℕ) :
    (jetSeries (R := R) m i).coeff n = jetVariable (R := R) m i n := by
  classical
  by_cases h : n ≤ m
  · simp [jetSeries, jetVariable, h, Polynomial.coeff_monomial]
  · simp [jetSeries, jetVariable, h, Polynomial.coeff_monomial]

/-- Substitute the truncated jet series for every generator of a multivariable polynomial. -/
noncomputable def jetSubst (m : ℕ) :
    MvPolynomial σ R →ₐ[R] Polynomial (JetPoly R σ m) :=
  MvPolynomial.aeval (jetSeries (R := R) m)

/-- The polynomial in the auxiliary series variable obtained from a relation by jet substitution. -/
noncomputable def relationSeries (m : ℕ) (f : MvPolynomial σ R) :
    Polynomial (JetPoly R σ m) :=
  jetSubst (R := R) m f

/-- The coefficient of order `n` in the substituted relation. -/
noncomputable def relationCoeff (m : ℕ) (n : ℕ) (f : MvPolynomial σ R) :
    JetPoly R σ m :=
  (relationSeries (R := R) m f).coeff n

/-- Coefficient extraction at one of the retained jet orders, as an `R`-linear map. -/
noncomputable def jetCoeff (m : ℕ) (j : Fin (m + 1)) :
    MvPolynomial σ R →ₗ[R] JetPoly R σ m :=
  ((Polynomial.lcoeff (JetPoly R σ m) j).restrictScalars R).comp
    (jetSubst (R := R) m).toLinearMap

@[simp]
theorem jetCoeff_apply (m : ℕ) (j : Fin (m + 1)) (f : MvPolynomial σ R) :
    jetCoeff (R := R) m j f = relationCoeff (R := R) m j f := by
  simp [jetCoeff, relationCoeff, relationSeries, Polynomial.lcoeff_apply]

@[simp]
theorem jetSubst_X (m : ℕ) (i : σ) :
    jetSubst (R := R) m (MvPolynomial.X i) = jetSeries (R := R) m i := by
  simp [jetSubst]

@[simp]
theorem jetSubst_C (m : ℕ) (r : R) :
    jetSubst (R := R) m (MvPolynomial.C r : MvPolynomial σ R) =
      Polynomial.C (MvPolynomial.C r : JetPoly R σ m) := by
  simp [jetSubst]

@[simp]
theorem relationSeries_X (m : ℕ) (i : σ) :
    relationSeries (R := R) m (MvPolynomial.X i) = jetSeries (R := R) m i := by
  simp [relationSeries]

@[simp]
theorem relationCoeff_X (m n : ℕ) (i : σ) :
    relationCoeff (R := R) m n (MvPolynomial.X i) = jetVariable (R := R) m i n := by
  simp [relationCoeff]

@[simp]
theorem relationCoeff_C_zero (m : ℕ) (r : R) :
    relationCoeff (R := R) m 0 (MvPolynomial.C r : MvPolynomial σ R) =
      (MvPolynomial.C r : JetPoly R σ m) := by
  simp [relationCoeff, relationSeries]

@[simp]
theorem relationCoeff_C_succ (m n : ℕ) (r : R) :
    relationCoeff (R := R) m (n + 1) (MvPolynomial.C r : MvPolynomial σ R) =
      (0 : JetPoly R σ m) := by
  simp [relationCoeff, relationSeries]

theorem relationCoeff_add (m n : ℕ) (f g : MvPolynomial σ R) :
    relationCoeff (R := R) m n (f + g) =
      relationCoeff (R := R) m n f + relationCoeff (R := R) m n g := by
  simp [relationCoeff, relationSeries]

theorem relationSeries_mul (m : ℕ) (f g : MvPolynomial σ R) :
    relationSeries (R := R) m (f * g) =
      relationSeries (R := R) m f * relationSeries (R := R) m g := by
  exact map_mul (jetSubst (R := R) m) f g

theorem relationCoeff_mul (m n : ℕ) (f g : MvPolynomial σ R) :
    relationCoeff (R := R) m n (f * g) =
      ∑ ij ∈ Finset.antidiagonal n,
        relationCoeff (R := R) m ij.1 f * relationCoeff (R := R) m ij.2 g := by
  rw [relationCoeff, relationSeries_mul, Polynomial.coeff_mul]
  rfl

/-- The exact truncated Cauchy coefficient for a product of two original generators. -/
theorem relationCoeff_X_mul_X (m n : ℕ) (i j : σ) :
    relationCoeff (R := R) m n (MvPolynomial.X i * MvPolynomial.X j) =
      ∑ ab ∈ Finset.antidiagonal n,
        jetVariable (R := R) m i ab.1 * jetVariable (R := R) m j ab.2 := by
  rw [relationCoeff_mul]
  simp only [relationCoeff_X]

end

section JetOrder

variable {R : Type uR} {σ : Type uσ} [CommSemiring R]

/-- Regard an order-at-most-`m` jet variable as an order-at-most-`m + 1` jet variable. -/
def jetVarSucc (m : ℕ) : JetVar σ m → JetVar σ (m + 1) :=
  fun v => ⟨v.generator, v.order.castSucc⟩

/-- The polynomial-algebra map which retains every old jet variable at the next jet order. -/
noncomputable def jetOrderHom (m : ℕ) : JetPoly R σ m →ₐ[R] JetPoly R σ (m + 1) :=
  MvPolynomial.rename (jetVarSucc (σ := σ) m)

theorem jetOrderHom_jetVariable (m r : ℕ) (i : σ) (hr : r ≤ m) :
    jetOrderHom (R := R) m (jetVariable (R := R) m i r) =
      jetVariable (R := R) (m + 1) i r := by
  rw [jetVariable_of_le (R := R) m i r hr,
    jetVariable_of_le (R := R) (m + 1) i r (hr.trans (Nat.le_succ m))]
  simp [jetOrderHom, jetVarSucc]

/-- Raising the jet order preserves every relation coefficient already retained at order `m`. -/
theorem jetOrderHom_relationCoeff (m : ℕ) (f : MvPolynomial σ R) :
    ∀ n, n ≤ m →
      jetOrderHom (R := R) m (relationCoeff (R := R) m n f) =
        relationCoeff (R := R) (m + 1) n f := by
  induction f using MvPolynomial.induction_on with
  | C r =>
      intro n hn
      cases n <;> simp [jetOrderHom]
  | add f g hf hg =>
      intro n hn
      rw [relationCoeff_add, relationCoeff_add, map_add, hf n hn, hg n hn]
  | mul_X f i hf =>
      intro n hn
      rw [relationCoeff_mul, relationCoeff_mul, map_sum]
      apply Finset.sum_congr rfl
      intro ab hab
      have hab_eq : ab.1 + ab.2 = n := Finset.mem_antidiagonal.mp hab
      have hleft : ab.1 ≤ m := by omega
      have hright : ab.2 ≤ m := by omega
      rw [map_mul, hf ab.1 hleft, relationCoeff_X, relationCoeff_X,
        jetOrderHom_jetVariable (R := R) m ab.2 i hright]

theorem jetOrderHom_jetCoeff (m : ℕ) (f : MvPolynomial σ R) (j : Fin (m + 1)) :
    jetOrderHom (R := R) m (jetCoeff (R := R) m j f) =
      jetCoeff (R := R) (m + 1) j.castSucc f := by
  simpa only [jetCoeff_apply] using
    jetOrderHom_relationCoeff (R := R) m f j (Nat.lt_succ_iff.mp j.isLt)

end JetOrder

section RelationIdeal

variable {R : Type uR} {σ : Type uσ} [CommSemiring R]

/-- The retained Hasse--Schmidt coefficients of all relations in `I`.

At jet order `m`, only coefficients of orders `0` through `m` are imposed.  Equivalently, the
substituted relation is required to vanish modulo the auxiliary series variable to order `m + 1`.
-/
noncomputable def jetRelationSet (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    Set (JetPoly R σ m) :=
  Set.range fun fj : I × Fin (m + 1) => jetCoeff (R := R) m fj.2 fj.1.1

/-- The order-`m` jet-relation ideal generated by the retained coefficients of relations in `I`. -/
noncomputable def jetIdeal (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    Ideal (JetPoly R σ m) :=
  Ideal.span (jetRelationSet (R := R) m I)

theorem jetCoeff_mem_jetRelationSet (m : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ I) (j : Fin (m + 1)) :
    jetCoeff (R := R) m j f ∈ jetRelationSet (R := R) m I := by
  exact ⟨(⟨f, hf⟩, j), rfl⟩

theorem jetCoeff_mem_jetIdeal (m : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ I) (j : Fin (m + 1)) :
    jetCoeff (R := R) m j f ∈ jetIdeal (R := R) m I := by
  exact Ideal.subset_span (jetCoeff_mem_jetRelationSet (R := R) m I f hf j)

theorem relationCoeff_mem_jetIdeal (m n : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ I) (hn : n ≤ m) :
    relationCoeff (R := R) m n f ∈ jetIdeal (R := R) m I := by
  simpa only [jetCoeff_apply] using
    jetCoeff_mem_jetIdeal (R := R) m I f hf ⟨n, Nat.lt_succ_iff.mpr hn⟩

theorem jetRelationSet_mono (m : ℕ) {I J : Ideal (MvPolynomial σ R)} (hIJ : I ≤ J) :
    jetRelationSet (R := R) m I ⊆ jetRelationSet (R := R) m J := by
  rintro g ⟨fj, rfl⟩
  exact ⟨(⟨fj.1.1, hIJ fj.1.2⟩, fj.2), rfl⟩

theorem jetIdeal_mono (m : ℕ) {I J : Ideal (MvPolynomial σ R)} (hIJ : I ≤ J) :
    jetIdeal (R := R) m I ≤ jetIdeal (R := R) m J := by
  exact Ideal.span_mono (jetRelationSet_mono (R := R) m hIJ)

/-- The order-raising polynomial map sends old jet relations to relations at the next order. -/
theorem jetIdeal_le_comap_jetOrderHom (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    jetIdeal (R := R) m I ≤
      Ideal.comap (jetOrderHom (R := R) m).toRingHom (jetIdeal (R := R) (m + 1) I) := by
  rw [jetIdeal]
  apply Ideal.span_le.mpr
  rintro g ⟨fj, rfl⟩
  change jetOrderHom (R := R) m (jetCoeff (R := R) m fj.2 fj.1.1) ∈
    jetIdeal (R := R) (m + 1) I
  rw [jetOrderHom_jetCoeff]
  exact jetCoeff_mem_jetIdeal (R := R) (m + 1) I fj.1.1 fj.1.2 fj.2.castSucc

theorem jetOrderHom_mem_jetIdeal (m : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : JetPoly R σ m) (hf : f ∈ jetIdeal (R := R) m I) :
    jetOrderHom (R := R) m f ∈ jetIdeal (R := R) (m + 1) I := by
  exact jetIdeal_le_comap_jetOrderHom (R := R) m I hf

end RelationIdeal

section PresentedJet

variable {R : Type uR} {σ : Type uσ} [CommRing R]

/-- The presentation-level order-`m` jet algebra of `MvPolynomial σ R ⧸ I`. -/
abbrev PresentedJet (m : ℕ) (I : Ideal (MvPolynomial σ R)) :=
  JetPoly R σ m ⧸ jetIdeal (R := R) m I

/-- The canonical algebra map from the finite jet polynomial ring to its presented quotient. -/
noncomputable def presentedJetMk (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    JetPoly R σ m →ₐ[R] PresentedJet (R := R) m I :=
  Ideal.Quotient.mkₐ R (jetIdeal (R := R) m I)

@[simp]
theorem presentedJetMk_ker (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    RingHom.ker (presentedJetMk (R := R) m I : JetPoly R σ m →+* PresentedJet (R := R) m I) =
      jetIdeal (R := R) m I := by
  exact Ideal.Quotient.mkₐ_ker R (jetIdeal (R := R) m I)

theorem presentedJetMk_surjective (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    Function.Surjective (presentedJetMk (R := R) m I) := by
  exact Ideal.Quotient.mkₐ_surjective R (jetIdeal (R := R) m I)

@[simp]
theorem presentedJetMk_jetCoeff (m : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ I) (j : Fin (m + 1)) :
    presentedJetMk (R := R) m I (jetCoeff (R := R) m j f) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    (jetCoeff_mem_jetIdeal (R := R) m I f hf j)

@[simp]
theorem presentedJetMk_relationCoeff (m n : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : MvPolynomial σ R) (hf : f ∈ I) (hn : n ≤ m) :
    presentedJetMk (R := R) m I (relationCoeff (R := R) m n f) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    (relationCoeff_mem_jetIdeal (R := R) m n I f hf hn)

/-- Enlarging the input relation ideal induces the expected quotient map on presented jets. -/
noncomputable def presentedJetFactor (m : ℕ) {I J : Ideal (MvPolynomial σ R)} (hIJ : I ≤ J) :
    PresentedJet (R := R) m I →ₐ[R] PresentedJet (R := R) m J :=
  Ideal.Quotient.factorₐ R (jetIdeal_mono (R := R) m hIJ)

@[simp]
theorem presentedJetFactor_mk (m : ℕ) {I J : Ideal (MvPolynomial σ R)} (hIJ : I ≤ J)
    (f : JetPoly R σ m) :
    presentedJetFactor (R := R) m hIJ (presentedJetMk (R := R) m I f) =
      presentedJetMk (R := R) m J f := by
  rfl

/-- The order-raising polynomial map descended to presentation-level finite jet algebras. -/
noncomputable def presentedJetOrderHom (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    PresentedJet (R := R) m I →ₐ[R] PresentedJet (R := R) (m + 1) I :=
  Ideal.quotientMapₐ (jetIdeal (R := R) (m + 1) I) (jetOrderHom (R := R) m)
    (jetIdeal_le_comap_jetOrderHom (R := R) m I)

@[simp]
theorem presentedJetOrderHom_mk (m : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : JetPoly R σ m) :
    presentedJetOrderHom (R := R) m I (presentedJetMk (R := R) m I f) =
      presentedJetMk (R := R) (m + 1) I (jetOrderHom (R := R) m f) := by
  rfl

end PresentedJet

end VOA.FiniteJet
