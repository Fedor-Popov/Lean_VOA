import VOA.Filtered.ClassicalFreeness

/-!
# Infinite presentation-level jet algebras from finite jets

Every polynomial in infinitely many jet variables has finite support.  We therefore define the
infinite relation ideal inside `MvPolynomial (σ × ℕ) R` as the ideal generated by the images of
all finite jet ideals.  This gives a concrete finite-support replacement for an abstract filtered
colimit and does not require any finite jet-order transition map to be injective.

The file also constructs evaluation by divided iterates of a derivation and proves that all
relations vanish whenever the order-zero presentation relations vanish.  No comparison with the
scheme-theoretic arc functor or classical-freeness assertion is made here.
-/

namespace VOA.InfiniteJet

universe uσ uR uA

/-- The polynomial ring on all jet variables `(generator, order)`. -/
abbrev JetPoly (R : Type uR) [CommSemiring R] (σ : Type uσ) :=
  MvPolynomial (σ × ℕ) R

section FiniteInclusion

variable {R : Type uR} {σ : Type uσ} [CommSemiring R]

/-- Include a bounded jet-variable label into the unbounded label type. -/
def finiteJetVar (m : ℕ) : FiniteJet.JetVar σ m → σ × ℕ :=
  fun v ↦ (v.generator, v.order)

/-- The inclusion of finite jet labels into unbounded jet labels is injective. -/
theorem finiteJetVar_injective (m : ℕ) :
    Function.Injective (finiteJetVar (σ := σ) m) := by
  intro v w hvw
  cases v with
  | mk vg vo =>
      cases w with
      | mk wg wo =>
          simp only [finiteJetVar, Prod.mk.injEq] at hvw
          cases hvw with
          | intro hgen hord =>
              subst wg
              congr
              exact Fin.ext hord

/-- Include a finite jet polynomial in the infinite jet polynomial ring. -/
noncomputable def ofFinite (m : ℕ) :
    FiniteJet.JetPoly R σ m →ₐ[R] JetPoly R σ :=
  MvPolynomial.rename (finiteJetVar (σ := σ) m)

@[simp]
theorem ofFinite_X (m : ℕ) (v : FiniteJet.JetVar σ m) :
    ofFinite (R := R) m (MvPolynomial.X v) =
      MvPolynomial.X (v.generator, (v.order : ℕ)) := by
  simp [ofFinite, finiteJetVar]

/-- Every polynomial in unbounded jet variables already comes from some finite jet order.
This is the finite-support statement needed to reduce injectivity of an infinite jet map to
injectivity at every finite stage; no transition-map injectivity is required. -/
theorem exists_ofFinite_preimage (f : JetPoly R σ) :
    ∃ (m : ℕ) (g : FiniteJet.JetPoly R σ m), ofFinite (R := R) m g = f := by
  classical
  let m : ℕ := f.vars.sup Prod.snd
  have hvars : (↑f.vars : Set (σ × ℕ)) ⊆
      Set.range (finiteJetVar (σ := σ) m) := by
    intro v hv
    have hvle : v.2 ≤ m := by
      exact Finset.le_sup hv
    exact ⟨⟨v.1, ⟨v.2, Nat.lt_succ_iff.mpr hvle⟩⟩, rfl⟩
  obtain ⟨g, hg⟩ := MvPolynomial.exists_rename_eq_of_vars_subset_range f
    (finiteJetVar (σ := σ) m) (finiteJetVar_injective m) hvars
  exact ⟨m, g, by simpa only [ofFinite] using hg⟩

/-- The image of every finite relation-ideal element, at every finite order. -/
noncomputable def relationSet (I : Ideal (MvPolynomial σ R)) : Set (JetPoly R σ) :=
  {f | ∃ (m : ℕ) (g : FiniteJet.JetPoly R σ m),
    g ∈ FiniteJet.jetIdeal (R := R) m I ∧ ofFinite (R := R) m g = f}

/-- The infinite jet ideal, generated inside the common infinite polynomial ring by all finite
jet ideals. -/
noncomputable def jetIdeal (I : Ideal (MvPolynomial σ R)) : Ideal (JetPoly R σ) :=
  Ideal.span (relationSet (R := R) I)

/-- Every finite jet ideal maps into the infinite jet ideal. -/
theorem ofFinite_mem_jetIdeal (m : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : FiniteJet.JetPoly R σ m) (hf : f ∈ FiniteJet.jetIdeal (R := R) m I) :
    ofFinite (R := R) m f ∈ jetIdeal (R := R) I := by
  apply Ideal.subset_span
  exact ⟨m, f, hf, rfl⟩

end FiniteInclusion

section PresentedJet

variable {R : Type uR} {σ : Type uσ} [CommRing R]

/-- The presentation-level infinite jet algebra. -/
abbrev PresentedJet (I : Ideal (MvPolynomial σ R)) :=
  JetPoly R σ ⧸ jetIdeal (R := R) I

/-- The quotient map from the infinite jet polynomial ring. -/
noncomputable def presentedJetMk (I : Ideal (MvPolynomial σ R)) :
    JetPoly R σ →ₐ[R] PresentedJet (R := R) I :=
  Ideal.Quotient.mkₐ R (jetIdeal (R := R) I)

/-- Every finite presented jet algebra maps canonically to the infinite presented jet algebra. -/
noncomputable def presentedJetOfFinite (m : ℕ) (I : Ideal (MvPolynomial σ R)) :
    FiniteJet.PresentedJet (R := R) m I →ₐ[R] PresentedJet (R := R) I :=
  Ideal.quotientMapₐ (jetIdeal (R := R) I) (ofFinite (R := R) m)
    (fun _f hf ↦ ofFinite_mem_jetIdeal (R := R) m I _ hf)

@[simp]
theorem presentedJetOfFinite_mk (m : ℕ) (I : Ideal (MvPolynomial σ R))
    (f : FiniteJet.JetPoly R σ m) :
    presentedJetOfFinite (R := R) m I (FiniteJet.presentedJetMk (R := R) m I f) =
      presentedJetMk (R := R) I (ofFinite (R := R) m f) := by
  rfl

end PresentedJet

section DerivationEvaluation

variable {σ : Type uσ} {A : Type uA} [CommRing A] [Algebra ℂ A]

/-- Evaluate every unbounded jet variable by the matching divided iterate. -/
noncomputable def derivationJetEval (D : A →ₗ[ℂ] A) (x : σ → A) :
    JetPoly ℂ σ →ₐ[ℂ] A :=
  MvPolynomial.aeval fun ir ↦ FiniteJet.dividedIterate D ir.2 (x ir.1)

/-- Infinite evaluation restricts to the previously defined finite evaluation. -/
theorem derivationJetEval_comp_ofFinite (D : A →ₗ[ℂ] A) (m : ℕ) (x : σ → A) :
    (derivationJetEval D x).comp (ofFinite (R := ℂ) m) =
      FiniteJet.derivationJetEval D m x := by
  apply MvPolynomial.algHom_ext
  intro v
  simp [derivationJetEval, ofFinite, finiteJetVar,
    FiniteJet.derivationJetEval]

/-- If the order-zero presentation relations vanish, the infinite jet ideal evaluates to zero. -/
theorem derivationJetEval_jetIdeal_le_ker (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) :
    jetIdeal (R := ℂ) I ≤ RingHom.ker (derivationJetEval D x).toRingHom := by
  rw [jetIdeal, Ideal.span_le]
  rintro f ⟨m, g, hg, rfl⟩
  apply RingHom.mem_ker.mpr
  have hfinite := FiniteJet.derivationJetEval_jetIdeal_le_ker
    D hleib hOne m x I hI hg
  have hcomp := DFunLike.congr_fun (derivationJetEval_comp_ofFinite D m x) g
  calc
    derivationJetEval D x (ofFinite (R := ℂ) m g) =
        FiniteJet.derivationJetEval D m x g := by
      change ((derivationJetEval D x).comp (ofFinite (R := ℂ) m)) g = _
      exact hcomp
    _ = 0 := RingHom.mem_ker.mp hfinite

/-- Evaluation descended to the infinite presented jet algebra. -/
noncomputable def presentedJetToDifferentialAlgebra (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) :
    PresentedJet (R := ℂ) I →ₐ[ℂ] A :=
  Ideal.Quotient.liftₐ (jetIdeal (R := ℂ) I) (derivationJetEval D x)
    (fun _f hf ↦ RingHom.mem_ker.mp
      (derivationJetEval_jetIdeal_le_ker D hleib hOne x I hI hf))

@[simp]
theorem presentedJetToDifferentialAlgebra_mk (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (f : JetPoly ℂ σ) :
    presentedJetToDifferentialAlgebra D hleib hOne x I hI
        (presentedJetMk (R := ℂ) I f) =
      derivationJetEval D x f := by
  rfl

/-- The universal evaluation sends an infinite jet coordinate to the corresponding divided
iterate of its order-zero generator. -/
@[simp]
theorem presentedJetToDifferentialAlgebra_X (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (ir : σ × ℕ) :
    presentedJetToDifferentialAlgebra D hleib hOne x I hI
        (presentedJetMk (R := ℂ) I (MvPolynomial.X ir)) =
      FiniteJet.dividedIterate D ir.2 (x ir.1) := by
  rw [presentedJetToDifferentialAlgebra_mk]
  simp [derivationJetEval]

/-- Uniqueness in the differential-algebra presentation: an algebra map out of the infinite
presented jet algebra is determined by the prescribed divided iterates of the order-zero
generators. -/
theorem presentedJetToDifferentialAlgebra_unique (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (f : PresentedJet (R := ℂ) I →ₐ[ℂ] A)
    (hf : ∀ ir : σ × ℕ,
      f (presentedJetMk (R := ℂ) I (MvPolynomial.X ir)) =
        FiniteJet.dividedIterate D ir.2 (x ir.1)) :
    f = presentedJetToDifferentialAlgebra D hleib hOne x I hI := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro ir
  change f (presentedJetMk (R := ℂ) I (MvPolynomial.X ir)) = _
  rw [hf]
  exact (presentedJetToDifferentialAlgebra_X D hleib hOne x I hI ir).symm

/-- Universal mapping property of the explicit infinite jet presentation.  For any differential
commutative algebra whose order-zero points kill `I`, there is a unique algebra map sending every
jet coordinate to the matching divided derivative. -/
theorem existsUnique_presentedJetToDifferentialAlgebra (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) :
    ∃! f : PresentedJet (R := ℂ) I →ₐ[ℂ] A,
      ∀ ir : σ × ℕ,
        f (presentedJetMk (R := ℂ) I (MvPolynomial.X ir)) =
          FiniteJet.dividedIterate D ir.2 (x ir.1) := by
  refine ⟨presentedJetToDifferentialAlgebra D hleib hOne x I hI, ?_, ?_⟩
  · exact presentedJetToDifferentialAlgebra_X D hleib hOne x I hI
  · intro f hf
    exact presentedJetToDifferentialAlgebra_unique D hleib hOne x I hI f hf

/-- The infinite evaluation is compatible with every finite presented-jet evaluation. -/
theorem presentedJetToDifferentialAlgebra_ofFinite (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (m : ℕ) (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (y : FiniteJet.PresentedJet (R := ℂ) m I) :
    presentedJetToDifferentialAlgebra D hleib hOne x I hI
        (presentedJetOfFinite (R := ℂ) m I y) =
      FiniteJet.presentedJetToDifferentialAlgebra D hleib hOne m x I hI y := by
  refine Submodule.Quotient.induction_on _ y fun f ↦ ?_
  change presentedJetToDifferentialAlgebra D hleib hOne x I hI
        (presentedJetOfFinite (R := ℂ) m I
          (FiniteJet.presentedJetMk (R := ℂ) m I f)) =
      FiniteJet.presentedJetToDifferentialAlgebra D hleib hOne m x I hI
        (FiniteJet.presentedJetMk (R := ℂ) m I f)
  rw [presentedJetOfFinite_mk, presentedJetToDifferentialAlgebra_mk,
    FiniteJet.presentedJetToDifferentialAlgebra_mk]
  exact DFunLike.congr_fun (derivationJetEval_comp_ofFinite D m x) f

end DerivationEvaluation

end VOA.InfiniteJet

section AxiomAudit
#print axioms VOA.InfiniteJet.existsUnique_presentedJetToDifferentialAlgebra
end AxiomAudit
