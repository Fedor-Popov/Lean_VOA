/-!
# Roots, reflections and the Weyl group

Ebeling §1.4. A **root** of an even positive definite lattice is a vector of norm `2`, and a
**root lattice** is an even positive definite lattice generated by its roots.

Everything here is Layer A: no Euclidean embedding is used anywhere. In particular the
finiteness of the root set is proved algebraically, from Cauchy–Schwarz inside `ℤ`, rather than
through a discreteness argument in `ℝⁿ`.

## Main definitions

* `IntegralLattice.rootSet` — the set of vectors of norm `2`.
* `IntegralLattice.reflection` — `s_α x = x - ⟪x, α⟫ α`, and `reflectionIsom` its packaging as
  an isometry.
* `IntegralLattice.weylGroup` — the subgroup of the isometry group generated by the reflections
  in roots.
* `IntegralLattice.IsRootSystem`, `IntegralLattice.IsRootLattice`.

## Main results

* `IntegralLattice.IsPosDef.finite_setOf_normSq_le` — a positive definite lattice has only
  finitely many vectors of bounded norm.
* `IntegralLattice.roots_isRootSystem` — the roots of an even positive definite lattice form a
  root system (Ebeling §1.4; the ledger keys this as `Prop-1.1`).
-/

open Module (Basis finrank)

namespace IntegralLattice

variable {Γ Λ : IntegralLattice}

/-! ### Finiteness of vectors of bounded norm

`BLUEPRINT.md` assigns `finite_normSq_le` to M4 (`Lattice/Euclidean.lean`), where it would be
proved through the Euclidean realisation. It is in fact a purely algebraic statement: the map
`x ↦ (⟪bᵢ, x⟫)ᵢ` is injective on a nondegenerate lattice, and Cauchy–Schwarz bounds its image.
-/

private theorem self_le_sq (a : ℤ) : a ≤ a ^ 2 := by
  by_cases h : 0 < a
  · have h1 : 1 ≤ a := by omega
    nlinarith
  · rw [not_lt] at h
    exact h.trans (sq_nonneg a)

private theorem abs_le_sq (a : ℤ) : |a| ≤ a ^ 2 := by
  rcases abs_cases a with ⟨h, _⟩ | ⟨h, _⟩
  · rw [h]; exact self_le_sq a
  · rw [h]; simpa using self_le_sq (-a)

/-- On a lattice with a nondegenerate form the "dual coordinates" `x ↦ (⟪bᵢ, x⟫)ᵢ` in a basis
`b` determine `x`. -/
theorem injective_bilinCoords (h : Γ.IsPosDef) {ι : Type*} (b : Basis ι ℤ Γ) :
    Function.Injective (fun (x : Γ) (i : ι) => Γ.bilin (b i) x) := by
  intro x y hxy
  have hz : ∀ i, Γ.bilin (b i) (x - y) = 0 := by
    intro i
    rw [bilin_sub_right, sub_eq_zero]
    exact congrFun hxy i
  have hflip : Γ.bilin.flip (x - y) = 0 := by
    refine b.ext fun i => ?_
    simp only [LinearMap.flip_apply, LinearMap.zero_apply]
    exact hz i
  have h0 : normSq (x - y) = 0 := by
    have h1 := LinearMap.congr_fun hflip (x - y)
    rw [LinearMap.flip_apply, LinearMap.zero_apply] at h1
    exact h1
  exact sub_eq_zero.mp (h.normSq_eq_zero_iff.mp h0)

/-- **A positive definite lattice has only finitely many vectors of any bounded norm.**
Proved inside `ℤ`: Cauchy–Schwarz bounds each dual coordinate `⟪bᵢ, x⟫` by `⟪bᵢ,bᵢ⟫ · N`, and
the dual coordinates are injective. -/
theorem IsPosDef.finite_setOf_normSq_le (h : Γ.IsPosDef) (N : ℤ) :
    {x : Γ | normSq x ≤ N}.Finite := by
  classical
  set b := Γ.chooseBasis with hb
  set K : Fin Γ.rank → ℤ := fun i => normSq (b i) * N with hK
  refine Set.Finite.of_injOn (f := fun (x : Γ) (i : Fin Γ.rank) => Γ.bilin (b i) x)
    (t := {g : Fin Γ.rank → ℤ | ∀ i, g i ∈ Set.Icc (-(K i)) (K i)}) ?_
    ((injective_bilinCoords h b).injOn) ?_
  · intro x hx i
    have hx' : normSq x ≤ N := hx
    have hcs : (Γ.bilin (b i) x) ^ 2 ≤ normSq (b i) * normSq x := h.bilin_sq_le _ _
    have hbi : 0 ≤ normSq (b i) := h.normSq_nonneg _
    have hle : (Γ.bilin (b i) x) ^ 2 ≤ K i :=
      hcs.trans (by rw [hK]; exact mul_le_mul_of_nonneg_left hx' hbi)
    have habs : |Γ.bilin (b i) x| ≤ K i := (abs_le_sq _).trans hle
    exact Set.mem_Icc.mpr ⟨neg_le_of_abs_le habs, le_of_abs_le habs⟩
  · exact Set.Finite.pi' fun i => Set.finite_Icc _ _

/-! ### Roots -/

/-- The **root set** of a lattice: the vectors of norm `2`. Ebeling §1.4. -/
def rootSet (Γ : IntegralLattice) : Set Γ := {x : Γ | normSq x = 2}

@[simp] theorem mem_rootSet {x : Γ} : x ∈ Γ.rootSet ↔ normSq x = 2 := Iff.rfl

theorem normSq_of_mem_rootSet {x : Γ} (hx : x ∈ Γ.rootSet) : normSq x = 2 := hx

theorem neg_mem_rootSet {x : Γ} (hx : x ∈ Γ.rootSet) : -x ∈ Γ.rootSet := by
  simpa [rootSet] using hx

theorem zero_notMem_rootSet (Γ : IntegralLattice) : (0 : Γ) ∉ Γ.rootSet := by
  simp [rootSet]

theorem ne_zero_of_mem_rootSet {x : Γ} (hx : x ∈ Γ.rootSet) : x ≠ 0 := by
  rintro rfl; exact Γ.zero_notMem_rootSet hx

/-- The root set of a positive definite lattice is finite. -/
theorem IsPosDef.finite_rootSet (h : Γ.IsPosDef) : Γ.rootSet.Finite :=
  (h.finite_setOf_normSq_le 2).subset fun _ hx => le_of_eq hx

/-- The roots of a positive definite lattice as a `Finset`. -/
noncomputable def rootFinset (Γ : IntegralLattice) (h : Γ.IsPosDef) : Finset Γ :=
  h.finite_rootSet.toFinset

@[simp] theorem mem_rootFinset {h : Γ.IsPosDef} {x : Γ} :
    x ∈ Γ.rootFinset h ↔ x ∈ Γ.rootSet := by
  simp [rootFinset]

/-- The number of roots, `|R|` in Ebeling's notation. It is `0` on a lattice that is not
positive definite, which is harmless: every statement about it carries `IsPosDef`. -/
noncomputable def numRoots (Γ : IntegralLattice) : ℕ := Γ.rootSet.ncard

theorem numRoots_eq_card (h : Γ.IsPosDef) : Γ.numRoots = (Γ.rootFinset h).card :=
  Set.ncard_eq_toFinset_card _ h.finite_rootSet

/-- The **Coxeter number** `h = |R| / n` of a root lattice (Ebeling §1.4, after Table 1.1). -/
noncomputable def coxeterNumber (Γ : IntegralLattice) : ℕ := Γ.numRoots / Γ.rank

/-! ### The arithmetic of two roots

The whole of §1.4 rests on the fact that two roots of a positive definite lattice have inner
product in `{0, ±1, ±2}`, with `±2` only for `±` the same root. Ebeling deduces this from
Cauchy–Schwarz; here it is cheaper to read it off from `(α ∓ β)² ≥ 0`. -/

theorem bilin_le_two (h : Γ.IsPosDef) {α β : Γ} (hα : α ∈ Γ.rootSet) (hβ : β ∈ Γ.rootSet) :
    Γ.bilin α β ≤ 2 := by
  have := h.normSq_nonneg (α - β)
  rw [normSq_sub, normSq_of_mem_rootSet hα, normSq_of_mem_rootSet hβ] at this
  omega

theorem neg_two_le_bilin (h : Γ.IsPosDef) {α β : Γ} (hα : α ∈ Γ.rootSet) (hβ : β ∈ Γ.rootSet) :
    -2 ≤ Γ.bilin α β := by
  have := h.normSq_nonneg (α + β)
  rw [normSq_add, normSq_of_mem_rootSet hα, normSq_of_mem_rootSet hβ] at this
  omega

theorem bilin_eq_two_iff (h : Γ.IsPosDef) {α β : Γ} (hα : α ∈ Γ.rootSet) (hβ : β ∈ Γ.rootSet) :
    Γ.bilin α β = 2 ↔ α = β := by
  constructor
  · intro hab
    have : normSq (α - β) = 0 := by
      rw [normSq_sub, normSq_of_mem_rootSet hα, normSq_of_mem_rootSet hβ, hab]; ring
    exact sub_eq_zero.mp (h.normSq_eq_zero_iff.mp this)
  · rintro rfl; exact normSq_of_mem_rootSet hα

theorem bilin_eq_neg_two_iff (h : Γ.IsPosDef) {α β : Γ} (hα : α ∈ Γ.rootSet)
    (hβ : β ∈ Γ.rootSet) : Γ.bilin α β = -2 ↔ α = -β := by
  constructor
  · intro hab
    have h0 : normSq (α + β) = 0 := by
      rw [normSq_add, normSq_of_mem_rootSet hα, normSq_of_mem_rootSet hβ, hab]; ring
    exact eq_neg_of_add_eq_zero_left (h.normSq_eq_zero_iff.mp h0)
  · rintro rfl
    have hb : Γ.bilin β β = 2 := normSq_of_mem_rootSet hβ
    simp [hb]

/-- If two roots meet at inner product `1` their difference is again a root: this is what makes
the diagram combinatorics of §1.4 work. -/
theorem sub_mem_rootSet {α β : Γ} (hα : α ∈ Γ.rootSet) (hβ : β ∈ Γ.rootSet)
    (h1 : Γ.bilin α β = 1) : α - β ∈ Γ.rootSet := by
  have : normSq (α - β) = 2 := by
    rw [normSq_sub, normSq_of_mem_rootSet hα, normSq_of_mem_rootSet hβ, h1]; norm_num
  exact this


/-! ### Reflections -/

/-- The **reflection** `s_α x = x - ⟪x, α⟫ α`. Ebeling §1.4 writes this for a root `α`, where
`⟪α,α⟫ = 2` turns the usual `x - 2⟪x,α⟫/⟪α,α⟫ · α` into this integral formula. The definition
is given for arbitrary `α`; the isometry statements below carry `normSq α = 2`. -/
def reflection (Γ : IntegralLattice) (α : Γ) : Γ →ₗ[ℤ] Γ :=
  LinearMap.id - (LinearMap.toSpanSingleton ℤ Γ α).comp (Γ.bilin.flip α)

@[simp] theorem reflection_apply (α x : Γ) : Γ.reflection α x = x - Γ.bilin x α • α := by
  simp [reflection, LinearMap.toSpanSingleton]

@[simp] theorem reflection_zero (Γ : IntegralLattice) (α : Γ) : Γ.reflection α 0 = 0 :=
  map_zero _

/-- A reflection sends its own axis to its negative. -/
@[simp] theorem reflection_self {α : Γ} (hα : normSq α = 2) : Γ.reflection α α = -α := by
  rw [reflection_apply, show Γ.bilin α α = 2 from hα]
  module

/-- Reflections are involutions. -/
theorem reflection_reflection {α : Γ} (hα : normSq α = 2) (x : Γ) :
    Γ.reflection α (Γ.reflection α x) = x := by
  have hαα : Γ.bilin α α = 2 := hα
  rw [reflection_apply, reflection_apply, bilin_sub_left, bilin_smul_left, hαα]
  module

/-- Reflections preserve the form. -/
theorem bilin_reflection {α : Γ} (hα : normSq α = 2) (x y : Γ) :
    Γ.bilin (Γ.reflection α x) (Γ.reflection α y) = Γ.bilin x y := by
  have hαα : Γ.bilin α α = 2 := hα
  simp only [reflection_apply, bilin_sub_left, bilin_sub_right, bilin_smul_left,
    bilin_smul_right, hαα]
  rw [Γ.bilin_symm α y]
  ring

@[simp] theorem normSq_reflection {α : Γ} (hα : normSq α = 2) (x : Γ) :
    normSq (Γ.reflection α x) = normSq x := bilin_reflection hα x x

/-! ### The isometry group -/

namespace Isom

@[ext] theorem ext {f g : Γ ≃ₗᵢ Λ} (h : ∀ x, f x = g x) : f = g := by
  obtain ⟨fe, hf⟩ := f
  obtain ⟨ge, hg⟩ := g
  simp only [Isom.mk.injEq]
  exact LinearEquiv.ext h

@[simp] theorem refl_apply (Γ : IntegralLattice) (x : Γ) : Isom.refl Γ x = x := rfl

@[simp] theorem trans_apply {Ξ : IntegralLattice} (f : Γ ≃ₗᵢ Λ) (g : Λ ≃ₗᵢ Ξ) (x : Γ) :
    f.trans g x = g (f x) := rfl

/-- The isometries of a lattice form a group, with `f * g` acting as `f ∘ g`. -/
instance instGroup (Γ : IntegralLattice) : Group (Γ ≃ₗᵢ Γ) where
  mul f g := g.trans f
  one := Isom.refl Γ
  inv := Isom.symm
  mul_assoc _ _ _ := rfl
  one_mul _ := rfl
  mul_one _ := rfl
  inv_mul_cancel f := by ext x; exact f.symm_apply_apply x

@[simp] theorem mul_apply (f g : Γ ≃ₗᵢ Γ) (x : Γ) : (f * g) x = f (g x) := rfl

@[simp] theorem one_apply (x : Γ) : (1 : Γ ≃ₗᵢ Γ) x = x := rfl

@[simp] theorem inv_apply (f : Γ ≃ₗᵢ Γ) (x : Γ) : f⁻¹ x = f.symm x := rfl

end Isom

/-- A reflection in a root, packaged as an isometry of the lattice. -/
def reflectionIsom (Γ : IntegralLattice) {α : Γ} (hα : normSq α = 2) : Γ ≃ₗᵢ Γ where
  toLinearEquiv :=
    { Γ.reflection α with
      invFun := Γ.reflection α
      left_inv := reflection_reflection hα
      right_inv := reflection_reflection hα }
  map_bilin' := bilin_reflection hα

@[simp] theorem reflectionIsom_apply {α : Γ} (hα : normSq α = 2) (x : Γ) :
    Γ.reflectionIsom hα x = x - Γ.bilin x α • α := reflection_apply α x

theorem reflectionIsom_sq {α : Γ} (hα : normSq α = 2) :
    Γ.reflectionIsom hα * Γ.reflectionIsom hα = 1 := by
  ext x; exact reflection_reflection hα x

/-! ### The Weyl group -/

/-- The **Weyl group** `W(Γ)`: the subgroup of the isometry group generated by the reflections
in the roots of `Γ`. Ebeling §1.4. -/
def weylGroup (Γ : IntegralLattice) : Subgroup (Γ ≃ₗᵢ Γ) :=
  Subgroup.closure {f : Γ ≃ₗᵢ Γ | ∃ α : Γ, ∃ hα : normSq α = 2, f = Γ.reflectionIsom hα}

theorem reflectionIsom_mem_weylGroup {α : Γ} (hα : normSq α = 2) :
    Γ.reflectionIsom hα ∈ Γ.weylGroup :=
  Subgroup.subset_closure ⟨α, hα, rfl⟩

/-- Every element of the Weyl group maps the root set into itself. -/
theorem mapsTo_rootSet_of_mem_weylGroup {f : Γ ≃ₗᵢ Γ} (_hf : f ∈ Γ.weylGroup) :
    Set.MapsTo f Γ.rootSet Γ.rootSet := fun x hx => by
  simpa [rootSet] using (f.map_normSq x).trans hx

/-! ### Root systems

Ebeling states in §1.4 that the roots of an even positive definite lattice form a root system;
the ledger keys this as `Prop-1.1`. Following `BLUEPRINT.md` D3 the axioms are recorded
directly rather than through Mathlib's `RootPairing`, which carries a coroot map and a
`PerfectPairing` that this development never uses. -/

/-- The defining properties of the root set of a positive definite lattice: it is finite, misses
`0`, contains no multiple of a root other than `±` the root itself, and is stable under all the
reflections it generates. -/
structure IsRootSystem (Γ : IntegralLattice) : Prop where
  /-- There are only finitely many roots. -/
  finite : Γ.rootSet.Finite
  /-- `0` is not a root. -/
  zero_notMem : (0 : Γ) ∉ Γ.rootSet
  /-- The only integer multiples of a root that are roots are `±` the root. -/
  zsmul_mem_iff : ∀ {α : Γ}, α ∈ Γ.rootSet → ∀ {c : ℤ}, c • α ∈ Γ.rootSet ↔ (c = 1 ∨ c = -1)
  /-- The root set is stable under the reflection in any of its members. -/
  reflection_mem : ∀ {α β : Γ}, α ∈ Γ.rootSet → β ∈ Γ.rootSet → Γ.reflection α β ∈ Γ.rootSet

/-- **Ebeling §1.4 (`Prop-1.1` in the ledger).** The roots of a positive definite lattice form a
root system. -/
theorem roots_isRootSystem (h : Γ.IsPosDef) : Γ.IsRootSystem where
  finite := h.finite_rootSet
  zero_notMem := Γ.zero_notMem_rootSet
  zsmul_mem_iff := by
    intro α hα c
    have hα2 : normSq α = 2 := hα
    constructor
    · intro hc
      have hcc : normSq (c • α) = 2 := hc
      rw [normSq_zsmul, hα2] at hcc
      have hc2 : c ^ 2 = 1 := by linarith
      have hcc2 : c * c = 1 := by rw [pow_two] at hc2; exact hc2
      exact Int.eq_one_or_neg_one_of_mul_eq_one hcc2
    · rintro (rfl | rfl) <;> simp only [mem_rootSet, normSq_zsmul, hα2] <;> norm_num
  reflection_mem := by
    intro α β hα hβ
    have hα2 : normSq α = 2 := hα
    show normSq (Γ.reflection α β) = 2
    rw [normSq_reflection hα2]
    exact hβ

/-! ### Root lattices -/

/-- A **root lattice**: an even, positive definite lattice generated by its roots.
Ebeling §1.4. -/
structure IsRootLattice (Γ : IntegralLattice) : Prop where
  /-- Every vector has even norm. -/
  isEven : Γ.IsEven
  /-- The form is positive definite. -/
  isPosDef : Γ.IsPosDef
  /-- The roots generate the lattice. -/
  span_rootSet : Submodule.span ℤ Γ.rootSet = ⊤

namespace IsRootLattice

theorem finite_rootSet (hΓ : Γ.IsRootLattice) : Γ.rootSet.Finite :=
  hΓ.isPosDef.finite_rootSet

theorem isRootSystem (hΓ : Γ.IsRootLattice) : Γ.IsRootSystem :=
  roots_isRootSystem hΓ.isPosDef

/-- A root lattice is transported along an isometry. -/
theorem of_isom (hΓ : Γ.IsRootLattice) (f : Γ ≃ₗᵢ Λ) : Λ.IsRootLattice where
  isEven := f.isEven hΓ.isEven
  isPosDef := f.isPosDef hΓ.isPosDef
  span_rootSet := by
    have himg : (f.toLinearEquiv : Γ →ₗ[ℤ] Λ) '' Γ.rootSet = Λ.rootSet := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        show normSq (f x) = 2
        rw [f.map_normSq]; exact hx
      · intro hy
        refine ⟨f.symm y, ?_, f.apply_symm_apply y⟩
        show normSq (f.symm y) = 2
        have h1 : normSq (f (f.symm y)) = normSq (f.symm y) := f.map_normSq _
        rw [f.apply_symm_apply] at h1
        rw [← h1]; exact hy
    rw [← himg, ← Submodule.map_span, hΓ.span_rootSet]
    simp

end IsRootLattice


/-! ### Sublattices and orthogonal splittings

`ofSubmodule` itself comes from `Lattice/Sublattice.lean` (M2). What is added here is the
inclusion as a *linear map*, which `Submodule.map_span` needs, and the notion of two submodules
being orthogonal to each other — the input to an orthogonal splitting. Both are general lattice
statements and should migrate to M2; see `HANDOFF.md`. -/

/-- The inclusion of a sublattice into the ambient lattice, as a `ℤ`-linear map. Working through
this map rather than through the subtype coercion is what lets `Submodule.map_span` apply. -/
def subInc (Γ : IntegralLattice) (M : Submodule ℤ Γ) : (Γ.ofSubmodule M) →ₗ[ℤ] Γ := M.subtype

theorem subInc_injective (M : Submodule ℤ Γ) : Function.Injective (Γ.subInc M) :=
  fun _ _ h => Subtype.ext h

@[simp] theorem subInc_mem (M : Submodule ℤ Γ) (x : Γ.ofSubmodule M) : Γ.subInc M x ∈ M :=
  Subtype.property x

theorem range_subInc (M : Submodule ℤ Γ) : LinearMap.range (Γ.subInc M) = M :=
  M.range_subtype

@[simp] theorem bilin_subInc (M : Submodule ℤ Γ) (x y : Γ.ofSubmodule M) :
    (Γ.ofSubmodule M).bilin x y = Γ.bilin (Γ.subInc M x) (Γ.subInc M y) := rfl

@[simp] theorem normSq_subInc (M : Submodule ℤ Γ) (x : Γ.ofSubmodule M) :
    normSq x = normSq (Γ.subInc M x) := rfl

theorem subInc_eq_zero_iff (M : Submodule ℤ Γ) {x : Γ.ofSubmodule M} :
    Γ.subInc M x = 0 ↔ x = 0 :=
  ⟨fun h => Γ.subInc_injective M (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩

/-- The roots of a sublattice are exactly the roots of the ambient lattice that lie in it. -/
theorem image_rootSet_subInc (M : Submodule ℤ Γ) :
    (Γ.subInc M) '' (Γ.ofSubmodule M).rootSet = Γ.rootSet ∩ (M : Set Γ) := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    have h2 : normSq (Γ.subInc M x) = 2 := hx
    exact ⟨h2, Γ.subInc_mem M x⟩
  · rintro ⟨hy, hyM⟩
    obtain ⟨x, hx⟩ : ∃ x, Γ.subInc M x = y := by
      have hmem : y ∈ LinearMap.range (Γ.subInc M) := by
        rw [range_subInc]; exact SetLike.mem_coe.mp hyM
      exact hmem
    refine ⟨x, ?_, hx⟩
    have h2 : normSq (Γ.subInc M x) = 2 := by rw [hx]; exact hy
    exact h2

/-- Two submodules are orthogonal when the form kills every pair drawn from them. -/
def IsOrthogonal (Γ : IntegralLattice) (M N : Submodule ℤ Γ) : Prop :=
  ∀ x ∈ M, ∀ y ∈ N, Γ.bilin x y = 0

theorem IsOrthogonal.symm {M N : Submodule ℤ Γ} (h : Γ.IsOrthogonal M N) :
    Γ.IsOrthogonal N M := fun x hx y hy => by rw [Γ.bilin_symm]; exact h y hy x hx

/-- An internal orthogonal splitting of a lattice, as an isometry from the external orthogonal
sum of its two pieces. Ebeling writes the conclusion `Γ = M ⊥ N`. -/
noncomputable def orthSplit (Γ : IntegralLattice) {M N : Submodule ℤ Γ} (hc : IsCompl M N)
    (ho : Γ.IsOrthogonal M N) : (Γ.ofSubmodule M ⊞ Γ.ofSubmodule N) ≃ₗᵢ Γ where
  toLinearEquiv := Submodule.prodEquivOfIsCompl M N hc
  map_bilin' x y := by
    have h12 : Γ.bilin (Γ.subInc M x.1) (Γ.subInc N y.2) = 0 :=
      ho _ (Γ.subInc_mem M x.1) _ (Γ.subInc_mem N y.2)
    have h21 : Γ.bilin (Γ.subInc N x.2) (Γ.subInc M y.1) = 0 :=
      ho.symm _ (Γ.subInc_mem N x.2) _ (Γ.subInc_mem M y.1)
    show Γ.bilin (Γ.subInc M x.1 + Γ.subInc N x.2) (Γ.subInc M y.1 + Γ.subInc N y.2)
        = Γ.bilin (Γ.subInc M x.1) (Γ.subInc M y.1) + Γ.bilin (Γ.subInc N x.2) (Γ.subInc N y.2)
    rw [bilin_add_left, bilin_add_right, bilin_add_right, h12, h21]
    ring

theorem rank_eq_of_orthSplit {M N : Submodule ℤ Γ} (hc : IsCompl M N)
    (ho : Γ.IsOrthogonal M N) :
    Γ.rank = (Γ.ofSubmodule M).rank + (Γ.ofSubmodule N).rank := by
  rw [← rank_orthSum]
  exact ((Γ.orthSplit hc ho).rank_eq).symm

/-! ### Reducible and irreducible lattices -/

/-- A lattice is **reducible** when it is the internal orthogonal direct sum of two nonzero
sublattices; Ebeling §1.4. -/
def IsReducible (Γ : IntegralLattice) : Prop :=
  ∃ M N : Submodule ℤ Γ, M ≠ ⊥ ∧ N ≠ ⊥ ∧ IsCompl M N ∧ Γ.IsOrthogonal M N

/-- A lattice is **irreducible** when it is nonzero and not reducible; Ebeling §1.4. -/
def IsIrreducible (Γ : IntegralLattice) : Prop := Γ.rank ≠ 0 ∧ ¬ Γ.IsReducible

/-- Reducibility is preserved by lattice isometry. -/
theorem IsReducible.isom {Γ Λ : IntegralLattice} (h : Γ.IsReducible) (f : Γ ≃ₗᵢ Λ) :
    Λ.IsReducible := by
  obtain ⟨M, N, hM, hN, hc, ho⟩ := h
  let M' : Submodule ℤ Λ := Submodule.map f.toLinearEquiv.toLinearMap M
  let N' : Submodule ℤ Λ := Submodule.map f.toLinearEquiv.toLinearMap N
  have hM' : M' ≠ ⊥ := by
    intro hz
    apply hM
    exact (Submodule.map_eq_bot_iff (e := f.toLinearEquiv)).mp hz
  have hN' : N' ≠ ⊥ := by
    intro hz
    apply hN
    exact (Submodule.map_eq_bot_iff (e := f.toLinearEquiv)).mp hz
  have hinf : M' ⊓ N' = ⊥ := by
    rw [← Submodule.map_inf f.toLinearEquiv.toLinearMap f.toLinearEquiv.injective,
      hc.inf_eq_bot, Submodule.map_bot]
  have hsup : M' ⊔ N' = ⊤ := by
    rw [← Submodule.map_sup, hc.sup_eq_top, Submodule.map_top]
    exact LinearMap.range_eq_top.mpr f.toLinearEquiv.surjective
  have hc' : IsCompl M' N' := by
    apply IsCompl.mk
    · exact disjoint_iff_inf_le.mpr (by rw [hinf])
    · exact codisjoint_iff_le_sup.mpr (by rw [hsup])
  refine ⟨M', N', hM', hN', hc', ?_⟩
  rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
  exact (f.map_bilin x y).trans (ho x hx y hy)

/-- Irreducibility is preserved by lattice isometry. -/
theorem IsIrreducible.isom {Γ Λ : IntegralLattice} (h : Γ.IsIrreducible)
    (f : Γ ≃ₗᵢ Λ) : Λ.IsIrreducible := by
  refine ⟨fun hr => h.1 (f.rank_eq.trans hr), ?_⟩
  intro hred
  exact h.2 (hred.isom f.symm)

/-- The root-lattice property is preserved by lattice isometry. -/
theorem IsRootLattice.isom {Γ Λ : IntegralLattice} (h : Γ.IsRootLattice)
    (f : Γ ≃ₗᵢ Λ) : Λ.IsRootLattice where
  isEven := f.isEven h.isEven
  isPosDef := f.isPosDef h.isPosDef
  span_rootSet := by
    have himage : f '' Γ.rootSet = Λ.rootSet := by
      ext z
      constructor
      · rintro ⟨x, hx, rfl⟩
        show normSq (f x) = 2
        rw [f.map_normSq]
        exact hx
      · intro hz
        refine ⟨f.symm z, ?_, f.apply_symm_apply z⟩
        show normSq (f.symm z) = 2
        rw [f.symm.map_normSq]
        exact hz
    rw [← himage]
    have hs : Submodule.map f.toLinearEquiv.toLinearMap
        (Submodule.span ℤ Γ.rootSet) = ⊤ := by
      rw [h.span_rootSet, Submodule.map_top]
      exact LinearMap.range_eq_top.mpr f.toLinearEquiv.surjective
    rw [Submodule.map_span] at hs
    exact hs

theorem rank_ne_zero_of_ne_bot {M : Submodule ℤ Γ} (hM : M ≠ ⊥) :
    (Γ.ofSubmodule M).rank ≠ 0 := by
  have hnt : Nontrivial M := Submodule.nontrivial_iff_ne_bot.mpr hM
  have hpos : 0 < Module.finrank ℤ M := (Module.finrank_pos_iff_of_free ℤ M).mpr hnt
  show Module.finrank ℤ M ≠ 0
  omega


/-! ### Functoriality of the orthogonal sum

`Lattice/Defs.lean` (M1) builds `⊞` and its numerical invariants but not its functoriality; the
three isometries below are what an iterated decomposition needs. They are general lattice
statements and belong in M1 or M2 eventually. -/

/-- Orthogonal sums are functorial in isometries. -/
def Isom.orthSumCongr {Γ Γ' Λ Λ' : IntegralLattice} (f : Γ ≃ₗᵢ Γ') (g : Λ ≃ₗᵢ Λ') :
    (Γ ⊞ Λ) ≃ₗᵢ (Γ' ⊞ Λ') where
  toLinearEquiv := f.toLinearEquiv.prodCongr g.toLinearEquiv
  map_bilin' x y := by
    show Γ'.bilin (f x.1) (f y.1) + Λ'.bilin (g x.2) (g y.2)
        = Γ.bilin x.1 y.1 + Λ.bilin x.2 y.2
    rw [f.map_bilin, g.map_bilin]

/-- Associativity of the orthogonal sum. -/
def orthSumAssoc (Γ Λ Ξ : IntegralLattice) : (Γ ⊞ (Λ ⊞ Ξ)) ≃ₗᵢ ((Γ ⊞ Λ) ⊞ Ξ) where
  toLinearEquiv :=
    { toFun := fun x => ((x.1, x.2.1), x.2.2)
      invFun := fun x => (x.1.1, (x.1.2, x.2))
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  map_bilin' x y := by
    show (Γ.bilin x.1 y.1 + Λ.bilin x.2.1 y.2.1) + Ξ.bilin x.2.2 y.2.2
        = Γ.bilin x.1 y.1 + (Λ.bilin x.2.1 y.2.1 + Ξ.bilin x.2.2 y.2.2)
    ring

/-- A rank-zero summand can be discarded. -/
def orthSumSubsingletonRight (Γ Z : IntegralLattice) (hZ : Subsingleton Z.carrier) :
    (Γ ⊞ Z) ≃ₗᵢ Γ where
  toLinearEquiv :=
    { toFun := Prod.fst
      invFun := fun x => (x, 0)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      left_inv := fun x => Prod.ext rfl (hZ.elim _ _)
      right_inv := fun _ => rfl }
  map_bilin' x y := by
    show Γ.bilin x.1 y.1 = Γ.bilin x.1 y.1 + Z.bilin x.2 y.2
    rw [hZ.elim x.2 0, map_zero]
    simp

/-- A rank-zero summand can be discarded, on the left. -/
def orthSumSubsingletonLeft (Z Γ : IntegralLattice) (hZ : Subsingleton Z.carrier) :
    (Z ⊞ Γ) ≃ₗᵢ Γ where
  toLinearEquiv :=
    { toFun := Prod.snd
      invFun := fun x => (0, x)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      left_inv := fun x => Prod.ext (hZ.elim _ _) rfl
      right_inv := fun _ => rfl }
  map_bilin' x y := by
    show Γ.bilin x.2 y.2 = Z.bilin x.1 y.1 + Γ.bilin x.2 y.2
    rw [hZ.elim x.1 0, map_zero]
    simp

/-- Any two rank-zero lattices are isometric. -/
def isomOfSubsingleton (Γ Λ : IntegralLattice) (hΓ : Subsingleton Γ.carrier)
    (hΛ : Subsingleton Λ.carrier) : Γ ≃ₗᵢ Λ where
  toLinearEquiv :=
    { toFun := fun _ => 0
      invFun := fun _ => 0
      map_add' := fun _ _ => by simp
      map_smul' := fun _ _ => by simp
      left_inv := fun _ => hΓ.elim _ _
      right_inv := fun _ => hΛ.elim _ _ }
  map_bilin' x y := by
    show Λ.bilin 0 0 = Γ.bilin x y
    rw [hΓ.elim x 0, hΓ.elim y 0]
    simp

theorem subsingleton_of_rank_eq_zero (h : Γ.rank = 0) : Subsingleton Γ.carrier :=
  (Module.finrank_eq_zero_iff_of_free ℤ Γ.carrier).mp h

end IntegralLattice

/-! ### The orthogonal decomposition of a root lattice

Ebeling §1.4: a root lattice is the orthogonal direct sum of irreducible root lattices — the
summands of the Coxeter–Dynkin diagram's connected components. The ledger keys this as
`Prop-1.2`; note that Ebeling's own Proposition 1.2 is the discriminant statement of §1.1, which
belongs to M2. See `HANDOFF.md`. -/

namespace RootLattice

open IntegralLattice

variable {Γ : IntegralLattice}

/-- Every root of a lattice that splits orthogonally lies wholly in one of the two summands:
its components have even nonnegative norms adding to `2`, so one of them vanishes. -/
theorem rootSet_subset_union (hΓ : Γ.IsRootLattice) {M N : Submodule ℤ Γ}
    (hc : IsCompl M N) (ho : Γ.IsOrthogonal M N) :
    Γ.rootSet ⊆ (M : Set Γ) ∪ (N : Set Γ) := by
  intro x hx
  have hxtop : x ∈ M ⊔ N := by rw [hc.sup_eq_top]; trivial
  obtain ⟨m, hm, n, hn, hmn⟩ := Submodule.mem_sup.mp hxtop
  have hmn0 : Γ.bilin m n = 0 := ho m hm n hn
  have hsum : normSq m + normSq n = 2 := by
    have : normSq x = 2 := hx
    rw [← hmn, normSq_add, hmn0] at this
    omega
  have hm0 : 0 ≤ normSq m := hΓ.isPosDef.normSq_nonneg m
  have hn0 : 0 ≤ normSq n := hΓ.isPosDef.normSq_nonneg n
  have hme : (2 : ℤ) ∣ normSq m := hΓ.isEven m
  have hne : (2 : ℤ) ∣ normSq n := hΓ.isEven n
  rcases (by omega : normSq m = 0 ∨ normSq n = 0) with h | h
  · right
    have : m = 0 := hΓ.isPosDef.normSq_eq_zero_iff.mp h
    rw [this, zero_add] at hmn
    exact SetLike.mem_coe.mpr (hmn ▸ hn)
  · left
    have : n = 0 := hΓ.isPosDef.normSq_eq_zero_iff.mp h
    rw [this, add_zero] at hmn
    exact SetLike.mem_coe.mpr (hmn ▸ hm)

/-- In an orthogonal splitting of a root lattice, each summand is generated by the roots it
contains. -/
theorem span_rootSet_inter (hΓ : Γ.IsRootLattice) {M N : Submodule ℤ Γ}
    (hc : IsCompl M N) (ho : Γ.IsOrthogonal M N) :
    Submodule.span ℤ (Γ.rootSet ∩ (M : Set Γ)) = M := by
  set P := Submodule.span ℤ (Γ.rootSet ∩ (M : Set Γ)) with hP
  set Q := Submodule.span ℤ (Γ.rootSet ∩ (N : Set Γ)) with hQ
  have hPM : P ≤ M := Submodule.span_le.mpr fun _ hz => hz.2
  have hQN : Q ≤ N := Submodule.span_le.mpr fun _ hz => hz.2
  have htop : P ⊔ Q = ⊤ := by
    refine top_le_iff.mp ?_
    rw [← hΓ.span_rootSet]
    refine Submodule.span_le.mpr fun z hz => ?_
    rcases rootSet_subset_union hΓ hc ho hz with hzM | hzN
    · exact Submodule.mem_sup_left (Submodule.subset_span ⟨hz, hzM⟩)
    · exact Submodule.mem_sup_right (Submodule.subset_span ⟨hz, hzN⟩)
  refine le_antisymm hPM fun m hm => ?_
  have hmtop : m ∈ P ⊔ Q := by rw [htop]; trivial
  obtain ⟨pp, hpp, q, hq, hpq⟩ := Submodule.mem_sup.mp hmtop
  have hqM : q ∈ M := by
    have : q = m - pp := by rw [← hpq]; abel
    rw [this]
    exact M.sub_mem hm (hPM hpp)
  have hq0 : q = 0 := by
    have : q ∈ M ⊓ N := ⟨hqM, hQN hq⟩
    rw [hc.inf_eq_bot] at this
    simpa using this
  rw [hq0, add_zero] at hpq
  exact hpq ▸ hpp

/-- Each summand of an orthogonal splitting of a root lattice is itself a root lattice. -/
theorem isRootLattice_ofSubmodule (hΓ : Γ.IsRootLattice) {M N : Submodule ℤ Γ}
    (hc : IsCompl M N) (ho : Γ.IsOrthogonal M N) : (Γ.ofSubmodule M).IsRootLattice where
  isEven := Γ.isEven_ofSubmodule hΓ.isEven
  isPosDef := Γ.isPosDef_ofSubmodule hΓ.isPosDef
  span_rootSet := by
    have h1 : Submodule.map (Γ.subInc M) (Submodule.span ℤ (Γ.ofSubmodule M).rootSet) = M := by
      rw [Submodule.map_span, image_rootSet_subInc]
      exact span_rootSet_inter hΓ hc ho
    have h2 : Submodule.map (Γ.subInc M) ⊤ = M := by
      rw [Submodule.map_top, range_subInc]
    exact Submodule.map_injective_of_injective (Γ.subInc_injective M) (h1.trans h2.symm)

/-! ### Iterated orthogonal sums -/

/-- The rank-zero lattice, the unit for `⊞`. -/
def trivialLattice : IntegralLattice :=
  IntegralLattice.ofGram (0 : Matrix (Fin 0) (Fin 0) ℤ) (by ext i; exact i.elim0)

theorem subsingleton_trivialLattice : Subsingleton trivialLattice.carrier :=
  inferInstanceAs (Subsingleton (Fin 0 → ℤ))

/-- The iterated orthogonal sum of a list of lattices, `Γ₁ ⊥ ⋯ ⊥ Γ_k` in Ebeling's notation. -/
def orthSumList : List IntegralLattice → IntegralLattice
  | [] => trivialLattice
  | Λ :: L => Λ ⊞ orthSumList L

/-- Concatenating lists corresponds to taking the orthogonal sum. -/
def orthSumListAppend : ∀ L₁ L₂ : List IntegralLattice,
    orthSumList (L₁ ++ L₂) ≃ₗᵢ (orthSumList L₁ ⊞ orthSumList L₂)
  | [], L₂ =>
      (orthSumSubsingletonLeft trivialLattice (orthSumList L₂) subsingleton_trivialLattice).symm
  | Λ :: L₁, L₂ =>
      (Isom.orthSumCongr (Isom.refl Λ) (orthSumListAppend L₁ L₂)).trans
        (orthSumAssoc Λ (orthSumList L₁) (orthSumList L₂))

private theorem exists_orthSumList_aux : ∀ (n : ℕ) (Γ : IntegralLattice), Γ.rank ≤ n →
    Γ.IsRootLattice → ∃ L : List IntegralLattice,
      (∀ Λ ∈ L, Λ.IsRootLattice ∧ Λ.IsIrreducible) ∧ Nonempty (Γ ≃ₗᵢ orthSumList L) := by
  intro n
  induction n with
  | zero =>
      intro Γ hr _
      exact ⟨[], by simp, ⟨isomOfSubsingleton Γ trivialLattice
        (subsingleton_of_rank_eq_zero (Nat.le_zero.mp hr)) subsingleton_trivialLattice⟩⟩
  | succ n ih =>
      intro Γ hr hΓ
      by_cases h0 : Γ.rank = 0
      · exact ⟨[], by simp, ⟨isomOfSubsingleton Γ trivialLattice
          (subsingleton_of_rank_eq_zero h0) subsingleton_trivialLattice⟩⟩
      by_cases hirr : Γ.IsIrreducible
      · refine ⟨[Γ], ?_, ⟨(orthSumSubsingletonRight Γ trivialLattice
          subsingleton_trivialLattice).symm⟩⟩
        intro Λ hΛ
        rw [List.mem_singleton] at hΛ
        exact hΛ ▸ ⟨hΓ, hirr⟩
      · have hred : Γ.IsReducible := by
          by_contra hcon
          exact hirr ⟨h0, hcon⟩
        obtain ⟨M, N, hM, hN, hcompl, horth⟩ := hred
        have hsplit := rank_eq_of_orthSplit hcompl horth
        have hMne := rank_ne_zero_of_ne_bot (Γ := Γ) hM
        have hNne := rank_ne_zero_of_ne_bot (Γ := Γ) hN
        have hrM : (Γ.ofSubmodule M).rank ≤ n := by omega
        have hrN : (Γ.ofSubmodule N).rank ≤ n := by omega
        obtain ⟨L₁, hL₁, ⟨f₁⟩⟩ := ih _ hrM (isRootLattice_ofSubmodule hΓ hcompl horth)
        obtain ⟨L₂, hL₂, ⟨f₂⟩⟩ := ih _ hrN
          (isRootLattice_ofSubmodule hΓ hcompl.symm horth.symm)
        refine ⟨L₁ ++ L₂, ?_, ⟨?_⟩⟩
        · intro Λ hΛ
          rcases List.mem_append.mp hΛ with h | h
          · exact hL₁ Λ h
          · exact hL₂ Λ h
        · exact ((Γ.orthSplit hcompl horth).symm.trans (Isom.orthSumCongr f₁ f₂)).trans
            (orthSumListAppend L₁ L₂).symm

/-- **Ebeling §1.4 (`Prop-1.2` in the ledger).** Every root lattice is isometric to an iterated
orthogonal sum of irreducible root lattices. -/
theorem orthSum_decomposition (Γ : IntegralLattice) (hΓ : Γ.IsRootLattice) :
    ∃ L : List IntegralLattice,
      (∀ Λ ∈ L, Λ.IsRootLattice ∧ Λ.IsIrreducible) ∧ Nonempty (Γ ≃ₗᵢ orthSumList L) :=
  exists_orthSumList_aux Γ.rank Γ le_rfl hΓ

end RootLattice
