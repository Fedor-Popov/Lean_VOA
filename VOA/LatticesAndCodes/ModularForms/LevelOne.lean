import Mathlib.NumberTheory.Modular
import Mathlib.NumberTheory.ModularForms.LevelOne.DimensionFormula
import Mathlib.NumberTheory.ModularForms.LevelOne.GradedRing
import Mathlib.NumberTheory.ModularForms.EisensteinSeries.QExpansion
import Mathlib.LinearAlgebra.Dimension.OrzechProperty

/-!
# Level-one modular forms

**Ebeling §2.2.**  Three of the four results of §2.2 come straight from Mathlib and are restated
here in Ebeling's shape; the fourth, **Corollary 2.2**, is proved here.

## What Mathlib supplies (surveyed 2026-08-23)

| Ebeling | Mathlib |
|---|---|
| Thm 2.2, the fundamental domain | `ModularGroup.fd`, `ModularGroup.exists_smul_mem_fd`, `ModularGroup.eq_smul_self_of_mem_fdo_mem_fdo` |
| Thm 2.5, `dim M_k` | `ModularForm.dimension_level_one` |
| Cor 2.1, the `q`-expansion of `E_k` | `EisensteinSeries.E_qExpansion_coeff` |

Ebeling's §2.5 — Prop 2.2 and Prop 2.3, the Eisenstein series in his own normalisation
`G_k = ∑ 1/(mτ+n)^k` — is in `ModularForms/Eisenstein.lean`.

`ModularGroup.fundamentalDomain`, `ModularForm.rank_levelOne` and
`ModularForm.eisenstein_qExpansion` below are those three, and **their proofs are one application
of a Mathlib theorem each** — nothing in that part of the file is proved here.

Mathlib reaches the dimension formula **without** the valence formula: `CuspForm.discriminantEquiv`
divides by `Δ` to identify `S_k ≃ M_{k-12}`, and the recursion `dim M_k = 1 + dim S_k` is closed
by explicit base cases.

**Thm 2.4, the valence formula**, is absent from Mathlib. It is *not* deferred: it is proved in
`ModularForms/ValenceFormula.lean` (`ModularForm.valence_formula`, 2026-09-02), by a route that
uses no contour integration. Mathlib's dimension formula does not depend on it, which is why this
file does not.

## Corollary 2.2, proved here

`ModularForm.levelOne_eq_polynomial`: in each weight the monomials `E₄^a E₆^b` with `4a + 6b = k`
are a **basis** of `ModularForm 𝒮ℒ k`.  The two halves are

* **spanning** (`ModularForm.coe_mem_eisSpan`) — that `E₄` and `E₆` generate.  Ebeling's induction
  on the weight: subtract a multiple of a single monomial to kill the constant term of the
  `q`-expansion, divide the resulting cusp form by `Δ`, and recurse in weight `k − 12`.  The
  induction is carried out inside a subspace `ModularForm.eisSpan k` of `ℍ → ℂ` rather than of
  modular forms, which is what keeps the graded-algebra `mcast` bookkeeping down to a single
  occurrence and makes "multiply by `Δ`" a plain `Submodule.span_induction`.  The step uses
  Mathlib's `Δ = (E₄³ − E₆²)/1728` to stay inside the span of monomials;
* **independence** — that they are *algebraically* independent, so the algebra is a polynomial
  algebra and not merely generated by two elements.  This is not proved directly but by counting:
  `ModularForm.card_wtIdx` shows there are exactly `dim M_k` monomials of weight `k`
  (`ModularForm.finrank_levelOne`), so a spanning family of that size is a basis.

## References

Ebeling, *Lattices and Codes*, §2.2.
-/

open UpperHalfPlane ModularForm EisensteinSeries
open scoped MatrixGroups Modular UpperHalfPlane ArithmeticFunction.sigma

namespace ModularGroup

/-- **Ebeling, Theorem 2.2.**  `𝒟 = {τ : |τ| ≥ 1, |Re τ| ≤ ½}` is a fundamental domain for the
action of `SL(2,ℤ)` on the upper half plane: every point is equivalent to a point of `𝒟`, and two
points of the interior `𝒟ᵒ` are equivalent only if they are equal.

This is Mathlib's `ModularGroup.exists_smul_mem_fd` and
`ModularGroup.eq_smul_self_of_mem_fdo_mem_fdo`; see the module docstring. -/
theorem fundamentalDomain :
    (∀ z : ℍ, ∃ g : SL(2, ℤ), g • z ∈ 𝒟) ∧
      (∀ (z : ℍ) (g : SL(2, ℤ)), z ∈ 𝒟ᵒ → g • z ∈ 𝒟ᵒ → z = g • z) :=
  ⟨exists_smul_mem_fd, fun _ _ hz hg => eq_smul_self_of_mem_fdo_mem_fdo hz hg⟩

end ModularGroup

namespace ModularForm

/-- **Ebeling, Theorem 2.5.**  For even `k`, `dim M_k = ⌊k/12⌋ + 1`, except when
`k ≡ 2 (mod 12)`, where it is `⌊k/12⌋`.  (Odd weights give the zero space, Mathlib's
`ModularForm.levelOne_odd_weight_rank_zero`.)

This is Mathlib's `ModularForm.dimension_level_one`; see the module docstring. -/
theorem rank_levelOne (k : ℕ) (hk : Even k) :
    Module.rank ℂ (ModularForm 𝒮ℒ k) = if k ≡ 2 [MOD 12] then (k / 12 : ℕ) else (k / 12 + 1 : ℕ) :=
  dimension_level_one k hk

/-- **Ebeling, Corollary 2.1.**  The `q`-expansion of the normalised Eisenstein series `E_k`
(even `k ≥ 3`) has constant term `1` and `m`-th coefficient `-(2k/B_k) σ_{k-1}(m)`.

This is Mathlib's `EisensteinSeries.E_qExpansion_coeff`; see the module docstring. -/
theorem eisenstein_qExpansion {k : ℕ} (hk : 3 ≤ k) (hk2 : Even k) (m : ℕ) :
    (qExpansion 1 (E hk)).coeff m
      = if m = 0 then 1 else -(2 * k / bernoulli k : ℂ) * (σ (k - 1) m) :=
  EisensteinSeries.E_qExpansion_coeff hk hk2 m

end ModularForm

/-! ## Corollary 2.2: `M_* = ℂ[E₄, E₆]`

The one result of §2.2 that Mathlib does not supply.  The proof is the standard induction on the
weight, organised so that the graded-algebra bookkeeping stays in one place: the induction runs
inside a subspace of `ℍ → ℂ` (`ModularForm.eisSpan`), where multiplying by `Δ` is a
`Submodule.span_induction`, and only the single subtraction that kills the constant term needs a
monomial as an honest `ModularForm 𝒮ℒ k` (hence one `ModularForm.mcast`). -/

namespace ModularForm

/-- The `ℂ`-subspace of functions on the upper half plane spanned by the monomials `E₄^a E₆^b`
of weight `4a + 6b = k`. -/
noncomputable def eisSpan (k : ℕ) : Submodule ℂ (ℍ → ℂ) :=
  Submodule.span ℂ
    {g : ℍ → ℂ | ∃ a b : ℕ, 4 * a + 6 * b = k ∧ g = fun z => E₄ z ^ a * E₆ z ^ b}

theorem eisMonomial_mem_eisSpan {k a b : ℕ} (h : 4 * a + 6 * b = k) :
    (fun z => E₄ z ^ a * E₆ z ^ b) ∈ eisSpan k :=
  Submodule.subset_span ⟨a, b, h, rfl⟩

/-- Multiplying by the discriminant raises the weight by `12`.  This is where
`Δ = (E₄³ − E₆²)/1728` enters: it is what keeps the product inside the span of monomials. -/
theorem discriminant_mul_mem_eisSpan {k : ℕ} {g : ℍ → ℂ} (hg : g ∈ eisSpan k) :
    (fun z => discriminant z * g z) ∈ eisSpan (k + 12) := by
  induction hg using Submodule.span_induction with
  | mem g hg =>
      obtain ⟨a, b, hab, rfl⟩ := hg
      have key : (fun z => discriminant z * (E₄ z ^ a * E₆ z ^ b))
          = (1 / 1728 : ℂ) • (fun z : ℍ => E₄ z ^ (a + 3) * E₆ z ^ b)
            - (1 / 1728 : ℂ) • (fun z : ℍ => E₄ z ^ a * E₆ z ^ (b + 2)) := by
        funext z
        simp only [Pi.smul_apply, Pi.sub_apply, smul_eq_mul,
          discriminant_eq_E₄_cube_sub_E₆_sq z]
        ring
      rw [key]
      exact Submodule.sub_mem _
        (Submodule.smul_mem _ _ (eisMonomial_mem_eisSpan (by omega)))
        (Submodule.smul_mem _ _ (eisMonomial_mem_eisSpan (by omega)))
  | zero =>
      have hz : (fun z => discriminant z * (0 : ℍ → ℂ) z) = 0 := by funext z; simp
      rw [hz]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      have hxy : (fun z => discriminant z * (x + y) z)
          = (fun z => discriminant z * x z) + (fun z => discriminant z * y z) := by
        funext z; simp [mul_add]
      rw [hxy]
      exact Submodule.add_mem _ hx hy
  | smul c x _ hx =>
      have hcx : (fun z => discriminant z * (c • x) z)
          = c • (fun z => discriminant z * x z) := by
        funext z
        simp only [Pi.smul_apply, smul_eq_mul]
        ring
      rw [hcx]
      exact Submodule.smul_mem _ _ hx

/-- The monomial `E₄^a E₆^b`, as a level-one modular form of weight `4a + 6b`. -/
noncomputable def eisMonomial (a b : ℕ) : ModularForm 𝒮ℒ ((4 * a + 6 * b : ℕ) : ℤ) :=
  ModularForm.mcast (by push_cast; ring) ((E₄.pow a).mul (E₆.pow b))

@[simp] theorem coe_eisMonomial (a b : ℕ) :
    ⇑(eisMonomial a b) = fun z => E₄ z ^ a * E₆ z ^ b := by
  ext z
  simp only [eisMonomial, coe_mcast, coe_mul, coe_pow, Pi.mul_apply, Pi.pow_apply]

theorem qExpansion_coeff_zero_eisMonomial (a b : ℕ) :
    (qExpansion 1 (eisMonomial a b)).coeff 0 = 1 := by
  rw [eisMonomial, ModularForm.qExpansion_mcast,
    ModularForm.qExpansion_mul one_pos one_mem_strictPeriods_SL,
    ModularForm.qExpansion_pow one_pos one_mem_strictPeriods_SL,
    ModularForm.qExpansion_pow one_pos one_mem_strictPeriods_SL]
  have h4 : (qExpansion 1 (E₄ : ℍ → ℂ)).coeff 0 = 1 := E_qExpansion_coeff_zero _ ⟨2, rfl⟩
  have h6 : (qExpansion 1 (E₆ : ℍ → ℂ)).coeff 0 = 1 := E_qExpansion_coeff_zero _ ⟨3, rfl⟩
  rw [PowerSeries.coeff_zero_eq_constantCoeff] at h4 h6 ⊢
  rw [map_mul, map_pow, map_pow, h4, h6, one_pow, one_pow, one_mul]

/-- Every even weight other than `2` is `4a + 6b` for some `a, b : ℕ`. -/
theorem exists_eisExponents {k : ℕ} (hk : Even k) (hk2 : k ≠ 2) :
    ∃ a b : ℕ, 4 * a + 6 * b = k := by
  have hk' : k % 2 = 0 := Nat.even_iff.1 hk
  rcases Nat.lt_or_ge k 3 with h | h
  · exact ⟨0, 0, by omega⟩
  · by_cases h4 : k % 4 = 0
    · exact ⟨k / 4, 0, by omega⟩
    · exact ⟨(k - 6) / 4, 1, by omega⟩

/-- **Ebeling, Corollary 2.2, the spanning half.**  Every level-one modular form of weight `k`
is a `ℂ`-linear combination of the monomials `E₄^a E₆^b` with `4a + 6b = k`.

The induction on `k` is Ebeling's: subtract a multiple of one monomial to kill the constant term
of the `q`-expansion, divide the resulting cusp form by `Δ` (`CuspForm.discriminantEquiv`), and
apply the inductive hypothesis in weight `k − 12`.  Weights below `4` other than `0`, and all odd
weights, are handled by the vanishing results. -/
theorem coe_mem_eisSpan : ∀ (k : ℕ) (f : ModularForm 𝒮ℒ (k : ℤ)), (f : ℍ → ℂ) ∈ eisSpan k := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro f
    rcases Nat.even_or_odd k with hk | hk
    · by_cases hk2 : k = 2
      · subst hk2
        have hrk : Module.rank ℂ (ModularForm 𝒮ℒ ((2 : ℕ) : ℤ)) = 0 := by
          simpa using ModularForm.levelOne_weight_two_rank_zero
        have hf : f = 0 := rank_zero_iff_forall_zero.1 hrk f
        simp [hf]
      · obtain ⟨a, b, hab⟩ := exists_eisExponents hk hk2
        set μ : ModularForm 𝒮ℒ (k : ℤ) :=
          ModularForm.mcast (by exact_mod_cast hab) (eisMonomial a b) with hμdef
        have hμcoe : (μ : ℍ → ℂ) = fun z => E₄ z ^ a * E₆ z ^ b := by
          rw [hμdef, coe_mcast, coe_eisMonomial]
        have hμ0 : (qExpansion 1 μ).coeff 0 = 1 := by
          rw [hμdef, ModularForm.qExpansion_mcast]
          exact qExpansion_coeff_zero_eisMonomial a b
        set c₀ : ℂ := (qExpansion 1 f).coeff 0 with hc₀
        set g : ModularForm 𝒮ℒ (k : ℤ) := f - c₀ • μ with hgdef
        have hg0 : (qExpansion 1 g).coeff 0 = 0 := by
          have hsub : (g : ℍ → ℂ) = (f : ℍ → ℂ) - ((c₀ • μ : ModularForm 𝒮ℒ (k : ℤ)) : ℍ → ℂ) :=
            rfl
          have hsmul : ((c₀ • μ : ModularForm 𝒮ℒ (k : ℤ)) : ℍ → ℂ) = c₀ • (μ : ℍ → ℂ) := rfl
          rw [hsub, ModularForm.qExpansion_sub one_pos one_mem_strictPeriods_SL f (c₀ • μ),
            hsmul, ModularForm.qExpansion_smul one_pos one_mem_strictPeriods_SL,
            map_sub, PowerSeries.coeff_smul, hμ0, smul_eq_mul, mul_one, ← hc₀, sub_self]
        have hgΔ : (g : ℍ → ℂ)
            = fun z => discriminant z *
              (CuspForm.discriminantEquiv (toCuspForm g hg0) : ℍ → ℂ) z := by
          funext z
          exact (discriminant_mul_discriminantEquiv_apply (toCuspForm g hg0) z).symm
        have hgmem : (g : ℍ → ℂ) ∈ eisSpan k := by
          rcases Nat.lt_or_ge k 12 with hk12 | hk12
          · have hneg : ((k : ℤ) - 12) < 0 := by omega
            have hz := ModularFormClass.levelOne_neg_weight_eq_zero hneg
              (CuspForm.discriminantEquiv (toCuspForm g hg0))
            rw [hgΔ]
            have : (fun z => discriminant z *
                (CuspForm.discriminantEquiv (toCuspForm g hg0) : ℍ → ℂ) z) = 0 := by
              funext z
              rw [show ((CuspForm.discriminantEquiv (toCuspForm g hg0) : ℍ → ℂ)) z = 0 from
                congrFun hz z, mul_zero]
              rfl
            rw [this]
            exact Submodule.zero_mem _
          · set h' : ModularForm 𝒮ℒ (((k - 12 : ℕ) : ℤ)) :=
              ModularForm.mcast (by omega) (CuspForm.discriminantEquiv (toCuspForm g hg0))
              with hh'
            have hcoe : (h' : ℍ → ℂ)
                = (CuspForm.discriminantEquiv (toCuspForm g hg0) : ℍ → ℂ) := by
              rw [hh', coe_mcast]
            have hmem := ih (k - 12) (by omega) h'
            have := discriminant_mul_mem_eisSpan hmem
            rw [show k - 12 + 12 = k from by omega] at this
            rw [hgΔ, ← hcoe]
            exact this
        have hfg : (f : ℍ → ℂ) = (g : ℍ → ℂ) + c₀ • (μ : ℍ → ℂ) := by
          rw [hgdef]
          funext z
          simp
        rw [hfg, hμcoe]
        exact Submodule.add_mem _ hgmem
          (Submodule.smul_mem _ _ (eisMonomial_mem_eisSpan hab))
    · have hodd : Odd ((k : ℕ) : ℤ) := by exact_mod_cast hk
      have hf : f = 0 := ModularForm.levelOne_odd_weight_eq_zero hodd f
      rw [show (f : ℍ → ℂ) = 0 by rw [hf]; rfl]
      exact Submodule.zero_mem _

/-! ### Counting the monomials of a given weight

Spanning alone says only that `E₄` and `E₆` *generate*.  To get that they are *algebraically
independent* — so that the graded algebra is a polynomial algebra — it is enough to count: the
monomials of weight `k` are as many as `dim M_k`, so a spanning family of that size is a basis.
The count is an induction with step `12`: adding `12` to the weight adds exactly one exponent
pair, namely the unique one with `a < 3`. -/

/-- The exponent pairs of the monomials of weight `k`: the `(a,b)` with `4a + 6b = k`. -/
def wtIdx (k : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.range (k + 1) ×ˢ Finset.range (k + 1)).filter fun p => 4 * p.1 + 6 * p.2 = k

@[simp] theorem mem_wtIdx {k : ℕ} {p : ℕ × ℕ} : p ∈ wtIdx k ↔ 4 * p.1 + 6 * p.2 = k := by
  simp only [wtIdx, Finset.mem_filter, Finset.mem_product, Finset.mem_range]
  exact ⟨fun h => h.2, fun h => ⟨⟨by omega, by omega⟩, h⟩⟩

theorem card_wtIdx_add_twelve {k : ℕ} (hk : Even k) :
    (wtIdx (k + 12)).card = (wtIdx k).card + 1 := by
  classical
  have hk2 : k % 2 = 0 := Nat.even_iff.1 hk
  obtain ⟨a₀, b₀, ha₀, hab₀⟩ : ∃ a b : ℕ, a < 3 ∧ 4 * a + 6 * b = k + 12 := by
    rcases (by omega : k % 6 = 0 ∨ k % 6 = 2 ∨ k % 6 = 4) with h | h | h
    · exact ⟨0, (k + 12) / 6, by omega, by omega⟩
    · exact ⟨2, (k + 4) / 6, by omega, by omega⟩
    · exact ⟨1, (k + 8) / 6, by omega, by omega⟩
  have hset : wtIdx (k + 12)
      = insert (a₀, b₀) ((wtIdx k).image fun p => (p.1 + 3, p.2)) := by
    ext ⟨a, b⟩
    simp only [Finset.mem_insert, Finset.mem_image, mem_wtIdx, Prod.mk.injEq, Prod.exists]
    constructor
    · intro h
      by_cases ha : a < 3
      · exact Or.inl ⟨by omega, by omega⟩
      · exact Or.inr ⟨a - 3, b, by omega, by omega, rfl⟩
    · rintro (⟨rfl, rfl⟩ | ⟨a', b', h', ha', hb'⟩)
      · exact hab₀
      · omega
  rw [hset, Finset.card_insert_of_notMem, Finset.card_image_of_injective]
  · intro p q hpq
    simpa [Prod.ext_iff] using hpq
  · intro hmem
    simp only [Finset.mem_image, mem_wtIdx, Prod.mk.injEq, Prod.exists] at hmem
    obtain ⟨a', b', h', ha', hb'⟩ := hmem
    omega

theorem card_wtIdx {k : ℕ} (hk : Even k) :
    (wtIdx k).card = if k % 12 = 2 then k / 12 else k / 12 + 1 := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    rcases Nat.lt_or_ge k 12 with h | h
    · have hk2 : k % 2 = 0 := Nat.even_iff.1 hk
      have hcase : k = 0 ∨ k = 2 ∨ k = 4 ∨ k = 6 ∨ k = 8 ∨ k = 10 := by omega
      rcases hcase with rfl | rfl | rfl | rfl | rfl | rfl <;> decide
    · have hk2 : k % 2 = 0 := Nat.even_iff.1 hk
      have hkm : Even (k - 12) := Nat.even_iff.2 (by omega)
      have hstep := card_wtIdx_add_twelve hkm
      rw [show k - 12 + 12 = k from by omega] at hstep
      rw [hstep, ih (k - 12) (by omega) hkm]
      split_ifs with h1 h2 h2 <;> omega

/-! ### The basis, and Corollary 2.2 -/

/-- The coercion `ModularForm 𝒮ℒ k → (ℍ → ℂ)` as a `ℂ`-linear map, so that
`ModularForm.eisSpan` (a subspace of functions) can be compared with a span of modular forms. -/
noncomputable def coeLm (k : ℤ) : ModularForm 𝒮ℒ k →ₗ[ℂ] (ℍ → ℂ) where
  toFun f := (f : ℍ → ℂ)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[simp] theorem coeLm_apply {k : ℤ} (f : ModularForm 𝒮ℒ k) : coeLm k f = (f : ℍ → ℂ) := rfl

theorem coeLm_injective (k : ℤ) : Function.Injective (coeLm k) :=
  fun _ _ h => DFunLike.coe_injective h

/-- The monomial `E₄^a E₆^b` attached to an exponent pair of weight `k`, as a modular form of
weight `k`. -/
noncomputable def eisBasisFun (k : ℕ) (p : wtIdx k) : ModularForm 𝒮ℒ (k : ℤ) :=
  ModularForm.mcast (by exact_mod_cast mem_wtIdx.1 p.2) (eisMonomial (p : ℕ × ℕ).1 (p : ℕ × ℕ).2)

@[simp] theorem coe_eisBasisFun (k : ℕ) (p : wtIdx k) :
    ((eisBasisFun k p : ModularForm 𝒮ℒ (k : ℤ)) : ℍ → ℂ)
      = fun z => E₄ z ^ (p : ℕ × ℕ).1 * E₆ z ^ (p : ℕ × ℕ).2 := by
  rw [eisBasisFun, coe_mcast, coe_eisMonomial]

theorem eisSpan_eq_map (k : ℕ) :
    eisSpan k = Submodule.map (coeLm (k : ℤ)) (Submodule.span ℂ (Set.range (eisBasisFun k))) := by
  rw [Submodule.map_span, ← Set.range_comp, eisSpan]
  congr 1
  ext g
  constructor
  · rintro ⟨a, b, hab, rfl⟩
    exact ⟨⟨(a, b), mem_wtIdx.2 hab⟩, by simp⟩
  · rintro ⟨p, rfl⟩
    exact ⟨(p : ℕ × ℕ).1, (p : ℕ × ℕ).2, mem_wtIdx.1 p.2, by simp⟩

theorem span_eisBasisFun (k : ℕ) : Submodule.span ℂ (Set.range (eisBasisFun k)) = ⊤ := by
  rw [eq_top_iff]
  intro f _
  have h1 : coeLm (k : ℤ) f
      ∈ Submodule.map (coeLm (k : ℤ)) (Submodule.span ℂ (Set.range (eisBasisFun k))) := by
    rw [← eisSpan_eq_map]
    exact coe_mem_eisSpan k f
  obtain ⟨g, hg, hgf⟩ := h1
  exact coeLm_injective _ hgf ▸ hg

theorem finrank_levelOne {k : ℕ} (hk : Even k) :
    Module.finrank ℂ (ModularForm 𝒮ℒ (k : ℤ))
      = if k % 12 = 2 then k / 12 else k / 12 + 1 := by
  have h := ModularForm.dimension_level_one k hk
  have hmod : (k ≡ 2 [MOD 12]) ↔ k % 12 = 2 := by
    unfold Nat.ModEq
    norm_num
  unfold Module.finrank
  rw [h]
  by_cases hc : k % 12 = 2
  · rw [if_pos (hmod.2 hc), if_pos hc, Cardinal.toNat_natCast]
  · rw [if_neg (fun hcc => hc (hmod.1 hcc)), if_neg hc, Cardinal.toNat_natCast]

/-- The monomials `E₄^a E₆^b` with `4a + 6b = k` form a basis of the space of level-one modular
forms of weight `k`. -/
noncomputable def eisBasis {k : ℕ} (hk : Even k) :
    Module.Basis (wtIdx k) ℂ (ModularForm 𝒮ℒ (k : ℤ)) :=
  basisOfTopLeSpanOfCardEqFinrank (eisBasisFun k) (by rw [span_eisBasisFun])
    (by rw [Fintype.card_coe, card_wtIdx hk, finrank_levelOne hk])

@[simp] theorem coe_eisBasis {k : ℕ} (hk : Even k) (p : wtIdx k) :
    ((eisBasis hk p : ModularForm 𝒮ℒ (k : ℤ)) : ℍ → ℂ)
      = fun z => E₄ z ^ (p : ℕ × ℕ).1 * E₆ z ^ (p : ℕ × ℕ).2 := by
  have h : (eisBasis hk) p = eisBasisFun k p :=
    congrFun (coe_basisOfTopLeSpanOfCardEqFinrank (eisBasisFun k) _ _) p
  rw [h, coe_eisBasisFun]

/-- **Ebeling, Corollary 2.2: `M_* = ℂ[E₄, E₆]`.**  In each weight `k`, the monomials
`E₄^a E₆^b` with `4a + 6b = k` are a *basis* of the space of level-one modular forms.

Spanning says that `E₄` and `E₆` generate the algebra of modular forms; linear independence in
each weight says that they are algebraically independent, so that the graded algebra really is a
polynomial algebra and not merely an algebra generated by two elements.  Independence is not
proved directly: it comes from counting, since a spanning family whose size is `dim M_k`
(`ModularForm.card_wtIdx` against `ModularForm.finrank_levelOne`) must be a basis.

Odd weights are excluded only because both sides are then empty: `M_k = 0` and there are no
exponent pairs. -/
theorem levelOne_eq_polynomial {k : ℕ} (hk : Even k) :
    ∃ B : Module.Basis (wtIdx k) ℂ (ModularForm 𝒮ℒ (k : ℤ)),
      ∀ p : wtIdx k, ((B p : ModularForm 𝒮ℒ (k : ℤ)) : ℍ → ℂ)
        = fun z => E₄ z ^ (p : ℕ × ℕ).1 * E₆ z ^ (p : ℕ × ℕ).2 :=
  ⟨eisBasis hk, coe_eisBasis hk⟩

end ModularForm
