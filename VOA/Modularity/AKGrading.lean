import VOA.Modularity.EisensteinRamanujan
import VOA.Modularity.SqWeightSpanning
import Mathlib.Algebra.Module.GradedModule

/-!
# The graded algebra interface needed by the Arakawa--Kawasetsu relation

This file separates the canonical graded objects from the one structural fact about Zhu's
relation module that is not yet supplied by the repository's square-bracket mode API.
-/

namespace VOA

open scoped BigOperators TensorProduct

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-- The genuine modular-weight subspace of `E46`. -/
noncomputable def e46WeightSpace (k : ℤ) : Submodule ℂ E46 where
  carrier := {f | E46Weight k f}
  zero_mem' := E46Weight.zero k
  add_mem' hf hg := hf.add hg
  smul_mem' c _ hf := hf.smul c

@[simp] theorem mem_e46WeightSpace {k : ℤ} {f : E46} :
    f ∈ e46WeightSpace k ↔ E46Weight k f := Iff.rfl

instance : SetLike.GradedMonoid e46WeightSpace where
  one_mem := E46Weight.one
  mul_mem := by
    intro i j f g hf hg
    exact E46Weight.mul hf hg

/-- The total weight-`n` subspace of `E46 ⊗ 𝒱`, generated by tensors whose modular and
square-bracket weights add to `n`. -/
noncomputable def akTotalWeightSpace (W : VertexOperatorAlgebra 𝒱) (n : ℤ) :
    Submodule ℂ (𝒱E 𝒱) :=
  Submodule.span ℂ {x | ∃ (p q : ℤ) (f : E46) (v : 𝒱), p + q = n ∧
    f ∈ e46WeightSpace p ∧ v ∈ sqWeightSpace W (q : ℂ) ∧ x = f ⊗ₜ[ℂ] v}

theorem tmul_mem_akTotalWeightSpace (W : VertexOperatorAlgebra 𝒱)
    {p q : ℤ} {f : E46} {v : 𝒱}
    (hf : f ∈ e46WeightSpace p) (hv : v ∈ sqWeightSpace W (q : ℂ)) :
    f ⊗ₜ[ℂ] v ∈ akTotalWeightSpace W (p + q) :=
  Submodule.subset_span ⟨p, q, f, v, rfl, hf, hv, rfl⟩

theorem ιE_mem_akTotalWeightSpace (W : VertexOperatorAlgebra 𝒱)
    {q : ℤ} {v : 𝒱} (hv : v ∈ sqWeightSpace W (q : ℂ)) :
    (ιE v : 𝒱E 𝒱) ∈ akTotalWeightSpace W q := by
  rw [ιE_apply, ← zero_add q]
  exact tmul_mem_akTotalWeightSpace W E46Weight.one hv

set_option synthInstance.maxHeartbeats 100000 in
-- Tensor-product scalar instances are expensive to synthesize in the span induction.
theorem e46Weight_smul_mem_akTotalWeightSpace (W : VertexOperatorAlgebra 𝒱)
    {p q : ℤ} {f : E46} (hf : f ∈ e46WeightSpace p)
    {x : 𝒱E 𝒱} (hx : x ∈ akTotalWeightSpace W q) :
    f • x ∈ akTotalWeightSpace W (p + q) := by
  classical
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨r, s, g, v, hrs, hg, hv, rfl⟩ := hx
      rw [TensorProduct.smul_tmul', smul_eq_mul]
      simpa [add_assoc, hrs] using
        (tmul_mem_akTotalWeightSpace W (E46Weight.mul hf hg) hv)
  | zero => simp
  | add x y _ _ hx hy => simpa [smul_add] using Submodule.add_mem _ hx hy
  | smul c x _ hx =>
      rw [← smul_comm c f]
      exact Submodule.smul_mem _ c hx

instance (W : VertexOperatorAlgebra 𝒱) :
    SetLike.GradedSMul e46WeightSpace (akTotalWeightSpace W) where
  smul_mem {i j} {f x} hf hx :=
    e46Weight_smul_mem_akTotalWeightSpace W (p := i) (q := j) (f := f) (x := x) hf hx

/-- The exact remaining graded datum.  The coefficient and total-weight spaces are canonical;
the fields assert their direct-sum decompositions and stability of Zhu's relation module under
total-weight projection. -/
structure AKWeightGrading (W : VertexOperatorAlgebra 𝒱) where
  coeffDecomposition : DirectSum.Decomposition e46WeightSpace
  totalDecomposition : DirectSum.Decomposition (akTotalWeightSpace W)
  relationHomogeneous :
    letI := totalDecomposition
    DirectSum.SetLike.IsHomogeneous (akTotalWeightSpace W)
      ((blockRelSpanE W).restrictScalars ℂ)

namespace AKWeightGrading

variable {W : VertexOperatorAlgebra 𝒱}

theorem decompose_smul_of_mem (hgrade : AKWeightGrading W)
    {p q : ℤ} (f : E46) {x : 𝒱E 𝒱} (hx : x ∈ akTotalWeightSpace W q) :
    letI := hgrade.coeffDecomposition
    letI := hgrade.totalDecomposition
    ((DirectSum.decompose (akTotalWeightSpace W) (f • x) (p + q) :
        akTotalWeightSpace W (p + q)) : 𝒱E 𝒱) =
      ((DirectSum.decompose e46WeightSpace f p : e46WeightSpace p) : E46) • x := by
  classical
  letI := hgrade.coeffDecomposition
  letI := hgrade.totalDecomposition
  have hsum := DirectSum.sum_support_decompose e46WeightSpace f
  let proj : 𝒱E 𝒱 →+ 𝒱E 𝒱 :=
    (akTotalWeightSpace W (p + q)).subtype.toAddMonoidHom.comp
      ((DFinsupp.evalAddMonoidHom (p + q)).comp
        (DirectSum.decomposeAddEquiv (akTotalWeightSpace W)).toAddMonoidHom)
  change proj (f • x) = _
  conv_lhs =>
    rw [← hsum, Finset.sum_smul, map_sum]
  change (∑ r ∈ (DirectSum.decompose e46WeightSpace f).support,
      ((DirectSum.decompose (akTotalWeightSpace W)
        (((DirectSum.decompose e46WeightSpace f r : e46WeightSpace r) : E46) • x)
          (p + q) : akTotalWeightSpace W (p + q)) : 𝒱E 𝒱)) = _
  by_cases hp : p ∈ (DirectSum.decompose e46WeightSpace f).support
  · rw [Finset.sum_eq_single p]
    · exact DirectSum.decompose_of_mem_same (akTotalWeightSpace W)
        (e46Weight_smul_mem_akTotalWeightSpace W
          (DirectSum.decompose e46WeightSpace f p).2 hx)
    · intro r hr hrp
      exact DirectSum.decompose_of_mem_ne (akTotalWeightSpace W)
        (e46Weight_smul_mem_akTotalWeightSpace W
          (DirectSum.decompose e46WeightSpace f r).2 hx) (by omega)
    · exact fun h => (h hp).elim
  · have hpzero : DirectSum.decompose e46WeightSpace f p = 0 :=
      DFinsupp.notMem_support_iff.mp hp
    have hpzero' : ((DirectSum.decompose e46WeightSpace f p : e46WeightSpace p) : E46) = 0 :=
      congrArg Subtype.val hpzero
    rw [hpzero', zero_smul]
    exact Finset.sum_eq_zero fun r hr =>
      DirectSum.decompose_of_mem_ne (akTotalWeightSpace W)
        (e46Weight_smul_mem_akTotalWeightSpace W
          (DirectSum.decompose e46WeightSpace f r).2 hx)
        (by
          intro hrp
          have hdegree : r = p := by omega
          exact hp (hdegree ▸ hr))

end AKWeightGrading

end VOA
