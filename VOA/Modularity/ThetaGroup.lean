import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
import Mathlib.NumberTheory.Modular
import Mathlib.LinearAlgebra.Matrix.FixedDetMatrices
import Mathlib.Algebra.CharP.Two

/-!
# The theta group `Γ_θ ≤ SL₂(ℤ)`

Zhu's theorem, as proved in `VOA.Modularity.ZhuTheorem`, produces characters that are
modular for the **full** modular group `SL₂(ℤ)`.  That statement is special to *bosonic*,
`ℤ`-graded vertex operator algebras.  As soon as the grading is allowed to be half-integral —
super vertex operator algebras (`VOA.Core.SuperVertexOperatorAlgebra`), the `βγ` system,
symplectic fermions in the Ramond sector — the translation `T : τ ↦ τ + 1` multiplies a weight-`h`
character by `e^{2πi h}`, which is `−1` rather than `1` for `h ∈ ℤ + ½`.  Such characters are
modular only for the subgroup generated by `S` and `T²`: the **theta group** `Γ_θ`.

This file is the group-theoretic foundation of that story; it is completely independent of the
vertex-algebra part of the library.

## Main definitions

* `VOA.ThetaGroup.redEntry` — the `(i,j)` matrix entry of `g ∈ SL(2,ℤ)` reduced mod `2`,
  together with a complete set of `@[simp]` rules (`redEntry_mul_*`, `redEntry_inv_*`,
  `redEntry_one_*`, `redEntry_S_*`, `redEntry_T_*`) that reduce the mod-`2` entries of any word
  in `S`, `T` and their inverses to explicit elements of `ZMod 2`.
* `VOA.ThetaGroup.IsThetaCongr` — the congruence condition "`g ≡ 1` or `g ≡ S` mod `2`",
  written out entry by entry.
* `VOA.ThetaGroup.GammaTheta` — the theta group, as a `Subgroup SL(2,ℤ)`.  Closure under
  multiplication and inversion is a genuine `2 × 2` computation modulo `2` and is proved here.
* `VOA.ThetaGroup.genSTsq` — the subgroup `⟨S, T²⟩`, definitionally the `thetaGroup` of
  `VOA.Modularity.SlashSubgroup`.
* `VOA.ThetaGroup.repSet`, `PermutesCosets`, `permutesSubgroup` — the Schreier-style
  machinery for the generation theorem: the three right-coset representatives `1`, `T`, `T·S`,
  and the (sub)group of elements permuting the three cosets of `⟨S, T²⟩` they represent.
* `VOA.ThetaGroup.cosetRep` — the three left-coset representatives `1`, `T⁻¹`, `(T·S)⁻¹`
  used for the index computation.

## Main results

* `S_mem`, `T_sq_mem`, `T_zpow_two_mul_mem` — `S ∈ Γ_θ`, `T² ∈ Γ_θ`, `T^{2n} ∈ Γ_θ`.
* `T_not_mem` — `T ∉ Γ_θ`.  This is what makes `Γ_θ` a *proper* subgroup, and is exactly the
  obstruction that half-integer conformal weights create.
* `Gamma_two_le` — `Γ(2) ≤ Γ_θ`, so `Γ_θ` is a congruence subgroup of level `2`.
* `GammaTheta_eq_genSTsq` — `Γ_θ = ⟨S, T²⟩`.  Both inclusions: `closure_S_T_sq_le` is the
  easy one, the reverse is a finite Schreier coset argument (`permutesCosets_all`).
* `T_not_mem_genSTsq` — `T ∉ ⟨S, T²⟩`, i.e. the `Prop` `ThetaGroupProper` of
  `VOA.Modularity.SlashSubgroup` holds.
* `mem_or_T_mul_mem_or_T_mul_S_mul_mem` — every `g ∈ SL(2,ℤ)` lies in one of the three cosets
  `Γ_θ`, `T⁻¹Γ_θ`, `(T·S)⁻¹Γ_θ`.
* `index_eq_three` — `[SL(2,ℤ) : Γ_θ] = 3`.
* `smul_def` — the action of `Γ_θ` on the upper half-plane, by restriction.

## Implementation notes

Everything is reduced to arithmetic in `ZMod 2`, where `decide` is available: the four `redEntry`
values of a word in `S` and `T` simp-normalise to literals, and the resulting closed proposition
is discharged by `decide`.  No `sorry`, no new axioms.
-/

open Matrix Matrix.SpecialLinearGroup

open scoped MatrixGroups

namespace VOA.ThetaGroup

/-! ## Matrix entries modulo `2` -/

/-- `redEntry g i j` is the `(i,j)` matrix entry of `g ∈ SL(2,ℤ)`, reduced modulo `2`. -/
def redEntry (g : SL(2, ℤ)) (i j : Fin 2) : ZMod 2 :=
  (((g : Matrix (Fin 2) (Fin 2) ℤ) i j : ℤ) : ZMod 2)

/-- Read off the four reduced entries from an explicit matrix representative. -/
theorem redEntry_of_coe {g : SL(2, ℤ)} {a b c d : ℤ}
    (h : (g : Matrix (Fin 2) (Fin 2) ℤ) = !![a, b; c, d]) :
    redEntry g 0 0 = (a : ZMod 2) ∧ redEntry g 0 1 = (b : ZMod 2) ∧
      redEntry g 1 0 = (c : ZMod 2) ∧ redEntry g 1 1 = (d : ZMod 2) := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> · unfold redEntry; rw [h]; simp

@[simp] theorem redEntry_mul_00 (x y : SL(2, ℤ)) :
    redEntry (x * y) 0 0 = redEntry x 0 0 * redEntry y 0 0 + redEntry x 0 1 * redEntry y 1 0 := by
  unfold redEntry
  rw [SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (x : Matrix (Fin 2) (Fin 2) ℤ) (y : Matrix (Fin 2) (Fin 2) ℤ)).1]
  push_cast
  ring

@[simp] theorem redEntry_mul_01 (x y : SL(2, ℤ)) :
    redEntry (x * y) 0 1 = redEntry x 0 0 * redEntry y 0 1 + redEntry x 0 1 * redEntry y 1 1 := by
  unfold redEntry
  rw [SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (x : Matrix (Fin 2) (Fin 2) ℤ) (y : Matrix (Fin 2) (Fin 2) ℤ)).2.1]
  push_cast
  ring

@[simp] theorem redEntry_mul_10 (x y : SL(2, ℤ)) :
    redEntry (x * y) 1 0 = redEntry x 1 0 * redEntry y 0 0 + redEntry x 1 1 * redEntry y 1 0 := by
  unfold redEntry
  rw [SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (x : Matrix (Fin 2) (Fin 2) ℤ) (y : Matrix (Fin 2) (Fin 2) ℤ)).2.2.1]
  push_cast
  ring

@[simp] theorem redEntry_mul_11 (x y : SL(2, ℤ)) :
    redEntry (x * y) 1 1 = redEntry x 1 0 * redEntry y 0 1 + redEntry x 1 1 * redEntry y 1 1 := by
  unfold redEntry
  rw [SpecialLinearGroup.coe_mul,
    (Matrix.two_mul_expl (x : Matrix (Fin 2) (Fin 2) ℤ) (y : Matrix (Fin 2) (Fin 2) ℤ)).2.2.2]
  push_cast
  ring

/-- The explicit inverse of an element of `SL(2,ℤ)`, as a matrix. -/
theorem coe_inv_eq (x : SL(2, ℤ)) :
    ((x⁻¹ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) =
      !![(x : Matrix (Fin 2) (Fin 2) ℤ) 1 1, -(x : Matrix (Fin 2) (Fin 2) ℤ) 0 1;
        -(x : Matrix (Fin 2) (Fin 2) ℤ) 1 0, (x : Matrix (Fin 2) (Fin 2) ℤ) 0 0] := by
  rw [SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]

@[simp] theorem redEntry_inv_00 (x : SL(2, ℤ)) : redEntry x⁻¹ 0 0 = redEntry x 1 1 :=
  (redEntry_of_coe (coe_inv_eq x)).1

@[simp] theorem redEntry_inv_01 (x : SL(2, ℤ)) : redEntry x⁻¹ 0 1 = redEntry x 0 1 := by
  rw [(redEntry_of_coe (coe_inv_eq x)).2.1, Int.cast_neg, CharTwo.neg_eq]
  rfl

@[simp] theorem redEntry_inv_10 (x : SL(2, ℤ)) : redEntry x⁻¹ 1 0 = redEntry x 1 0 := by
  rw [(redEntry_of_coe (coe_inv_eq x)).2.2.1, Int.cast_neg, CharTwo.neg_eq]
  rfl

@[simp] theorem redEntry_inv_11 (x : SL(2, ℤ)) : redEntry x⁻¹ 1 1 = redEntry x 0 0 :=
  (redEntry_of_coe (coe_inv_eq x)).2.2.2

/-- The identity of `SL(2,ℤ)` as an explicit matrix. -/
theorem coe_one_eq : ((1 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = !![1, 0; 0, 1] := by
  rw [SpecialLinearGroup.coe_one, Matrix.one_fin_two]

@[simp] theorem redEntry_one_00 : redEntry 1 0 0 = 1 := by
  rw [(redEntry_of_coe coe_one_eq).1]; decide

@[simp] theorem redEntry_one_01 : redEntry 1 0 1 = 0 := by
  rw [(redEntry_of_coe coe_one_eq).2.1]; decide

@[simp] theorem redEntry_one_10 : redEntry 1 1 0 = 0 := by
  rw [(redEntry_of_coe coe_one_eq).2.2.1]; decide

@[simp] theorem redEntry_one_11 : redEntry 1 1 1 = 1 := by
  rw [(redEntry_of_coe coe_one_eq).2.2.2]; decide

@[simp] theorem redEntry_S_00 : redEntry ModularGroup.S 0 0 = 0 := by
  rw [(redEntry_of_coe ModularGroup.coe_S).1]; decide

@[simp] theorem redEntry_S_01 : redEntry ModularGroup.S 0 1 = 1 := by
  rw [(redEntry_of_coe ModularGroup.coe_S).2.1]; decide

@[simp] theorem redEntry_S_10 : redEntry ModularGroup.S 1 0 = 1 := by
  rw [(redEntry_of_coe ModularGroup.coe_S).2.2.1]; decide

@[simp] theorem redEntry_S_11 : redEntry ModularGroup.S 1 1 = 0 := by
  rw [(redEntry_of_coe ModularGroup.coe_S).2.2.2]; decide

@[simp] theorem redEntry_T_00 : redEntry ModularGroup.T 0 0 = 1 := by
  rw [(redEntry_of_coe ModularGroup.coe_T).1]; decide

@[simp] theorem redEntry_T_01 : redEntry ModularGroup.T 0 1 = 1 := by
  rw [(redEntry_of_coe ModularGroup.coe_T).2.1]; decide

@[simp] theorem redEntry_T_10 : redEntry ModularGroup.T 1 0 = 0 := by
  rw [(redEntry_of_coe ModularGroup.coe_T).2.2.1]; decide

@[simp] theorem redEntry_T_11 : redEntry ModularGroup.T 1 1 = 1 := by
  rw [(redEntry_of_coe ModularGroup.coe_T).2.2.2]; decide

/-- The determinant condition, read modulo `2`. -/
theorem redEntry_det (g : SL(2, ℤ)) :
    redEntry g 0 0 * redEntry g 1 1 - redEntry g 0 1 * redEntry g 1 0 = 1 := by
  have h : ((g : Matrix (Fin 2) (Fin 2) ℤ)).det = 1 := g.2
  rw [Matrix.det_fin_two] at h
  have h2 := congrArg (fun n : ℤ => (n : ZMod 2)) h
  simp only at h2
  push_cast at h2
  exact h2

/-! ## The theta group -/

/-- The congruence condition cutting out the theta group: the reduction of `g` modulo `2` is
either the identity matrix or `S = !![0, -1; 1, 0]`.  Equivalently `g ≡ 1` or `g ≡ S` mod `2`. -/
def IsThetaCongr (g : SL(2, ℤ)) : Prop :=
  (redEntry g 0 0 = 1 ∧ redEntry g 0 1 = 0 ∧ redEntry g 1 0 = 0 ∧ redEntry g 1 1 = 1) ∨
    (redEntry g 0 0 = 0 ∧ redEntry g 0 1 = 1 ∧ redEntry g 1 0 = 1 ∧ redEntry g 1 1 = 0)

/-- The **theta group** `Γ_θ ≤ SL(2,ℤ)`: the matrices congruent modulo `2` to either the identity
or to `S`.  It is the index-`3` subgroup generated by `S` and `T²`, and it is the group for which
characters of super / half-integer-weight vertex operator algebras are modular. -/
def GammaTheta : Subgroup SL(2, ℤ) where
  carrier := {g | IsThetaCongr g}
  one_mem' := by
    change IsThetaCongr 1
    unfold IsThetaCongr
    simp only [redEntry_one_00, redEntry_one_01, redEntry_one_10, redEntry_one_11]
    decide
  mul_mem' := by
    intro a b ha hb
    change IsThetaCongr (a * b)
    have ha' : IsThetaCongr a := ha
    have hb' : IsThetaCongr b := hb
    unfold IsThetaCongr at ha' hb' ⊢
    simp only [redEntry_mul_00, redEntry_mul_01, redEntry_mul_10, redEntry_mul_11]
    rcases ha' with ⟨p1, p2, p3, p4⟩ | ⟨p1, p2, p3, p4⟩ <;>
      rcases hb' with ⟨q1, q2, q3, q4⟩ | ⟨q1, q2, q3, q4⟩ <;>
        rw [p1, p2, p3, p4, q1, q2, q3, q4] <;> decide
  inv_mem' := by
    intro a ha
    change IsThetaCongr a⁻¹
    have ha' : IsThetaCongr a := ha
    unfold IsThetaCongr at ha' ⊢
    simp only [redEntry_inv_00, redEntry_inv_01, redEntry_inv_10, redEntry_inv_11]
    tauto

@[simp] theorem mem_GammaTheta {g : SL(2, ℤ)} : g ∈ GammaTheta ↔ IsThetaCongr g := Iff.rfl

theorem mem_GammaTheta_iff {g : SL(2, ℤ)} : g ∈ GammaTheta ↔
    (redEntry g 0 0 = 1 ∧ redEntry g 0 1 = 0 ∧ redEntry g 1 0 = 0 ∧ redEntry g 1 1 = 1) ∨
      (redEntry g 0 0 = 0 ∧ redEntry g 0 1 = 1 ∧ redEntry g 1 0 = 1 ∧ redEntry g 1 1 = 0) :=
  Iff.rfl

/-- `Γ(2) ≤ Γ_θ`: the theta group is a congruence subgroup of level `2`. -/
theorem Gamma_two_le : CongruenceSubgroup.Gamma 2 ≤ GammaTheta := by
  intro g hg
  rw [CongruenceSubgroup.Gamma_mem] at hg
  exact Or.inl ⟨hg.1, hg.2.1, hg.2.2.1, hg.2.2.2⟩

/-! ## The generators -/

/-- `S = !![0, -1; 1, 0]` lies in `Γ_θ`. -/
theorem S_mem : ModularGroup.S ∈ GammaTheta := by
  change IsThetaCongr ModularGroup.S
  unfold IsThetaCongr
  simp only [redEntry_S_00, redEntry_S_01, redEntry_S_10, redEntry_S_11]
  decide

/-- `T² = !![1, 2; 0, 1]` lies in `Γ_θ`. -/
theorem T_sq_mem : ModularGroup.T ^ 2 ∈ GammaTheta := by
  change IsThetaCongr (ModularGroup.T ^ 2)
  unfold IsThetaCongr
  simp only [pow_two, redEntry_mul_00, redEntry_mul_01, redEntry_mul_10, redEntry_mul_11,
    redEntry_T_00, redEntry_T_01, redEntry_T_10, redEntry_T_11]
  decide

/-- Every even power of `T` lies in `Γ_θ`. -/
theorem T_zpow_two_mul_mem (n : ℤ) : ModularGroup.T ^ (2 * n) ∈ GammaTheta := by
  change IsThetaCongr (ModularGroup.T ^ (2 * n))
  have h : ((ModularGroup.T ^ (2 * n) : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) =
      !![1, 2 * n; 0, 1] := ModularGroup.coe_T_zpow (2 * n)
  obtain ⟨e00, e01, e10, e11⟩ := redEntry_of_coe h
  refine Or.inl ⟨?_, ?_, ?_, ?_⟩
  · rw [e00]; decide
  · rw [e01, show (2 * n : ℤ) = n + n by ring, Int.cast_add, CharTwo.add_self_eq_zero]
  · rw [e10]; decide
  · rw [e11]; decide

/-- `T ∉ Γ_θ`.  This is the point of the whole construction: the translation `τ ↦ τ + 1` is
*not* in the theta group, which is why half-integer conformal weights are only `Γ_θ`-modular. -/
theorem T_not_mem : ModularGroup.T ∉ GammaTheta := by
  intro h
  have h' : IsThetaCongr ModularGroup.T := h
  unfold IsThetaCongr at h'
  simp only [redEntry_T_00, redEntry_T_01, redEntry_T_10, redEntry_T_11] at h'
  exact absurd h' (by decide)

/-- `T⁻¹ ∉ Γ_θ`. -/
theorem T_inv_not_mem : ModularGroup.T⁻¹ ∉ GammaTheta := by
  intro h
  exact T_not_mem (by simpa using GammaTheta.inv_mem h)

/-- `T · S ∉ Γ_θ`. -/
theorem T_mul_S_not_mem : ModularGroup.T * ModularGroup.S ∉ GammaTheta := by
  intro h
  have h' : IsThetaCongr (ModularGroup.T * ModularGroup.S) := h
  unfold IsThetaCongr at h'
  simp only [redEntry_mul_00, redEntry_mul_01, redEntry_mul_10, redEntry_mul_11,
    redEntry_S_00, redEntry_S_01, redEntry_S_10, redEntry_S_11,
    redEntry_T_00, redEntry_T_01, redEntry_T_10, redEntry_T_11] at h'
  exact absurd h' (by decide)

/-- `Γ_θ` is a proper subgroup of `SL(2,ℤ)`. -/
theorem ne_top : GammaTheta ≠ ⊤ := fun h => T_not_mem (h ▸ Subgroup.mem_top _)

/-! ## Generation by `S` and `T²` -/

/-- `⟨S, T²⟩ ≤ SL(2,ℤ)`, the subgroup generated by `S` and `T²`.  This is definitionally the
`thetaGroup` of `VOA.Modularity.SlashSubgroup`. -/
def genSTsq : Subgroup SL(2, ℤ) :=
  Subgroup.closure ({ModularGroup.S, ModularGroup.T ^ 2} : Set SL(2, ℤ))

theorem S_mem_genSTsq : ModularGroup.S ∈ genSTsq :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem T_sq_mem_genSTsq : ModularGroup.T ^ 2 ∈ genSTsq :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

/-- The easy inclusion: the subgroup generated by `S` and `T²` is contained in `Γ_θ`. -/
theorem closure_S_T_sq_le : genSTsq ≤ GammaTheta := by
  rw [genSTsq, Subgroup.closure_le]
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact S_mem
  · exact T_sq_mem

/-- The three right-coset representatives `1`, `T`, `T·S` for `⟨S, T²⟩` in `SL(2,ℤ)`. -/
def repSet : Set SL(2, ℤ) := {1, ModularGroup.T, ModularGroup.T * ModularGroup.S}

theorem one_mem_repSet : (1 : SL(2, ℤ)) ∈ repSet := Set.mem_insert _ _

theorem T_mem_repSet : ModularGroup.T ∈ repSet :=
  Set.mem_insert_of_mem _ (Set.mem_insert _ _)

theorem T_mul_S_mem_repSet : ModularGroup.T * ModularGroup.S ∈ repSet :=
  Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)

/-- `g` permutes the three right cosets `⟨S,T²⟩ · t`, `t ∈ repSet`, and so does `g⁻¹`.

Carrying the condition for `g` *and* `g⁻¹` is what makes this a subgroup by a two-line argument:
no counting is needed to invert the induced permutation of the three cosets. -/
def PermutesCosets (g : SL(2, ℤ)) : Prop :=
  (∀ t ∈ repSet, ∃ t' ∈ repSet, t * g * t'⁻¹ ∈ genSTsq) ∧
    ∀ t ∈ repSet, ∃ t' ∈ repSet, t * g⁻¹ * t'⁻¹ ∈ genSTsq

/-- The elements permuting the three cosets form a subgroup. -/
def permutesSubgroup : Subgroup SL(2, ℤ) where
  carrier := {g | PermutesCosets g}
  one_mem' := by
    change PermutesCosets 1
    exact ⟨fun t ht => ⟨t, ht, by simp⟩, fun t ht => ⟨t, ht, by simp⟩⟩
  mul_mem' := by
    intro a b ha hb
    obtain ⟨ha1, ha2⟩ : PermutesCosets a := ha
    obtain ⟨hb1, hb2⟩ : PermutesCosets b := hb
    refine ⟨fun t ht => ?_, fun t ht => ?_⟩
    · obtain ⟨u, hu, h1⟩ := ha1 t ht
      obtain ⟨v, hv, h2⟩ := hb1 u hu
      refine ⟨v, hv, ?_⟩
      have e : t * (a * b) * v⁻¹ = (t * a * u⁻¹) * (u * b * v⁻¹) := by group
      rw [e]
      exact mul_mem h1 h2
    · obtain ⟨u, hu, h1⟩ := hb2 t ht
      obtain ⟨v, hv, h2⟩ := ha2 u hu
      refine ⟨v, hv, ?_⟩
      have e : t * (a * b)⁻¹ * v⁻¹ = (t * b⁻¹ * u⁻¹) * (u * a⁻¹ * v⁻¹) := by group
      rw [e]
      exact mul_mem h1 h2
  inv_mem' := by
    intro a ha
    obtain ⟨ha1, ha2⟩ : PermutesCosets a := ha
    exact ⟨ha2, by simpa using ha1⟩

/-- `S` permutes the three cosets. -/
theorem S_permutesCosets : PermutesCosets ModularGroup.S := by
  constructor
  · intro t ht
    simp only [repSet, Set.mem_insert_iff, Set.mem_singleton_iff] at ht
    rcases ht with rfl | rfl | rfl
    · exact ⟨1, one_mem_repSet, by simpa using S_mem_genSTsq⟩
    · refine ⟨ModularGroup.T * ModularGroup.S, T_mul_S_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.S * (ModularGroup.T * ModularGroup.S)⁻¹
        = (1 : SL(2, ℤ)) by group]
      exact one_mem _
    · refine ⟨ModularGroup.T, T_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.S * ModularGroup.S * ModularGroup.T⁻¹
        = ModularGroup.S * ModularGroup.S by decide]
      exact mul_mem S_mem_genSTsq S_mem_genSTsq
  · intro t ht
    simp only [repSet, Set.mem_insert_iff, Set.mem_singleton_iff] at ht
    rcases ht with rfl | rfl | rfl
    · exact ⟨1, one_mem_repSet, by simpa using inv_mem S_mem_genSTsq⟩
    · refine ⟨ModularGroup.T * ModularGroup.S, T_mul_S_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.S⁻¹ * (ModularGroup.T * ModularGroup.S)⁻¹
        = ModularGroup.S * ModularGroup.S by decide]
      exact mul_mem S_mem_genSTsq S_mem_genSTsq
    · refine ⟨ModularGroup.T, T_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.S * ModularGroup.S⁻¹ * ModularGroup.T⁻¹
        = (1 : SL(2, ℤ)) by group]
      exact one_mem _

/-- `T` permutes the three cosets. -/
theorem T_permutesCosets : PermutesCosets ModularGroup.T := by
  constructor
  · intro t ht
    simp only [repSet, Set.mem_insert_iff, Set.mem_singleton_iff] at ht
    rcases ht with rfl | rfl | rfl
    · refine ⟨ModularGroup.T, T_mem_repSet, ?_⟩
      rw [show (1 : SL(2, ℤ)) * ModularGroup.T * ModularGroup.T⁻¹ = (1 : SL(2, ℤ)) by group]
      exact one_mem _
    · refine ⟨1, one_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.T * (1 : SL(2, ℤ))⁻¹ = ModularGroup.T ^ 2 by
        rw [pow_two]; group]
      exact T_sq_mem_genSTsq
    · refine ⟨ModularGroup.T * ModularGroup.S, T_mul_S_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.S * ModularGroup.T *
        (ModularGroup.T * ModularGroup.S)⁻¹ = ModularGroup.S⁻¹ * (ModularGroup.T ^ 2)⁻¹ by decide]
      exact mul_mem (inv_mem S_mem_genSTsq) (inv_mem T_sq_mem_genSTsq)
  · intro t ht
    simp only [repSet, Set.mem_insert_iff, Set.mem_singleton_iff] at ht
    rcases ht with rfl | rfl | rfl
    · refine ⟨ModularGroup.T, T_mem_repSet, ?_⟩
      rw [show (1 : SL(2, ℤ)) * ModularGroup.T⁻¹ * ModularGroup.T⁻¹ = (ModularGroup.T ^ 2)⁻¹ by
        group]
      exact inv_mem T_sq_mem_genSTsq
    · refine ⟨1, one_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.T⁻¹ * (1 : SL(2, ℤ))⁻¹ = (1 : SL(2, ℤ)) by group]
      exact one_mem _
    · refine ⟨ModularGroup.T * ModularGroup.S, T_mul_S_mem_repSet, ?_⟩
      rw [show ModularGroup.T * ModularGroup.S * ModularGroup.T⁻¹ *
        (ModularGroup.T * ModularGroup.S)⁻¹ = ModularGroup.T ^ 2 * ModularGroup.S by decide]
      exact mul_mem T_sq_mem_genSTsq S_mem_genSTsq

/-- Every element of `SL(2,ℤ)` permutes the three cosets: `S` and `T` do, and they generate
(`SpecialLinearGroup.SL2Z_generators`). -/
theorem permutesCosets_all (g : SL(2, ℤ)) : PermutesCosets g := by
  have hle : (⊤ : Subgroup SL(2, ℤ)) ≤ permutesSubgroup := by
    rw [← SpecialLinearGroup.SL2Z_generators, Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact S_permutesCosets
    · exact T_permutesCosets
  exact hle (Subgroup.mem_top g)

/-- **`Γ_θ` is generated by `S` and `T²`.**

The proof is a Schreier-style coset argument, entirely finite: `S` and `T` permute the three
right cosets of `⟨S, T²⟩` represented by `1`, `T`, `T·S` (twelve explicit matrix identities), so
every `g ∈ SL(2,ℤ)` satisfies `g · t⁻¹ ∈ ⟨S, T²⟩` for one of the three `t`.  If moreover
`g ∈ Γ_θ`, then `t ∈ Γ_θ` too, and `T ∉ Γ_θ`, `T·S ∉ Γ_θ` force `t = 1`. -/
theorem GammaTheta_eq_genSTsq : GammaTheta = genSTsq := by
  refine le_antisymm (fun g hg => ?_) closure_S_T_sq_le
  obtain ⟨t, ht, h⟩ := (permutesCosets_all g).1 1 one_mem_repSet
  rw [one_mul] at h
  have hkG : g * t⁻¹ ∈ GammaTheta := closure_S_T_sq_le h
  have htG : t ∈ GammaTheta := by
    rw [show t = (g * t⁻¹)⁻¹ * g by group]
    exact mul_mem (inv_mem hkG) hg
  simp only [repSet, Set.mem_insert_iff, Set.mem_singleton_iff] at ht
  rcases ht with rfl | rfl | rfl
  · simpa using h
  · exact absurd htG T_not_mem
  · exact absurd htG T_mul_S_not_mem

/-- Membership in `⟨S, T²⟩` is the mod-`2` congruence condition. -/
theorem mem_genSTsq_iff {g : SL(2, ℤ)} : g ∈ genSTsq ↔ IsThetaCongr g := by
  rw [← GammaTheta_eq_genSTsq]
  exact Iff.rfl

/-- `T ∉ ⟨S, T²⟩`.  `Subgroup.closure {S, T²}` is the definition of `thetaGroup` in
`VOA.Modularity.SlashSubgroup`, so this discharges the `Prop` `ThetaGroupProper`
recorded there. -/
theorem T_not_mem_genSTsq : ModularGroup.T ∉ genSTsq := fun h =>
  T_not_mem (by rw [GammaTheta_eq_genSTsq]; exact h)

/-! ## The three cosets, and the index -/

/-- The six elements of `SL(2, ZMod 2)`, in the form of a classification of the mod-`2` entries of
an element of `SL(2,ℤ)`. -/
theorem classify_mod_two : ∀ a b c d : ZMod 2, a * d - b * c = 1 →
    (a = 1 ∧ b = 0 ∧ c = 0 ∧ d = 1) ∨ (a = 0 ∧ b = 1 ∧ c = 1 ∧ d = 0) ∨
      (a = 1 ∧ b = 1 ∧ c = 0 ∧ d = 1) ∨ (a = 1 ∧ b = 1 ∧ c = 1 ∧ d = 0) ∨
        (a = 0 ∧ b = 1 ∧ c = 1 ∧ d = 1) ∨ (a = 1 ∧ b = 0 ∧ c = 1 ∧ d = 1) := by
  decide

/-- Every element of `SL(2,ℤ)` lies in one of the three cosets `Γ_θ`, `T⁻¹Γ_θ`, `(T·S)⁻¹Γ_θ`. -/
theorem mem_or_T_mul_mem_or_T_mul_S_mul_mem (g : SL(2, ℤ)) :
    g ∈ GammaTheta ∨ ModularGroup.T * g ∈ GammaTheta ∨
      ModularGroup.T * ModularGroup.S * g ∈ GammaTheta := by
  rcases classify_mod_two _ _ _ _ (redEntry_det g) with
    ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩ |
      ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩ <;>
    simp only [mem_GammaTheta, IsThetaCongr, redEntry_mul_00, redEntry_mul_01, redEntry_mul_10,
      redEntry_mul_11, redEntry_S_00, redEntry_S_01, redEntry_S_10, redEntry_S_11,
      redEntry_T_00, redEntry_T_01, redEntry_T_10, redEntry_T_11, h1, h2, h3, h4] <;>
    decide

/-- The three coset representatives for `Γ_θ` in `SL(2,ℤ)`. -/
def cosetRep : Fin 3 → SL(2, ℤ)
  | 0 => 1
  | 1 => ModularGroup.T⁻¹
  | 2 => (ModularGroup.T * ModularGroup.S)⁻¹

theorem cosetRep_zero : cosetRep 0 = 1 := rfl

theorem cosetRep_one : cosetRep 1 = ModularGroup.T⁻¹ := rfl

theorem cosetRep_two : cosetRep 2 = (ModularGroup.T * ModularGroup.S)⁻¹ := rfl

/-- The three coset representatives are pairwise inequivalent modulo `Γ_θ`. -/
theorem cosetRep_inv_mul_not_mem :
    ((cosetRep 0)⁻¹ * cosetRep 1 ∉ GammaTheta) ∧ ((cosetRep 0)⁻¹ * cosetRep 2 ∉ GammaTheta) ∧
      ((cosetRep 1)⁻¹ * cosetRep 0 ∉ GammaTheta) ∧ ((cosetRep 1)⁻¹ * cosetRep 2 ∉ GammaTheta) ∧
        ((cosetRep 2)⁻¹ * cosetRep 0 ∉ GammaTheta) ∧
          ((cosetRep 2)⁻¹ * cosetRep 1 ∉ GammaTheta) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    · intro h
      rw [mem_GammaTheta] at h
      unfold IsThetaCongr at h
      simp only [cosetRep_zero, cosetRep_one, cosetRep_two, redEntry_mul_00, redEntry_mul_01,
        redEntry_mul_10, redEntry_mul_11, redEntry_inv_00, redEntry_inv_01, redEntry_inv_10,
        redEntry_inv_11, redEntry_one_00, redEntry_one_01, redEntry_one_10, redEntry_one_11,
        redEntry_S_00, redEntry_S_01, redEntry_S_10, redEntry_S_11, redEntry_T_00, redEntry_T_01,
        redEntry_T_10, redEntry_T_11] at h
      exact absurd h (by decide)

set_option maxHeartbeats 1000000 in
-- The nine-case `fin_cases` on the three coset representatives unfolds concrete `SL(2,ℤ)`
-- matrices, which exceeds the default heartbeat budget.
/-- The theta group has index `3` in `SL(2,ℤ)`. -/
theorem index_eq_three : GammaTheta.index = 3 := by
  obtain ⟨n01, n02, n10, n12, n20, n21⟩ := cosetRep_inv_mul_not_mem
  have hb : Function.Bijective
      (fun i : Fin 3 => (cosetRep i : SL(2, ℤ) ⧸ GammaTheta)) := by
    constructor
    · intro i j hij
      simp only at hij
      rw [QuotientGroup.eq] at hij
      fin_cases i <;> fin_cases j
      · rfl
      · exact absurd hij n01
      · exact absurd hij n02
      · exact absurd hij n10
      · rfl
      · exact absurd hij n12
      · exact absurd hij n20
      · exact absurd hij n21
      · rfl
    · intro q
      refine QuotientGroup.induction_on q ?_
      intro g
      rcases mem_or_T_mul_mem_or_T_mul_S_mul_mem g with h | h | h
      · exact ⟨0, (QuotientGroup.eq (s := GammaTheta)).mpr (by simpa [cosetRep_zero] using h)⟩
      · exact ⟨1, (QuotientGroup.eq (s := GammaTheta)).mpr (by simpa [cosetRep_one] using h)⟩
      · exact ⟨2, (QuotientGroup.eq (s := GammaTheta)).mpr (by simpa [cosetRep_two] using h)⟩
  have h := Nat.card_eq_of_bijective _ hb
  simpa [Subgroup.index, Nat.card_eq_fintype_card] using h.symm

/-- `⟨S, T²⟩` has index `3` in `SL(2,ℤ)`. -/
theorem genSTsq_index_eq_three : genSTsq.index = 3 := by
  rw [← GammaTheta_eq_genSTsq]
  exact index_eq_three

/-! ## The action on the upper half-plane -/

/-- `Γ_θ` acts on the upper half-plane by restriction of the `SL(2,ℤ)`-action. -/
theorem smul_def (γ : GammaTheta) (τ : UpperHalfPlane) : γ • τ = (γ : SL(2, ℤ)) • τ := rfl

/-- The `Γ_θ`-action on the upper half-plane exists, by restriction of the `SL(2,ℤ)`-action:
no new instance is needed, the ambient `MulAction` restricts along the inclusion. -/
theorem mulAction_upperHalfPlane : Nonempty (MulAction GammaTheta UpperHalfPlane) :=
  ⟨inferInstance⟩

end VOA.ThetaGroup
