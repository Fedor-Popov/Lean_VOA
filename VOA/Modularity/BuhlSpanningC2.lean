import VOA.Modularity.BuhlSpanningData
import VOA.Modularity.C2Extraction

/-!
# `C₂`-cofinite ⟹ ordered spanning, and the convergence consequence

The final step of `LiFiltration` → `OrderedSpan` → `BuhlSpanningProof` →
`OrderedMonomialBridge` → `BuhlSpanningData`, fed by the generator extraction
`C2Extraction.exists_homog_gen_of_C2Cofinite`.

## Contents

* **`orderedSpanningData_adjoint_of_C2Cofinite`** — for a `C₂`-cofinite `𝒱` with nonzero
  vacuum, the adjoint module `𝒱` admits `OrderedSpanningData` at conformal weight `0`.
  ⚠ **This is the Li-filtration ORDERING theorem, NOT Gaberdiel–Neitzke's spanning theorem**
  `OrderedSpanningData` (see
  `Modularity.GrowthBound`) quantifies `∃ μ : Fin g × ℕ →₀ ℕ` with **no bound, no `Nodup`, and no
  strict-decrease clause** — `OrdPairs` (`Modularity.OrderedSpan`) is non-strict lexicographic
  sortedness, so repeats are allowed. That is exactly enough for `SubexponentialCoeffs` (coloured
  partitions grow subexponentially, repeats and all), and it is **strictly weaker** than
  Gaberdiel–Neitzke `hep-th/0009235` Prop. 8, whose monomials satisfy `N₁ > N₂ > ⋯ > N_k > 0`.
  ⚠ Do **not** reach for this theorem to obtain `C_m`-cofiniteness or `dim A_n(𝒱) < ∞`
  (Buhl `math/0111296` Cor. 5.5): Buhl's mechanism is a **length** bound — strict decrease forces
  `length ≤ N₁` — and a pure weight bound is useless (`x₍₋₁₎^k 𝟙` has unbounded weight with every
  mode index `1`). GN Prop. 8 is not in this repository.
* **`subexponentialCoeffs_adjoint_of_C2Cofinite`** — hence `dim 𝒱ₙ` grows subexponentially
  and (`ConvergenceBridge`) the character of `𝒱` converges on all of `ℍ`.
* **`orderedSpanningData_of_C2Cofinite`** / **`subexponentialCoeffs_of_C2Cofinite`** — the
  module statements, carrying the single remaining hypothesis `LWGenerated` (see below).
* `BuhlSpanningOn` — the `BuhlSpanning` predicate of `Modularity.GrowthBound` relativised to the
  modules that satisfy that hypothesis, and `buhlSpanningOn_of_C2Cofinite`.

## The exact remaining gap

`GrowthBound.BuhlSpanning W` quantifies over **every** `OrdVModule` with a conformal weight, with
no generation hypothesis.  Buhl's theorem (J. Algebra 254 (2002), Main Theorem) is instead about
a weak module **generated by one vector**, and its spanning monomials `x¹₍₋n₁₎⋯x^k₍₋n_k₎w` allow
modes `nⱼ ≤ 0` (i.e. *non-negative* mode indices) in a bounded range `nⱼ > −L`, each repeated at
most `Q − 1` times.  That bounded-mode, bounded-length inner part is what has to be absorbed into
the finite bottom family `bot`, and its finite-dimensionality is Buhl's §3 weight count
(`B = max wt X`, `N` with `⊕_{i≥N}𝒱ᵢ ⊆ C₂(𝒱)`, `Q = max{N, 2B−1}+1`, Prop 3.7).

That the absorption is genuinely needed — i.e. that `LWGenerated` fails for `B = M_h` — is not a
formalisation artefact: for the Ising model `𝒱 = L(1/2,0)` one has `𝒱₁ = 0`, so **no** word in
strictly negative modes raises the weight by exactly `1`, while the module `L(1/2,1/16)` has a
nonzero level-`1` space, spanned by `L₋₁v = ω₍₀₎v` — a non-negative mode.  For the **adjoint**
module the creation axiom `u₍₋₁₎𝟙 = u` supplies the missing words, which is why the `𝒱`-case
here is unconditional.

## Status
Proved, axiom-clean, `pbw`-free, no `sorry`.  Residual: `LWGenerated` for a finite bottom family
(Buhl §3–4).
-/

namespace VOA

open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## The `𝒱`-case: unconditional -/

/-- **The Li-filtration ordering theorem, unconditional.**  A `C₂`-cofinite VOA with nonzero
vacuum admits ordered (coloured-partition) spanning data for itself.

⚠ **Not** Gaberdiel–Neitzke's spanning theorem: `OrderedSpanningData`
carries **no strict-decrease condition** on the mode indices, only a canonical lexicographic
ordering of the factors. Sufficient for `SubexponentialCoeffs`; insufficient for `C_m`-cofiniteness
or `dim A_n(𝒱) < ∞`. See the module docstring. -/
theorem orderedSpanningData_adjoint_of_C2Cofinite (W : VertexOperatorAlgebra 𝒱)
    (hne : W.vacuum ≠ 0) (hC2 : C2Cofinite W) :
    Nonempty (OrderedSpanningData (adjointModule W) 0) := by
  obtain ⟨g, gen, wt, hwt, hgen, hdec⟩ := exists_homog_gen_of_C2Cofinite W hC2
  exact ⟨orderedSpanningDataAdjoint W hne gen wt hwt hgen hdec⟩

/-- **The growth bound for a `C₂`-cofinite VOA.**  `dim 𝒱ₙ` is subexponential, so the
character of `𝒱` converges on all of `ℍ` (`ConvergenceBridge.qSummable_gradedDim`). -/
theorem subexponentialCoeffs_adjoint_of_C2Cofinite (W : VertexOperatorAlgebra 𝒱)
    (hne : W.vacuum ≠ 0) (hC2 : C2Cofinite W) :
    SubexponentialCoeffs (adjointModule W) (0 - W.centralCharge / 24) :=
  (orderedSpanningData_adjoint_of_C2Cofinite W hne hC2).elim
    (fun d => subexponentialCoeffs_of_ordered (adjointModule W) 0 d)

/-! ## The module case, modulo lowest-weight generation -/

section Module

variable {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]

/-- **`C₂`-cofinite ⟹ ordered spanning data**, for a module presented with a finite
homogeneous bottom family that lowest-weight generates it. -/
theorem orderedSpanningData_of_C2Cofinite (hC2 : C2Cofinite W) (N : OrdVModule W M) (h : ℂ)
    (hcw : HasConformalWeight N h) {b : ℕ} (bot : Fin b → M) (botWt : Fin b → ℕ)
    (hbot : ∀ j, bot j ∈ N.weight (h + botWt j))
    (hLW : LWGenerated N.toWeakModule (Set.range bot)) :
    Nonempty (OrderedSpanningData N h) := by
  obtain ⟨g, gen, wt, hwt, hgen, hdec⟩ := exists_homog_gen_of_C2Cofinite W hC2
  exact ⟨orderedSpanningDataOf N h hcw bot botWt hbot hLW gen wt hwt hgen hdec⟩

/-- The growth bound for such a module. -/
theorem subexponentialCoeffs_of_C2Cofinite (hC2 : C2Cofinite W) (N : OrdVModule W M) (h : ℂ)
    (hcw : HasConformalWeight N h) {b : ℕ} (bot : Fin b → M) (botWt : Fin b → ℕ)
    (hbot : ∀ j, bot j ∈ N.weight (h + botWt j))
    (hLW : LWGenerated N.toWeakModule (Set.range bot)) :
    SubexponentialCoeffs N (h - W.centralCharge / 24) :=
  (orderedSpanningData_of_C2Cofinite hC2 N h hcw bot botWt hbot hLW).elim
    (fun d => subexponentialCoeffs_of_ordered N h d)

end Module

/-! ## `BuhlSpanning`, relativised -/

/-- **Buhl's spanning property, relativised** to the modules that come with a finite homogeneous
bottom family generating them by strictly negative modes.  Dropping the hypothesis
`FiniteLWGenerated` recovers `GrowthBound.BuhlSpanning`; supplying it for every module of a
`C₂`-cofinite VOA is Buhl's §3–4 (the `Q`/`L` truncation), the residual named above. -/
def FiniteLWGenerated {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]
    (N : OrdVModule W M) (h : ℂ) : Prop :=
  ∃ (b : ℕ) (bot : Fin b → M) (botWt : Fin b → ℕ),
    (∀ j, bot j ∈ N.weight (h + botWt j)) ∧ LWGenerated N.toWeakModule (Set.range bot)

/-- The relativised Buhl spanning predicate. -/
def BuhlSpanningOn (W : VertexOperatorAlgebra 𝒱) : Prop :=
  ∀ (M : Type u) [AddCommGroup M] [Module ℂ M] (N : OrdVModule W M) (h : ℂ),
    HasConformalWeight N h → FiniteLWGenerated N h → Nonempty (OrderedSpanningData N h)

/-- **`C2Cofinite W → BuhlSpanningOn W`.**  The target `C2Cofinite W → BuhlSpanning W` of
`Modularity.GrowthBound`, with the module hypothesis made explicit. -/
theorem buhlSpanningOn_of_C2Cofinite (W : VertexOperatorAlgebra 𝒱) (hC2 : C2Cofinite W) :
    BuhlSpanningOn W := by
  intro M _ _ N h hcw hfin
  obtain ⟨b, bot, botWt, hbot, hLW⟩ := hfin
  exact orderedSpanningData_of_C2Cofinite hC2 N h hcw bot botWt hbot hLW

/-- **`BuhlSpanning` from the relativised form**: if every conformal-weight module of `W`
carries a finite lowest-weight generating bottom family (Buhl's §3–4), then `W` satisfies the
`GrowthBound.BuhlSpanning` predicate verbatim, and hence every character of `W` converges. -/
theorem buhlSpanning_of_C2Cofinite (W : VertexOperatorAlgebra 𝒱) (hC2 : C2Cofinite W)
    (hfin : ∀ (M : Type u) [AddCommGroup M] [Module ℂ M] (N : OrdVModule W M) (h : ℂ),
      HasConformalWeight N h → FiniteLWGenerated N h) :
    BuhlSpanning W := by
  intro M _ _ N h hcw
  exact buhlSpanningOn_of_C2Cofinite W hC2 M N h hcw (hfin M N h hcw)

end VOA
