import Mathlib.RingTheory.PowerSeries.Inverse
import Mathlib.Analysis.SpecialFunctions.Complex.Circle

/-!
# ⚠ Why the purely formal `ℂ⟦q⟧` route cannot reach a point of the upper half-plane

A tempting route to Zhu's Theorem 5.3.3 is: build the `ℂ⟦q⟧`-module `M := (𝒱 ⊗ ℂ⟦q⟧)/O_q(𝒱)`,
prove it finitely generated (`C₂`-cofiniteness), apply Nakayama to get `M` generated by
`dim_ℂ M/qM` elements, and conclude that "the fibre at `q₀ = e^{2πiz₀}`" has dimension at most
that.  **The last step does not typecheck, and not because of a missing lemma.**

`Nakayama` does give: `M` generated by `n := dim_ℂ M/qM` elements, hence `dim_K (K ⊗_φ M) ≤ n`
for *every* ring hom `φ : ℂ⟦q⟧ → K` into a field.  But:

  ⚠ `no_algHom_powerSeries_X_ne_zero` — **there is no `ℂ`-algebra hom `ℂ⟦q⟧ → ℂ` sending `q` to a
  nonzero value.**

so there is no `φ` to apply it to.  (`Spec ℂ⟦q⟧` has two points — the closed point `q = 0` and the
generic point `ℂ((q))`; a `q₀` with `0 < |q₀| < 1` is neither.)  The proof is one line: `1 − q₀⁻¹q`
is a unit of `ℂ⟦q⟧` because its constant coefficient is `1`, and any ring hom would send it to
`1 − q₀⁻¹q₀ = 0`, which is not a unit of `ℂ`.

**Consequence, recorded honestly.** A convergence-free commutative-algebra argument over `ℂ⟦q⟧`
bounds only the *generic* fibre (over `ℂ((q))`) and the *special* fibre (at `q = 0`, which is
`Modularity.CuspLimit.blockRelSpanAtCusp`, proved to have dimension `dim A(𝒱)/[A,A]`).  To
reach a genuine `z₀ ∈ ℍ` one must leave `ℂ⟦q⟧`: either

* work over `ℂ[E₄,E₆]` — a polynomial ring, where evaluation at a point **is** a `ℂ`-algebra hom,
  and where Nakayama + spreading out gives the bound on a Zariski-open set of the `(E₄,E₆)`-plane
  containing the cusp value; the analytic input then shrinks to the single statement
  `(E₄(z), E₆(z)) → (E₄(∞), E₆(∞))` as `Im z → ∞`, which forces some `z₀ ∈ ℍ` into that open set;
  or
* run Zhu's own route: `T` acts on the finite-dimensional block space, so blocks have
  `q`-expansions with a leading Fourier coefficient, and that coefficient is a symmetric
  functional on `A(𝒱)` (`Modularity.BlockZeroMode`) — this needs Laurent expansion on a punctured
  disc, which Mathlib does not have.

Either way the residual is **analytic**, and it is one statement, not a theory.

## Status
Proved, axiom-clean, `pbw`-free, no `sorry`.
-/

namespace VOA

open PowerSeries

/-- ⚠⚠ **There is no `ℂ`-algebra homomorphism `ℂ⟦q⟧ → ℂ` sending `q` to a nonzero value.**

Hence a `ℂ⟦q⟧`-module has no "fibre at `q₀ ≠ 0`", and no amount of Nakayama over `ℂ⟦q⟧` can
produce a statement about a point of the upper half-plane. -/
theorem no_algHom_powerSeries_X_ne_zero (φ : PowerSeries ℂ →ₐ[ℂ] ℂ) {q₀ : ℂ} (hq : q₀ ≠ 0) :
    φ PowerSeries.X ≠ q₀ := by
  intro hφ
  set u : PowerSeries ℂ :=
    1 - algebraMap ℂ (PowerSeries ℂ) q₀⁻¹ * (X : PowerSeries ℂ) with hu
  have hcc : PowerSeries.constantCoeff u = 1 := by
    rw [hu, map_sub, map_one, map_mul, PowerSeries.constantCoeff_X, mul_zero, sub_zero]
  have hunit : IsUnit u := PowerSeries.isUnit_iff_constantCoeff.mpr (by rw [hcc]; exact isUnit_one)
  have hzero : φ u = 0 := by
    rw [hu, map_sub, map_one, map_mul, AlgHom.commutes, hφ]
    rw [Algebra.algebraMap_self, RingHom.id_apply, inv_mul_cancel₀ hq, sub_self]
  have : IsUnit (0 : ℂ) := by
    rw [← hzero]
    exact hunit.map φ
  exact (not_isUnit_zero) this

/-- The only `ℂ`-algebra hom `ℂ⟦q⟧ → ℂ` sends `q` to `0`. -/
theorem algHom_powerSeries_X_eq_zero (φ : PowerSeries ℂ →ₐ[ℂ] ℂ) : φ PowerSeries.X = 0 := by
  by_contra h
  exact no_algHom_powerSeries_X_ne_zero φ h rfl

end VOA
