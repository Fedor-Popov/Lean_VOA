import VOA.Modularity.OrderedMonomialBridge

/-!
# `OrderedSpanningData` from the straightening theorem

Assembles `Modularity.BuhlSpanningProof.ordSpanAll_eq_top` and the normal-form bridge
`Modularity.OrderedMonomialBridge` into the datum consumed by `Modularity.GrowthBound`.

## Contents

* **`orderedSpanningDataOf`** — the constructor: a finite homogeneous generating family
  `gen` of `𝒱` modulo `ℂ𝟙 + C₂(𝒱)`, plus a finite homogeneous bottom family `bot` that
  lowest-weight generates `M`, produce `OrderedSpanningData N h`, hence (`GrowthBound`)
  subexponential graded dimensions and character convergence.
* **`lwGenerated_adjoint`** — for the **adjoint module** `𝒱` with bottom `{𝟙}` the
  lowest-weight generation hypothesis is *free*: the creation axiom `u₍₋₁₎𝟙 = u` exhibits every
  homogeneous `u` as a one-letter word.
* **`orderedSpanningDataAdjoint`** — hence, **unconditionally in the module hypotheses**,
  ordered spanning data for `𝒱` itself: Gaberdiel–Neitzke's spanning-set theorem.

## The remaining module-level hypothesis

`LWGenerated A B` says `M` is spanned by words in **strictly negative** modes of `𝒱` applied to
`B`.  It is *not* automatic for a general lowest-weight module even when `B = M_h`: for the
Ising model `L(1/2,0)` one has `𝒱₁ = 0`, so no strictly-negative-mode word raises the weight by
exactly `1`, while `L(1/2,1/16)` has a nonzero level-`1` space (spanned by `L₋₁v = ω₍₀₎v`, a
*non-negative* mode).  This is exactly why Buhl's theorem allows modes `> −L`: the bounded-mode,
bounded-length part `x^{j₁}₍m₁₎⋯x^{jₛ}₍mₛ₎ w` (`0 ≤ mᵢ < L`) has to be absorbed into the bottom
family `B`.  That absorption — the finite-dimensionality of that span, via Buhl's constants
`B = max wt X`, `N` with `⊕_{i≥N}𝒱ᵢ ⊆ C₂(𝒱)` and `Q = max{N, 2B−1}+1` — is the one input carried
here as `LWGenerated`, and is the precise remaining gap for the module case.

## Status
Proved, axiom-clean, `pbw`-free, no `sorry`.
-/

namespace VOA

open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## The constructor -/

section Construct

variable {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]

/-- **Ordered spanning data from a finite homogeneous generating family.** -/
noncomputable def orderedSpanningDataOf (N : OrdVModule W M) (h : ℂ) (hcw : HasConformalWeight N h)
    {b : ℕ} (bot : Fin b → M) (botWt : Fin b → ℕ)
    (hbot : ∀ j, bot j ∈ N.weight (h + botWt j))
    (hLW : LWGenerated N.toWeakModule (Set.range bot))
    {g : ℕ} (gen : Fin g → 𝒱) (wt : Fin g → ℕ) (hwt : ∀ i, 1 ≤ wt i)
    (hgen : ∀ i, gen i ∈ W.grading (wt i : ℤ))
    (hdec : (⊤ : Submodule ℂ 𝒱) = Submodule.span ℂ (Set.range gen ∪ {W.vacuum}) ⊔ O₂ W) :
    OrderedSpanningData N h where
  g := g
  gen := gen
  wt := wt
  wt_pos := hwt
  gen_mem := hgen
  b := b
  bot := bot
  botWt := botWt
  bot_mem := hbot
  spans := by
    have hB : ∀ w ∈ Set.range bot, ∃ d₀ : ℕ, w ∈ N.weight (h + d₀) := by
      rintro _ ⟨j, rfl⟩; exact ⟨botWt j, hbot j⟩
    have htop := ordSpanAll_eq_top N (Set.range bot) h hcw hB hLW hgen hdec
    refine le_antisymm ?_ le_top
    rw [← htop, ordSpanAll, Submodule.span_le]
    rintro x ⟨l, w, hl, _, ⟨j, rfl⟩, rfl⟩
    rw [wordAct_genWord_eq_orderedMonomial N gen wt (bot j) l hl]
    exact Submodule.subset_span ⟨countFinsupp l, j, rfl⟩

end Construct

/-! ## The adjoint module: lowest-weight generation is free -/

section Adjoint

variable (W : VertexOperatorAlgebra 𝒱)

/-- **Creation makes the adjoint module lowest-weight generated by `{𝟙}`.**  Every
homogeneous `u ∈ 𝒱_β` is the one-letter word `u₍₋₁₎𝟙`. -/
theorem lwGenerated_adjoint :
    LWGenerated (adjointWeakModule W) ({W.vacuum} : Set 𝒱) := by
  refine top_le_iff.mp ?_
  rw [← span_homog_eq_top W, Submodule.span_le]
  rintro x ⟨n, hx⟩
  rcases lt_or_ge n 0 with hn | hn
  · have hz : x = 0 := by rw [W.positivity n hn, Submodule.mem_bot] at hx; exact hx
    rw [hz]; exact Submodule.zero_mem _
  · obtain ⟨β, rfl⟩ : ∃ β : ℕ, n = (β : ℤ) := ⟨n.toNat, by omega⟩
    have hidx : -(((0 : ℕ) : ℤ)) - 1 = (-1 : ℤ) := by norm_num
    have hword : wordAct (adjointWeakModule W) [((x, β, 0) : Letter 𝒱)] W.vacuum = x := by
      simp only [wordAct_cons, wordAct_nil]
      rw [hidx]
      exact (W.creation x).1
    rw [← hword]
    refine wordAct_mem_Gfil (adjointWeakModule W) ({W.vacuum} : Set 𝒱)
      (WordOK_cons (p := ((x, β, 0) : Letter 𝒱)) hx (WordOK_nil W)) (Set.mem_singleton _) ?_
    exact Int.natCast_nonneg _

/-- The adjoint module has conformal weight `0` (given a nonzero vacuum). -/
theorem hasConformalWeight_adjoint (hne : W.vacuum ≠ 0) :
    HasConformalWeight (adjointModule W) 0 := by
  constructor
  · intro hbot
    have hmem : W.vacuum ∈ (adjointModule W).weight 0 := by
      show W.vacuum ∈ adjWeight W 0
      have h0 : ((0 : ℤ) : ℂ) = (0 : ℂ) := by norm_num
      rw [← h0, adjWeight_cast W 0]
      exact W.vacuum_mem_grading_zero
    rw [hbot, Submodule.mem_bot] at hmem
    exact hne hmem
  · intro α hα
    by_cases hex : ∃ m : ℤ, (m : ℂ) = α
    · obtain ⟨m, rfl⟩ := hex
      have hg : W.grading m ≠ ⊥ := by
        intro hc
        exact hα (by show adjWeight W (m : ℂ) = ⊥; rw [adjWeight_cast W m]; exact hc)
      have hm : 0 ≤ m := by
        by_contra hcon
        exact hg (W.positivity m (not_le.mp hcon))
      refine ⟨m.toNat, ?_⟩
      rw [zero_add]
      exact_mod_cast (Int.toNat_of_nonneg hm).symm
    · exact absurd (adjWeight_eq_bot W (not_exists.mp hex)) hα

/-- **Gaberdiel–Neitzke: ordered spanning data for `𝒱` itself.**  Given a finite family of
homogeneous generators of positive weight spanning `𝒱` modulo `ℂ𝟙 + C₂(𝒱)`, the adjoint module
`𝒱` is spanned by the lexicographically ordered monomials

  `(gen i₁)₍₋m₁₋₁₎^{μ(i₁,m₁)} ⋯ (gen i_r)₍₋m_r₋₁₎^{μ(i_r,m_r)} 𝟙`.

No hypothesis on the module side is carried: `LWGenerated` is discharged by creation. -/
noncomputable def orderedSpanningDataAdjoint (hne : W.vacuum ≠ 0)
    {g : ℕ} (gen : Fin g → 𝒱) (wt : Fin g → ℕ) (hwt : ∀ i, 1 ≤ wt i)
    (hgen : ∀ i, gen i ∈ W.grading (wt i : ℤ))
    (hdec : (⊤ : Submodule ℂ 𝒱) = Submodule.span ℂ (Set.range gen ∪ {W.vacuum}) ⊔ O₂ W) :
    OrderedSpanningData (adjointModule W) 0 := by
  refine orderedSpanningDataOf (adjointModule W) 0 (hasConformalWeight_adjoint W hne)
    (b := 1) (fun _ => W.vacuum) (fun _ => 0) ?_ ?_ gen wt hwt hgen hdec
  · intro _
    change W.vacuum ∈ adjWeight W (0 + ((0 : ℕ) : ℂ))
    have h0 : (0 : ℂ) + ((0 : ℕ) : ℂ) = ((0 : ℤ) : ℂ) := by norm_num
    rw [h0, adjWeight_cast W 0]
    exact W.vacuum_mem_grading_zero
  · have hrange : Set.range (fun _ : Fin 1 => W.vacuum) = ({W.vacuum} : Set 𝒱) := by
      ext y; simp
    rw [hrange]
    exact lwGenerated_adjoint W

end Adjoint

end VOA
