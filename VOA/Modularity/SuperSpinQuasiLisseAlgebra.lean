import VOA.Modularity.AKUniformODE
import VOA.Modularity.SuperPoissonTrace
import VOA.Modularity.SuperSpinDescentSqFinite

/-!
# Bounded coefficient algebra and formal recurrences for square-spin blocks

This file records the algebraic part of the half-integral quasi-lisse route that is justified by
the present API.  The exponent variable is `t = q^(1/2)`: `spinQPowerSeries p k` packages the
normalized doubled-lattice coefficients of the characteristic `(p.mu,p.lambda)` as an ordinary
power series in `t`.

For a finite set `J` of characteristic/weight pairs, their coefficient algebra is an explicitly
finitely generated, hence Noetherian, `Complex`-algebra.  The canonical bounded family contains
all four `SpinPair` labels and weights below a chosen cutoff.  This does not identify the spatial
and temporal labels, does not identify either label with parity, and uses no spin--statistics
premise.

The finite square-spin cusp quotient for one fixed `BoundaryPair` gives a monic relation for every
state-space tower.  This is the `pp` cusp quotient: its defining kill family contains the three
non-`pp` inner eigenspaces.  It therefore does not realize or prove an ODE for the other three
characteristics.  Applied to the square `L[-2]` tower it gives the uniform `pp` algebraic
recurrence that is currently available.  A formal Euler equation follows only from an explicit
bridge saying that a coefficient-valued functional kills the cusp relation submodule and
intertwines this tower with the Euler operator.  These two facts are not fields of
`IsSuperSpinSqFormalBlock`, so they are bundled below rather than inferred.

Likewise, the repository currently has no relative theorem transporting `SuperEtingofFinite` to
the fixed-boundary square-spin cusp quotient.  `SuperSpinRelativeEtingofData` isolates exactly the
missing finite-spanning statement; all downstream recurrence and formal Euler consequences are
proved from it.

Nothing here constructs sectors, realizes the `pm`, `mp`, or `mm` formal blocks, proves
convergence or spanning of trace functions, or proves a `GammaTheta` transformation law.  The
finite coefficient algebra and the `pp` cusp recurrence are separate proved layers: no closure
theorem currently turns the former into coefficients of the latter.  The final relation is a
formal constant-coefficient Euler equation, not an analytic MLDE.
-/

namespace VOA

open scoped BigOperators
open GammaThetaStmt SuperNearVOA

set_option autoImplicit false

/-! ## A finite coefficient algebra on the doubled exponent lattice -/

/-- The normalized spin coefficient series in the honest variable `t = q^(1/2)`.

The coefficient at `t^N` is exactly `spinQ p k (N/2)`.  In particular, multiplication in
`PowerSeries Complex` is the Cauchy product appropriate to doubled exponents. -/
noncomputable def spinQPowerSeries (p : SpinPair) (k : Nat) : PowerSeries Complex :=
  PowerSeries.mk (spinQNatCoeff p k)

@[simp] theorem spinQPowerSeries_coeff (p : SpinPair) (k N : Nat) :
    PowerSeries.coeff N (spinQPowerSeries p k) = spinQNatCoeff p k N := by
  simp [spinQPowerSeries]

/-- The finite set of doubled-lattice spin coefficient series selected by `J`.

The pair order is `(SpinPair, weight index)`.  `SpinPair.mu` remains the spatial label and
`SpinPair.lambda` the temporal label. -/
noncomputable def spinCharacteristicGeneratorSet
    (J : Finset (SpinPair × Nat)) : Set (PowerSeries Complex) :=
  (fun i : SpinPair × Nat => spinQPowerSeries i.1 i.2) '' (J : Set (SpinPair × Nat))

/-- The bounded spin-characteristic coefficient algebra generated by `J`. -/
noncomputable def SpinCharacteristicAlgebra
    (J : Finset (SpinPair × Nat)) : Subalgebra Complex (PowerSeries Complex) :=
  Algebra.adjoin Complex (spinCharacteristicGeneratorSet J)

theorem spinCharacteristicGeneratorSet_finite (J : Finset (SpinPair × Nat)) :
    (spinCharacteristicGeneratorSet J).Finite := by
  exact J.finite_toSet.image _

/-- Every selected characteristic coefficient belongs to its bounded algebra. -/
theorem spinQPowerSeries_mem_SpinCharacteristicAlgebra
    {J : Finset (SpinPair × Nat)} {p : SpinPair} {k : Nat} (hpk : (p, k) ∈ J) :
    spinQPowerSeries p k ∈ SpinCharacteristicAlgebra J := by
  apply Algebra.subset_adjoin
  exact ⟨(p, k), Finset.mem_coe.mpr hpk, rfl⟩

/-- The bounded spin-characteristic coefficient algebra is of finite type over `Complex`. -/
theorem finiteType_SpinCharacteristicAlgebra (J : Finset (SpinPair × Nat)) :
    Algebra.FiniteType Complex (SpinCharacteristicAlgebra J) := by
  rw [SpinCharacteristicAlgebra]
  exact Algebra.FiniteType.adjoin_of_finite (spinCharacteristicGeneratorSet_finite J)

/-- The bounded spin-characteristic coefficient algebra is Noetherian. -/
theorem isNoetherianRing_SpinCharacteristicAlgebra (J : Finset (SpinPair × Nat)) :
    IsNoetherianRing (SpinCharacteristicAlgebra J) :=
  haveI := finiteType_SpinCharacteristicAlgebra J
  Algebra.FiniteType.isNoetherianRing Complex (SpinCharacteristicAlgebra J)

/-- All four characteristics, with weights strictly below `K`. -/
def boundedSpinCharacteristicIndices (K : Nat) : Finset (SpinPair × Nat) :=
  Finset.univ.product (Finset.range K)

theorem mem_boundedSpinCharacteristicIndices_iff {K k : Nat} {p : SpinPair} :
    (p, k) ∈ boundedSpinCharacteristicIndices K ↔ k < K := by
  simp [boundedSpinCharacteristicIndices]

/-- The canonical four-characteristic coefficient algebra below weight cutoff `K`. -/
noncomputable abbrev GammaThetaSpinCoefficientAlgebra (K : Nat) :=
  SpinCharacteristicAlgebra (boundedSpinCharacteristicIndices K)

/-- Every one of the four labels occurs in the bounded family at every selected weight. -/
theorem spinQPowerSeries_mem_GammaThetaSpinCoefficientAlgebra
    {K k : Nat} (p : SpinPair) (hk : k < K) :
    spinQPowerSeries p k ∈ GammaThetaSpinCoefficientAlgebra K := by
  apply spinQPowerSeries_mem_SpinCharacteristicAlgebra
  exact mem_boundedSpinCharacteristicIndices_iff.mpr hk

/-- The all-sector bounded index family is stable under the finite characteristic action of
`GammaTheta`.  This only records label stability; it is not a modular transformation theorem. -/
theorem boundedSpinCharacteristicIndices_act_gammaTheta
    (K : Nat) (A : ThetaGroup.GammaTheta) {p : SpinPair} {k : Nat}
    (hpk : (p, k) ∈ boundedSpinCharacteristicIndices K) :
    (SpinPair.act A p, k) ∈ boundedSpinCharacteristicIndices K := by
  rw [mem_boundedSpinCharacteristicIndices_iff] at hpk ⊢
  exact hpk

/-! ## Fixed-boundary square-spin cusp recurrences -/

universe u

variable {VType : Type u} [AddCommGroup VType] [Module Complex VType]
variable {W : SuperVertexOperatorAlgebra VType}

namespace SuperNearVOA

/-- A monic recurrence modulo the square-spin cusp relations, from a finite spanning family.

This is pure Noetherian module theory over `Complex`.  It is stated for an arbitrary tower so the
state-space content is visibly independent of any trace or analytic realization. -/
theorem BoundaryPair.exists_monic_tower_relation_mem_superSpinSqCusp_of_finset
    (b : BoundaryPair W) (hhalf : IsHalfIntegerGraded W)
    (T : Finset VType)
    (htop : (⊤ : Submodule Complex VType) = Submodule.span Complex (T : Set VType) ⊔
      superSpinSqCuspRelSpan W hhalf b.spinEigenspace)
    (x : Nat -> VType) :
    exists (s : Nat) (c : Nat -> Complex), 1 <= s /\
      (x s - ∑ i ∈ Finset.range s, c i • x i) ∈
        superSpinSqCuspRelSpan W hhalf b.spinEigenspace := by
  exact exists_monic_relation_mem_of_fin_gen
    (superSpinSqCuspRelSpan W hhalf b.spinEigenspace) (T : Set VType)
      T.finite_toSet htop x

/-- Finite-dimensionality of the fixed-boundary cusp quotient gives a monic recurrence for every
state-space tower. -/
theorem BoundaryPair.exists_monic_tower_relation_mem_superSpinSqCusp_of_finite
    (b : BoundaryPair W) (hhalf : IsHalfIntegerGraded W)
    (hfin : FiniteDimensional Complex
      (VType ⧸ superSpinSqCuspRelSpan W hhalf b.spinEigenspace))
    (x : Nat -> VType) :
    exists (s : Nat) (c : Nat -> Complex), 1 <= s /\
      (x s - ∑ i ∈ Finset.range s, c i • x i) ∈
        superSpinSqCuspRelSpan W hhalf b.spinEigenspace := by
  obtain ⟨T, hT⟩ := exists_finset_span_sup_of_quot_finite_superSq
    (superSpinSqCuspRelSpan W hhalf b.spinEigenspace) hfin
  exact BoundaryPair.exists_monic_tower_relation_mem_superSpinSqCusp_of_finset
    b hhalf T hT x

/-- The square `L[-2]` tower satisfies a monic state-space relation whenever the fixed-boundary
square-spin cusp quotient is finite-dimensional. -/
theorem BoundaryPair.exists_monic_superLsq_relation_mem_superSpinSqCusp_of_finite
    (b : BoundaryPair W) (hhalf : IsHalfIntegerGraded W)
    (hfin : FiniteDimensional Complex
      (VType ⧸ superSpinSqCuspRelSpan W hhalf b.spinEigenspace))
    (a : VType) :
    exists (s : Nat) (c : Nat -> Complex), 1 <= s /\
      (((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[s] a -
        ∑ i ∈ Finset.range s, c i •
          ((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[i] a) ∈
        superSpinSqCuspRelSpan W hhalf b.spinEigenspace := by
  exact BoundaryPair.exists_monic_tower_relation_mem_superSpinSqCusp_of_finite b hhalf hfin
    (fun n => ((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[n] a)

/-- The exact relative finiteness input missing from the current half-integral Etingof route.

It says that `SuperEtingofFinite` supplies a finite family spanning the state space modulo the
square-spin cusp relations for this fixed outer `BoundaryPair`.  No such transport theorem is
presently derived from the Poisson quotient API. -/
structure SuperSpinRelativeEtingofData
    (W : SuperVertexOperatorAlgebra VType) (hhalf : IsHalfIntegerGraded W)
    (b : BoundaryPair W) : Prop where
  finiteSpan : SuperEtingofFinite W ->
    exists T : Finset VType,
      (⊤ : Submodule Complex VType) = Submodule.span Complex (T : Set VType) ⊔
        superSpinSqCuspRelSpan W hhalf b.spinEigenspace

/-- Conditional fixed-boundary square-spin recurrence from `SuperEtingofFinite`, with precisely
the absent relative quotient comparison supplied as data. -/
theorem BoundaryPair.exists_monic_superLsq_relation_mem_superSpinSqCusp_of_etingofFinite
    (b : BoundaryPair W) (hhalf : IsHalfIntegerGraded W)
    (hbridge : SuperSpinRelativeEtingofData W hhalf b)
    (hE : SuperEtingofFinite W) (a : VType) :
    exists (s : Nat) (c : Nat -> Complex), 1 <= s /\
      (((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[s] a -
        ∑ i ∈ Finset.range s, c i •
          ((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[i] a) ∈
        superSpinSqCuspRelSpan W hhalf b.spinEigenspace := by
  obtain ⟨T, hT⟩ := hbridge.finiteSpan hE
  exact BoundaryPair.exists_monic_tower_relation_mem_superSpinSqCusp_of_finset b hhalf T hT
    (fun n => ((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[n] a)

/-! ## The exact bridge to a formal Euler equation -/

/-- The two extra identities needed to turn the state-space cusp recurrence into a formal Euler
equation for a coefficient-valued functional.

Neither field follows from `IsSuperSpinSqFormalBlock`: its four residue fields do not state that
the literal cusp submodule is killed, and it has no square-omega/Euler recursion field. -/
structure SuperSpinCuspEulerData
    (W : SuperVertexOperatorAlgebra VType) (hhalf : IsHalfIntegerGraded W)
    (b : BoundaryPair W) (S : VType →ₗ[Complex] FormalQSeries) (a : VType) : Prop where
  cusp_le_ker : superSpinSqCuspRelSpan W hhalf b.spinEigenspace <= LinearMap.ker S
  tower : forall n : Nat,
    S (((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[n] a) =
      (qDeriv^[n]) (S a)

/-- Push a monic square-`L[-2]` cusp relation through an exact Euler bridge.

The coefficients are constants in `Complex`; this is a formal Euler equation on coefficient
functions.  No convergence or analytic modularity is asserted. -/
theorem SuperSpinCuspEulerData.euler_relation_of_monic
    {b : BoundaryPair W} {hhalf : IsHalfIntegerGraded W}
    {S : VType →ₗ[Complex] FormalQSeries} {a : VType}
    (hdata : SuperSpinCuspEulerData W hhalf b S a)
    {s : Nat} {c : Nat -> Complex}
    (hrel : (((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[s] a -
      ∑ i ∈ Finset.range s, c i •
        ((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[i] a) ∈
      superSpinSqCuspRelSpan W hhalf b.spinEigenspace) :
    (qDeriv^[s]) (S a) = ∑ i ∈ Finset.range s, c i • (qDeriv^[i]) (S a) := by
  have hzero := hdata.cusp_le_ker hrel
  rw [LinearMap.mem_ker, map_sub, map_sum] at hzero
  simp only [map_smul] at hzero
  rw [hdata.tower] at hzero
  have htower : ∀ i ∈ Finset.range s,
      S (((W.toSuperNearVOA.superLsq (-2) : VType -> VType))^[i] a) =
        (qDeriv^[i]) (S a) := by
    intro i hi
    exact hdata.tower i
  rw [Finset.sum_congr rfl (fun i hi => by rw [htower i hi])] at hzero
  exact sub_eq_zero.mp hzero

/-- A formal constant-coefficient Euler equation from finite-dimensionality of the fixed-boundary
square-spin cusp quotient and the explicit Euler bridge. -/
theorem BoundaryPair.exists_formalEuler_relation_of_superSpinSqCusp_finite
    (b : BoundaryPair W) (hhalf : IsHalfIntegerGraded W)
    (hfin : FiniteDimensional Complex
      (VType ⧸ superSpinSqCuspRelSpan W hhalf b.spinEigenspace))
    (S : VType →ₗ[Complex] FormalQSeries) (a : VType)
    (hdata : SuperSpinCuspEulerData W hhalf b S a) :
    exists (s : Nat) (c : Nat -> Complex), 1 <= s /\
      (qDeriv^[s]) (S a) = ∑ i ∈ Finset.range s, c i • (qDeriv^[i]) (S a) := by
  obtain ⟨s, c, hs, hrel⟩ :=
    BoundaryPair.exists_monic_superLsq_relation_mem_superSpinSqCusp_of_finite
      b hhalf hfin a
  exact ⟨s, c, hs, hdata.euler_relation_of_monic hrel⟩

/-- Conditional formal constant-coefficient Euler equation from `SuperEtingofFinite`, after
supplying both exact missing bridges: relative square-spin finite spanning and Euler recursion. -/
theorem BoundaryPair.exists_formalEuler_relation_of_superEtingofFinite
    (b : BoundaryPair W) (hhalf : IsHalfIntegerGraded W)
    (hbridge : SuperSpinRelativeEtingofData W hhalf b)
    (hE : SuperEtingofFinite W)
    (S : VType →ₗ[Complex] FormalQSeries) (a : VType)
    (hdata : SuperSpinCuspEulerData W hhalf b S a) :
    exists (s : Nat) (c : Nat -> Complex), 1 <= s /\
      (qDeriv^[s]) (S a) = ∑ i ∈ Finset.range s, c i • (qDeriv^[i]) (S a) := by
  obtain ⟨s, c, hs, hrel⟩ :=
    BoundaryPair.exists_monic_superLsq_relation_mem_superSpinSqCusp_of_etingofFinite
      b hhalf hbridge hE a
  exact ⟨s, c, hs, hdata.euler_relation_of_monic hrel⟩

end SuperNearVOA

end VOA
