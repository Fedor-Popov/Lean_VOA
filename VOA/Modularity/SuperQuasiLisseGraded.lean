import VOA.Modularity.SuperPoissonTrace
import VOA.Modularity.SuperZhuAlgebraFinite

/-!
# Graded super Poisson-trace relations

This file supplies the graded input to the integral-weight super Arakawa--Kawasetsu finite
generation argument.  Both relation families are refined simultaneously by conformal weight and
parity.  The two indices remain independent: no spin--statistics relation is assumed.
-/

namespace VOA

open GammaThetaStmt

set_option autoImplicit false

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## Bi-homogeneous generators -/

/-- A `C₂` generator with independent weight and parity witnesses for both inputs. -/
def superBiHomNegTwoGen (W : SuperVertexOperatorAlgebra 𝒱) : Set 𝒱 :=
  {x : 𝒱 | ∃ (K M : ℤ) (p q : ZMod 2) (a b : 𝒱),
    a ∈ W.toSuperNearVOA.gradingZ K ∧ a ∈ W.toSuperNearVOA.parity p ∧
    b ∈ W.toSuperNearVOA.gradingZ M ∧ b ∈ W.toSuperNearVOA.parity q ∧
    x = W.toSuperNearVOA.smul a (-2) b}

/-- The span of the bi-homogeneous `C₂` generators. -/
def superBiHomNegTwoSpan (W : SuperVertexOperatorAlgebra 𝒱) : Submodule ℂ 𝒱 :=
  Submodule.span ℂ (superBiHomNegTwoGen W)

theorem superBiHomNegTwo_mem_span (W : SuperVertexOperatorAlgebra 𝒱)
    {K M : ℤ} {p q : ZMod 2} {a b : 𝒱}
    (haK : a ∈ W.toSuperNearVOA.gradingZ K) (hap : a ∈ W.toSuperNearVOA.parity p)
    (hbM : b ∈ W.toSuperNearVOA.gradingZ M) (hbq : b ∈ W.toSuperNearVOA.parity q) :
    W.toSuperNearVOA.smul a (-2) b ∈ superBiHomNegTwoSpan W :=
  Submodule.subset_span ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl⟩

/-- Integral weights and the independent parity decomposition refine every `C₂` generator into
bi-homogeneous generators. -/
theorem superO₂_eq_span_bihomogeneous (W : SuperVertexOperatorAlgebra 𝒱)
    (hV : W.toSuperNearVOA.IntegralWeights) :
    superO₂ W = superBiHomNegTwoSpan W := by
  let V := W.toSuperNearVOA
  apply le_antisymm
  · rw [superO₂, Submodule.span_le]
    rintro _ ⟨a, b, rfl⟩
    refine V.reduce_bihomogeneous hV
      (P := fun a => V.smul a (-2) b ∈ superBiHomNegTwoSpan W) ?_ ?_ ?_ a
    · intro K p u hu
      refine V.reduce_bihomogeneous hV
        (P := fun b => V.smul u (-2) b ∈ superBiHomNegTwoSpan W) ?_ ?_ ?_ b
      · intro M q v hv
        exact superBiHomNegTwo_mem_span W hu.1 hu.2 hv.1 hv.2
      · simp
      · intro x y hx hy
        rw [SuperVertexAlgebra.smul_add_right]
        exact (superBiHomNegTwoSpan W).add_mem hx hy
    · simp
    · intro x y hx hy
      rw [SuperVertexAlgebra.smul_add_left]
      exact (superBiHomNegTwoSpan W).add_mem hx hy
  · rw [superBiHomNegTwoSpan, Submodule.span_le]
    rintro _ ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl⟩
    exact Submodule.subset_span ⟨a, b, rfl⟩

/-- The two bi-homogeneous relation families together. -/
def superPoissonBiHomGen (W : SuperVertexOperatorAlgebra 𝒱) : Set 𝒱 :=
  superBiHomNegTwoGen W ∪ superBiHomZeroModeGen W

/-- The full super Poisson-trace relation span is generated by the two bi-homogeneous families. -/
theorem superPoissonRelSpan_eq_span_bihomogeneous
    (W : SuperVertexOperatorAlgebra 𝒱) (hV : W.toSuperNearVOA.IntegralWeights) :
    superPoissonRelSpan W = Submodule.span ℂ (superPoissonBiHomGen W) := by
  rw [superPoissonRelSpan, superO₂_eq_span_bihomogeneous W hV,
    superZeroModeSpan_eq_bihomogeneous W hV, superBiHomNegTwoSpan,
    superBiHomZeroModeSpan, superPoissonBiHomGen, Submodule.span_union]

/-- A bi-homogeneous `C₂` generator has weight `K+M+1` and parity `p+q`. -/
theorem superBiHomNegTwo_bidegree (W : SuperVertexOperatorAlgebra 𝒱)
    {K M : ℤ} {p q : ZMod 2} {a b : 𝒱}
    (haK : a ∈ W.toSuperNearVOA.gradingZ K) (hap : a ∈ W.toSuperNearVOA.parity p)
    (hbM : b ∈ W.toSuperNearVOA.gradingZ M) (hbq : b ∈ W.toSuperNearVOA.parity q) :
    W.toSuperNearVOA.smul a (-2) b ∈ W.toSuperNearVOA.gradingZ (K + M + 1) ⊓
      W.toSuperNearVOA.parity (p + q) := by
  constructor
  · have h := W.toSuperNearVOA.smul_mem_gradingZ haK hbM (-2)
    rwa [show K + M - (-2) - 1 = K + M + 1 from by ring] at h
  · exact W.toSuperNearVOA.smul_mem_parity hap hbq (-2)

/-- A bi-homogeneous zero-mode generator has weight `K+M-1` and parity `p+q`.
There is no Koszul scalar here: the operation is `a₍₀₎b` itself, with no exchange of inputs. -/
theorem superBiHomZeroMode_bidegree (W : SuperVertexOperatorAlgebra 𝒱)
    {K M : ℤ} {p q : ZMod 2} {a b : 𝒱}
    (haK : a ∈ W.toSuperNearVOA.gradingZ K) (hap : a ∈ W.toSuperNearVOA.parity p)
    (hbM : b ∈ W.toSuperNearVOA.gradingZ M) (hbq : b ∈ W.toSuperNearVOA.parity q) :
    W.toSuperNearVOA.smul a 0 b ∈ W.toSuperNearVOA.gradingZ (K + M - 1) ⊓
      W.toSuperNearVOA.parity (p + q) := by
  constructor
  · have h := W.toSuperNearVOA.smul_mem_gradingZ haK hbM 0
    rwa [show K + M - 0 - 1 = K + M - 1 from by ring] at h
  · exact W.toSuperNearVOA.smul_mem_parity hap hbq 0

/-- Every combined generator is genuinely bi-homogeneous, but its weight and parity need not be
related. -/
theorem superPoissonBiHomGen_is_bihomogeneous (W : SuperVertexOperatorAlgebra 𝒱)
    {g : 𝒱} (hg : g ∈ superPoissonBiHomGen W) :
    ∃ (n : ℤ) (r : ZMod 2),
      g ∈ W.toSuperNearVOA.gradingZ n ⊓ W.toSuperNearVOA.parity r := by
  rcases hg with hg | hg
  · obtain ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl⟩ := hg
    exact ⟨K + M + 1, p + q, superBiHomNegTwo_bidegree W haK hap hbM hbq⟩
  · obtain ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl⟩ := hg
    exact ⟨K + M - 1, p + q, superBiHomZeroMode_bidegree W haK hap hbM hbq⟩

/-! ## Exact-degree generators and descent -/

def superBiHomNegTwoGenDeg (W : SuperVertexOperatorAlgebra 𝒱) (n : ℤ) : Set 𝒱 :=
  {x : 𝒱 | ∃ (K M : ℤ) (p q : ZMod 2) (a b : 𝒱),
    a ∈ W.toSuperNearVOA.gradingZ K ∧ a ∈ W.toSuperNearVOA.parity p ∧
    b ∈ W.toSuperNearVOA.gradingZ M ∧ b ∈ W.toSuperNearVOA.parity q ∧
    K + M + 1 = n ∧ x = W.toSuperNearVOA.smul a (-2) b}

def superBiHomZeroModeGenDeg (W : SuperVertexOperatorAlgebra 𝒱) (n : ℤ) : Set 𝒱 :=
  {x : 𝒱 | ∃ (K M : ℤ) (p q : ZMod 2) (a b : 𝒱),
    a ∈ W.toSuperNearVOA.gradingZ K ∧ a ∈ W.toSuperNearVOA.parity p ∧
    b ∈ W.toSuperNearVOA.gradingZ M ∧ b ∈ W.toSuperNearVOA.parity q ∧
    K + M - 1 = n ∧ x = W.toSuperNearVOA.smul a 0 b}

def superPoissonBiHomGenDeg (W : SuperVertexOperatorAlgebra 𝒱) (n : ℤ) : Set 𝒱 :=
  superBiHomNegTwoGenDeg W n ∪ superBiHomZeroModeGenDeg W n

theorem superPiHom_biHomNegTwo_mem (W : SuperVertexOperatorAlgebra 𝒱)
    (hV : W.toSuperNearVOA.IntegralWeights) (n : ℤ) {g : 𝒱}
    (hg : g ∈ superBiHomNegTwoGen W) :
    W.toSuperNearVOA.superPiHom hV n g ∈
      Submodule.span ℂ (superBiHomNegTwoGenDeg W n) := by
  let V := W.toSuperNearVOA
  obtain ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl⟩ := hg
  by_cases hd : K + M + 1 = n
  · subst n
    rw [V.superPiHom_of_mem hV (superBiHomNegTwo_bidegree W haK hap hbM hbq).1]
    exact Submodule.subset_span ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl, rfl⟩
  · rw [V.superPiHom_of_mem_ne hV hd
      (superBiHomNegTwo_bidegree W haK hap hbM hbq).1]
    exact (Submodule.span ℂ (superBiHomNegTwoGenDeg W n)).zero_mem

theorem superPiHom_biHomZeroMode_mem (W : SuperVertexOperatorAlgebra 𝒱)
    (hV : W.toSuperNearVOA.IntegralWeights) (n : ℤ) {g : 𝒱}
    (hg : g ∈ superBiHomZeroModeGen W) :
    W.toSuperNearVOA.superPiHom hV n g ∈
      Submodule.span ℂ (superBiHomZeroModeGenDeg W n) := by
  let V := W.toSuperNearVOA
  obtain ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl⟩ := hg
  by_cases hd : K + M - 1 = n
  · subst n
    rw [V.superPiHom_of_mem hV (superBiHomZeroMode_bidegree W haK hap hbM hbq).1]
    exact Submodule.subset_span ⟨K, M, p, q, a, b, haK, hap, hbM, hbq, rfl, rfl⟩
  · rw [V.superPiHom_of_mem_ne hV hd
      (superBiHomZeroMode_bidegree W haK hap hbM hbq).1]
    exact (Submodule.span ℂ (superBiHomZeroModeGenDeg W n)).zero_mem

theorem superPiHom_poissonBiHomGen_mem (W : SuperVertexOperatorAlgebra 𝒱)
    (hV : W.toSuperNearVOA.IntegralWeights) (n : ℤ) {g : 𝒱}
    (hg : g ∈ superPoissonBiHomGen W) :
    W.toSuperNearVOA.superPiHom hV n g ∈
      Submodule.span ℂ (superPoissonBiHomGenDeg W n) := by
  rcases hg with hg | hg
  · exact Submodule.span_mono Set.subset_union_left
      (superPiHom_biHomNegTwo_mem W hV n hg)
  · exact Submodule.span_mono Set.subset_union_right
      (superPiHom_biHomZeroMode_mem W hV n hg)

theorem superPiHom_maps_superPoissonRelSpan (W : SuperVertexOperatorAlgebra 𝒱)
    (hV : W.toSuperNearVOA.IntegralWeights) (n : ℤ) {x : 𝒱}
    (hx : x ∈ superPoissonRelSpan W) :
    W.toSuperNearVOA.superPiHom hV n x ∈ superPoissonRelSpan W := by
  let V := W.toSuperNearVOA
  rw [superPoissonRelSpan_eq_span_bihomogeneous W hV] at hx ⊢
  refine V.superPiHom_maps_span_homog hV n (superPoissonBiHomGen W) ?_ hx
  intro g hg
  obtain ⟨k, p, hgp⟩ := superPoissonBiHomGen_is_bihomogeneous W hg
  exact ⟨k, hgp.1⟩

/-- The degree-`n` part of the augmented relation span is generated by the degree-`n`
bi-homogeneous `C₂` and zero-mode generators. -/
theorem superPoissonRelSpan_inf_gradingZ_le_span_deg
    (W : SuperVertexOperatorAlgebra 𝒱) (hV : W.toSuperNearVOA.IntegralWeights) (n : ℤ) :
    superPoissonRelSpan W ⊓ W.toSuperNearVOA.gradingZ n ≤
      Submodule.span ℂ (superPoissonBiHomGenDeg W n) := by
  let V := W.toSuperNearVOA
  intro x hx
  obtain ⟨hxP, hxg⟩ := hx
  rw [superPoissonRelSpan_eq_span_bihomogeneous W hV] at hxP
  rw [← V.superPiHom_of_mem hV hxg]
  refine Submodule.span_induction
    (p := fun y _ => V.superPiHom hV n y ∈
      Submodule.span ℂ (superPoissonBiHomGenDeg W n)) ?_ ?_ ?_ ?_ hxP
  · intro g hg
    exact superPiHom_poissonBiHomGen_mem W hV n hg
  · simp
  · intro y z _ _ hy hz
    rw [map_add]
    exact (Submodule.span ℂ (superPoissonBiHomGenDeg W n)).add_mem hy hz
  · intro c y _ hy
    rw [map_smul]
    exact (Submodule.span ℂ (superPoissonBiHomGenDeg W n)).smul_mem c hy

/-- Graded spanning modulo the augmented relation space. -/
theorem gradingZ_le_span_sup_superPoissonRelSpan_inf
    (W : SuperVertexOperatorAlgebra 𝒱) (hV : W.toSuperNearVOA.IntegralWeights)
    (S : Set 𝒱) (hShom : ∀ s ∈ S, W.toSuperNearVOA.IsHomogZ s)
    (htop : (⊤ : Submodule ℂ 𝒱) = Submodule.span ℂ S ⊔ superPoissonRelSpan W)
    (n : ℤ) :
    W.toSuperNearVOA.gradingZ n ≤
      Submodule.span ℂ S ⊔ (superPoissonRelSpan W ⊓ W.toSuperNearVOA.gradingZ n) := by
  let V := W.toSuperNearVOA
  intro x hx
  have hxtop : x ∈ Submodule.span ℂ S ⊔ superPoissonRelSpan W := htop ▸ Submodule.mem_top
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hxtop
  have hpix : V.superPiHom hV n (a + b) = a + b := V.superPiHom_of_mem hV hx
  rw [map_add] at hpix
  rw [← hpix]
  exact Submodule.add_mem_sup
    (V.superPiHom_maps_span_homog hV n S hShom ha)
    ⟨superPiHom_maps_superPoissonRelSpan W hV n hb, V.superPiHom_mem hV n b⟩

/-! ## Finite homogeneous spanning data -/

/-- A finite-codimension subspace admits a finite integral-weight homogeneous spanning family,
provided the integral grading spans the state space. -/
theorem exists_finset_homog_span_sup_of_quot_finite
    (W : SuperVertexOperatorAlgebra 𝒱) (hV : W.toSuperNearVOA.IntegralWeights)
    (P : Submodule ℂ 𝒱) (hfin : FiniteDimensional ℂ (𝒱 ⧸ P)) :
    ∃ T : Finset 𝒱, (∀ x ∈ (T : Set 𝒱), W.toSuperNearVOA.IsHomogZ x) ∧
      (⊤ : Submodule ℂ 𝒱) = Submodule.span ℂ (T : Set 𝒱) ⊔ P := by
  classical
  let V := W.toSuperNearVOA
  obtain ⟨T, hT⟩ := SuperNearVOA.exists_finset_span_sup_of_quot_finite P hfin
  have hall : ∀ y : 𝒱, ∃ F : Finset 𝒱,
      (↑F : Set 𝒱) ⊆ {x : 𝒱 | V.IsHomogZ x} ∧
      y ∈ Submodule.span ℂ (F : Set 𝒱) := by
    intro y
    have hy : y ∈ Submodule.span ℂ {x : 𝒱 | V.IsHomogZ x} := by
      rw [V.span_isHomogZ_eq_top hV]
      trivial
    exact Submodule.mem_span_finite_of_mem_span hy
  choose F hFsub hFmem using hall
  let U : Finset 𝒱 := T.biUnion F
  have hUhom : ∀ x ∈ U, V.IsHomogZ x := by
    intro x hx
    rw [show U = T.biUnion F from rfl, Finset.mem_biUnion] at hx
    obtain ⟨y, _, hxy⟩ := hx
    exact hFsub y (Finset.mem_coe.mpr hxy)
  have hTU : (T : Set 𝒱) ⊆ (Submodule.span ℂ (U : Set 𝒱) : Set 𝒱) := by
    intro y hy
    refine Submodule.span_mono ?_ (hFmem y)
    intro z hz
    exact Finset.mem_coe.mpr
      (Finset.mem_biUnion.mpr ⟨y, Finset.mem_coe.mp hy, Finset.mem_coe.mp hz⟩)
  refine ⟨U, hUhom, le_antisymm ?_ le_top⟩
  rw [hT]
  exact sup_le_sup_right (Submodule.span_le.mpr hTU) _

/-- Super Etingof finiteness produces a finite homogeneous family spanning modulo the augmented
`C₂` and zero-mode relation space. -/
theorem exists_finset_homog_span_sup_superPoissonRelSpan
    (W : SuperVertexOperatorAlgebra 𝒱) (hV : W.toSuperNearVOA.IntegralWeights)
    (hE : SuperEtingofFinite W) :
    ∃ T : Finset 𝒱, (∀ x ∈ (T : Set 𝒱), W.toSuperNearVOA.IsHomogZ x) ∧
      (⊤ : Submodule ℂ 𝒱) =
        Submodule.span ℂ (T : Set 𝒱) ⊔ superPoissonRelSpan W :=
  exists_finset_homog_span_sup_of_quot_finite W hV (superPoissonRelSpan W) hE

end VOA
