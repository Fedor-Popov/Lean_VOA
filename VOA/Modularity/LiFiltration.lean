import VOA.Modularity.GrowthBound
import VOA.Modularity.ZhuAssembly
import VOA.Modularity.ZhuRecursionProof
import VOA.Modules.FiniteGenerationProof

/-!
# Li's `C₂`-filtration on a module — the engine of Buhl's ordered spanning theorem

This is the technical core of the residual `C2Cofinite W → BuhlSpanning W`
(`Modularity.GrowthBound`).  Following Haisheng Li (*Abelianizing vertex algebras*) — the
filtration underlying Karel–Li's, Gaberdiel–Neitzke's and Buhl's spanning-set arguments — we
filter a weak module `M` by the **total mode depth** of the words in strictly negative modes
that produce it.

## The set-up

A **letter** is a triple `(c, β, n) : 𝒱 × ℕ × ℕ`, standing for the mode `c₍₋n₋₁₎` of a
homogeneous `c ∈ 𝒱_β` (`letterOK`).  A **word** is a list of letters, acting with the head
**outermost**:

  `wordAct A [(c₁,β₁,n₁), …, (c_r,β_r,n_r)] x = (c₁)₍₋n₁₋₁₎ ⋯ (c_r)₍₋n_r₋₁₎ x`.

Its **level** is `wordLevel l = Σ nᵢ` (Li's `Σ (mᵢ − 1)` for modes `−mᵢ`) and its **degree** —
the weight it adds — is `wordDeg l = Σ (βᵢ + nᵢ) ≥ wordLevel l`.  For a set `B ⊆ M` of "bottom"
vectors,

  `Gfil A B p := span ℂ {wordAct A l w : w ∈ B, l homogeneous, wordLevel l ≥ p}`

(`p : ℤ`, everything `≤ 0` collapsing to `p = 0`) is a decreasing filtration of `M`.

## What is proved here (all unconditional, axiom-clean)

* `Gfil_antitone`, `Gfil_prepend` — the elementary filtration API.
* **`act_mem_Gfil`** (KEY-1, *Li's mode estimate*): granted `LWGenerated A B`
  (`Gfil A B 0 = ⊤`, i.e. the negative-mode words on `B` already span `M`), **every** mode of a
  homogeneous `u` obeys `u₍ₖ₎ · Gfil p ⊆ Gfil (p − k − 1)`.  Induction on the word via the
  module commutator formula; the correction terms `(u₍ⱼ₎c)₍ₖ₋ₙ₋₁₋ⱼ₎` land one level *better*.
* **`smul_comm_mem_Gfil`** (KEY-3, *reordering is free*): for `x ∈ Gfil r`,
  `[a₍₋m₋₁₎, b₍₋n₋₁₎] x ∈ Gfil (r + m + n + 1)` — one level **above** the level `r + m + n` of
  the product itself.  This is the commutativity of `gr^F M` that makes an ordered spanning set
  possible at all.
* **`O₂_act_mem_Gfil`** (KEY-2, *`C₂` costs a level*): for `c ∈ O₂ W = C₂(𝒱)` and any mode,
  `c₍ₙ₎ · Gfil r ⊆ Gfil (r − n)` — again one level better than `act_mem_Gfil`.  This is where
  `C₂`-cofiniteness enters: modulo `Gfil (p+1)` only `𝒱/C₂(𝒱)` survives in each letter.
* **`Gfil_le_wtGe`** — `Gfil p` sits in weights `≥ h + p`, so on a module with a conformal
  weight the filtration is **exhaustive in each weight space**: `Gfil p ⊓ M_{h+d} = ⊥` for
  `p > d` (`Gfil_inf_weight_eq_bot`).  This is what makes the downward induction on `p`
  terminate in `Modularity.BuhlSpanningProof`.

Together, KEY-1/2/3 say exactly that `gr^F M` is a module over the *commutative* algebra
`gr^F 𝒱`, generated by the image of `𝒱/C₂(𝒱)`.

## References
* H. Li, *Abelianizing vertex algebras*, Comm. Math. Phys. 259 (2005).
* Karel–Li, *Certain generating subspaces for vertex operator algebras*, J. Algebra 217 (1999),
  Thm 3.10 (an **arbitrary** linear order on the modes may be imposed).
* Gaberdiel–Neitzke, CMP 238 (2003); G. Buhl, *A spanning set for VOA modules*,
  J. Algebra 254 (2002).

## Status
Proved, axiom-clean, `pbw`-free, no `sorry`.
-/

namespace VOA

open scoped BigOperators

universe u v

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## A generic `finsum`-membership helper -/

/-- A `finsum` all of whose terms lie in a submodule lies in that submodule. -/
theorem finsum_mem_submodule_lf {ι : Type*} {X : Type*} [AddCommGroup X] [Module ℂ X]
    (p : Submodule ℂ X) (F : ι → X) (hF : ∀ i, F i ∈ p) : (∑ᶠ i, F i) ∈ p := by
  classical
  by_cases hfin : (Function.support F).Finite
  · rw [finsum_eq_finsetSum_of_support_subset F (s := hfin.toFinset)
        (fun i hi => hfin.mem_toFinset.mpr hi)]
    exact Submodule.sum_mem _ (fun i _ => hF i)
  · rw [finsum_of_infinite_support (by rwa [Set.not_finite] at hfin)]
    exact p.zero_mem

section Filtration

variable {W : VertexOperatorAlgebra 𝒱} {M : Type v} [AddCommGroup M] [Module ℂ M]

/-! ## Homogeneous words in strictly negative modes -/

/-- A **letter** `(c, β, n)`: the mode `c₍₋n₋₁₎` of a homogeneous `c ∈ 𝒱_β`. -/
abbrev Letter (𝒱 : Type u) [AddCommGroup 𝒱] [Module ℂ 𝒱] := 𝒱 × ℕ × ℕ

/-- The letter is **admissible**: its vector really is homogeneous of the recorded weight. -/
def letterOK (W : VertexOperatorAlgebra 𝒱) (p : Letter 𝒱) : Prop :=
  p.1 ∈ W.grading (p.2.1 : ℤ)

/-- A **word** is admissible when all its letters are. -/
def WordOK (W : VertexOperatorAlgebra 𝒱) (l : List (Letter 𝒱)) : Prop := ∀ p ∈ l, letterOK W p

theorem WordOK_nil (W : VertexOperatorAlgebra 𝒱) : WordOK W ([] : List (Letter 𝒱)) :=
  fun _ h => absurd h (List.not_mem_nil)

theorem WordOK_cons {W : VertexOperatorAlgebra 𝒱} {p : Letter 𝒱} {t : List (Letter 𝒱)}
    (hp : letterOK W p) (ht : WordOK W t) : WordOK W (p :: t) := by
  intro q hq
  rcases List.mem_cons.mp hq with h | h
  · exact h ▸ hp
  · exact ht q h

theorem WordOK_of_cons {W : VertexOperatorAlgebra 𝒱} {p : Letter 𝒱} {t : List (Letter 𝒱)}
    (h : WordOK W (p :: t)) : letterOK W p ∧ WordOK W t :=
  ⟨h p (List.mem_cons_self ..), fun q hq => h q (List.mem_cons_of_mem _ hq)⟩

/-- `wordAct A l x` applies the negative modes listed in `l` to `x`, the **head outermost**. -/
def wordAct (A : WeakModule W M) : List (Letter 𝒱) → M → M
  | [], x => x
  | p :: t, x => mode (A.YM p.1) (-(p.2.2 : ℤ) - 1) (wordAct A t x)

@[simp] theorem wordAct_nil (A : WeakModule W M) (x : M) : wordAct A [] x = x := rfl

@[simp] theorem wordAct_cons (A : WeakModule W M) (p : Letter 𝒱) (t : List (Letter 𝒱)) (x : M) :
    wordAct A (p :: t) x = mode (A.YM p.1) (-(p.2.2 : ℤ) - 1) (wordAct A t x) := rfl

/-- The **level** `Σ nᵢ` of a word (Li's total mode depth `Σ (mᵢ − 1)` for modes `−mᵢ`). -/
def wordLevel (l : List (Letter 𝒱)) : ℕ := (l.map (fun p => p.2.2)).sum

/-- The **degree** `Σ (βᵢ + nᵢ)` of a word: the weight it raises by. -/
def wordDeg (l : List (Letter 𝒱)) : ℕ := (l.map (fun p => p.2.1 + p.2.2)).sum

@[simp] theorem wordLevel_nil : wordLevel ([] : List (Letter 𝒱)) = 0 := rfl

@[simp] theorem wordLevel_cons (p : Letter 𝒱) (t : List (Letter 𝒱)) :
    wordLevel (p :: t) = p.2.2 + wordLevel t := rfl

@[simp] theorem wordDeg_nil : wordDeg ([] : List (Letter 𝒱)) = 0 := rfl

@[simp] theorem wordDeg_cons (p : Letter 𝒱) (t : List (Letter 𝒱)) :
    wordDeg (p :: t) = (p.2.1 + p.2.2) + wordDeg t := rfl

/-- The level never exceeds the degree (weights are nonnegative). -/
theorem wordLevel_le_wordDeg (l : List (Letter 𝒱)) : wordLevel l ≤ wordDeg l := by
  induction l with
  | nil => simp
  | cons p t ih => simp only [wordLevel_cons, wordDeg_cons]; omega

/-! ## The filtration -/

/-- The generating set of the level-`p` piece: admissible words of level `≥ p` applied to `B`. -/
def Gset (A : WeakModule W M) (B : Set M) (p : ℕ) : Set M :=
  {x | ∃ (l : List (Letter 𝒱)) (w : M), WordOK W l ∧ w ∈ B ∧ p ≤ wordLevel l ∧
    x = wordAct A l w}

/-- **Li's `C₂`-filtration** of `M` relative to a bottom set `B`: the span of the admissible
words of level `≥ p` in strictly negative modes applied to `B`.  Indexed by `ℤ`, with everything
`≤ 0` collapsing to the level-`0` piece. -/
def Gfil (A : WeakModule W M) (B : Set M) (p : ℤ) : Submodule ℂ M :=
  Submodule.span ℂ (Gset A B p.toNat)

theorem Gset_antitone (A : WeakModule W M) (B : Set M) {p q : ℕ} (h : p ≤ q) :
    Gset A B q ⊆ Gset A B p := by
  rintro x ⟨l, w, hl, hw, hlev, rfl⟩
  exact ⟨l, w, hl, hw, le_trans h hlev, rfl⟩

/-- The filtration is decreasing. -/
theorem Gfil_antitone (A : WeakModule W M) (B : Set M) {p q : ℤ} (h : p ≤ q) :
    Gfil A B q ≤ Gfil A B p :=
  Submodule.span_mono (Gset_antitone A B (Int.toNat_le_toNat h))

/-- An admissible word of level `≥ p` on `B` lies in `Gfil p`. -/
theorem wordAct_mem_Gfil (A : WeakModule W M) (B : Set M) {l : List (Letter 𝒱)} {w : M}
    (hl : WordOK W l) (hw : w ∈ B) {p : ℤ} (hlev : p ≤ (wordLevel l : ℤ)) :
    wordAct A l w ∈ Gfil A B p :=
  Submodule.subset_span ⟨l, w, hl, hw, by omega, rfl⟩

/-- `B ⊆ Gfil p` for every `p ≤ 0`. -/
theorem mem_Gfil_of_mem_B (A : WeakModule W M) (B : Set M) {w : M} (hw : w ∈ B) {p : ℤ}
    (hp : p ≤ 0) : w ∈ Gfil A B p := by
  have := wordAct_mem_Gfil A B (l := ([] : List (Letter 𝒱))) (WordOK_nil W) hw (p := p)
    (by simpa using hp)
  simpa using this

/-- **Prepending a homogeneous negative mode raises the level by `n`.** -/
theorem Gfil_prepend (A : WeakModule W M) (B : Set M) {c : 𝒱} {b n : ℕ}
    (hc : c ∈ W.grading (b : ℤ)) {r : ℤ} {x : M} (hx : x ∈ Gfil A B r) :
    mode (A.YM c) (-(n : ℤ) - 1) x ∈ Gfil A B (r + n) := by
  refine Submodule.span_induction (p := fun x _ => mode (A.YM c) (-(n : ℤ) - 1) x
      ∈ Gfil A B (r + n)) ?_ ?_ ?_ ?_ hx
  · rintro y ⟨l, w, hl, hw, hlev, rfl⟩
    have hstep : mode (A.YM c) (-(n : ℤ) - 1) (wordAct A l w)
        = wordAct A (((c, b, n) : Letter 𝒱) :: l) w := rfl
    rw [hstep]
    refine wordAct_mem_Gfil A B (WordOK_cons (p := ((c, b, n) : Letter 𝒱)) hc hl) hw ?_
    have hlv : wordLevel (((c, b, n) : Letter 𝒱) :: l) = n + wordLevel l := rfl
    rw [hlv]
    have : r.toNat ≤ wordLevel l := hlev
    omega
  · simp only [map_zero]; exact (Gfil A B (r + n)).zero_mem
  · intro y z _ _ hy hz; rw [map_add]; exact (Gfil A B (r + n)).add_mem hy hz
  · intro a y _ hy; rw [map_smul]; exact (Gfil A B (r + n)).smul_mem a hy

/-! ## Lowest-weight generation -/

/-- `M` is **lowest-weight generated** by `B`: the admissible words in strictly negative modes
on `B` already span `M`, i.e. `Gfil A B 0 = ⊤`.  This is the standard hypothesis on a
lowest-weight module `M = U(𝒱̂)₋ · M(0)`. -/
def LWGenerated (A : WeakModule W M) (B : Set M) : Prop := Gfil A B 0 = ⊤

theorem Gfil_eq_top_of_nonpos {A : WeakModule W M} {B : Set M} (h : LWGenerated A B) {p : ℤ}
    (hp : p ≤ 0) : Gfil A B p = ⊤ := by
  have hp0 : p.toNat = (0 : ℤ).toNat := by omega
  have heq : Gfil A B p = Gfil A B 0 := by unfold Gfil; rw [hp0]
  rw [heq]; exact h

/-! ## KEY-1 — Li's mode estimate -/

/-- **KEY-1, on word generators.**  For an admissible word `l` on `B`, a homogeneous
`u ∈ 𝒱_bu` and any `k ∈ ℤ`, `u₍ₖ₎ (wordAct A l w) ∈ Gfil (wordLevel l − k − 1)`.

Induction on `l`.  The `nil` case is either a one-letter word (`k ≤ −1`) or free
(`k ≥ 0`, target level `< 0`).  The `cons` case is the module commutator formula: the swapped
term is handled by the inductive hypothesis plus `Gfil_prepend`, and each correction term
`(u₍ⱼ₎c)₍ₖ₋ₙ₋₁₋ⱼ₎` is a *lower*-mode action on the shorter word, landing at level
`wordLevel t − k + n + j ≥ wordLevel l − k − 1`. -/
theorem wordAct_act_mem_Gfil (A : WeakModule W M) (B : Set M) (hLW : LWGenerated A B)
    (l : List (Letter 𝒱)) {w : M} (hw : w ∈ B) :
    WordOK W l → ∀ (u : 𝒱) (bu : ℕ), u ∈ W.grading (bu : ℤ) → ∀ k : ℤ,
      mode (A.YM u) k (wordAct A l w) ∈ Gfil A B ((wordLevel l : ℤ) - k - 1) := by
  induction l with
  | nil =>
      intro _ u bu hu k
      simp only [wordAct_nil, wordLevel_nil, Nat.cast_zero]
      rcases le_or_gt 0 k with hk | hk
      · rw [Gfil_eq_top_of_nonpos hLW (by omega)]; exact Submodule.mem_top
      · -- `k ≤ −1`: this is the one-letter word `(u, bu, (−k−1).toNat)`
        have hidx : -(((-k - 1).toNat : ℕ) : ℤ) - 1 = k := by omega
        have hmode : wordAct A [((u, bu, (-k - 1).toNat) : Letter 𝒱)] w = mode (A.YM u) k w := by
          simp only [wordAct_cons, wordAct_nil, hidx]
        rw [← hmode]
        refine wordAct_mem_Gfil A B
          (WordOK_cons (p := ((u, bu, (-k - 1).toNat) : Letter 𝒱)) hu (WordOK_nil W)) hw ?_
        have hlv : wordLevel [((u, bu, (-k - 1).toNat) : Letter 𝒱)] = (-k - 1).toNat := rfl
        rw [hlv]
        omega
  | cons pc t ih =>
      intro hl u bu hu k
      obtain ⟨hpc, ht⟩ := WordOK_of_cons hl
      have hcomm := mode_commutator A u pc.1 (wordAct A t w) k (-(pc.2.2 : ℤ) - 1)
      have hsplit : mode (A.YM u) k (wordAct A (pc :: t) w)
          = mode (A.YM pc.1) (-(pc.2.2 : ℤ) - 1) (mode (A.YM u) k (wordAct A t w))
            + ∑ᶠ j : ℤ, cbz k j •
                mode (A.YM (W.smul u j pc.1)) (k + (-(pc.2.2 : ℤ) - 1) - j) (wordAct A t w) := by
        rw [wordAct_cons, ← hcomm]
        abel
      rw [hsplit]
      refine Submodule.add_mem _ ?_ ?_
      · have h2 := Gfil_prepend A B (b := pc.2.1) (n := pc.2.2) hpc (ih ht u bu hu k)
        refine (Gfil_antitone A B ?_) h2
        simp only [wordLevel_cons]
        push_cast
        omega
      · refine finsum_mem_submodule_lf _ _ (fun j => ?_)
        rcases lt_or_ge j 0 with hj | hj
        · rw [cbz_apply_neg _ hj, zero_smul]; exact Submodule.zero_mem _
        · refine Submodule.smul_mem _ _ ?_
          -- the new letter `u₍ⱼ₎c` is homogeneous of degree `bu + β − j − 1`
          have hgr : W.smul u j pc.1 ∈ W.grading ((bu : ℤ) + (pc.2.1 : ℤ) - j - 1) :=
            W.smul_mem_grading hu hpc j
          rcases lt_or_ge ((bu : ℤ) + (pc.2.1 : ℤ) - j - 1) 0 with hneg | hnn
          · -- negative degree ⟹ the element is `0`
            have hz : W.smul u j pc.1 = 0 := by
              rw [W.positivity _ hneg, Submodule.mem_bot] at hgr; exact hgr
            rw [hz]
            simp only [map_zero, mode_zero, LinearMap.zero_apply]
            exact Submodule.zero_mem _
          · obtain ⟨γ, hγ⟩ : ∃ γ : ℕ, ((bu : ℤ) + (pc.2.1 : ℤ) - j - 1) = (γ : ℤ) :=
              ⟨((bu : ℤ) + (pc.2.1 : ℤ) - j - 1).toNat, by omega⟩
            rw [hγ] at hgr
            have h3 := ih ht (W.smul u j pc.1) γ hgr (k + (-(pc.2.2 : ℤ) - 1) - j)
            refine (Gfil_antitone A B ?_) h3
            simp only [wordLevel_cons]
            push_cast
            omega

/-- **KEY-1 (Li's mode estimate).**  For a lowest-weight generated module and a homogeneous
`u ∈ 𝒱_bu`, `u₍ₖ₎ · Gfil p ⊆ Gfil (p − k − 1)` for **every** `k ∈ ℤ`. -/
theorem act_mem_Gfil (A : WeakModule W M) (B : Set M) (hLW : LWGenerated A B) {u : 𝒱} {bu : ℕ}
    (hu : u ∈ W.grading (bu : ℤ)) (k : ℤ) {p : ℤ} {x : M} (hx : x ∈ Gfil A B p) :
    mode (A.YM u) k x ∈ Gfil A B (p - k - 1) := by
  refine Submodule.span_induction
    (p := fun x _ => mode (A.YM u) k x ∈ Gfil A B (p - k - 1)) ?_ ?_ ?_ ?_ hx
  · rintro y ⟨l, w, hl, hw, hlev, rfl⟩
    have h := wordAct_act_mem_Gfil A B hLW l hw hl u bu hu k
    refine (Gfil_antitone A B ?_) h
    have : p.toNat ≤ wordLevel l := hlev
    omega
  · simp only [map_zero]; exact Submodule.zero_mem _
  · intro y z _ _ hy hz; rw [map_add]; exact Submodule.add_mem _ hy hz
  · intro a y _ hy; rw [map_smul]; exact Submodule.smul_mem _ a hy

/-! ## KEY-3 — reordering costs exactly one level -/

/-- **KEY-3 (`gr^F M` is commutative).**  For `x ∈ Gfil r`, the commutator of two
homogeneous negative modes lands **one level above** the level `r + m + n` of the product:
`[a₍₋m₋₁₎, b₍₋n₋₁₎] x ∈ Gfil (r + m + n + 1)`.

Each correction term of the commutator formula is a single mode `(a₍ⱼ₎b)₍₋m₋n₋₂₋ⱼ₎` of depth
`m + n + 1 + j ≥ m + n + 1`. -/
theorem smul_comm_mem_Gfil (A : WeakModule W M) (B : Set M) (hLW : LWGenerated A B)
    {a b : 𝒱} {ba bb : ℕ} (ha : a ∈ W.grading (ba : ℤ)) (hb : b ∈ W.grading (bb : ℤ)) (m n : ℕ)
    {r : ℤ} {x : M} (hx : x ∈ Gfil A B r) :
    mode (A.YM a) (-(m : ℤ) - 1) (mode (A.YM b) (-(n : ℤ) - 1) x)
      - mode (A.YM b) (-(n : ℤ) - 1) (mode (A.YM a) (-(m : ℤ) - 1) x)
      ∈ Gfil A B (r + m + n + 1) := by
  rw [mode_commutator A a b x (-(m : ℤ) - 1) (-(n : ℤ) - 1)]
  refine finsum_mem_submodule_lf _ _ (fun j => ?_)
  rcases lt_or_ge j 0 with hj | hj
  · rw [cbz_apply_neg _ hj, zero_smul]; exact Submodule.zero_mem _
  · refine Submodule.smul_mem _ _ ?_
    have hgr : W.smul a j b ∈ W.grading ((ba : ℤ) + (bb : ℤ) - j - 1) := W.smul_mem_grading ha hb j
    rcases lt_or_ge ((ba : ℤ) + (bb : ℤ) - j - 1) 0 with hneg | hnn
    · have hz : W.smul a j b = 0 := by
        rw [W.positivity _ hneg, Submodule.mem_bot] at hgr; exact hgr
      rw [hz]
      simp only [map_zero, mode_zero, LinearMap.zero_apply]
      exact Submodule.zero_mem _
    · obtain ⟨γ, hγ⟩ : ∃ γ : ℕ, ((ba : ℤ) + (bb : ℤ) - j - 1) = (γ : ℤ) :=
        ⟨((ba : ℤ) + (bb : ℤ) - j - 1).toNat, by omega⟩
      rw [hγ] at hgr
      have h := act_mem_Gfil A B hLW hgr (-(m : ℤ) - 1 + (-(n : ℤ) - 1) - j) hx
      refine (Gfil_antitone A B ?_) h
      omega

/-! ## KEY-2 — a `C₂` factor costs a level -/

/-- The homogeneous-generator case of KEY-2: `(u₍₋₂₎v)₍ₙ₎ · Gfil r ⊆ Gfil (r − n)`. -/
theorem O₂gen_act_mem_Gfil (A : WeakModule W M) (B : Set M) (hLW : LWGenerated A B)
    {u v : 𝒱} {bu bv : ℕ} (hu : u ∈ W.grading (bu : ℤ)) (hv : v ∈ W.grading (bv : ℤ)) (N : ℤ)
    {r : ℤ} {x : M} (hx : x ∈ Gfil A B r) :
    mode (A.YM (W.smul u (-2) v)) N x ∈ Gfil A B (r - N) := by
  rw [mode_iterate A u v x (-2) N]
  refine finsum_mem_submodule_lf _ _ (fun j => ?_)
  rcases lt_or_ge j 0 with hj | hj
  · rw [cbz_apply_neg _ hj, mul_zero, zero_smul]; exact Submodule.zero_mem _
  refine Submodule.smul_mem _ _ (Submodule.sub_mem _ ?_ (Submodule.smul_mem _ _ ?_))
  · -- Family A: `u₍₋₂₋ⱼ₎ (v₍ₙ₊ⱼ₎ x)`
    have h1 := act_mem_Gfil A B hLW hv (N + j) hx
    have h2 := act_mem_Gfil A B hLW hu (-2 - j) h1
    refine (Gfil_antitone A B ?_) h2
    omega
  · -- Family B: `v₍₋₂₊ₙ₋ⱼ₎ (u₍ⱼ₎ x)`
    have h1 := act_mem_Gfil A B hLW hu j hx
    have h2 := act_mem_Gfil A B hLW hv (-2 + N - j) h1
    refine (Gfil_antitone A B ?_) h2
    omega

/-- **KEY-2 (`C₂` costs a level).**  For `c ∈ O₂ W = C₂(𝒱)` and any mode `N`,
`c₍ₙ₎ · Gfil r ⊆ Gfil (r − N)` — one level better than the generic `act_mem_Gfil`.

This is the mechanism by which `C₂`-cofiniteness cuts the spanning set down to the finitely
many generators of `𝒱/C₂(𝒱)`: modulo `Gfil (p+1)` the `C₂` part of any letter disappears. -/
theorem O₂_act_mem_Gfil (A : WeakModule W M) (B : Set M) (hLW : LWGenerated A B)
    {c : 𝒱} (hc : c ∈ O₂ W) (N : ℤ) {r : ℤ} {x : M} (hx : x ∈ Gfil A B r) :
    mode (A.YM c) N x ∈ Gfil A B (r - N) := by
  rw [O₂_eq_span_homGen] at hc
  refine Submodule.span_induction
    (p := fun c _ => mode (A.YM c) N x ∈ Gfil A B (r - N)) ?_ ?_ ?_ ?_ hc
  · rintro g ⟨p, q, a, b, ha, hb, rfl⟩
    -- reduce to nonnegative recorded weights (negative grading pieces are `⊥`)
    rcases lt_or_ge p 0 with hp | hp
    · have hz : a = 0 := by rw [W.positivity p hp, Submodule.mem_bot] at ha; exact ha
      rw [hz, PreVertexAlgebra.smul_zero_left]
      simp only [map_zero, mode_zero, LinearMap.zero_apply]
      exact Submodule.zero_mem _
    rcases lt_or_ge q 0 with hq | hq
    · have hz : b = 0 := by rw [W.positivity q hq, Submodule.mem_bot] at hb; exact hb
      rw [hz, PreVertexAlgebra.smul_zero_right]
      simp only [map_zero, mode_zero, LinearMap.zero_apply]
      exact Submodule.zero_mem _
    obtain ⟨p', rfl⟩ : ∃ p' : ℕ, p = (p' : ℤ) := ⟨p.toNat, by omega⟩
    obtain ⟨q', rfl⟩ : ∃ q' : ℕ, q = (q' : ℤ) := ⟨q.toNat, by omega⟩
    exact O₂gen_act_mem_Gfil A B hLW ha hb N hx
  · simp only [map_zero, mode_zero, LinearMap.zero_apply]
    exact Submodule.zero_mem _
  · intro c₁ c₂ _ _ h1 h2
    rw [map_add, mode_add, LinearMap.add_apply]
    exact Submodule.add_mem _ h1 h2
  · intro a c₁ _ h1
    rw [map_smul, mode_smul, LinearMap.smul_apply]
    exact Submodule.smul_mem _ a h1

end Filtration

/-! ## The filtration is exhaustive in each weight space -/

section Graded

variable {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]

/-- The span of the weight spaces `M_{h+d}` with `d ≥ P`. -/
def wtGe (N : OrdVModule W M) (h : ℂ) (P : ℕ) : Submodule ℂ M :=
  ⨆ (d : ℕ) (_ : P ≤ d), N.weight (h + d)

theorem weight_le_wtGe (N : OrdVModule W M) (h : ℂ) {P d : ℕ} (hd : P ≤ d) :
    N.weight (h + d) ≤ wtGe N h P :=
  le_iSup_of_le d (le_iSup_of_le hd le_rfl)

/-- An admissible word raises the weight by its degree. -/
theorem wordAct_mem_weight (N : OrdVModule W M) {l : List (Letter 𝒱)} (hl : WordOK W l) {α : ℂ}
    {x : M} (hx : x ∈ N.weight α) :
    wordAct N.toWeakModule l x ∈ N.weight (α + (wordDeg l : ℂ)) := by
  induction l generalizing α with
  | nil => simpa using hx
  | cons pc t ih =>
      obtain ⟨hpc, ht⟩ := WordOK_of_cons hl
      rw [wordAct_cons]
      have h := mode_mem_weight N hpc (ih ht hx) (-(pc.2.2 : ℤ) - 1)
      convert h using 2
      simp only [wordDeg_cons]
      push_cast
      ring

/-- **The filtration lands in high weights.**  If every bottom vector sits in some
`M_{h+d₀}` with `d₀ ≥ 0`, then `Gfil p ≤ wtGe N h p`: the level-`p` piece only meets weights
`≥ h + p`. -/
theorem Gfil_le_wtGe (N : OrdVModule W M) (B : Set M) (h : ℂ)
    (hB : ∀ w ∈ B, ∃ d₀ : ℕ, w ∈ N.weight (h + d₀)) (p : ℕ) :
    Gfil N.toWeakModule B (p : ℤ) ≤ wtGe N h p := by
  rw [Gfil, Submodule.span_le]
  rintro x ⟨l, w, hl, hw, hlev, rfl⟩
  obtain ⟨d₀, hd₀⟩ := hB w hw
  have hmem := wordAct_mem_weight N hl hd₀
  have hcast : (h + (d₀ : ℂ)) + (wordDeg l : ℂ) = h + ((d₀ + wordDeg l : ℕ) : ℂ) := by
    push_cast; ring
  rw [hcast] at hmem
  refine weight_le_wtGe N h ?_ hmem
  have h1 : wordLevel l ≤ wordDeg l := wordLevel_le_wordDeg l
  have h2 : p ≤ wordLevel l := by simpa using hlev
  omega

/-- **Exhaustiveness.**  For `p > d` the level-`p` piece misses the weight space `M_{h+d}`
entirely.  This is what terminates the downward induction on the filtration level. -/
theorem Gfil_inf_weight_eq_bot (N : OrdVModule W M) (B : Set M) (h : ℂ)
    (hB : ∀ w ∈ B, ∃ d₀ : ℕ, w ∈ N.weight (h + d₀)) {p d : ℕ} (hpd : d < p) :
    Gfil N.toWeakModule B (p : ℤ) ⊓ N.weight (h + d) = ⊥ := by
  have hindep : iSupIndep N.weight :=
    ((DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top N.weight).mp N.isInternal).1
  have hdisj : Disjoint (N.weight (h + d)) (⨆ (β : ℂ) (_ : β ≠ h + d), N.weight β) := by
    have := hindep (h + d)
    simpa [iSupIndep] using this
  have hle : wtGe N h p ≤ ⨆ (β : ℂ) (_ : β ≠ h + d), N.weight β := by
    refine iSup_le (fun d' => iSup_le (fun hd' => ?_))
    refine le_iSup_of_le (h + (d' : ℂ)) (le_iSup_of_le ?_ le_rfl)
    intro hcontra
    have : ((d' : ℕ) : ℂ) = ((d : ℕ) : ℂ) := by
      have := hcontra
      linear_combination this
    have : (d' : ℕ) = d := by exact_mod_cast this
    omega
  have := hdisj.mono_right (le_trans (Gfil_le_wtGe N B h hB p) hle)
  rw [inf_comm]
  exact this.eq_bot

end Graded

end VOA
