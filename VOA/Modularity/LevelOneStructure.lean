import VOA.Modularity.EisensteinCuspLimit
import Mathlib.NumberTheory.ModularForms.LevelOne.DimensionFormula
import Mathlib.NumberTheory.ModularForms.LevelOne.GradedRing
import Mathlib.NumberTheory.ModularForms.CuspFormSubmodule

/-!
# Level-one generation: every modular form is a polynomial in `E₄`, `E₆`

Stated in the plain `ℂ`-algebra `ℍ → ℂ` (no graded-ring plumbing): the subalgebra
`E46 = ℂ⟨E₄, E₆⟩` contains `⇑f` for **every** `f : ModularForm 𝒮ℒ k`, every `k : ℤ`.

The proof is Serre's, and every hard ingredient is already in Mathlib:

* `levelOne_neg_weight_eq_zero`, `levelOne_odd_weight_eq_zero`, `levelOne_weight_zero_const`,
  `levelOne_weight_two_rank_zero` — the base cases;
* `ModularForm.toCuspForm` — a form whose `q`-expansion has zero constant term is a cusp form;
* `CuspForm.discriminantEquiv : CuspForm 𝒮ℒ k ≃ₗ[ℂ] ModularForm 𝒮ℒ (k−12)` — division by `Δ`;
* `discriminant_eq_E₄_cube_sub_E₆_sq` — `Δ = (E₄³−E₆²)/1728`, so `Δ ∈ E46`;
* `ModularForm.pow`/`mcast` — the monomials `E₄ᵃE₆ᵇ` as forms of the right weight.

Induction: for even `k ≥ 4` pick a monomial of weight `k` with value `1` at the cusp, subtract
`(value of f at ∞)` times it to land in the cusp forms, divide by `Δ`, and recurse at `k − 12`.

## Why this file exists

Route (i) to Zhu's Theorem 5.3.3 needs the block relation coefficients to lie in a **finitely
generated** `ℂ`-algebra.  The coefficients are the `G_{2j} = (zhuG j 0)·E_{2j}`, `j ≥ 2`, so what is
needed is exactly `zhuGC_mem_E46`.

## Relation to the vendored basis theorem

`levelOne_coe_mem_E46` proves **generation only** (every form lies in the subalgebra `ℂ⟨E₄, E₆⟩`).
The stronger statement — the weight-`k` monomials `E₄ᵃE₆ᵇ` form a *basis* of `M_k` — is
`ModularForm.levelOne_eq_polynomial` in `LatticesAndCodes/ModularForms/LevelOne.lean`, proved
independently; the two are not connected in the library.

## Main results

* `levelOne_coe_mem_E46` — generation by `E₄`, `E₆` (not algebraic independence);
* `E_mem_E46`, `zhuGC_mem_E46`.

## Status
Proved, axiom-clean, `pbw`-free, no `sorry`.
-/

namespace VOA

open ModularForm UpperHalfPlane Filter
open scoped MatrixGroups Topology Real

/-- The `ℂ`-subalgebra of functions on `ℍ` generated by `E₄` and `E₆`. -/
noncomputable def E46 : Subalgebra ℂ (UpperHalfPlane → ℂ) :=
  Algebra.adjoin ℂ {(⇑ModularForm.E₄ : UpperHalfPlane → ℂ), (⇑ModularForm.E₆ : UpperHalfPlane → ℂ)}

theorem E4_mem_E46 : (⇑ModularForm.E₄ : UpperHalfPlane → ℂ) ∈ E46 :=
  Algebra.subset_adjoin (by simp)

theorem E6_mem_E46 : (⇑ModularForm.E₆ : UpperHalfPlane → ℂ) ∈ E46 :=
  Algebra.subset_adjoin (by simp)

/-- `Δ = (E₄³ − E₆²)/1728` lies in `E46`. -/
theorem discriminant_mem_E46 : (ModularForm.discriminant : UpperHalfPlane → ℂ) ∈ E46 := by
  have hfun : (ModularForm.discriminant : UpperHalfPlane → ℂ)
      = (1728 : ℂ)⁻¹ • ((⇑ModularForm.E₄ : UpperHalfPlane → ℂ) ^ 3
          - (⇑ModularForm.E₆ : UpperHalfPlane → ℂ) ^ 2) := by
    funext z
    rw [ModularForm.discriminant_eq_E₄_cube_sub_E₆_sq z]
    simp only [Pi.smul_apply, Pi.sub_apply, Pi.pow_apply, smul_eq_mul]
    ring
  rw [hfun]
  exact Subalgebra.smul_mem _ (Subalgebra.sub_mem _ (Subalgebra.pow_mem _ E4_mem_E46 3)
    (Subalgebra.pow_mem _ E6_mem_E46 2)) _

/-! ## Monomials of a prescribed even weight, with cusp value `1` -/

/-- For every even `k ≥ 4` there is a modular form of weight `k` lying in `E46` whose value at
the cusp is `1` — a monomial `E₄ᵃE₆ᵇ`. -/
theorem exists_unit_modularForm : ∀ k : ℕ, Even k → 4 ≤ k →
    ∃ F : ModularForm 𝒮ℒ (k : ℤ), (⇑F : UpperHalfPlane → ℂ) ∈ E46 ∧
      Tendsto (⇑F : UpperHalfPlane → ℂ) atImInfty (𝓝 1) := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    intro hk h4
    have hE4 : Tendsto (⇑ModularForm.E₄ : UpperHalfPlane → ℂ) atImInfty (𝓝 1) := by
      have := tendsto_modularForm_atImInfty (ModularForm.E₄)
      rwa [valueAtInfty_E (by norm_num) (by decide)] at this
    have hE6 : Tendsto (⇑ModularForm.E₆ : UpperHalfPlane → ℂ) atImInfty (𝓝 1) := by
      have := tendsto_modularForm_atImInfty (ModularForm.E₆)
      rwa [valueAtInfty_E (by norm_num) (by decide)] at this
    rcases eq_or_lt_of_le h4 with h | h4'
    · exact ⟨ModularForm.mcast (show (4 : ℤ) = (k : ℤ) from by omega) ModularForm.E₄, by
        rw [ModularForm.coe_mcast]; exact E4_mem_E46, by rw [ModularForm.coe_mcast]; exact hE4⟩
    rcases eq_or_lt_of_le (show 6 ≤ k by
      rcases hk with ⟨m, rfl⟩; omega) with h6 | h6'
    · exact ⟨ModularForm.mcast (show (6 : ℤ) = (k : ℤ) from by omega) ModularForm.E₆, by
        rw [ModularForm.coe_mcast]; exact E6_mem_E46, by rw [ModularForm.coe_mcast]; exact hE6⟩
    · have hk8 : 8 ≤ k := by rcases hk with ⟨m, rfl⟩; omega
      obtain ⟨G, hGmem, hGlim⟩ := ih (k - 4) (by omega) (by
        rcases hk with ⟨m, rfl⟩; exact ⟨m - 2, by omega⟩) (by omega)
      refine ⟨ModularForm.mcast (show (4 : ℤ) + ((k - 4 : ℕ) : ℤ) = (k : ℤ) from by
        push_cast [Nat.cast_sub (by omega : 4 ≤ k)]; ring)
        (ModularForm.E₄.mul G), ?_, ?_⟩
      · rw [ModularForm.coe_mcast, ModularForm.coe_mul]
        exact Subalgebra.mul_mem _ E4_mem_E46 hGmem
      · rw [ModularForm.coe_mcast, ModularForm.coe_mul]
        simpa using hE4.mul hGlim

/-! ## The structure theorem -/

/-- **Every level-one modular form is a polynomial in `E₄` and `E₆`** (generation only;
the basis statement is the vendored `ModularForm.levelOne_eq_polynomial`). -/
theorem levelOne_coe_mem_E46 : ∀ (k : ℤ) (f : ModularForm 𝒮ℒ k),
    (⇑f : UpperHalfPlane → ℂ) ∈ E46 := by
  intro k
  induction hn : k.toNat using Nat.strong_induction_on generalizing k with
  | _ n ih =>
    intro f
    rcases lt_or_ge k 0 with hneg | hpos
    · rw [ModularFormClass.levelOne_neg_weight_eq_zero hneg f]
      exact Subalgebra.zero_mem _
    rcases Int.even_or_odd k with hev | hodd
    swap
    · rw [ModularForm.levelOne_odd_weight_eq_zero hodd f]
      exact Subalgebra.zero_mem _
    rcases lt_or_ge k 4 with hsmall | hbig
    · -- k ∈ {0, 2}
      interval_cases k
      · obtain ⟨c, hc⟩ := ModularFormClass.levelOne_weight_zero_const f
        rw [hc]
        exact Subalgebra.algebraMap_mem _ c
      · exact absurd hev (by decide)
      · have : Subsingleton (ModularForm 𝒮ℒ 2) := by
          rw [← rank_zero_iff (R := ℂ)]
          exact ModularForm.levelOne_weight_two_rank_zero
        rw [Subsingleton.elim f 0]
        exact Subalgebra.zero_mem _
      · exact absurd hev (by decide)
    -- the main case: `k` even, `k ≥ 4`
    obtain ⟨F0, hF0mem, hF0lim⟩ := exists_unit_modularForm k.toNat
      (by rcases hev with ⟨m, hm⟩; exact ⟨m.toNat, by omega⟩) (by omega)
    have hcast : ((k.toNat : ℕ) : ℤ) = k := by omega
    set F : ModularForm 𝒮ℒ k := ModularForm.mcast hcast F0 with hFdef
    have hFmem : (⇑F : UpperHalfPlane → ℂ) ∈ E46 := by
      rw [hFdef, ModularForm.coe_mcast]; exact hF0mem
    have hFlim : Tendsto (⇑F : UpperHalfPlane → ℂ) atImInfty (𝓝 1) := by
      rw [hFdef, ModularForm.coe_mcast]; exact hF0lim
    set c : ℂ := valueAtInfty (⇑f : UpperHalfPlane → ℂ) with hc
    have hflim : Tendsto (⇑f : UpperHalfPlane → ℂ) atImInfty (𝓝 c) :=
      tendsto_modularForm_atImInfty f
    have hdiff : Tendsto (⇑(f - c • F) : UpperHalfPlane → ℂ) atImInfty (𝓝 0) := by
      have hstep : Tendsto (fun z : UpperHalfPlane => f z - c * F z) atImInfty (𝓝 (c - c * 1)) :=
        hflim.sub (hFlim.const_mul c)
      simpa using hstep
    have hcoeff : (qExpansion 1 (⇑(f - c • F) : UpperHalfPlane → ℂ)).coeff 0 = 0 := by
      rw [qExpansion_coeff_zero (h := 1) one_pos
        (ModularFormClass.analyticAt_cuspFunction_zero (F := ModularForm 𝒮ℒ k)
          (f := f - c • F) one_pos one_mem_strictPeriods_SL)
        (SlashInvariantFormClass.periodic_comp_ofComplex (f - c • F) one_mem_strictPeriods_SL)]
      exact hdiff.limUnder_eq
    have hgmem : (⇑(CuspForm.discriminantEquiv (ModularForm.toCuspForm (f - c • F) hcoeff))
        : UpperHalfPlane → ℂ) ∈ E46 := ih (k - 12).toNat (by omega) (k - 12) rfl _
    have hsplit : (⇑f : UpperHalfPlane → ℂ)
        = c • (⇑F : UpperHalfPlane → ℂ)
          + (ModularForm.discriminant : UpperHalfPlane → ℂ)
            * (⇑(CuspForm.discriminantEquiv (ModularForm.toCuspForm (f - c • F) hcoeff))
                : UpperHalfPlane → ℂ) := by
      funext z
      have hmul := ModularForm.discriminant_mul_discriminantEquiv_apply
        (ModularForm.toCuspForm (f - c • F) hcoeff) z
      rw [ModularForm.toCuspForm_apply] at hmul
      have hfz : (f - c • F) z = f z - c * F z := rfl
      rw [hfz] at hmul
      simp only [Pi.add_apply, Pi.smul_apply, Pi.mul_apply, smul_eq_mul]
      rw [hmul]
      ring
    rw [hsplit]
    exact Subalgebra.add_mem _ (Subalgebra.smul_mem _ hFmem c)
      (Subalgebra.mul_mem _ discriminant_mem_E46 hgmem)

/-- Every normalised Eisenstein series is a polynomial in `E₄`, `E₆`. -/
theorem E_mem_E46 {k : ℕ} (hk : 3 ≤ k) :
    (⇑(ModularForm.E hk) : UpperHalfPlane → ℂ) ∈ E46 :=
  levelOne_coe_mem_E46 _ _

/-- **The coefficient ring of Zhu's block relations is finitely generated**:
`G_{2j} ∈ ℂ[E₄, E₆]` for every `j ≥ 2`. -/
theorem zhuGC_mem_E46 {j : ℕ} (hj : 2 ≤ j) :
    (fun z : UpperHalfPlane => zhuGC j (z : ℂ)) ∈ E46 := by
  have hk : 3 ≤ 2 * j := by omega
  have hfun : (fun z : UpperHalfPlane => zhuGC j (z : ℂ))
      = zhuG j 0 • (⇑(ModularForm.E hk) : UpperHalfPlane → ℂ) := by
    funext z
    rw [zhuGC_eq_mul_E hj (coe_mem_imGT_zero z)]
    rfl
  rw [hfun]
  exact Subalgebra.smul_mem _ (E_mem_E46 hk) _

end VOA
