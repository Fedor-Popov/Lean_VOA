namespace VOA

namespace SlashSub

open Complex
open scoped BigOperators MatrixGroups

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## (b) The slash relation required only on a subgroup -/

/-- **`G` is a `Γ`-slash system for `F`**: for every `γ` in the subgroup `Γ`, the family
`G γ` is the weight-graded slash of `F` by `γ`.  This is `IsSlashOf` with the quantifier over
`γ` restricted from all of `SL₂(ℤ)` to `Γ`. -/
def IsSlashOfOn (W : VertexOperatorAlgebra 𝒱) (Γ : Subgroup SL(2, ℤ)) (F : 𝒱 → ℂ → ℂ)
    (G : SL(2, ℤ) → 𝒱 → ℂ → ℂ) : Prop :=
  ∀ γ ∈ Γ, IsSlashOf W γ F (G γ)

/-- **The subgroup-element case**: at a member of `Γ` the full relation is available. -/
theorem IsSlashOfOn.mem {W : VertexOperatorAlgebra 𝒱} {Γ : Subgroup SL(2, ℤ)} {F : 𝒱 → ℂ → ℂ}
    {G : SL(2, ℤ) → 𝒱 → ℂ → ℂ} (hG : IsSlashOfOn W Γ F G) {γ : SL(2, ℤ)} (hγ : γ ∈ Γ) :
    IsSlashOf W γ F (G γ) := hG γ hγ

/-- **Restriction along an inclusion of subgroups.** -/
theorem IsSlashOfOn.mono {W : VertexOperatorAlgebra 𝒱} {Γ Γ' : Subgroup SL(2, ℤ)} (hle : Γ ≤ Γ')
    {F : 𝒱 → ℂ → ℂ} {G : SL(2, ℤ) → 𝒱 → ℂ → ℂ} (hG : IsSlashOfOn W Γ' F G) :
    IsSlashOfOn W Γ F G :=
  fun γ hγ => hG γ (hle hγ)

/-- **Restriction from the full group.** -/
theorem isSlashOfOn_of_forall {W : VertexOperatorAlgebra 𝒱} {F : 𝒱 → ℂ → ℂ}
    {G : SL(2, ℤ) → 𝒱 → ℂ → ℂ} (hG : ∀ γ : SL(2, ℤ), IsSlashOf W γ F (G γ))
    (Γ : Subgroup SL(2, ℤ)) : IsSlashOfOn W Γ F G :=
  fun γ _ => hG γ

theorem isSlashOfOn_top_iff {W : VertexOperatorAlgebra 𝒱} {F : 𝒱 → ℂ → ℂ}
    {G : SL(2, ℤ) → 𝒱 → ℂ → ℂ} :
    IsSlashOfOn W ⊤ F G ↔ ∀ γ : SL(2, ℤ), IsSlashOf W γ F (G γ) :=
  ⟨fun hG γ => hG γ (Subgroup.mem_top γ), fun hG => isSlashOfOn_of_forall hG ⊤⟩

/-- The canonical witness `blockSlash` works over **any** subgroup — the formal content of point
(1) of the analysis: `isSlashOf_blockSlash` is elementwise in `γ`. -/
theorem isSlashOfOn_blockSlash {W : VertexOperatorAlgebra 𝒱} (Γ : Subgroup SL(2, ℤ))
    {F : 𝒱 → ℂ → ℂ} (hF0 : ∀ z ∈ imGT 0, F 0 z = 0) :
    IsSlashOfOn W Γ F (fun γ => blockSlash W γ F) :=
  isSlashOfOn_of_forall (fun γ => isSlashOf_blockSlash W γ hF0) Γ

/-! ## (c) Modularity for a subgroup only -/

/-- The identity of `SL₂(ℤ)` slashes trivially: `mobiusC 1 z = z` and `denomC 1 z = 1`. -/
theorem isSlashOf_one (W : VertexOperatorAlgebra 𝒱) (F : 𝒱 → ℂ → ℂ) : IsSlashOf W 1 F F := by
  intro n v _ z _
  have hd : denomC (1 : SL(2, ℤ)) z = 1 := by simp [denomC]
  have hm : mobiusC (1 : SL(2, ℤ)) z = z := by simp [mobiusC, denomC]
  rw [slashC, hm, hd, one_zpow, mul_one]

/-- **`F` is modular for the subgroup `Γ`**: on every integer `L[0]`-weight space `𝒱_{[n]}`,
`F v ∣[n] γ = F v` for every `γ ∈ Γ`.  For `Γ = ⊤` this is full `SL₂(ℤ)`-modularity; for
`Γ = thetaGroup` it is `Γ_θ`-modularity. -/
def ModularOn (W : VertexOperatorAlgebra 𝒱) (Γ : Subgroup SL(2, ℤ)) (F : 𝒱 → ℂ → ℂ) : Prop :=
  ∀ γ ∈ Γ, IsSlashOf W γ F F

/-- **Modular for a bigger group ⟹ modular for a smaller one.** -/
theorem ModularOn.mono {W : VertexOperatorAlgebra 𝒱} {Γ Γ' : Subgroup SL(2, ℤ)} (hle : Γ ≤ Γ')
    {F : 𝒱 → ℂ → ℂ} (hF : ModularOn W Γ' F) : ModularOn W Γ F :=
  fun γ hγ => hF γ (hle hγ)

/-- **Modular for `SL₂(ℤ)` ⟹ modular for every subgroup** — the specialization the programme
needs: `SL₂(ℤ)`-modularity of a bosonic character gives `Γ_θ`-modularity for free. -/
theorem ModularOn.of_top {W : VertexOperatorAlgebra 𝒱} {F : 𝒱 → ℂ → ℂ} (hF : ModularOn W ⊤ F)
    (Γ : Subgroup SL(2, ℤ)) : ModularOn W Γ F :=
  hF.mono le_top

theorem modularOn_top_iff {W : VertexOperatorAlgebra 𝒱} {F : 𝒱 → ℂ → ℂ} :
    ModularOn W ⊤ F ↔ ∀ γ : SL(2, ℤ), IsSlashOf W γ F F :=
  ⟨fun hF γ => hF γ (Subgroup.mem_top γ), fun hF γ _ => hF γ⟩

/-- `ModularOn` is not vacuous at the bottom subgroup. -/
theorem modularOn_bot (W : VertexOperatorAlgebra 𝒱) (F : 𝒱 → ℂ → ℂ) : ModularOn W ⊥ F := by
  intro γ hγ
  rw [Subgroup.mem_bot] at hγ
  subst hγ
  exact isSlashOf_one W F

/-! ## The half-integer weight defects of the present slash layer

These are the formal content of point (3) of the analysis. -/

/-- **`IsSlashOf` constrains the slashed family ONLY on the integer weight spaces.**  Two
families agreeing on `⋃_{n : ℤ} 𝒱_{[n]}` are simultaneously slashes of `F`; off those spaces the
relation says nothing at all.  For a half-integer-weight (super) VOA this is exactly the gap. -/
theorem isSlashOf_of_eqOn_int {W : VertexOperatorAlgebra 𝒱} {γ : SL(2, ℤ)}
    {F G G' : 𝒱 → ℂ → ℂ} (hG : IsSlashOf W γ F G)
    (hGG' : ∀ w : 𝒱, (∃ n : ℤ, w ∈ sqWeightSpace W (n : ℂ)) → G' w = G w) :
    IsSlashOf W γ F G' := by
  intro n w hw z hz
  rw [hGG' w ⟨n, hw⟩]
  exact hG n w hw z hz

/-- **The canonical slash applies weight `0` off the integer weights.**  `sqWtOf W v = 0`
whenever `v` lies in no integer `L[0]`-weight space — in particular for every genuinely
half-integer weight vector. -/
theorem sqWtOf_eq_zero_of_notInt (W : VertexOperatorAlgebra 𝒱) {v : 𝒱}
    (hv : ∀ n : ℤ, v ∉ sqWeightSpace W (n : ℂ)) : sqWtOf W v = 0 := by
  have hnex : ¬ ∃ n : ℤ, v ∈ sqWeightSpace W (n : ℂ) ∧ v ≠ 0 := by
    rintro ⟨n, hn, -⟩
    exact hv n hn
  rw [sqWtOf, dif_neg hnex]

theorem blockSlash_apply_of_notInt (W : VertexOperatorAlgebra 𝒱) (γ : SL(2, ℤ))
    (F : 𝒱 → ℂ → ℂ) {v : 𝒱} (hv : ∀ n : ℤ, v ∉ sqWeightSpace W (n : ℂ)) :
    blockSlash W γ F v = slashC 0 γ (F v) := by
  have hw : sqWtOf W v = 0 := sqWtOf_eq_zero_of_notInt W hv
  simp only [blockSlash, hw]

/-! ## The vector-valued layer on a subgroup -/

section Vector

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {W : VertexOperatorAlgebra 𝒱}
variable (Mfam : ι → IrrModule W) (h : ι → ℂ)

/-- **Zhu's transformation law, required only on a subgroup `Γ`.**  `RealisesLawOn Γ` is
`TraceSpanning` with `∀ A : SL(2, ℤ)` weakened to `∀ A ∈ Γ`. -/
def RealisesLawOn (Γ : Subgroup SL(2, ℤ)) : Prop :=
  ∀ A ∈ Γ, ∃ ρA : ι → ι → ℂ, RealisesLaw Mfam h A ρA

/-- At the top subgroup this **is** `TraceSpanning`. -/
theorem realisesLawOn_top_iff : RealisesLawOn Mfam h ⊤ ↔ TraceSpanning Mfam h :=
  ⟨fun hG A => hG A (Subgroup.mem_top A), fun hG A _ => hG A⟩

theorem RealisesLawOn.mono {Γ Γ' : Subgroup SL(2, ℤ)} (hle : Γ ≤ Γ')
    (hG : RealisesLawOn Mfam h Γ') : RealisesLawOn Mfam h Γ :=
  fun A hA => hG A (hle hA)

/-- **Full modularity ⟹ modularity on any subgroup**, vector-valued. -/
theorem realisesLawOn_of_traceSpanning (hsp : TraceSpanning Mfam h) (Γ : Subgroup SL(2, ℤ)) :
    RealisesLawOn Mfam h Γ :=
  fun A _ => hsp A

/-- **The submonoid engine, subgroup-agnostic.**  The realising matrices form a submonoid
(`realisesLaw_one`, `realisesLaw_mul` — both purely cocycle-theoretic), so the law propagates
from any generating set to every *positive word* in it.  This is the mechanism of
`traceSpanning_of_S` with the full group replaced by an arbitrary monoid closure. -/
theorem realisesLaw_of_mem_closure {X : Set SL(2, ℤ)}
    (hX : ∀ x ∈ X, ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h x ρ) {A : SL(2, ℤ)}
    (hA : A ∈ Submonoid.closure X) : ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h A ρ := by
  induction hA using Submonoid.closure_induction with
  | mem x hx => exact hX x hx
  | one => exact ⟨_, realisesLaw_one Mfam h⟩
  | mul x y _ _ ihx ihy =>
      obtain ⟨ρx, hx⟩ := ihx
      obtain ⟨ρy, hy⟩ := ihy
      exact ⟨_, realisesLaw_mul Mfam h hx hy⟩

/-- **`RealisesLawOn Γ` from a monoid generating set for `Γ`.** -/
theorem realisesLawOn_of_subset_closure {X : Set SL(2, ℤ)} {Γ : Subgroup SL(2, ℤ)}
    (hX : ∀ x ∈ X, ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h x ρ)
    (hΓ : ∀ A ∈ Γ, A ∈ Submonoid.closure X) : RealisesLawOn Mfam h Γ :=
  fun A hA => realisesLaw_of_mem_closure Mfam h hX (hΓ A hA)

end Vector

/-! ## Diagonal laws and their inverses -/

section DiagMatrices

variable {ι : Type*} [DecidableEq ι]

/-- The diagonal matrix with entries `d`. -/
def diagMat (d : ι → ℂ) : ι → ι → ℂ := fun i j => if i = j then d i else 0

theorem diagMat_sum [Fintype ι] (d : ι → ℂ) (f : ι → ℂ) (i : ι) :
    ∑ j, diagMat d i j * f j = d i * f i := by
  rw [Finset.sum_eq_single i
    (fun j _ hj => by simp [diagMat, Ne.symm hj])
    (fun hi => absurd (Finset.mem_univ i) hi)]
  simp [diagMat]

theorem modularRepT_eq_diagMat (W : VertexOperatorAlgebra 𝒱) (h : ι → ℂ) :
    modularRepT W h = diagMat (fun i => modularTEntry W (h i)) := rfl

theorem modularTEntry_ne_zero (W : VertexOperatorAlgebra 𝒱) (x : ℂ) :
    modularTEntry W x ≠ 0 := Complex.exp_ne_zero _

end DiagMatrices

section InverseLaw

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {W : VertexOperatorAlgebra 𝒱}
variable (Mfam : ι → IrrModule W) (h : ι → ℂ)

/-- **The law at `A⁻¹` from a DIAGONAL, invertible law at `A` with trivial automorphy
factor.**

This is the missing ingredient of the `Γ_θ` submonoid argument.  `Γ_θ = ⟨S, T²⟩` does **not**
contain `T⁻²` as a positive word in its generators (`Γ_θ/{±1} ≅ ℤ/2 ∗ ℤ`), so — unlike the full
group, where `T⁻¹ = (ST)⁵S` — the inverse law cannot be obtained by a word.  It is obtained here
instead from invertibility of the diagonal matrix. -/
theorem realisesLaw_inv_of_diag {A : SL(2, ℤ)} {d : ι → ℂ} (hd : ∀ i, d i ≠ 0)
    (haf : ∀ τ : UpperHalfPlane, autFactor A τ = 1)
    (hA : RealisesLaw Mfam h A (diagMat d)) :
    RealisesLaw Mfam h A⁻¹ (diagMat (fun i => (d i)⁻¹)) := by
  have hAA : A * A⁻¹ = 1 := by simp
  have hafinv : ∀ τ : UpperHalfPlane, autFactor A⁻¹ τ = 1 := by
    intro τ
    have h1 : autFactor (A * A⁻¹) τ = autFactor A (A⁻¹ • τ) * autFactor A⁻¹ τ :=
      autFactor_mul A A⁻¹ τ
    rw [hAA, autFactor_one, haf (A⁻¹ • τ), one_mul] at h1
    exact h1.symm
  intro n v hv i τ
  have hkey : traceFun Mfam h i v τ = d i * traceFun Mfam h i v (A⁻¹ • τ) := by
    have hk := hA n v hv i (A⁻¹ • τ)
    rw [← mul_smul, hAA, one_smul, haf (A⁻¹ • τ), one_pow, one_mul] at hk
    simp only [diagMat_sum] at hk
    exact hk
  rw [hafinv τ, one_pow, one_mul]
  simp only [diagMat_sum]
  rw [hkey, ← mul_assoc, inv_mul_cancel₀ (hd i), one_mul]

/-- **The `T⁻¹`-law, unconditionally.**  `ρ(T)` is diagonal with entries
`e^{2πi(h−c/24)} ≠ 0` and `autFactor T ≡ 1`, so `realisesLaw_T` inverts. -/
theorem realisesLaw_T_inv (hcw : ∀ i, HasConformalWeight (Mfam i).isMod (h i)) :
    RealisesLaw Mfam h ModularGroup.T⁻¹
      (diagMat (fun i => (modularTEntry W (h i))⁻¹)) :=
  realisesLaw_inv_of_diag (A := ModularGroup.T) (d := fun i => modularTEntry W (h i))
    Mfam h (fun i => modularTEntry_ne_zero W (h i)) autFactor_T (realisesLaw_T Mfam h hcw)

/-- The `T²`-law, from the `T`-law. -/
theorem realisesLaw_T_sq (hcw : ∀ i, HasConformalWeight (Mfam i).isMod (h i)) :
    ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h (ModularGroup.T ^ 2) ρ := by
  have hT := realisesLaw_T Mfam h hcw
  have h2 := realisesLaw_mul Mfam h hT hT
  rw [← pow_two] at h2
  exact ⟨_, h2⟩

/-- The `T⁻²`-law, from the `T⁻¹`-law. -/
theorem realisesLaw_T_sq_inv (hcw : ∀ i, HasConformalWeight (Mfam i).isMod (h i)) :
    ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h ((ModularGroup.T ^ 2)⁻¹) ρ := by
  have hTi := realisesLaw_T_inv Mfam h hcw
  have h2 := realisesLaw_mul Mfam h hTi hTi
  rw [← mul_inv_rev, ← pow_two] at h2
  exact ⟨_, h2⟩

end InverseLaw

/-! ## The theta group -/

/-- **The theta group** `Γ_θ = ⟨S, T²⟩ ≤ SL₂(ℤ)`.

Classically `Γ_θ` is the index-`3` subgroup `{γ : γ ≡ I or S (mod 2)}`, the stabiliser of the
theta multiplier.  That identification and properness, `T ∉ Γ_θ`, are proved downstream
(`GammaThetaStmt.thetaGroup_eq`, `thetaGroup_index`, `thetaGroupProper`).    Everything this file needs is generation, which is definitional. -/
def thetaGroup : Subgroup SL(2, ℤ) :=
  Subgroup.closure ({ModularGroup.S, ModularGroup.T ^ 2} : Set SL(2, ℤ))

theorem S_mem_thetaGroup : ModularGroup.S ∈ thetaGroup :=
  Subgroup.subset_closure (by simp)

theorem T_sq_mem_thetaGroup : ModularGroup.T ^ 2 ∈ thetaGroup :=
  Subgroup.subset_closure (by simp)

theorem T_sq_inv_mem_thetaGroup : (ModularGroup.T ^ 2)⁻¹ ∈ thetaGroup :=
  inv_mem T_sq_mem_thetaGroup

theorem thetaGroup_le_top : thetaGroup ≤ ⊤ := le_top

/-- **Properness of the theta group**: `T ∉ Γ_θ` (`Γ_θ` has index `3` in `SL₂(ℤ)`).  This is what
makes the whole programme non-trivial — if it failed, `Γ_θ`-modularity would just be
`SL₂(ℤ)`-modularity.  Stated here as a `Prop`; proved downstream as
`GammaThetaStmt.thetaGroupProper` (`Modularity/GammaThetaStatement.lean`). -/
def ThetaGroupProper : Prop := ModularGroup.T ∉ thetaGroup

/-- **`Γ_θ` is contained in the SUBMONOID generated by `S`, `T²` and `T⁻²`.**

The exact analogue of `submonoid_closure_S_T_eq_top`, and the reason the `Γ_θ` programme can reuse
the whole `TraceSpanningS` mechanism.  `S⁻¹ = S³` is a positive word in `S` (`S_inv_eq`), so only
`(T²)⁻¹` has to be adjoined — and unlike the full-group case it genuinely **must** be adjoined,
since `Γ_θ/{±1} ≅ ℤ/2 ∗ ℤ` makes `T⁻²` no positive word in `S` and `T²`. -/
theorem thetaGroup_le_submonoidClosure (A : SL(2, ℤ)) (hA : A ∈ thetaGroup) :
    A ∈ Submonoid.closure
      ({ModularGroup.S, ModularGroup.T ^ 2, (ModularGroup.T ^ 2)⁻¹} : Set SL(2, ℤ)) := by
  have hS : ModularGroup.S ∈ Submonoid.closure
      ({ModularGroup.S, ModularGroup.T ^ 2, (ModularGroup.T ^ 2)⁻¹} : Set SL(2, ℤ)) :=
    Submonoid.subset_closure (by simp)
  have hT2 : ModularGroup.T ^ 2 ∈ Submonoid.closure
      ({ModularGroup.S, ModularGroup.T ^ 2, (ModularGroup.T ^ 2)⁻¹} : Set SL(2, ℤ)) :=
    Submonoid.subset_closure (by simp)
  have hT2i : (ModularGroup.T ^ 2)⁻¹ ∈ Submonoid.closure
      ({ModularGroup.S, ModularGroup.T ^ 2, (ModularGroup.T ^ 2)⁻¹} : Set SL(2, ℤ)) :=
    Submonoid.subset_closure (by simp)
  have hsub : A ∈ (Subgroup.closure
      ({ModularGroup.S, ModularGroup.T ^ 2} : Set SL(2, ℤ))).toSubmonoid := hA
  rw [Subgroup.closure_toSubmonoid] at hsub
  refine Submonoid.closure_le.mpr ?_ hsub
  rintro y (hy | hy)
  · rcases hy with rfl | hy
    · exact hS
    · rw [Set.mem_singleton_iff] at hy
      subst hy
      exact hT2
  · rw [Set.mem_inv] at hy
    have hy' : y = ModularGroup.S⁻¹ ∨ y = (ModularGroup.T ^ 2)⁻¹ := by
      rcases hy with hy | hy
      · exact Or.inl (by rw [← hy, inv_inv])
      · rw [Set.mem_singleton_iff] at hy
        exact Or.inr (by rw [← hy, inv_inv])
    rcases hy' with rfl | rfl
    · rw [S_inv_eq]
      exact Submonoid.pow_mem _ hS 3
    · exact hT2i

/-! ## `Γ_θ`-modularity of the trace functions -/

section Theta

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {W : VertexOperatorAlgebra 𝒱}
variable (Mfam : ι → IrrModule W) (h : ι → ℂ)

/-- **The `Γ_θ` analogue of `traceSpanning_of_S`.**

Zhu's law holds on all of `Γ_θ` as soon as it holds at the three matrices `S`, `T²`, `T⁻²`.
For a **super** or half-integer-weight VOA this is the right shape: the `T`-law is unavailable —
that is the whole point of `Γ_θ` — but the `T²`-law survives, and the `T⁻²`-law follows from it
by `realisesLaw_inv_of_diag` whenever the `T²`-matrix is diagonal and invertible. -/
theorem realisesLawOn_thetaGroup_of_generators
    (hS : ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h ModularGroup.S ρ)
    (hT2 : ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h (ModularGroup.T ^ 2) ρ)
    (hT2i : ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h ((ModularGroup.T ^ 2)⁻¹) ρ) :
    RealisesLawOn Mfam h thetaGroup := by
  refine realisesLawOn_of_subset_closure Mfam h ?_ thetaGroup_le_submonoidClosure
  intro x hx
  rcases hx with rfl | rfl | hx
  · exact hS
  · exact hT2
  · rw [Set.mem_singleton_iff] at hx
    subst hx
    exact hT2i

/-- **For an integer-weight (bosonic) VOA, `Γ_θ`-modularity costs exactly what full
modularity costs: the `S`-law.**  The `T²`- and `T⁻²`-inputs are free (`realisesLaw_T_sq`,
`realisesLaw_T_sq_inv`).  So restricting to `Γ_θ` buys nothing in the bosonic case — confirming
that the `Γ_θ` programme is about the *weight*, not about the *group*. -/
theorem realisesLawOn_thetaGroup_of_S (hcw : ∀ i, HasConformalWeight (Mfam i).isMod (h i))
    (hS : ∃ ρ : ι → ι → ℂ, RealisesLaw Mfam h ModularGroup.S ρ) :
    RealisesLawOn Mfam h thetaGroup :=
  realisesLawOn_thetaGroup_of_generators Mfam h hS (realisesLaw_T_sq Mfam h hcw)
    (realisesLaw_T_sq_inv Mfam h hcw)

/-- The other side of the comparison: full modularity restricts to `Γ_θ`. -/
theorem realisesLawOn_thetaGroup_of_traceSpanning (hsp : TraceSpanning Mfam h) :
    RealisesLawOn Mfam h thetaGroup :=
  realisesLawOn_of_traceSpanning Mfam h hsp thetaGroup

end Theta

/-! ## (d) What `Γ_θ` modularity means for a SUPER VOA character

`slashC (k : ℤ)` multiplies by `(cz+d)^{-k}` with an **integer** exponent; a half-integer weight
needs `(cτ+d)^{1/2}`, i.e. a chosen square root together with the multiplier system recording its
failure to be a strict cocycle.  That datum is `HalfAutFactor`.  With it, `Γ_θ`-modularity of a
super character is a statement of exactly the shape of `RealisesLaw`, with `autFactor A τ ^ n`
(`n : ℕ`) replaced by `J.sq A τ ^ m` (`m : ℤ`, the *doubled* weight).

Nothing here is proved about any concrete super VOA: these are the **targets**. -/

section Super

/-- **A half-integral automorphy factor on `Γ`** — a chosen square root of `cτ+d` together
with its multiplier system.  `sq A τ` plays the role of `(cτ+d)^{1/2}`, so the weight-`m/2`
factor is `sq A τ ^ m` for `m : ℤ`.  For `Γ = thetaGroup` the intended instance is
`sq A τ = θ(Aτ)/θ(τ)` with `θ` the Jacobi theta constant, whose multiplier is an eighth root of
unity. -/
structure HalfAutFactor (Γ : Subgroup SL(2, ℤ)) where
  /-- The chosen square root of the automorphy factor. -/
  sq : SL(2, ℤ) → UpperHalfPlane → ℂ
  /-- It really is a square root of `cτ+d`. -/
  sq_sq : ∀ A ∈ Γ, ∀ τ : UpperHalfPlane, sq A τ ^ (2 : ℤ) = autFactor A τ
  /-- It never vanishes. -/
  sq_ne_zero : ∀ A ∈ Γ, ∀ τ : UpperHalfPlane, sq A τ ≠ 0
  /-- The multiplier system: the obstruction to `sq` being a strict cocycle. -/
  mult : SL(2, ℤ) → SL(2, ℤ) → ℂ
  /-- The cocycle identity, up to the multiplier. -/
  cocycle : ∀ A ∈ Γ, ∀ B ∈ Γ, ∀ τ : UpperHalfPlane,
    sq (A * B) τ = mult A B * (sq A (B • τ) * sq B τ)
  /-- Normalisation at the identity. -/
  sq_one : ∀ τ : UpperHalfPlane, sq 1 τ = 1

/-- On **even** doubled weight `m = 2n` the half-integral factor collapses to the repo's
`autFactor A τ ^ n`: the new layer extends the old one, it does not replace it. -/
theorem HalfAutFactor.zpow_even {Γ : Subgroup SL(2, ℤ)} (J : HalfAutFactor Γ) {A : SL(2, ℤ)}
    (hA : A ∈ Γ) (τ : UpperHalfPlane) (n : ℤ) :
    J.sq A τ ^ (2 * n) = autFactor A τ ^ n := by
  rw [zpow_mul, J.sq_sq A hA τ]

/-- **`Γ`-modularity of a family of super-VOA characters, with a half-integral automorphy
factor.**  For `v` of weight `m/2` (`m : ℤ` — this is exactly where half-integer weights enter)
and every `A ∈ Γ`:
`χ_i(v; Aτ) = (cτ+d)^{m/2} · Σ_j ρ(A)_{ij} χ_j(v; τ)`,
the fractional power being `J.sq A τ ^ m`.

The weight is read off `W.grading`, the `ℂ`-valued conformal-weight grading of a
`SuperVertexOperatorAlgebra`.  *Caveat for whoever proves this*: Zhu's law is naturally stated in
the **square-bracket** grading `L[0]`, and the repo builds `Lsq` / `sqWeightSpace` only for
`VertexOperatorAlgebra`.  Porting the square-bracket grading to the super side is a prerequisite
of the programme; until then `W.grading` is the honest placeholder (the two agree to leading
order). -/
def SuperRealisesLawOn (W : SuperVertexOperatorAlgebra 𝒱) {ι : Type*} [Fintype ι]
    (Γ : Subgroup SL(2, ℤ)) (J : HalfAutFactor Γ)
    (χ : ι → 𝒱 → UpperHalfPlane → ℂ) (ρ : SL(2, ℤ) → ι → ι → ℂ) : Prop :=
  ∀ A ∈ Γ, ∀ (m : ℤ) (v : 𝒱), v ∈ W.grading ((m : ℂ) / 2) → ∀ (i : ι) (τ : UpperHalfPlane),
    χ i v (A • τ) = J.sq A τ ^ m * ∑ j, ρ A i j * χ j v τ

/-- **`Γ_θ`-modularity of a super-VOA character — the target of the programme.**

This is the statement a later proof should discharge for, e.g., the symplectic fermions
(`c = −2`) or a `βγ` system (the first genuine half-integer-weight instance): the one-point
functions of a finite family of modules over a `SuperVertexOperatorAlgebra` transform under the
theta group `⟨S, T²⟩` by a representation `ρ`, with the half-integral automorphy factor `J`.

Deliberately a `def`, not a theorem: no proof is claimed. -/
def IsGammaThetaModular (W : SuperVertexOperatorAlgebra 𝒱) {ι : Type*} [Fintype ι]
    (J : HalfAutFactor thetaGroup) (χ : ι → 𝒱 → UpperHalfPlane → ℂ)
    (ρ : SL(2, ℤ) → ι → ι → ℂ) : Prop :=
  SuperRealisesLawOn W thetaGroup J χ ρ

/-- The super law restricts to a smaller subgroup, exactly as in the bosonic case
(`RealisesLawOn.mono`), provided the two half-integral factors agree there. -/
theorem SuperRealisesLawOn.mono {W : SuperVertexOperatorAlgebra 𝒱} {ι : Type*} [Fintype ι]
    {Γ Γ' : Subgroup SL(2, ℤ)} (hle : Γ ≤ Γ') {J : HalfAutFactor Γ'} {J' : HalfAutFactor Γ}
    (hJ : ∀ A ∈ Γ, ∀ τ : UpperHalfPlane, J'.sq A τ = J.sq A τ)
    {χ : ι → 𝒱 → UpperHalfPlane → ℂ} {ρ : SL(2, ℤ) → ι → ι → ℂ}
    (hχ : SuperRealisesLawOn W Γ' J χ ρ) : SuperRealisesLawOn W Γ J' χ ρ := by
  intro A hA m v hv i τ
  rw [hJ A hA τ]
  exact hχ A (hle hA) m v hv i τ

end Super

end SlashSub

end VOA
