import VOA.Modules.ZhuVermaAnArchMUjacobi

/-!
# Closing the module Jacobi 5.3.1b for `M(U)` — the defect-quotient construction `M̄(U)`

The companion file `ZhuVermaAnArchMUjacobi` reduced the module Borcherds identity 5.3.1b
(`VHat.VHatRep.IsModuleJacobi`) to the **single residual** `ModuleIterate ρ` (the DLM3
associativity-defect relation, eqs 4.3–4.4): under the truncation/field property,
`IsModuleJacobi ρ ↔ ModuleIterate ρ` (`isModuleJacobi_iff_iterate`).

`ModuleIterate ρ` is **not** free for a generic `V̂`-representation `ρ` — the loop Lie algebra `V̂`
only sees commutators, never the iterate `u₍ℓ₎v` as a single mode. The honest induced module
`M(U) = U(V̂) ⊗_{U(P)} U` satisfies it only **modulo the defect relations**; the genuine module is
the *defect quotient*

`M̄(U) = M(U) / D`,  where `D` is the `V̂`-submodule generated by all iterate defects.

This file performs that construction **axiom-free, for an arbitrary `V̂`-representation** `ρ`, and
proves `ModuleIterate` holds on the quotient **by construction** — discharging `IsModuleJacobi` on
`M̄(U)` via the reduction `isModuleJacobi_of_iterate`. The mathematics is pure representation theory
of the Lie algebra `V̂`; no mode/residue identity is needed (the iterate content is *quotiented in*,
which is exactly the Frenkel–Zhu / Dong–Jiang construction of the generalized Verma module).

## What is built

* **`VHatRep.IsInvariant ρ D`** — `D : Submodule ℂ M` is a `V̂`-subrepresentation (`ρ x` maps `D`
  into `D` for every `x : V̂`).
* **`VHatRep.quotientRep ρ D hD : VHatRep W (M ⧸ D)`** — the quotient representation, a genuine
  Lie morphism `V̂ →ₗ⁅ℂ⁆ End ℂ (M ⧸ D)` via `Submodule.mapQ` (well-defined by invariance), with
  `actMode_quotientRep` (the mode action descends: `actMode a m (mk x) = mk (actMode a m x)`).
* **`VHatRep.defectVec ρ`** — the iterate-defect vector
  `δ(u,v,x,ℓ,N) = (u₍ℓ₎v)₍N₎ x − Σᶠ i (-1)ⁱC(ℓ,i)(u₍ℓ₋ᵢ₎(v₍N₊ᵢ₎x) − (-1)ℓ v₍ℓ₊N₋ᵢ₎(u₍ᵢ₎x))`
  (the LHS − RHS of `ModuleIterate`), and **`defectSet`/`defectSubmodule ρ`** — the smallest
  `V̂`-invariant submodule containing every defect vector (`sInf` of invariant submodules;
  invariant and defect-containing by `defectSubmodule_invariant` / `defectVec_mem_defectSubmodule`).
* **`VHatRep.moduleIterate_quotientRep`** — `ModuleIterate` holds for the quotient representation
  `M̄(U) = M ⧸ defectSubmodule ρ`, because each quotient defect is `mk` of an `M`-defect, which lies
  in `defectSubmodule ρ`, hence is `0` in the quotient.
* **`VHatRep.isModuleJacobi_quotientRep`** — therefore, given truncation on `M̄(U)`,
  `IsModuleJacobi` holds for the defect quotient (via `isModuleJacobi_of_iterate`). This is the
  genuine closure of 5.3.1b for `M̄(U)`.

The truncation property of the quotient is inherited from `M` (`ActModeTruncated` descends through
`mkQ`: `actMode_quotientRep_truncated`), so it is supplied from the source module's truncation.

Everything is `#print axioms`-clean (`[propext, Classical.choice, Quot.sound]`).

## References
DLM3 §4 (eqs 4.3–4.4); Frenkel–Zhu; Dong–Jiang `math/0601626`; Gannon §5.3.2, Thm 5.3.4;
`Core.Borcherds`; the reduction `ZhuVermaAnArchMUjacobi.isModuleJacobi_iff_iterate`.
-/

namespace VOA

open VertexOperatorAlgebra
open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

namespace VHat
namespace VHatRep

variable {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]

/-! ## `V̂`-subrepresentations -/

/-- `D` is a **`V̂`-subrepresentation**: every `ρ x` maps `D` into `D`. This is the invariance
condition under which the action descends to the quotient `M ⧸ D`. -/
def IsInvariant (ρ : VHatRep W M) (D : Submodule ℂ M) : Prop :=
  ∀ (x : VHatCarrier W) (d : M), d ∈ D → ρ x d ∈ D

/-- The trivial top submodule is invariant. -/
theorem isInvariant_top (ρ : VHatRep W M) : IsInvariant ρ (⊤ : Submodule ℂ M) :=
  fun _ _ _ => Submodule.mem_top

/-- An arbitrary intersection (`sInf`) of invariant submodules is invariant. -/
theorem isInvariant_sInf (ρ : VHatRep W M) (S : Set (Submodule ℂ M))
    (hS : ∀ D ∈ S, IsInvariant ρ D) : IsInvariant ρ (sInf S) := by
  intro x d hd
  rw [Submodule.mem_sInf] at hd ⊢
  intro D' hD'
  exact hS D' hD' x d (hd D' hD')

/-! ## The quotient representation `M ⧸ D` -/

/-- The mode `ρ x` descends to `M ⧸ D` (via `Submodule.mapQ`) when `D` is invariant. -/
noncomputable def quotientEnd (ρ : VHatRep W M) (D : Submodule ℂ M) (hD : IsInvariant ρ D)
    (x : VHatCarrier W) : Module.End ℂ (M ⧸ D) :=
  D.mapQ D (ρ x) (fun d hd => hD x d hd)

@[simp] theorem quotientEnd_mk (ρ : VHatRep W M) (D : Submodule ℂ M) (hD : IsInvariant ρ D)
    (x : VHatCarrier W) (m : M) :
    quotientEnd ρ D hD x (Submodule.Quotient.mk m) = Submodule.Quotient.mk (ρ x m) :=
  Submodule.mapQ_apply _ _ _ m

/-- **The quotient representation** `ρ̄ : V̂ →ₗ⁅ℂ⁆ End ℂ (M ⧸ D)` for an invariant `D`. The linear
structure is `Submodule.mapQ`; `map_lie'` holds because `mkQ` intertwines the action, so the
commutator on `M ⧸ D` is the image of the commutator on `M`, and `ρ` is already a Lie morphism. -/
noncomputable def quotientRep (ρ : VHatRep W M) (D : Submodule ℂ M) (hD : IsInvariant ρ D) :
    VHatRep W (M ⧸ D) where
  toFun := quotientEnd ρ D hD
  map_add' x y := by
    refine LinearMap.ext (fun m => ?_)
    induction m using Submodule.Quotient.induction_on with
    | _ a =>
      simp only [quotientEnd_mk, LinearMap.add_apply, map_add, Submodule.Quotient.mk_add]
  map_smul' c x := by
    refine LinearMap.ext (fun m => ?_)
    induction m using Submodule.Quotient.induction_on with
    | _ a =>
      simp only [quotientEnd_mk, LinearMap.smul_apply, map_smul, RingHom.id_apply,
        Submodule.Quotient.mk_smul]
  map_lie' {x y} := by
    refine LinearMap.ext (fun m => ?_)
    induction m using Submodule.Quotient.induction_on with
    | _ a =>
      -- both sides applied to `mk a`: reduce to the `M`-bracket via `mkQ` intertwining.
      rw [Ring.lie_def, LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply]
      simp only [quotientEnd_mk]
      congr 1
      rw [ρ.map_lie x y, Ring.lie_def, LinearMap.sub_apply, Module.End.mul_apply,
        Module.End.mul_apply]

@[simp] theorem quotientRep_mk (ρ : VHatRep W M) (D : Submodule ℂ M) (hD : IsInvariant ρ D)
    (x : VHatCarrier W) (m : M) :
    quotientRep ρ D hD x (Submodule.Quotient.mk m) = Submodule.Quotient.mk (ρ x m) :=
  quotientEnd_mk ρ D hD x m

/-- **The mode action descends**: `actMode a p (mk x) = mk (actMode a p x)` on `M ⧸ D`. -/
@[simp] theorem actMode_quotientRep (ρ : VHatRep W M) (D : Submodule ℂ M) (hD : IsInvariant ρ D)
    (a : 𝒱) (p : ℤ) (m : M) :
    (quotientRep ρ D hD).actMode a p (Submodule.Quotient.mk m)
      = Submodule.Quotient.mk (ρ.actMode a p m) := by
  rw [actMode_def, actMode_def, quotientRep_mk]

/-- **Truncation descends** through `mkQ`: if `ρ` is `ActModeTruncated`, so is `quotientRep ρ D`. -/
theorem actMode_quotientRep_truncated (ρ : VHatRep W M) (D : Submodule ℂ M) (hD : IsInvariant ρ D)
    (htr : ActModeTruncated ρ) : ActModeTruncated (quotientRep ρ D hD) := by
  intro a y
  refine Submodule.Quotient.induction_on _ y (fun x => ?_)
  obtain ⟨N, hN⟩ := htr a x
  refine ⟨N, fun p hp => ?_⟩
  rw [actMode_quotientRep, hN p hp, Submodule.Quotient.mk_zero]

/-! ## The iterate-defect vector and the defect submodule -/

/-- **The iterate-defect vector** `δ(u,v,x,ℓ,N)` — the LHS − RHS of the `ModuleIterate` identity at
`(u,v,x,ℓ,N)`. `ModuleIterate ρ` is exactly `δ(u,v,x,ℓ,N) = 0` for all arguments. -/
noncomputable def defectVec (ρ : VHatRep W M) (u v : 𝒱) (x : M) (ℓ N : ℤ) : M :=
  ρ.actMode (W.smul u ℓ v) N x
    - ∑ᶠ i : ℤ, (negOnePow i * cbz ℓ i) •
        (ρ.actMode u (ℓ - i) (ρ.actMode v (N + i) x)
          - negOnePow ℓ • ρ.actMode v (ℓ + N - i) (ρ.actMode u i x))

/-- `ModuleIterate ρ` is precisely the vanishing of every defect vector. -/
theorem moduleIterate_iff_defectVec_zero (ρ : VHatRep W M) :
    ModuleIterate ρ ↔ ∀ (u v : 𝒱) (x : M) (ℓ N : ℤ), defectVec ρ u v x ℓ N = 0 := by
  constructor
  · intro h u v x ℓ N
    rw [defectVec, h u v x ℓ N, sub_self]
  · intro h u v x ℓ N
    have := h u v x ℓ N
    rw [defectVec, sub_eq_zero] at this
    exact this

/-- **The defect set** of `ρ` — all iterate-defect vectors. -/
def defectSet (ρ : VHatRep W M) : Set M :=
  {y | ∃ (u v : 𝒱) (x : M) (ℓ N : ℤ), y = defectVec ρ u v x ℓ N}

/-- **The defect submodule** `D` — the smallest `V̂`-invariant submodule containing every iterate
defect (`sInf` of all invariant submodules that contain the defect set). The defect quotient is
`M̄(U) = M ⧸ defectSubmodule ρ`. -/
noncomputable def defectSubmodule (ρ : VHatRep W M) : Submodule ℂ M :=
  sInf {D : Submodule ℂ M | defectSet ρ ⊆ ↑D ∧ IsInvariant ρ D}

/-- The defect submodule is `V̂`-invariant (`sInf` of invariant submodules). -/
theorem defectSubmodule_invariant (ρ : VHatRep W M) : IsInvariant ρ (defectSubmodule ρ) := by
  apply isInvariant_sInf
  intro D hD
  exact hD.2

/-- The defect submodule contains every defect vector. -/
theorem defectVec_mem_defectSubmodule (ρ : VHatRep W M) (u v : 𝒱) (x : M) (ℓ N : ℤ) :
    defectVec ρ u v x ℓ N ∈ defectSubmodule ρ := by
  rw [defectSubmodule, Submodule.mem_sInf]
  intro D hD
  exact hD.1 ⟨u, v, x, ℓ, N, rfl⟩

/-! ## `ModuleIterate` holds on the defect quotient -/

/-- The defect vector of the **quotient** representation at `(u,v, mk x, ℓ, N)` is `mk` of the
defect vector of `ρ` at `(u,v,x,ℓ,N)`. (`mkQ` is a linear intertwiner commuting with the finite
defect `finsum`.) -/
theorem defectVec_quotientRep_mk (ρ : VHatRep W M) (D : Submodule ℂ M) (hD : IsInvariant ρ D)
    (htr : ActModeTruncated ρ) (u v : 𝒱) (x : M) (ℓ N : ℤ) :
    defectVec (quotientRep ρ D hD) u v (Submodule.Quotient.mk x) ℓ N
      = Submodule.Quotient.mk (defectVec ρ u v x ℓ N) := by
  -- the defect `finsum` for `quotientRep` is `mkQ` of the defect `finsum` for `ρ`.
  -- finiteness of the underlying summand families on `M` (truncation).
  obtain ⟨Nv, hNv⟩ := htr v x
  obtain ⟨Nu, hNu⟩ := htr u x
  -- the summand of the quotient defect equals `mkQ` of the `M` summand, pointwise in `i`.
  have hsummand : ∀ i : ℤ,
      (negOnePow i * cbz ℓ i) •
        ((quotientRep ρ D hD).actMode u (ℓ - i)
              ((quotientRep ρ D hD).actMode v (N + i) (Submodule.Quotient.mk x))
          - negOnePow ℓ • (quotientRep ρ D hD).actMode v (ℓ + N - i)
              ((quotientRep ρ D hD).actMode u i (Submodule.Quotient.mk x)))
      = Submodule.Quotient.mk ((negOnePow i * cbz ℓ i) •
          (ρ.actMode u (ℓ - i) (ρ.actMode v (N + i) x)
            - negOnePow ℓ • ρ.actMode v (ℓ + N - i) (ρ.actMode u i x))) := by
    intro i
    simp only [actMode_quotientRep, Submodule.Quotient.mk_smul, Submodule.Quotient.mk_sub]
  -- the linear map `mkQ : M →ₗ M ⧸ D`.
  let q : M →ₗ[ℂ] (M ⧸ D) := D.mkQ
  have hq : ∀ m : M, q m = Submodule.Quotient.mk m := fun _ => rfl
  -- finite support of the `M`-summand family (`cbz ℓ i` kills `i<0`; truncation kills large `i`:
  -- the first composite needs `N+i < Nv`, the second needs `i < Nu`).
  have hfinM : (Function.support fun i : ℤ =>
      (negOnePow i * cbz ℓ i) •
        (ρ.actMode u (ℓ - i) (ρ.actMode v (N + i) x)
          - negOnePow ℓ • ρ.actMode v (ℓ + N - i) (ρ.actMode u i x))).Finite := by
    apply Set.Finite.subset (Set.finite_Icc 0 (max (Nv - N) Nu))
    intro i hi
    rw [Function.mem_support] at hi; rw [Set.mem_Icc]
    refine ⟨not_lt.mp fun h => hi ?_, not_lt.mp fun h => hi ?_⟩
    · rw [cbz_apply_neg ℓ h, mul_zero, zero_smul]
    · -- `i > max (Nv-N) Nu`: both composites vanish.
      rw [hNv (N + i) (by omega), map_zero, hNu i (by omega), map_zero]
      simp
  -- push `mkQ` through the finite defect `finsum`.
  rw [defectVec, defectVec]
  rw [show (∑ᶠ i : ℤ, (negOnePow i * cbz ℓ i) •
          ((quotientRep ρ D hD).actMode u (ℓ - i)
                ((quotientRep ρ D hD).actMode v (N + i) (Submodule.Quotient.mk x))
            - negOnePow ℓ • (quotientRep ρ D hD).actMode v (ℓ + N - i)
                ((quotientRep ρ D hD).actMode u i (Submodule.Quotient.mk x))))
        = ∑ᶠ i : ℤ, q ((negOnePow i * cbz ℓ i) •
            (ρ.actMode u (ℓ - i) (ρ.actMode v (N + i) x)
              - negOnePow ℓ • ρ.actMode v (ℓ + N - i) (ρ.actMode u i x)))
      from finsum_congr fun i => by rw [hq]; exact hsummand i,
    ← map_finsum q hfinM, hq, actMode_quotientRep, ← Submodule.Quotient.mk_sub]

/-- **`ModuleIterate` holds on the defect quotient** `M̄(U) = M ⧸ defectSubmodule ρ`. Each quotient
defect is `mk` of an `M`-defect, and every `M`-defect lies in `defectSubmodule ρ` (by construction),
so it vanishes in the quotient. This is the closure of the genuine residual: the iterate content is
*quotiented in*, exactly the Frenkel–Zhu / Dong–Jiang generalized-Verma construction. -/
theorem moduleIterate_quotientRep (ρ : VHatRep W M) (htr : ActModeTruncated ρ) :
    ModuleIterate (quotientRep ρ (defectSubmodule ρ) (defectSubmodule_invariant ρ)) := by
  rw [moduleIterate_iff_defectVec_zero]
  intro u v y ℓ N
  refine Submodule.Quotient.induction_on _ y (fun x => ?_)
  rw [defectVec_quotientRep_mk ρ (defectSubmodule ρ) (defectSubmodule_invariant ρ) htr,
    Submodule.Quotient.mk_eq_zero]
  exact defectVec_mem_defectSubmodule ρ u v x ℓ N

/-! ## `IsModuleJacobi` on the defect quotient — the closure of 5.3.1b for `M̄(U)` -/

/-- **`IsModuleJacobi` holds on the defect quotient** `M̄(U) = M ⧸ defectSubmodule ρ`. Combining
`moduleIterate_quotientRep` (the residual, true by construction) with the reduction
`isModuleJacobi_of_iterate` (the module Borcherds from the residual + locality) discharges the
module Jacobi 5.3.1b for the genuine induced module. The truncation hypothesis is the one on `M`,
inherited by the quotient (`actMode_quotientRep_truncated`). -/
theorem isModuleJacobi_quotientRep (ρ : VHatRep W M) (htr : ActModeTruncated ρ) :
    (quotientRep ρ (defectSubmodule ρ) (defectSubmodule_invariant ρ)).IsModuleJacobi :=
  isModuleJacobi_of_iterate _
    (actMode_quotientRep_truncated ρ (defectSubmodule ρ) (defectSubmodule_invariant ρ) htr)
    (moduleIterate_quotientRep ρ htr)

end VHatRep
end VHat

end VOA

