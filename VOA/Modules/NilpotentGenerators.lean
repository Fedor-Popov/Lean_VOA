/-!
# Finitely many nilpotent generators ⟹ finite dimensional

The **pure commutative-algebra engine** behind the nilpotency route to `C₂`-cofiniteness
(Arakawa–Kawasetsu Prop. 3.3; the project lead's strategy for the triplet `W(2)`).  Nothing in
this file mentions vertex algebras: it is the statement

> a commutative algebra generated by finitely many **nilpotent** elements is
> **finite-dimensional**, of dimension at most `∏ᵢ mᵢ` where `gᵢ ^ mᵢ = 0`.

The intended consumer is the Poisson algebra `A₂(𝒱) = 𝒱 ⧸ O₂(𝒱)` of `Modules.C2Cofinite`,
whose product is `poissonMul W u v = u₍₋₁₎v` and which is commutative mod `O₂`
(`poissonMul_sub_swap_mem_O₂`).  Feeding in the four strong generators `ω, W⁺, W⁰, W⁻` of the
triplet, together with an explicit nilpotency exponent for **each one in `A₂(V⁺)` itself**,
yields `C2Cofinite` immediately via `finiteDimensional_of_four_isNilpotent`.

## Main results

* `isIntegral_of_isNilpotent` — a nilpotent element is integral (`xᵐ = 0` is a monic relation).
  This is the whole trick: it reduces the theorem to Mathlib's integral-closure machinery.
* `module_finite_of_isNilpotent_of_adjoin_eq_top` — if `Algebra.adjoin R s = ⊤` for a **finite**
  set `s` of nilpotents, then `Module.Finite R A`.
* `finiteDimensional_of_isNilpotent` / `finiteDimensional_of_range_isNilpotent` — the same over
  a field, phrased as `FiniteDimensional K A` (the shape `C2Cofinite` is stated in).
* `span_nilMono_eq_top` — the **spanning-set form**: `A` is spanned as a `K`-module (indeed as
  an `R`-module) by the *bounded* monomials `∏ᵢ gᵢ ^ eᵢ` with `eᵢ < mᵢ`.  This is the constructive
  content and does **not** go through integrality.
* `finrank_le_prod` — hence `finrank K A ≤ ∏ᵢ mᵢ`.
* `finiteDimensional_of_four_isNilpotent`, `finrank_le_of_four` — the `n = 4` convenience
  wrappers, the shape the triplet `W(2)` needs (`ω, W⁺, W⁰, W⁻`).

## What Mathlib already had

Almost everything.  The finite-dimensionality half is genuinely three lines of Mathlib:

* `IsIntegral.of_pow` + `isIntegral_zero`  (`Mathlib/RingTheory/IntegralClosure/IsIntegral/Basic`)
  give nilpotent ⟹ integral;  Mathlib has **no** `IsNilpotent.isIntegral`, so we add it.
* `Algebra.finite_adjoin_of_finite_of_isIntegral`
  (`Mathlib/RingTheory/IntegralClosure/IsIntegral/Basic`, line 226) gives
  `Module.Finite R (Algebra.adjoin R s)` for finite `s` of integral elements — exactly our
  statement once `adjoin R s = ⊤`.  (`Algebra.IsIntegral.finite` is the `FiniteType` phrasing.)

The **explicit monomial spanning set with bounded exponents** and the bound `∏ᵢ mᵢ` are *not* in
Mathlib in any form we could find, and are proved here from scratch (`Submodule.toSubalgebra` +
`Submodule.span_mul_span` + `Algebra.adjoin_le`).

## Status

`sorry`-free, no project axioms (`[propext, Classical.choice, Quot.sound]` only).
Pure commutative algebra — no vertex-algebra input, no dependence on the rest of the repo.

## References
* Arakawa–Kawasetsu, *Quasi-lisse vertex algebras and modular linear differential equations*,
  Prop. 3.3 (`[ω]` is nilpotent in `R_V`).
* Gannon §5.3.2 (the Poisson algebra `A₂(𝒱)` this feeds).
-/

namespace VOA.NilpotentGenerators

open scoped BigOperators

/-! ## Nilpotent ⟹ integral -/

section Integral

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- **A nilpotent element is integral.**  If `x ^ n = 0` then `x` satisfies the monic polynomial
`Xⁿ⁺¹`, so `x` is integral over any base ring.  (Mathlib has `IsIntegral.of_pow` and
`isIntegral_zero` but not this combination.) -/
theorem isIntegral_of_isNilpotent {x : A} (hx : IsNilpotent x) : IsIntegral R x := by
  obtain ⟨n, hn⟩ := hx
  refine IsIntegral.of_pow (n := n + 1) (Nat.succ_pos n) ?_
  rw [pow_succ, hn, zero_mul]
  exact isIntegral_zero

/-- Explicit-exponent form of `isIntegral_of_isNilpotent`: `x ^ m = 0` implies `x` integral. -/
theorem isIntegral_of_pow_eq_zero {x : A} {m : ℕ} (hx : x ^ m = 0) : IsIntegral R x :=
  isIntegral_of_isNilpotent ⟨m, hx⟩

end Integral

/-! ## Finiteness from finitely many nilpotent generators -/

section Finite

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- **The engine.**  A commutative `R`-algebra `A` generated by a *finite* set `s` of
**nilpotent** elements is a finite `R`-module.

Proof: nilpotent ⟹ integral (`isIntegral_of_isNilpotent`), then Mathlib's
`Algebra.finite_adjoin_of_finite_of_isIntegral`, transported along `adjoin R s = ⊤`. -/
theorem module_finite_of_isNilpotent_of_adjoin_eq_top {s : Set A} (hs : s.Finite)
    (hnil : ∀ x ∈ s, IsNilpotent x) (htop : Algebra.adjoin R s = ⊤) :
    Module.Finite R A := by
  have h : Module.Finite R (Algebra.adjoin R s) :=
    Algebra.finite_adjoin_of_finite_of_isIntegral hs
      (fun x hx => isIntegral_of_isNilpotent (hnil x hx))
  rw [htop] at h
  haveI := h
  exact Module.Finite.equiv (Subalgebra.topEquiv.toLinearEquiv)

/-- Indexed-family form of `module_finite_of_isNilpotent_of_adjoin_eq_top`: finitely many
nilpotent generators `g : ι → A` with `Algebra.adjoin R (Set.range g) = ⊤`. -/
theorem module_finite_of_range_isNilpotent {ι : Type*} [Finite ι] (g : ι → A)
    (hnil : ∀ i, IsNilpotent (g i)) (htop : Algebra.adjoin R (Set.range g) = ⊤) :
    Module.Finite R A :=
  module_finite_of_isNilpotent_of_adjoin_eq_top (Set.finite_range g)
    (by rintro _ ⟨i, rfl⟩; exact hnil i) htop

end Finite

section FiniteDimensional

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A]

/-- **Over a field**: a commutative `K`-algebra generated by a finite set of nilpotents is
finite-dimensional.  This is the exact shape of `VOA.C2Cofinite`. -/
theorem finiteDimensional_of_isNilpotent {s : Set A} (hs : s.Finite)
    (hnil : ∀ x ∈ s, IsNilpotent x) (htop : Algebra.adjoin K s = ⊤) :
    FiniteDimensional K A :=
  module_finite_of_isNilpotent_of_adjoin_eq_top hs hnil htop

/-- Indexed-family form of `finiteDimensional_of_isNilpotent`. -/
theorem finiteDimensional_of_range_isNilpotent {ι : Type*} [Finite ι] (g : ι → A)
    (hnil : ∀ i, IsNilpotent (g i)) (htop : Algebra.adjoin K (Set.range g) = ⊤) :
    FiniteDimensional K A :=
  module_finite_of_range_isNilpotent g hnil htop

end FiniteDimensional

/-! ## The explicit monomial spanning set

The constructive half, which the VOA application actually consumes: `A` is spanned by the
monomials `∏ᵢ gᵢ ^ eᵢ` with **bounded** exponents `eᵢ < mᵢ`.  This route does not use
integrality at all — it is the elementary "reduce every monomial modulo `gᵢ ^ mᵢ = 0`" argument,
and it is what gives the numerical bound `dim ≤ ∏ᵢ mᵢ`. -/

section Monomials

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
variable {ι : Type*} [Fintype ι]

/-- The monomial `∏ᵢ (gᵢ) ^ (eᵢ)` in the generators `g`, with exponent vector `e`. -/
def nilMono (g : ι → A) (e : ι → ℕ) : A := ∏ i, g i ^ e i

/-- The monomials with exponents **bounded** by `m`, indexed by `∀ i, Fin (mᵢ)`.  The index type
has cardinality `∏ᵢ mᵢ`, which is where the dimension bound comes from. -/
def nilMonoFin (g : ι → A) (m : ι → ℕ) (e : ∀ i, Fin (m i)) : A :=
  nilMono g fun i => (e i : ℕ)

/-- Monomials multiply by adding exponents. -/
theorem nilMono_mul (g : ι → A) (e f : ι → ℕ) :
    nilMono g e * nilMono g f = nilMono g fun i => e i + f i := by
  simp [nilMono, ← Finset.prod_mul_distrib, pow_add]

/-- `nilMono g 0 = 1`. -/
@[simp] theorem nilMono_zero (g : ι → A) : nilMono g 0 = 1 := by
  simp [nilMono]

/-- A monomial that **saturates** one of the nilpotency bounds vanishes: if `gᵢ ^ mᵢ = 0` and
`mᵢ ≤ eᵢ`, then `∏ⱼ gⱼ ^ eⱼ = 0`. -/
theorem nilMono_eq_zero (g : ι → A) {m e : ι → ℕ} {i : ι} (hi : m i ≤ e i)
    (h : g i ^ m i = 0) : nilMono g e = 0 := by
  refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
  rw [← Nat.add_sub_cancel' hi, pow_add, h, zero_mul]

/-- Every monomial in the generators, with *arbitrary* exponents, lies in the span of the
**bounded** ones: exponents at or above `mᵢ` make the monomial zero. -/
theorem nilMono_mem_span (g : ι → A) (m : ι → ℕ) (hm : ∀ i, g i ^ m i = 0) (e : ι → ℕ) :
    nilMono g e ∈ Submodule.span R (Set.range (nilMonoFin g m)) := by
  by_cases hb : ∀ i, e i < m i
  · have he : nilMono g e = nilMonoFin g m fun i => ⟨e i, hb i⟩ := rfl
    rw [he]
    exact Submodule.subset_span ⟨_, rfl⟩
  · simp only [not_forall, not_lt] at hb
    obtain ⟨i, hi⟩ := hb
    rw [nilMono_eq_zero g hi (hm i)]
    exact Submodule.zero_mem _

/-- Each generator is itself a bounded-exponent monomial (or zero), hence in the span. -/
theorem generator_mem_span (g : ι → A) (m : ι → ℕ) (hm : ∀ i, g i ^ m i = 0) (i : ι) :
    g i ∈ Submodule.span R (Set.range (nilMonoFin g m)) := by
  classical
  have hgi : nilMono g (fun j => if j = i then 1 else 0) = g i := by
    rw [nilMono,
      Finset.prod_eq_single i (fun j _ hj => by simp [hj]) fun h =>
        absurd (Finset.mem_univ i) h]
    simp
  rw [← hgi]
  exact nilMono_mem_span g m hm _

/-- **The spanning-set theorem.**  If the commutative `R`-algebra `A` is generated by
`g : ι → A` (`ι` finite) and `gᵢ ^ mᵢ = 0` for each `i`, then `A` is spanned as an `R`-module by
the `∏ᵢ mᵢ` monomials `∏ᵢ gᵢ ^ eᵢ` with `eᵢ < mᵢ`.

The proof shows directly that this span is a subalgebra: it contains `1` (the empty monomial), is
closed under multiplication (monomials multiply by adding exponents, and any exponent reaching
`mᵢ` kills the product), and contains every generator — so it contains `Algebra.adjoin R (range g)
= ⊤`.  No integrality, no Noetherian input. -/
theorem span_nilMono_eq_top (g : ι → A) (m : ι → ℕ) (hm : ∀ i, g i ^ m i = 0)
    (htop : Algebra.adjoin R (Set.range g) = ⊤) :
    Submodule.span R (Set.range (nilMonoFin g m)) = ⊤ := by
  set S : Submodule R A := Submodule.span R (Set.range (nilMonoFin g m)) with hS
  have hmem : ∀ e : ι → ℕ, nilMono g e ∈ S := nilMono_mem_span g m hm
  have h1 : (1 : A) ∈ S := by
    have := hmem 0
    rwa [nilMono_zero] at this
  have hmul : ∀ x y : A, x ∈ S → y ∈ S → x * y ∈ S := by
    have key : S * S ≤ S := by
      rw [hS, Submodule.span_mul_span, Submodule.span_le]
      intro x hx
      simp only [Set.mem_mul, Set.mem_range] at hx
      obtain ⟨_, ⟨e, rfl⟩, _, ⟨f, rfl⟩, rfl⟩ := hx
      simp only [nilMonoFin, nilMono_mul, SetLike.mem_coe]
      exact hmem _
    intro x y hx hy
    exact key (Submodule.mul_mem_mul hx hy)
  have hgen : Set.range g ⊆ (S.toSubalgebra h1 hmul : Set A) := by
    rintro _ ⟨i, rfl⟩
    simpa only [SetLike.mem_coe, Submodule.mem_toSubalgebra] using
      generator_mem_span g m hm i
  have hle : (⊤ : Subalgebra R A) ≤ S.toSubalgebra h1 hmul := by
    rw [← htop]
    exact Algebra.adjoin_le hgen
  refine Submodule.eq_top_iff'.2 fun x => ?_
  simpa only [Submodule.mem_toSubalgebra] using hle (Algebra.mem_top (x := x))

end Monomials

/-! ## The dimension bound `∏ᵢ mᵢ` -/

section Bound

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A]

/-- **The dimension bound.**  With `n` nilpotent generators of nilpotency exponents `mᵢ`
generating `A`, `dim_K A ≤ ∏ᵢ mᵢ`. -/
theorem finrank_le_prod {ι : Type*} [Fintype ι] (g : ι → A) (m : ι → ℕ)
    (hm : ∀ i, g i ^ m i = 0) (htop : Algebra.adjoin K (Set.range g) = ⊤) :
    Module.finrank K A ≤ ∏ i, m i := by
  classical
  have h := finrank_le_of_span_eq_top (R := K) (span_nilMono_eq_top g m hm htop)
  simpa [Fintype.card_pi] using h

/-- The exponent-vector form of `finiteDimensional_of_range_isNilpotent`, obtained from the
spanning set rather than from integrality. -/
theorem finiteDimensional_of_pow_eq_zero {ι : Type*} [Finite ι] (g : ι → A) (m : ι → ℕ)
    (hm : ∀ i, g i ^ m i = 0) (htop : Algebra.adjoin K (Set.range g) = ⊤) :
    FiniteDimensional K A :=
  finiteDimensional_of_range_isNilpotent g (fun i => ⟨m i, hm i⟩) htop

end Bound

/-! ## The `n = 4` wrappers — the shape the triplet `W(2)` needs

`ω, W⁺, W⁰, W⁻` are the four strong generators of the triplet algebra.  ⚠ The nilpotency
hypotheses below must be verified **in the algebra `A` one is actually working in** — for the
triplet that means `A₂(V⁺)` computed with `V⁺`'s own vertex operators, *not* the ambient
symplectic-fermion `A₂(V)`; the natural map `A₂(V⁺) → A₂(V)` need not be injective. -/

section Four

variable {K A : Type*} [Field K] [CommRing A] [Algebra K A]

/-- **Four nilpotent generators.**  If `a, b, c, d` are nilpotent and generate the commutative
`K`-algebra `A`, then `A` is finite-dimensional. -/
theorem finiteDimensional_of_four_isNilpotent (a b c d : A) (ha : IsNilpotent a)
    (hb : IsNilpotent b) (hc : IsNilpotent c) (hd : IsNilpotent d)
    (htop : Algebra.adjoin K ({a, b, c, d} : Set A) = ⊤) :
    FiniteDimensional K A := by
  refine finiteDimensional_of_isNilpotent (Set.toFinite _) ?_ htop
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl | rfl <;> assumption

/-- **Four nilpotent generators, with the explicit bound.**  If `a ^ p = b ^ q = c ^ r =
d ^ s = 0` and `a, b, c, d` generate `A`, then `dim_K A ≤ p * q * r * s`. -/
theorem finrank_le_of_four (a b c d : A) (p q r s : ℕ) (ha : a ^ p = 0) (hb : b ^ q = 0)
    (hc : c ^ r = 0) (hd : d ^ s = 0)
    (htop : Algebra.adjoin K ({a, b, c, d} : Set A) = ⊤) :
    Module.finrank K A ≤ p * q * r * s := by
  have hrange : Set.range ![a, b, c, d] = ({a, b, c, d} : Set A) := by
    ext x
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · rintro (rfl | rfl | rfl | rfl)
      exacts [⟨0, by simp⟩, ⟨1, by simp⟩, ⟨2, by simp⟩, ⟨3, by simp⟩]
  have hm : ∀ i : Fin 4, (![a, b, c, d] i) ^ (![p, q, r, s] i) = 0 := by
    intro i
    fin_cases i
    · simpa using ha
    · simpa using hb
    · simpa using hc
    · simpa using hd
  have h := finrank_le_prod (K := K) ![a, b, c, d] ![p, q, r, s] hm (by rw [hrange]; exact htop)
  simpa [Fin.prod_univ_four, mul_assoc] using h

end Four

end VOA.NilpotentGenerators
