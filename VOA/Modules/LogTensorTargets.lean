import VOA.Modules.LogTensorAnnihilator
import VOA.Modules.LogVModule
import VOA.Modules.C2Cofinite

/-!
# Named targets of the logarithmic tensor-category programme — statements only

These are **named `Prop`s, not axioms and not proved**.  They fix the exact Lean statements of the
next steps of the logarithmic tensor-category construction, so that later work proves *these*
and nothing weaker.

* `FinGen N` — a weak module generated by finitely many vectors (for grading-restricted generalized
  modules of a `C₂`-cofinite VOA this is equivalent to finite length; not formalized here).
* `LogFusionFiniteFact W` — **finiteness of logarithmic fusion rules** (node T1d): for finitely
  generated logarithmic (grading-restricted generalized) modules `W₁, W₂, W₃`, the space of
  logarithmic intertwining operators of type `(W₃ / W₁ W₂)` is finite-dimensional.

*Truth.*  For `C₂`-cofinite `V` of CFT type (built into `VertexOperatorAlgebra` here) this is a
theorem of the literature: Huang, *Cofiniteness conditions, projective covers and the logarithmic
tensor product theory*, J. Pure Appl. Algebra 213 (2009), arXiv:0712.4109, §3 (finiteness of the
spaces of logarithmic intertwining operators among finitely generated modules), with
Miyamoto's `C₁`-cofiniteness of fusion products; alternatively via the Huang–Yang associative
algebras `A_N` (arXiv:1104.4679).  The global lower bound built into `LogVModule` only shrinks the
class of modules, so it makes the statement weaker, not false.  The intended theorem is
`C2Cofinite W → LogFusionFiniteFact W`, which is open.

*Not vacuous.*  For ordinary modules it specializes, through `LogTensor.ordEquiv`, to the FHL
fusion rules, which are positive in examples (`logModuleIntertwiner_ne_zero`).
-/

namespace VOA.LogTensor

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-- A weak module generated by finitely many vectors. -/
def FinGen {W : VertexOperatorAlgebra 𝒱} {M : Type*} [AddCommGroup M] [Module ℂ M]
    (A : WeakModule W M) : Prop :=
  ∃ S : Set M, S.Finite ∧ Generates A S

/-- **Target T1d (open)**: finiteness of logarithmic fusion rules among finitely generated
logarithmic modules.  Intended theorem: `C2Cofinite W → LogFusionFiniteFact W`. -/
def LogFusionFiniteFact (W : VertexOperatorAlgebra 𝒱) : Prop :=
  ∀ (M₁ M₂ M₃ : Type u) [AddCommGroup M₁] [Module ℂ M₁] [AddCommGroup M₂] [Module ℂ M₂]
    [AddCommGroup M₃] [Module ℂ M₃]
    (N₁ : LogVModule W M₁) (N₂ : LogVModule W M₂) (N₃ : LogVModule W M₃),
    FinGen N₁.toWeakModule → FinGen N₂.toWeakModule → FinGen N₃.toWeakModule →
      FiniteDimensional ℂ
        (LogIntertwiningOperator N₁.toWeakModule N₂.toWeakModule N₃.toWeakModule)

end VOA.LogTensor
