import VOA.Moonshine.HeisenbergTwistedModuleTwistedComm
import VOA.Core.LocalSystemRegular
import VOA.Core.Goddard

/-!
# Twisted associativity of twisted products  (Moonshine step M6)

For fields `A, B, C` in the twisted local system generated by a pairwise-local family and twists
`α, β ∈ ℂ`, the twisted products `star` of `HeisenbergTwistedModuleTwistedComm` satisfy the
**iterate formula** of an (untwisted) vertex algebra:

  `star (α+β) (star α A p B) q C
     = Σᶠ_i (−1)ⁱ C(p,i) · [star α A (p−i) (star β B (q+i) C)
                             − (−1)ᵖ star β B (p+q−i) (star α A i C)]`   (`star_iterate`).

This is the associativity half of Li's theorem that a twisted local system carries a vertex
algebra structure; the commutator half is `star_comm`.

## Proof
The state space is `TSt S = ℂ →₀ (TGenerated S)`: finitely supported families of fields of the
system indexed by their twist.  A state `a` acts by the twisted products,
`(stY a)₍ₚ₎ (single β X) = Σ_α single (α+β) (star α (a α) p X)`, which are fields
(`stY_isField`).  The twisted commutator formula `star_comm` makes `stY` of two single states
mutually local (`stY_local`); the identity field is a vacuum with the creation property; and the
divided powers of the twisted translation `Dα α = ∂ − α z⁻¹` satisfy a Leibniz rule against
twisted products (`star_D_iter`).  Goddard's uniqueness argument (`goddard_pt`, the pointwise
form of `goddard_zero`) then identifies the state field of `a₍ₚ₎b` with the field product of the
state fields, and the mode iterate formula `Fld.mode_prod_iterate` gives `star_iterate`.

Also: `star_deriv_left` — the twisted translation in the first slot,
`star α (∂A − α z⁻¹A) ℓ X = −ℓ · star α A (ℓ−1) X`.

## Status
All declarations `sorry`-free; `#print axioms` gives `[propext, Classical.choice, Quot.sound]`.
-/

namespace VOA

open Module (End)
open scoped BigOperators

universe u

namespace TwistedReduction

variable {M : Type u} [AddCommGroup M] [Module ℂ M]

/-! ## Pointwise Goddard uniqueness -/

/-- **Goddard uniqueness, pointwise** (the proof of `goddard_zero`, for one test vector). -/
theorem goddard_pt {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] (vac : 𝒱)
    (A G : FormalDist (End ℂ 𝒱)) (b : 𝒱) (hloc : Local A G) (hcre0 : G 0 vac = b)
    (hcreneg : ∀ q : ℤ, q < 0 → G q vac = 0) (hAvac : ∀ p : ℤ, A p vac = 0) (m : ℤ) :
    A m b = 0 := by
  obtain ⟨N, hN⟩ := hloc
  have hDeq : (fun p q : ℤ => A p (G q vac)) = applyVec vac (bracketDist A G) := by
    apply FormalDist₂.ext; intro p q
    show A p (G q vac) = applyVec vac (bracketDist A G) p q
    rw [applyVec_apply, bracketDist_apply, LinearMap.sub_apply, Module.End.mul_apply,
      Module.End.mul_apply, hAvac, map_zero, sub_zero]
  have hkill : mulBySubPow N (fun p q : ℤ => A p (G q vac)) = 0 := by
    rw [hDeq, ← applyVec_mulBySubPow, hN, applyVec_zero]
  have hbb : IsBddBelow₂ (fun p q : ℤ => A p (G q vac)) :=
    ⟨0, fun p q hq => by change A p (G q vac) = 0; rw [hcreneg q hq, map_zero]⟩
  have hD0 : (fun p q : ℤ => A p (G q vac)) = 0 :=
    eq_zero_of_mulBySubPow_of_bddBelow N _ hkill hbb
  have hfin := congrFun (congrFun hD0 m) 0
  change A m (G 0 vac) = 0 at hfin
  rw [hcre0] at hfin
  exact hfin

/-! ## Locality helpers -/

theorem local_sub_left {f g h : FormalDist (End ℂ M)} (hf : Local f h) (hg : Local g h) :
    Local (f - g) h := by
  rw [sub_eq_add_neg, show -g = (-1 : ℂ) • g by simp]
  exact VertexOperatorAlgebra.Local.add hf (VertexOperatorAlgebra.Local.smul' _ hg)

/-! ## The twisted translation -/

/-- The twisted translation `Dα α X = ∂X − α z⁻¹ X`. -/
noncomputable def Dα (α : ℂ) (X : Fld M) : Fld M := Fld.deriv X - α • fzmul (-1) X

theorem Dα_add (α : ℂ) (X Y : Fld M) : Dα α (X + Y) = Dα α X + Dα α Y := by
  simp only [Dα, fld_deriv_add, fzmul_add, smul_add]; abel

theorem Dα_smul (α c : ℂ) (X : Fld M) : Dα α (c • X) = c • Dα α X := by
  simp only [Dα, fld_deriv_smul, fzmul_smul, smul_sub]
  rw [smul_comm]

theorem Dα_mem {S : Set (Fld M)} (α : ℂ) {X : Fld M} (hX : X ∈ TGenerated S) :
    Dα α X ∈ TGenerated S := by
  have hd : Fld.deriv X = Fld.prod (-2) X Fld.one := by
    apply Subtype.ext
    rw [Fld.deriv_val, show (-2 : ℤ) = -((1 : ℕ) : ℤ) - 1 by norm_num, Fld.prod_one_right_negsucc]
    simp
  rw [Dα, hd]
  exact sub_mem_tgenerated (prod_mem_tgenerated _ hX (one_mem_tgenerated _))
    (smul_mem_tgenerated _ (fzmul_mem_tgenerated _ hX))

theorem Dα_iterate_mem {S : Set (Fld M)} (α : ℂ) {X : Fld M} (hX : X ∈ TGenerated S) (k : ℕ) :
    (Dα α)^[k] X ∈ TGenerated S := by
  induction k with
  | zero => exact hX
  | succ k ih => rw [Function.iterate_succ_apply']; exact Dα_mem α ih

/-- The vacuum products: `star α A (−k−1) 1 = (k!)⁻¹ · Dαᵏ A`. -/
theorem star_one_negsucc (α : ℂ) (A : Fld M) (k : ℕ) :
    star α A (-(k : ℤ) - 1) Fld.one = ((k.factorial : ℂ))⁻¹ • (Dα α)^[k] A := by
  induction k generalizing A with
  | zero => simp [star_one_right_neg_one]
  | succ k ih =>
      have h := star_deriv_one α A (-(k : ℤ) - 1)
      rw [show Fld.deriv A - α • fzmul (-1) A = Dα α A from rfl, ih,
        show -(k : ℤ) - 1 - 1 = -((k + 1 : ℕ) : ℤ) - 1 by push_cast; ring] at h
      have hk : (-((-(k : ℤ) - 1 : ℤ) : ℂ)) = (k : ℂ) + 1 := by push_cast; ring
      rw [hk] at h
      have hne : ((k : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero k
      rw [Function.iterate_succ_apply, Nat.factorial_succ]
      have h' := congrArg (fun Y => ((k : ℂ) + 1)⁻¹ • Y) h
      simp only [smul_smul, inv_mul_cancel₀ hne, one_smul] at h'
      rw [← h']
      congr 1
      push_cast
      rw [mul_inv]

/-- **The twisted translation against a twisted product** (Leibniz rule):
`Dα (α+β) (star α A q Y) = star α A q (Dα β Y) − q · star α A (q−1) Y`. -/
theorem Dα_star {A Y : Fld M} (h : Local A.1 Y.1) (α β : ℂ) (q : ℤ) :
    Dα (α + β) (star α A q Y) = star α A q (Dα β Y) - (q : ℂ) • star α A (q - 1) Y := by
  have hd : Local A.1 (Fld.deriv Y).1 := Local.derivR h
  have hz : Local A.1 (fzmul (-1) Y).1 := Local.zmul_right h (-1)
  have hsub : star α A q (Dα β Y)
      = star α A q (Fld.deriv Y) - β • fzmul (-1) (star α A q Y) := by
    rw [Dα, sub_eq_add_neg, star_add_right hd (by
        rw [show -(β • fzmul (-1) Y) = (-β) • fzmul (-1) Y by rw [neg_smul]]
        exact Reconstruction.Local.smulR (-β) hz),
      show -(β • fzmul (-1) Y) = (-β) • fzmul (-1) Y by rw [neg_smul],
      star_smul_right hz, star_fzmul_right, neg_smul, ← sub_eq_add_neg]
  rw [hsub, Dα, deriv_star h α q, add_smul]
  abel

/-- **Leibniz rule for divided twisted translations**:
`(K!)⁻¹ Dα(α+β)ᴷ (star α A p B) = Σ_{i ≤ K} (−1)ⁱ C(p,i) star α A (p−i) ((K−i)!⁻¹ Dα βᴷ⁻ⁱ B)`. -/
theorem star_D_iter {A B : Fld M} (hAB : ∀ j : ℕ, Local A.1 ((Dα β)^[j] B).1) (α : ℂ)
    (K : ℕ) (p : ℤ) :
    ((K.factorial : ℂ))⁻¹ • (Dα (α + β))^[K] (star α A p B)
      = ∑ i ∈ Finset.range (K + 1), ((-1 : ℂ) ^ i * gBinom p i) •
          star α A (p - i) ((((K - i).factorial : ℂ))⁻¹ • (Dα β)^[K - i] B) := by
  induction K generalizing p with
  | zero => simp
  | succ K ih =>
      set T : ℕ → Fld M := fun m => ((m.factorial : ℂ))⁻¹ • (Dα β)^[m] B with hT
      have hTloc : ∀ m, Local A.1 (T m).1 := fun m =>
        Reconstruction.Local.smulR _ (hAB m)
      have hDT : ∀ m : ℕ, Dα β (T m) = ((m : ℂ) + 1) • T (m + 1) := by
        intro m
        simp only [hT]
        rw [Dα_smul, ← Function.iterate_succ_apply' (Dα β), smul_smul, Nat.factorial_succ]
        congr 1
        have : (m.factorial : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero m
        have : ((m : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero m
        push_cast
        field_simp
      -- apply `Dα` to the induction hypothesis
      have hDlin : ∀ (s : Finset ℕ) (f : ℕ → Fld M),
          Dα (α + β) (∑ i ∈ s, f i) = ∑ i ∈ s, Dα (α + β) (f i) := by
        intro s f
        classical
        induction s using Finset.induction with
        | empty => simp [Dα, fld_deriv_zero, fzmul_zero]
        | insert a s ha ih' => rw [Finset.sum_insert ha, Finset.sum_insert ha, Dα_add, ih']
      have h1 := congrArg (Dα (α + β)) (ih p)
      rw [Dα_smul, ← Function.iterate_succ_apply' (Dα (α + β)), hDlin] at h1
      simp only [Dα_smul] at h1
      have hstep : ∀ i ∈ Finset.range (K + 1), ((-1 : ℂ) ^ i * gBinom p i) •
            Dα (α + β) (star α A (p - i) (T (K - i)))
          = ((-1 : ℂ) ^ i * gBinom p i * ((K - i : ℕ) + 1 : ℂ)) •
              star α A (p - i) (T (K + 1 - i))
            - ((-1 : ℂ) ^ i * gBinom p i * ((p - i : ℤ) : ℂ)) • star α A (p - i - 1) (T (K - i)) := by
        intro i hi
        rw [Finset.mem_range] at hi
        rw [Dα_star (hTloc _) α β, hDT, star_smul_right (hTloc _), smul_sub, smul_smul, smul_smul,
          show K - i + 1 = K + 1 - i by omega]
      rw [Finset.sum_congr rfl hstep, Finset.sum_sub_distrib] at h1
      -- reindex the second sum
      have hsecond : ∑ i ∈ Finset.range (K + 1), ((-1 : ℂ) ^ i * gBinom p i * ((p - i : ℤ) : ℂ)) •
            star α A (p - i - 1) (T (K - i))
          = ∑ j ∈ Finset.range (K + 2), (-(j : ℂ) * ((-1 : ℂ) ^ j * gBinom p j)) •
              star α A (p - j) (T (K + 1 - j)) := by
        rw [Finset.sum_range_succ' _ (K + 1)]
        simp only [Nat.cast_zero, neg_zero, zero_mul, zero_smul, add_zero]
        refine Finset.sum_congr rfl fun i hi => ?_
        rw [Finset.mem_range] at hi
        rw [show p - ((i + 1 : ℕ) : ℤ) = p - i - 1 by push_cast; ring,
          show K + 1 - (i + 1) = K - i by omega]
        congr 1
        have h2 := gBinom_mul_sub p i
        have h3 := gBinom_succ_mul p i
        push_cast
        rw [pow_succ]
        linear_combination ((-1 : ℂ) ^ i) * (h2 - h3)
      have hfirst : ∑ i ∈ Finset.range (K + 1), ((-1 : ℂ) ^ i * gBinom p i * ((K - i : ℕ) + 1 : ℂ))
            • star α A (p - i) (T (K + 1 - i))
          = ∑ j ∈ Finset.range (K + 2), (((K + 1 - j : ℕ) : ℂ) * ((-1 : ℂ) ^ j * gBinom p j)) •
              star α A (p - j) (T (K + 1 - j)) := by
        rw [Finset.sum_range_succ _ (K + 1)]
        simp only [Nat.sub_self, Nat.cast_zero, zero_mul, zero_smul, add_zero]
        refine Finset.sum_congr rfl fun i hi => ?_
        rw [Finset.mem_range] at hi
        congr 1
        rw [show K + 1 - i = (K - i) + 1 by omega]
        push_cast
        ring
      rw [hsecond, hfirst, ← Finset.sum_sub_distrib] at h1
      have hK1 : ((K + 1 : ℕ) : ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero K
      have h1' : ((K + 1 : ℕ) : ℂ) • (((K + 1).factorial : ℂ))⁻¹ •
            (Dα (α + β))^[K + 1] (star α A p B)
          = ((K + 1 : ℕ) : ℂ) • ∑ j ∈ Finset.range (K + 2), ((-1 : ℂ) ^ j * gBinom p j) •
              star α A (p - j) (T (K + 1 - j)) := by
        rw [smul_smul, Nat.factorial_succ, Nat.cast_mul, mul_inv, ← mul_assoc,
          mul_inv_cancel₀ hK1, one_mul, h1, Finset.smul_sum]
        refine Finset.sum_congr rfl fun j hj => ?_
        rw [Finset.mem_range] at hj
        rw [← sub_smul, smul_smul]
        congr 1
        rw [show K + 1 - j = K + 1 - j from rfl]
        push_cast [Nat.cast_sub (show j ≤ K + 1 by omega)]
        ring
      exact smul_right_injective _ hK1 h1'

/-- **The twisted translation in the first slot**:
`star α (∂A − α z⁻¹A) ℓ X = −ℓ · star α A (ℓ−1) X` (the case `X = 1` is `star_deriv_one`). -/
theorem star_deriv_left {A X : Fld M} (hloc : Local A.1 X.1) (α : ℂ) (n : ℤ) :
    star α (Dα α A) n X = (-n : ℂ) • star α A (n - 1) X := by
  obtain ⟨K0, hK0⟩ := exists_prod_offset_zero hloc (n - 1)
  set K := K0 + 1 with hKdef
  set a : ℕ → Fld M := fun J => Fld.prod (n - 1 + J) A X with ha
  have hav : ∀ J : ℕ, K ≤ J → a J = 0 := fun J hJ => hK0 J (by omega)
  have hD : ∀ i : ℕ, Fld.prod (n + i) (Dα α A) X
      = (-((n + i : ℤ) : ℂ)) • a i - α • ∑ t ∈ Finset.range K,
          gBinom (-1) t • fzmul (-1 - t) (a (i + t + 1)) := by
    intro i
    rw [Dα, prod_sub_left, Fld.prod_smul_left, prod_deriv_left,
      prod_fzmul_left hloc (-1) (n + i) K (fun t ht => by
        rw [show n + (i : ℤ) + t = n - 1 + ((i + t + 1 : ℕ) : ℤ) by push_cast; ring]
        exact hK0 _ (by omega))]
    simp only [ha]
    rw [show n + (i : ℤ) - 1 = n - 1 + i by ring]
    congr 2
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [show n + (i : ℤ) + t = n - 1 + ((i + t + 1 : ℕ) : ℤ) by push_cast; ring]
  rw [star_eq_sum_range α A (n - 1) X K hav, star_eq_sum_range α _ n X K (fun i hi => by
    rw [hD i, hav i (by omega), smul_zero, zero_sub, Finset.sum_eq_zero (fun t _ => by
      rw [hav _ (by omega), fzmul_zero, smul_zero]), smul_zero, neg_zero])]
  simp only [hD, smul_sub, fzmul_sub, fzmul_smul, fzmul_sum, Finset.smul_sum, fzmul_fzmul,
    Finset.sum_sub_distrib, smul_smul]
  set b : ℕ → Fld M := fun J => fzmul (-(J : ℤ)) (a J) with hb
  have hbv : ∀ J : ℕ, K ≤ J → b J = 0 := fun J hJ => by simp only [hb]; rw [hav J hJ, fzmul_zero]
  have hdouble : ∑ i ∈ Finset.range K, ∑ t ∈ Finset.range K,
      (cbinom (-α) i * (α * gBinom (-1) t)) • fzmul (-(i : ℤ) + (-1 - t)) (a (i + t + 1))
      = ∑ J ∈ Finset.range K, (if 1 ≤ J then α * cbinom (-α - 1) (J - 1) else 0) • b J := by
    have hre : ∀ i t : ℕ, fzmul (-(i : ℤ) + (-1 - t)) (a (i + t + 1)) = b (i + t + 1) := by
      intro i t; simp only [hb]; congr 1; push_cast; ring
    simp only [hre]
    rw [sum_range_sq_eq_sum_antidiagonal K (fun i t => (cbinom (-α) i * (α * gBinom (-1) t)) •
      b (i + t + 1)) (fun i t h => by beta_reduce; rw [hbv _ (by omega), smul_zero])]
    rw [show (∑ J ∈ Finset.range K, ∑ p ∈ Finset.antidiagonal J,
        (cbinom (-α) p.1 * (α * gBinom (-1) p.2)) • b (p.1 + p.2 + 1))
        = ∑ J ∈ Finset.range K, (α * cbinom (-α - 1) J) • b (J + 1) by
      refine Finset.sum_congr rfl fun J _ => ?_
      rw [show -α - 1 = -α + -1 by ring, ← gBinom_vandermonde, Finset.mul_sum, Finset.sum_smul]
      refine Finset.sum_congr rfl fun it hit => ?_
      rw [Finset.mem_antidiagonal] at hit
      rw [hit, gBinom_eq_cbinom]
      push_cast
      congr 1
      ring]
    rw [sum_range_add_shift b _ 1 K hbv]
  rw [hdouble, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun J _ => ?_
  simp only [hb]
  rw [← sub_smul]
  congr 1
  rcases Nat.eq_zero_or_pos J with rfl | hJ
  · simp
  · rw [if_pos (show 1 ≤ J by omega)]
    obtain ⟨j, rfl⟩ : ∃ j : ℕ, J = j + 1 := ⟨J - 1, by omega⟩
    have h := cbinom_succ_mul (-α) j
    rw [Nat.add_sub_cancel]
    push_cast at h ⊢
    linear_combination (-1 : ℂ) * h


/-! ## The twist-graded state space of a twisted local system -/

section StateSpace

variable (S : Set (Fld M))

/-- The generated twisted system as a submodule of the fields. -/
def tgenSub : Submodule ℂ (Fld M) where
  carrier := TGenerated S
  add_mem' ha hb := add_mem_tgenerated ha hb
  zero_mem' := zero_mem_tgenerated S
  smul_mem' c _ ha := smul_mem_tgenerated c ha

theorem mem_tgenSub {X : Fld M} : X ∈ tgenSub S ↔ X ∈ TGenerated S := Iff.rfl

/-- The twist-graded state space `ℂ →₀ TGenerated S`. -/
abbrev TSt : Type u := ℂ →₀ tgenSub S

variable {S}

/-- Twisted products eventually vanish. -/
theorem star_eventually_zero {A X : Fld M} (h : Local A.1 X.1) (α : ℂ) :
    ∃ N : ℤ, ∀ p : ℤ, N ≤ p → star α A p X = 0 := by
  obtain ⟨N0, hN0⟩ := Fld.prod_eventually_zero_of_local h
  exact ⟨N0, fun p hp => by
    rw [star_eq_sum_range α A p X 0 (fun i _ => hN0 _ (by omega)), Finset.sum_range_zero]⟩

variable (hS : ∀ a ∈ S, ∀ b ∈ S, Local a.1 b.1)
include hS

theorem tsLocal (A X : tgenSub S) : Local A.1.1 X.1.1 :=
  tgenerated_local hS ((mem_tgenSub S).mp A.2) ((mem_tgenSub S).mp X.2)

/-- The twisted product on the system, bilinear. -/
noncomputable def starL (α : ℂ) (p : ℤ) : tgenSub S →ₗ[ℂ] (tgenSub S →ₗ[ℂ] tgenSub S) where
  toFun A :=
    { toFun := fun X => ⟨star α A.1 p X.1,
        (mem_tgenSub S).mpr (star_mem hS ((mem_tgenSub S).mp A.2) ((mem_tgenSub S).mp X.2) α p)⟩
      map_add' := fun X Y => Subtype.ext (star_add_right (tsLocal hS A X) (tsLocal hS A Y) α p)
      map_smul' := fun c X => Subtype.ext (star_smul_right (tsLocal hS A X) α c p) }
  map_add' A B := by
    ext X : 1
    exact Subtype.ext (star_add_left (tsLocal hS A X) (tsLocal hS B X) α p)
  map_smul' c A := by
    ext X : 1
    exact Subtype.ext (star_smul_left (tsLocal hS A X) α c p)

@[simp] theorem starL_val (α : ℂ) (p : ℤ) (A X : tgenSub S) :
    ((starL hS α p A X : tgenSub S) : Fld M) = star α A.1 p X.1 := rfl

/-- The action of a single twist-component. -/
noncomputable def stInner (α : ℂ) (p : ℤ) : tgenSub S →ₗ[ℂ] End ℂ (TSt S) where
  toFun A := Finsupp.lsum ℂ (fun β => (Finsupp.lsingle (α + β)).comp (starL hS α p A))
  map_add' A B := by
    apply Finsupp.lhom_ext
    intro β X
    simp [map_add]
  map_smul' c A := by
    apply Finsupp.lhom_ext
    intro β X
    simp [map_smul, Finsupp.smul_single]

/-- **The twisted product action** of a state: `(a₍ₚ₎ x)_{α+β} ∋ star α (a α) p (x β)`. -/
noncomputable def stMode (p : ℤ) : TSt S →ₗ[ℂ] End ℂ (TSt S) :=
  Finsupp.lsum ℂ (fun α => stInner hS α p)

@[simp] theorem stMode_single (p : ℤ) (α β : ℂ) (A X : tgenSub S) :
    stMode hS p (Finsupp.single α A) (Finsupp.single β X)
      = Finsupp.single (α + β) (starL hS α p A X) := by
  simp [stMode, stInner]

/-- The state field `Y⋆(a, z)`. -/
noncomputable def stY (a : TSt S) : FormalDist (End ℂ (TSt S)) := fun n => stMode hS (-n - 1) a

theorem mode_stY (a : TSt S) (p : ℤ) : mode (stY hS a) p = stMode hS p a := by
  rw [mode_apply, stY, show -(-p - 1) - 1 = p by ring]

theorem stY_apply (a : TSt S) (n : ℤ) : stY hS a n = stMode hS (-n - 1) a := rfl

theorem stY_isField_single (α : ℂ) (A : tgenSub S) : IsField (stY hS (Finsupp.single α A)) := by
  intro x
  induction x using Finsupp.induction_linear with
  | zero => exact ⟨0, fun n _ => map_zero _⟩
  | add x y hx hy =>
      obtain ⟨B1, h1⟩ := hx
      obtain ⟨B2, h2⟩ := hy
      exact ⟨min B1 B2, fun n hn => by
        rw [map_add, h1 n (by omega), h2 n (by omega), add_zero]⟩
  | single β X =>
      obtain ⟨N, hN⟩ := star_eventually_zero (tsLocal hS A X) α
      refine ⟨-N, fun n hn => ?_⟩
      rw [stY_apply, stMode_single,
        show starL hS α (-n - 1) A X = 0 from Subtype.ext (hN _ (by omega)), Finsupp.single_zero]

/-- The state field of a single state, as a field. -/
noncomputable def stYF (α : ℂ) (A : tgenSub S) : Fld (TSt S) :=
  ⟨stY hS (Finsupp.single α A), stY_isField_single hS α A⟩

@[simp] theorem stYF_val (α : ℂ) (A : tgenSub S) :
    (stYF hS α A).1 = stY hS (Finsupp.single α A) := rfl

omit hS in
theorem gBinom_eq_prod_mul (p : ℤ) (j : ℕ) :
    gBinom p j = (((∏ i ∈ Finset.range j, (p - (i : ℤ)) : ℤ) : ℂ)) * ((j.factorial : ℂ))⁻¹ := by
  rw [gBinom, div_eq_mul_inv]
  push_cast
  rfl

/-- **Locality of the state fields** (from the twisted commutator formula `star_comm`). -/
theorem stY_local_single (α β : ℂ) (A B : tgenSub S) :
    Local (stY hS (Finsupp.single α A)) (stY hS (Finsupp.single β B)) := by
  obtain ⟨N0, hN0⟩ := Fld.prod_eventually_zero_of_local (tsLocal hS A B)
  set N : ℕ := N0.toNat with hN
  have hvan : ∀ s : ℕ, N ≤ s → Fld.prod s A.1 B.1 = 0 := fun s hs => hN0 _ (by omega)
  refine ⟨N, (local_iff_deltaSum _ N).mpr ⟨fun j => (((j : ℕ).factorial : ℂ))⁻¹ •
      stY hS (Finsupp.single (α + β) (starL hS α (j : ℕ) A B)), ?_⟩⟩
  funext m n
  refine LinearMap.ext fun x => ?_
  induction x using Finsupp.induction_linear with
  | zero => simp only [map_zero]
  | add x y hx hy => simp only [map_add, hx, hy]
  | single γ C =>
      rw [bracketDist_apply, formalDist₂_sum_apply, LinearMap.sum_apply, LinearMap.sub_apply,
        Module.End.mul_apply, Module.End.mul_apply, stY_apply, stY_apply, stMode_single,
        stMode_single, stMode_single, stMode_single,
        show α + (β + γ) = α + β + γ by ring, show β + (α + γ) = α + β + γ by ring,
        ← Finsupp.single_sub]
      have hterm : ∀ j : Fin N, (deltaDeriv (j : ℕ) ((((j : ℕ).factorial : ℂ))⁻¹ •
            stY hS (Finsupp.single (α + β) (starL hS α (j : ℕ) A B))) m n) (Finsupp.single γ C)
          = Finsupp.single (α + β + γ) (gBinom (-m - 1) (j : ℕ) •
              starL hS (α + β) ((-m - 1) + (-n - 1) - (j : ℕ)) (starL hS α (j : ℕ) A B) C) := by
        intro j
        have hsm : ∀ (c : ℂ) (F : FormalDist (End ℂ (TSt S))) (t : ℤ), (c • F) t = c • F t :=
          fun _ _ _ => rfl
        rw [deltaDeriv_apply, ← Int.cast_smul_eq_zsmul ℂ, LinearMap.smul_apply, hsm,
          LinearMap.smul_apply, stY_apply, stMode_single, Finsupp.smul_single,
          Finsupp.smul_single, smul_smul, gBinom_eq_prod_mul,
          show -(m + n + 1 + ((j : ℕ) : ℤ)) - 1 = (-m - 1) + (-n - 1) - (j : ℕ) by ring]
      rw [Finset.sum_congr rfl (fun j _ => hterm j), ← Finsupp.single_finsetSum]
      congr 1
      apply Subtype.ext
      rw [Submodule.coe_sub, starL_val, starL_val, starL_val, starL_val, Submodule.coe_sum,
        star_comm hS ((mem_tgenSub S).mp A.2) ((mem_tgenSub S).mp B.2) ((mem_tgenSub S).mp C.2)
          α β (-m - 1) (-n - 1) N hvan,
        ← Fin.sum_univ_eq_sum_range (fun s => gBinom (-m - 1) s •
          star (α + β) (star α A.1 s B.1) ((-m - 1) + (-n - 1) - s) C.1) N]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Submodule.coe_smul, starL_val, starL_val]

/-- The vacuum state. -/
noncomputable def vacS : TSt S :=
  Finsupp.single 0 ⟨Fld.one, (mem_tgenSub S).mpr (one_mem_tgenerated S)⟩

theorem stMode_single_vacS (p : ℤ) (β : ℂ) (B : tgenSub S) :
    stMode hS p (Finsupp.single β B) (vacS (S := S))
      = Finsupp.single β ⟨star β B.1 p Fld.one, (mem_tgenSub S).mpr
          (star_mem hS ((mem_tgenSub S).mp B.2) (one_mem_tgenerated S) β p)⟩ := by
  rw [vacS, stMode_single, add_zero]
  rfl

theorem stY_creation0 (β : ℂ) (B : tgenSub S) :
    stY hS (Finsupp.single β B) 0 (vacS (S := S)) = Finsupp.single β B := by
  rw [stY_apply, show -(0 : ℤ) - 1 = -1 by ring, stMode_single_vacS]
  congr 1
  exact Subtype.ext (star_one_right_neg_one β B.1)

theorem stY_creation_neg (β : ℂ) (B : tgenSub S) {q : ℤ} (hq : q < 0) :
    stY hS (Finsupp.single β B) q (vacS (S := S)) = 0 := by
  rw [stY_apply, stMode_single_vacS]
  rw [show (⟨star β B.1 (-q - 1) Fld.one, _⟩ : tgenSub S) = 0 from
    Subtype.ext (star_one_right_nonneg β B.1 (by omega)), Finsupp.single_zero]

/-! ## Associativity via Goddard uniqueness -/

theorem stMode_single_vacS_nonneg (p : ℤ) (hp : 0 ≤ p) (β : ℂ) (B : tgenSub S) :
    stMode hS p (Finsupp.single β B) (vacS (S := S)) = 0 := by
  rw [stMode_single_vacS]
  rw [show (⟨star β B.1 p Fld.one, _⟩ : tgenSub S) = 0 from
    Subtype.ext (star_one_right_nonneg β B.1 hp), Finsupp.single_zero]

theorem stMode_single_vacS_negsucc (k : ℕ) (β : ℂ) (B : tgenSub S) :
    stMode hS (-(k : ℤ) - 1) (Finsupp.single β B) (vacS (S := S))
      = Finsupp.single β ⟨((k.factorial : ℂ))⁻¹ • (Dα β)^[k] B.1, (mem_tgenSub S).mpr
          (smul_mem_tgenerated _ (Dα_iterate_mem β ((mem_tgenSub S).mp B.2) k))⟩ := by
  rw [stMode_single_vacS]
  congr 1
  exact Subtype.ext (star_one_negsucc β B.1 k)

/-- The vacuum identity behind associativity. -/
theorem stMode_vac_assoc (α β : ℂ) (A B : tgenSub S) (p n : ℤ) :
    stMode hS n (Finsupp.single (α + β) (starL hS α p A B)) (vacS (S := S))
      = mode (Fld.prod p (stYF hS α A) (stYF hS β B)).1 n (vacS (S := S)) := by
  rw [Fld.mode_prod_iterate]
  simp only [stYF_val, mode_stY]
  have h2 : ∀ i : ℕ, stMode hS (i : ℤ) (Finsupp.single α A) (vacS (S := S)) = 0 :=
    fun i => stMode_single_vacS_nonneg hS _ (by omega) α A
  simp only [h2, map_zero, smul_zero, sub_zero]
  rcases le_or_gt 0 n with hn | hn
  · rw [stMode_single_vacS_nonneg hS n hn]
    symm
    refine finsum_eq_zero_of_forall_eq_zero fun i => ?_
    rw [stMode_single_vacS_nonneg hS _ (by omega), map_zero, smul_zero]
  obtain ⟨K, rfl⟩ : ∃ K : ℕ, n = -(K : ℤ) - 1 := ⟨(-n - 1).toNat, by omega⟩
  rw [stMode_single_vacS_negsucc]
  rw [finsum_eq_sum_of_support_subset _ (s := Finset.range (K + 1)) (by
    intro i hi
    rw [Function.mem_support] at hi
    by_contra hc
    rw [Finset.coe_range, Set.mem_Iio, not_lt] at hc
    exact hi (by rw [stMode_single_vacS_nonneg hS _ (by omega), map_zero, smul_zero]))]
  have hterm : ∀ i ∈ Finset.range (K + 1), ((-1 : ℂ) ^ i * gBinom p i) •
      stMode hS (p - i) (Finsupp.single α A)
        (stMode hS (-(K : ℤ) - 1 + i) (Finsupp.single β B) (vacS (S := S)))
      = Finsupp.single (α + β) (((-1 : ℂ) ^ i * gBinom p i) •
          starL hS α (p - i) A ⟨((((K - i).factorial : ℂ))⁻¹ • (Dα β)^[K - i] B.1),
            (mem_tgenSub S).mpr (smul_mem_tgenerated _
              (Dα_iterate_mem β ((mem_tgenSub S).mp B.2) _))⟩) := by
    intro i hi
    rw [Finset.mem_range] at hi
    rw [show -(K : ℤ) - 1 + i = -((K - i : ℕ) : ℤ) - 1 by push_cast [Nat.cast_sub (by omega : i ≤ K)]; ring,
      stMode_single_vacS_negsucc, stMode_single, Finsupp.smul_single]
  rw [Finset.sum_congr rfl hterm, ← Finsupp.single_finsetSum]
  congr 1
  apply Subtype.ext
  rw [Submodule.coe_sum]
  simp only [Submodule.coe_smul, starL_val]
  have hloc : ∀ j : ℕ, Local A.1.1 ((Dα β)^[j] B.1).1 := fun j =>
    tgenerated_local hS ((mem_tgenSub S).mp A.2) (Dα_iterate_mem β ((mem_tgenSub S).mp B.2) j)
  exact star_D_iter hloc α K p

/-- **Associativity of the state fields** (Goddard): the state field of `a₍ₚ₎b` acts on
`single γ C` as the field product of the state fields. -/
theorem stMode_assoc (α β γ : ℂ) (A B C : tgenSub S) (p q : ℤ) :
    stMode hS q (stMode hS p (Finsupp.single α A) (Finsupp.single β B)) (Finsupp.single γ C)
      = mode (Fld.prod p (stYF hS α A) (stYF hS β B)).1 q (Finsupp.single γ C) := by
  rw [stMode_single]
  have h3 : Local (Fld.prod p (stYF hS α A) (stYF hS β B)).1 (stYF hS γ C).1 :=
    Fld.prod_local_right_of_pairwise (a := stYF hS α A) (b := stYF hS β B) (c := stYF hS γ C)
      (stY_local_single hS α β A B) (stY_local_single hS α γ A C) (stY_local_single hS β γ B C) p
  have hloc : Local (stY hS (Finsupp.single (α + β) (starL hS α p A B))
      - (Fld.prod p (stYF hS α A) (stYF hS β B)).1) (stY hS (Finsupp.single γ C)) :=
    local_sub_left (stY_local_single hS (α + β) γ _ C) h3
  have hsubF : ∀ (F G : FormalDist (End ℂ (TSt S))) (t : ℤ), (F - G) t = F t - G t :=
    fun _ _ _ => rfl
  have h := goddard_pt (vacS (S := S)) _ _ (Finsupp.single γ C) hloc
    (stY_creation0 hS γ C) (fun q hq => stY_creation_neg hS γ C hq) (fun t => by
      rw [hsubF, LinearMap.sub_apply]
      have := stMode_vac_assoc hS α β A B p (-t - 1)
      rw [mode_apply, show -(-t - 1) - 1 = t by ring] at this
      rw [stY_apply, this, sub_self]) (-q - 1)
  rw [hsubF, LinearMap.sub_apply, sub_eq_zero, stY_apply, show -(-q - 1) - 1 = q by ring] at h
  rw [h, mode_apply]

/-- **Twisted associativity: the iterate formula for twisted products.**  For `A, B, C` in
the twisted local system generated by a pairwise-local family and any twists `α, β`:
`star (α+β) (star α A p B) q C
   = Σᶠ_i (−1)ⁱ C(p,i) [star α A (p−i) (star β B (q+i) C) − (−1)ᵖ star β B (p+q−i) (star α A i C)]`. -/
theorem star_iterate {A B C : Fld M} (hA : A ∈ TGenerated S) (hB : B ∈ TGenerated S)
    (hC : C ∈ TGenerated S) (α β : ℂ) (p q : ℤ) :
    star (α + β) (star α A p B) q C
      = ∑ᶠ i : ℕ, ((-1 : ℂ) ^ i * gBinom p i) •
          (star α A (p - i) (star β B (q + i) C)
            - ((-1 : ℂ) ^ p) • star β B (p + q - i) (star α A i C)) := by
  set A' : tgenSub S := ⟨A, (mem_tgenSub S).mpr hA⟩
  set B' : tgenSub S := ⟨B, (mem_tgenSub S).mpr hB⟩
  set C' : tgenSub S := ⟨C, (mem_tgenSub S).mpr hC⟩
  have key := stMode_assoc hS α β 0 A' B' C' p q
  rw [Fld.mode_prod_iterate] at key
  simp only [stYF_val, mode_stY, stMode_single, add_zero] at key
  rw [show β + α = α + β by ring] at key
  simp only [Finsupp.smul_single, ← Finsupp.single_sub] at key
  have hfin : ∀ f : ℕ → tgenSub S,
      (∑ᶠ i, Finsupp.single (α + β) (f i)) = Finsupp.single (α + β) (∑ᶠ i, f i) := fun f =>
    (AddMonoidHom.map_finsum_of_injective (Finsupp.singleAddHom (α + β))
      (Finsupp.single_injective _) f).symm
  rw [hfin] at key
  have key' := congrArg Subtype.val (Finsupp.single_injective (α + β) key)
  rw [starL_val, starL_val] at key'
  change star (α + β) (star α A p B) q C = _ at key'
  rw [key']
  have hsub : ∀ f : ℕ → tgenSub S, ((∑ᶠ i, f i : tgenSub S) : Fld M) = ∑ᶠ i, (f i : Fld M) :=
    fun f => AddMonoidHom.map_finsum_of_injective (tgenSub S).subtype.toAddMonoidHom
      Subtype.val_injective f
  rw [hsub]
  refine finsum_congr fun i => ?_
  simp only [Submodule.coe_smul, Submodule.coe_sub, starL_val]
  rfl

/-- `star_iterate` with a finite range. -/
theorem star_iterate_range {A B C : Fld M} (hA : A ∈ TGenerated S) (hB : B ∈ TGenerated S)
    (hC : C ∈ TGenerated S) (α β : ℂ) (p q : ℤ) (K : ℕ)
    (hK : ∀ i : ℕ, K ≤ i → star β B (q + i) C = 0 ∧ star α A i C = 0) :
    star (α + β) (star α A p B) q C
      = ∑ i ∈ Finset.range K, ((-1 : ℂ) ^ i * gBinom p i) •
          (star α A (p - i) (star β B (q + i) C)
            - ((-1 : ℂ) ^ p) • star β B (p + q - i) (star α A i C)) := by
  rw [star_iterate hS hA hB hC]
  refine finsum_eq_sum_of_support_subset _ fun i hi => ?_
  rw [Function.mem_support] at hi
  simp only [Finset.coe_range, Set.mem_Iio]
  by_contra hc
  obtain ⟨h1, h2⟩ := hK i (by omega)
  exact hi (by rw [h1, h2, star_zero_right, star_zero_right, smul_zero, sub_zero, smul_zero])

