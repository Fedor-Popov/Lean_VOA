import VOA.Moonshine.FockSpanFock
import VOA.Moonshine.GroundLattice

/-!
# Zhu generation of `V₀⁺` by its weight-2 part  (R-gen, closed)

`V₀⁺ = V_{Λ₀}^+` (`V0P`) is generated, as a Zhu algebra (every subspace containing `𝟙`, `O(V₀⁺)` and
the weight-2 part, closed under the Zhu product, is everything), by its weight-2 subspace.

Assembled from `FockSpan.zhuGenerated_weightTwo_of_groundLattice` (the two Fock residuals,
`FockSpan.fockSpanned`, `FockSpan.excitedSpanned`) and `SigmaExist.groundLattice` (the Golay /
`Λ₀` combinatorics).

## Status
Unconditional; `#print axioms` gives `[propext, Classical.choice, Quot.sound]` (no `VOA.pbw`).
-/

namespace VOA.Moonshine

/-- **R-gen**: `V₀⁺` is Zhu-generated by its weight-2 part. -/
theorem zhuGenerated_weightTwo : SigmaExist.ZhuGenerated SigmaExist.weightTwo :=
  FockSpan.zhuGenerated_weightTwo_of_groundLattice SigmaExist.groundLattice

end VOA.Moonshine
