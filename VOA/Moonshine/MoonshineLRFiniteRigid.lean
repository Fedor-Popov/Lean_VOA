import Mathlib
import VOA.Moonshine.MoonshineLRFinOrderPeriodic

/-!
# Finiteness and infinitesimal rigidity

Commutative bilinear products need not be associative or unital.
-/

namespace VOA.Moonshine.ConwayNorton.M8

/-- The Nakayama step for an isolated point of an affine scheme. -/
private theorem lrFiniteRigid_minimal {R : Type*} [CommRing R] [IsNoetherianRing R]
    (J m : Ideal R) [m.IsPrime] (hJ : J ≤ m) (hm : m ≤ J ⊔ m * m) :
    m ∈ J.minimalPrimes := by
  refine ⟨⟨inferInstance, hJ⟩, ?_⟩
  intro Q hQ hQm
  letI : Q.IsPrime := hQ.1
  let f := Ideal.Quotient.mk Q
  let N := m.map f
  have hN : N ≤ N * N := by
    have h : m.map f ≤ (Q ⊔ m * m).map f :=
      Ideal.map_mono (hm.trans (sup_le_sup_right hQ.2 _))
    simpa only [N, f, Ideal.map_sup, Ideal.map_mul, Ideal.map_quotient_self, bot_sup_eq]
      using (h : m.map f ≤ (Q ⊔ m * m).map f)
  obtain ⟨r, hr, hrN⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul N N
      N.fg_of_isNoetherianRing (by simpa only [Ideal.smul_eq_mul] using hN)
  have hproper : N ≠ ⊤ := by
    intro h
    have hcomap := congrArg (Ideal.comap f) h
    have heq : (m.map f).comap f = m := by
      rw [Ideal.comap_map_of_surjective f Ideal.Quotient.mk_surjective]
      simp only [f, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hQm]
    rw [heq, Ideal.comap_top] at hcomap
    exact (inferInstance : m.IsPrime).ne_top hcomap
  have hr0 : r ≠ 0 := by
    intro h
    apply hproper
    apply (Ideal.eq_top_iff_one N).mpr
    simpa [h] using N.neg_mem hr
  have hbot : N = ⊥ := by
    apply le_antisymm _ bot_le
    intro x hx
    exact (mul_eq_zero.mp (hrN x hx)).resolve_left hr0
  have hle := (Ideal.map_eq_bot_iff_le_ker f).mp hbot
  simpa only [f, Ideal.mk_ker] using hle

open scoped BigOperators
open MvPolynomial

/-- The point ideal is generated by the translated coordinate functions. -/
private theorem lrFiniteRigid_point_span {ι : Type*} (p : ι → ℂ) :
    RingHom.ker (eval p) = Ideal.span (Set.range fun i => X i - C (p i)) := by
  let m : Ideal (MvPolynomial ι ℂ) := Ideal.span (Set.range fun i => X i - C (p i))
  have hsub (f : MvPolynomial ι ℂ) : f - C (eval p f) ∈ m := by
    induction f using MvPolynomial.induction_on with
    | C a => simp
    | add f g hf hg =>
      simpa only [map_add, add_sub_add_comm] using m.add_mem hf hg
    | mul_X f i hf =>
      have hi : X i - C (p i) ∈ m := Ideal.subset_span (Set.mem_range_self i)
      have h := m.add_mem (m.mul_mem_right (X i) hf)
        (m.mul_mem_left (C (eval p f)) hi)
      convert h using 1
      simp only [map_mul, eval_X]
      ring
  apply le_antisymm
  · intro f hf
    have hf0 : eval p f = 0 := hf
    simpa only [hf0, map_zero, sub_zero] using hsub f
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change eval p (X i - C (p i)) = 0
    simp

/-- Bilinear extension of a finite array of structure constants. -/
private def lrFiniteRigid_bilin {ι A : Type*} [Fintype ι] [CommRing A]
    (c : ι → ι → ι → A) (x y : ι → A) (i : ι) : A :=
  ∑ j, ∑ k, c i j k * x j * y k

private theorem lrFiniteRigid_bilin_add_left {ι A : Type*} [Fintype ι] [CommRing A]
    (c : ι → ι → ι → A) (x y z : ι → A) :
    lrFiniteRigid_bilin c (x + y) z =
      lrFiniteRigid_bilin c x z + lrFiniteRigid_bilin c y z := by
  ext i
  simp [lrFiniteRigid_bilin, mul_add, add_mul, Finset.sum_add_distrib]

private theorem lrFiniteRigid_bilin_add_right {ι A : Type*} [Fintype ι] [CommRing A]
    (c : ι → ι → ι → A) (x y z : ι → A) :
    lrFiniteRigid_bilin c x (y + z) =
      lrFiniteRigid_bilin c x y + lrFiniteRigid_bilin c x z := by
  ext i
  simp [lrFiniteRigid_bilin, mul_add, Finset.sum_add_distrib]

private theorem lrFiniteRigid_bilin_comm {ι A : Type*} [Fintype ι] [CommRing A]
    (c : ι → ι → ι → A) (hc : ∀ i j k, c i j k = c i k j) (x y : ι → A) :
    lrFiniteRigid_bilin c x y = lrFiniteRigid_bilin c y x := by
  ext i
  rw [lrFiniteRigid_bilin, lrFiniteRigid_bilin, Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro k _
  rw [hc i k j]
  ring

private theorem lrFiniteRigid_bilin_map {ι A A' : Type*} [Fintype ι]
    [CommRing A] [CommRing A'] (f : A →+* A')
    (c : ι → ι → ι → A) (x y : ι → A) (i : ι) :
    lrFiniteRigid_bilin (fun i j k => f (c i j k)) (f ∘ x) (f ∘ y) i =
      f (lrFiniteRigid_bilin c x y i) := by
  simp [lrFiniteRigid_bilin, map_sum, map_mul]

/-- The matrix of multiplication by a coordinate vector. -/
private def lrFiniteRigid_matrix {ι A : Type*} [Fintype ι] [CommRing A]
    (c : ι → ι → ι → A) (p : ι → A) : Matrix ι ι A :=
  fun i k => ∑ j, c i j k * p j

private theorem lrFiniteRigid_matrix_mulVec {ι A : Type*} [Fintype ι] [CommRing A]
    (c : ι → ι → ι → A) (p x : ι → A) :
    (lrFiniteRigid_matrix c p).mulVec x = lrFiniteRigid_bilin c p x := by
  ext i
  simp only [Matrix.mulVec, dotProduct, lrFiniteRigid_matrix, Finset.sum_mul,
    lrFiniteRigid_bilin]
  rw [Finset.sum_comm]

private noncomputable def lrFiniteRigid_equations {ι : Type*} [Fintype ι]
    (c : ι → ι → ι → ℂ) : Ideal (MvPolynomial ι ℂ) :=
  Ideal.span (Set.range fun i =>
    lrFiniteRigid_bilin (fun i j k => C (c i j k)) X X i - 2 * X i)

/-- An invertible linearization makes the point ideal a minimal prime. -/
private theorem lrFiniteRigid_coordinate_minimal {ι : Type*} [Fintype ι] [DecidableEq ι]
    (c : ι → ι → ι → ℂ) (hc : ∀ i j k, c i j k = c i k j)
    (p : ι → ℂ) (hp : ∀ i, lrFiniteRigid_bilin c p p i = 2 * p i)
    (hu : IsUnit (lrFiniteRigid_matrix c p - 1)) :
    RingHom.ker (eval p) ∈ (lrFiniteRigid_equations c).minimalPrimes := by
  let J := lrFiniteRigid_equations c
  let m := RingHom.ker (eval p)
  have hJ : J ≤ m := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change eval p (_ - 2 * X i) = 0
    simpa [lrFiniteRigid_bilin, map_sum] using sub_eq_zero.mpr (hp i)
  letI : m.IsPrime := RingHom.ker_isPrime (eval p)
  apply lrFiniteRigid_minimal J m hJ
  let K := J ⊔ m * m
  let g := Ideal.Quotient.mk K
  let f : ℂ →+* MvPolynomial ι ℂ ⧸ K := g.comp C
  let x : ι → MvPolynomial ι ℂ ⧸ K := g ∘ X
  let v : ι → MvPolynomial ι ℂ ⧸ K := f ∘ p
  let z := x - v
  let d := fun i j k => f (c i j k)
  have hz (i : ι) : z i = g (X i - C (p i)) := by
    simp [z, x, v, f, map_sub]
  have hzmem (i : ι) : X i - C (p i) ∈ m := by
    change eval p (X i - C (p i)) = 0
    simp
  have hzz : lrFiniteRigid_bilin d z z = 0 := by
    ext i
    apply Finset.sum_eq_zero
    intro j _
    apply Finset.sum_eq_zero
    intro k _
    have hprod : z j * z k = 0 := by
      rw [hz, hz, ← map_mul]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      exact (show m * m ≤ K from le_sup_right)
        (Ideal.mul_mem_mul (hzmem j) (hzmem k))
    change d i j k * z j * z k = 0
    rw [mul_assoc, hprod, mul_zero]
  have hvv (i : ι) : lrFiniteRigid_bilin d v v i = 2 * v i := by
    rw [lrFiniteRigid_bilin_map f c p p i, hp]
    simp [v, map_ofNat]
  have hxx (i : ι) : lrFiniteRigid_bilin d x x i = 2 * x i := by
    have hmem : lrFiniteRigid_bilin (fun i j k => C (c i j k)) X X i -
        2 * X i ∈ K := (show J ≤ K from le_sup_left)
          (Ideal.subset_span (Set.mem_range_self i))
    have heq := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rw [map_sub, sub_eq_zero] at heq
    simpa [lrFiniteRigid_bilin, map_sum, d, x, f] using heq
  have hder : lrFiniteRigid_bilin d v z - z = 0 := by
    ext i
    have hvz := congrFun (lrFiniteRigid_bilin_comm d (fun i j k =>
      congrArg f (hc i j k)) z v) i
    have hexp := hxx i
    have hx : x = v + z := by simp [z]
    rw [hx, lrFiniteRigid_bilin_add_left, lrFiniteRigid_bilin_add_right,
      lrFiniteRigid_bilin_add_right] at hexp
    simp only [Pi.add_apply, hvv, hvz, hzz, Pi.zero_apply] at hexp
    have heq : f 2 * (lrFiniteRigid_bilin d v z i - z i) = f 2 * 0 := by
      rw [map_ofNat]
      linear_combination hexp
    exact (IsUnit.map f (isUnit_iff_ne_zero.mpr (by norm_num : (2 : ℂ) ≠ 0))).mul_left_cancel
      heq
  have hmat : (lrFiniteRigid_matrix c p - 1).map f = lrFiniteRigid_matrix d v - 1 := by
    ext i j
    simp [lrFiniteRigid_matrix, d, v, map_sum, Matrix.map_apply, Matrix.one_apply]
  have hz0 : z = 0 := by
    apply Matrix.mulVec_injective_of_isUnit (hu.map f.mapMatrix)
    rw [RingHom.mapMatrix_apply, hmat, Matrix.sub_mulVec, Matrix.one_mulVec,
      lrFiniteRigid_matrix_mulVec, hder, Matrix.mulVec_zero]
  change RingHom.ker (eval p) ≤ K
  rw [lrFiniteRigid_point_span p]
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  rw [← hz, hz0]
  rfl

variable {B : Type*} [AddCommGroup B] [Module ℂ B]
    (mul : B →ₗ[ℂ] B →ₗ[ℂ] B) (hcomm : ∀ x y, mul x y = mul y x)

private theorem lrFiniteRigid_coordinates {ι : Type*} [Fintype ι]
    (b : Module.Basis ι ℂ B) (x y : B) (i : ι) :
    lrFiniteRigid_bilin (fun i j k => b.repr (mul (b j) (b k)) i)
      (fun j => b.repr x j) (fun k => b.repr y k) i = b.repr (mul x y) i := by
  conv_rhs => rw [← b.sum_repr x, ← b.sum_repr y]
  simp only [map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply,
    Finsupp.finsetSum_apply, Finsupp.smul_apply, smul_eq_mul]
  simp only [lrFiniteRigid_bilin, mul_comm, mul_left_comm]
  rw [Finset.sum_comm]
  simp only [Finset.mul_sum, mul_left_comm]

include hcomm in
/-- There are only finitely many rigid idempotents. -/
theorem finite_setOf_rigid_idempotent [FiniteDimensional ℂ B] :
    {e : B | mul e e = (2 : ℂ) • e ∧ ∀ y, mul e y = y → y = 0}.Finite := by
  classical
  let b := Module.finBasis ℂ B
  let c := fun i j k => b.repr (mul (b j) (b k)) i
  let point := fun e : B => RingHom.ker (eval (fun i => b.repr e i))
  refine Set.Finite.of_injOn (f := point)
    (t := (lrFiniteRigid_equations c).minimalPrimes) ?_ ?_
    (Ideal.finite_minimalPrimes_of_isNoetherianRing _ _)
  · intro e he
    apply lrFiniteRigid_coordinate_minimal c
      (fun i j k => congrArg (fun z => b.repr z i) (hcomm (b j) (b k)))
    · intro i
      rw [lrFiniteRigid_coordinates mul b, he.1]
      simp
    · have hmat : lrFiniteRigid_matrix c (fun i => b.repr e i) =
          LinearMap.toMatrix b b (mul e) := by
        ext i j
        have h := lrFiniteRigid_coordinates mul b e (b j) i
        simpa [lrFiniteRigid_bilin, lrFiniteRigid_matrix, c,
          LinearMap.toMatrix_apply, Finsupp.single_apply] using h
      rw [hmat, ← LinearMap.toMatrix_id b, ← map_sub]
      apply (LinearMap.isUnit_toMatrix_iff b).mpr
      apply (LinearMap.isUnit_iff_ker_eq_bot _).mpr
      apply LinearMap.ker_eq_bot'.mpr
      intro y hy
      exact he.2 y (sub_eq_zero.mp hy)
  · intro e _ e' _ h
    apply b.repr.injective
    ext i
    have hm : X i - C (b.repr e i) ∈ point e := by
      change eval (fun j => b.repr e j) (X i - C (b.repr e i)) = 0
      simp
    rw [h] at hm
    change eval (fun j => b.repr e' j) (X i - C (b.repr e i)) = 0 at hm
    simpa using (sub_eq_zero.mp (by simpa using hm)).symm

include hcomm in
/-- A derivation vanishes when the rigid idempotents span. -/
theorem derivation_eq_zero_of_span_rigid [FiniteDimensional ℂ B]
    (hspan : Submodule.span ℂ
      {e : B | mul e e = (2 : ℂ) • e ∧ ∀ y, mul e y = y → y = 0} = ⊤)
    (D : Module.End ℂ B)
    (hD : ∀ x y, D (mul x y) = mul (D x) y + mul x (D y)) : D = 0 := by
  apply LinearMap.ext
  intro x
  have hker : Submodule.span ℂ
      {e : B | mul e e = (2 : ℂ) • e ∧ ∀ y, mul e y = y → y = 0} ≤ D.ker := by
    apply Submodule.span_le.mpr
    intro e he
    exact derivation_apply_eq_zero_of_rigid mul hcomm D hD e he.1 he.2
  have hx := hker (hspan.symm ▸ (Submodule.mem_top : x ∈ (⊤ : Submodule ℂ B)))
  exact hx

end VOA.Moonshine.ConwayNorton.M8
