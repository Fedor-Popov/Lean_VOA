namespace VOA.Moonshine.MonsterGriess.Code

open VOA.Moonshine.MonsterGriess
open scoped Finset

private theorem zmod2_cases : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide

/-! ### From `CFSG/Monster/Code/Defs.lean` -/

@[simp] theorem row_coord (r : Fin 4) (j : Fin 6) : row (coord r j) = r := by
  ext; simp only [row, coord]; omega

@[simp] theorem col_coord (r : Fin 4) (j : Fin 6) : col (coord r j) = j := by
  ext; simp only [col, coord]; omega

def γ (j : Fin 6) : Fin 24 → ZMod 2 := Pi.single (coord 0 j) 1

/-! ### From `CFSG/Monster/Code/Basis.lean` -/

theorem Ω_eq_sum_g : Ω = ∑ j, g j := by decide

/-! ### From `CFSG/Monster/Code/Weights.lean` -/

theorem eight_le_wt {x : Fin 24 → ZMod 2} (hx : x ∈ C) (h0 : x ≠ 0) : 8 ≤ hammingNorm x := by
  have := wt_mem hx
  have h1 : hammingNorm x ≠ 0 := hammingNorm_ne_zero_iff.2 h0
  simp only [Finset.mem_insert, Finset.mem_singleton] at this
  omega

theorem wt_B : ∀ i, hammingNorm (B i) = 8 := by
  intro i; rw [B_eq_bvec, hammingNorm_bvec]; revert i; decide

/-! ### From `CFSG/Monster/Code/LoopIdentities.lean` -/

theorem P_bvec (a : ℕ) : P (bvec 24 a) = ((popc 24 a / 4 : ℕ) : ZMod 2) := by
  rw [P, hammingNorm_bvec]

theorem K_bvec (a b : ℕ) : K (bvec 24 a) (bvec 24 b) = ((popc 24 (a &&& b) / 2 : ℕ) : ZMod 2) := by
  rw [K_eq, ← bvec_and, hammingNorm_bvec]

theorem β_bvec (i j : Fin 12) : β i j = if i < j then 0 else if i = j then
    ((popc 24 (Bmask i) / 4 : ℕ) : ZMod 2) else ((popc 24 (Bmask i &&& Bmask j) / 2 : ℕ) : ZMod 2) := by
  rw [β, B_eq_bvec, B_eq_bvec, P_bvec, K_bvec]

def ι6 : Fin 6 → Fin 12 := Fin.castLE (by norm_num)

theorem B_ι6 : ∀ j, B (ι6 j) = g j := by decide

theorem β_grey : ∀ (i : Fin 6) (j : Fin 12), β (ι6 i) j = 0 := by
  intro i j
  rw [β_bvec]
  revert i j
  decide

def greyWeight (μ : Fin 6 → ZMod 2) : ℕ := ∑ j, (μ j).val

def greyGamma (μ : Fin 6 → ZMod 2) : Fin 24 → ZMod 2 := ∑ j, μ j • γ j

def greyVec (μ : Fin 6 → ZMod 2) : Fin 24 → ZMod 2 :=
  (((greyWeight μ : ℤ) - 1 : ℤ) : ZMod 2) • greyGamma μ +
    (((greyWeight μ).choose 2 : ℕ) : ZMod 2) • ωInf

def greyCoords (μ : Fin 6 → ZMod 2) : Fin 12 → ZMod 2 := ∑ j, μ j • Pi.single (ι6 j) 1

theorem ι6_injective : Function.Injective ι6 := Fin.castLE_injective _

theorem greyCoords_ι6 (μ : Fin 6 → ZMod 2) (j : Fin 6) : greyCoords μ (ι6 j) = μ j := by
  rw [greyCoords, Finset.sum_apply, Finset.sum_eq_single j]
  · simp
  · intro k _ hk
    simp [ι6_injective.ne (Ne.symm hk)]
  · simp

theorem greyCoords_of_not_mem (μ : Fin 6 → ZMod 2) {i : Fin 12} (hi : i ∉ Set.range ι6) :
    greyCoords μ i = 0 := by
  rw [greyCoords, Finset.sum_apply]
  refine Finset.sum_eq_zero fun k _ => ?_
  have : i ≠ ι6 k := fun h => hi ⟨k, h.symm⟩
  simp [this]

theorem repr_grey (μ : Fin 6 → ZMod 2) (e : C) (he : (e : Fin 24 → ZMod 2) = ∑ j, μ j • g j) :
    ⇑(basisC.repr e) = greyCoords μ := by
  funext i
  rw [repr_apply, he, map_sum, greyCoords]
  simp only [map_smul, ← B_ι6, ψ_B]

private theorem g_mul_g : ∀ i j : Fin 6, i ≠ j → g i * g j = ωInf + γ i + γ j := by decide

private theorem ZMod2_six : ∀ a b c d e f : ZMod 2,
    (∑ i : Fin 6, ∑ j : Fin 6,
      (if i < j then ![a, b, c, d, e, f] i * ![a, b, c, d, e, f] j else 0) • (ωInf + γ i + γ j)) =
      greyVec ![a, b, c, d, e, f] := by
  decide +kernel

theorem greyVec_eq (μ : Fin 6 → ZMod 2) :
    (∑ i : Fin 6, ∑ j : Fin 6, (if i < j then μ i * μ j else 0) • (ωInf + γ i + γ j)) =
      greyVec μ := by
  have hμ : μ = ![μ 0, μ 1, μ 2, μ 3, μ 4, μ 5] := by
    funext i; fin_cases i <;> rfl
  rw [hμ]
  exact ZMod2_six _ _ _ _ _ _

theorem θc_greyCoords (μ : Fin 6 → ZMod 2) (ν : Fin 12 → ZMod 2) :
    θc (greyCoords μ) ν = ∑ i : Fin 6, ∑ j : Fin 6,
      (if i < j then μ i * μ j else 0) * A (g i) (g j) (∑ k, ν k • B k) := by
  rw [θc_eq]
  have h1 : ∑ i, ∑ j, greyCoords μ i * ν j * β i j = 0 := by
    refine Finset.sum_eq_zero fun i _ => Finset.sum_eq_zero fun j _ => ?_
    by_cases hi : i ∈ Set.range ι6
    · obtain ⟨i', rfl⟩ := hi
      rw [β_grey, mul_zero]
    · rw [greyCoords_of_not_mem μ hi, zero_mul, zero_mul]
  rw [h1, zero_add]
  have h2 : ∀ i j, ∑ k, lt01 i j * greyCoords μ i * greyCoords μ j * ν k * Ab i j k =
      lt01 i j * greyCoords μ i * greyCoords μ j * A (B i) (B j) (∑ k, ν k • B k) := by
    intro i j
    rw [A_sum_right, Finset.mul_sum]
    exact Finset.sum_congr rfl fun k _ => by rw [Ab]; ring
  simp only [h2]
  symm
  refine Fintype.sum_of_injective ι6 ι6_injective _ _ (fun i hi => ?_) (fun i => ?_)
  · refine Finset.sum_eq_zero fun j _ => ?_
    rw [greyCoords_of_not_mem μ hi, mul_zero, zero_mul, zero_mul]
  · refine Fintype.sum_of_injective ι6 ι6_injective _ _ (fun j hj => ?_) (fun j => ?_)
    · rw [greyCoords_of_not_mem μ hj, mul_zero, zero_mul]
    · rw [greyCoords_ι6, greyCoords_ι6, B_ι6, B_ι6]
      simp only [lt01, ι6, Fin.castLE_lt_castLE_iff]
      split_ifs <;> ring

theorem A_eq_dotProduct (x y z : Fin 24 → ZMod 2) : A x y z = z ⬝ᵥ (x * y) := by
  rw [A_eq_sum, dotProduct]
  exact Finset.sum_congr rfl fun k _ => by simp only [Pi.mul_apply]; ring

theorem θ_grey (μ : Fin 6 → ZMod 2) (e f : C)
    (he : (e : Fin 24 → ZMod 2) = ∑ j, μ j • g j) :
    θ e f = (f : Fin 24 → ZMod 2) ⬝ᵥ greyVec μ := by
  rw [θ, repr_grey μ e he, θc_greyCoords, ← coe_eq_sum, ← greyVec_eq, dotProduct_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [dotProduct_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [dotProduct_smul, smul_eq_mul]
  split_ifs with h
  · rw [A_eq_dotProduct, g_mul_g i j (ne_of_lt h)]
  · rw [zero_mul, zero_mul]

private theorem greyVec_one : greyVec (fun _ => 1) = 0 := by decide

theorem θ_Ω (f : C) : θ ⟨Ω, Ω_mem_C⟩ f = 0 := by
  have hΩ : ((⟨Ω, Ω_mem_C⟩ : C) : Fin 24 → ZMod 2) = ∑ j, (fun _ => (1 : ZMod 2)) j • g j := by
    simp only [one_smul]
    exact Ω_eq_sum_g
  rw [θ_grey (fun _ => 1) _ f hΩ, greyVec_one, dotProduct_zero]

/-! ### From `CFSG/Monster/Code/LatticeBasic.lean` -/

def normSq (u : Fin 24 → ℤ) : ℤ := ∑ i, u i * u i

theorem codeForm_self (u : Fin 24 → ℤ) :
    codeForm (fun i => (u i : ℚ)) (fun i => (u i : ℚ)) = (normSq u : ℚ) / 8 := by
  unfold codeForm normSq
  push_cast
  rfl

theorem codeForm_self_eq_four_iff (u : Fin 24 → ℤ) :
    codeForm (fun i => (u i : ℚ)) (fun i => (u i : ℚ)) = 4 ↔ normSq u = 32 := by
  rw [codeForm_self]
  constructor
  · intro h
    have : (normSq u : ℚ) = 32 := by linarith
    exact_mod_cast this
  · intro h
    rw [h]
    norm_num

def eℤ (i : Fin 24) : Fin 24 → ℤ := Pi.single i 1

/-! ### From `CFSG/Monster/Code/LatticeShort.lean` -/

private theorem val_zero' : (0 : ZMod 2).val = 0 := rfl

private theorem val_one' : (1 : ZMod 2).val = 1 := rfl

private theorem bitLift_zero' : bitLift 0 = 0 := rfl

private theorem bitLift_one' : bitLift 1 = 1 := rfl

def oddMin (i : Fin 24) (d : Fin 24 → ZMod 2) : Fin 24 → ℤ :=
  fun j => (-1) ^ (d j).val * (1 - 4 * if j = i then 1 else 0)

def minFamily₃ : Set (Fin 24 → ℤ) := {u | ∃ i : Fin 24, ∃ d ∈ C, u = oddMin i d}

theorem mem_minVecs_iff {u : Fin 24 → ℤ} : u ∈ minVecs ↔ u ∈ codeLattice C ∧ normSq u = 32 := by
  show (u ∈ codeLattice C ∧ _) ↔ _
  rw [codeForm_self_eq_four_iff]

private theorem odd_sq (x : ℤ) (hx : x % 2 = 1) : ∃ t, 0 ≤ t ∧ x * x = 1 + 8 * t := by
  obtain ⟨q, rfl⟩ : ∃ q, x = 2 * q + 1 := ⟨x / 2, by omega⟩
  obtain ⟨r, hr⟩ := Int.even_mul_succ_self q
  have hq : 0 ≤ q * (q + 1) := by
    rcases le_or_gt 0 q with h | h
    · positivity
    · nlinarith
  refine ⟨r, by linarith, ?_⟩
  linear_combination 4 * hr

private theorem sq_par (x : ℤ) : (x * x - x) % 2 = 0 := by
  have h := Int.even_mul_pred_self x
  rw [Int.even_iff] at h
  have e : x * x - x = x * (x - 1) := by ring
  rw [e]
  exact h

theorem normSq_nonneg (u : Fin 24 → ℤ) : 0 ≤ normSq u :=
  Finset.sum_nonneg fun i _ => mul_self_nonneg (u i)

theorem normSq_pos {u : Fin 24 → ℤ} (h : u ≠ 0) : 0 < normSq u := by
  obtain ⟨i, hi⟩ : ∃ i, u i ≠ 0 := Function.ne_iff.1 h
  have h1 : 0 < u i * u i := mul_self_pos.2 hi
  have h2 : u i * u i ≤ normSq u :=
    Finset.single_le_sum (f := fun i => u i * u i) (fun j _ => mul_self_nonneg (u j))
      (Finset.mem_univ i)
  linarith

theorem normSq_ge {u : Fin 24 → ℤ} (hu : u ∈ codeLattice C) (h0 : u ≠ 0) : 32 ≤ normSq u := by
  have h16 := sum_mul_self_emod_sixteen (C := C) (fun d hd => weight_mod_four hd) hu
  have hpos := normSq_pos h0
  have h16' : normSq u % 16 = 0 := h16
  rcases lt_or_ge (normSq u) 32 with hlt | hge
  swap
  · exact hge
  exfalso
  have hn : normSq u = 16 := by omega
  obtain ⟨m, hm, d, hd, hud, hus⟩ := hu
  rcases hm with rfl | rfl
  · by_cases hd0 : d = 0
    · subst hd0
      obtain ⟨w, hw⟩ : ∃ w : Fin 24 → ℤ, ∀ i, u i = 4 * w i := ⟨fun i => u i / 4, fun i => by
        have h := hud i
        unfold Int.ModEq at h
        simp only [Pi.zero_apply, bitLift_zero', mul_zero, add_zero] at h
        show u i = 4 * (u i / 4)
        omega⟩
      have hsq : ∑ i, w i * w i = 1 := by
        have h : normSq u = ∑ i, 16 * (w i * w i) :=
          Finset.sum_congr rfl fun i _ => by rw [hw i]; ring
        rw [← Finset.mul_sum, hn] at h
        omega
      have hpar : Even (∑ i, (w i * w i - w i)) :=
        Finset.even_sum _ fun i _ => Int.even_iff.2 (sq_par (w i))
      rw [Int.even_iff, Finset.sum_sub_distrib, hsq] at hpar
      have hs : ∑ i, u i = 4 * ∑ i, w i := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun i _ => hw i
      rw [hs, mul_zero] at hus
      unfold Int.ModEq at hus
      omega
    · have hw8 : 8 ≤ hammingNorm d := eight_le_wt hd hd0
      have hlow : ∀ i, 4 * bitLift (d i) ≤ u i * u i := fun i => by
        have h := hud i
        unfold Int.ModEq at h
        rcases bitLift_zero_or_one (d i) with hb | hb
        · rw [hb]; simpa using mul_self_nonneg (u i)
        · rw [hb] at h ⊢
          have : u i ≥ 2 ∨ u i ≤ -2 := by omega
          rcases this with h' | h' <;> nlinarith
      have h := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => hlow i
      rw [← Finset.mul_sum, sum_bitLift] at h
      have : (8 : ℤ) ≤ hammingNorm d := by exact_mod_cast hw8
      change 4 * (hammingNorm d : ℤ) ≤ normSq u at h
      linarith
  · have hodd : ∀ i, u i % 2 = 1 := fun i => by
      have h := hud i
      unfold Int.ModEq at h
      have := bitLift_zero_or_one (d i)
      omega
    have h1 : ∀ i, 1 ≤ u i * u i := fun i => by
      obtain ⟨t, ht0, ht⟩ := odd_sq (u i) (hodd i)
      linarith
    have h := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) => h1 i
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
      Nat.cast_ofNat, mul_one] at h
    change (24 : ℤ) ≤ normSq u at h
    linarith

private theorem neg_one_pow_val (t : ZMod 2) : ((-1 : ℤ) ^ t.val) = 1 - 2 * bitLift t := by
  rcases zmod2_cases t with rfl | rfl
  · rw [val_zero', bitLift_zero']; norm_num
  · rw [val_one', bitLift_one']; norm_num

theorem minFamily₃_subset : minFamily₃ ⊆ minVecs := by
  rintro u ⟨i, d, hd, rfl⟩
  have hcoord : ∀ j, oddMin i d j = (1 - 2 * bitLift (d j)) * (1 - 4 * if j = i then 1 else 0) :=
    fun j => by rw [oddMin, neg_one_pow_val]
  have hn : normSq (oddMin i d) = 32 := by
    have hsq : ∀ j, oddMin i d j * oddMin i d j = 1 + 8 * (if j = i then 1 else 0) := fun j => by
      rw [hcoord j]
      rcases bitLift_zero_or_one (d j) with hb | hb <;> rw [hb] <;> split_ifs <;> norm_num
    rw [normSq, Finset.sum_congr rfl fun j _ => hsq j, Finset.sum_add_distrib, ← Finset.mul_sum]
    simp
  refine mem_minVecs_iff.2 ⟨⟨1, .inr rfl, d, hd, fun j => ?_, ?_⟩, hn⟩
  · unfold Int.ModEq
    rw [hcoord j]
    rcases bitLift_zero_or_one (d j) with hb | hb <;> rw [hb] <;> split_ifs <;> norm_num
  ·
    have hs : ∑ j, oddMin i d j = 24 - 2 * hammingNorm d - 4 * (1 - 2 * bitLift (d i)) := by
      have e : ∀ j, oddMin i d j =
          (1 - 2 * bitLift (d j)) - 4 * (if j = i then (1 - 2 * bitLift (d i)) else 0) := fun j => by
        rw [hcoord j]
        split_ifs with h
        · rw [h]; ring
        · ring
      rw [Finset.sum_congr rfl fun j _ => e j, Finset.sum_sub_distrib, Finset.sum_sub_distrib,
        ← Finset.mul_sum, sum_bitLift, ← Finset.mul_sum, Finset.sum_ite_eq']
      simp
    rw [hs]
    obtain ⟨k, hk⟩ := four_dvd_wt hd
    rw [hk]
    unfold Int.ModEq
    push_cast
    have := bitLift_zero_or_one (d i)
    omega

/-! ### From `CFSG/Monster/Code/LatticeCount.lean` -/

theorem normSq_add_sub (u v : Fin 24 → ℤ) :
    normSq (u + v) + normSq (u - v) = 2 * normSq u + 2 * normSq v := by
  simp only [normSq, Pi.add_apply, Pi.sub_apply, Finset.mul_sum, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun i _ => by ring

theorem normSq_two_smul (w : Fin 24 → ℤ) : normSq ((2 : ℤ) • w) = 4 * normSq w := by
  simp only [normSq, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun i _ => by ring

theorem normSq_eq_zero {u : Fin 24 → ℤ} (h : normSq u = 0) : u = 0 := by
  by_contra h0
  have := normSq_pos h0
  omega

theorem eq_or_eq_neg_of_sub_mem {u v : Fin 24 → ℤ} (hu : u ∈ minVecs) (hv : v ∈ minVecs)
    {w : Fin 24 → ℤ} (hw : w ∈ codeLattice C) (huv : (2 : ℤ) • w = u - v) : v = u ∨ v = -u := by
  have hu32 := (mem_minVecs_iff.1 hu).2
  have hv32 := (mem_minVecs_iff.1 hv).2
  by_cases hw0 : w = 0
  · left
    rw [hw0, smul_zero, eq_comm, sub_eq_zero] at huv
    exact huv.symm
  · right
    have h32 := normSq_ge hw hw0
    have h1 := normSq_add_sub u v
    rw [← huv, normSq_two_smul, hu32, hv32] at h1
    have h2 := normSq_nonneg (u + v)
    have h3 : normSq (u + v) = 0 := by linarith
    exact eq_neg_of_add_eq_zero_right (normSq_eq_zero h3)

theorem minVecs_ne_zero {u : Fin 24 → ℤ} (hu : u ∈ minVecs) : u ≠ 0 := by
  intro h
  have := (mem_minVecs_iff.1 hu).2
  rw [h] at this
  simp [normSq] at this

theorem neg_mem_minVecs {u : Fin 24 → ℤ} (hu : u ∈ minVecs) : -u ∈ minVecs := by
  obtain ⟨hL, hn⟩ := mem_minVecs_iff.1 hu
  refine mem_minVecs_iff.2 ⟨neg_mem_codeLattice allOnes_mem_C hL, ?_⟩
  rw [← hn, normSq, normSq]
  simp

theorem neg_ne_self_of_mem_minVecs {u : Fin 24 → ℤ} (hu : u ∈ minVecs) : -u ≠ u := by
  intro h
  apply minVecs_ne_zero hu
  have h2 : u + u = 0 := by nth_rewrite 1 [← h]; exact neg_add_cancel u
  rw [← two_smul ℕ u] at h2
  exact (smul_eq_zero.1 h2).resolve_left (by norm_num)

theorem classOf_eq_iff {u v : Fin 24 → ℤ} (hu : u ∈ minVecs) (hv : v ∈ minVecs) :
    classOf u = classOf v ↔ v = u ∨ v = -u := by
  simp only [classOf, dif_pos hu.1, dif_pos hv.1]
  rw [Submodule.Quotient.eq, mem_two_range_iff]
  constructor
  · rintro ⟨w, hw⟩
    exact eq_or_eq_neg_of_sub_mem hu hv w.2 hw
  · rintro (rfl | rfl)
    · exact ⟨0, by simp⟩
    · refine ⟨⟨u, hu.1⟩, ?_⟩
      simp only [AddSubgroupClass.coe_sub]
      rw [two_smul, sub_neg_eq_add]

/-! ### From `CFSG/Monster/Code/LatticeGen.lean` -/

def lam0 : Fin 24 → ℤ := fun i => 1 - 4 * eℤ 0 i

def latticeGens : Set (Fin 24 → ℤ) :=
  {u | ∃ i j : Fin 24, i < j ∧ (u = (4 : ℤ) • (eℤ i - eℤ j) ∨ u = (4 : ℤ) • (eℤ i + eℤ j))} ∪
    Set.range (fun j : Fin 12 => (2 : ℤ) • liftℤ (B j)) ∪ {lam0}

private theorem sum_eℤ (i : Fin 24) : ∑ k, eℤ i k = 1 := by
  simp [eℤ]

private theorem sum_mul_eℤ (k : Fin 24 → ℤ) (c : Fin 24) : ∑ i, k i * eℤ i c = k c := by
  simp [eℤ, Pi.single_apply]

private theorem sum_lam0 : ∑ i, lam0 i = 20 := by decide +kernel

private theorem normSq_pm : ∀ i j : Fin 24, i ≠ j →
    normSq ((4 : ℤ) • (eℤ i - eℤ j)) = 32 ∧ normSq ((4 : ℤ) • (eℤ i + eℤ j)) = 32 := by
  decide +kernel

private theorem normSq_B : ∀ j : Fin 12, normSq ((2 : ℤ) • liftℤ (B j)) = 32 := by
  intro j
  rw [B_eq_bvec]
  revert j
  decide +kernel

private theorem normSq_lam0 : normSq lam0 = 32 := by decide +kernel

theorem latticeGens_mem {u : Fin 24 → ℤ} (hu : u ∈ latticeGens) :
    u ∈ codeLattice C ∧ normSq u = 32 := by
  rcases hu with (⟨i, j, hij, rfl | rfl⟩ | ⟨j, rfl⟩) | rfl
  · refine ⟨⟨0, .inl rfl, 0, C.zero_mem, fun k => ?_, ?_⟩, (normSq_pm i j (ne_of_lt hij)).1⟩
    · simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply, bitLift, ZMod.val_zero,
        Nat.cast_zero, mul_zero, add_zero]
      exact Int.modEq_zero_iff_dvd.2 (Dvd.intro _ rfl)
    · simp only [Pi.smul_apply, smul_eq_mul, Pi.sub_apply, ← Finset.mul_sum,
        Finset.sum_sub_distrib, sum_eℤ, sub_self, mul_zero]
      rfl
  · refine ⟨⟨0, .inl rfl, 0, C.zero_mem, fun k => ?_, ?_⟩, (normSq_pm i j (ne_of_lt hij)).2⟩
    · simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply, bitLift, ZMod.val_zero,
        Nat.cast_zero, mul_zero, add_zero]
      exact Int.modEq_zero_iff_dvd.2 (Dvd.intro _ rfl)
    · simp only [Pi.smul_apply, smul_eq_mul, Pi.add_apply, ← Finset.mul_sum,
        Finset.sum_add_distrib, sum_eℤ]
      decide
  · refine ⟨⟨0, .inl rfl, B j, B_mem_C j, fun k => ?_, ?_⟩, normSq_B j⟩
    · simp only [Pi.smul_apply, smul_eq_mul, liftℤ, zero_add]
      rfl
    · simp only [Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum, sum_liftℤ, wt_B, mul_zero]
      decide
  · refine ⟨⟨1, .inr rfl, 0, C.zero_mem, fun k => ?_, ?_⟩, normSq_lam0⟩
    · simp only [lam0, Pi.zero_apply, bitLift, ZMod.val_zero, Nat.cast_zero, mul_zero, add_zero]
      unfold Int.ModEq
      omega
    · rw [sum_lam0]
      decide

theorem four_smul_mem_closure (k : Fin 24 → ℤ) (hk : Even (∑ i, k i)) :
    (4 : ℤ) • k ∈ AddSubgroup.closure latticeGens := by
  set S := AddSubgroup.closure latticeGens
  have hdiff : ∀ i, (4 : ℤ) • (eℤ i - eℤ 0) ∈ S := by
    intro i
    rcases eq_or_ne i 0 with rfl | hi
    · rw [sub_self, smul_zero]
      exact S.zero_mem
    · have h := S.neg_mem (AddSubgroup.subset_closure
        (Or.inl (Or.inl ⟨0, i, Fin.pos_iff_ne_zero.2 hi, Or.inl rfl⟩)))
      rwa [← smul_neg, neg_sub] at h
  have h8 : (8 : ℤ) • eℤ 0 ∈ S := by
    have h1 : (4 : ℤ) • (eℤ 0 + eℤ 1) ∈ S :=
      AddSubgroup.subset_closure (Or.inl (Or.inl ⟨0, 1, by decide, Or.inr rfl⟩))
    have h2 : (4 : ℤ) • (eℤ 0 - eℤ 1) ∈ S :=
      AddSubgroup.subset_closure (Or.inl (Or.inl ⟨0, 1, by decide, Or.inl rfl⟩))
    have : (8 : ℤ) • eℤ 0 = (4 : ℤ) • (eℤ 0 + eℤ 1) + (4 : ℤ) • (eℤ 0 - eℤ 1) := by
      rw [← smul_add, add_add_sub_cancel, ← two_smul ℤ (eℤ 0), smul_smul]
      norm_num
    rw [this]
    exact S.add_mem h1 h2
  obtain ⟨t, ht⟩ := hk
  have key : (4 : ℤ) • k = ∑ i, k i • ((4 : ℤ) • (eℤ i - eℤ 0)) + t • ((8 : ℤ) • eℤ 0) := by
    funext c
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.sub_apply]
    have h : ∑ i, k i * (4 * (eℤ i c - eℤ 0 c)) =
        4 * ∑ i, k i * eℤ i c - 4 * (∑ i, k i) * eℤ 0 c := by
      rw [Finset.mul_sum, Finset.mul_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [h, sum_mul_eℤ, ht]
    ring
  rw [key]
  exact S.add_mem (S.sum_mem fun i _ => S.zsmul_mem (hdiff i) _) (S.zsmul_mem h8 _)

private theorem bitLift_modEq_sum (d : Fin 24 → ZMod 2) (c : Fin 12 → ZMod 2)
    (hd : d = ∑ j, c j • B j) (i : Fin 24) :
    bitLift (d i) ≡ ∑ j, ((c j).val : ℤ) * bitLift (B j i) [ZMOD 2] := by
  have h : ((bitLift (d i) : ℤ) : ZMod 2) = ((∑ j, ((c j).val : ℤ) * bitLift (B j i) : ℤ) : ZMod 2) := by
    push_cast
    simp only [bitLift_cast, ZMod.natCast_val, ZMod.cast_id', id]
    rw [hd, Finset.sum_apply]
    simp only [Pi.smul_apply, smul_eq_mul]
  exact (ZMod.intCast_eq_intCast_iff _ _ 2).1 h

theorem mem_closure_of_even (u : Fin 24 → ℤ) {d : Fin 24 → ZMod 2} (hd : d ∈ C)
    (hud : ∀ i, u i ≡ 2 * bitLift (d i) [ZMOD 4]) (hus : ∑ i, u i ≡ 0 [ZMOD 8]) :
    u ∈ AddSubgroup.closure latticeGens := by
  set S := AddSubgroup.closure latticeGens
  set c := ψ d
  set v : Fin 24 → ℤ := ∑ j, ((c j).val : ℤ) • ((2 : ℤ) • liftℤ (B j)) with hvdef
  have hv : v ∈ S := S.sum_mem fun j _ =>
    S.zsmul_mem (AddSubgroup.subset_closure (Or.inl (Or.inr ⟨j, rfl⟩))) _
  have hvi : ∀ i, v i = 2 * ∑ j, ((c j).val : ℤ) * bitLift (B j i) := by
    intro i
    simp only [hvdef, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, liftℤ, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  have hsumv : ∑ i, v i = 16 * ∑ j, ((c j).val : ℤ) := by
    simp only [hvi, ← Finset.mul_sum]
    rw [Finset.sum_comm]
    simp only [← Finset.mul_sum]
    have : ∀ j : Fin 12, ∑ i, bitLift (B j i) = 8 := fun j => by
      have := sum_liftℤ (B j)
      rw [wt_B] at this
      exact_mod_cast this
    simp only [this, Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  have hmod : ∀ i, (u i - v i) % 4 = 0 := by
    intro i
    have h1 := hud i
    have h2 := bitLift_modEq_sum d c (eq_comb_of_mem_C hd) i
    rw [hvi]
    unfold Int.ModEq at h1 h2
    omega
  set k : Fin 24 → ℤ := fun i => (u i - v i) / 4
  have huv : u = v + (4 : ℤ) • k := by
    funext i
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, k]
    have := hmod i
    omega
  have hk : Even (∑ i, k i) := by
    have hs : ∑ i, u i = ∑ i, v i + 4 * ∑ i, k i := by
      conv_lhs => rw [huv]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib,
        Finset.mul_sum]
    rw [hs, hsumv] at hus
    unfold Int.ModEq at hus
    rw [Int.even_iff]
    omega
  rw [huv]
  exact S.add_mem hv (four_smul_mem_closure k hk)

theorem mem_closure_of_mem_codeLattice {u : Fin 24 → ℤ} (hu : u ∈ codeLattice C) :
    u ∈ AddSubgroup.closure latticeGens := by
  obtain ⟨m, hm, d, hd, hud, hus⟩ := hu
  rcases hm with rfl | rfl
  · exact mem_closure_of_even u hd (fun i => by simpa using hud i) (by simpa using hus)
  · have h := mem_closure_of_even (u - lam0) hd (fun i => by
        have h1 := hud i
        simp only [Pi.sub_apply, lam0]
        unfold Int.ModEq at h1 ⊢
        have : eℤ 0 i = 0 ∨ eℤ 0 i = 1 := by
          simp only [eℤ, Pi.single_apply]; split_ifs <;> simp
        omega) (by
        have hs : ∑ i, (u - lam0) i = ∑ i, u i - 20 := by
          rw [← sum_lam0, ← Finset.sum_sub_distrib]; rfl
        rw [hs]
        unfold Int.ModEq at hus ⊢
        omega)
    have : u = (u - lam0) + lam0 := by abel
    rw [this]
    exact (AddSubgroup.closure latticeGens).add_mem h (AddSubgroup.subset_closure (Or.inr rfl))

theorem closure_latticeGens :
    AddSubgroup.closure latticeGens = codeLatticeSubgroup allOnes_mem_C := by
  refine le_antisymm ((AddSubgroup.closure_le _).2 fun u hu => (latticeGens_mem hu).1)
    fun u hu => mem_closure_of_mem_codeLattice hu

