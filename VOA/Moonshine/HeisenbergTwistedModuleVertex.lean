import VOA.Moonshine.HeisenbergTwistedModuleLocality

/-!
# The twisted vertex operator on all of `V = FockN r`  (Moonshine step M6a)

A candidate for the `σ`-twisted vertex operator `Y^T(u, z)` of the level-one Heisenberg VOA on
`S[θ] = FockT r`, defined on **every** state, together with every structural property of
`TwistedModule` except the Jacobi identity, which is reduced to the twisted product formula.

## The definition (Li's twisted products, inverted)

The DLM twisted Jacobi identity for a generator `a = h_a(−1)𝟙 ∈ 𝒱¹` and any `w` is equivalent
(`TwistedReduction`) to the **twisted product formula**
`Fgen_a ₍ℓ₎ Ỹ(w) = Σ_t C(½,t) z^{−t} Ỹ(a₍ℓ₊ₜ₎w)` for the rescaled fields; it inverts to

  `Ỹ(h_a(−n−1) w) = Σ_{i ≥ 0} C(−½, i) z^{−i} · Fgen_a ₍₋ₙ₋₁₊ᵢ₎ Ỹ(w)`.

`Ywt r l` implements this recursively on words `l` (finite cut-off `n + 3 + 2·wt(w)`, beyond which
the products vanish for the true module).  The terms `i ≥ n + 1` use the *nonnegative* products
`Fgen_a ₍ⱼ₎ Ỹ(w)` (contractions); they are exactly the FLM `Δ_z` corrections.  A monomial is read
through its canonical word `monoWordN m`, and a word of length `d` carries offset `d`:
`YT r (monomial m 1) k = mode (Ywt r (monoWordN m)) ((k − d)/2)` for `k ≡ d (mod 2)`, else `0`.

## What is proved
* `YT_vacuum` — `Y^T(𝟙, z) = id` (the `vacuum_YM` field, `N = 2`).
* `YT_X` — `Y^T(h_a(−1)𝟙, z) = h_a(z)`: the generators go to the twisted Heisenberg fields.
* `YT_truncation` — lower truncation for every state.
* `YT_support` — **the support condition 5.3.22a** for `σ`: for `u ∈ 𝒱ʲ`,
  `Y^T(u)₍k/2₎ = 0` unless `k ≡ j (mod 2)`.
* `resc_YT_mem` / `YT_local` — every rescaled field of every state, on every residue class, lies
  in the twisted system generated by the `Fgen r a`; hence **all of them are mutually local**.
* `twistedJacobi_generators_nonneg_YT` — the generator Jacobi identity at `ℓ ≥ 0` for `YT`.
* `twistedJacobi_YT_of_productFormula` — **the remaining content, isolated**: the corrected
  twisted Jacobi identity `TwistedJacobi (sigma1 r) 2 (YT r)` follows from the twisted product
  formula `hpf` for all pairs.  `hpf` is not proved in this file; it is discharged in
  `HeisenbergTwistedModuleProductFormula.lean` (`productFormula_YT`), giving `twistedJacobi_YT`
  and the instance `heisTwistedModule` (`HeisenbergTwistedModuleInstance.lean`).

## Status
All declarations `sorry`-free; `#print axioms` gives `[propext, Classical.choice, Quot.sound]`.
**Not proved in this file** (proved downstream, see above): the product formula `hpf` beyond the
generator pairs at `ℓ ≥ 0`; in particular neither word-order independence of `Ywt` (the canonical word `monoWordN m` enumerates
`m.support` by `Finset.toList`, an unspecified order, so even the quadratic states need it) nor
the Jacobi identity for composite states.  The `L0_weight` field `YT ω 2 = L0T r` is proved in
`HeisenbergTwistedModuleL0`.
-/

namespace VOA

namespace Moonshine

open MvPolynomial TwistedHeisenberg HeisenbergN TwistedReduction
open Module (End)

variable (r : ℕ)

/-! ## Words and identity-field products -/

/-- `a ₍₋₁₎ 1 = a`. -/
theorem prod_one_right_neg_one (a : Fld (FockT r)) : (Fld.prod (-1) a Fld.one).1 = a.1 := by
  rw [Fld.prod_of_neg (by norm_num)]
  change negProd a.2 (idField_isField (V := FockT r)) 0 = a.1
  rw [negProd, Nat.factorial_zero, Nat.cast_one, inv_one, one_smul]
  exact nprod_idField a.2

/-- `a ₍ⱼ₎ 1 = 0` for `j ≥ 0`. -/
theorem prod_one_right_nonneg (a : Fld (FockT r)) {j : ℤ} (hj : 0 ≤ j) :
    (Fld.prod j a Fld.one).1 = 0 := by
  rw [Fld.prod_of_nonneg hj]
  have h0 : bracketDist a.1 (Fld.one : Fld (FockT r)).1 = 0 := by
    apply FormalDist₂.ext; intro m n
    rw [bracketDist_apply, Fld.one_val, idField_apply]
    change _ = (0 : End ℂ (FockT r))
    split_ifs
    · change a.1 m * 1 - 1 * a.1 m = 0
      rw [mul_one, one_mul, sub_self]
    · rw [mul_zero, zero_mul, sub_zero]
  rw [h0]
  funext n
  rw [cCoeff_apply, map_zero]
  rfl

/-- The length of the canonical word of a monomial. -/
theorem length_monoWordN (m : (ℕ × Fin r) →₀ ℕ) : (monoWordN m).length = m.degree := by
  classical
  rw [monoWordN, List.length_flatMap]
  simp only [List.length_replicate]
  rw [Finset.sum_map_toList, Finsupp.degree_apply]

/-! ## The rescaled twisted word fields -/

/-- **The rescaled twisted field of a word** (offset = word length), by inverting the twisted
product formula against the generators:
`Ỹ((n,a) :: w) = Σ_{i < n+3+2·wt w} C(−½, i) · z^{−i} · (Fgen_a ₍₋ₙ₋₁₊ᵢ₎ Ỹ(w))`. -/
noncomputable def Ywt : List (ℕ × Fin r) → Fld (FockT r)
  | [] => Fld.one
  | (c :: w) => ∑ i ∈ Finset.range (c.1 + 3 + 2 * wordWeightNN w),
      cbinom (-1 / 2) i • fzmul (-(i : ℤ)) (Fld.prod (-(c.1 : ℤ) - 1 + i) (FgenFld r c.2) (Ywt w))

@[simp] theorem Ywt_nil : Ywt r [] = Fld.one := rfl

theorem Ywt_cons (c : ℕ × Fin r) (w : List (ℕ × Fin r)) :
    Ywt r (c :: w) = ∑ i ∈ Finset.range (c.1 + 3 + 2 * wordWeightNN w),
      cbinom (-1 / 2) i •
        fzmul (-(i : ℤ)) (Fld.prod (-(c.1 : ℤ) - 1 + i) (FgenFld r c.2) (Ywt r w)) :=
  rfl

/-- Every word field lies in the twisted system generated by the `Fgen r a`. -/
theorem Ywt_mem (l : List (ℕ × Fin r)) : Ywt r l ∈ TGenerated (genSet r) := by
  induction l with
  | nil => exact one_mem_tgenerated _
  | cons c w ih =>
      rw [Ywt_cons]
      refine Finset.sum_induction _ (· ∈ TGenerated (genSet r)) (fun a b ha hb =>
        add_mem_tgenerated ha hb) (zero_mem_tgenerated _) (fun i _ => ?_)
      exact smul_mem_tgenerated _ (fzmul_mem_tgenerated _
        (prod_mem_tgenerated _ (subset_tgenerated ⟨c.2, rfl⟩) ih))

/-- The single-letter word `[(0,a)]` gives back the generator field. -/
theorem Ywt_single (a : Fin r) : Ywt r [((0 : ℕ), a)] = FgenFld r a := by
  rw [Ywt_cons, Finset.sum_eq_single 0]
  · apply Subtype.ext
    rw [Fld.smul_val, fzmul_val, cbinom_zero, one_smul, Ywt_nil]
    simp only [Nat.cast_zero, neg_zero, add_zero, zero_sub]
    rw [prod_one_right_neg_one]
    funext n
    simp [zmul]
  · intro i _ hi
    apply Subtype.ext
    rw [Fld.smul_val, fzmul_val, Ywt_nil, prod_one_right_nonneg r _ (by simp; omega)]
    change cbinom (-1 / 2) i • zmul (-(i : ℤ)) (0 : FormalDist (End ℂ (FockT r))) = 0
    rw [show zmul (-(i : ℤ)) (0 : FormalDist (End ℂ (FockT r))) = 0 from rfl, smul_zero]
  · intro h
    simp at h

/-! ## The twisted vertex operator -/

/-- The fractional-mode family of a monomial: `k ↦ mode (Ỹ(word)) ((k − d)/2)` on `k ≡ d`. -/
noncomputable def YTmon (m : (ℕ × Fin r) →₀ ℕ) : ℤ → End ℂ (FockT r) := fun k =>
  if (k - (monoWordN m).length) % 2 = 0 then
    mode (Ywt r (monoWordN m)).1 ((k - (monoWordN m).length) / 2)
  else 0

/-- **The candidate `σ`-twisted vertex operator** `Y^T : FockN r → (ℤ → End (FockT r))`
(`YT r u k = u₍k/2₎`), the linear extension of `YTmon` off the monomial basis. -/
noncomputable def YT : FockN r →ₗ[ℂ] (ℤ → End ℂ (FockT r)) :=
  Finsupp.linearCombination ℂ (YTmon r)

theorem YT_monomial (m : (ℕ × Fin r) →₀ ℕ) (c : ℂ) : YT r (monomial m c) = c • YTmon r m :=
  Finsupp.linearCombination_single ℂ c m

/-- **`Y^T(𝟙, z) = id`**: `YT 𝟙 k = δ_{k,−2}`. -/
theorem YT_vacuum (k : ℤ) : YT r (vacuumN r) k = if k = -2 then 1 else 0 := by
  rw [vacuumN, show (1 : FockN r) = monomial 0 1 by rw [monomial_zero', map_one], YT_monomial,
    one_smul, YTmon, monoWordN_zero, Ywt_nil, Fld.one_val]
  simp only [List.length_nil, Nat.cast_zero, sub_zero]
  split_ifs with h1 h2 h2
  · rw [mode_apply, idField_apply, if_pos (by omega)]; rfl
  · rw [mode_apply, idField_apply, if_neg (by omega)]
  · omega
  · rfl

/-- **`Y^T(h_a(−1)𝟙, z) = h_a(z)`**: the generators go to the twisted Heisenberg fields. -/
theorem YT_X (a : Fin r) : YT r (X (0, a)) = modeT r a := by
  rw [X_zero_eq_monomialN, YT_monomial, one_smul]
  funext k
  rw [YTmon, monoWordN_single, Ywt_single, FgenFld_val]
  simp only [List.length_singleton, Nat.cast_one]
  split_ifs with h
  · rw [mode_Fgen]; congr 1; omega
  · rw [modeT_even]; omega

/-! ## Truncation -/

theorem YTmon_truncation (m : (ℕ × Fin r) →₀ ℕ) (x : FockT r) :
    ∃ K : ℤ, ∀ k : ℤ, K ≤ k → YTmon r m k x = 0 := by
  obtain ⟨B, hB⟩ := (Ywt r (monoWordN m)).2 x
  refine ⟨(monoWordN m).length - 2 * B, fun k hk => ?_⟩
  rw [YTmon]
  split_ifs with h
  · rw [mode_apply]; exact hB _ (by omega)
  · rfl

/-- **Lower truncation** of the twisted vertex operator, for every state. -/
theorem YT_truncation (u : FockN r) (x : FockT r) :
    ∃ K : ℤ, ∀ k : ℤ, K ≤ k → YT r u k x = 0 := by
  induction u using MvPolynomial.induction_on' with
  | monomial m c =>
      obtain ⟨K, hK⟩ := YTmon_truncation r m x
      refine ⟨K, fun k hk => ?_⟩
      rw [YT_monomial]
      change c • YTmon r m k x = 0
      rw [hK k hk, smul_zero]
  | add p q hp hq =>
      obtain ⟨K₁, h₁⟩ := hp
      obtain ⟨K₂, h₂⟩ := hq
      refine ⟨max K₁ K₂, fun k hk => ?_⟩
      rw [map_add]
      change YT r p k x + YT r q k x = 0
      rw [h₁ k (le_of_max_le_left hk), h₂ k (le_of_max_le_right hk), add_zero]

/-! ## The support condition -/

/-- `σ` on a monomial in terms of its canonical word length. -/
theorem sigmaN_monomial_length (m : (ℕ × Fin r) →₀ ℕ) :
    LatGen.sigmaN r (monomial m 1) = ((-1 : ℂ) ^ (monoWordN m).length) • monomial m 1 := by
  rw [← wordStateN_monoWordN, sigmaN_wordStateN']

/-- The coefficients of `σ u`. -/
theorem coeff_sigmaN (m : (ℕ × Fin r) →₀ ℕ) (u : FockN r) :
    coeff m (LatGen.sigmaN r u) = ((-1 : ℂ) ^ (monoWordN m).length) * coeff m u := by
  induction u using MvPolynomial.induction_on' with
  | monomial m' c =>
      rw [show (monomial m' c : FockN r) = c • monomial m' 1 by
        rw [smul_monomial, smul_eq_mul, mul_one], map_smul, sigmaN_monomial_length, smul_smul]
      simp only [coeff_smul, coeff_monomial]
      by_cases h : m' = m
      · subst h; simp only [if_true, smul_eq_mul, mul_one]; ring
      · simp [h]
  | add p q hp hq => rw [map_add, coeff_add, coeff_add, hp, hq, mul_add]

/-- A `σ`-eigenvector of eigenvalue `(−1)ʲ` only contains monomials of word length `≡ j`. -/
theorem length_parity_of_mem {j : ℕ} {u : FockN r}
    (hu : u ∈ (sigma1 r).twistedEigenspace 2 j) {m : (ℕ × Fin r) →₀ ℕ} (hm : coeff m u ≠ 0) :
    ((monoWordN m).length : ℤ) % 2 = (j : ℤ) % 2 := by
  rw [mem_twistedEigenspace_two_iff] at hu
  have h := congrArg (coeff m) hu
  rw [coeff_sigmaN, coeff_smul, smul_eq_mul] at h
  have h' : (-1 : ℂ) ^ (monoWordN m).length = (-1 : ℂ) ^ j := mul_right_cancel₀ hm h
  rcases Nat.even_or_odd (monoWordN m).length with he | ho <;>
    rcases Nat.even_or_odd j with hj | hj
  · rw [Int.even_iff.mp (by exact_mod_cast he), Int.even_iff.mp (by exact_mod_cast hj)]
  · rw [he.neg_one_pow, hj.neg_one_pow] at h'; norm_num at h'
  · rw [ho.neg_one_pow, hj.neg_one_pow] at h'; norm_num at h'
  · rw [Int.odd_iff.mp (by exact_mod_cast ho), Int.odd_iff.mp (by exact_mod_cast hj)]

/-- `YT u` as the finite sum over the monomials of `u`. -/
theorem YT_eq_sum (u : FockN r) :
    YT r u = ∑ m ∈ u.support, coeff m u • YTmon r m := by
  rw [show YT r u = Finsupp.linearCombination ℂ (YTmon r) u from rfl,
    Finsupp.linearCombination_apply]
  rfl

/-- **The support condition (5.3.22a)** for the involution `σ`: for `u ∈ 𝒱ʲ`, the fractional
modes `u₍k/2₎` vanish unless `k ≡ −j (mod 2)`. -/
theorem YT_support (j : ℕ) (u : FockN r) (hu : u ∈ (sigma1 r).twistedEigenspace 2 j)
    (k : ℤ) (hk : (k + j) % ((2 : ℕ) : ℤ) ≠ 0) : YT r u k = 0 := by
  rw [YT_eq_sum, Finset.sum_apply]
  refine Finset.sum_eq_zero fun m hm => ?_
  have hpar := length_parity_of_mem r hu (mem_support_iff.mp hm)
  rw [Pi.smul_apply, YTmon, if_neg (by push_cast at hk; omega), smul_zero]

/-! ## Locality of all rescaled fields -/

theorem resc_add_fun (A B : ℤ → End ℂ (FockT r)) (N : ℕ) (e : ℤ) :
    resc (A + B) N e = resc A N e + resc B N e := rfl

theorem resc_smul_fun (c : ℂ) (A : ℤ → End ℂ (FockT r)) (N : ℕ) (e : ℤ) :
    resc (c • A) N e = c • resc A N e := rfl

/-- A formal distribution is determined by its modes. -/
theorem formalDist_ext_mode {f g : FormalDist (End ℂ (FockT r))}
    (h : ∀ p : ℤ, mode f p = mode g p) : f = g := by
  funext n
  have := h (-n - 1)
  rwa [mode_apply, mode_apply, show -(-n - 1) - 1 = n by ring] at this

/-- The rescaled field of a monomial on a residue class: a power of `z` times its word field, or
`0` off the class. -/
theorem resc_YTmon (m : (ℕ × Fin r) →₀ ℕ) (e : ℤ) :
    resc (YTmon r m) 2 e =
      if (e - (monoWordN m).length) % 2 = 0 then
        zmul ((e - (monoWordN m).length) / 2) (Ywt r (monoWordN m)).1
      else 0 := by
  apply formalDist_ext_mode r
  intro p
  rw [mode_resc, YTmon]
  split_ifs with h1 h2 h2
  · rw [mode_zmul]; congr 1; push_cast; omega
  · push_cast at h1; omega
  · push_cast at h1; omega
  · rfl

/-- **Every rescaled field of `Y^T`, on every residue class, lies in the twisted system
generated by the `Fgen r a`.** -/
theorem resc_YT_mem (u : FockN r) (e : ℤ) :
    ∃ F ∈ TGenerated (genSet r), resc (YT r u) 2 e = F.1 := by
  induction u using MvPolynomial.induction_on' with
  | monomial m c =>
      rw [YT_monomial, resc_smul_fun, resc_YTmon]
      split_ifs
      · exact ⟨c • fzmul _ (Ywt r (monoWordN m)),
          smul_mem_tgenerated _ (fzmul_mem_tgenerated _ (Ywt_mem r _)), rfl⟩
      · exact ⟨0, zero_mem_tgenerated _, by rw [smul_zero]; rfl⟩
  | add p q hp hq =>
      obtain ⟨F, hF, hFe⟩ := hp
      obtain ⟨G, hG, hGe⟩ := hq
      exact ⟨F + G, add_mem_tgenerated hF hG, by rw [map_add, resc_add_fun, hFe, hGe]; rfl⟩

/-- **All rescaled twisted vertex operators are mutually local**, for every pair of states and
every pair of residue classes. -/
theorem YT_local (u v : FockN r) (e e' : ℤ) :
    Local (resc (YT r u) 2 e) (resc (YT r v) 2 e') := by
  obtain ⟨F, hF, hFe⟩ := resc_YT_mem r u e
  obtain ⟨G, hG, hGe⟩ := resc_YT_mem r v e'
  rw [hFe, hGe]
  exact twistedSystem_local r hF hG

/-! ## Jacobi: the generators, and the reduction of the rest -/

/-- The generator Jacobi identity at `ℓ ≥ 0` for the concrete `Y^T`. -/
theorem twistedJacobi_generators_nonneg_YT (a b : Fin r) (x : FockT r) (ℓ k m : ℤ) (hℓ : 0 ≤ ℓ)
    (hk : (k + (1 : ℕ)) % ((2 : ℕ) : ℤ) = 0) :
    (∑ᶠ i : ℤ, (negOnePow i * cbz ℓ i) •
        (YT r (X (0, a)) (ℓ * (2 : ℕ) + k - i * (2 : ℕ)) (YT r (X (0, b)) (m + i * (2 : ℕ)) x)
          - negOnePow ℓ • YT r (X (0, b)) (ℓ * (2 : ℕ) + m - i * (2 : ℕ))
              (YT r (X (0, a)) (k + i * (2 : ℕ)) x)))
      = ∑ᶠ i : ℕ, cbinom ((k : ℂ) / (2 : ℕ)) i •
          YT r ((heisVOA1 r).smul (X (0, a)) (ℓ + i) (X (0, b))) (k + m - i * (2 : ℕ)) x :=
  twistedJacobi_generators_nonneg (YT r) (YT_truncation r) (YT_vacuum r) (YT_X r) a b x ℓ k m hℓ hk

/-- **The open content of M6, isolated.**  The corrected twisted Jacobi identity for `Y^T` holds
as soon as the twisted product formula `hpf` holds for every `u ∈ 𝒱ʲ` (offset `j`) and every `v`
(offset `e' ∈ {0,1}`).  Locality, the other input of the reduction, is discharged by `YT_local`.
**`hpf` is not proved in this file** — it is `productFormula_YT` downstream (only its generator, `ℓ ≥ 0` instance,
`pf_generators_nonneg`); this theorem only records exactly what remains. -/
theorem twistedJacobi_YT_of_productFormula
    (hpf : ∀ (j : ℕ) (u : FockN r), u ∈ (sigma1 r).twistedEigenspace 2 j → ∀ (v : FockN r)
      (e' : ℤ), 0 ≤ e' → e' < 2 → ∀ (ℓ s : ℤ) (x : FockT r),
      mode (Fld.prod ℓ (rescFld (by norm_num : 0 < 2) (YT_truncation r u) (j : ℤ))
          (rescFld (by norm_num : 0 < 2) (YT_truncation r v) e')).1 s x
        = ∑ᶠ t : ℕ, cbinom ((((j : ℤ) : ℤ) : ℂ) / (2 : ℕ)) t •
            YT r ((heisVOA1 r).smul u (ℓ + t) v) ((2 : ℕ) * (s - t) + (j : ℤ) + e') x) :
    TwistedJacobi (sigma1 r) 2 (YT r) :=
  twistedJacobi_of_local_pf (sigma1 r) (YT r) (by norm_num) (YT_truncation r)
    (fun j => (j : ℤ)) (fun j => by push_cast; omega)
    (fun j u _ v e' _ _ => YT_local r u v j e') hpf

end Moonshine

end VOA
