import VOA.Moonshine.MoonshineLRGenerationPositive

/-!
# Borcherds pre-data and the subalgebra generated by simple root spaces

`BorcherdsPreData g` has every field of `BorcherdsData g` except `generated`. For such data
`P`, the Lie subalgebra `P.simpleSpan` generated by the Cartan and the simple root spaces is
homogeneous (`simpleSpan_le_iSup`), so it inherits the grading (`isInternal_simpleSpanWeight`).
-/

noncomputable section

namespace VOA.Moonshine.ConwayNorton.M8

open Module

/-- Borcherds data without the generation field. -/
structure BorcherdsPreData (g : Type*) [LieRing g] [LieAlgebra ℂ g] where
  weightSpace : ℤ × ℤ → Submodule ℂ g
  weight_internal : DirectSum.IsInternal weightSpace
  weight_finite : ∀ γ, FiniteDimensional ℂ (weightSpace γ)
  bracket_weight : ∀ {γ δ} {x y : g},
    x ∈ weightSpace γ → y ∈ weightSpace δ → ⁅x, y⁆ ∈ weightSpace (γ + δ)
  cartanMap : (ℂ × ℂ) →ₗ[ℂ] g
  cartan_injective : Function.Injective cartanMap
  cartan_range : LinearMap.range cartanMap = weightSpace 0
  cartan_action : ∀ (ξ : ℂ × ℂ) (γ : ℤ × ℤ) (x : g), x ∈ weightSpace γ →
    ⁅cartanMap ξ, x⁆ = borcherdsCartanPairing ξ (borcherdsWeightVector γ) • x
  form : LinearMap.BilinForm ℂ g
  form_symmetric : ∀ x y, form x y = form y x
  form_invariant : ∀ x y z, form ⁅x, y⁆ z = form x ⁅y, z⁆
  form_orthogonal : ∀ γ δ, γ + δ ≠ 0 → ∀ x ∈ weightSpace γ,
    ∀ y ∈ weightSpace δ, form x y = 0
  form_cartan : ∀ ξ μ, form (cartanMap ξ) (cartanMap μ) = borcherdsCartanPairing ξ μ
  form_nondegenerate : ∀ γ, ∀ x ∈ weightSpace γ,
    (∀ y ∈ weightSpace (-γ), form x y = 0) → x = 0
  root_support : ∀ γ, weightSpace γ ≠ ⊥ → borcherdsRootSupport γ
  real_dimension : Module.finrank ℂ (weightSpace borcherdsRealRoot) = 1 ∧
    Module.finrank ℂ (weightSpace (-borcherdsRealRoot)) = 1

namespace BorcherdsPreData

variable {g : Type*} [LieRing g] [LieAlgebra ℂ g] (P : BorcherdsPreData g)

/-- Borcherds data from pre-data and generation. -/
def toData (hgen : LieSubalgebra.lieSpan ℂ g (borcherdsSimpleGenerators P.weightSpace) = ⊤) :
    BorcherdsData g where
  weightSpace := P.weightSpace
  weight_internal := P.weight_internal
  weight_finite := P.weight_finite
  bracket_weight := P.bracket_weight
  cartanMap := P.cartanMap
  cartan_injective := P.cartan_injective
  cartan_range := P.cartan_range
  cartan_action := P.cartan_action
  form := P.form
  form_symmetric := P.form_symmetric
  form_invariant := P.form_invariant
  form_orthogonal := P.form_orthogonal
  form_cartan := P.form_cartan
  form_nondegenerate := P.form_nondegenerate
  root_support := P.root_support
  real_dimension := P.real_dimension
  generated := hgen

/-- The subalgebra generated by the Cartan and the simple root spaces. -/
def simpleSpan : LieSubalgebra ℂ g :=
  LieSubalgebra.lieSpan ℂ g (borcherdsSimpleGenerators P.weightSpace)

/-- The homogeneous part `⨆_γ (G ⊓ g_γ)` of the generated subalgebra, as a Lie subalgebra. -/
def simpleSpanHomogeneous : LieSubalgebra ℂ g where
  __ := ⨆ γ, P.simpleSpan.toSubmodule ⊓ P.weightSpace γ
  lie_mem' {x y} hx hy := by
    change ⁅x, y⁆ ∈ ⨆ γ, P.simpleSpan.toSubmodule ⊓ P.weightSpace γ
    have hx' : x ∈ ⨆ γ, P.simpleSpan.toSubmodule ⊓ P.weightSpace γ := hx
    have hy' : y ∈ ⨆ γ, P.simpleSpan.toSubmodule ⊓ P.weightSpace γ := hy
    clear hx hy
    induction hx' using Submodule.iSup_induction' with
    | mem γ x hx =>
        induction hy' using Submodule.iSup_induction' with
        | mem δ y hy =>
            refine Submodule.mem_iSup_of_mem (γ + δ) (Submodule.mem_inf.mpr ⟨?_, ?_⟩)
            · exact P.simpleSpan.lie_mem (Submodule.mem_inf.mp hx).1 (Submodule.mem_inf.mp hy).1
            · exact P.bracket_weight (Submodule.mem_inf.mp hx).2 (Submodule.mem_inf.mp hy).2
        | zero => simp
        | add y z _ _ hy hz => simpa only [lie_add] using Submodule.add_mem _ hy hz
    | zero => simp
    | add x z _ _ hx hz => simpa only [add_lie] using Submodule.add_mem _ hx hz

/-- **The generated subalgebra is homogeneous.** -/
theorem simpleSpan_le_iSup :
    P.simpleSpan.toSubmodule ≤ ⨆ γ, P.simpleSpan.toSubmodule ⊓ P.weightSpace γ := by
  have h : P.simpleSpan ≤ P.simpleSpanHomogeneous := by
    refine LieSubalgebra.lieSpan_le.mpr ?_
    intro x hx
    have hxG : x ∈ P.simpleSpan.toSubmodule := LieSubalgebra.subset_lieSpan hx
    change x ∈ ⨆ γ, P.simpleSpan.toSubmodule ⊓ P.weightSpace γ
    rcases hx with hx | ⟨α, _, hx | hx⟩
    · exact Submodule.mem_iSup_of_mem 0 (Submodule.mem_inf.mpr ⟨hxG, hx⟩)
    · exact Submodule.mem_iSup_of_mem α (Submodule.mem_inf.mpr ⟨hxG, hx⟩)
    · exact Submodule.mem_iSup_of_mem (-α) (Submodule.mem_inf.mpr ⟨hxG, hx⟩)
  exact fun x hx => h hx

/-- The grading of the generated subalgebra. -/
def simpleSpanWeight (γ : ℤ × ℤ) : Submodule ℂ P.simpleSpan :=
  (P.weightSpace γ).comap P.simpleSpan.toSubmodule.subtype

theorem isInternal_simpleSpanWeight : DirectSum.IsInternal P.simpleSpanWeight :=
  isInternal_comap_of_le_iSup_inf P.weight_internal.submodule_iSupIndep _ P.simpleSpan_le_iSup

end BorcherdsPreData

end VOA.Moonshine.ConwayNorton.M8
