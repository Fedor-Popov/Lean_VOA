import VOA.Moonshine.SigmaTopTT

/-!
# Off-diagonal frame letters: `σ(w_j(−1)w_k(−1)𝟙)` and the eigen-conditions on the block data

For `j ≠ k`, `σ(α_j(−1)α_k(−1)𝟙) = (e^{α_j} + ε_j e^{−α_j})₍₋₁₎(e^{α_k} + ε_k e^{−α_k})` is a
combination of the four charged states `e^{±α_j±α_k}` of `V_N` (`golaySigma_quadH_offdiag`).
Transporting along `golayToV0` (`golayToV0_charged`: charged vacua go to charged vacua, rescaled
by `tc a = latCob_Λ(a) / (golayE(a)·latCob_N(a))`) gives `σ(w_j(−1)w_k(−1)𝟙)` as a combination of
`e^{±γ₊}, e^{±γ₋}`, `γ± = 4e_j ± 4e_k ∈ Λ₀` (`sig_dV_offdiag_coe`).  Its zero mode on
`(T⁺)₂` is therefore `κ₊ o(e^{γ₊}) + κ₋ o(e^{γ₋})` with explicit (but opaque: they contain the
chosen `golayE` and the basis-dependent cocycles) constants `κ± = kP, kM`
(`actT_sig_dV_offdiag`).

## Main results
* `golayToV0_charged` — `golayToV0` on combinations of charged vacua.
* `root_prod`, `golaySigma_quadH_offdiag`, `sig_dV_offdiag_coe`, `actT_sig_dV_offdiag`.
* `phiV3_ZM_offdiag` — for `φ_τ` the off-diagonal identity follows from: every `τ(n)` is an
  eigenvector of `κ₊ e_{γ₊}` and of `κ₋ e_{γ₋}` with eigenvalue `lam j k n`
  (`= n_j n_k/2` off the blocks `j, k`, `−n_j n_k/6` on them).  Given that `κ± e_{γ±}` have
  eigenvalues `±½` (not proved here), this condition is also necessary.
* `phiTT_ZMT_offdiag` — for `φ_ψ`: `(κ₊ e_{γ₊} + κ₋ e_{γ₋}) ψ_m = 0` on `T_{s'}` and the
  block links `ψ_k = 2κ₋ e_{γ₋} ψ_j`, `ψ_j = 2κ₋ e_{γ₋} ψ_k` (exactly what the identity says).
* `topSigmaV3_of_eigen`, `topSigmaTT_of_eigen` — (R-top) reduced to: `ZhuGenerated G2`, the
  eigen-conditions above, and the lattice letters.

## Status
`sorry`-free; `#print axioms`: `[propext, Classical.choice, Quot.sound]`.  **Conditional**: the
eigen-conditions are stated, not proved; no `τ`/`ψ` satisfying them is constructed (this needs
the values of `κ±`, i.e. `golayE` and the coboundaries on `±α_j ± α_k`, and the structure of `T`
under the abelian group generated by the `e_{γ±}`).  Imported by the umbrella `VOA/Moonshine.lean`.
-/

set_option linter.style.longLine false
set_option maxRecDepth 20000

namespace VOA.Moonshine.SigmaTop

open VOA VOA.Moonshine VOA.Moonshine.TrialityTw VOA.Moonshine.SigmaExist VOA.IntegralLattice
open VOA.LatGen HeisenbergN MvPolynomial VOA.Moonshine.Triality
open Module (End)
open Submodule
open scoped TensorProduct

/-! ## §1  Charged states through `golayToV0` -/

theorem bridgeN_latChargeGen (a : lam0.carrier) :
    bridgeN (latChargeGen lam0 a) = latCob lam0 golayN inclN a • latChargeGen golayN (inclN a) := by
  rw [latChargeGen, bridgeN, latMorph_latStateGen, vacuumN, fockMap_one]; rfl

theorem bridgeΛ_latChargeGen (a : lam0.carrier) :
    bridgeΛ (latChargeGen lam0 a) = latCob lam0 leech inclΛ a • latChargeGen leech (inclΛ a) := by
  rw [latChargeGen, bridgeΛ, latMorph_latStateGen, vacuumN, fockMap_one]; rfl

theorem charLat_latChargeGen_lam0 (a : lam0.carrier) :
    charLat lam0 golayE (latChargeGen lam0 a) = charVal lam0 golayE a • latChargeGen lam0 a := by
  rw [latChargeGen, charLat_latStateGen lam0 _ lam0_posDef]

/-- The transport constant of `e^a` along `golayToV0`. -/
noncomputable def tc (a : lam0.carrier) : ℂ :=
  latCob lam0 leech inclΛ a / (charVal lam0 golayE a * latCob lam0 golayN inclN a)

/-- **`golayToV0` on charged states**: if `y ∈ V_N^{⟨χ,Θ⟩}` is a combination of charged vacua
`e^{ι_N a}`, then `golayToV0 y` is the same combination of `e^{ι_Λ a}`, rescaled by `tc a`
(`tc` collects the two bridge coboundaries and the chosen character `golayE`). -/
theorem golayToV0_charged {ι : Type*} (s : Finset ι) (d : ι → ℂ) (a : ι → lam0.carrier)
    (y : (orbifold golayK).carrier)
    (hy : (y : LatModuleGen golayN) = ∑ i ∈ s, d i • latChargeGen golayN (inclN (a i))) :
    (((golayToV0 y : V0Sub.carrier) : VPlus) : LatModuleGen leech)
      = ∑ i ∈ s, (d i * tc (a i)) • latChargeGen leech (inclΛ (a i)) := by
  set z := lam0PlusGolayEquiv.symm y
  have hz : bridgeN (charLat lam0 golayE (z : LatModuleGen lam0)) = y := by
    have := congrArg (fun w : (orbifold golayK).carrier => (w : LatModuleGen golayN))
      (lam0PlusGolayEquiv.apply_symm_apply y)
    exact this
  set z' : LatModuleGen lam0 := ∑ i ∈ s, (d i / (charVal lam0 golayE (a i) * latCob lam0 golayN inclN (a i)))
    • latChargeGen lam0 (a i)
  have hz' : bridgeN (charLat lam0 golayE z') = y := by
    rw [hy]
    simp only [z', map_sum, map_smul, charLat_latChargeGen_lam0, bridgeN_latChargeGen, smul_smul]
    refine Finset.sum_congr rfl fun i _ => ?_
    congr 1
    have h1 := charVal_ne_zero lam0 golayE (a i)
    have h2 := latCob_ne_zero lam0 golayN inclN (a i)
    field_simp
  have heq : (z : LatModuleGen lam0) = z' := by
    have hinj : Function.Injective (fun w : LatModuleGen lam0 => bridgeN (charLat lam0 golayE w)) := by
      intro w w' h
      have h1 := bridgeN_injective h
      have h2 := congrArg (charLat lam0 (-golayE)) h1
      simp only at h2
      rwa [charLat_neg_charLat, charLat_neg_charLat] at h2
    exact hinj (hz.trans hz'.symm)
  change (((lam0PlusEquiv z : V0Sub.carrier) : VPlus) : LatModuleGen leech) = _
  rw [lam0PlusEquiv_coe, heq]
  simp only [z', map_sum, map_smul, bridgeΛ_latChargeGen, smul_smul]
  refine Finset.sum_congr rfl fun i _ => ?_
  congr 1
  rw [tc]
  ring

/-! ## §2  `σ(α_j(−1)α_k(−1)𝟙)`, `j ≠ k`, on the Niemeier side -/

section General

variable (L : IntegralLattice) (hEven : L.Even) (hPos : L.PosDef)

theorem echg_neg_one_orth (a b : L.carrier) (h : L.form a b = 0) :
    (latticeVOAGen L hEven hPos).smul (latChargeGen L a) (-1) (latChargeGen L b)
      = latticeCocycle L a b • latChargeGen L (a + b) := by
  have := LatticeTwisted.smul_echg_echg L hEven hPos a b (-1)
  rw [h, if_pos (by norm_num), show (-(-1 : ℤ) - 1 - 0).toNat = 0 from rfl, vSchur_zero] at this
  exact this

/-- `(e^α + ε_α e^{−α})₍₋₁₎(e^β + ε_β e^{−β})` for orthogonal `α, β`. -/
theorem root_prod (α β : L.carrier) (hαβ : L.form α β = 0) (εα εβ : ℂ) :
    (latticeVOAGen L hEven hPos).smul (latChargeGen L α + εα • latChargeGen L (-α)) (-1)
        (latChargeGen L β + εβ • latChargeGen L (-β))
      = latticeCocycle L α β • latChargeGen L (α + β)
        + (εβ * latticeCocycle L α (-β)) • latChargeGen L (α + -β)
        + (εα * latticeCocycle L (-α) β) • latChargeGen L (-α + β)
        + (εα * εβ * latticeCocycle L (-α) (-β)) • latChargeGen L (-α + -β) := by
  have h1 : L.form α (-β) = 0 := by rw [map_neg, hαβ, neg_zero]
  have h2 : L.form (-α) β = 0 := by rw [map_neg, LinearMap.neg_apply, hαβ, neg_zero]
  have h3 : L.form (-α) (-β) = 0 := by rw [map_neg, h2, neg_zero]
  simp only [PreVertexAlgebra.smul_add_left, PreVertexAlgebra.smul_add_right, PreVertexAlgebra.smul_smul_left,
    PreVertexAlgebra.smul_smul_right, echg_neg_one_orth L hEven hPos _ _ hαβ,
    echg_neg_one_orth L hEven hPos _ _ h1, echg_neg_one_orth L hEven hPos _ _ h2,
    echg_neg_one_orth L hEven hPos _ _ h3, smul_smul]
  module

theorem quadH_smul_smul (n m : ℕ) (α β : L.carrier) :
    quadH L hEven hPos (n • α) (m • β) = ((n : ℂ) * m) • quadH L hEven hPos α β := by
  rw [quadH, hSt_nsmul, hSt_nsmul, PreVertexAlgebra.smul_smul_left, PreVertexAlgebra.smul_smul_right, smul_smul]
  rfl

end General

theorem golaySigma_quadH_offdiag {j k : Fin 24} (hjk : j ≠ k) :
    golaySigma (quadH golayN golayN_even golayN_posDef (golayRoot j) (golayRoot k))
      = latticeCocycle golayN (golayRoot j) (golayRoot k) • latChargeGen golayN (golayRoot j + golayRoot k)
        + (golayEps k * latticeCocycle golayN (golayRoot j) (-golayRoot k)) •
            latChargeGen golayN (golayRoot j + -golayRoot k)
        + (golayEps j * latticeCocycle golayN (-golayRoot j) (golayRoot k)) •
            latChargeGen golayN (-golayRoot j + golayRoot k)
        + (golayEps j * golayEps k * latticeCocycle golayN (-golayRoot j) (-golayRoot k)) •
            latChargeGen golayN (-golayRoot j + -golayRoot k) := by
  have h := golaySigma.map_smul (hSt golayN (golayRoot j)) (-1) (hSt golayN (golayRoot k))
  change golaySigma (quadH golayN golayN_even golayN_posDef (golayRoot j) (golayRoot k)) = _ at h
  rw [h, golaySigma_hSt, golaySigma_hSt]
  have ht : ∀ i, tri i 1 0 (golayEps i) = latChargeGen golayN (golayRoot i)
      + golayEps i • latChargeGen golayN (-golayRoot i) := by
    intro i; simp [tri, vec3]
  rw [ht, ht]
  exact root_prod golayN golayN_even golayN_posDef _ _ (golayRoot_orth hjk) _ _

/-! ## §3  The `Λ₀`-vectors `2e_j ± 2e_k` -/

theorem apm_mem (j k : Fin 24) (c : ℤ) (hc : c = 1 ∨ c = -1) :
    (2 : ℤ) • (Pi.single j 1 + c • Pi.single k 1 : Fin 24 → ℤ) ∈ Leech.subA := by
  refine ⟨two_smul_mem_preimageOfCode Code.golay _, ?_⟩
  simp only [Pi.smul_apply, Pi.add_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib,
    ← Finset.mul_sum, Finset.sum_pi_single', Finset.mem_univ, if_true]
  rcases hc with rfl | rfl
  · exact ⟨1, by norm_num⟩
  · exact ⟨0, by norm_num⟩

/-- `2e_j + 2e_k ∈ A` (`= α_j + α_k` in `N`). -/
def aP (j k : Fin 24) : lam0.carrier := (⟨_, apm_mem j k 1 (Or.inl rfl)⟩ : ↥Leech.subA)

/-- `2e_j − 2e_k ∈ A` (`= α_j − α_k` in `N`). -/
def aM (j k : Fin 24) : lam0.carrier := (⟨_, apm_mem j k (-1) (Or.inr rfl)⟩ : ↥Leech.subA)

theorem inclN_aP (j k : Fin 24) : inclN (aP j k) = golayRoot j + golayRoot k := by
  apply Subtype.ext
  change (2 : ℤ) • (Pi.single j 1 + (1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)
    = (2 : ℤ) • Pi.single j 1 + (2 : ℤ) • Pi.single k 1
  rw [one_smul, smul_add]

theorem inclN_aM (j k : Fin 24) : inclN (aM j k) = golayRoot j + -golayRoot k := by
  apply Subtype.ext
  change (2 : ℤ) • (Pi.single j 1 + (-1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)
    = (2 : ℤ) • Pi.single j 1 + -((2 : ℤ) • Pi.single k 1)
  rw [smul_add, neg_one_smul, smul_neg]

theorem inclN_a4_eq (j : Fin 24) : inclN (a4 j) = 2 • golayRoot j := inclN_a4 j

/-- `γ₊ = 4e_j + 4e_k ∈ Λ₀` and `γ₋ = 4e_j − 4e_k ∈ Λ₀` (Leech coordinates). -/
noncomputable def gP (j k : Fin 24) : leech.carrier := inclΛ (aP j k)
noncomputable def gM (j k : Fin 24) : leech.carrier := inclΛ (aM j k)

theorem gP_mem (j k : Fin 24) : gP j k ∈ lambda0 := (mem_range_inclΛ _).mp ⟨_, rfl⟩
theorem gM_mem (j k : Fin 24) : gM j k ∈ lambda0 := (mem_range_inclΛ _).mp ⟨_, rfl⟩

theorem lv_gP (j k : Fin 24) : lv (gP j k) = (4 : ℤ) • (Pi.single j 1 + Pi.single k 1 : Fin 24 → ℤ) := by
  change (2 : ℤ) • ((2 : ℤ) • (Pi.single j 1 + (1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)) = _
  rw [smul_smul, one_smul]; norm_num

theorem lv_gM (j k : Fin 24) : lv (gM j k) = (4 : ℤ) • (Pi.single j 1 - Pi.single k 1 : Fin 24 → ℤ) := by
  change (2 : ℤ) • ((2 : ℤ) • (Pi.single j 1 + (-1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)) = _
  rw [smul_smul, neg_one_smul, ← sub_eq_add_neg]; norm_num

theorem form_eq_of_lv {x y : leech.carrier} (h : lv x ⬝ᵥ lv y = 8 * c) : leech.form x y = c := by
  rw [leech_form_lv, h, Int.mul_ediv_cancel_left _ (by norm_num : (8 : ℤ) ≠ 0)]

theorem gP_two (j k : Fin 24) : gP j k + gP j k = fw j + fw k := by
  apply Subtype.ext
  change lv (gP j k) + lv (gP j k) = lv (fw j) + lv (fw k)
  rw [lv_gP, lv_fw, lv_fw, ← add_smul, smul_add]; norm_num

theorem gM_two (j k : Fin 24) : gM j k + gM j k = fw j - fw k := by
  apply Subtype.ext
  change lv (gM j k) + lv (gM j k) = lv (fw j) - lv (fw k)
  rw [lv_gM, lv_fw, lv_fw, ← add_smul, smul_sub]; norm_num

theorem form_gP_self {j k : Fin 24} (hjk : j ≠ k) : leech.form (gP j k) (gP j k) = 4 := by
  rw [show gP j k = inclΛ (aP j k) from rfl, inclΛ_form]
  change ((2 : ℤ) • (Pi.single j 1 + (1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)) ⬝ᵥ
    ((2 : ℤ) • (Pi.single j 1 + (1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)) / 2 = 4
  simp [dotProduct, Pi.single_apply, Finset.sum_add_distrib, hjk, Ne.symm hjk, add_mul, mul_add]

theorem form_gM_self {j k : Fin 24} (hjk : j ≠ k) : leech.form (gM j k) (gM j k) = 4 := by
  rw [show gM j k = inclΛ (aM j k) from rfl, inclΛ_form]
  change ((2 : ℤ) • (Pi.single j 1 + (-1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)) ⬝ᵥ
    ((2 : ℤ) • (Pi.single j 1 + (-1 : ℤ) • Pi.single k 1 : Fin 24 → ℤ)) / 2 = 4
  simp [dotProduct, Pi.single_apply, Finset.sum_add_distrib, hjk, Ne.symm hjk, add_mul, mul_add]

/-! ## §4  `σ(w_j(−1)w_k(−1)𝟙)` in `V_Λ` -/

/-- The four `N`-charges `±α_j ± α_k`, as elements of `A = Λ₀`. -/
noncomputable def aQ (j k : Fin 24) : Fin 4 → lam0.carrier := ![aP j k, aM j k, -aM j k, -aP j k]

/-- The `golaySigma` coefficients of `σ(α_j(−1)α_k(−1)𝟙)` on `e^{±α_j±α_k}`. -/
noncomputable def cQ (j k : Fin 24) : Fin 4 → ℂ :=
  ![latticeCocycle golayN (golayRoot j) (golayRoot k),
    golayEps k * latticeCocycle golayN (golayRoot j) (-golayRoot k),
    golayEps j * latticeCocycle golayN (-golayRoot j) (golayRoot k),
    golayEps j * golayEps k * latticeCocycle golayN (-golayRoot j) (-golayRoot k)]

theorem aQ_0 (j k : Fin 24) : aQ j k 0 = aP j k := rfl
theorem aQ_1 (j k : Fin 24) : aQ j k 1 = aM j k := rfl
theorem aQ_2 (j k : Fin 24) : aQ j k 2 = -aM j k := rfl
theorem aQ_3 (j k : Fin 24) : aQ j k 3 = -aP j k := rfl
theorem cQ_0 (j k : Fin 24) : cQ j k 0 = latticeCocycle golayN (golayRoot j) (golayRoot k) := rfl
theorem cQ_1 (j k : Fin 24) : cQ j k 1 = golayEps k * latticeCocycle golayN (golayRoot j) (-golayRoot k) := rfl
theorem cQ_2 (j k : Fin 24) : cQ j k 2 = golayEps j * latticeCocycle golayN (-golayRoot j) (golayRoot k) := rfl
theorem cQ_3 (j k : Fin 24) :
    cQ j k 3 = golayEps j * golayEps k * latticeCocycle golayN (-golayRoot j) (-golayRoot k) := rfl

theorem golaySigma_qN_offdiag {j k : Fin 24} (hjk : j ≠ k) :
    golaySigma ((qN (a4 j) (a4 k) : (orbifold golayK).carrier) : LatModuleGen golayN)
      = ∑ i : Fin 4, (4 * cQ j k i) • latChargeGen golayN (inclN (aQ j k i)) := by
  change golaySigma (quadH golayN golayN_even golayN_posDef (inclN (a4 j)) (inclN (a4 k))) = _
  rw [inclN_a4, inclN_a4, quadH_smul_smul, Aut.map_smul_c, golaySigma_quadH_offdiag hjk]
  rw [Fin.sum_univ_four, aQ_0, aQ_1, aQ_2, aQ_3, cQ_0, cQ_1, cQ_2, cQ_3, map_neg, map_neg, inclN_aP,
    inclN_aM, neg_add, neg_neg, neg_add]
  simp only [smul_add, smul_smul]
  norm_num

/-- **`σ` on the off-diagonal frame letters**: `σ(w_j(−1)w_k(−1)𝟙)` is the combination
`Σ_i 4 c_i t_i e^{ι a_i}` of the four charged states `e^{±4e_j ±4e_k}` of `V_Λ`, with `c_i` the
`golaySigma` coefficients (`cQ`) and `t_i = tc a_i` the transport constants. -/
theorem sig_dV_offdiag_coe {j k : Fin 24} (hjk : j ≠ k) :
    (((sig (dV (fw j) (fw k)) : V0Sub.carrier) : VPlus) : LatModuleGen leech)
      = ∑ i : Fin 4, (4 * cQ j k i * tc (aQ j k i)) • latChargeGen leech (inclΛ (aQ j k i)) := by
  rw [show dV (fw j) (fw k) = golayToV0 (qN (a4 j) (a4 k)) from (golayToV0_qN _ _).symm, sig,
    ← golayToV0_sigma]
  refine golayToV0_charged Finset.univ _ _ _ ?_
  rw [golaySigma0_coe, golaySigma_qN_offdiag hjk]

/-! ## §5  `o(σ(w_j(−1)w_k(−1)𝟙))` on `(T⁺)₂` -/

theorem leechYM_echg_hT {γ : leech.carrier} (hγ : γ ∈ lambda0) (h4 : leech.form γ γ = 4)
    (v : Fin (rank leech) → ℂ) (t : TLeechT) :
    LatticeTwisted.leechTwistedModule.YM (latChargeGen leech γ) 2 (hT v t)
      = (2 : ℂ) ^ (-(4 : ℤ)) • hT (latL γ v) (eT leech leech_even leech_isUnit_det_gramMat γ t) := by
  have h := congrArg (fun y : TP => (y : Tw)) (actT_lV_hP hγ h4 v t)
  simp only [Submodule.coe_smul, hP_coe] at h
  rw [actT_coe] at h
  change LatticeTwisted.leechTwistedModule.YM (latChargeGen leech γ + latChargeGen leech (-γ)) (2 * 1) (hT v t) = _ at h
  rw [map_add, Pi.add_apply, LinearMap.add_apply, show (2 : ℤ) * 1 = 2 by norm_num] at h
  change LatticeTwisted.leechTwistedModule.YM (LatticeTwisted.echg leech γ) 2 (hT v t)
    + LatticeTwisted.leechTwistedModule.YM (LatticeTwisted.echg leech (-γ)) 2 (hT v t) = _ at h
  rw [leechYM_echg_neg_two, ← two_smul ℂ] at h
  change LatticeTwisted.leechTwistedModule.YM (LatticeTwisted.echg leech γ) 2 (hT v t) = _
  have h2 : (2 : ℂ) ^ (-(4 : ℤ)) = (1 / 2) * (2 : ℂ) ^ (-(3 : ℤ)) := by norm_num
  have h' : (2 : ℂ) ^ (-(3 : ℤ)) • hT (latL γ v) (eT leech leech_even leech_isUnit_det_gramMat γ t)
      = (2 : ℂ) • LatticeTwisted.leechTwistedModule.YM (LatticeTwisted.echg leech γ) 2 (hT v t) := h.symm
  rw [h2, ← smul_smul, h', smul_smul]
  norm_num

/-- The coefficient of `o(e^{γ₊})` (resp. `o(e^{γ₋})`) in `o(σ(w_j(−1)w_k(−1)𝟙))`. -/
noncomputable def kP (j k : Fin 24) : ℂ :=
  (2 : ℂ) ^ (-(4 : ℤ)) * (4 * cQ j k 0 * tc (aQ j k 0) + 4 * cQ j k 3 * tc (aQ j k 3))

noncomputable def kM (j k : Fin 24) : ℂ :=
  (2 : ℂ) ^ (-(4 : ℤ)) * (4 * cQ j k 1 * tc (aQ j k 1) + 4 * cQ j k 2 * tc (aQ j k 2))

/-- **`o(σ(w_j(−1)w_k(−1)𝟙))` on `h_v(−½) ⊗ t`**:
`κ₊ h_{v−2⟨v,γ₊⟩γ₊} ⊗ e_{γ₊} t + κ₋ h_{v−2⟨v,γ₋⟩γ₋} ⊗ e_{γ₋} t`, `γ± = 4e_j ± 4e_k`. -/
theorem actT_sig_dV_offdiag {j k : Fin 24} (hjk : j ≠ k) (v : Fin (rank leech) → ℂ) (t : TLeechT) :
    actT (sig (dV (fw j) (fw k))) 1 (hP v t)
      = kP j k • hP (latL (gP j k) v) (eT leech leech_even leech_isUnit_det_gramMat (gP j k) t)
        + kM j k • hP (latL (gM j k) v) (eT leech leech_even leech_isUnit_det_gramMat (gM j k) t) := by
  apply Subtype.ext
  rw [actT_coe, sig_dV_offdiag_coe hjk, hP_coe, map_sum, show (2 : ℤ) * 1 = 2 by norm_num]
  simp only [Fin.sum_univ_four, Pi.add_apply, LinearMap.add_apply, map_smul, Pi.smul_apply,
    LinearMap.smul_apply]
  have e0 : inclΛ (aQ j k 0) = gP j k := rfl
  have e1 : inclΛ (aQ j k 1) = gM j k := rfl
  have e2 : inclΛ (aQ j k 2) = -gM j k := by simp [aQ, gM]
  have e3 : inclΛ (aQ j k 3) = -gP j k := by simp [aQ, gP]
  rw [e0, e1, e2, e3]
  have hn : ∀ γ : leech.carrier, LatticeTwisted.leechTwistedModule.YM (latChargeGen leech (-γ)) 2
      = LatticeTwisted.leechTwistedModule.YM (latChargeGen leech γ) 2 := leechYM_echg_neg_two
  rw [hn, hn]
  change _ = ((kP j k • hP _ _ + kM j k • hP _ _ : TP) : Tw)
  simp only [Submodule.coe_add, Submodule.coe_smul, hP_coe]
  rw [← hT, leechYM_echg_hT (gP_mem j k) (form_gP_self hjk), leechYM_echg_hT (gM_mem j k) (form_gM_self hjk)]
  simp only [hT, kP, kM, smul_smul]
  module

/-! ## §6  Eigen-conditions on the block data -/

theorem chargeCoord_gP (j k : Fin 24) : chargeCoord leech (gP j k) = (1 / 2 : ℂ) • (cw j + cw k) := by
  funext a
  have h := chargeCoord_add leech (gP j k) (gP j k) a
  rw [gP_two, chargeCoord_add] at h
  simp only [Pi.smul_apply, Pi.add_apply, smul_eq_mul, cw]
  linear_combination -(1 / 2 : ℂ) * h

theorem chargeCoord_gM (j k : Fin 24) : chargeCoord leech (gM j k) = (1 / 2 : ℂ) • (cw j - cw k) := by
  funext a
  have h := chargeCoord_add leech (gM j k) (gM j k) a
  rw [gM_two, sub_eq_add_neg, chargeCoord_add, chargeCoord_neg] at h
  simp only [Pi.smul_apply, Pi.sub_apply, smul_eq_mul, cw]
  linear_combination -(1 / 2 : ℂ) * h

theorem pair_cw_left (γ : leech.carrier) (m : Fin 24) :
    ∑ a, chargeCoord leech γ a * cw m a = ((lv γ m : ℤ) : ℂ) := by
  rw [pair_cw, ← form_fw_left]
  have := leech.isSymm.eq (fw m) γ
  rw [this]

theorem latL_apply (γ : leech.carrier) (v : Fin (rank leech) → ℂ) :
    latL γ v = v - (2 * ∑ a, chargeCoord leech γ a * v a) • chargeCoord leech γ := by
  simp only [latL, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.smul_apply,
    LinearMap.smulRight_apply, LinearMap.sum_apply, LinearMap.proj_apply, smul_eq_mul, smul_smul]

theorem latL_gP_cw (j k m : Fin 24) :
    latL (gP j k) (cw m) = cw m - (((lv (gP j k) m : ℤ) : ℂ)) • (cw j + cw k) := by
  rw [latL_apply, pair_cw_left, chargeCoord_gP, smul_smul]
  congr 1; ring_nf

theorem latL_gM_cw (j k m : Fin 24) :
    latL (gM j k) (cw m) = cw m - (((lv (gM j k) m : ℤ) : ℂ)) • (cw j - cw k) := by
  rw [latL_apply, pair_cw_left, chargeCoord_gM, smul_smul]
  congr 1; ring_nf

theorem lv_gP_apply (j k m : Fin 24) :
    lv (gP j k) m = 4 * ((if m = j then 1 else 0) + (if m = k then 1 else 0)) := by
  rw [lv_gP]; simp [Pi.single_apply]

theorem lv_gM_apply (j k m : Fin 24) :
    lv (gM j k) m = 4 * ((if m = j then 1 else 0) - (if m = k then 1 else 0)) := by
  rw [lv_gM]; simp [Pi.single_apply]

/-- `latL γ₊ (w_m) + latL γ₋ (w_m)`: `2w_m` off `{j,k}`, `−6w_m` on `{j,k}`. -/
theorem latL_sum_cw {j k : Fin 24} (hjk : j ≠ k) (m : Fin 24) :
    latL (gP j k) (cw m) + latL (gM j k) (cw m)
      = (if m = j ∨ m = k then (-6 : ℂ) else 2) • cw m := by
  rw [latL_gP_cw, latL_gM_cw, lv_gP_apply, lv_gM_apply]
  by_cases hj : m = j
  · subst hj; simp [hjk]; module
  · by_cases hk : m = k
    · subst hk; simp [hj]; module
    · simp [hj, hk]; module

/-- The prescribed eigenvalue of `κ₊ e_{γ₊}` and `κ₋ e_{γ₋}` on `τ(n)`. -/
noncomputable def lam (j k : Fin 24) (n : leech.carrier) : ℂ :=
  if blk n = j ∨ blk n = k then -(((lv n j * lv n k : ℤ) : ℂ)) / 6 else ((lv n j * lv n k : ℤ) : ℂ) / 2

theorem hP_smul_right (v : Fin (rank leech) → ℂ) (c : ℂ) (t : TLeechT) : hP v (c • t) = c • hP v t := by
  apply Subtype.ext; simp [hP_coe, TensorProduct.tmul_smul]

theorem hP_add_left' (v w : Fin (rank leech) → ℂ) (t : TLeechT) : hP v t + hP w t = hP (v + w) t :=
  (hP_add_left v w t).symm

/-- **Off-diagonal frame letters on `V₃⁺`, reduced to eigen-conditions on `τ`.**  If every
`τ(n)` is a common eigenvector of `κ₊ e_{γ₊}` and `κ₋ e_{γ₋}` with eigenvalue `lam j k n`, then
`φ_τ` intertwines `o(w_j(−1)w_k(−1)𝟙)`. -/
theorem phiV3_ZM_offdiag (τ : leech.carrier → TLeechT) {j k : Fin 24} (hjk : j ≠ k)
    (hτ : ∀ n ∈ halfFourChi 1,
      kP j k • eT leech leech_even leech_isUnit_det_gramMat (gP j k) (τ n) = lam j k n • τ n ∧
      kM j k • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (τ n) = lam j k n • τ n) :
    ZM (phiV3 τ) OmegaV3 (dV (fw j) (fw k)) := by
  refine ZM_of_basis _ _ fun n hn => ?_
  obtain ⟨h4, h1⟩ := mem_halfFourChi hn
  have hn0 : n ∉ lambda0 := by rw [mem_lambda0, h1]; exact one_ne_zero
  obtain ⟨hP', hM'⟩ := hτ n hn
  rw [actV_dV, form_fw_left, form_fw_left, map_smul, phiV3_frameX0P τ hn, actT_sig_dV_offdiag hjk,
    ← hP_smul_right (latL (gP j k) (cw (blk n))), ← hP_smul_right (latL (gM j k) (cw (blk n))),
    hP', hM', hP_smul_right, hP_smul_right, ← smul_add, hP_add_left', latL_sum_cw hjk,
    hP_smul_left, smul_smul]
  congr 1
  unfold lam
  by_cases hb : blk n = j ∨ blk n = k
  · rw [if_pos hb, if_pos hb]; push_cast; ring
  · rw [if_neg hb, if_neg hb]; push_cast; ring

theorem dL_fw_off {j k : Fin 24} (hjk : j ≠ k) (m : Fin 24) :
    dL (fw j) (fw k) (cw m) = (if m = k then (4 : ℂ) else 0) • cw j + (if m = j then (4 : ℂ) else 0) • cw k := by
  simp only [dL, LinearMap.add_apply, LinearMap.smul_apply, LinearMap.id_apply,
    LinearMap.smulRight_apply, LinearMap.sum_apply, LinearMap.proj_apply, smul_eq_mul]
  have e1 : ∑ x, chargeCoord leech (fw k) x * cw m x = ((leech.form (fw k) (fw m) : ℤ) : ℂ) := pair_cw _ m
  have e2 : ∑ x, chargeCoord leech (fw j) x * cw m x = ((leech.form (fw j) (fw m) : ℤ) : ℂ) := pair_cw _ m
  rw [e1, e2, form_fw_fw, form_fw_fw, form_fw_fw, if_neg hjk]
  change _ = _ • cw j + _ • cw k
  by_cases hk : m = k
  · subst hk
    simp only [if_true, if_neg hjk, if_neg (Ne.symm hjk)]
    unfold cw; push_cast; module
  · by_cases hj : m = j
    · subst hj
      simp only [if_true, if_neg hk, if_neg (Ne.symm hk)]
      unfold cw; push_cast; module
    · simp only [if_neg hk, if_neg hj, if_neg (Ne.symm hk), if_neg (Ne.symm hj)]
      unfold cw; push_cast; module

theorem hP_sub_left (v w : Fin (rank leech) → ℂ) (t : TLeechT) : hP (v - w) t = hP v t - hP w t := by
  apply Subtype.ext; simp [hP_coe, hvec_sub, TensorProduct.sub_tmul]

theorem hP_neg_right (v : Fin (rank leech) → ℂ) (t : TLeechT) : hP v (-t) = -hP v t := by
  apply Subtype.ext; simp [hP_coe, TensorProduct.tmul_neg]

theorem hP_add_right (v : Fin (rank leech) → ℂ) (t t' : TLeechT) : hP v (t + t') = hP v t + hP v t' := by
  apply Subtype.ext; simp [hP_coe, TensorProduct.tmul_add]

/-- **Off-diagonal frame letters on `T_{s'}⁺`, reduced to conditions on `ψ`.** -/
theorem phiTT_ZMT_offdiag (ψ : Fin 24 → TLeechT →ₗ[ℂ] TLeechT) (s' : ZMod 2) {j k : Fin 24}
    (hjk : j ≠ k)
    (h0 : ∀ (m : Fin 24) (t : TLeechT), t ∈ leechFrameT s' →
      kP j k • eT leech leech_even leech_isUnit_det_gramMat (gP j k) (ψ m t)
        + kM j k • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (ψ m t) = 0)
    (hk : ∀ t ∈ leechFrameT s', ψ k t = (2 * kM j k) • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (ψ j t))
    (hj : ∀ t ∈ leechFrameT s', ψ j t = (2 * kM j k) • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (ψ k t)) :
    ZMT (phiTT ψ) (OmegaT s') (dV (fw j) (fw k)) := by
  refine ZMT_of_basis _ s' _ fun m t ht => ?_
  set X := eT leech leech_even leech_isUnit_det_gramMat (gP j k) (ψ m t)
  set Y := eT leech leech_even leech_isUnit_det_gramMat (gM j k) (ψ m t)
  have hXY : kP j k • X = -(kM j k • Y) := eq_neg_of_add_eq_zero_left (h0 m t ht)
  have hR : ∀ u, kP j k • hP u X = -(kM j k • hP u Y) := by
    intro u; rw [← hP_smul_right, hXY, hP_neg_right, hP_smul_right]
  rw [actT_dV_hP, dL_fw_off hjk, hP_add_left, hP_smul_left, hP_smul_left, map_add, map_smul,
    map_smul]
  simp only [phiTT_hP]
  rw [actT_sig_dV_offdiag hjk, hR, latL_gP_cw, latL_gM_cw, lv_gP_apply, lv_gM_apply]
  by_cases hmk : m = k
  · subst hmk
    rw [hj t ht]
    simp only [if_neg (Ne.symm hjk), hP_sub_left, hP_add_left, hP_smul_left, hP_smul_right]
    push_cast
    module
  · by_cases hmj : m = j
    · subst hmj
      rw [hk t ht]
      simp only [if_neg hmk, hP_sub_left, hP_add_left, hP_smul_left, hP_smul_right]
      push_cast
      module
    · simp only [if_neg hmk, if_neg hmj, hP_sub_left, hP_add_left, hP_smul_left]
      push_cast
      simp only [zero_smul, add_zero, sub_zero]
      exact (neg_add_cancel _).symm

/-! ## §7  Assembly: (R-top) reduced to eigen-conditions and the lattice letters -/

/-- **`TopSigmaV3` from block data**: Zhu generation, the eigen-conditions on `τ` for the
off-diagonal frame letters, and the lattice letters. -/
theorem topSigmaV3_of_eigen {s : ZMod 2} {τ : leech.carrier → TLeechT}
    (hτ : ∀ n ∈ halfFourChi 1, τ n ∈ leechFrameT s) {t₀ : TLeechT} (ht₀ : t₀ ∈ leechFrameT s)
    (h0 : t₀ ≠ 0) (hblk : ∀ j, τ (nvec j) = t₀) (hZhu : ZhuGenerated G2)
    (heig : ∀ j k : Fin 24, j ≠ k → ∀ n ∈ halfFourChi 1,
      kP j k • eT leech leech_even leech_isUnit_det_gramMat (gP j k) (τ n) = lam j k n • τ n ∧
      kM j k • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (τ n) = lam j k n • τ n)
    (hlat : ∀ γ ∈ halfFourChi 0, ZM (phiV3 τ) OmegaV3 (lV' γ)) :
    TopSigmaV3 s (phiV3 τ) :=
  topSigmaV3_of_offdiag hτ ht₀ h0 hblk hZhu
    (fun j k hjk => phiV3_ZM_offdiag τ hjk (heig j k hjk)) hlat

/-- **`TopSigmaTT` from block data.** -/
theorem topSigmaTT_of_eigen {s' s : ZMod 2} {ψ : Fin 24 → TLeechT →ₗ[ℂ] TLeechT}
    (hψ : ∀ m t, ψ m t ∈ leechFrameT s) {t₁ t₀ : TLeechT} (ht₁ : t₁ ∈ leechFrameT s')
    (ht₀ : t₀ ∈ leechFrameT s) (h0 : t₀ ≠ 0) (hblk : ∀ m, ψ m t₁ = t₀) (hZhu : ZhuGenerated G2)
    (hsum : ∀ j k : Fin 24, j ≠ k → ∀ (m : Fin 24) (t : TLeechT), t ∈ leechFrameT s' →
      kP j k • eT leech leech_even leech_isUnit_det_gramMat (gP j k) (ψ m t)
        + kM j k • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (ψ m t) = 0)
    (hlink : ∀ j k : Fin 24, j ≠ k → ∀ t ∈ leechFrameT s',
      ψ k t = (2 * kM j k) • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (ψ j t))
    (hlink' : ∀ j k : Fin 24, j ≠ k → ∀ t ∈ leechFrameT s',
      ψ j t = (2 * kM j k) • eT leech leech_even leech_isUnit_det_gramMat (gM j k) (ψ k t))
    (hlat : ∀ γ ∈ halfFourChi 0, ZMT (phiTT ψ) (OmegaT s') (lV' γ)) :
    TopSigmaTT s' s (phiTT ψ) :=
  topSigmaTT_of_offdiag hψ ht₁ ht₀ h0 hblk hZhu
    (fun j k hjk => phiTT_ZMT_offdiag ψ s' hjk (hsum j k hjk) (hlink j k hjk) (hlink' j k hjk)) hlat

end VOA.Moonshine.SigmaTop
