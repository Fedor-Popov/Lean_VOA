import VOA.Moonshine.LeechLatticeVOA

/-!
# The Leech lattice is generated by its minimal vectors
(Aut(V♮) campaign, step 3, route C, node C6 of `Notes/MONSTER_AUT_PLAN.md`)

`leech = ofEbeling Leech.lattice` has carrier `Λ = 2A ∪ (u + 2A) ⊆ ℤ²⁴` (the `√8`-scaled model of
`VOA/LatticesAndCodes/Leech/Defs.lean`: `A = {a ∈ ρ⁻¹(Golay) : 4 ∣ Σ aᵢ}`, `u = (5,1²³)`) and
form `⟪x,y⟫ = x·y/8`, so the minimal vectors (norm `4`) are the `x ∈ Λ` with `x·x = 32`.

The proof exhibits norm-`4` generators and writes every `x ∈ Λ` in terms of them.

* **Shape `(±4, ±4, 0²²)`.**  `4eᵢ ± 4eⱼ ∈ Λ` (`pair_mem_minT`).  They generate `4·D₂₄`:
  `4w` with `Σ wⱼ` even is `Σᵢ wᵢ(4eᵢ − 4e₀) + k(8e₀)`, `Σ w = 2k`, `8e₀ = (4e₀+4e₁) + (4e₀−4e₁)`
  (`four_smul_mem_minC`).
* **Octads `(2⁸, 0¹⁶)`.**  The rows `R i` of the generator matrix `[I₁₂ | B]` of `Code.golay`
  (integer `0/1` lifts) lie in `A`; rows `0..10` are octads, so `2·R i` is minimal.  Row `11` is
  a dodecad; `2·R₁₁ = 2·O − 2·R₀ + 4·(R₁₁ ∧ R₀)` with the octad `O = R₁₁ ⊕ R₀` and an overlap of
  size `6` (`two_smul_R_mem`).  These facts about concrete vectors are `decide +kernel`.
* **`2A`.**  For `a ∈ A` choose `y` with `golayEnc y = a mod 2`, put `s = Σᵢ yᵢ R i`; then
  `a − s = 2w` with `Σ w` even (all row sums are `≡ 0 mod 4`), so
  `2a = Σᵢ yᵢ (2 R i) + 4w` (`two_smul_subA_mem_minC`).
* **The odd coset.**  `u − 8e₀ = (−3, 1²³)` is minimal, and `x = (x − u) + (u − 8e₀) + 4(2e₀)`
  (`mem_minC_of_mem_carrier`).

## Main results
* ⭐ `leech_mem_closure_minimal` — every `β ∈ Λ` lies in
  `AddSubgroup.closure {α | leech.form α α = 4}`.
* ⭐ `leech_closure_minimal_eq_top` — the same as an equality `= ⊤`.
* ⭐ `leech_induction` — for `P : Λ → Prop` with `P 0`, `P γ → P (γ + α)` and
  `P γ → P (γ − α)` for all minimal `α`: `P` holds on all of `Λ`.

## Status
All declarations `sorry`-free; no `native_decide` (the concrete facts use `decide +kernel`).
`#print axioms` gives `[propext, Classical.choice, Quot.sound]` for every theorem (checked with
`lake build VOA.Moonshine.AutLeechSpan` green, 3,174 jobs).  Unconditional.
-/

set_option linter.style.longLine false

namespace VOA.Moonshine.LeechSpan

open Leech Code
open scoped Matrix

/-! ## §1  Minimal vectors in the `ℤ²⁴` model -/

/-- The minimal vectors of the `√8`-scaled model: `x ∈ Λ` with `x·x = 32` (norm `4`). -/
def minT : Set (Fin 24 → ℤ) := {x | x ∈ Leech.carrier ∧ x ⬝ᵥ x = 32}

/-- The subgroup of `ℤ²⁴` generated by the minimal vectors. -/
abbrev minC : AddSubgroup (Fin 24 → ℤ) := AddSubgroup.closure minT

theorem mem_minC_of_minT {x : Fin 24 → ℤ} (h : x ∈ minT) : x ∈ minC :=
  AddSubgroup.subset_closure h

/-- `4eᵢ + 4s·eⱼ` (`s = ±1`, `i ≠ j`) is a minimal vector. -/
theorem pair_mem_minT (i j : Fin 24) (hij : i ≠ j) (s : ℤ) (hs : s = 1 ∨ s = -1) :
    (Pi.single i 4 + Pi.single j (4 * s) : Fin 24 → ℤ) ∈ minT := by
  refine ⟨Or.inl (mem_subA2.2 ⟨Pi.single i 2 + Pi.single j (2 * s), mem_subA.2 ⟨?_, ?_⟩, ?_⟩), ?_⟩
  · have h : (Pi.single i 2 + Pi.single j (2 * s) : Fin 24 → ℤ)
        = (2 : ℤ) • (Pi.single i 1 + Pi.single j s) := by
      funext k
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply]
      split_ifs <;> ring
    rw [h]
    exact two_smul_mem_preimageOfCode Code.golay _
  · simp only [Pi.add_apply]
    rw [Finset.sum_add_distrib, Finset.sum_pi_single', Finset.sum_pi_single']
    simp only [Finset.mem_univ, if_true]
    rcases hs with rfl | rfl <;> norm_num
  · funext k
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply]
    split_ifs <;> ring
  · rw [add_dotProduct, dotProduct_add, dotProduct_add, single_dotProduct, single_dotProduct,
      single_dotProduct, single_dotProduct, Pi.single_eq_same, Pi.single_eq_same,
      Pi.single_eq_of_ne hij, Pi.single_eq_of_ne (Ne.symm hij)]
    rcases hs with rfl | rfl <;> norm_num

/-- ⭐ **`4·D₂₄` is generated by minimal vectors**: `4w ∈ minC` whenever `Σ wⱼ` is even. -/
theorem four_smul_mem_minC (w : Fin 24 → ℤ) (hw : Even (∑ j, w j)) : (4 : ℤ) • w ∈ minC := by
  obtain ⟨k, hk⟩ := hw
  have hd : ∀ i : Fin 24, (Pi.single i 4 + Pi.single 0 (4 * (-1)) : Fin 24 → ℤ) ∈ minC := by
    intro i
    by_cases hi : i = 0
    · subst hi
      have h0 : (Pi.single (0 : Fin 24) 4 + Pi.single 0 (4 * (-1)) : Fin 24 → ℤ) = 0 := by
        funext j
        simp only [Pi.add_apply, Pi.single_apply, Pi.zero_apply]
        split_ifs <;> norm_num
      rw [h0]
      exact zero_mem _
    · exact mem_minC_of_minT (pair_mem_minT i 0 hi (-1) (Or.inr rfl))
  have hp := mem_minC_of_minT (pair_mem_minT 0 1 (by decide) 1 (Or.inl rfl))
  have hm := mem_minC_of_minT (pair_mem_minT 0 1 (by decide) (-1) (Or.inr rfl))
  have heq : (4 : ℤ) • w
      = ∑ i, w i • (Pi.single i 4 + Pi.single 0 (4 * (-1)) : Fin 24 → ℤ)
        + k • ((Pi.single 0 4 + Pi.single 1 (4 * 1) : Fin 24 → ℤ)
          + (Pi.single 0 4 + Pi.single 1 (4 * (-1)))) := by
    funext j
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_apply, mul_add,
      Finset.sum_add_distrib]
    rw [← Finset.sum_mul, hk]
    simp only [Pi.single_apply, mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    by_cases h0 : j = 0
    · subst h0
      simp only [if_true, show ((0 : Fin 24) = 1) = False from by decide, if_false]
      ring
    · by_cases h1 : j = 1
      · subst h1
        simp only [if_true, show ((1 : Fin 24) = 0) = False from by decide, if_false]
        ring
      · simp only [h0, h1, if_false]
        ring
  rw [heq]
  refine add_mem (AddSubgroup.sum_mem _ fun i _ => AddSubgroup.zsmul_mem _ (hd i) _) ?_
  exact AddSubgroup.zsmul_mem _ (add_mem hp hm) _

/-! ## §2  The Golay rows -/

/-- The integer `0/1` lift of the `i`-th row of the generator matrix `[I₁₂ | B]` of `golay`. -/
def R (i : Fin 12) : Fin 24 → ℤ := fun j => ((golayEnc (Pi.single i 1) j).val : ℤ)

theorem R_dot_self : ∀ i : Fin 12, i ≠ 11 → R i ⬝ᵥ R i = 8 := by decide +kernel

theorem R_sum_mod : ∀ i : Fin 12, (∑ j, R i j) % 4 = 0 := by decide +kernel

/-- The overlap `R₁₁ ∧ R₀` of the dodecad row with row `0`. -/
def ov : Fin 24 → ℤ := fun j => R 11 j * R 0 j

/-- The octad `R₁₁ ⊕ R₀`. -/
def octO : Fin 24 → ℤ := fun j => R 11 j + R 0 j - 2 * (R 11 j * R 0 j)

theorem ov_sum : ∑ j, ov j = 6 := by decide +kernel

theorem octO_dot : octO ⬝ᵥ octO = 8 := by decide +kernel

theorem octO_sum : (∑ j, octO j) % 4 = 0 := by decide +kernel

theorem reduceMod_R (i : Fin 12) : reduceMod 2 24 (R i) = golayEnc (Pi.single i 1) := by
  funext j
  rw [reduceMod_apply]
  change (((golayEnc (Pi.single i 1) j).val : ℤ) : ZMod 2) = _
  rw [Int.cast_natCast, ZMod.natCast_zmod_val]

theorem R_mem_subA (i : Fin 12) : R i ∈ subA :=
  mem_subA.2 ⟨mem_preG.2 (by rw [reduceMod_R]; exact golayEnc_mem _),
    Int.dvd_of_emod_eq_zero (R_sum_mod i)⟩

theorem octO_eq : octO = R 11 + R 0 - (2 : ℤ) • ov := by
  funext j
  simp only [octO, ov, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]

theorem octO_mem_subA : octO ∈ subA := by
  refine mem_subA.2 ⟨?_, Int.dvd_of_emod_eq_zero octO_sum⟩
  rw [octO_eq]
  exact preG.sub_mem (preG.add_mem (R_mem_subA 11).1 (R_mem_subA 0).1)
    (two_smul_mem_preimageOfCode Code.golay ov)

theorem two_smul_mem_minT {a : Fin 24 → ℤ} (ha : a ∈ subA) (hdot : a ⬝ᵥ a = 8) :
    (2 : ℤ) • a ∈ minT :=
  ⟨Or.inl (two_smul_mem_subA2 ha), by rw [dot_two_smul_two_smul, hdot]; norm_num⟩

/-- Every doubled Golay row is a combination of minimal vectors. -/
theorem two_smul_R_mem (i : Fin 12) : (2 : ℤ) • R i ∈ minC := by
  by_cases hi : i = 11
  · subst hi
    have heq : (2 : ℤ) • R 11 = (2 : ℤ) • octO - (2 : ℤ) • R 0 + (4 : ℤ) • ov := by
      funext j
      simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, octO, ov]
      ring
    rw [heq]
    refine add_mem (sub_mem ?_ ?_) (four_smul_mem_minC ov ⟨3, by rw [ov_sum]; norm_num⟩)
    · exact mem_minC_of_minT (two_smul_mem_minT octO_mem_subA octO_dot)
    · exact mem_minC_of_minT (two_smul_mem_minT (R_mem_subA 0) (R_dot_self 0 (by decide)))
  · exact mem_minC_of_minT (two_smul_mem_minT (R_mem_subA i) (R_dot_self i hi))

/-! ## §3  `2A` and the odd coset -/

/-- ⭐ **`2A` is generated by minimal vectors.** -/
theorem two_smul_subA_mem_minC {a : Fin 24 → ℤ} (ha : a ∈ subA) : (2 : ℤ) • a ∈ minC := by
  obtain ⟨y, hy⟩ := Code.mem_golay.1 (mem_preG.1 (mem_subA.1 ha).1)
  set s : Fin 24 → ℤ := ∑ i, ((y i).val : ℤ) • R i with hs_def
  have hs : reduceMod 2 24 s = golayEnc y := by
    have hy' : y = ∑ i, y i • (Pi.single i 1 : Fin 12 → ZMod 2) := by
      funext j
      simp [Finset.sum_apply, Pi.single_apply]
    rw [hs_def, map_sum]
    conv_rhs => rw [hy', map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_smul, map_smul, reduceMod_R]
    funext j
    simp only [Pi.smul_apply, zsmul_eq_mul, smul_eq_mul, Int.cast_natCast, ZMod.natCast_zmod_val]
  have hdiv : ∀ j, (2 : ℤ) ∣ a j - s j := by
    intro j
    have h0 : reduceMod 2 24 (a - s) = 0 := by rw [map_sub, hs, hy, sub_self]
    have h1 := congrFun h0 j
    rw [reduceMod_apply, Pi.zero_apply] at h1
    have h2 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 2).1 h1
    simpa using h2
  set w : Fin 24 → ℤ := fun j => (a j - s j) / 2 with hw_def
  have haw : a = s + (2 : ℤ) • w := by
    funext j
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hw_def]
    rw [Int.mul_ediv_cancel' (hdiv j)]
    ring
  have hsum4 : (4 : ℤ) ∣ ∑ j, s j := by
    have h : ∑ j, s j = ∑ i, ((y i).val : ℤ) * ∑ j, R i j := by
      rw [hs_def]
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      rw [Finset.sum_comm]
      simp only [Finset.mul_sum]
    rw [h]
    exact Finset.dvd_sum fun i _ => Dvd.dvd.mul_left (Int.dvd_of_emod_eq_zero (R_sum_mod i)) _
  have hweven : Even (∑ j, w j) := by
    have hsa : ∑ j, a j = ∑ j, s j + 2 * ∑ j, w j := by
      conv_lhs => rw [haw]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Finset.sum_add_distrib, Finset.mul_sum]
    obtain ⟨k1, hk1⟩ := (mem_subA.1 ha).2
    obtain ⟨k2, hk2⟩ := hsum4
    exact ⟨k1 - k2, by omega⟩
  rw [haw, smul_add, smul_smul, show (2 : ℤ) * 2 = 4 by norm_num]
  refine add_mem ?_ (four_smul_mem_minC w hweven)
  rw [hs_def, Finset.smul_sum]
  refine AddSubgroup.sum_mem _ fun i _ => ?_
  rw [smul_comm]
  exact AddSubgroup.zsmul_mem _ (two_smul_R_mem i) _

/-- `u − 8e₀ = (−3, 1²³)` is a minimal vector. -/
theorem uMin_mem_minT : (uVec - Pi.single 0 8 : Fin 24 → ℤ) ∈ minT := by
  refine ⟨Or.inr (mem_subA2.2 ⟨Pi.single 0 (-4), mem_subA.2 ⟨?_, ?_⟩, ?_⟩), ?_⟩
  · have h : (Pi.single 0 (-4) : Fin 24 → ℤ) = (2 : ℤ) • Pi.single 0 (-2) := by
      funext k
      simp only [Pi.smul_apply, smul_eq_mul, Pi.single_apply]
      split_ifs <;> norm_num
    rw [h]
    exact two_smul_mem_preimageOfCode Code.golay _
  · rw [Finset.sum_pi_single']
    simp
  · funext k
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply]
    split_ifs <;> ring
  · decide +kernel

/-- ⭐ **Every vector of the `ℤ²⁴` model of `Λ` is a combination of minimal vectors.** -/
theorem mem_minC_of_mem_carrier {x : Fin 24 → ℤ} (hx : x ∈ Leech.carrier) : x ∈ minC := by
  have h2A : ∀ {y : Fin 24 → ℤ}, y ∈ subA2 → y ∈ minC := fun hy => by
    obtain ⟨a, ha, rfl⟩ := mem_subA2.1 hy
    exact two_smul_subA_mem_minC ha
  rcases mem_carrier.1 hx with hx | hx
  · exact h2A hx
  · have heq : x = (x - uVec) + (uVec - Pi.single 0 8) + (4 : ℤ) • Pi.single 0 2 := by
      funext j
      simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply]
      split_ifs <;> ring
    rw [heq]
    refine add_mem (add_mem (h2A hx) (mem_minC_of_minT uMin_mem_minT))
      (four_smul_mem_minC _ ⟨1, ?_⟩)
    rw [Finset.sum_pi_single']
    simp

/-! ## §4  Transport to `leech` -/

theorem carrier_mem_closure (β : ↥Leech.carrier) :
    β ∈ AddSubgroup.closure
      {α : ↥Leech.carrier | (α : Fin 24 → ℤ) ⬝ᵥ (α : Fin 24 → ℤ) = 32} := by
  set S := {α : ↥Leech.carrier | (α : Fin 24 → ℤ) ⬝ᵥ (α : Fin 24 → ℤ) = 32}
  let φ : ↥Leech.carrier →+ (Fin 24 → ℤ) := Leech.carrier.subtype.toAddMonoidHom
  have hle : minC ≤ (AddSubgroup.closure S).map φ := by
    rw [AddSubgroup.closure_le]
    rintro x ⟨hx, hdot⟩
    exact AddSubgroup.mem_map.2 ⟨⟨x, hx⟩, AddSubgroup.subset_closure hdot, rfl⟩
  obtain ⟨β', hβ', heq⟩ := AddSubgroup.mem_map.1 (hle (mem_minC_of_mem_carrier β.2))
  have hβ : β' = β := Subtype.ext heq
  rwa [← hβ]

/-- The minimal vectors of `leech`, read in the `ℤ²⁴` model. -/
theorem leech_minimal_set_eq :
    {α : leech.carrier | leech.form α α = 4}
      = {α : ↥Leech.carrier | (α : Fin 24 → ℤ) ⬝ᵥ (α : Fin 24 → ℤ) = 32} := by
  refine Set.ext fun (α : ↥Leech.carrier) => ?_
  change ((α : Fin 24 → ℤ) ⬝ᵥ (α : Fin 24 → ℤ)) / 8 = 4 ↔ (α : Fin 24 → ℤ) ⬝ᵥ (α : Fin 24 → ℤ) = 32
  obtain ⟨k, hk⟩ := Leech.eight_dvd_dot α.2 α.2
  rw [hk]
  omega

/-- ⭐ **Node C6: the Leech lattice is the `ℤ`-span of its minimal (norm-`4`) vectors.** -/
theorem leech_mem_closure_minimal (β : leech.carrier) :
    β ∈ AddSubgroup.closure {α : leech.carrier | leech.form α α = 4} := by
  rw [leech_minimal_set_eq]
  exact carrier_mem_closure β

theorem leech_closure_minimal_eq_top :
    AddSubgroup.closure {α : leech.carrier | leech.form α α = 4} = ⊤ :=
  eq_top_iff.2 fun β _ => leech_mem_closure_minimal β

/-- ⭐ **Induction over the minimal vectors of `Λ`.** -/
theorem leech_induction (P : leech.carrier → Prop) (h0 : P 0)
    (hadd : ∀ γ α : leech.carrier, leech.form α α = 4 → P γ → P (γ + α))
    (hsub : ∀ γ α : leech.carrier, leech.form α α = 4 → P γ → P (γ - α))
    (β : leech.carrier) : P β := by
  refine AddSubgroup.closure_induction_right (p := fun x _ => P x) h0 ?_ ?_
    (leech_mem_closure_minimal β)
  · intro x _ y hy hx
    exact hadd x y hy hx
  · intro x _ y hy hx
    rw [← sub_eq_add_neg]
    exact hsub x y hy hx

end VOA.Moonshine.LeechSpan
