import VOA.Moonshine.MoonshineCNStringModule

/-! # Two Virasoro generators and stability of the longitudinal vacua

The generation statements use only the Virasoro commutators, at arbitrary
central charge. The stability statements use the mixed and abelian relations.
-/

namespace VOA.Moonshine.ConwayNorton.StringModule

universe u
variable {H : Type u} [AddCommGroup H] [Module ℂ H] (M : StringModule H)

/-- Annihilation by `L 1` and `L 2` propagates to every positive mode. -/
theorem L_positive_vanish_of_one_two (x : H) (h₁ : M.L 1 x = 0)
    (h₂ : M.L 2 x = 0) (n : ℕ) : M.L (n + 1 : ℤ) x = 0 := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · simpa using h₁
    rcases n with _ | n
    · simpa using h₂
    have hp := ih (n + 1) (by omega)
    have h := M.L_comm_apply (n + 2 : ℤ) 1 x
    have hn : (n + 2 : ℤ) + 1 ≠ 0 := by omega
    have hi : (↑(n + 1) + 1 : ℤ) = n + 2 := by omega
    rw [hi] at hp
    simp only [h₁, hp, map_zero, sub_self, if_neg hn, add_zero] at h
    have hc : ((n + 2 : ℤ) : ℂ) - (1 : ℤ) ≠ 0 := by
      exact_mod_cast (show (n + 2 : ℤ) - 1 ≠ 0 by omega)
    have hz := (smul_eq_zero.mp h.symm).resolve_left hc
    convert hz using 1 <;> congr 2 <;> omega

/-- Physicality is determined by the two smallest positive Virasoro modes. -/
theorem physical_of_L_one_two (x : H) (h₁ : M.L 1 x = 0)
    (h₂ : M.L 2 x = 0) : x ∈ M.physical :=
  (M.mem_physical_iff x).mpr (M.L_positive_vanish_of_one_two x h₁ h₂)

/-- Every negative mode has image in the sum of the first two images. -/
theorem negative_L_range_le_two (n : ℕ) :
    LinearMap.range (M.L (-(n + 1 : ℤ))) ≤
      LinearMap.range (M.L (-1)) ⊔ LinearMap.range (M.L (-2)) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · simpa using (le_sup_left : LinearMap.range (M.L (-1)) ≤
        LinearMap.range (M.L (-1)) ⊔ LinearMap.range (M.L (-2)))
    rcases n with _ | n
    · simpa using (le_sup_right : LinearMap.range (M.L (-2)) ≤
        LinearMap.range (M.L (-1)) ⊔ LinearMap.range (M.L (-2)))
    rintro _ ⟨x, rfl⟩
    let U := LinearMap.range (M.L (-1)) ⊔ LinearMap.range (M.L (-2))
    have hi : (↑(n + 1) + 1 : ℤ) = n + 2 := by omega
    have hm : M.L (-(n + 2 : ℤ)) (M.L (-1) x) ∈ U := by
      apply ih (n + 1) (by omega)
      exact ⟨M.L (-1) x, by rw [hi]⟩
    have h := M.L_comm_apply (-1) (-(n + 2 : ℤ)) x
    have hn : (-1 : ℤ) + -(n + 2 : ℤ) ≠ 0 := by omega
    simp only [if_neg hn, add_zero] at h
    have hs : (((-1 : ℤ) : ℂ) - (-(n + 2 : ℤ) : ℤ)) •
        M.L (-1 + -(n + 2 : ℤ)) x ∈ U := by
      rw [← h]
      exact U.sub_mem
        ((show LinearMap.range (M.L (-1)) ≤ U from le_sup_left)
          ⟨M.L (-(n + 2 : ℤ)) x, rfl⟩) hm
    have hc : (((-1 : ℤ) : ℂ) - (-(n + 2 : ℤ) : ℤ)) ≠ 0 := by
      exact_mod_cast (show (-1 : ℤ) - -(n + 2 : ℤ) ≠ 0 by omega)
    have hz := (Submodule.smul_mem_iff U hc).mp hs
    convert hz using 1 <;> congr 2 <;> omega

/-- The entire spurious space is generated by the images of `L (-1)` and `L (-2)`. -/
theorem spurious_eq_sup_two :
    M.spurious = LinearMap.range (M.L (-1)) ⊔ LinearMap.range (M.L (-2)) := by
  apply le_antisymm
  · exact iSup_le (M.negative_L_range_le_two)
  · apply sup_le
    · rintro _ ⟨x, rfl⟩
      exact M.negative_L_mem_spurious 0 x
    · rintro _ ⟨x, rfl⟩
      exact M.negative_L_mem_spurious 1 x

/-- Positive Virasoro modes preserve the common longitudinal kernel. -/
theorem kVacuum_L_stable (n : ℕ) (x : H) (hx : x ∈ M.kVacuum) :
    M.L (n + 1 : ℤ) x ∈ M.kVacuum := by
  rw [M.mem_kVacuum_iff] at hx ⊢
  intro m
  have h := M.LK_comm_apply (n + 1 : ℤ) (m + 1 : ℤ) (by omega) (by omega) x
  have hi : (n + 1 : ℤ) + (m + 1 : ℤ) = ↑(n + m + 1) + 1 := by omega
  rw [hi, hx m, hx (n + m + 1), map_zero, smul_zero] at h
  exact (sub_eq_zero.mp h).symm

/-- All longitudinal modes preserve the common positive longitudinal kernel. -/
theorem kVacuum_K_stable (n : ℤ) (x : H) (hx : x ∈ M.kVacuum) :
    M.K n x ∈ M.kVacuum := by
  rw [M.mem_kVacuum_iff] at hx ⊢
  intro m
  rw [M.K_comm_apply, hx m, map_zero]

end VOA.Moonshine.ConwayNorton.StringModule
