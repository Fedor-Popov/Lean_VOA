import VOA.Modules.ZhuModule
import VOA.Core.SkewSymmetry
import VOA.Core.Identities

/-!
# A filtered criterion for Zhu generation (VOA-generic)

Let `W` be a VOA and `S ≤ W` a subspace with `𝟙 ∈ S`, `O(W) ≤ S`, `S ∗ S ⊆ S`.  Write
`F_{<n} = ⊕_{k<n} W_k`.  If `F_{<n} ≤ S`, then `S` contains every product `a₍ₘ₎b` with
`a ∈ W_p`, `b ∈ W_q`, `p, q < n`, `m ≤ 0` and `p + q - m - 1 = n` (`lowerProd_subset`).  The three
cases are

* `m = -1`: `a ∗ b = a₍₋₁₎b + ∑_{i≥1} C(p,i) a₍ᵢ₋₁₎b`, the tail lies in `F_{<n}`
  (`zhuMul_sub_normal_mem`);
* `m ≤ -2`: Frenkel–Zhu's higher-pole residue `Pres` (`Pres_mem_O`) has leading term `a₍ₘ₎b`
  (`smul_sub_Pres_mem`);
* `m = 0`: the **filtered commutator formula** `a ∗ b − b ∗ a ≡ a₍₀₎b  (mod O(W) + F_{<p+q-1})`
  (`zhuMul_comm_sub_zero_mem`), from skew-symmetry and `L₋₁y ≡ −(wt y)·y (mod O(W))`
  (`L_neg_one_add_mem_O`, `Tpow_mem`).

Induction on the weight then gives the criterion `eq_top_of_lowerSpan`: if every `W_n`, `n ≥ 1`,
is spanned by `G` together with such "weight-raising products of lower-weight states", then every
`∗`-closed subspace containing `𝟙`, `O(W)` and `G` is all of `W`.

This is the leading-order (associated-graded) form of the standard argument that strong
generators generate `A(W)`; the `m = 0` products are what make it applicable to VOAs that are
**not** strongly generated by `G` (e.g. `V_{Λ₀}⁺` with `G` its weight-2 space).

## Main results
* `L_neg_one_add_mem_O`, `L_neg_one_mem_O_sup` — `(L₋₁ + L₀)y ∈ O(W)`.
* `Tpow_mem` — `T^j y ∈ O(W) ⊔ X` for homogeneous `y ∈ X`.
* `zhuMul_sub_normal_mem`, `smul_sub_Pres_mem`, `zhuMul_comm_sub_zero_mem`.
* `lowerProd`, `lowerProd_subset`, `eq_top_of_lowerSpan`.

## Status
`sorry`-free; no project axiom (no `VOA.pbw`: only `O(W)`, `∗`, skew-symmetry and
`Pres_mem_O` are used).  Reached from the umbrella `VOA/Moonshine.lean`.
-/

set_option linter.style.longLine false

namespace VOA.Moonshine.ZhuGen

open VOA VertexOperatorAlgebra
open Submodule

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] (W : VertexOperatorAlgebra 𝒱)

/-! ## §1  The weight filtration -/

/-- `F_{<n} = ⊕_{k<n} W_k`. -/
noncomputable def Fl (n : ℤ) : Submodule ℂ 𝒱 := ⨆ (k : ℤ) (_ : k < n), W.grading k

variable {W}

theorem grading_le_Fl {k n : ℤ} (h : k < n) : W.grading k ≤ Fl W n :=
  le_iSup₂_of_le k h le_rfl

theorem mem_Fl_of_mem {k n : ℤ} (h : k < n) {x : 𝒱} (hx : x ∈ W.grading k) : x ∈ Fl W n :=
  grading_le_Fl h hx

theorem Fl_le_of {n : ℤ} {S : Submodule ℂ 𝒱} (h : ∀ k < n, W.grading k ≤ S) : Fl W n ≤ S :=
  iSup₂_le fun k hk => h k hk

/-! ## §2  `L₋₁` modulo `O(W)` -/

theorem L_neg_one_add_mem_O (y : 𝒱) : W.L (-1) y + W.L 0 y ∈ O W := by
  have h := gen_mem_O W y W.vacuum
  rwa [zhuMul_vacuum_right] at h

theorem T_eq (y : 𝒱) : W.toPreVertexAlgebra.T y = W.L (-1) y := by rw [T_eq_Lneg1]

theorem L_neg_one_mem_grading {w : ℤ} {y : 𝒱} (hy : y ∈ W.grading w) :
    W.L (-1) y ∈ W.grading (w + 1) := by
  have h := W.grading_mode W.conformalVector W.conformal_mem y hy 0
  rw [show (2 : ℤ) + w - 0 - 1 = w + 1 by ring] at h
  exact h

/-- `L₋₁y + w·y ∈ O(W)` for `y ∈ W_w`. -/
theorem L_neg_one_add_wt_mem_O {w : ℤ} {y : 𝒱} (hy : y ∈ W.grading w) :
    W.L (-1) y + (w : ℂ) • y ∈ O W := by
  have h := L_neg_one_add_mem_O (W := W) y
  rwa [W.L_zero_grading y hy] at h

theorem Tpow_mem_grading {w : ℤ} {y : 𝒱} (hy : y ∈ W.grading w) (j : ℕ) :
    (W.toPreVertexAlgebra.T ^ j) y ∈ W.grading (w + j) := by
  induction j with
  | zero => simpa using hy
  | succ j ih =>
    rw [pow_succ', Module.End.mul_apply, T_eq]
    have := L_neg_one_mem_grading ih
    rwa [show w + (j : ℤ) + 1 = w + ((j + 1 : ℕ) : ℤ) by push_cast; ring] at this

/-- `T^j y ∈ O(W) ⊔ X` for homogeneous `y ∈ X`. -/
theorem Tpow_mem {w : ℤ} {y : 𝒱} (hy : y ∈ W.grading w) {X : Submodule ℂ 𝒱} (hyX : y ∈ X)
    (j : ℕ) : (W.toPreVertexAlgebra.T ^ j) y ∈ O W ⊔ X := by
  induction j with
  | zero => simpa using mem_sup_right hyX
  | succ j ih =>
    rw [pow_succ', Module.End.mul_apply, T_eq]
    have hO := L_neg_one_add_wt_mem_O (Tpow_mem_grading hy j)
    have : W.L (-1) ((W.toPreVertexAlgebra.T ^ j) y)
        = (W.L (-1) ((W.toPreVertexAlgebra.T ^ j) y) + ((w + j : ℤ) : ℂ) • (W.toPreVertexAlgebra.T ^ j) y)
          - ((w + j : ℤ) : ℂ) • (W.toPreVertexAlgebra.T ^ j) y := by abel
    rw [this]
    exact sub_mem (mem_sup_left hO) (smul_mem _ _ ih)

/-! ## §3  The three leading-term identities -/

theorem smul_mem_Fl {p q m n : ℤ} {a b : 𝒱} (ha : a ∈ W.grading p) (hb : b ∈ W.grading q)
    (h : p + q - m - 1 < n) : W.smul a m b ∈ Fl W n :=
  mem_Fl_of_mem h (W.toPreVertexAlgebra.smul_mem_grading ha hb m)

/-- `a ∗ b − a₍₋₁₎b ∈ F_{<p+q}`. -/
theorem zhuMul_sub_normal_mem {p q : ℤ} {a b : 𝒱} (ha : a ∈ W.grading p) (hb : b ∈ W.grading q) :
    zhuMul W a b - W.smul a (-1) b ∈ Fl W (p + q) := by
  rw [zhuMul_homogeneous' W ha, Finset.sum_range_succ', Nat.cast_zero, cbz_zero, one_smul,
    zero_sub, add_sub_cancel_right]
  refine sum_mem fun i _ => smul_mem _ _ (smul_mem_Fl ha hb ?_)
  push_cast; omega

/-- `a₍₋₂₋ₖ₎b − Pres(a, p, b, k) ∈ F_{<p+q+1+k}` (`a ∈ W_p`, `p : ℕ`). -/
theorem smul_sub_Pres_mem {p : ℕ} {q : ℤ} {a b : 𝒱} (ha : a ∈ W.grading (p : ℤ))
    (hb : b ∈ W.grading q) (k : ℕ) :
    W.smul a (-2 - k) b - Pres W p a b k ∈ Fl W (p + q + 1 + k) := by
  unfold Pres
  rw [Finset.sum_range_succ', Nat.cast_zero, cbz_zero, one_smul, zero_sub]
  rw [show W.smul a (-2 - k) b - (∑ i ∈ Finset.range (p + k), cbz ((p : ℤ) + k) ((i + 1 : ℕ) : ℤ) •
      W.smul a (((i + 1 : ℕ) : ℤ) - 2 - k) b + W.smul a (-2 - k) b)
      = -(∑ i ∈ Finset.range (p + k), cbz ((p : ℤ) + k) ((i + 1 : ℕ) : ℤ) •
      W.smul a (((i + 1 : ℕ) : ℤ) - 2 - k) b) by abel]
  refine neg_mem (sum_mem fun i _ => smul_mem _ _ (smul_mem_Fl ha hb ?_))
  push_cast; omega

/-- A finite-support `finsum` over `ℕ`, with all terms of index `≥ 2` in `X`, is congruent to its
first two terms modulo `X`. -/
theorem finsum_sub_two_mem {f : ℕ → 𝒱} (hf : (Function.support f).Finite) {X : Submodule ℂ 𝒱}
    (hX : ∀ j, 2 ≤ j → f j ∈ X) : (∑ᶠ j, f j) - f 0 - f 1 ∈ X := by
  set s : Finset ℕ := hf.toFinset ∪ {0, 1}
  have hsub : Function.support f ⊆ ↑s := by
    intro j hj; simp [s, hj]
  rw [finsum_eq_sum_of_support_subset f hsub]
  have h01 : ({0, 1} : Finset ℕ) ⊆ s := Finset.subset_union_right
  rw [← Finset.sum_sdiff h01, Finset.sum_pair (by norm_num)]
  rw [show (∑ x ∈ s \ {0, 1}, f x + (f 0 + f 1)) - f 0 - f 1 = ∑ x ∈ s \ {0, 1}, f x by abel]
  refine sum_mem fun j hj => hX j ?_
  simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton, not_or] at hj
  omega

theorem finsum_sub_one_mem {f : ℕ → 𝒱} (hf : (Function.support f).Finite) {X : Submodule ℂ 𝒱}
    (hX : ∀ j, 1 ≤ j → f j ∈ X) : (∑ᶠ j, f j) - f 0 ∈ X := by
  have h := finsum_sub_two_mem hf (X := X) (fun j hj => hX j (by omega))
  have h1 := hX 1 le_rfl
  have := add_mem h h1
  rwa [sub_add_cancel] at this

/-- The skew-symmetry formula in `smul` form:
`b₍ₙ₎a = ∑ᶠ_j (1/j!) (−1)^{n+1+j} T^j (a₍ₙ₊ⱼ₎b)`. -/
theorem skew_smul (a b : 𝒱) (n : ℤ) :
    W.smul b n a = ∑ᶠ j : ℕ, ((j.factorial : ℂ)⁻¹) • (sgn (-n - 1 - j)) •
      ((W.toPreVertexAlgebra.T ^ j) (W.smul a (n + j) b)) := by
  rw [skew_mode W b a n]
  refine finsum_congr fun j => ?_
  rw [show (W.Y a) (-n - 1 - j) b = W.smul a (n + j) b by
    rw [PreVertexAlgebra.smul_eq_coeff, show -(n + (j : ℤ)) - 1 = -n - 1 - j by ring]]

theorem skew_smul_support (a b : 𝒱) (n : ℤ) :
    (Function.support fun j : ℕ => ((j.factorial : ℂ)⁻¹) • (sgn (-n - 1 - j)) •
      ((W.toPreVertexAlgebra.T ^ j) (W.smul a (n + j) b))).Finite := by
  have h := skew_support_finite W b a (-n - 1)
  refine h.subset fun j hj => ?_
  rw [Function.mem_support] at hj ⊢
  rwa [show (W.Y a) (-n - 1 - j) b = W.smul a (n + j) b by
    rw [PreVertexAlgebra.smul_eq_coeff, show -(n + (j : ℤ)) - 1 = -n - 1 - j by ring]]

theorem sgn_zero' : sgn 0 = 1 := by simp [sgn]
theorem sgn_neg_one' : sgn (-1) = -1 := by simp [sgn]

theorem skew_term_mem {p q : ℤ} {a b : 𝒱} (ha : a ∈ W.grading p) (hb : b ∈ W.grading q)
    (n : ℤ) (j : ℕ) (hj : 0 < n + j) :
    ((j.factorial : ℂ)⁻¹) • (sgn (-n - 1 - j)) • ((W.toPreVertexAlgebra.T ^ j) (W.smul a (n + j) b))
      ∈ O W ⊔ Fl W (p + q - 1) := by
  have hy : W.smul a (n + j) b ∈ W.grading (p + q - (n + j) - 1) :=
    W.toPreVertexAlgebra.smul_mem_grading ha hb (n + j)
  have hlt : p + q - (n + j) - 1 < p + q - 1 := by omega
  have hF : W.smul a (n + j) b ∈ Fl W (p + q - 1) := mem_Fl_of_mem hlt hy
  have hT := Tpow_mem hy (X := Fl W (p + q - 1)) hF j
  exact Submodule.smul_mem _ _ (Submodule.smul_mem _ _ hT)

/-- `b₍₋₁₎a − a₍₋₁₎b + L₋₁(a₍₀₎b) ∈ O(W) ⊔ F_{<p+q-1}`. -/
theorem skew_neg_one_mem {p q : ℤ} {a b : 𝒱} (ha : a ∈ W.grading p) (hb : b ∈ W.grading q) :
    W.smul b (-1) a - W.smul a (-1) b + W.L (-1) (W.smul a 0 b) ∈ O W ⊔ Fl W (p + q - 1) := by
  have h := finsum_sub_two_mem (skew_smul_support (W := W) a b (-1))
    (X := O W ⊔ Fl W (p + q - 1)) (fun j hj => skew_term_mem ha hb (-1) j (by omega))
  rw [← skew_smul] at h
  simp only [Nat.factorial_zero, Nat.factorial_one, Nat.cast_one, inv_one, one_smul,
    Nat.cast_zero, add_zero, pow_zero, Module.End.one_apply, pow_one, Nat.cast_one] at h
  rw [show -(-1 : ℤ) - 1 - 0 = 0 by norm_num, show -(-1 : ℤ) - 1 - 1 = -1 by norm_num,
    show (-1 : ℤ) + 1 = 0 by norm_num, sgn_zero', sgn_neg_one', one_smul, T_eq, neg_one_smul,
    sub_neg_eq_add] at h
  exact h

/-- `b₍₀₎a + a₍₀₎b ∈ O(W) ⊔ F_{<p+q-1}`. -/
theorem skew_zero_mem {p q : ℤ} {a b : 𝒱} (ha : a ∈ W.grading p) (hb : b ∈ W.grading q) :
    W.smul b 0 a + W.smul a 0 b ∈ O W ⊔ Fl W (p + q - 1) := by
  have h := finsum_sub_one_mem (skew_smul_support (W := W) a b 0)
    (X := O W ⊔ Fl W (p + q - 1)) (fun j hj => skew_term_mem ha hb 0 j (by omega))
  rw [← skew_smul] at h
  simp only [Nat.factorial_zero, Nat.cast_one, inv_one, one_smul, Nat.cast_zero, add_zero,
    pow_zero, Module.End.one_apply] at h
  rw [show -(0 : ℤ) - 1 - 0 = -1 by norm_num, sgn_neg_one', neg_one_smul, sub_neg_eq_add] at h
  exact h

/-- `a ∗ b − a₍₋₁₎b − p·a₍₀₎b ∈ F_{<p+q-1}`. -/
theorem zhuMul_sub_two_mem {p q : ℤ} {a b : 𝒱} (ha : a ∈ W.grading p) (hb : b ∈ W.grading q)
    (hp : 0 ≤ p) :
    zhuMul W a b - W.smul a (-1) b - (p : ℂ) • W.smul a 0 b ∈ Fl W (p + q - 1) := by
  rw [zhuMul_homogeneous' W ha]
  rcases eq_or_lt_of_le hp with h0 | hpos
  · subst h0
    simp only [Int.toNat_zero, zero_add, Finset.range_one, Finset.sum_singleton, Nat.cast_zero,
      cbz_zero, one_smul, zero_sub, Int.cast_zero, zero_smul, sub_self]
    exact zero_mem _
  obtain ⟨P, rfl⟩ : ∃ P : ℕ, p = (P + 1 : ℕ) := ⟨(p - 1).toNat, by omega⟩
  rw [show ((P + 1 : ℕ) : ℤ).toNat + 1 = (P + 1) + 1 by simp, Finset.sum_range_succ',
    Finset.sum_range_succ']
  simp only [Nat.cast_zero, cbz_zero, one_smul, zero_sub]
  have hc1 : cbz (((P + 1 : ℕ) : ℤ)) (((0 + 1 : ℕ) : ℤ)) = ((P + 1 : ℕ) : ℂ) := by
    rw [cbz_apply_nonneg _ (by norm_num)]
    simp [gBinom]
  rw [hc1, show (((0 + 1 : ℕ) : ℤ) - 1) = 0 by norm_num]
  rw [show (∑ i ∈ Finset.range P, cbz ((P + 1 : ℕ) : ℤ) (((i + 1 + 1 : ℕ) : ℤ)) •
        W.smul a (((i + 1 + 1 : ℕ) : ℤ) - 1) b + ((P + 1 : ℕ) : ℂ) • W.smul a 0 b
        + W.smul a (-1) b) - W.smul a (-1) b - ((((P + 1 : ℕ) : ℤ) : ℂ)) • W.smul a 0 b
      = ∑ i ∈ Finset.range P, cbz ((P + 1 : ℕ) : ℤ) (((i + 1 + 1 : ℕ) : ℤ)) •
        W.smul a (((i + 1 + 1 : ℕ) : ℤ) - 1) b by push_cast; abel]
  refine sum_mem fun i _ => smul_mem _ _ (smul_mem_Fl ha hb ?_)
  push_cast; omega

/-- **The filtered commutator formula**: `a ∗ b − b ∗ a − a₍₀₎b ∈ O(W) ⊔ F_{<p+q-1}`. -/
theorem zhuMul_comm_sub_zero_mem {p q : ℤ} {a b : 𝒱} (ha : a ∈ W.grading p)
    (hb : b ∈ W.grading q) (hp : 0 ≤ p) (hq : 0 ≤ q) :
    zhuMul W a b - zhuMul W b a - W.smul a 0 b ∈ O W ⊔ Fl W (p + q - 1) := by
  set X := O W ⊔ Fl W (p + q - 1)
  have h1 : zhuMul W a b - W.smul a (-1) b - (p : ℂ) • W.smul a 0 b ∈ X :=
    mem_sup_right (zhuMul_sub_two_mem ha hb hp)
  have h2 : zhuMul W b a - W.smul b (-1) a - (q : ℂ) • W.smul b 0 a ∈ X :=
    mem_sup_right (by
      have := zhuMul_sub_two_mem hb ha hq
      rwa [show q + p - 1 = p + q - 1 by ring] at this)
  have h3 := skew_neg_one_mem ha hb
  have h4 := skew_zero_mem ha hb
  have hy := W.toPreVertexAlgebra.smul_mem_grading ha hb 0
  have h5 : W.L (-1) (W.smul a 0 b) + (((p + q - 0 - 1 : ℤ)) : ℂ) • W.smul a 0 b ∈ X :=
    mem_sup_left (L_neg_one_add_wt_mem_O hy)
  have key : zhuMul W a b - zhuMul W b a - W.smul a 0 b
      = (zhuMul W a b - W.smul a (-1) b - (p : ℂ) • W.smul a 0 b)
        - (zhuMul W b a - W.smul b (-1) a - (q : ℂ) • W.smul b 0 a)
        - (W.smul b (-1) a - W.smul a (-1) b + W.L (-1) (W.smul a 0 b))
        + (W.L (-1) (W.smul a 0 b) + (((p + q - 0 - 1 : ℤ)) : ℂ) • W.smul a 0 b)
        - (q : ℂ) • (W.smul b 0 a + W.smul a 0 b) := by
    push_cast
    module
  rw [key]
  exact sub_mem (add_mem (sub_mem (sub_mem h1 h2) h3) h5) (smul_mem _ _ h4)

/-! ## §4  The criterion -/

variable (W)

/-- The **weight-raising products of lower-weight states** of weight `n`:
`a₍ₘ₎b` with `a ∈ W_p`, `b ∈ W_q`, `p, q < n`, `m ≤ 0`, `p + q − m − 1 = n`. -/
def lowerProd (n : ℤ) : Set 𝒱 :=
  {x | ∃ p q m : ℤ, p < n ∧ q < n ∧ m ≤ 0 ∧ p + q - m - 1 = n ∧
    ∃ a ∈ W.grading p, ∃ b ∈ W.grading q, x = W.smul a m b}

variable {W}

theorem mem_grading_neg_eq_zero {k : ℤ} (hk : k < 0) {x : 𝒱} (hx : x ∈ W.grading k) : x = 0 := by
  rw [W.positivity k hk] at hx; exact (mem_bot ℂ).mp hx

/-- If `S ⊇ O(W)` is `∗`-closed and contains `F_{<n}`, it contains `lowerProd W n`. -/
theorem lowerProd_subset {S : Submodule ℂ 𝒱} (hO : O W ≤ S)
    (hmul : ∀ a ∈ S, ∀ b ∈ S, zhuMul W a b ∈ S) {n : ℤ} (hF : Fl W n ≤ S) :
    lowerProd W n ⊆ S := by
  rintro x ⟨p, q, m, hp, hq, hm, hw, a, ha, b, hb, rfl⟩
  have haS : a ∈ S := hF (mem_Fl_of_mem hp ha)
  have hbS : b ∈ S := hF (mem_Fl_of_mem hq hb)
  -- negative weights are zero
  rcases lt_or_ge p 0 with hp0 | hp0
  · rw [mem_grading_neg_eq_zero hp0 ha, PreVertexAlgebra.smul_zero_left]; exact zero_mem _
  rcases lt_or_ge q 0 with hq0 | hq0
  · rw [mem_grading_neg_eq_zero hq0 hb, PreVertexAlgebra.smul_zero_right]; exact zero_mem _
  have hOF : O W ⊔ Fl W n ≤ S := sup_le hO hF
  rcases lt_trichotomy m (-1) with hlt | heq | hgt
  · -- `m ≤ -2`: the residue `Pres`
    obtain ⟨P, rfl⟩ : ∃ P : ℕ, p = (P : ℤ) := ⟨p.toNat, by omega⟩
    obtain ⟨k, rfl⟩ : ∃ k : ℕ, m = -2 - k := ⟨(-2 - m).toNat, by omega⟩
    have h1 := smul_sub_Pres_mem ha hb k
    rw [show (P : ℤ) + q + 1 + k = n by omega] at h1
    have h2 : Pres W P a b k ∈ S := hO (Pres_mem_O W ha b k)
    have := add_mem (hF h1) h2
    rwa [sub_add_cancel] at this
  · -- `m = -1`: the Zhu product
    subst heq
    have h1 := zhuMul_sub_normal_mem ha hb
    rw [show p + q = n by omega] at h1
    have := sub_mem (hmul a haS b hbS) (hF h1)
    rwa [sub_sub_cancel] at this
  · -- `m = 0`: the commutator
    have hm0 : m = 0 := by omega
    subst hm0
    have h1 := zhuMul_comm_sub_zero_mem ha hb hp0 hq0
    rw [show p + q - 1 = n by omega] at h1
    have h2 := sub_mem (hmul a haS b hbS) (hmul b hbS a haS)
    have := sub_mem h2 (hOF h1)
    rwa [sub_sub_cancel] at this

/-- **The filtered Zhu-generation criterion.**  If every `W_n` (`n ≥ 1`) is spanned by `G` and
the weight-raising products of lower-weight states, then every subspace containing `𝟙`, `O(W)`
and `G` and closed under `∗` is all of `W`. -/
theorem eq_top_of_lowerSpan (G : Set 𝒱)
    (hG : ∀ n : ℤ, 0 < n → W.grading n ≤ span ℂ (G ∪ lowerProd W n))
    (S : Submodule ℂ 𝒱) (h1 : W.vacuum ∈ S) (hO : O W ≤ S)
    (hmul : ∀ a ∈ S, ∀ b ∈ S, zhuMul W a b ∈ S) (hGS : G ⊆ S) : S = ⊤ := by
  have key : ∀ N : ℕ, ∀ k : ℤ, k < N → W.grading k ≤ S := by
    intro N
    induction N with
    | zero =>
      intro k hk
      rw [W.positivity k (by exact_mod_cast hk)]; exact bot_le
    | succ N ih =>
      intro k hk
      rcases lt_or_eq_of_le (show k ≤ N by omega) with hlt | heq
      · exact ih k hlt
      subst heq
      rcases Nat.eq_zero_or_pos N with h0 | hpos
      · subst h0
        rw [show ((0 : ℕ) : ℤ) = 0 by rfl, W.vacuum_grade, span_le]
        rintro _ rfl; exact h1
      · refine (hG N (by exact_mod_cast hpos)).trans (span_le.mpr ?_)
        rintro x (hx | hx)
        · exact hGS hx
        · exact lowerProd_subset hO hmul (Fl_le_of ih) hx
  rw [eq_top_iff, ← W.isInternal.submodule_iSup_eq_top, iSup_le_iff]
  intro k
  rcases lt_or_ge k 0 with hk | hk
  · rw [W.positivity k hk]; exact bot_le
  · exact key (k.toNat + 1) k (by omega)

end VOA.Moonshine.ZhuGen
