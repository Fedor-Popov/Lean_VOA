import VOA.Modules.WeakModule
import VOA.Core.Automorphism
import VOA.Moonshine.CyclicVacuumTrick
import VOA.Moonshine.TrialityTwGeneric

/-!
# Existence of a twisted intertwiner from its top level  (Moonshine step M8g twisted half)

Generic, lattice-free module theory for the triality `σ` on the twisted sectors of `V♮`
(`SigmaExistLeech.lean`).

Let `W` be a VOA, `A` a weak `W`-module on `M` (the source), `B` a weak `W`-module on `N` (the
target, already twisted by the automorphism), `β` a bilinear form on `N`, and `Ω ≤ M` a "top
level".  Given a linear map `φ : M → N`, the question is whether `x₀ ↦ φ x₀` extends to a
module map on the cyclic module generated by `x₀ ∈ Ω`, i.e. whether `(x₀, φ x₀)` is
annihilator-compatible (`TrialityTw.AnnCompat`).

The answer proved here (`annCompat_of_top`) is the module-theoretic half of the Zhu
correspondence, done **without** the generalized Verma module (hence without the `VOA.pbw`
axiom that the library's Dong–Jiang `M(U)` carries):

* the submodule of `A ⊕ B` generated by the graph `{(x, φ x) | x ∈ Ω}` is spanned by **single
  modes** `(a₍q₎x, a₍q₎φx)` (`act_act_mem_span`, Li's lemma, from the module Jacobi identity by
  an induction on the truncation order — the module form of `mem_span_iterate_of_vacuum`);
* a linear functional which kills the single-mode generators kills the whole generated
  submodule; the hypothesis `hZO` ("top-level compatibility": on homogeneous letters, the
  `Ω`-component of `a₍q₎x` is sent by `φ` to the component of `a₍q₎φx` that `β` sees against
  `φ Ω`) makes `(m, n) ↦ β n (φ x') − β (φ (P m)) (φ x')` such a functional;
* `B`-invariance of `β` (`hadj`, adjoints of modes are combinations of modes) moves every
  test vector `c₍r₎ φ x'` back to `φ x'`, so a second component `y` of `(0, y)` in the
  generated submodule is `β`-orthogonal to the span `Y_G` of the `c₍r₎ φ x'`;
* nondegeneracy of `β` on that span (`hnd`) forces `y = 0`, which is annihilator
  compatibility.

## Main definitions
* `prodModule` — the direct sum of two weak modules.
* `twistModule` — a weak module twisted by a VOA automorphism (`Y^g(u) = Y(g u)`).
* `modeSpan A U` — `span{a₍q₎u | a ∈ 𝒱, q ∈ ℤ, u ∈ U}`.

## Main results
* `act_act_mem_span` — `v₍p₎ u₍n₎ x ∈ span{a₍q₎ x}` (single-mode spanning of a cyclic module).
* `act_mem_modeSpan` — `modeSpan A U` is a submodule.
* `annCompat_of_top` — top-level compatibility + invariance + nondegeneracy ⇒
  annihilator compatibility, hence (with `TrialityTw.exists_twInt_iff`) existence of the
  intertwiner.
* `annCompat_twist_iff` — `AnnCompat` with a twist `g` is `AnnCompat` for the twisted action.

## Status
`sorry`-free; `#print axioms` of every declaration: `[propext, Classical.choice, Quot.sound]`.
Lattice-free.  These are reductions: the top-level datum `φ` is an explicit hypothesis.
-/

set_option linter.style.longLine false

namespace VOA.Moonshine.SigmaExist

open VOA VOA.Moonshine.TrialityTw
open Module (End)
open Submodule

universe u v w

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
variable {M : Type v} [AddCommGroup M] [Module ℂ M] {N : Type w} [AddCommGroup N] [Module ℂ N]

/-! ## §0  Finsum helpers -/

/-- A `finsum` of a family supported in `[0, K)` has finite support. -/
theorem support_finite_of_vanish {X : Type*} [AddCommMonoid X] (f : ℤ → X) (K : ℤ)
    (hneg : ∀ i, i < 0 → f i = 0) (hbig : ∀ i, K ≤ i → f i = 0) :
    (Function.support f).Finite := by
  refine (Set.finite_Ico (0 : ℤ) K).subset ?_
  intro i hi
  rw [Function.mem_support] at hi
  refine ⟨?_, ?_⟩
  · by_contra h; exact hi (hneg i (by omega))
  · by_contra h; exact hi (hbig i (by omega))

/-- If a finitely supported family has its `finsum` in `S` and all terms but the `0`-th in `S`,
then the `0`-th term is in `S`. -/
theorem zero_term_mem {X : Type*} [AddCommGroup X] [Module ℂ X] (S : Submodule ℂ X) (f : ℤ → X)
    (hfin : (Function.support f).Finite) (hsum : (∑ᶠ i, f i) ∈ S) (hne : ∀ i, i ≠ 0 → f i ∈ S) :
    f 0 ∈ S := by
  set g : ℤ → X := fun i => if i = 0 then 0 else f i
  set e : ℤ → X := fun i => if i = 0 then f 0 else 0
  have hfg : ∀ i, f i = g i + e i := by
    intro i; by_cases h : i = 0
    · subst h; simp [g, e]
    · simp [g, e, h]
  have hg : (Function.support g).Finite :=
    hfin.subset (fun i hi => by
      rw [Function.mem_support] at hi ⊢
      by_cases h : i = 0
      · simp [g, h] at hi
      · simpa [g, h] using hi)
  have he : (Function.support e).Finite :=
    (Set.finite_singleton (0 : ℤ)).subset (fun i hi => by
      rw [Function.mem_support] at hi
      by_contra h
      exact hi (by simp [e, show i ≠ 0 from h]))
  have hsplit : (∑ᶠ i, f i) = (∑ᶠ i, g i) + ∑ᶠ i, e i := by
    rw [← finsum_add_distrib hg he]
    exact finsum_congr hfg
  have he0 : (∑ᶠ i, e i) = f 0 := by
    rw [finsum_eq_single _ (0 : ℤ) (fun i hi => by simp [e, hi])]
    simp [e]
  have hgS : (∑ᶠ i, g i) ∈ S :=
    finsum_mem_submodule_of_forall S g (fun i => by
      by_cases h : i = 0
      · simp [g, h]
      · simpa [g, h] using hne i h)
  have : f 0 = (∑ᶠ i, f i) - ∑ᶠ i, g i := by rw [hsplit, he0]; abel
  rw [this]
  exact S.sub_mem hsum hgS

/-! ## §1  Products and twists of weak modules -/

/-- The state–field map of the direct sum of two weak modules. -/
noncomputable def prodYM (A : WeakModule W M) (B : WeakModule W N) :
    𝒱 →ₗ[ℂ] FormalDist (End ℂ (M × N)) where
  toFun u := fun k => LinearMap.prodMap (A.YM u k) (B.YM u k)
  map_add' u v := by
    funext k
    apply LinearMap.ext; intro x
    change ((A.YM (u + v) k) x.1, (B.YM (u + v) k) x.2)
      = ((A.YM u k) x.1 + (A.YM v k) x.1, (B.YM u k) x.2 + (B.YM v k) x.2)
    rw [map_add, map_add]; rfl
  map_smul' c u := by
    funext k
    apply LinearMap.ext; intro x
    change ((A.YM (c • u) k) x.1, (B.YM (c • u) k) x.2) = (c • (A.YM u k) x.1, c • (B.YM u k) x.2)
    rw [map_smul, map_smul]; rfl

theorem mode_prodYM (A : WeakModule W M) (B : WeakModule W N) (u : 𝒱) (n : ℤ) (p : M × N) :
    mode (prodYM A B u) n p = (mode (A.YM u) n p.1, mode (B.YM u) n p.2) := rfl

omit [Module ℂ M] [Module ℂ N] in
/-- The first projection commutes with a finitely supported `finsum`. -/
theorem fst_finsum {f : ℤ → M × N} (hf : (Function.support f).Finite) :
    (∑ᶠ i, f i).1 = ∑ᶠ i, (f i).1 :=
  (AddMonoidHom.fst M N).map_finsum hf

omit [Module ℂ M] [Module ℂ N] in
theorem snd_finsum {f : ℤ → M × N} (hf : (Function.support f).Finite) :
    (∑ᶠ i, f i).2 = ∑ᶠ i, (f i).2 :=
  (AddMonoidHom.snd M N).map_finsum hf

/-- **The direct sum of two weak modules.** -/
noncomputable def prodModule (A : WeakModule W M) (B : WeakModule W N) :
    WeakModule W (M × N) where
  YM := prodYM A B
  vacuum_YM := by
    funext k
    apply LinearMap.ext; intro x
    change (A.YM W.vacuum k x.1, B.YM W.vacuum k x.2) = ((1 : FormalDist (End ℂ (M × N))) k) x
    rw [A.vacuum_YM, B.vacuum_YM, FormalDist.one_apply, FormalDist.one_apply,
      FormalDist.one_apply]
    split_ifs <;> rfl
  truncation u p := by
    obtain ⟨Na, hNa⟩ := A.truncation u p.1
    obtain ⟨Nb, hNb⟩ := B.truncation u p.2
    refine ⟨max Na Nb, fun n hn => ?_⟩
    rw [mode_prodYM, hNa n (le_trans (le_max_left _ _) hn), hNb n (le_trans (le_max_right _ _) hn)]
    rfl
  jacobi u v p ℓ m n := by
    -- truncation bounds
    obtain ⟨Na, hNa⟩ := A.truncation v p.1
    obtain ⟨Nb, hNb⟩ := B.truncation v p.2
    obtain ⟨Ma, hMa⟩ := A.truncation u p.1
    obtain ⟨Mb, hMb⟩ := B.truncation u p.2
    obtain ⟨R, hR⟩ := W.regularity u v
    set K : ℤ := max (max (Na - n) (Nb - n)) (max (Ma - m) (Mb - m))
    have hL : (Function.support fun i : ℤ => (negOnePow i * cbz ℓ i) •
        (mode (prodYM A B u) (ℓ + m - i) (mode (prodYM A B v) (n + i) p)
          - negOnePow ℓ • mode (prodYM A B v) (ℓ + n - i) (mode (prodYM A B u) (m + i) p))).Finite := by
      refine support_finite_of_vanish _ K (fun i hi => by rw [cbz_apply_neg _ hi]; simp) ?_
      intro i hi
      simp only [mode_prodYM]
      rw [hNa (n + i) (by omega), hNb (n + i) (by omega), hMa (m + i) (by omega),
        hMb (m + i) (by omega)]
      simp
    have hR' : (Function.support fun i : ℤ =>
        cbz m i • mode (prodYM A B (W.smul u (ℓ + i) v)) (m + n - i) p).Finite := by
      refine support_finite_of_vanish _ (max (R - ℓ) 0) (fun i hi => by rw [cbz_apply_neg _ hi]; simp) ?_
      intro i hi
      rw [show W.smul u (ℓ + i) v = 0 from hR (ℓ + i) (by omega), map_zero]
      simp only [smul_eq_zero]
      exact Or.inr rfl
    ext
    · rw [fst_finsum hL, fst_finsum hR']
      exact A.jacobi u v p.1 ℓ m n
    · rw [snd_finsum hL, snd_finsum hR']
      exact B.jacobi u v p.2 ℓ m n

@[simp] theorem prodModule_act (A : WeakModule W M) (B : WeakModule W N) (u : 𝒱) (n : ℤ)
    (p : M × N) : (prodModule A B).act u n p = (A.act u n p.1, B.act u n p.2) := rfl

/-- **A weak module twisted by an automorphism**: `Y^g(u, z) = Y(g u, z)`. -/
noncomputable def twistModule (B : WeakModule W N) (g : Aut W) : WeakModule W N where
  YM := B.YM.comp g.toLinearEquiv.toLinearMap
  vacuum_YM := by
    change B.YM (g W.vacuum) = 1
    rw [g.map_vacuum, B.vacuum_YM]
  truncation u x := B.truncation (g u) x
  jacobi u v x ℓ m n := by
    have h := B.jacobi (g u) (g v) x ℓ m n
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [h]
    refine finsum_congr (fun i => ?_)
    rw [← g.map_smul]

@[simp] theorem twistModule_act (B : WeakModule W N) (g : Aut W) (u : 𝒱) (n : ℤ) (x : N) :
    (twistModule B g).act u n x = B.act (g u) n x := rfl

theorem mode_twistModule (B : WeakModule W N) (g : Aut W) (u : 𝒱) (n : ℤ) :
    mode ((twistModule B g).YM u) n = mode (B.YM (g u)) n := rfl

/-! ## §2  Single-mode spanning (Li's lemma) -/

/-- The span of all single modes applied to vectors of `U`. -/
noncomputable def modeSpan {P : Type*} [AddCommGroup P] [Module ℂ P] (A : WeakModule W P)
    (U : Set P) : Submodule ℂ P :=
  span ℂ {y | ∃ a : 𝒱, ∃ q : ℤ, ∃ x ∈ U, y = A.act a q x}

/-- **Li's lemma (single-mode spanning).**  For a weak module and any `x`,
`v₍p₎ u₍n₎ x ∈ span{a₍q₎ x | a ∈ 𝒱, q ∈ ℤ}`.  Proof: the module Jacobi identity with
`(ℓ, m) = (p − m, m)`, `m` beyond the truncation of `v` at `x`, expresses `v₍p₎u₍n₎x` through
`(v₍ℓ₊ᵢ₎u)₍ₘ₊ₙ₋ᵢ₎x` and the terms `v₍p₋ᵢ₎u₍n₊ᵢ₎x` (`i ≥ 1`), which are handled by induction on the
truncation order of `u` at `x`. -/
theorem act_act_mem_span {P : Type*} [AddCommGroup P] [Module ℂ P] (A : WeakModule W P) (x : P)
    (u v : 𝒱) (n p : ℤ) :
    A.act v p (A.act u n x) ∈ span ℂ {y | ∃ a : 𝒱, ∃ q : ℤ, y = A.act a q x} := by
  set S := span ℂ {y | ∃ a : 𝒱, ∃ q : ℤ, y = A.act a q x}
  obtain ⟨K, hK⟩ := A.truncation u x
  suffices H : ∀ d : ℕ, ∀ n : ℤ, K - n ≤ d → ∀ (v : 𝒱) (p : ℤ), A.act v p (A.act u n x) ∈ S by
    exact H (K - n).toNat n (by omega) v p
  intro d
  induction d with
  | zero =>
    intro n hn v p
    rw [WeakModule.act_def, WeakModule.act_def, hK n (by omega), map_zero]
    exact S.zero_mem
  | succ d ih =>
    intro n hn v p
    by_cases hnK : K ≤ n
    · rw [WeakModule.act_def, WeakModule.act_def, hK n hnK, map_zero]
      exact S.zero_mem
    obtain ⟨Mv, hMv⟩ := A.truncation v x
    set m : ℤ := max Mv 0
    set ℓ : ℤ := p - m
    have hJ := A.jacobi v u x ℓ m n
    set f : ℤ → P := fun i => (negOnePow i * cbz ℓ i) •
      (mode (A.YM v) (ℓ + m - i) (mode (A.YM u) (n + i) x)
        - negOnePow ℓ • mode (A.YM u) (ℓ + n - i) (mode (A.YM v) (m + i) x)) with hf
    have hvan : ∀ i : ℤ, 0 ≤ i → mode (A.YM v) (m + i) x = 0 := fun i hi => hMv _ (by omega)
    have hfin : (Function.support f).Finite := by
      refine support_finite_of_vanish f (K - n) (fun i hi => by simp [hf, cbz_apply_neg _ hi]) ?_
      intro i hi
      simp only [hf]
      rw [hK (n + i) (by omega), hvan i (by omega)]
      simp
    have hsum : (∑ᶠ i, f i) ∈ S := by
      rw [hJ]
      refine finsum_mem_submodule_of_forall S _ (fun i => S.smul_mem _ (subset_span ?_))
      exact ⟨W.smul v (ℓ + i) u, m + n - i, rfl⟩
    have hne : ∀ i : ℤ, i ≠ 0 → f i ∈ S := by
      intro i hi
      rcases lt_or_gt_of_ne hi with h | h
      · simp [hf, cbz_apply_neg _ h]
      · simp only [hf]
        rw [hvan i (by omega), map_zero, smul_zero, sub_zero]
        refine S.smul_mem _ ?_
        exact ih (n + i) (by omega) v (ℓ + m - i)
    have h0 := zero_term_mem S f hfin hsum hne
    simp only [hf, cbz_zero, mul_one, sub_zero, add_zero] at h0
    have hm0 : mode (A.YM v) m x = 0 := by simpa using hvan 0 le_rfl
    rw [hm0, map_zero, smul_zero, sub_zero,
      show negOnePow 0 = 1 by simp [negOnePow], one_smul,
      show ℓ + m = p by simp [ℓ]] at h0
    exact h0

/-- **`modeSpan A U` is a weak submodule.** -/
theorem act_mem_modeSpan {P : Type*} [AddCommGroup P] [Module ℂ P] (A : WeakModule W P)
    (U : Set P) (v : 𝒱) (p : ℤ) {y : P} (hy : y ∈ modeSpan A U) : A.act v p y ∈ modeSpan A U := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨a, q, x, hx, rfl⟩ := hz
    refine span_mono ?_ (act_act_mem_span A x a v q p)
    rintro _ ⟨b, r, rfl⟩
    exact ⟨b, r, x, hx, rfl⟩
  | zero => rw [WeakModule.act_zero_right]; exact zero_mem _
  | add a b _ _ ha hb => rw [WeakModule.act_add_right]; exact add_mem ha hb
  | smul c a _ ha => rw [WeakModule.act_smul_right]; exact smul_mem _ c ha

theorem subset_modeSpan {P : Type*} [AddCommGroup P] [Module ℂ P] (A : WeakModule W P)
    (U : Set P) {x : P} (hx : x ∈ U) : x ∈ modeSpan A U := by
  refine subset_span ⟨W.vacuum, -1, x, hx, ?_⟩
  rw [WeakModule.act_vacuum, if_pos rfl]

/-! ## §3  Annihilator compatibility from the top level -/

theorem wordAct_twWord {A' : Type*} (τ : A' → ℤ → N →ₗ[ℂ] N) (g : A' → A') (w : List (A' × ℤ)) :
    wordAct τ (twWord g w) = wordAct (fun a q => τ (g a) q) (twWord id w) := by
  induction w with
  | nil => rfl
  | cons p w ih =>
    simp only [twWord_cons, wordAct_cons, ih]
    rfl

/-- `AnnCompat` with a twist `g` equals `AnnCompat` for the twisted action and no twist. -/
theorem evTw_twist {A' : Type*} (τ : A' → ℤ → N →ₗ[ℂ] N) (g : A' → A') (S : Set A') (y₀ : N) :
    evTw τ g S y₀ = evTw (fun a q => τ (g a) q) id S y₀ := by
  apply Finsupp.lhom_ext'
  intro w
  apply LinearMap.ext_ring
  simp only [evTw, LinearMap.coe_comp, Function.comp_apply, Finsupp.lsingle_apply,
    Finsupp.linearCombination_single, one_smul]
  rw [wordAct_twWord]

theorem annCompat_twist_iff {A' : Type*} (ρ : A' → ℤ → M →ₗ[ℂ] M) (τ : A' → ℤ → N →ₗ[ℂ] N)
    (g : A' → A') (S : Set A') (x₀ : M) (y₀ : N) :
    AnnCompat ρ τ g S x₀ y₀ ↔ AnnCompat ρ (fun a q => τ (g a) q) id S x₀ y₀ := by
  unfold AnnCompat
  rw [evTw_twist]

/-- Word vectors of the product module are pairs of word vectors. -/
theorem wordAct_prod (A : WeakModule W M) (B : WeakModule W N) (w : List (𝒱 × ℤ)) (p : M × N) :
    wordAct (fun a q => mode ((prodModule A B).YM a) q) w p
      = (wordAct (fun a q => mode (A.YM a) q) w p.1,
          wordAct (fun a q => mode (B.YM a) q) (twWord id w) p.2) := by
  induction w generalizing p with
  | nil => rfl
  | cons a w ih =>
    simp only [wordAct_cons, LinearMap.comp_apply, twWord_cons, id]
    rw [ih]
    rfl

/-- The test span `Y_G = span{c₍r₎ φ x' | c ∈ G, x' ∈ Ω}` against which `β` must be
nondegenerate. -/
noncomputable def testSpan (B : WeakModule W N) (G : Set 𝒱) (Ω : Submodule ℂ M)
    (φ : M →ₗ[ℂ] N) : Submodule ℂ N :=
  span ℂ {y | ∃ c ∈ G, ∃ r : ℤ, ∃ x ∈ Ω, y = B.act c r (φ x)}

/-- **Annihilator compatibility from the top level.**

* `hZO` (top-level compatibility, homogeneous letters `a ∈ W_k`): for `x, x' ∈ Ω`,
  `β(a₍q₎ φx, φx') = β(φ(P(a₍q₎x)), φx')`.  In applications `P` is the projection onto the top
  weight, so for `q ≠ k − 1` both sides vanish by weights, and for `q = k − 1` this is
  `φ ∘ o(a) = o(a) ∘ φ` on `Ω`.
* `hadj` (invariance of `β`, on letters of `G`): the adjoint of `c₍r₎` is a finite combination
  of modes.
* `hnd` (nondegeneracy): a vector of the target cyclic span `modeSpan B (φ Ω)` orthogonal to
  `Y_G` vanishes.

Then for every `x₀ ∈ Ω`, `(x₀, φ x₀)` is annihilator-compatible: every linear relation among
words applied to `x₀` holds among the same words applied to `φ x₀`. -/
theorem annCompat_of_top (A : WeakModule W M) (B : WeakModule W N)
    (β : LinearMap.BilinForm ℂ N) (Ω : Submodule ℂ M) (φ : M →ₗ[ℂ] N) (P : M →ₗ[ℂ] M)
    (G : Set 𝒱)
    (hZO : ∀ (k : ℤ) (a : 𝒱), a ∈ W.grading k → ∀ (q : ℤ), ∀ x ∈ Ω, ∀ x' ∈ Ω,
      β (B.act a q (φ x)) (φ x') = β (φ (P (A.act a q x))) (φ x'))
    (hadj : ∀ c ∈ G, ∀ r : ℤ, ∃ (n : ℕ) (a : ℕ → 𝒱) (q : ℕ → ℤ) (t : ℕ → ℂ), ∀ y y' : N,
      β y (B.act c r y') = β (∑ i ∈ Finset.range n, t i • B.act (a i) (q i) y) y')
    (hnd : ∀ y ∈ modeSpan B (φ '' Ω), (∀ z ∈ testSpan B G Ω φ, β y z = 0) → y = 0)
    {x₀ : M} (hx₀ : x₀ ∈ Ω) :
    AnnCompat (fun a q => mode (A.YM a) q) (fun a q => mode (B.YM a) q) id Set.univ x₀ (φ x₀) := by
  set AB := prodModule A B
  set Γ : Set (M × N) := (fun x => (x, φ x)) '' Ω
  set Z := modeSpan AB Γ
  -- Step 1: the functional `(m, n) ↦ β n (φ x') − β (φ (P m)) (φ x')` kills `Z`.
  have hfun : ∀ x' ∈ Ω, ∀ z ∈ Z, β z.2 (φ x') = β (φ (P z.1)) (φ x') := by
    intro x' hx' z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨a, q, _, ⟨x, hx, rfl⟩, rfl⟩ := hz
      -- decompose the letter `a` into homogeneous components
      have hall : ∀ a : 𝒱, β (B.act a q (φ x)) (φ x') = β (φ (P (A.act a q x))) (φ x') := by
        intro a
        have ha : a ∈ ⨆ k, W.grading k := by rw [W.isInternal.submodule_iSup_eq_top]; trivial
        induction ha using Submodule.iSup_induction' with
        | mem k a hak => exact hZO k a hak q x hx x' hx'
        | zero =>
          simp only [WeakModule.act_def, map_zero, mode_zero, LinearMap.zero_apply]
        | add a b _ _ ha hb =>
          simp only [WeakModule.act_add_left, map_add, LinearMap.add_apply, ha, hb]
      exact hall a
    | zero => simp
    | add a b _ _ ha hb =>
      simp only [Prod.fst_add, Prod.snd_add, map_add, LinearMap.add_apply, ha, hb]
    | smul c a _ ha =>
      simp only [Prod.smul_fst, Prod.smul_snd, map_smul, LinearMap.smul_apply, ha]
  -- Step 2: second components of `(0, y) ∈ Z` are orthogonal to `φ Ω` …
  have horth0 : ∀ y : N, ((0 : M), y) ∈ Z → ∀ x' ∈ Ω, β y (φ x') = 0 := by
    intro y hy x' hx'
    have := hfun x' hx' _ hy
    simpa using this
  -- … and, by invariance, to the whole test span.
  have hZact : ∀ (a : 𝒱) (q : ℤ) {z : M × N}, z ∈ Z → AB.act a q z ∈ Z :=
    fun a q z hz => act_mem_modeSpan AB Γ a q hz
  have horth : ∀ y : N, ((0 : M), y) ∈ Z → ∀ z ∈ testSpan B G Ω φ, β y z = 0 := by
    intro y hy z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨c, hc, r, x', hx', rfl⟩ := hz
      obtain ⟨n, a, q, t, hT⟩ := hadj c hc r
      rw [hT]
      refine horth0 _ ?_ x' hx'
      -- `(0, T y) ∈ Z`
      have : ((0 : M), ∑ i ∈ Finset.range n, t i • B.act (a i) (q i) y)
          = ∑ i ∈ Finset.range n, t i • AB.act (a i) (q i) ((0 : M), y) := by
        ext
        · rw [Prod.fst_sum]
          symm
          refine Finset.sum_eq_zero (fun i _ => ?_)
          change t i • mode (A.YM (a i)) (q i) 0 = 0
          rw [map_zero, smul_zero]
        · rw [Prod.snd_sum]
          rfl
      rw [this]
      exact Z.sum_mem (fun i _ => Z.smul_mem _ (hZact (a i) (q i) hy))
    | zero => simp
    | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
    | smul c a _ ha => rw [map_smul, ha, smul_zero]
  -- Step 3: second components of elements of `Z` lie in the target cyclic span.
  have hsnd : ∀ z ∈ Z, z.2 ∈ modeSpan B (φ '' Ω) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨a, q, _, ⟨x, hx, rfl⟩, rfl⟩ := hz
      exact subset_span ⟨a, q, φ x, ⟨x, hx, rfl⟩, rfl⟩
    | zero => exact zero_mem _
    | add a b _ _ ha hb => exact add_mem ha hb
    | smul c a _ ha => exact smul_mem _ c ha
  -- Step 4: words applied to `(x₀, φ x₀)` stay in `Z`.
  have hword : ∀ w : List (𝒱 × ℤ),
      wordAct (fun a q => mode (AB.YM a) q) w (x₀, φ x₀) ∈ Z := by
    intro w
    induction w with
    | nil => exact subset_modeSpan AB Γ ⟨x₀, hx₀, rfl⟩
    | cons p w ih =>
      simp only [wordAct_cons, LinearMap.comp_apply]
      exact hZact p.1 p.2 ih
  -- Conclusion.
  intro f hf
  rw [LinearMap.mem_ker] at hf ⊢
  have hpair : ((evW (fun a q => mode (A.YM a) q) Set.univ x₀ f),
      evTw (fun a q => mode (B.YM a) q) id Set.univ (φ x₀) f) ∈ Z := by
    have : ((evW (fun a q => mode (A.YM a) q) Set.univ x₀ f),
        evTw (fun a q => mode (B.YM a) q) id Set.univ (φ x₀) f)
        = f.sum fun w c => c • wordAct (fun a q => mode (AB.YM a) q) w.1 (x₀, φ x₀) := by
      simp only [evW, evTw, Finsupp.linearCombination_apply, Finsupp.sum]
      ext
      · rw [Prod.fst_sum]
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [Prod.smul_fst, wordAct_prod]
      · rw [Prod.snd_sum]
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [Prod.smul_snd, wordAct_prod]
    rw [this, Finsupp.sum]
    exact Z.sum_mem (fun w _ => Z.smul_mem _ (hword w.1))
  rw [hf] at hpair
  exact hnd _ (hsnd _ hpair) (horth _ hpair)

end VOA.Moonshine.SigmaExist
