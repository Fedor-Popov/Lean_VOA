import VOA.Moonshine.FZGenV3
import VOA.Modules.FZBimodule

/-!
# Bridge: `bimodGen_V3` in the vocabulary of `Modules/FZBimodule.lean`

`FZGenFiltration.lean` uses minimal local Frenkel–Zhu residues (`FZGen.fzCirc`, `FZGen.fzLeft`,
`FZGen.fzRight`).  `Modules/FZBimodule.lean` defines `FZ.fzO` (spanned by all residues
`FZ.fzRes p k a m`), `FZ.fzLeft`, `FZ.fzRight` and the predicate `FZ.FZGenerated N h`.  The two
agree on homogeneous `a` (`fzLeft_eq`, `fzRight_eq` for `p ≥ 1`, `fzCirc_eq`), so:

`fzGenerated_MV3 : FZ.FZGenerated MV3 2`.

## Status
`sorry`-free; no project axiom.  Depends on `Modules/FZBimodule.lean`.  Reached from the
umbrella `VOA/Moonshine.lean`.
-/

set_option linter.style.longLine false

namespace VOA.Moonshine.FZGen

open VOA VOA.Moonshine VOA.Moonshine.SigmaExist
open Submodule

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
variable {M : Type u} [AddCommGroup M] [Module ℂ M]

theorem fzLeft_eq (N : OrdVModule W M) (p : ℕ) (a : 𝒱) (x : M) :
    FZ.fzLeft N.toWeakModule p a x = fzLeft N p a x := rfl

theorem fzCirc_eq (N : OrdVModule W M) (p : ℕ) (a : 𝒱) (x : M) :
    FZ.fzRes N.toWeakModule p 0 a x = fzCirc N p a x := by
  unfold FZ.fzRes fzCirc
  refine Finset.sum_congr rfl fun i _ => ?_
  norm_num

theorem fzRight_eq (N : OrdVModule W M) {p : ℕ} (hp : 1 ≤ p) (a : 𝒱) (x : M) :
    FZ.fzRight N.toWeakModule p a x = fzRight N p a x := by
  unfold FZ.fzRight fzRight
  rw [Finset.sum_range_succ, cbz_lt (by omega) (by omega), zero_smul, add_zero]
  rfl

/-- **`A(V₃⁺)` is generated by its top level `(V₃⁺)₂` as an `A(V₀⁺)`-bimodule**, in the sense
of `FZ.FZGenerated`. -/
theorem fzGenerated_MV3 : FZ.FZGenerated MV3 (2 : ℂ) := by
  intro S hO htop hLR
  refine bimodGen_V3 S (fun p a ha x => ?_) (fun p a ha x hx => ?_) (fun p a hp ha x hx => ?_)
    (fun x hx => htop hx)
  · rw [← fzCirc_eq]; exact hO (FZ.fzRes_mem_fzO _ 0 ha x)
  · rw [← fzLeft_eq]; exact (hLR p a ha x hx).1
  · rw [← fzRight_eq _ hp]; exact (hLR p a ha x hx).2

end VOA.Moonshine.FZGen
