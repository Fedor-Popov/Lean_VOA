import VOA.Moonshine.MoonshineCNNearSkew

/-! Consequences of Borcherds and skew symmetry used by the physical-state Lie bracket. -/

namespace VOA
open Module (End)
open scoped BigOperators
universe u
namespace NearVOA
variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-- The ordinary commutator, with an explicit finite sum of modes. -/
theorem mode_commutator_lie (V : NearVOA 𝒱) (u v : 𝒱) (m n : ℤ) :
    ∃ N : ℕ, ⁅mode (V.Y u) m, mode (V.Y v) n⁆ =
      ∑ j : Fin N, gBinom m (j : ℕ) •
        mode (V.Y (V.smul u (j : ℕ) v)) (m + n - (j : ℕ)) := by
  simpa only [modeBracketε, one_smul, LieRing.of_associative_ring_bracket]
    using V.mode_commutator u v m n

/-- The finite-support commutator identity on a state. -/
theorem mode_commutator_apply (V : NearVOA 𝒱) (u v x : 𝒱) (m n : ℤ) :
    V.smul u m (V.smul v n x) - V.smul v n (V.smul u m x) =
      ∑ᶠ i : ℤ, cbz m i • V.smul (V.smul u i v) (m + n - i) x := by
  have h := V.jacobi u v x 0 m n
  rw [finsum_eq_single _ (0 : ℤ) (fun i hi => by
    rw [cbz_zero_left, if_neg hi, mul_zero, zero_smul])] at h
  simpa only [cbz_zero_left, if_pos rfl, negOnePow, Even.zero, if_pos,
    one_mul, one_smul, zero_add, add_zero, sub_zero] using h

/-- Every zero mode is a derivation, with no homogeneity assumption. -/
theorem zeroMode_derivation (V : NearVOA 𝒱) (u v : 𝒱) (n : ℤ) :
    ⁅mode (V.Y u) 0, mode (V.Y v) n⁆ = mode (V.Y (V.smul u 0 v)) n := by
  have h := congrFun (V.nth_product u v 0) (-n - 1)
  simpa only [bracketDistε_one, cCoeff_apply, mulBySubPow_zero,
    LinearMap.id_apply, bracketDist_apply, LieRing.of_associative_ring_bracket,
    mode_apply] using h

/-- Virasoro commutation for a primary state of conformal weight one. -/
theorem primary_comm (V : NearVOA 𝒱) (u : 𝒱) (hu : V.L 0 u = u)
    (hpos : ∀ j : ℤ, 0 < j → V.L j u = 0) (m n : ℤ) :
    ⁅V.L m, mode (V.Y u) n⁆ = (-n) • mode (V.Y u) (m + n) := by
  classical
  apply LinearMap.ext
  intro x
  have h := V.mode_commutator_apply V.conformalVector u x (m + 1) n
  rw [finsum_eq_finsetSum_of_support_subset _ (s := {0, 1}) (by
    intro i hi
    by_contra hc
    simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
      Set.mem_singleton_iff, not_or] at hc
    rw [Function.mem_support] at hi
    rcases lt_or_ge i 0 with hi0 | hi0
    · exact hi (by rw [cbz_apply_neg _ hi0, zero_smul])
    · have hz : V.smul V.conformalVector i u = 0 := by
        have hz := hpos (i - 1) (by omega)
        simpa only [L_def, sub_add_cancel, smul_def] using hz
      exact hi (by rw [hz, smul_zero_left, smul_zero]))] at h
  have homega0 : V.smul V.conformalVector 0 u = V.L (-1) u := rfl
  have homega1 : V.smul V.conformalVector 1 u = u := hu
  have hbinom : cbz (m + 1) 1 = ((m + 1 : ℤ) : ℂ) := by
    simp [cbz, gBinom]
  simp only [Finset.sum_pair (by norm_num : (0 : ℤ) ≠ 1), cbz_zero, one_smul,
    sub_zero, homega0, homega1, hbinom] at h
  rw [smul_T_apply] at h
  have he1 : m + 1 + n - 1 = m + n := by ring
  rw [he1] at h
  change V.L m (V.smul u n x) - V.smul u n (V.L m x) = (-n) • V.smul u (m + n) x
  change V.L m (V.smul u n x) - V.smul u n (V.L m x) = _ at h
  rw [h, ← Int.cast_smul_eq_zsmul ℂ, ← Int.cast_smul_eq_zsmul ℂ, ← add_smul]
  congr 1
  push_cast
  ring

/-- The subspace generated by negative Virasoro modes. -/
noncomputable def spurious (V : NearVOA 𝒱) : Submodule ℂ 𝒱 :=
  ⨆ n : ℕ, LinearMap.range (V.L (-(n + 1 : ℤ)))

/-- A primary weight-one zero mode commutes with every Virasoro mode. -/
theorem primary_zeroMode_commutes (V : NearVOA 𝒱) (u : 𝒱) (hu : V.L 0 u = u)
    (hpos : ∀ j : ℤ, 0 < j → V.L j u = 0) (m : ℤ) (x : 𝒱) :
    V.smul u 0 (V.L m x) = V.L m (V.smul u 0 x) := by
  have h := DFunLike.congr_fun (V.primary_comm u hu hpos m 0) x
  simp only [neg_zero, zero_smul, LinearMap.zero_apply,
    LieRing.of_associative_ring_bracket, LinearMap.sub_apply,
    Module.End.mul_apply, sub_eq_zero] at h
  exact h.symm

/-- Primary weight-one zero modes preserve spurious states. -/
theorem zeroMode_preserves_spurious (V : NearVOA 𝒱) (u : 𝒱) (hu : V.L 0 u = u)
    (hpos : ∀ j : ℤ, 0 < j → V.L j u = 0) (x : 𝒱) (hx : x ∈ V.spurious) :
    V.smul u 0 x ∈ V.spurious := by
  refine Submodule.iSup_induction (fun n : ℕ => LinearMap.range (V.L (-(n + 1 : ℤ))))
    (motive := fun x => V.smul u 0 x ∈ V.spurious) hx ?_ ?_ ?_
  · intro n y hy
    obtain ⟨z, rfl⟩ := hy
    rw [V.primary_zeroMode_commutes u hu hpos]
    exact (le_iSup (fun n : ℕ => LinearMap.range (V.L (-(n + 1 : ℤ)))) n) ⟨_, rfl⟩
  · change V.smul u 0 0 ∈ V.spurious
    rw [smul_zero_right]
    exact Submodule.zero_mem _
  · intro y z hy hz
    change mode (V.Y u) 0 (y + z) ∈ _
    rw [map_add]
    exact Submodule.add_mem _ hy hz

/-- The symmetric zero-product is a translation, for arbitrary states. -/
theorem skew_zero (V : NearVOA 𝒱) (u v : 𝒱) :
    V.smul u 0 v + V.smul v 0 u ∈ LinearMap.range (V.L (-1)) := by
  classical
  let f : ℕ → 𝒱 := fun j => ((j.factorial : ℂ)⁻¹) • sgn (-(0 : ℤ) - 1 - j) •
    ((V.L (-1) ^ j) (V.smul u (0 + j) v))
  have hf : (Function.support f).Finite := by
    obtain ⟨N, hN⟩ := V.regularity u v
    refine Set.Finite.subset (Set.finite_Iio N.toNat) ?_
    intro j hj
    simp only [Set.mem_Iio]
    by_contra hc
    have hz : V.smul u (0 + (j : ℤ)) v = 0 := hN _ (by omega)
    exact hj (by simp only [f, hz, map_zero, smul_zero])
  have hsum : (∑ᶠ j, f j) - f 0 ∈ LinearMap.range (V.L (-1)) := by
    let s : Finset ℕ := hf.toFinset ∪ {0}
    have hs : Function.support f ⊆ (s : Set ℕ) := by
      intro j hj
      simp only [s, Finset.mem_coe, Finset.mem_union, Set.Finite.mem_toFinset,
        Finset.mem_singleton]
      exact Or.inl hj
    rw [finsum_eq_sum_of_support_subset f hs,
      ← Finset.sum_erase_add _ _ (by simp [s] : 0 ∈ s), add_sub_cancel_right]
    apply Submodule.sum_mem
    intro j hj
    have hj0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj0
    apply Submodule.smul_mem
    apply Submodule.smul_mem
    rw [pow_succ', Module.End.mul_apply]
    exact ⟨_, rfl⟩
  have hskew : V.smul v 0 u = ∑ᶠ j, f j := V.smul_eq_skew u v 0
  have hzero : f 0 = -V.smul u 0 v := by
    simp [f, sgn]
  rw [← hskew, hzero, sub_neg_eq_add, add_comm] at hsum
  exact hsum

end NearVOA
end VOA
