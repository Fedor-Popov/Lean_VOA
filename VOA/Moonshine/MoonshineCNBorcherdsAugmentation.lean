import VOA.Moonshine.MoonshineCNBorcherdsGeneration
import Mathlib.Algebra.Lie.UniversalEnveloping

/-! The augmentation ideal is the left ideal generated by a Lie-generating space. -/

noncomputable section
namespace VOA.Moonshine.ConwayNorton

variable {g : Type*} [LieRing g] [LieAlgebra ℂ g]

/-- Algebra induction for the actual universal enveloping algebra quotient. -/
theorem envelopingAlgebra_induction {P : UniversalEnvelopingAlgebra ℂ g → Prop}
    (hscalar : ∀ c : ℂ, P (algebraMap ℂ _ c))
    (hlie : ∀ x : g, P (UniversalEnvelopingAlgebra.ι ℂ x))
    (hmul : ∀ a b, P a → P b → P (a * b))
    (hadd : ∀ a b, P a → P b → P (a + b))
    (a : UniversalEnvelopingAlgebra ℂ g) : P a := by
  obtain ⟨t, rfl⟩ := RingQuot.mkAlgHom_surjective ℂ (UniversalEnvelopingAlgebra.Rel ℂ g) a
  induction t using TensorAlgebra.induction with
  | algebraMap c => simpa using hscalar c
  | ι x => exact hlie x
  | mul a b ha hb => simpa only [map_mul] using hmul _ _ ha hb
  | add a b ha hb => simpa only [map_add] using hadd _ _ ha hb

/-- The enveloping algebra character which kills the Lie algebra. -/
def envelopingAugmentation : UniversalEnvelopingAlgebra ℂ g →ₐ[ℂ] ℂ :=
  UniversalEnvelopingAlgebra.lift ℂ (0 : g →ₗ⁅ℂ⁆ ℂ)

/-- The left ideal A·S, where A is the enveloping algebra. -/
def envelopingGeneratorLeftIdeal (S : Submodule ℂ g) :
    Submodule (UniversalEnvelopingAlgebra ℂ g) (UniversalEnvelopingAlgebra ℂ g) :=
  Submodule.span _ (UniversalEnvelopingAlgebra.ι ℂ '' (S : Set g))

theorem enveloping_lieSpan_mem_generatorIdeal (S : Submodule ℂ g)
    {x : g} (hx : x ∈ LieSubalgebra.lieSpan ℂ g (S : Set g)) :
    UniversalEnvelopingAlgebra.ι ℂ x ∈ envelopingGeneratorLeftIdeal S := by
  let I := envelopingGeneratorLeftIdeal S
  change UniversalEnvelopingAlgebra.ι ℂ x ∈ I
  induction hx using LieSubalgebra.lieSpan_induction with
  | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => simpa only [map_add] using I.add_mem hx hy
  | smul c x _ hx =>
      simpa only [map_smul] using (I.restrictScalars ℂ).smul_mem c hx
  | lie x y _ _ hx hy =>
      rw [LieHom.map_lie, LieRing.of_associative_ring_bracket]
      exact I.sub_mem (I.smul_mem (UniversalEnvelopingAlgebra.ι ℂ x) hy)
        (I.smul_mem (UniversalEnvelopingAlgebra.ι ℂ y) hx)

theorem enveloping_sub_augmentation_mem (S : Submodule ℂ g)
    (hS : LieSubalgebra.lieSpan ℂ g (S : Set g) = ⊤)
    (a : UniversalEnvelopingAlgebra ℂ g) :
    a - algebraMap ℂ _ (envelopingAugmentation a) ∈ envelopingGeneratorLeftIdeal S := by
  let I := envelopingGeneratorLeftIdeal S
  let ε : UniversalEnvelopingAlgebra ℂ g →ₐ[ℂ] ℂ := envelopingAugmentation
  change a - algebraMap ℂ _ (ε a) ∈ I
  induction a using envelopingAlgebra_induction with
  | hscalar c => simp
  | hlie x =>
      have hx : x ∈ LieSubalgebra.lieSpan ℂ g (S : Set g) := by rw [hS]; trivial
      simpa [ε, envelopingAugmentation, UniversalEnvelopingAlgebra.lift_ι_apply] using
        enveloping_lieSpan_mem_generatorIdeal S hx
  | hadd a b ha hb =>
      simpa only [map_add, add_sub_add_comm] using I.add_mem ha hb
  | hmul a b ha hb =>
      have h := I.add_mem (I.smul_mem a hb)
        (I.smul_mem (algebraMap ℂ _ (ε b)) ha)
      change a * (b - algebraMap ℂ _ (ε b)) +
        algebraMap ℂ _ (ε b) * (a - algebraMap ℂ _ (ε a)) ∈ I at h
      convert h using 1
      rw [map_mul, map_mul]
      have hcomm := Algebra.commutes (R := ℂ) (A := UniversalEnvelopingAlgebra ℂ g) (ε b) a
      have hcomm' := Algebra.commutes (R := ℂ) (A := UniversalEnvelopingAlgebra ℂ g)
        (ε b) (algebraMap ℂ _ (ε a))
      rw [mul_sub, mul_sub, hcomm, hcomm']
      abel

/-- No PBW assumption is needed for the augmentation-ideal generation statement. -/
theorem enveloping_augmentationIdeal_eq (S : Submodule ℂ g)
    (hS : LieSubalgebra.lieSpan ℂ g (S : Set g) = ⊤) :
    LinearMap.ker (envelopingAugmentation (g := g)).toLinearMap =
      (envelopingGeneratorLeftIdeal S).restrictScalars ℂ := by
  apply le_antisymm
  · intro a ha
    have h := enveloping_sub_augmentation_mem S hS a
    have ha' : envelopingAugmentation a = 0 := ha
    simpa only [ha', map_zero, sub_zero] using h
  · intro a ha
    induction ha using Submodule.span_induction with
    | mem a ha =>
        obtain ⟨x, hx, rfl⟩ := ha
        simp [LinearMap.mem_ker, envelopingAugmentation]
    | zero => exact LinearMap.mem_ker.mpr (map_zero _)
    | add a b _ _ ha hb => exact Submodule.add_mem _ ha hb
    | smul a b _ hb =>
        change envelopingAugmentation (a * b) = 0
        rw [map_mul, (show envelopingAugmentation b = 0 from hb), mul_zero]

namespace BorcherdsData

variable (D : BorcherdsData g)

/-- U regarded inside the positive Lie algebra. -/
def positiveGeneratorSpace (e : g) : Submodule ℂ D.positivePart :=
  (D.genSpace e).comap D.positivePart.toSubmodule.subtype

theorem positiveGeneratorSpace_lieSpan (e f : g)
    (he : e ∈ D.weightSpace borcherdsRealRoot)
    (hf : f ∈ D.weightSpace (-borcherdsRealRoot)) (hef : D.form e f = 1) :
    LieSubalgebra.lieSpan ℂ D.positivePart
      (D.positiveGeneratorSpace e : Set D.positivePart) = ⊤ := by
  let B := LieSubalgebra.lieSpan ℂ D.positivePart
    (D.positiveGeneratorSpace e : Set D.positivePart)
  have hle : LieSubalgebra.lieSpan ℂ g (D.genSpace e : Set g) ≤ B.map D.positivePart.incl := by
    apply LieSubalgebra.lieSpan_le.mpr
    intro x hx
    exact ⟨⟨x, D.genSpace_le_positive e he hx⟩, LieSubalgebra.subset_lieSpan hx, rfl⟩
  rw [← D.positivePart_eq_lieSpan_genSpace e f he hf hef] at hle
  apply top_unique
  intro x _
  obtain ⟨y, hy, hxy⟩ := hle x.property
  have hyx : y = x := Subtype.ext hxy
  simpa only [hyx] using hy

/-- The positive augmentation ideal is generated on the left by U. -/
theorem positive_augmentationIdeal_eq (e f : g)
    (he : e ∈ D.weightSpace borcherdsRealRoot)
    (hf : f ∈ D.weightSpace (-borcherdsRealRoot)) (hef : D.form e f = 1) :
    LinearMap.ker (envelopingAugmentation (g := D.positivePart)).toLinearMap =
      (envelopingGeneratorLeftIdeal (D.positiveGeneratorSpace e)).restrictScalars ℂ :=
  enveloping_augmentationIdeal_eq _ (D.positiveGeneratorSpace_lieSpan e f he hf hef)

end BorcherdsData
end VOA.Moonshine.ConwayNorton
