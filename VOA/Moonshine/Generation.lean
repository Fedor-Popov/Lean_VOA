import VOA.Moonshine.GenerationFock
import VOA.Moonshine.InvFormTP

/-!
# `V_Λ^+` is generated by the states `e^β + e^{-β}`  (Moonshine step M8c, residual `hgen` discharged)

`leechPlus_generated`: every subspace `S ≤ V_Λ^+` closed under all `n`-th products and
containing every `x_β := e^β + e^{-β}` (`frameX0P β`, `β ∈ Λ`) is all of `V_Λ^+`.  (The vacuum
hypothesis of the residual is not even needed: `x_0 = 2·𝟙`.)  Consequently

`TPForm_fhlInv` — **unconditional** FHL invariance of `TPForm` on `TP = (V_Λ^T)^+` for every
homogeneous `u ∈ V_Λ^+`.

## The proof (lattice-independent; no Griess-algebra or `M(1)^+` input)

Write `P = ½(1 + θ) : V_Λ → V_Λ^+` (`plusProj`) and `G = P⁻¹(S)`.  It suffices to show
`p ⊗ e^γ ∈ G` for every Fock state `p` and `γ ∈ Λ`.

1. **Safe step** (`plusProj_smul`).  For `p` of Fock weight `w` and `n ≥ w + ⟨a,c⟩`,
   `x_a ₍ₙ₎ P(p ⊗ e^c) = P(e^a ₍ₙ₎ (p ⊗ e^c))`: of the four terms of
   `(e^a + e^{-a})₍ₙ₎(p⊗e^c + σp⊗e^{-c})`, the two "opposite-sign" ones
   `e^{-a}₍ₙ₎(p⊗e^c)` and `e^a₍ₙ₎(σp⊗e^{-c})` vanish, because the boson dressing `EE(∓a)_t` with
   `t = -n-1+⟨a,c⟩ < -w` kills weight-`w` states (`EEVec_eq_zero_of_lt`), and the fourth is the
   `θ`-image of the first.  So such `e^a₍ₙ₎(p⊗e^c)` lies in `G` whenever `p⊗e^c` does.
2. **Leading term** (`mem_G_vSchur_mul`).  Fix the target weight `w` and suppose all Fock weights
   `< w` are done (in every charge sector).  Call `a` *safe* for `(γ, w)` if
   `2⟨a, γ-a⟩ + w + 1 ≤ 0`.  For safe `a`, `d ≥ 1`, `p` of weight `w-d`, and `c = γ - a`,
   `n = -d-1-⟨a,c⟩` is a safe mode and
   `e^a₍ₙ₎(p⊗e^c) = ε(a,c)·∑_{r} S_{d+r}(a)·E⁺(a)_{-r}p ⊗ e^γ` (`EEVec_expand`).  Downward
   induction on `d` (the `r ≥ 1` terms have larger Schur index) gives `S_d(a)·p ⊗ e^γ ∈ G`.
3. **Linearisation** (`mem_G_of_weight`).  `S_d(ka₀)` is a polynomial in `k` whose linear
   coefficient is `d⁻¹·a₀(-d)` (`schurPoly_coeff_one`); `k·a₀` is safe for all large `k`, so
   interpolation (`mem_of_forall_sum_pow_smul_mem`) gives `a₀(-d)·p ⊗ e^γ ∈ G`.  Letting `a₀` run
   over a lattice basis, `h_b(-d)·p ⊗ e^γ ∈ G` for every oscillator (`X_mem_span_vVar`); creation
   words then exhaust the weight-`w` space (`gradingWN_le_span_words`).  Weight `0` is
   `P(e^γ) = ½x_γ ∈ S`.

The argument works verbatim for every even positive-definite lattice; only `θ`, `V^+` and
`frameX0P` are Leech-specific here.

## Main results
* `plusProj`, `plusProj_of_mem`, `plusProj_latChargeGen`.
* `leechVOA_smul_latChargeGen_state`, `leechVOA_smul_latChargeGen_eq_zero_of_le`.
* `plusProj_smul` (the safe step).
* `leechPlus_generated` (the residual `hgen` of `InvForm.TPForm_fhlInv_of_generates`).
* `TPForm_fhlInv` (unconditional).

## Status
`sorry`-free; no project axioms.  `leechPlus_generated` and `TPForm_fhlInv` are unconditional.
Imported by the umbrella `VOA/Moonshine.lean`.
-/

set_option linter.style.longLine false

namespace VOA.Moonshine

open LatGen IntegralLattice HeisenbergN

/-! ## §1  The projection `P = ½(1 + θ)` onto `V_Λ^+` -/

theorem half_add_theta_mem_plus (v : LatModuleGen leech) :
    ((1 / 2 : ℂ) • (v + thetaLat leech v)) ∈ (orbifold (Subgroup.zpowers leechTheta)).carrier := by
  rw [mem_leechVOAPlus_iff, map_smul, map_add, thetaLat_thetaLat, add_comm]

/-- The projection `P = ½(1 + θ) : V_Λ → V_Λ^+`. -/
noncomputable def plusProj : LatModuleGen leech →ₗ[ℂ] VPlus :=
  LinearMap.codRestrict _ ((1 / 2 : ℂ) • (LinearMap.id + (thetaLat leech).toLinearMap))
    (fun v => by simpa using half_add_theta_mem_plus v)

theorem plusProj_coe (v : LatModuleGen leech) :
    ((plusProj v : VPlus) : LatModuleGen leech) = (1 / 2 : ℂ) • (v + thetaLat leech v) := by
  simp [plusProj]

theorem plusProj_of_mem (v : VPlus) : plusProj (v : LatModuleGen leech) = v := by
  apply Subtype.ext
  rw [plusProj_coe, (mem_leechVOAPlus_iff _).mp v.2, ← two_smul ℂ, smul_smul]
  norm_num

theorem plusProj_latChargeGen (c : leech.carrier) :
    plusProj (latChargeGen leech c) = (1 / 2 : ℂ) • frameX0P c := by
  apply Subtype.ext
  rw [plusProj_coe, thetaLat_latChargeGen]
  rfl

/-! ## §2  `e^a₍ₙ₎` on a charged Fock state -/

theorem leechVOA_smul_latChargeGen_state (a c : leech.carrier) (n : ℤ) (q : FockN (rank leech)) :
    leechVOA.smul (latChargeGen leech a) n (latStateGen leech q c)
      = latticeCocycle leech a c •
          latStateGen leech (EEVec leech a (-n - 1 - leech.form a c) q) (a + c) := by
  rw [PreVertexAlgebra.smul_def, leechVOA_Y_latChargeGen, mode_apply, Yeαvec_tmul]

/-- `e^b₍ₙ₎(q ⊗ e^c) = 0` for `q` of Fock weight `w` and `n ≥ w - ⟨b,c⟩`. -/
theorem leechVOA_smul_latChargeGen_eq_zero_of_le (b c : leech.carrier) {n : ℤ} {w : ℕ}
    {q : FockN (rank leech)} (hq : q ∈ gradingWN (rank leech) w)
    (hn : (w : ℤ) - leech.form b c ≤ n) :
    leechVOA.smul (latChargeGen leech b) n (latStateGen leech q c) = 0 := by
  rw [leechVOA_smul_latChargeGen_state, EEVec_eq_zero_of_lt leech b hq (by omega), latStateGen,
    TensorProduct.zero_tmul, smul_zero]

/-- **The safe step**: `x_a₍ₙ₎ P(q ⊗ e^c) = P(e^a₍ₙ₎(q ⊗ e^c))` when `n ≥ w + ⟨a,c⟩`. -/
theorem plusProj_smul (a c : leech.carrier) {n : ℤ} {w : ℕ} {q : FockN (rank leech)}
    (hq : q ∈ gradingWN (rank leech) w) (hn : (w : ℤ) + leech.form a c ≤ n) :
    plusProj (leechVOA.smul (latChargeGen leech a) n (latStateGen leech q c))
      = leechVOAPlus.smul (frameX0P a) n (plusProj (latStateGen leech q c)) := by
  apply Subtype.ext
  rw [plus_smul_coe, plusProj_coe, plusProj_coe, thetaLat_latStateGen]
  have hσ := sigmaN_mem_gradingWN (rank leech) hq
  have h2 : leechVOA.smul (latChargeGen leech a) n
      (latStateGen leech (sigmaN (rank leech) q) (-c)) = 0 :=
    leechVOA_smul_latChargeGen_eq_zero_of_le a (-c) hσ (by rw [leech_form_neg_right]; omega)
  have h3 : leechVOA.smul (latChargeGen leech (-a)) n (latStateGen leech q c) = 0 :=
    leechVOA_smul_latChargeGen_eq_zero_of_le (-a) c hq (by rw [leech_form_neg_left]; omega)
  have h4 : thetaLat leech (leechVOA.smul (latChargeGen leech a) n (latStateGen leech q c))
      = leechVOA.smul (latChargeGen leech (-a)) n
          (latStateGen leech (sigmaN (rank leech) q) (-c)) := by
    have := thetaLat_mode leech leech_even leech_posDef (latChargeGen leech a) n
      (latStateGen leech q c)
    rw [thetaLat_latChargeGen, thetaLat_latStateGen] at this
    exact this
  change _ = leechVOA.smul (frameX0 a) n _
  rw [frameX0, PreVertexAlgebra.smul_smul_right, PreVertexAlgebra.smul_add_left,
    PreVertexAlgebra.smul_add_right, PreVertexAlgebra.smul_add_right, h2, h3, h4]
  simp only [add_zero, zero_add]

/-! ## §3  The induction -/

section Induction

variable (S : Submodule ℂ VPlus)
  (hS : ∀ u ∈ S, ∀ v ∈ S, ∀ n : ℤ, leechVOAPlus.smul u n v ∈ S)
  (hX : ∀ β : leech.carrier, frameX0P β ∈ S)

/-- The pull-back `G = P⁻¹(S)`. -/
noncomputable abbrev genG : Submodule ℂ (LatModuleGen leech) := S.comap plusProj

/-- `a` is *safe* for target charge `γ` and Fock weight `w`. -/
def SafeFor (a γ : leech.carrier) (w : ℕ) : Prop := 2 * leech.form a (γ - a) + w + 1 ≤ 0

include hX in
theorem latChargeGen_mem_genG (c : leech.carrier) : latChargeGen leech c ∈ genG S := by
  rw [Submodule.mem_comap, plusProj_latChargeGen]
  exact S.smul_mem _ (hX c)

include hS hX in
theorem smul_mem_genG (a c : leech.carrier) {n : ℤ} {w : ℕ} {q : FockN (rank leech)}
    (hq : q ∈ gradingWN (rank leech) w) (hn : (w : ℤ) + leech.form a c ≤ n)
    (hmem : latStateGen leech q c ∈ genG S) :
    leechVOA.smul (latChargeGen leech a) n (latStateGen leech q c) ∈ genG S := by
  rw [Submodule.mem_comap, plusProj_smul a c hq hn]
  exact hS _ (hX a) _ hmem n

theorem latStateGen_sum {ι : Type*} (s : Finset ι) (f : ι → FockN (rank leech))
    (γ : leech.carrier) :
    latStateGen leech (∑ i ∈ s, f i) γ = ∑ i ∈ s, latStateGen leech (f i) γ := by
  simp only [latStateGen, TensorProduct.sum_tmul]

theorem latStateGen_smul (c : ℂ) (p : FockN (rank leech)) (γ : leech.carrier) :
    latStateGen leech (c • p) γ = c • latStateGen leech p γ := by
  simp only [latStateGen, TensorProduct.smul_tmul']

include hS hX in
/-- Step 2: for safe `a`, `S_d(a)·q ⊗ e^γ ∈ G` (`q` of weight `k`, `d + k = w`, `d ≥ 1`), given all
lower Fock weights. -/
theorem mem_G_vSchur_mul (w : ℕ)
    (IH : ∀ w' < w, ∀ (c : leech.carrier) (q : FockN (rank leech)),
      q ∈ gradingWN (rank leech) w' → latStateGen leech q c ∈ genG S) :
    ∀ k : ℕ, ∀ d : ℕ, d + k = w → 1 ≤ d → ∀ γ a : leech.carrier, SafeFor a γ w →
      ∀ q ∈ gradingWN (rank leech) k, latStateGen leech (vSchur leech a d * q) γ ∈ genG S := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ihk =>
  intro d hdk hd γ a hsafe q hq
  have hsafe' : 2 * leech.form a (γ - a) + w + 1 ≤ 0 := hsafe
  set c := γ - a with hc
  set n : ℤ := -(d : ℤ) - 1 - leech.form a c with hn
  have h1 := smul_mem_genG S hS hX a c (n := n) hq (by omega) (IH k (by omega) c q hq)
  rw [leechVOA_smul_latChargeGen_state, show -n - 1 - leech.form a c = (d : ℤ) by omega,
    show a + c = γ by rw [hc]; abel, EEVec_expand leech a hq d, latStateGen_sum,
    Finset.sum_range_succ', aExpVec_zero, LinearMap.id_apply, add_zero, smul_add] at h1
  have hrest : latticeCocycle leech a c • ∑ r ∈ Finset.range k,
      latStateGen leech (vSchur leech a (d + (r + 1)) * aExpVec leech a (r + 1) q) γ ∈ genG S := by
    refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun r hr => ?_)
    simp only [Finset.mem_range] at hr
    have hq' : aExpVec leech a (r + 1) q ∈ gradingWN (rank leech) (k - (r + 1)) := by
      have := aExpVec_mem_gradingZN leech a (r + 1) hq
      rwa [gradingZN_of_nonneg (by omega), show ((k : ℤ) - ((r + 1 : ℕ) : ℤ)).toNat = k - (r + 1)
        by omega] at this
    exact ihk (k - (r + 1)) (by omega) (d + (r + 1)) (by omega) (by omega) γ a hsafe _ hq'
  have h2 := Submodule.sub_mem _ h1 hrest
  rw [add_sub_cancel_left] at h2
  have hε : latticeCocycle leech a c * latticeCocycle leech a c = 1 := latticeCocycle_sq leech a c
  have h3 := Submodule.smul_mem _ (latticeCocycle leech a c) h2
  rwa [smul_smul, hε, one_smul] at h3

theorem form_nsmul_safe (a₀ γ : leech.carrier) (ha : a₀ ≠ 0) (w : ℕ) (k : ℕ)
    (hk : (|leech.form a₀ γ|).toNat + w + 1 ≤ k) : SafeFor (k • a₀) γ w := by
  have hpos : 0 < leech.form a₀ a₀ := leech_posDef a₀ ha
  have hform : leech.form (k • a₀) (γ - k • a₀)
      = (k : ℤ) * leech.form a₀ γ - (k : ℤ) * (k : ℤ) * leech.form a₀ a₀ := by
    simp only [map_nsmul, map_sub, LinearMap.smul_apply, nsmul_eq_mul]
    ring
  unfold SafeFor
  rw [hform]
  have habs : leech.form a₀ γ ≤ |leech.form a₀ γ| := le_abs_self _
  have hk' : |leech.form a₀ γ| + w + 1 ≤ (k : ℤ) := by
    have := abs_nonneg (leech.form a₀ γ)
    omega
  nlinarith [abs_nonneg (leech.form a₀ γ)]

include hS hX in
/-- Step 3: every Fock weight is in `G`, in every charge sector. -/
theorem mem_G_of_weight :
    ∀ w : ℕ, ∀ (c : leech.carrier) (q : FockN (rank leech)),
      q ∈ gradingWN (rank leech) w → latStateGen leech q c ∈ genG S := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w IH =>
  intro c q hq
  have hB := mem_G_vSchur_mul S hS hX w IH
  -- reduce to creation words of weight `w`
  have hlin : ∀ p : FockN (rank leech), p ∈ Submodule.span ℂ
      {p | ∃ l : List (ℕ × Fin (rank leech)), wordWt l = w ∧ p = wordStateN l} →
      latStateGen leech p c ∈ genG S := by
    intro p hp
    induction hp using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨l, hl, rfl⟩ := hx
      cases l with
      | nil => exact latChargeGen_mem_genG S hX c
      | cons ia rest =>
        obtain ⟨m, b⟩ := ia
        rw [wordWt_cons] at hl
        have hrest := wordStateN_mem_gradingWN rest
        rw [wordStateN_cons]
        -- the linear map `p ↦ (p · rest) ⊗ e^c`
        set φ : FockN (rank leech) →ₗ[ℂ] LatModuleGen leech :=
          ((TensorProduct.mk ℂ (FockN (rank leech)) (leech.carrier →₀ ℂ)).flip (eGen leech c)).comp
            (LinearMap.mulRight ℂ (wordStateN rest)) with hφ
        have hφapp : ∀ p, φ p = latStateGen leech (p * wordStateN rest) c := fun p => rfl
        have hspan := X_mem_span_vVar leech leech_posDef m b
        suffices hsub : Submodule.span ℂ (Set.range fun i : Fin (latRank leech) =>
            vVar leech (latticeBasis leech i) m) ≤ (genG S).comap φ by
          have := hsub hspan
          rwa [Submodule.mem_comap, hφapp] at this
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, Submodule.mem_comap, hφapp]
        set a₀ := latticeBasis leech i
        have ha₀ : a₀ ≠ 0 := (latticeBasis leech).ne_zero i
        set D := (schurPoly leech a₀ (m + 1)).natDegree
        have hpoly := mem_of_forall_sum_pow_smul_mem ((genG S).comap φ)
          (fun j => (schurPoly leech a₀ (m + 1)).coeff j) D
          ((|leech.form a₀ c|).toNat + w + 1) (fun k hk => by
            rw [Submodule.mem_comap, ← vSchur_nsmul_eq_sum, hφapp]
            exact hB (wordWt rest) (m + 1) (by omega) (by omega) c (k • a₀)
              (form_nsmul_safe a₀ c ha₀ w k hk) _ hrest)
        by_cases h1 : 1 ∈ Finset.range (D + 1)
        · have := hpoly 1 h1
          simp only [schurPoly_coeff_one] at this
          rw [Submodule.mem_comap, map_smul] at this
          have h2 := Submodule.smul_mem _ ((m : ℂ) + 1) this
          rw [smul_smul, mul_inv_cancel₀ (by exact_mod_cast Nat.succ_ne_zero m), one_smul,
            hφapp] at h2
          exact h2
        · have hD : D < 1 := by simpa using h1
          have hc1 := Polynomial.coeff_eq_zero_of_natDegree_lt (p := schurPoly leech a₀ (m + 1))
            (n := 1) (by omega)
          rw [schurPoly_coeff_one] at hc1
          rcases smul_eq_zero.mp hc1 with h | h
          · exact absurd h (inv_ne_zero (by exact_mod_cast Nat.succ_ne_zero m))
          · dsimp only
            rw [h, zero_mul, latStateGen, TensorProduct.zero_tmul]; exact Submodule.zero_mem _
    | zero => rw [latStateGen, TensorProduct.zero_tmul]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [latStateGen_add_boson]; exact Submodule.add_mem _ hx hy
    | smul a x _ hx => rw [latStateGen_smul]; exact Submodule.smul_mem _ _ hx
  exact hlin q (gradingWN_le_span_words _ w hq)

end Induction

/-! ## §4  The generation theorem and unconditional invariance -/

/-- **`V_Λ^+` is generated by the states `e^β + e^{-β}`**: a subspace of `V_Λ^+` containing `𝟙`
and every `e^β + e^{-β}` (`β ∈ Λ`) and closed under all `n`-th products is everything.  This is
the residual `hgen` of `InvForm.TPForm_fhlInv_of_generates`. -/
theorem leechPlus_generated : ∀ S : Submodule ℂ VPlus, leechVOAPlus.vacuum ∈ S →
    (∀ u ∈ S, ∀ v ∈ S, ∀ n : ℤ, leechVOAPlus.smul u n v ∈ S) →
    (∀ β : leech.carrier, frameX0P β ∈ S) → S = ⊤ := by
  intro S _ hS hX
  have hG : genG S = ⊤ := by
    rw [eq_top_iff, ← wordStateLatGen_span leech, Submodule.span_le]
    rintro _ ⟨⟨l, α⟩, rfl⟩
    rw [SetLike.mem_coe, Function.uncurry_apply_pair, wordStateLatGen_eq]
    exact mem_G_of_weight S hS hX (wordWt l) α (wordStateN l) (wordStateN_mem_gradingWN l)
  rw [eq_top_iff]
  intro v _
  have hv : (v : LatModuleGen leech) ∈ genG S := by rw [hG]; trivial
  rwa [Submodule.mem_comap, plusProj_of_mem] at hv

/-- **Unconditional FHL invariance of `TPForm`** for every homogeneous `u ∈ V_Λ^+`. -/
theorem TPForm_fhlInv {wt : ℤ} {u : VPlus} (hu : u ∈ leechVOAPlus.grading wt) :
    InvForm.FHLInv plusModule InvForm.TPForm wt u :=
  InvForm.TPForm_fhlInv_of_generates leechPlus_generated hu

end VOA.Moonshine
