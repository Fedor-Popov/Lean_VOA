import VOA.Moonshine.MoonshineLRGenerationSandwich
import VOA.Moonshine.MoonshineCNMonsterBorcherdsData
import VOA.Moonshine.MoonshineCNTwistedDenominator

/-!
# The Monster Lie algebra is generated by its simple root spaces

* `monsterLiePreData`: the Monster Lie algebra `𝔪` with grading, Cartan and form, as
  Borcherds pre-data (every field of `monsterLieBorcherdsData` except `generated`);
* `finrank_monsterLieBorcherdsWeight_cone`: `dim 𝔪_(m,n) = c(mn)` for `m, n ≥ 1`;
* `monsterLiePreData_KNZ`: the KNZ hypothesis for `𝔪`, which is `knz_product`;
* **`monsterLieSimpleRootGeneration : MonsterLieSimpleRootGeneration`**, with no hypotheses.

This supplies simple-root generation for `monsterLieBorcherdsData` and
`conwayNorton_of_simpleRootGeneration`; `conwayNorton_of_isOfFinOrder` needs only finite order.
-/

noncomputable section

namespace VOA.Moonshine.ConwayNorton.M8

open Module AutMonster

/-- The Monster Lie algebra as Borcherds pre-data. -/
def monsterLiePreData : BorcherdsPreData monsterLieAlgebra where
  weightSpace := monsterLieBorcherdsWeight
  weight_internal := monsterLieBorcherdsWeight_isInternal
  weight_finite := monsterLieBorcherdsWeight_finite
  bracket_weight {γ δ} {x y} hx hy := by
    have h := monsterLieMomentum_bracket _ _ x y hx hy
    change ⁅x, y⁆ ∈ monsterLieMomentum (borcherdsMomentum (γ + δ))
    rwa [borcherdsMomentum_add]
  cartanMap := monsterLieCartanMap
  cartan_injective := monsterLieCartanMap_injective
  cartan_range := monsterLieCartanMap_range
  cartan_action := monsterLieCartanMap_action
  form := monsterLieBilinearForm
  form_symmetric := monsterLieBilinearForm_symmetric
  form_invariant := monsterLieBilinearForm_invariant
  form_orthogonal γ δ hγδ x hx y hy := by
    apply monsterLieBilinearForm_momentum_orthogonal _ _ _ x y hx hy
    rw [← borcherdsMomentum_add, Ne, borcherdsMomentum_eq_zero_iff]
    exact hγδ
  form_cartan := monsterLieCartanMap_form
  form_nondegenerate γ x hx hB := by
    apply monsterLieBilinearForm_pairing_nondegenerate _ x hx
    intro v hv
    apply hB v
    change v ∈ monsterLieMomentum (borcherdsMomentum (-γ))
    rwa [borcherdsMomentum_neg]
  root_support := monsterLieBorcherdsWeight_support
  real_dimension := ⟨monsterLieBorcherdsWeight_real_finrank _ (Or.inl rfl),
    monsterLieBorcherdsWeight_real_finrank _ (Or.inr rfl)⟩

/-- **`dim 𝔪_(m,n) = c(mn)`** on the cone. -/
theorem finrank_monsterLieBorcherdsWeight_cone (m n : ℕ) (hm : 0 < m) (_hn : 0 < n) :
    (finrank ℂ (monsterLieBorcherdsWeight ((m : ℤ), (n : ℤ))) : ℂ) = cJ (m * n) := by
  have hγ : ((m : ℤ), (n : ℤ)) ≠ 0 := by
    intro h
    have := congrArg Prod.fst h
    simp only [Prod.fst_zero] at this
    omega
  rw [(monsterLieBorcherdsRootEquiv _ hγ).finrank_eq]
  rw [show (1 + ((m : ℤ), (n : ℤ)).1 * ((m : ℤ), (n : ℤ)).2) = ((m * n + 1 : ℕ) : ℤ) by
    push_cast
    ring]
  rw [VnatVOA_grading, finrank_gradingNat_eq_coeff_JShift]
  rfl

/-- **The KNZ hypothesis for `𝔪`** is the product identity `knz_product`. -/
theorem monsterLiePreData_KNZ : monsterLiePreData.KNZ := by
  have h1 : coneProd (fun m n : ℕ =>
      (finrank ℂ (monsterLiePreData.weightSpace ((m : ℤ), (n : ℤ))) : ℂ)) =
      coneProd fun m n => cJ (m * n) :=
    coneProd_congr fun m n hm hn => finrank_monsterLieBorcherdsWeight_cone m n hm hn
  have h2 : knzSeries (fun j : ℕ =>
      (finrank ℂ (monsterLiePreData.weightSpace (1, (j : ℤ))) : ℂ)) = knzSeries cJ :=
    knzSeries_congr fun j hj => by
      simpa using finrank_monsterLieBorcherdsWeight_cone 1 j one_pos hj
  rw [BorcherdsPreData.KNZ, h1, h2]
  exact knz_product

/-- **The Monster Lie algebra is generated by its simple root spaces.** -/
theorem monsterLieSimpleRootGeneration : MonsterLieSimpleRootGeneration :=
  monsterLiePreData.lieSpan_eq_top_of_KNZ monsterLiePreData_KNZ

/-- **Conway–Norton from finite order alone**: `conwayNorton_of_simpleRootGeneration` with
simple-root generation supplied. -/
theorem conwayNorton_of_isOfFinOrder (hfin : ∀ g : AutVnat, IsOfFinOrder g) :
    ConwayNortonConjecture :=
  conwayNorton_of_simpleRootGeneration monsterLieSimpleRootGeneration hfin

end VOA.Moonshine.ConwayNorton.M8
