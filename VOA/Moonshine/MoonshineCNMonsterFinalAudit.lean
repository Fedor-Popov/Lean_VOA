import VOA.Moonshine.MoonshineLRMonsterFinal
import VOA.Moonshine.MoonshineCNFinalAudit
import VOA.Moonshine.MoonshineCNGriessIso

/-!
# Final audit of the Conway–Norton theorem for the Monster

Coordinator audit of the Monster form of the Conway–Norton theorem, stated in terms of the rational
model `AutO ≤ GL_ℚ(SpaceB)` of the Monster (the automorphism group of Axiom's Griess algebra) and
transported to `V♮₂` by the isomorphism `griessIso : ℂ ⊗ SpaceB ≃ V♮₂`.

* `conwayNorton_monster`: Conway–Norton for every element of `AutO`, given the CFSG generation
  theorem `Generated.Gmat = AutO`. This restates `M8.conwayNorton_monster_of_Gmat`.
* `conwayNorton_gmat`: Conway–Norton for every element of the generated group
  `Generated.Gmat = ⟨Gvis, tauB⟩`, with **no hypotheses**. The generation theorem is what identifies
  `Generated.Gmat` with `AutO`; it is not used here.

The proof of `conwayNorton_gmat`: `Generated.Gmat` is the image under the inclusion
`AutO → GL_ℚ(SpaceB)` of the subgroup of `AutO` generated by `tauB` and the visible elements
(`gmat_eq_map_closure_insert_tauB`). Every visible element lifts to `V♮`
(`M8.isVnatLiftable_of_mem_visibleSetAutO`), and so does `tauB` (`M8.isVnatLiftable_tauB`), so that
subgroup lies in `liftableSubgroup`. For a liftable element,
`conwayNorton_monster_of_isVnatLiftable` gives the lift and the Hauptmodul property.
-/

namespace VOA.Moonshine.ConwayNorton

open VOA.Moonshine.AutMonster VOA.Moonshine.GriessDictionary
open VOA.Moonshine.MonsterGriess VOA.Moonshine.MonsterAction

/-- **Conway–Norton for every element of the Monster `AutO`**, given CFSG's generation theorem
`Generated.Gmat = AutO`: every `g ∈ AutO` is the restriction to `V♮₂` (through `griessIso`) of some
automorphism `h` of `V♮`, whose McKay–Thompson series is the normalised Hauptmodul of a moonshine
group. -/
theorem conwayNorton_monster (hGmat : Generated.Gmat = AutO) (g : AutO) :
    ∃ h : AutVnat, vnatWeightTwoRestrict h = griessConj (g : SpaceB ≃ₗ[ℚ] SpaceB) ∧
      ∃ (Γ : Subgroup (GL (Fin 2) ℝ)) (N : ℕ), IsMoonshineGroup Γ N ∧
        IsNormalizedHauptmodul Γ (mckayThompsonFun h) :=
  M8.conwayNorton_monster_of_Gmat hGmat g

/-- The triality generator `tauB`, as an element of `AutO`. -/
noncomputable def tauBAutO : AutO := ⟨tauB, tauB_mem_AutO⟩

/-- The visible elements of `AutO` are exactly the visible group `Gvis`, read in `GL_ℚ(SpaceB)`. -/
theorem image_visibleSetAutO :
    (AutO.subtype '' M8.visibleSetAutO) = (Visible.Gvis : Set (SpaceB ≃ₗ[ℚ] SpaceB)) := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact hy
  · intro hx
    exact ⟨⟨x, Visible.Gvis_le_AutO hx⟩, hx, rfl⟩

/-- **The generated group inside `AutO`**: `Generated.Gmat = ⟨Gvis, tauB⟩` is the image, under the
inclusion of `AutO` in `GL_ℚ(SpaceB)`, of the subgroup of `AutO` generated by `tauB` and the visible
elements. -/
theorem gmat_eq_map_closure_insert_tauB :
    Generated.Gmat = (Subgroup.closure (insert tauBAutO M8.visibleSetAutO)).map AutO.subtype := by
  rw [MonoidHom.map_closure, Set.image_insert_eq, image_visibleSetAutO,
    Generated.Gmat_eq_closure_insert]
  rfl

/-- **The subgroup of `AutO` generated by `tauB` and the visible elements lifts to `V♮`.** -/
theorem closure_insert_tauB_le_liftableSubgroup :
    Subgroup.closure (insert tauBAutO M8.visibleSetAutO) ≤ liftableSubgroup :=
  subgroupClosure_insert_le_liftable M8.isVnatLiftable_of_mem_visibleSetAutO
    M8.isVnatLiftable_tauB

/-- **Every element of `AutO` lying in `Generated.Gmat` lifts to an automorphism of `V♮`.** -/
theorem isVnatLiftable_of_mem_gmat (g : AutO)
    (hg : (g : SpaceB ≃ₗ[ℚ] SpaceB) ∈ Generated.Gmat) : IsVnatLiftable g := by
  rw [gmat_eq_map_closure_insert_tauB, Subgroup.mem_map] at hg
  obtain ⟨g', hg', hgg'⟩ := hg
  have hEq : g' = g := Subtype.ext hgg'
  subst hEq
  exact mem_liftableSubgroup.1 (closure_insert_tauB_le_liftableSubgroup hg')

/-- **Conway–Norton for every element of the generated group `Generated.Gmat = ⟨Gvis, tauB⟩`**, with
no hypotheses: every `g ∈ AutO` lying in `Generated.Gmat` is the restriction to `V♮₂` (through
`griessIso`) of some automorphism `h` of `V♮`, whose McKay–Thompson series is the normalised
Hauptmodul of a moonshine group. The CFSG generation theorem `Generated.Gmat = AutO` would
extend this to all of `AutO` (`conwayNorton_monster`). -/
theorem conwayNorton_gmat (g : AutO) (hg : (g : SpaceB ≃ₗ[ℚ] SpaceB) ∈ Generated.Gmat) :
    ∃ h : AutVnat, vnatWeightTwoRestrict h = griessConj (g : SpaceB ≃ₗ[ℚ] SpaceB) ∧
      ∃ (Γ : Subgroup (GL (Fin 2) ℝ)) (N : ℕ), IsMoonshineGroup Γ N ∧
        IsNormalizedHauptmodul Γ (mckayThompsonFun h) := by
  obtain ⟨h, hres, -, -, hCN⟩ :=
    conwayNorton_monster_of_isVnatLiftable g (isVnatLiftable_of_mem_gmat g hg)
  exact ⟨h, hres, hCN⟩

/-- The unfolded statement of `conwayNorton_gmat`: for every linear automorphism `g` of `SpaceB`
that preserves Axiom's Griess product and form and lies in the group generated by `Gvis` and `tauB`,
some automorphism `h` of `V♮` acts on `V♮₂` as `griessIso ∘ (ℂ ⊗ g) ∘ griessIso⁻¹`, and the
McKay–Thompson series of `h` is the normalised Hauptmodul of a genus-zero group containing some
`Γ₀(N)` and commensurable with `SL₂(ℤ)`. -/
example (g : SpaceB ≃ₗ[ℚ] SpaceB)
    (hA : (∀ u v, g (gmul u v) = gmul (g u) (g v)) ∧ ∀ u v, bform (g u) (g v) = bform u v)
    (hg : g ∈ Subgroup.closure ((Visible.Gvis : Set (SpaceB ≃ₗ[ℚ] SpaceB)) ∪ {tauB})) :
    ∃ h : AutVnat, vnatWeightTwoRestrict h
        = (griessIso.symm ≪≫ₗ LinearEquiv.baseChange ℚ ℂ SpaceB SpaceB g ≪≫ₗ griessIso) ∧
      ∃ (Γ : Subgroup (GL (Fin 2) ℝ)) (N : ℕ), IsMoonshineGroup Γ N ∧
        IsNormalizedHauptmodul Γ (mckayThompsonFun h) :=
  conwayNorton_gmat ⟨g, hA⟩ hg

end VOA.Moonshine.ConwayNorton

