import VOA.Moonshine.MoonshineLRGenerationRadical

/-!
# `G / R` is Borcherds data

For Borcherds pre-data `P`, the quotient `𝔤 = G ⧸ R` of the subalgebra generated by the simple
root spaces by the radical of the form carries Borcherds data `P.quotientData`, generated by its
simple root spaces by construction. If `g_γ` and `g_{−γ}` both lie in `G`, then `𝔤_γ ≅ g_γ`
(`finrank_quotientWeight`).
-/

noncomputable section

namespace VOA.Moonshine.ConwayNorton.M8

open Module

namespace BorcherdsPreData

variable {g : Type*} [LieRing g] [LieAlgebra ℂ g] (P : BorcherdsPreData g)

theorem mem_simpleSpan_of_mem_zero {x : g} (hx : x ∈ P.weightSpace 0) : x ∈ P.simpleSpan :=
  LieSubalgebra.subset_lieSpan (Or.inl hx)

theorem weightSpace_le_simpleSpan {α : ℤ × ℤ} (hα : borcherdsSimpleRoot α) :
    P.weightSpace α ≤ P.simpleSpan.toSubmodule :=
  fun _ hx => LieSubalgebra.subset_lieSpan (Or.inr ⟨α, hα, Or.inl hx⟩)

theorem weightSpace_neg_le_simpleSpan {α : ℤ × ℤ} (hα : borcherdsSimpleRoot α) :
    P.weightSpace (-α) ≤ P.simpleSpan.toSubmodule :=
  fun _ hx => LieSubalgebra.subset_lieSpan (Or.inr ⟨α, hα, Or.inr hx⟩)

theorem cartan_mem_weightSpace_zero (ξ : ℂ × ℂ) : P.cartanMap ξ ∈ P.weightSpace 0 := by
  rw [← P.cartan_range]
  exact LinearMap.mem_range_self _ ξ

/-- The Cartan of `G`. -/
def simpleCartan : (ℂ × ℂ) →ₗ[ℂ] P.simpleSpan :=
  P.cartanMap.codRestrict P.simpleSpan.toSubmodule
    fun ξ => P.mem_simpleSpan_of_mem_zero (P.cartan_mem_weightSpace_zero ξ)

/-- The Cartan of `𝔤`. -/
def quotientCartan : (ℂ × ℂ) →ₗ[ℂ] P.simpleQuotient :=
  (P.quotientMap : P.simpleSpan →ₗ[ℂ] P.simpleQuotient) ∘ₗ P.simpleCartan

theorem eq_zero_of_cartanPairing (ξ : ℂ × ℂ) (h : ∀ μ, borcherdsCartanPairing ξ μ = 0) :
    ξ = 0 := by
  have h1 := h (1, 0)
  have h2 := h (0, 1)
  simp only [borcherdsCartanPairing, mul_zero, mul_one, one_mul, zero_mul, zero_add, add_zero,
    neg_eq_zero] at h1 h2
  exact Prod.ext h2 h1

theorem quotientCartan_injective : Function.Injective P.quotientCartan := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro ξ hξ
  have hR : P.simpleCartan ξ ∈ P.simpleRadical := P.quotientMap_eq_zero.mp hξ
  apply eq_zero_of_cartanPairing ξ
  intro μ
  rw [← P.form_cartan]
  exact hR (P.simpleCartan μ)

theorem range_simpleCartan : LinearMap.range P.simpleCartan = P.simpleSpanWeight 0 := by
  ext x
  constructor
  · rintro ⟨ξ, rfl⟩
    exact P.cartan_mem_weightSpace_zero ξ
  · intro hx
    have hx' : (x : g) ∈ LinearMap.range P.cartanMap := by
      rw [P.cartan_range]
      exact hx
    obtain ⟨ξ, hξ⟩ := hx'
    exact ⟨ξ, Subtype.ext hξ⟩

theorem quotientCartan_range : LinearMap.range P.quotientCartan = P.quotientWeight 0 := by
  rw [quotientCartan, LinearMap.range_comp, range_simpleCartan, quotientWeight]

theorem quotientCartan_action (ξ : ℂ × ℂ) (γ : ℤ × ℤ) (q : P.simpleQuotient)
    (hq : q ∈ P.quotientWeight γ) :
    ⁅P.quotientCartan ξ, q⁆ = borcherdsCartanPairing ξ (borcherdsWeightVector γ) • q := by
  obtain ⟨x, hx, rfl⟩ := hq
  have hG : ⁅P.simpleCartan ξ, x⁆ = borcherdsCartanPairing ξ (borcherdsWeightVector γ) • x :=
    Subtype.ext (by rw [LieSubalgebra.coe_bracket]; exact P.cartan_action ξ γ x hx)
  change ⁅P.quotientMap (P.simpleCartan ξ), P.quotientMap x⁆ = _
  rw [← LieHom.map_lie, hG, map_smul]
  rfl

theorem quotientWeight_bracket {γ δ : ℤ × ℤ} {q r : P.simpleQuotient}
    (hq : q ∈ P.quotientWeight γ) (hr : r ∈ P.quotientWeight δ) :
    ⁅q, r⁆ ∈ P.quotientWeight (γ + δ) := by
  obtain ⟨x, hx, rfl⟩ := hq
  obtain ⟨y, hy, rfl⟩ := hr
  refine ⟨⁅x, y⁆, ?_, (LieHom.map_lie P.quotientMap x y)⟩
  change ((⁅x, y⁆ : P.simpleSpan) : g) ∈ P.weightSpace (γ + δ)
  rw [LieSubalgebra.coe_bracket]
  exact P.bracket_weight hx hy

instance (γ : ℤ × ℤ) : FiniteDimensional ℂ (P.quotientWeight γ) := by
  unfold quotientWeight
  infer_instance

theorem quotientForm_symmetric (q r : P.simpleQuotient) :
    P.quotientForm q r = P.quotientForm r q := by
  obtain ⟨x, rfl⟩ := P.quotientMap_surjective q
  obtain ⟨y, rfl⟩ := P.quotientMap_surjective r
  exact P.form_symmetric _ _

theorem quotientForm_invariant (q r s : P.simpleQuotient) :
    P.quotientForm ⁅q, r⁆ s = P.quotientForm q ⁅r, s⁆ := by
  obtain ⟨x, rfl⟩ := P.quotientMap_surjective q
  obtain ⟨y, rfl⟩ := P.quotientMap_surjective r
  obtain ⟨z, rfl⟩ := P.quotientMap_surjective s
  rw [← LieHom.map_lie, ← LieHom.map_lie]
  change P.form ((⁅x, y⁆ : P.simpleSpan) : g) (z : g) =
    P.form (x : g) ((⁅y, z⁆ : P.simpleSpan) : g)
  rw [LieSubalgebra.coe_bracket, LieSubalgebra.coe_bracket, P.form_invariant]

theorem quotientForm_orthogonal (γ δ : ℤ × ℤ) (h : γ + δ ≠ 0) :
    ∀ q ∈ P.quotientWeight γ, ∀ r ∈ P.quotientWeight δ, P.quotientForm q r = 0 := by
  rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
  exact P.form_orthogonal γ δ h _ hx _ hy

theorem quotientForm_cartan (ξ μ : ℂ × ℂ) :
    P.quotientForm (P.quotientCartan ξ) (P.quotientCartan μ) = borcherdsCartanPairing ξ μ :=
  P.form_cartan ξ μ

theorem quotientForm_nondegenerate (γ : ℤ × ℤ) (q : P.simpleQuotient)
    (hq : q ∈ P.quotientWeight γ)
    (h : ∀ r ∈ P.quotientWeight (-γ), P.quotientForm q r = 0) : q = 0 := by
  obtain ⟨x, hx, rfl⟩ := hq
  refine P.quotientMap_eq_zero.mpr (P.mem_simpleRadical_of_orthogonal hx fun y hy => ?_)
  exact h (P.quotientMap y) ⟨y, hy, rfl⟩

theorem quotientWeight_support (γ : ℤ × ℤ) (hne : P.quotientWeight γ ≠ ⊥) :
    borcherdsRootSupport γ := by
  apply P.root_support
  intro h0
  apply hne
  rw [eq_bot_iff]
  rintro _ ⟨x, hx, rfl⟩
  have hx0 : x = 0 := Subtype.ext ((Submodule.eq_bot_iff _).mp h0 _ hx)
  rw [hx0, map_zero]
  exact Submodule.zero_mem _

/-- If `g_γ` and `g_{−γ}` both lie in `G`, then `dim 𝔤_γ = dim g_γ`. -/
theorem finrank_quotientWeight {γ : ℤ × ℤ} (hγ : P.weightSpace γ ≤ P.simpleSpan.toSubmodule)
    (hγ' : P.weightSpace (-γ) ≤ P.simpleSpan.toSubmodule) :
    finrank ℂ (P.quotientWeight γ) = finrank ℂ (P.weightSpace γ) := by
  have hinj : Function.Injective
      ((P.quotientMap : P.simpleSpan →ₗ[ℂ] P.simpleQuotient).domRestrict
        (P.simpleSpanWeight γ)) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have hR : (x : P.simpleSpan) ∈ P.simpleRadical := P.quotientMap_eq_zero.mp hx
    have hx0 : ((x : P.simpleSpan) : g) = 0 := by
      refine P.form_nondegenerate γ _ x.2 fun y hy => ?_
      exact hR ⟨y, hγ' hy⟩
    exact Subtype.ext (Subtype.ext hx0)
  rw [quotientWeight, ← LinearMap.range_domRestrict, LinearMap.finrank_range_of_inj hinj]
  exact (Submodule.comapSubtypeEquivOfLe hγ).finrank_eq

theorem quotient_real_dimension :
    finrank ℂ (P.quotientWeight borcherdsRealRoot) = 1 ∧
      finrank ℂ (P.quotientWeight (-borcherdsRealRoot)) = 1 := by
  have hα : borcherdsSimpleRoot borcherdsRealRoot := Or.inl rfl
  constructor
  · rw [P.finrank_quotientWeight (P.weightSpace_le_simpleSpan hα)
      (P.weightSpace_neg_le_simpleSpan hα)]
    exact P.real_dimension.1
  · rw [P.finrank_quotientWeight (P.weightSpace_neg_le_simpleSpan hα)
      (by rw [neg_neg]; exact P.weightSpace_le_simpleSpan hα)]
    exact P.real_dimension.2

/-- Inside `G`, the generators pulled back to `G` generate. -/
theorem lieSpan_preimage_eq_top :
    LieSubalgebra.lieSpan ℂ P.simpleSpan
      {x : P.simpleSpan | (x : g) ∈ borcherdsSimpleGenerators P.weightSpace} = ⊤ := by
  set H := LieSubalgebra.lieSpan ℂ P.simpleSpan
    {x : P.simpleSpan | (x : g) ∈ borcherdsSimpleGenerators P.weightSpace}
  have hG : P.simpleSpan ≤ H.map P.simpleSpan.incl :=
    LieSubalgebra.lieSpan_le.mpr fun s hs =>
      (LieSubalgebra.mem_map _ _ _).mpr ⟨⟨s, LieSubalgebra.subset_lieSpan hs⟩,
        LieSubalgebra.subset_lieSpan hs, rfl⟩
  rw [eq_top_iff]
  intro x _
  obtain ⟨y, hy, hyx⟩ := (LieSubalgebra.mem_map _ _ _).mp (hG x.2)
  have hyx' : y = x := Subtype.ext hyx
  rwa [← hyx']

/-- **`𝔤` is generated by its simple root spaces.** -/
theorem quotient_generated :
    LieSubalgebra.lieSpan ℂ P.simpleQuotient (borcherdsSimpleGenerators P.quotientWeight) = ⊤ := by
  rw [eq_top_iff]
  rintro q -
  obtain ⟨x, rfl⟩ := P.quotientMap_surjective q
  have hx : x ∈ LieSubalgebra.lieSpan ℂ P.simpleSpan
      {x : P.simpleSpan | (x : g) ∈ borcherdsSimpleGenerators P.weightSpace} := by
    rw [P.lieSpan_preimage_eq_top]
    exact LieSubalgebra.mem_top x
  have hle : LieSubalgebra.lieSpan ℂ P.simpleSpan
      {x : P.simpleSpan | (x : g) ∈ borcherdsSimpleGenerators P.weightSpace} ≤
      (LieSubalgebra.lieSpan ℂ P.simpleQuotient
        (borcherdsSimpleGenerators P.quotientWeight)).comap P.quotientMap := by
    refine LieSubalgebra.lieSpan_le.mpr fun y hy => LieSubalgebra.subset_lieSpan ?_
    rcases hy with h0 | ⟨α, hα, h | h⟩
    · exact Or.inl ⟨y, h0, rfl⟩
    · exact Or.inr ⟨α, hα, Or.inl ⟨y, h, rfl⟩⟩
    · exact Or.inr ⟨α, hα, Or.inr ⟨y, h, rfl⟩⟩
  exact hle hx

/-- **`G ⧸ R` is Borcherds data.** -/
def quotientData : BorcherdsData P.simpleQuotient where
  weightSpace := P.quotientWeight
  weight_internal := P.isInternal_quotientWeight
  weight_finite := fun _ => inferInstance
  bracket_weight := P.quotientWeight_bracket
  cartanMap := P.quotientCartan
  cartan_injective := P.quotientCartan_injective
  cartan_range := P.quotientCartan_range
  cartan_action := P.quotientCartan_action
  form := P.quotientForm
  form_symmetric := P.quotientForm_symmetric
  form_invariant := P.quotientForm_invariant
  form_orthogonal := P.quotientForm_orthogonal
  form_cartan := P.quotientForm_cartan
  form_nondegenerate := P.quotientForm_nondegenerate
  root_support := P.quotientWeight_support
  real_dimension := P.quotient_real_dimension
  generated := P.quotient_generated

end BorcherdsPreData

end VOA.Moonshine.ConwayNorton.M8
