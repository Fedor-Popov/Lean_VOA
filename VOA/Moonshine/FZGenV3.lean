/-! ## §1  The pair lemma -/

theorem odd_abs_split {z : ℤ} (h : Odd z) : ∃ r : ℤ, |z| = 2 * r + 1 ∧ 0 ≤ r := by
  obtain ⟨r, hr⟩ := (odd_abs.mpr h)
  exact ⟨r, hr, by have := abs_nonneg z; omega⟩

theorem dot_self_of_ones (x : Fin 24 → ℤ) (i0 : Fin 24) (h : ∀ k, k ≠ i0 → |x k| = 1) :
    x ⬝ᵥ x = |x i0| * |x i0| + 23 := by
  rw [dotProduct, ← Finset.add_sum_erase _ _ (Finset.mem_univ i0), abs_mul_abs_self]
  congr 1
  rw [Finset.sum_congr rfl (g := fun _ => (1 : ℤ)) (fun k hk => by
    rw [← abs_mul_abs_self, h k (Finset.ne_of_mem_erase hk), one_mul])]
  simp [Finset.card_erase_of_mem]

theorem exists_two_ne (i0 : Fin 24) : ∃ j1 j2 : Fin 24, j1 ≠ i0 ∧ j2 ≠ i0 ∧ j1 ≠ j2 := by
  by_cases h0 : i0 = 0
  · subst h0; exact ⟨1, 2, by decide, by decide, by decide⟩
  by_cases h1 : i0 = 1
  · subst h1; exact ⟨0, 2, by decide, by decide, by decide⟩
  exact ⟨0, 1, Ne.symm h0, Ne.symm h1, by decide⟩

/-- **The pair lemma** (pure arithmetic): a vector of `24` odd integers with `x·x ≥ 48` and
`16 ∣ x·x` has two coordinates with `|xᵢ| + |x_k| = 6` or `≥ 10`. -/
theorem exists_good_pair (x : Fin 24 → ℤ) (hodd : ∀ i, Odd (x i)) (h48 : 48 ≤ x ⬝ᵥ x)
    (h16 : (16 : ℤ) ∣ x ⬝ᵥ x) :
    ∃ i k : Fin 24, i ≠ k ∧ (|x i| + |x k| = 6 ∨ 10 ≤ |x i| + |x k|) := by
  by_contra H
  push Not at H
  obtain ⟨i0, -, hmax⟩ := Finset.exists_max_image Finset.univ (fun i => |x i|) Finset.univ_nonempty
  obtain ⟨j1, j2, h1, h2, h12⟩ := exists_two_ne i0
  obtain ⟨r, hr, hr0⟩ := odd_abs_split (hodd i0)
  obtain ⟨s1, hs1, hs10⟩ := odd_abs_split (hodd j1)
  obtain ⟨s2, hs2, hs20⟩ := odd_abs_split (hodd j2)
  have H1 := H i0 j1 (Ne.symm h1)
  have H2 := H i0 j2 (Ne.symm h2)
  have H12 := H j1 j2 h12
  have hm1 := hmax j1 (Finset.mem_univ _)
  have hm2 := hmax j2 (Finset.mem_univ _)
  simp only at hm1 hm2
  -- all other coordinates are `±1` unless `|x i0| = 5`
  have hones : r ≠ 2 → ∀ k, k ≠ i0 → |x k| = 1 := by
    intro hr2 k hk
    obtain ⟨s, hs, hs0⟩ := odd_abs_split (hodd k)
    have Hk := H i0 k (Ne.symm hk)
    have hmk := hmax k (Finset.mem_univ _)
    simp only at hmk
    omega
  rcases (show r = 2 ∨ r ≠ 2 by omega) with hr2 | hr2
  · omega
  · have hsum := dot_self_of_ones x i0 (hones hr2)
    rw [hsum, hr] at h48 h16
    have : r ≤ 3 := by omega
    interval_cases r <;> omega

/-- **The pair lemma in `Λ`**: for `ν ∈ Λ ∖ Λ₀` with `|ν|² ≥ 6` there is `γ ∈ Λ₀`, `|γ|² = 4`,
with `⟨γ,ν⟩ = 3` or `⟨γ,ν⟩ ≥ 5`. -/
theorem exists_pair_gamma {ν : leech.carrier} (hν : ν ∉ lambda0) (h6 : 6 ≤ leech.form ν ν) :
    ∃ γ ∈ lambda0, leech.form γ γ = 4 ∧ (leech.form γ ν = 3 ∨ 5 ≤ leech.form γ ν) := by
  have hdot := lv_dot ν ν
  have e := two_mul_halfNorm ν
  obtain ⟨i, k, hik, hgood⟩ := exists_good_pair (lv ν) (lv_odd_of_not_mem hν) (by omega)
    ⟨LatGen.halfNorm leech ν, by omega⟩
  -- a vector `γ` with `lv γ = 4 (s eᵢ + t e_k)`
  have key : ∀ (s t : ℤ), s * s = 1 → t * t = 1 → ∀ γ : leech.carrier,
      lv γ = (fun m => (if m = i then 4 * s else 0) + (if m = k then 4 * t else 0)) →
      leech.form γ γ = 4 ∧ 2 * leech.form γ ν = s * lv ν i + t * lv ν k := by
    intro s t hs ht γ hγ
    have hγγ := lv_dot γ γ
    have hγν := lv_dot γ ν
    have c1 : lv γ ⬝ᵥ lv γ = 16 * (s * s) + 16 * (t * t) := by
      rw [hγ]
      simp only [dotProduct, add_mul, mul_add, Finset.sum_add_distrib, ite_mul, zero_mul, mul_ite,
        mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true, if_neg hik, if_neg (Ne.symm hik)]
      ring
    have c2 : lv γ ⬝ᵥ lv ν = 4 * (s * lv ν i) + 4 * (t * lv ν k) := by
      rw [hγ]
      simp only [dotProduct, add_mul, Finset.sum_add_distrib, ite_mul, zero_mul,
        Finset.sum_ite_eq', Finset.mem_univ, if_true]
      ring
    constructor <;> nlinarith
  have hsg : ∀ z : ℤ, GroundLat.sg z * GroundLat.sg z = 1 := by
    intro z; rcases GroundLat.sg_cases z with h | h <;> rw [h] <;> norm_num
  -- the four sign patterns
  have hex : ∃ γ ∈ lambda0, lv γ = (fun m => (if m = i then 4 * GroundLat.sg (lv ν i) else 0)
      + (if m = k then 4 * GroundLat.sg (lv ν k) else 0)) := by
    rcases GroundLat.sg_cases (lv ν i) with hi | hi <;>
      rcases GroundLat.sg_cases (lv ν k) with hk | hk
    · refine ⟨gP i k, gP_mem i k, ?_⟩
      rw [lv_gP, hi, hk]; funext m; simp only [Pi.smul_apply, Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.single_apply, smul_eq_mul]; split_ifs <;> ring
    · refine ⟨gM i k, gM_mem i k, ?_⟩
      rw [lv_gM, hi, hk]; funext m; simp only [Pi.smul_apply, Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.single_apply, smul_eq_mul]; split_ifs <;> ring
    · refine ⟨-gM i k, lambda0.neg_mem (gM_mem i k), ?_⟩
      rw [lv_neg, lv_gM, hi, hk]; funext m; simp only [Pi.smul_apply, Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.single_apply, smul_eq_mul]; split_ifs <;> ring
    · refine ⟨-gP i k, lambda0.neg_mem (gP_mem i k), ?_⟩
      rw [lv_neg, lv_gP, hi, hk]; funext m; simp only [Pi.smul_apply, Pi.add_apply, Pi.sub_apply, Pi.neg_apply, Pi.single_apply, smul_eq_mul]; split_ifs <;> ring
  obtain ⟨γ, hγ, hlv⟩ := hex
  obtain ⟨h4, h2⟩ := key _ _ (hsg _) (hsg _) γ hlv
  rw [GroundLat.sg_mul, GroundLat.sg_mul] at h2
  refine ⟨γ, hγ, h4, ?_⟩
  omega

/-! ## §2  The ground states -/

theorem not_mem_sub_of {γ ν : leech.carrier} (hγ : γ ∈ lambda0) (hν : ν ∉ lambda0) :
    ν - γ ∉ lambda0 := fun h => hν (by simpa using add_mem h hγ)

/-- **The ground sector of `V₃⁺`**: `x_ν ∈ span (Lv (½|ν|²))` for `ν ∈ Λ ∖ Λ₀`, `|ν|² ≥ 6`. -/
theorem ground_mem_span {ν : leech.carrier} (hν : ν ∉ lambda0) (h6 : 6 ≤ leech.form ν ν) :
    frameX0P ν ∈ span ℂ (Lv (LatGen.halfNorm leech ν)) := by
  obtain ⟨γ, hγ, hγγ, hf⟩ := exists_pair_gamma hν h6
  set δ := ν - γ with hδdef
  have hδ : δ ∉ lambda0 := not_mem_sub_of hγ hν
  have hsum : γ + δ = ν := by rw [hδdef]; abel
  have hsym : leech.form ν γ = leech.form γ ν := IntegralLattice.form_symm leech ν γ
  have hfd : leech.form γ δ = leech.form γ ν - 4 := by
    rw [hδdef, map_sub, hγγ]
  have hδδ : leech.form δ δ = leech.form ν ν - 2 * leech.form γ ν + 4 := by
    rw [hδdef, form_sub_self, hsym, hγγ]
  have e1 := two_mul_halfNorm ν
  have e2 := two_mul_halfNorm δ
  have e3 := two_mul_halfNorm γ
  have hδ1 := frameX0_mem_frameSector_one hδ
  have hδq := InvForm.frameX0P_mem_grading δ
  have ha : ((x0 hγ : V0Sub.carrier) : VPlus) ∈ leechVOAPlus.grading (LatGen.halfNorm leech γ) :=
    x0_mem_grading hγ
  set n := LatGen.halfNorm leech ν
  rcases hf with hf | hf
  · -- `f = -1`
    have hmem := smul_mem_Lv (j := 0) ha hδ1 hδq (n := n) (by omega) le_rfl (by omega)
    have heq : leechVOAPlus.smul (frameX0P γ) 0 (frameX0P δ)
        = latticeCocycle leech γ δ • frameX0P (γ + δ) :=
      frameX0P_smul_zero_of_form_neg_one (by omega)
    have hsp := smul_mem _ (latticeCocycle leech γ δ) (subset_span (R := ℂ) hmem)
    change latticeCocycle leech γ δ • leechVOAPlus.smul (frameX0P γ) 0 (frameX0P δ) ∈ _ at hsp
    rwa [heq, smul_smul, latticeCocycle_sq, one_smul, hsum] at hsp
  · -- `f = k ≥ 1`
    obtain ⟨k, hkk⟩ : ∃ k : ℕ, leech.form γ δ = k := ⟨(leech.form γ δ).toNat, by omega⟩
    have hk1 : 1 ≤ k := by omega
    have hmem := smul_mem_Lv (j := -(k : ℤ) - 1) ha hδ1 hδq (n := n) (by omega) (by omega)
      (by omega)
    have hγδ : γ - δ ∉ lambda0 := by
      intro h
      apply hδ
      have := sub_mem hγ h
      rwa [sub_sub_cancel] at this
    have e4 := two_mul_halfNorm (γ - δ)
    rw [form_sub_self, hkk, hγγ] at e4
    have hex := excV3_mem_span hγδ (w := 2 * k) (by omega) (vSchur_mem_gradingWN leech γ (2 * k))
    rw [show ((2 * k : ℕ) : ℤ) + LatGen.halfNorm leech (γ - δ) = n by push_cast; omega] at hex
    have heq : leechVOAPlus.smul (frameX0P γ) (-(k : ℤ) - 1) (frameX0P δ)
        = latticeCocycle leech γ δ • (frameX0P (γ + δ)
          + (2 : ℂ) • excV3 (γ - δ) (vSchur leech γ (2 * k))) := by
      apply Subtype.ext
      rw [frameX0P_smul_of_form_pos hkk]
      rfl
    have hsp := smul_mem _ (latticeCocycle leech γ δ) (subset_span (R := ℂ) hmem)
    change latticeCocycle leech γ δ • leechVOAPlus.smul (frameX0P γ) (-(k : ℤ) - 1) (frameX0P δ)
      ∈ _ at hsp
    rw [heq, smul_smul, latticeCocycle_sq, one_smul, hsum] at hsp
    have := sub_mem hsp (smul_mem _ (2 : ℂ) hex)
    rwa [add_sub_cancel_right] at this

/-! ## §3  Assembly -/

theorem wordWt_pos' {l : List (ℕ × Fin (rank leech))} (hl : l ≠ []) : 1 ≤ wordWt l := by
  cases l with
  | nil => exact absurd rfl hl
  | cons ia rest => rw [wordWt_cons]; omega

/-- **The spanning statement for `V₃⁺`**: for `n ≥ 3`, `M_n` is spanned by weight-raising
products of lower-weight states (`lowerProdM MV3 n`). -/
theorem V3_lowerSpanned (n : ℤ) (hn : 3 ≤ n) :
    MV3.weight (n : ℂ) ≤ span ℂ (lowerProdM MV3 n) := by
  intro x hx
  apply mem_of_mem_span_Lv
  have hxv := V3_le_span_words n x.2 (mem_MV3_weight_int.mp hx)
  refine (span_le.mpr ?_) hxv
  rintro _ ⟨l, ν, hν, hw, rfl⟩
  rw [SetLike.mem_coe]
  by_cases hl : l = []
  · subst hl
    simp only [wordWt_nil, Nat.cast_zero, zero_add] at hw
    rw [wordStateLatGen_nil, plusProj_latChargeGen]
    refine smul_mem _ _ ?_
    have e := two_mul_halfNorm ν
    have := ground_mem_span hν (by omega)
    rwa [hw] at this
  · have := excV3_mem_span hν (wordWt_pos' hl) (wordStateN_mem_gradingWN l)
    rw [hw] at this
    rw [wordStateLatGen_eq]
    exact this

theorem MV3_weight_int {α : ℂ} (h : MV3.weight α ≠ ⊥) : ∃ k : ℤ, α = k := by
  obtain ⟨m, rfl⟩ := isLowestWeight_MV3 α h
  exact ⟨2 + m, by push_cast; ring⟩

theorem MV3_weight_bot {k : ℤ} (hk : k < 2) : MV3.weight (k : ℂ) = ⊥ := by
  by_contra h
  obtain ⟨m, hm⟩ := isLowestWeight_MV3 _ h
  have : k = 2 + m := by exact_mod_cast hm
  omega

/-- **Bimodule generation of `A(V₃⁺)` by its top level.**  Every subspace `S` of
`M = V₃⁺` that contains `O(M)` (every `fzCirc MV3 p a x`), contains the top level `M₂`, and
is closed under the left action `a ∗ ·` (`fzLeft`) and the right action `· ∗ a` (`fzRight`)
of all homogeneous `a ∈ V₀⁺`, is all of `M`. -/
theorem bimodGen_V3 (S : Submodule ℂ (frameSector 1))
    (hO : ∀ (p : ℕ) (a : V0Sub.carrier), a ∈ V0P.grading (p : ℤ) → ∀ x, fzCirc MV3 p a x ∈ S)
    (hL : ∀ (p : ℕ) (a : V0Sub.carrier), a ∈ V0P.grading (p : ℤ) → ∀ x ∈ S, fzLeft MV3 p a x ∈ S)
    (hR : ∀ (p : ℕ) (a : V0Sub.carrier), 1 ≤ p → a ∈ V0P.grading (p : ℤ) → ∀ x ∈ S,
      fzRight MV3 p a x ∈ S)
    (htop : ∀ x : frameSector 1, x ∈ MV3.weight (2 : ℂ) → x ∈ S) : S = ⊤ := by
  refine eq_top_of_lowerSpanM MV3 {x | x ∈ MV3.weight (2 : ℂ)} 2 (fun α h => MV3_weight_int h)
    (fun k hk => MV3_weight_bot hk) (fun n => ?_) S hO hL hR (fun x hx => htop x hx)
  rcases lt_trichotomy n 2 with h | h | h
  · rw [MV3_weight_bot h]; exact bot_le
  · subst h
    intro x hx
    exact subset_span (Or.inl (by exact_mod_cast hx))
  · exact (V3_lowerSpanned n (by omega)).trans (span_mono Set.subset_union_right)

end VOA.Moonshine.FZGen
