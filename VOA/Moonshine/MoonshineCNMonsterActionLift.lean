import VOA.Moonshine.MoonshineCNMonsterActionConj

/-!
# Lifting elements of the rational Monster `AutO` to automorphisms of `V♮`

An element `g` of `AutO` (Axiom's Monster, the automorphism group of the rational Griess algebra
`SpaceB`) is **liftable** when some automorphism of the moonshine module acts on
`V♮₂ ≅ ℂ ⊗ SpaceB` as `ℂ ⊗ g`, i.e. its restriction to `V♮₂` is `griessConj g`.  Because `Aut V♮`
acts faithfully on `V♮₂` (`vnatGriessRestrict_injective`) the lift is unique, and the liftable
elements form a subgroup `liftableSubgroup` (the preimage under
`griessConjAut : AutO →* GriessAutVnat` of the image of `Aut V♮`).
`monsterLift : liftableSubgroup →* AutVnat` is the resulting injective homomorphism.

This does **not** use the reverse direction `Aut V♮ → AutO` (rationality, Tits).  That direction is
isolated here as a criterion: an automorphism of `V♮` lies in the image of `monsterLift` exactly
when it maps the rational dictionary `griessNat (SpaceB)` into itself
(`mem_range_monsterLift_iff`).  Consequently `Aut V♮ ≃* AutO` follows from two named inputs, every
element of `AutO` lifts and every automorphism of `V♮` is rational on `V♮₂`
(`autVnat_mulEquiv_autO_of_liftable_of_rational`).

## Main results
* `IsVnatLiftable g`, `liftableSubgroup`, ⭐ `mem_liftableSubgroup`.
* ⭐ `monsterLift : liftableSubgroup →* AutVnat`, ⭐ `monsterLift_restrict`,
  ⭐ `monsterLift_apply_griessNat` (`monsterLift g (griessNat u) = griessNat (g u)`),
  `monsterLift_unique`, ⭐ `monsterLift_injective`.
* ⭐ `subgroupClosure_le_liftable`, `subgroupClosure_insert_le_liftable`,
  `isVnatLiftable_of_closure_eq_top`.
* `monsterLiftOfAll hlift : AutO →* AutVnat` (when every element lifts),
  `monsterLiftOfAll_injective`.
* ⭐ `isVnatLiftable_of_rational`, ⭐ `mem_range_monsterLift_iff`,
  ⭐ `autVnat_mulEquiv_autO_of_liftable_of_rational`.
-/

set_option linter.style.longLine false

namespace VOA.Moonshine.MonsterAction

open VOA VOA.Moonshine VOA.Moonshine.AutMonster VOA.Moonshine.GriessDictionary
open VOA.Moonshine.MonsterGriess
open scoped TensorProduct

/-! ## Liftable elements -/

/-- **`g ∈ AutO` lifts to `V♮`**: some automorphism of `V♮` restricts on `V♮₂` to
`griessConj g = griessIso ∘ (ℂ ⊗ g) ∘ griessIso⁻¹`. -/
def IsVnatLiftable (g : AutO) : Prop :=
  ∃ h : AutVnat, vnatWeightTwoRestrict h = griessConj (g : SpaceB ≃ₗ[ℚ] SpaceB)

/-- **The liftable subgroup of `AutO`**: the preimage under `griessConjAut` of the image of `Aut V♮`
in the Griess automorphism group of `V♮`. -/
noncomputable def liftableSubgroup : Subgroup AutO :=
  vnatGriessRestrict.range.comap griessConjAut

/-- ⭐ Membership in `liftableSubgroup` is liftability. -/
theorem mem_liftableSubgroup {g : AutO} : g ∈ liftableSubgroup ↔ IsVnatLiftable g := by
  rw [liftableSubgroup, Subgroup.mem_comap, MonoidHom.mem_range]
  constructor
  · rintro ⟨h, hh⟩
    exact ⟨h, congrArg Subtype.val hh⟩
  · rintro ⟨h, hh⟩
    exact ⟨h, Subtype.ext hh⟩

theorem isVnatLiftable_one : IsVnatLiftable 1 :=
  mem_liftableSubgroup.1 liftableSubgroup.one_mem

theorem IsVnatLiftable.mul {g h : AutO} (hg : IsVnatLiftable g) (hh : IsVnatLiftable h) :
    IsVnatLiftable (g * h) :=
  mem_liftableSubgroup.1 (liftableSubgroup.mul_mem (mem_liftableSubgroup.2 hg)
    (mem_liftableSubgroup.2 hh))

theorem IsVnatLiftable.inv {g : AutO} (hg : IsVnatLiftable g) : IsVnatLiftable g⁻¹ :=
  mem_liftableSubgroup.1 (liftableSubgroup.inv_mem (mem_liftableSubgroup.2 hg))

/-- ⭐ **Generators suffice**: if every element of `S ⊆ AutO` lifts, so does the subgroup they
generate. -/
theorem subgroupClosure_le_liftable {S : Set AutO} (hS : ∀ g ∈ S, IsVnatLiftable g) :
    Subgroup.closure S ≤ liftableSubgroup :=
  (Subgroup.closure_le _).2 fun g hg => mem_liftableSubgroup.2 (hS g hg)

/-- **Generators plus one extra element** (the shape `Gmat = ⟨Gvis ∪ {τ}⟩`): if every element of
`S` lifts and `τ` lifts, the subgroup generated by `S ∪ {τ}` consists of liftable elements. -/
theorem subgroupClosure_insert_le_liftable {S : Set AutO} {τ : AutO}
    (hS : ∀ g ∈ S, IsVnatLiftable g) (hτ : IsVnatLiftable τ) :
    Subgroup.closure (insert τ S) ≤ liftableSubgroup :=
  subgroupClosure_le_liftable fun g hg => by
    rcases Set.mem_insert_iff.1 hg with rfl | hg
    · exact hτ
    · exact hS g hg

/-- If `S` generates `AutO` and every element of `S` lifts, every element of `AutO` lifts. -/
theorem isVnatLiftable_of_closure_eq_top {S : Set AutO} (hS : ∀ g ∈ S, IsVnatLiftable g)
    (hgen : Subgroup.closure S = ⊤) (g : AutO) : IsVnatLiftable g :=
  mem_liftableSubgroup.1 (subgroupClosure_le_liftable hS (hgen ▸ Subgroup.mem_top g))

/-! ## The lift homomorphism -/

/-- ⭐ **The lift of the liftable part of the Monster to `Aut V♮`**: `g ↦` the unique automorphism of
`V♮` acting on `V♮₂` as `griessConj g`. -/
noncomputable def monsterLift : liftableSubgroup →* AutVnat :=
  (MonoidHom.ofInjective vnatGriessRestrict_injective).symm.toMonoidHom.comp
    (griessConjAut.subgroupComap vnatGriessRestrict.range)

/-- ⭐ **The lift restricts to `griessConjAut g` on the Griess algebra.** -/
theorem monsterLift_griessRestrict (g : liftableSubgroup) :
    vnatGriessRestrict (monsterLift g) = griessConjAut (g : AutO) :=
  MonoidHom.apply_ofInjective_symm vnatGriessRestrict_injective
    (griessConjAut.subgroupComap vnatGriessRestrict.range g)

/-- ⭐ **The lift acts on `V♮₂` as `griessConj g`.** -/
theorem monsterLift_restrict (g : liftableSubgroup) :
    vnatWeightTwoRestrict (monsterLift g) = griessConj ((g : AutO) : SpaceB ≃ₗ[ℚ] SpaceB) :=
  congrArg Subtype.val (monsterLift_griessRestrict g)

/-- ⭐ **On the rational Griess algebra the lift is `g` itself**:
`monsterLift g (griessNat u) = griessNat (g u)` for every `u ∈ SpaceB`. -/
theorem monsterLift_apply_griessNat (g : liftableSubgroup) (u : SpaceB) :
    monsterLift g (griessNat u : Vnat) = griessNat (((g : AutO) : SpaceB ≃ₗ[ℚ] SpaceB) u) := by
  rw [← vnatWeightTwoRestrict_apply_coe, monsterLift_restrict, griessConj_griessNat]

/-- **Uniqueness of the lift**: an automorphism of `V♮` acting on `V♮₂` as `griessConj g` is
`monsterLift g`. -/
theorem monsterLift_unique (g : liftableSubgroup) (h : AutVnat)
    (hh : vnatWeightTwoRestrict h = griessConj ((g : AutO) : SpaceB ≃ₗ[ℚ] SpaceB)) :
    h = monsterLift g :=
  vnatWeightTwoRestrict_injective (hh.trans (monsterLift_restrict g).symm)

/-- ⭐ **The lift is injective.** -/
theorem monsterLift_injective : Function.Injective monsterLift := by
  intro g g' hgg'
  have h := congrArg vnatGriessRestrict hgg'
  rw [monsterLift_griessRestrict, monsterLift_griessRestrict] at h
  exact Subtype.ext (griessConjAut_injective h)

/-- When every element of `AutO` lifts: the lift `AutO →* AutVnat`. -/
noncomputable def monsterLiftOfAll (hlift : ∀ g : AutO, IsVnatLiftable g) : AutO →* AutVnat :=
  monsterLift.comp (MonoidHom.codRestrict (MonoidHom.id AutO) liftableSubgroup
    fun g => mem_liftableSubgroup.2 (hlift g))

theorem monsterLiftOfAll_restrict (hlift : ∀ g : AutO, IsVnatLiftable g) (g : AutO) :
    vnatWeightTwoRestrict (monsterLiftOfAll hlift g) = griessConj (g : SpaceB ≃ₗ[ℚ] SpaceB) :=
  monsterLift_restrict _

theorem monsterLiftOfAll_injective (hlift : ∀ g : AutO, IsVnatLiftable g) :
    Function.Injective (monsterLiftOfAll hlift) := by
  intro g g' h
  have := monsterLift_injective h
  exact congrArg Subtype.val this

/-! ## The image of the lift: automorphisms of `V♮` rational on `V♮₂` -/

/-- Two `ℂ`-linear endomorphisms of `V♮₂` agreeing on the rational dictionary are equal
(`griessIso` is onto and `griessIso (a ⊗ u) = a • griessNat u`). -/
theorem linearMap_ext_griessNat {f f' : VnatVOA.grading 2 →ₗ[ℂ] VnatVOA.grading 2}
    (h : ∀ u : SpaceB, f (griessNat u) = f' (griessNat u)) : f = f' := by
  refine LinearMap.ext fun v => ?_
  obtain ⟨x, rfl⟩ := griessIso.surjective v
  induction x using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | add x x' hx hx' => simp only [map_add, hx, hx']
  | tmul a u => rw [griessIso_tmul_smul, map_smul, map_smul, h]

/-- The rational map `SpaceB → SpaceB` induced by an automorphism of `V♮` preserving
`griessNat (SpaceB)`. -/
noncomputable def rationalPart (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') (u : SpaceB) : SpaceB :=
  (hrat u).choose

theorem rationalPart_spec (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') (u : SpaceB) :
    h (griessNat u : Vnat) = griessNat (rationalPart h hrat u) :=
  (hrat u).choose_spec

theorem griessNat_coe_injective {u u' : SpaceB} (h : (griessNat u : Vnat) = griessNat u') : u = u' :=
  griessNat_injective (Subtype.ext h)

theorem autVnat_map_add (h : AutVnat) (x y : Vnat) : h (x + y) = h x + h y :=
  h.toLinearEquiv.map_add x y

theorem autVnat_map_smul (h : AutVnat) (c : ℂ) (x : Vnat) : h (c • x) = c • h x :=
  h.toLinearEquiv.map_smul c x

/-- The rational part is `ℚ`-linear. -/
noncomputable def rationalPartLinear (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') :
    SpaceB →ₗ[ℚ] SpaceB where
  toFun := rationalPart h hrat
  map_add' u v := by
    refine griessNat_coe_injective ?_
    change (griessNat (rationalPart h hrat (u + v)) : Vnat)
      = griessNat (rationalPart h hrat u + rationalPart h hrat v)
    rw [← rationalPart_spec h hrat (u + v), map_add griessNat u v,
      Submodule.coe_add (griessNat u) (griessNat v), autVnat_map_add, rationalPart_spec h hrat u,
      rationalPart_spec h hrat v, map_add griessNat, Submodule.coe_add]
  map_smul' q u := by
    refine griessNat_coe_injective ?_
    change (griessNat (rationalPart h hrat (q • u)) : Vnat) = griessNat (q • rationalPart h hrat u)
    rw [← rationalPart_spec h hrat (q • u), griessNat_smul q u,
      griessNat_smul q (rationalPart h hrat u), Submodule.coe_smul (q : ℂ) (griessNat u),
      autVnat_map_smul, rationalPart_spec h hrat u, Submodule.coe_smul]

theorem rationalPartLinear_injective (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') :
    Function.Injective (rationalPartLinear h hrat) := by
  intro u u' huu'
  refine griessNat_coe_injective (h.toLinearEquiv.injective ?_)
  change h (griessNat u : Vnat) = h (griessNat u' : Vnat)
  rw [rationalPart_spec h hrat, rationalPart_spec h hrat]
  exact congrArg (fun w => (griessNat w : Vnat)) huu'

/-- The rational part as a `ℚ`-linear automorphism of `SpaceB` (an injective endomorphism of a
finite-dimensional space). -/
noncomputable def rationalPartEquiv (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') : SpaceB ≃ₗ[ℚ] SpaceB :=
  LinearEquiv.ofInjectiveEndo _ (rationalPartLinear_injective h hrat)

theorem rationalPartEquiv_spec (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') (u : SpaceB) :
    h (griessNat u : Vnat) = griessNat (rationalPartEquiv h hrat u) :=
  rationalPart_spec h hrat u

/-- The rational part of an automorphism of `V♮` lies in `AutO`. -/
theorem rationalPartEquiv_mem_autO (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') :
    rationalPartEquiv h hrat ∈ AutO := by
  refine mem_AutO.2 ⟨fun u v => griessNat_coe_injective ?_, fun u v => ?_⟩
  · rw [← rationalPartEquiv_spec, griessNat_gmul, griessNat_gmul, VertexOperatorAlgebra.griessMul_coe,
      VertexOperatorAlgebra.griessMul_coe, ← rationalPartEquiv_spec, ← rationalPartEquiv_spec]
    exact Aut.map_smul h _ _ _
  · have h1 := griessNat_form (rationalPartEquiv h hrat u) (rationalPartEquiv h hrat v)
    rw [← rationalPartEquiv_spec, ← rationalPartEquiv_spec, natForm_autRestrict h (griessNat u)
      (griessNat v), griessNat_form] at h1
    have h2 : ((bform (rationalPartEquiv h hrat u) (rationalPartEquiv h hrat v) : ℚ) : ℂ)
        = ((bform u v : ℚ) : ℂ) := by
      have := h1.symm
      rwa [mul_right_inj' two_ne_zero] at this
    exact_mod_cast h2

/-- ⭐ **Rationality criterion**: an automorphism of `V♮` mapping the rational dictionary
`griessNat (SpaceB)` into itself is the lift of an element of `AutO`. -/
theorem isVnatLiftable_of_rational (h : AutVnat)
    (hrat : ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') :
    ∃ g : liftableSubgroup, monsterLift g = h := by
  have hmem : rationalPartEquiv h hrat ∈ AutO := rationalPartEquiv_mem_autO h hrat
  have hrestr : vnatWeightTwoRestrict h = griessConj (rationalPartEquiv h hrat) := by
    refine LinearEquiv.toLinearMap_injective (linearMap_ext_griessNat fun u => ?_)
    apply Subtype.ext
    change h (griessNat u : Vnat) = ((griessConj (rationalPartEquiv h hrat) (griessNat u) :
      VnatVOA.grading 2) : Vnat)
    rw [griessConj_griessNat, rationalPartEquiv_spec]
  have hlift : IsVnatLiftable ⟨rationalPartEquiv h hrat, hmem⟩ := ⟨h, hrestr⟩
  exact ⟨⟨⟨rationalPartEquiv h hrat, hmem⟩, mem_liftableSubgroup.2 hlift⟩,
    (monsterLift_unique ⟨⟨rationalPartEquiv h hrat, hmem⟩, mem_liftableSubgroup.2 hlift⟩ h
      hrestr).symm⟩

/-- ⭐ **The image of the lift is the stabiliser of the rational form**: an automorphism of `V♮` is
`monsterLift g` for some liftable `g` iff it maps `griessNat (SpaceB)` into itself. -/
theorem mem_range_monsterLift_iff (h : AutVnat) :
    h ∈ monsterLift.range ↔ ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u' := by
  rw [MonoidHom.mem_range]
  constructor
  · rintro ⟨g, rfl⟩ u
    exact ⟨_, monsterLift_apply_griessNat g u⟩
  · intro hrat
    exact isVnatLiftable_of_rational h hrat

/-- ⭐ **`Aut V♮ ≃* AutO` from two named inputs**: every element of `AutO` lifts to `V♮` (`hlift`;
generators `Gvis ∪ {τ}` plus `Gmat = AutO`), and every automorphism of `V♮` maps the rational
Griess algebra `griessNat (SpaceB)` into itself (`hrat`; Tits's rationality). -/
theorem autVnat_mulEquiv_autO_of_liftable_of_rational (hlift : ∀ g : AutO, IsVnatLiftable g)
    (hrat : ∀ h : AutVnat, ∀ u : SpaceB, ∃ u' : SpaceB, h (griessNat u : Vnat) = griessNat u') :
    Nonempty (AutVnat ≃* AutO) := by
  have hsurj : Function.Surjective (monsterLiftOfAll hlift) := by
    intro h
    obtain ⟨g, hg⟩ := isVnatLiftable_of_rational h (hrat h)
    refine ⟨(g : AutO), ?_⟩
    rw [← hg]
    rfl
  exact ⟨(MulEquiv.ofBijective _ ⟨monsterLiftOfAll_injective hlift, hsurj⟩).symm⟩

end VOA.Moonshine.MonsterAction
