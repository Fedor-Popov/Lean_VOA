import VOA.Moonshine.HeisenbergTwistedModuleGenerators
import VOA.Core.LocalSystemRegular

/-!
# Locality of the twisted field system generated by the rescaled generators  (Moonshine step M6a)

The reduction `TwistedReduction.twistedJacobi_of_local_pf` has two inputs: mutual locality of the
rescaled fields, and the twisted product formula.  This file discharges the **locality** input
for every rescaled field that can be built from the generators — independently of how the
twisted vertex operator on composite states is eventually defined, as long as the definition
stays inside the system.

The **twisted field system** `TGen S` generated by a set `S ⊆ Fld M` is closed under the
identity field, all integer field products `a₍ₙ₎b` (`Fld.prod`), multiplication by every power
`zᵏ` (`fzmul`, needed because the rescaling `z^{e/N}` shifts by integral powers of `z` when the
offset `e` moves within its class: `resc A N (e + N) = z · resc A N e`, `resc_add_N`), sums,
scalars and `0`.

* `mulBySubPow_zshift`, `Local.zmul_left/right` — locality survives multiplication by `zᵏ`;
* `tgen_local` / `tgenerated_local` — **if `S` is pairwise local, so is everything generated**
  (Dong's lemma for every integer product, `Fld.prod_local_right_of_pairwise`, inside a
  size-indexed strong induction, as in `Core.LocalSystem.gen_local`);
* `Moonshine.twistedSystem_local` — the system generated by the rescaled twisted Heisenberg
  generators `Fgen r a = z^{1/2} h_a(z)` is pairwise local.

## Status
All declarations `sorry`-free; `#print axioms` gives `[propext, Classical.choice, Quot.sound]`.
-/

namespace VOA

open Module (End)

universe u

namespace TwistedReduction

variable {M : Type u} [AddCommGroup M] [Module ℂ M]

/-! ## Multiplication by `zᵏ` -/

/-- Multiplication of a distribution by `zᵏ`: the coefficient of `zⁿ` becomes that of `zⁿ⁻ᵏ`. -/
def zmul (k : ℤ) (a : FormalDist (End ℂ M)) : FormalDist (End ℂ M) := fun n => a (n - k)

@[simp] theorem mode_zmul (k : ℤ) (a : FormalDist (End ℂ M)) (p : ℤ) :
    mode (zmul k a) p = mode a (p + k) := by
  rw [mode_apply, mode_apply, zmul]; congr 1; ring

/-- Moving the offset by `N` multiplies the rescaled field by `z`. -/
theorem resc_add_N (A : ℤ → End ℂ M) (N : ℕ) (e : ℤ) :
    resc A N (e + N) = zmul 1 (resc A N e) := by
  funext n
  simp only [resc, zmul]
  congr 1; ring

theorem isField_zmul {a : FormalDist (End ℂ M)} (ha : IsField a) (k : ℤ) : IsField (zmul k a) := by
  intro x
  obtain ⟨B, hB⟩ := ha x
  exact ⟨B + k, fun n hn => hB (n - k) (by omega)⟩

/-- `(z₁−z₂)ᴺ` commutes with shifting the first variable. -/
theorem mulBySubPow_zshift (k : ℤ) (f : FormalDist₂ (End ℂ M)) (N : ℕ) :
    mulBySubPow N (fun m n => f (m - k) n) = fun m n => mulBySubPow N f (m - k) n := by
  induction N with
  | zero => rfl
  | succ N ih =>
      funext m n
      rw [mulBySubPow_succ, LinearMap.comp_apply, ih, LinearMap.comp_apply,
        mulBySub_apply, mulBySub_apply, show m - 1 - k = m - k - 1 by ring]

theorem Local.zmul_left {a b : FormalDist (End ℂ M)} (h : Local a b) (k : ℤ) :
    Local (zmul k a) b := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N, ?_⟩
  have hb : bracketDist (zmul k a) b = fun m n => bracketDist a b (m - k) n := rfl
  rw [hb, mulBySubPow_zshift, hN]
  rfl

theorem Local.zmul_right {a b : FormalDist (End ℂ M)} (h : Local a b) (k : ℤ) :
    Local a (zmul k b) :=
  (Local.zmul_left h.symm k).symm

/-- `zᵏ ·` on the field space. -/
def fzmul (k : ℤ) (a : Fld M) : Fld M := ⟨zmul k a.1, isField_zmul a.2 k⟩

@[simp] theorem fzmul_val (k : ℤ) (a : Fld M) : (fzmul k a).1 = zmul k a.1 := rfl

/-! ## The generated twisted system and its locality -/

/-- `TGen S i a`: the field `a` is built from `S` by `i` operations among the identity field,
`0`, integer field products, multiplication by `zᵏ`, sums and scalars. -/
inductive TGen (S : Set (Fld M)) : ℕ → Fld M → Prop
  | base {a : Fld M} : a ∈ S → TGen S 0 a
  | one : TGen S 0 Fld.one
  | zero : TGen S 0 0
  | prod {i j : ℕ} {a b : Fld M} (n : ℤ) : TGen S i a → TGen S j b →
      TGen S (i + j + 1) (Fld.prod n a b)
  | zmul {i : ℕ} {a : Fld M} (k : ℤ) : TGen S i a → TGen S (i + 1) (fzmul k a)
  | add {i j : ℕ} {a b : Fld M} : TGen S i a → TGen S j b → TGen S (i + j + 1) (a + b)
  | smul {i : ℕ} {a : Fld M} (c : ℂ) : TGen S i a → TGen S (i + 1) (c • a)

/-- The atoms of the generated system. -/
def IsAtom (S : Set (Fld M)) (a : Fld M) : Prop := a ∈ S ∨ a = Fld.one ∨ a = 0

theorem local_zero_left (b : FormalDist (End ℂ M)) : Local (0 : FormalDist (End ℂ M)) b :=
  Reconstruction.Local.zero_left b

theorem atom_local {S : Set (Fld M)} (hS : ∀ a ∈ S, ∀ b ∈ S, Local a.1 b.1) {a b : Fld M}
    (ha : IsAtom S a) (hb : IsAtom S b) : Local a.1 b.1 := by
  rcases ha with ha | rfl | rfl
  · rcases hb with hb | rfl | rfl
    · exact hS a ha b hb
    · exact Local_idField_right _
    · exact (local_zero_left _).symm
  · exact Local_idField_left _
  · exact local_zero_left _

/-- **The twisted system generated by a pairwise-local family is pairwise local.** -/
theorem tgen_local (S : Set (Fld M)) (hS : ∀ a ∈ S, ∀ b ∈ S, Local a.1 b.1) :
    ∀ (N i j : ℕ) (a b : Fld M), i + j ≤ N → TGen S i a → TGen S j b → Local a.1 b.1 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro i j a b hij ha hb
    -- the case of an atomic right factor: peel the left factor
    have hA : ∀ b' : Fld M, TGen S 0 b' → IsAtom S b' → i ≤ N → Local a.1 b'.1 := by
      intro b' hb' hat hi
      cases ha with
      | @prod i₁ i₂ a₁ a₂ n ha₁ ha₂ =>
          exact Fld.prod_local_right_of_pairwise
            (ih (i₁ + i₂) (by omega) i₁ i₂ a₁ a₂ le_rfl ha₁ ha₂)
            (ih (i₁ + 0) (by omega) i₁ 0 a₁ b' le_rfl ha₁ hb')
            (ih (i₂ + 0) (by omega) i₂ 0 a₂ b' le_rfl ha₂ hb') n
      | @zmul i₁ a₁ k ha₁ =>
          exact Local.zmul_left (ih (i₁ + 0) (by omega) i₁ 0 a₁ b' le_rfl ha₁ hb') k
      | @add i₁ i₂ a₁ a₂ ha₁ ha₂ =>
          exact VertexOperatorAlgebra.Local.add
            (ih (i₁ + 0) (by omega) i₁ 0 a₁ b' le_rfl ha₁ hb')
            (ih (i₂ + 0) (by omega) i₂ 0 a₂ b' le_rfl ha₂ hb')
      | @smul i₁ a₁ c ha₁ =>
          exact VertexOperatorAlgebra.Local.smul' c
            (ih (i₁ + 0) (by omega) i₁ 0 a₁ b' le_rfl ha₁ hb')
      | base haS => exact atom_local hS (Or.inl haS) hat
      | one => exact atom_local hS (Or.inr (Or.inl rfl)) hat
      | zero => exact atom_local hS (Or.inr (Or.inr rfl)) hat
    cases hb with
    | @prod j₁ j₂ b₁ b₂ n hb₁ hb₂ =>
        exact (Fld.prod_local_right_of_pairwise
          (ih (j₁ + j₂) (by omega) j₁ j₂ b₁ b₂ le_rfl hb₁ hb₂)
          (ih (j₁ + i) (by omega) j₁ i b₁ a le_rfl hb₁ ha)
          (ih (j₂ + i) (by omega) j₂ i b₂ a le_rfl hb₂ ha) n).symm
    | @zmul j₁ b₁ k hb₁ =>
        exact Local.zmul_right (ih (i + j₁) (by omega) i j₁ a b₁ le_rfl ha hb₁) k
    | @add j₁ j₂ b₁ b₂ hb₁ hb₂ =>
        exact (VertexOperatorAlgebra.Local.add
          (ih (j₁ + i) (by omega) j₁ i b₁ a le_rfl hb₁ ha)
          (ih (j₂ + i) (by omega) j₂ i b₂ a le_rfl hb₂ ha)).symm
    | @smul j₁ b₁ c hb₁ =>
        exact (VertexOperatorAlgebra.Local.smul' c
          (ih (j₁ + i) (by omega) j₁ i b₁ a le_rfl hb₁ ha)).symm
    | base hbS => exact hA _ (TGen.base hbS) (Or.inl hbS) (by omega)
    | one => exact hA _ TGen.one (Or.inr (Or.inl rfl)) (by omega)
    | zero => exact hA _ TGen.zero (Or.inr (Or.inr rfl)) (by omega)

/-- The generated twisted system, forgetting the size. -/
def TGenerated (S : Set (Fld M)) : Set (Fld M) := {a | ∃ i, TGen S i a}

/-- **Pairwise locality of the generated twisted system.** -/
theorem tgenerated_local {S : Set (Fld M)} (hS : ∀ a ∈ S, ∀ b ∈ S, Local a.1 b.1)
    {a b : Fld M} (ha : a ∈ TGenerated S) (hb : b ∈ TGenerated S) : Local a.1 b.1 := by
  obtain ⟨i, ha⟩ := ha
  obtain ⟨j, hb⟩ := hb
  exact tgen_local S hS (i + j) i j a b le_rfl ha hb

theorem subset_tgenerated {S : Set (Fld M)} : S ⊆ TGenerated S := fun _ h => ⟨0, TGen.base h⟩

theorem one_mem_tgenerated (S : Set (Fld M)) : (Fld.one : Fld M) ∈ TGenerated S := ⟨0, TGen.one⟩

theorem zero_mem_tgenerated (S : Set (Fld M)) : (0 : Fld M) ∈ TGenerated S := ⟨0, TGen.zero⟩

theorem prod_mem_tgenerated {S : Set (Fld M)} {a b : Fld M} (n : ℤ)
    (ha : a ∈ TGenerated S) (hb : b ∈ TGenerated S) : Fld.prod n a b ∈ TGenerated S := by
  obtain ⟨i, ha⟩ := ha; obtain ⟨j, hb⟩ := hb
  exact ⟨i + j + 1, TGen.prod n ha hb⟩

theorem fzmul_mem_tgenerated {S : Set (Fld M)} {a : Fld M} (k : ℤ) (ha : a ∈ TGenerated S) :
    fzmul k a ∈ TGenerated S := by
  obtain ⟨i, ha⟩ := ha
  exact ⟨i + 1, TGen.zmul k ha⟩

theorem add_mem_tgenerated {S : Set (Fld M)} {a b : Fld M}
    (ha : a ∈ TGenerated S) (hb : b ∈ TGenerated S) : a + b ∈ TGenerated S := by
  obtain ⟨i, ha⟩ := ha; obtain ⟨j, hb⟩ := hb
  exact ⟨i + j + 1, TGen.add ha hb⟩

theorem smul_mem_tgenerated {S : Set (Fld M)} {a : Fld M} (c : ℂ) (ha : a ∈ TGenerated S) :
    c • a ∈ TGenerated S := by
  obtain ⟨i, ha⟩ := ha
  exact ⟨i + 1, TGen.smul c ha⟩

end TwistedReduction

namespace Moonshine

open TwistedHeisenberg TwistedReduction

variable (r : ℕ)

/-- The rescaled twisted Heisenberg generators `{Fgen r a}`. -/
def genSet : Set (Fld (FockT r)) := Set.range (FgenFld r)

/-- **The twisted field system generated by the rescaled twisted Heisenberg generators is
pairwise local.**  Every rescaled twisted vertex operator assembled from the `Fgen r a` by field
products, powers of `z`, sums and scalars is mutually local with every other one — the locality
input of `TwistedReduction.twistedJacobi_of_local_pf`. -/
theorem twistedSystem_local {a b : Fld (FockT r)} (ha : a ∈ TGenerated (genSet r))
    (hb : b ∈ TGenerated (genSet r)) : Local a.1 b.1 := by
  refine tgenerated_local ?_ ha hb
  rintro _ ⟨c, rfl⟩ _ ⟨d, rfl⟩
  exact Fgen_local r c d

end Moonshine

end VOA
