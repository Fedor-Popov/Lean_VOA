import VOA.Moonshine.TopPairs
import VOA.Core.Automorphism
import VOA.Core.GriessAutomorphism

/-!
# The named Moonshine VOA `VnatVOA` and its automorphism group  (Aut(V♮) campaign, step 1)

`Moonshine.moonshine` is an existential statement.  To speak about `Aut(V♮)` we need the VOA
itself.  The vertex operator algebra `VnatAxioms.vnatVOA htt` packages the block vertex map `YN`;
its only hypothesis is twisted × twisted locality `htt`.  The unconditional chain behind
`moonshine` proves `htt` for the explicit triality data (`ε = +1`), but only inside the
existential.  This file extracts it.

## Main results
* ⭐ `vnat_twistedLocality` — `Local (YnatT leechWbar t) (YnatT leechWbar t')` for all `t, t' ∈ TP`,
  unconditionally: the σ-key of the standard data (`sigmaKey_of_top`, fed by `topPairs_one`)
  gives DGM (4.23) for every pair (`tpBlockLocal_of_sigma`), the untwisted blocks are local
  (`leechWbar_VPBlockLocal`), and locality on the frame cyclic vectors propagates to all of `TP`
  (`YnatT_local_all_of_gen`).
* ⭐ `VnatVOA : VertexOperatorAlgebra Vnat` — the Moonshine module, no hypotheses.
* `VnatVOA_Y`, `VnatVOA_vacuum`, `VnatVOA_conformalVector`, `VnatVOA_grading`,
  `VnatVOA_isSimple`, `VnatVOA_grading_one`, `VnatVOA_finrank_two`.
* `AutVnat := Aut VnatVOA` — the group the campaign identifies with the Monster
  (`Notes/MONSTER_AUT_PLAN.md`).
* `vnat_griessMul_comm`, `GriessAutVnat`, ⭐ `vnatGriessRestrict : AutVnat →* GriessAutVnat`,
  ⭐ `vnatGriessRestrict_injective_of_gen` (faithfulness from generation by `V♮₂`).
-/

set_option linter.style.longLine false

namespace VOA.Moonshine.AutMonster

open VOA.Moonshine VOA.Moonshine.SigmaAssemble VOA.Moonshine.SigmaKey VOA.Moonshine.M8hKey
open VOA.Moonshine.M8h0 VOA.Moonshine.VnatAxioms VOA.Moonshine.SigmaExist

/-- The standard triality data `D(c⋆, +1)` used by the unconditional `Moonshine.moonshine`. -/
noncomputable abbrev Dnat : SigmaData :=
  mkData cStar0 1 (c_ne_of_norm cStar0_norm) (by norm_num)

/-- The σ-key of the standard data: the content of `Moonshine.moonshine`, extracted. -/
theorem sigmaKey_Dnat : SigmaKey Dnat β₂ tF :=
  sigmaKey_of_top Dnat β₂_not_mem tF_mem tF_ne
    (phiTop_of_phiIso _ (phiIso_mkData cStar0_norm (by norm_num)) (tF_mem _))
    (thetaTop_mkData _ _ _ (by norm_num))
    (FZKey.keySkew_of_FZ _ tF_mem tF_ne FZGen.fzGenerated_MV3 topPairs_one)

/-- ⭐ **Twisted × twisted locality on `TP = (V_Λ^T)⁺`, unconditionally.** -/
theorem vnat_twistedLocality (t t' : TP) : Local (YnatT leechWbar t) (YnatT leechWbar t') := by
  obtain ⟨x, -, hspan⟩ := exists_frame_modeSpan
  have htt0 : ∀ i j, Local (YnatT leechWbar (x i)) (YnatT leechWbar (x j)) := fun i j =>
    (YnatT_local_iff _ _ _).2 ⟨leechWbar_VPBlockLocal _ _, tpBlockLocal_of_sigma sigmaKey_Dnat _ _⟩
  exact YnatT_local_all_of_gen hspan htt0 t t'

/-- ⭐ **The Moonshine module `V♮`** as a named vertex operator algebra (no hypotheses). -/
noncomputable def VnatVOA : VertexOperatorAlgebra Vnat := vnatVOA vnat_twistedLocality

theorem VnatVOA_Y : VnatVOA.Y = Ynat wbarL := rfl

theorem VnatVOA_vacuum : VnatVOA.vacuum = vacNat := rfl

theorem VnatVOA_conformalVector : VnatVOA.conformalVector = omegaNat := rfl

theorem VnatVOA_grading : VnatVOA.grading = gradingNat := rfl

theorem VnatVOA_isSimple : VnatVOA.IsSimple :=
  SimpleNat.vnatVOA_isSimple vnat_twistedLocality

theorem VnatVOA_grading_one : VnatVOA.grading 1 = ⊥ := gradingNat_one

theorem VnatVOA_finrank_two : Module.finrank ℂ (VnatVOA.grading 2) = 196884 :=
  finrank_gradingNat_two

/-- The automorphism group of `V♮`; the campaign's target is `AutVnat ≃* 𝕄`. -/
abbrev AutVnat : Type := Aut VnatVOA

theorem VnatVOA_vacuum_ne_zero : VnatVOA.vacuum ≠ 0 :=
  SimpleNat.vnatVOA_vacuum_ne_zero vnat_twistedLocality

/-! ## The Griess algebra of `V♮` (campaign step 2) -/

/-- The Griess product on `V♮₂` is commutative (`V♮₁ = 0`). -/
theorem vnat_griessMul_comm (u v : VnatVOA.grading 2) :
    VnatVOA.griessMul u v = VnatVOA.griessMul v u :=
  VertexOperatorAlgebra.griessMul_comm_of_grading1_eq_bot _ VnatVOA_grading_one u v

/-- The automorphism group of the Griess algebra `(V♮₂, ×, ⟨·,·⟩₃)`. -/
noncomputable abbrev GriessAutVnat := GriessAut.griessAut VnatVOA_vacuum_ne_zero

/-- ⭐ Every automorphism of `V♮` acts on the Griess algebra. -/
noncomputable def vnatGriessRestrict : AutVnat →* GriessAutVnat :=
  GriessAut.griessRestrict VnatVOA_vacuum_ne_zero

/-- ⭐ **Faithfulness, reduced to generation**: if `V♮` is generated by `V♮₂`, then `Aut V♮`
embeds in the automorphism group of the Griess algebra. -/
theorem vnatGriessRestrict_injective_of_gen (hgen : GriessAut.GeneratedByWeightTwo VnatVOA) :
    Function.Injective vnatGriessRestrict :=
  GriessAut.griessRestrict_injective _ hgen

end VOA.Moonshine.AutMonster
