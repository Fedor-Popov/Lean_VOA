import VOA.Moonshine.LatticeTwistedTwoPoint
import VOA.Moonshine.HeisenbergTwistedModuleLocality
import VOA.Moonshine.ExtraspecialModule
import VOA.Moonshine.LatticeInvolution

/-!
# The twisted vertex operators `Y^T(e^α, z)` on `S[θ] ⊗ T` and their locality  (Moonshine step M6c)

FLM ch. 9: for an even unimodular positive-definite lattice `L` with orthonormal coordinates
`chargeCoord L α`, the `θ`-twisted vertex operator of `e^α` on `V_L^T = S[θ] ⊗ T` is

  `Y^T(e^α, z) = 2^{−⟨α,α⟩} z^{−⟨α,α⟩/2} E⁻(−α, z) E⁺(−α, z) ⊗ e_α`,

`T` the extraspecial module (`ExtraspecialModule.lean`, `e_α` = `eT L hEven hU α`).  In the
fractional-mode carrier of `Modularity/Twisted.lean` (`YM u k = u₍k/2₎`, coefficient of
`z^{−k/2−1} = w^{−k−2}`, `w = z^{1/2}`) its `k`-th mode is
`2^{−⟨α,α⟩} · DD α (−k − 2 + ⟨α,α⟩) ⊗ e_α` (`YTL`), with `DD` the dressing of
`LatticeTwistedEOps`.  The normalization `2^{−⟨α,α⟩}` is the one compatible with
`e^α₍₋⟨α,β⟩₋₁₎ e^β = ε(α,β) e^{α+β}` (leading order of the twisted product formula); it plays no
role in the locality statements below.

## Main results (generic charge `v`, shift `c₀`, scalar `κ`, operator `g` on `T`)
* `YTg`, `YTg_tmul`, `YTg_truncation` — the modes and lower truncation.
* `rTensor_modeT_comm_YTg` — `[h_i(K/2) ⊗ 1, Y^T_k] = vᵢ Y^T_{k+K}` (FLM: `[α(m), Y^T(e^β,z)] =
  ⟨α,β⟩ z^m Y^T(e^β,z)`).
* `YTg_local` — **twisted locality of the exponential fields**: if `⟨v,u⟩ = n ∈ ℤ` and
  `g' g = (−1)ⁿ g g'`, then on every pair of residue classes the rescaled fields are mutually
  local of order `|n|` (from `DD_bracket_local`).
* `FgenT`, `FgenT_local`, `FgenT_YTg_local` — the twisted Heisenberg generators on `S[θ] ⊗ T` are
  local with each other (order 2) and with every exponential field (order 1); the OPE
  `bracketDist_FgenT_YTg` (`[Fgen_a(z₁), Ỹ_e(z₂)] = vₐ δ · Ỹ_{e+1}(z₂)`).
* `YTg_neg`, `YTg_zero_charge` — charge conjugation and the zero charge.

## The lattice specialization
* `YTL L hEven hU α` — `Y^T(e^α)`; `YTL_neg` — `Y^T(e^{−α})_k = (−1)^k Y^T(e^α)_k`, the
  `θ`-compatibility (`θ e^α = e^{−α}` in `V_L`, `e_{−α} = e_α` on `T`), which makes the modes of
  the `θ`-eigenvectors `e^α ± e^{−α}` vanish off the right parity class.
* `YTL_add_neg_of_odd`, `YTL_sub_neg_of_even` — the support condition for `e^α ± e^{−α}`;
  `YTL_zero` — `Y^T(e^0) = id` (`δ_{k,−2}`).
* `YTL_local` — all `Y^T(e^α)`, `Y^T(e^β)` rescaled fields are mutually local.
* `prod_FgenTFld_YTLFld_zero` / `_pos` — `Fgen_a ₍₀₎ Ỹ(e^β)_e = βₐ Ỹ(e^β)_{e+1}`, higher products
  vanish (the field-level form of `h_a(0) e^β = βₐ e^β`, `h_a(n > 0) e^β = 0`).
* `latticeTwistedSystem_local` — the twisted field system generated by
  `{z^{1/2} h_a(z)} ∪ {resc Y^T(e^α) on every class}` is pairwise local: the **locality input**
  of the reduction `TwistedReduction.twistedJacobi_of_local_pf` for the lattice twisted module;
  `leechTwistedSystem_local` for `L = Λ` (`T` of dimension `4096`).

## Status
All declarations `sorry`-free; `#print axioms` gives `[propext, Classical.choice, Quot.sound]`.
**Not done in this file, done downstream:** the twisted vertex operator on composite states of
`V_L` (`YML`, `LatticeTwistedFields.lean`), the twisted product formula (`PF_all`,
`LatticeTwistedBaseCase.lean`), the Jacobi identity (`twistedJacobi_YML`) and the instance
`leechTwistedModule : TwistedModule leechTheta 2 (FockT 24 ⊗ T)` (`LatticeTwistedModule.lean`).
-/

namespace VOA.Moonshine.LatticeTwisted

open MvPolynomial TwistedHeisenberg TwistedReduction
open Module (End)
open scoped BigOperators TensorProduct

variable {r : ℕ} {Tm : Type*} [AddCommGroup Tm] [Module ℂ Tm]

/-! ## Vanishing of the dressing -/

theorem DD_eq_zero_of_le (v : Fin r → ℂ) (y : FockT r) {Q : ℕ}
    (hQ : ∀ q, Q ≤ q → EpC v q y = 0) {a : ℤ} (ha : a + Q ≤ 0) : DD v a y = 0 := by
  rw [DD_apply_range v a y Q hQ]
  refine Finset.sum_eq_zero fun q hq => ?_
  rw [Finset.mem_range] at hq
  rw [sMz_of_neg v (by omega), zero_mul]

/-! ## The generic twisted exponential field on `S[θ] ⊗ T` -/

/-- The modes `k ↦ u₍k/2₎` of `κ w^{−c₀} E⁻(−v,w)E⁺(−v,w) ⊗ g`. -/
noncomputable def YTg (v : Fin r → ℂ) (c0 : ℤ) (κ : ℂ) (g : End ℂ Tm) (k : ℤ) :
    End ℂ (FockT r ⊗[ℂ] Tm) :=
  κ • TensorProduct.map (DD v (-k - 2 + c0)) g

theorem YTg_tmul (v : Fin r → ℂ) (c0 : ℤ) (κ : ℂ) (g : End ℂ Tm) (k : ℤ) (y : FockT r) (t : Tm) :
    YTg v c0 κ g k (y ⊗ₜ t) = κ • (DD v (-k - 2 + c0) y ⊗ₜ g t) := by
  rw [YTg, LinearMap.smul_apply, TensorProduct.map_tmul]

/-- **Lower truncation** of the twisted exponential field. -/
theorem YTg_truncation (v : Fin r → ℂ) (c0 : ℤ) (κ : ℂ) (g : End ℂ Tm)
    (x : FockT r ⊗[ℂ] Tm) : ∃ K : ℤ, ∀ k : ℤ, K ≤ k → YTg v c0 κ g k x = 0 := by
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨0, fun k _ => map_zero _⟩
  | tmul y t =>
    obtain ⟨Q, hQ⟩ := EpC_eventually_zero v y
    refine ⟨c0 + Q, fun k hk => ?_⟩
    rw [YTg_tmul, DD_eq_zero_of_le v y hQ (by omega), TensorProduct.zero_tmul, smul_zero]
  | add x₁ x₂ h₁ h₂ =>
    obtain ⟨K₁, hK₁⟩ := h₁
    obtain ⟨K₂, hK₂⟩ := h₂
    exact ⟨max K₁ K₂, fun k hk => by
      rw [map_add, hK₁ k (le_of_max_le_left hk), hK₂ k (le_of_max_le_right hk), add_zero]⟩

/-- **The twisted oscillators against the exponential field**:
`[h_i(K/2) ⊗ 1, Y^T_k] = vᵢ · Y^T_{k+K}` for odd `K`. -/
theorem rTensor_modeT_comm_YTg (v : Fin r → ℂ) (c0 : ℤ) (κ : ℂ) (g : End ℂ Tm) (i : Fin r)
    {K : ℤ} (hK : Odd K) (k : ℤ) :
    (modeT r i K).rTensor Tm * YTg v c0 κ g k - YTg v c0 κ g k * (modeT r i K).rTensor Tm
      = v i • YTg v c0 κ g (k + K) := by
  refine TensorProduct.ext' fun y t => ?_
  rw [LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply, YTg_tmul,
    LinearMap.rTensor_tmul, YTg_tmul, LinearMap.smul_apply, YTg_tmul, map_smul,
    LinearMap.rTensor_tmul, ← smul_sub, ← TensorProduct.sub_tmul]
  have h := congrArg (fun f : End ℂ (FockT r) => f y) (modeT_comm_DD v i hK (-k - 2 + c0))
  simp only [LinearMap.sub_apply, Module.End.mul_apply, LinearMap.smul_apply] at h
  rw [h, ← TensorProduct.smul_tmul', smul_comm,
    show -k - 2 + c0 - K = -(k + K) - 2 + c0 by ring]

/-! ## Locality of the exponential fields -/

theorem neg_one_zpow_eq_pow_natAbs (n : ℤ) : (-1 : ℂ) ^ n = (-1 : ℂ) ^ n.natAbs := by
  rcases Int.natAbs_eq n with h | h
  · rw [h, zpow_natCast, Int.natAbs_natCast]
  · rw [h, zpow_neg, zpow_natCast, Int.natAbs_neg, Int.natAbs_natCast, ← inv_pow, inv_neg, inv_one]

theorem resc_two_apply (A : ℤ → End ℂ (FockT r ⊗[ℂ] Tm)) (e n : ℤ) :
    resc A 2 e n = A (2 * (-n - 1) + e) := by
  simp only [resc]; push_cast; rfl

/-- The commutator of two exponential fields on a pure tensor. -/
theorem YTg_bracket_tmul (v u : Fin r → ℂ) (c0 c0' : ℤ) (κ κ' : ℂ) (g g' : End ℂ Tm) (s : ℂ)
    (hg : g' * g = s • (g * g')) (k₁ k₂ : ℤ) (y : FockT r) (t : Tm) :
    (YTg v c0 κ g k₁ * YTg u c0' κ' g' k₂ - YTg u c0' κ' g' k₂ * YTg v c0 κ g k₁) (y ⊗ₜ t)
      = (κ * κ') • ((DD v (-k₁ - 2 + c0) (DD u (-k₂ - 2 + c0') y)
          - s • DD u (-k₂ - 2 + c0') (DD v (-k₁ - 2 + c0) y)) ⊗ₜ g (g' t)) := by
  have hgt : g' (g t) = s • g (g' t) := by
    rw [← Module.End.mul_apply, hg]; rfl
  rw [LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply, YTg_tmul, map_smul,
    YTg_tmul, YTg_tmul, map_smul, YTg_tmul, hgt]
  simp only [TensorProduct.tmul_smul, TensorProduct.sub_tmul, ← TensorProduct.smul_tmul']
  module

/-- **Twisted locality of the exponential fields.**  If `⟨v,u⟩ = n ∈ ℤ` and the `T`-operators
satisfy `g' g = (−1)ⁿ g g'`, then on any residue classes `e, e'` the rescaled fields are
mutually local, of order `|n|`. -/
theorem YTg_local (v u : Fin r → ℂ) (n : ℤ) (hn : pair v u = n) (c0 c0' : ℤ) (κ κ' : ℂ)
    (g g' : End ℂ Tm) (hg : g' * g = (-1 : ℂ) ^ n.natAbs • (g * g')) (e e' : ℤ) :
    Local (resc (YTg v c0 κ g) 2 e) (resc (YTg u c0' κ' g') 2 e') := by
  refine ⟨n.natAbs, ?_⟩
  funext m m'
  change _ = (0 : End ℂ (FockT r ⊗[ℂ] Tm))
  rw [mulBySubPow_apply_sum]
  refine TensorProduct.ext' fun y t => ?_
  rw [LinearMap.sum_apply, LinearMap.zero_apply]
  set N := n.natAbs with hN
  set A : ℤ := 2 * m - e + c0
  set B : ℤ := 2 * m' - e' + c0'
  have key : ∀ q ∈ Finset.range (N + 1),
      ((((-1 : ℤ) ^ (N - q)) * (N.choose q : ℤ)) •
        bracketDist (resc (YTg v c0 κ g) 2 e) (resc (YTg u c0' κ' g') 2 e')
          (m - q) (m' - ((N - q : ℕ) : ℤ))) (y ⊗ₜ t)
      = ((κ * κ') • (((-1 : ℂ) ^ (N - q) * (N.choose q : ℂ)) •
          (DD v (A - 2 * q) (DD u (B - 2 * (N - q : ℕ)) y)
            - (-1 : ℂ) ^ n.natAbs • DD u (B - 2 * (N - q : ℕ)) (DD v (A - 2 * q) y))))
          ⊗ₜ g (g' t) := by
    intro q _
    rw [← Int.cast_smul_eq_zsmul ℂ, LinearMap.smul_apply, bracketDist_apply, resc_two_apply,
      resc_two_apply, YTg_bracket_tmul v u c0 c0' κ κ' g g' _ hg,
      show -(2 * (-(m - (q : ℤ)) - 1) + e) - 2 + c0 = A - 2 * q by ring,
      show -(2 * (-(m' - ((N - q : ℕ) : ℤ)) - 1) + e') - 2 + c0' = B - 2 * (N - q : ℕ) by ring,
      ← TensorProduct.smul_tmul', ← TensorProduct.smul_tmul', smul_comm]
    push_cast
    rfl
  rw [Finset.sum_congr rfl key, ← TensorProduct.sum_tmul, ← Finset.smul_sum,
    DD_bracket_local v u n hn N (by omega) (by omega) A B y, smul_zero, TensorProduct.zero_tmul]

/-! ## The twisted Heisenberg generators on `S[θ] ⊗ T` -/

/-- Coefficientwise application of an additive map commutes with `(z₁ − z₂)ᴺ`. -/
theorem mulBySubPow_map {M M' : Type*} [AddCommGroup M] [Module ℂ M] [AddCommGroup M']
    [Module ℂ M'] (φ : End ℂ M → End ℂ M') (hφ : ∀ a b, φ (a - b) = φ a - φ b)
    (H : FormalDist₂ (End ℂ M)) (N : ℕ) :
    mulBySubPow N (fun m n => φ (H m n)) = fun m n => φ (mulBySubPow N H m n) := by
  induction N with
  | zero => rfl
  | succ N ih =>
    funext m n
    simp only [mulBySubPow_succ, LinearMap.comp_apply, mulBySub_apply, ih]
    exact (hφ _ _).symm

/-- Locality survives `− ⊗ 1`. -/
theorem Local.rTensor {a b : FormalDist (End ℂ (FockT r))} (h : Local a b) :
    Local (fun n => (a n).rTensor Tm) (fun n => (b n).rTensor Tm) := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N, ?_⟩
  have hb : bracketDist (fun n => (a n).rTensor Tm) (fun n => (b n).rTensor Tm)
      = fun m n => (bracketDist a b m n).rTensor Tm := by
    funext m n
    rw [bracketDist_apply, bracketDist_apply, LinearMap.rTensor_sub, LinearMap.rTensor_mul,
      LinearMap.rTensor_mul]
  rw [hb, mulBySubPow_map (fun f => f.rTensor Tm) (fun f g => LinearMap.rTensor_sub f g), hN]
  funext m n
  exact LinearMap.rTensor_zero Tm

/-- The twisted Heisenberg modes `h_a(k/2) ⊗ 1` on `S[θ] ⊗ T`. -/
noncomputable def modeTT (a : Fin r) (k : ℤ) : End ℂ (FockT r ⊗[ℂ] Tm) := (modeT r a k).rTensor Tm

theorem modeTT_truncation (a : Fin r) (x : FockT r ⊗[ℂ] Tm) :
    ∃ K : ℤ, ∀ k : ℤ, K ≤ k → modeTT (Tm := Tm) a k x = 0 := by
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨0, fun k _ => map_zero _⟩
  | tmul y t =>
    obtain ⟨K, hK⟩ := Moonshine.modeT_truncation r a y
    exact ⟨K, fun k hk => by
      rw [modeTT, LinearMap.rTensor_tmul, hK k hk, TensorProduct.zero_tmul]⟩
  | add x₁ x₂ h₁ h₂ =>
    obtain ⟨K₁, hK₁⟩ := h₁
    obtain ⟨K₂, hK₂⟩ := h₂
    exact ⟨max K₁ K₂, fun k hk => by
      rw [map_add, hK₁ k (le_of_max_le_left hk), hK₂ k (le_of_max_le_right hk), add_zero]⟩

/-- The rescaled generator `z^{1/2} h_a(z) ⊗ 1`. -/
noncomputable def FgenT (a : Fin r) : FormalDist (End ℂ (FockT r ⊗[ℂ] Tm)) :=
  resc (modeTT (Tm := Tm) a) 2 1

/-- The generators on `S[θ] ⊗ T` are mutually local (order `2`). -/
theorem FgenT_local (a b : Fin r) : Local (FgenT (Tm := Tm) a) (FgenT (Tm := Tm) b) :=
  Local.rTensor (Moonshine.Fgen_local r a b)

/-- **The generators are local with every exponential field** (order `1`): the commutator
`[h_a(z₁), Y^T(e^β, z₂)]` is a multiple of `δ(z₁/z₂)`. -/
theorem FgenT_YTg_local (a : Fin r) (v : Fin r → ℂ) (c0 : ℤ) (κ : ℂ) (g : End ℂ Tm) (e : ℤ) :
    Local (FgenT (Tm := Tm) a) (resc (YTg v c0 κ g) 2 e) := by
  refine ⟨1, ?_⟩
  rw [mulBySubPow_one]
  funext m n
  rw [mulBySub_apply, bracketDist_apply, bracketDist_apply]
  simp only [FgenT, resc_two_apply, modeTT]
  rw [rTensor_modeT_comm_YTg v c0 κ g a ⟨-m, by ring⟩,
    rTensor_modeT_comm_YTg v c0 κ g a ⟨-m - 1, by ring⟩]
  rw [show 2 * (-(n : ℤ) - 1) + e + (2 * (-(m - 1) - 1) + 1)
      = 2 * (-(n - 1) - 1) + e + (2 * (-m - 1) + 1) by ring, sub_self]
  rfl

/-- **The generator–exponential OPE**: `[z₁^{1/2}h_a(z₁), z₂^{e/2}Y^T(z₂)] = vₐ δ(z₁/z₂) ·
z₂^{(e+1)/2}Y^T(z₂)`, i.e. the bracket is `deltaDeriv 0` of the rescaled field on the next class. -/
theorem bracketDist_FgenT_YTg (a : Fin r) (v : Fin r → ℂ) (c0 : ℤ) (κ : ℂ) (g : End ℂ Tm)
    (e : ℤ) :
    bracketDist (FgenT (Tm := Tm) a) (resc (YTg v c0 κ g) 2 e)
      = deltaDeriv 0 (v a • resc (YTg v c0 κ g) 2 (e + 1)) := by
  funext m n
  rw [bracketDist_apply, deltaDeriv_apply, Finset.range_zero, Finset.prod_empty, one_smul]
  simp only [FgenT, resc_two_apply, modeTT]
  rw [rTensor_modeT_comm_YTg v c0 κ g a ⟨-m - 1, by ring⟩]
  change _ = v a • YTg v c0 κ g (2 * (-(m + n + 1 + ((0 : ℕ) : ℤ)) - 1) + (e + 1))
  congr 2
  push_cast
  ring

/-! ## The lattice specialization -/

section Lattice

open IntegralLattice LatGen Extraspecial

variable (L : IntegralLattice) (hEven : L.Even) (hU : IsUnit (gramMat L).det)

/-- **The twisted vertex operator of `e^α`** on `S[θ] ⊗ T_L`:
`Y^T(e^α)₍k/2₎ = 2^{−⟨α,α⟩} · DD α (−k − 2 + ⟨α,α⟩) ⊗ e_α`. -/
noncomputable def YTL (α : L.carrier) (k : ℤ) :
    End ℂ (FockT (rank L) ⊗[ℂ] Rep (cocMat L) (isUnit_det_cocMat L hEven hU)) :=
  YTg (chargeCoord L α) (L.form α α) ((2 : ℂ) ^ (-(L.form α α))) (eT L hEven hU α) k

theorem YTL_truncation (α : L.carrier)
    (x : FockT (rank L) ⊗[ℂ] Rep (cocMat L) (isUnit_det_cocMat L hEven hU)) :
    ∃ K : ℤ, ∀ k : ℤ, K ≤ k → YTL L hEven hU α k x = 0 :=
  YTg_truncation _ _ _ _ x

/-- The commutation of the `T`-operators: `e_β e_α = (−1)^{⟨α,β⟩} e_α e_β`. -/
theorem eT_swap (α β : L.carrier) :
    eT L hEven hU β * eT L hEven hU α
      = (-1 : ℂ) ^ (L.form α β).natAbs • (eT L hEven hU α * eT L hEven hU β) := by
  rw [eT_mul, eT_mul, latticeCocycle_swap_sign L hEven β α, add_comm β α, mul_smul,
    form_symm L β α, neg_one_zpow_eq_pow_natAbs]

/-- **Locality of the twisted lattice vertex operators**: for all `α, β ∈ L` and all residue
classes, the rescaled fields of `Y^T(e^α)` and `Y^T(e^β)` are mutually local
(of order `|⟨α,β⟩|`). -/
theorem YTL_local (hPos : L.PosDef) (α β : L.carrier) (e e' : ℤ) :
    Local (resc (YTL L hEven hU α) 2 e) (resc (YTL L hEven hU β) 2 e') :=
  YTg_local (chargeCoord L α) (chargeCoord L β) (L.form α β) (sum_chargeCoord L hPos α β) _ _ _ _
    _ _ (eT_swap L hEven hU α β) e e'

/-- The generators against `Y^T(e^β)`. -/
theorem FgenT_YTL_local (a : Fin (rank L)) (β : L.carrier) (e : ℤ) :
    Local (FgenT (Tm := Rep (cocMat L) (isUnit_det_cocMat L hEven hU)) a)
      (resc (YTL L hEven hU β) 2 e) :=
  FgenT_YTg_local a _ _ _ _ e

/-- The rescaled generator, as a field. -/
noncomputable def FgenTFld (a : Fin (rank L)) :
    Fld (FockT (rank L) ⊗[ℂ] Rep (cocMat L) (isUnit_det_cocMat L hEven hU)) :=
  rescFld (A := modeTT a) (by norm_num : 0 < 2) (modeTT_truncation a) 1

/-- The rescaled `Y^T(e^α)` on the class `e`, as a field. -/
noncomputable def YTLFld (α : L.carrier) (e : ℤ) :
    Fld (FockT (rank L) ⊗[ℂ] Rep (cocMat L) (isUnit_det_cocMat L hEven hU)) :=
  rescFld (A := YTL L hEven hU α) (by norm_num : 0 < 2) (YTL_truncation L hEven hU α) e

/-- `Fgen_a ₍₀₎ Ỹ(e^β)_e = βₐ Ỹ(e^β)_{e+1}`. -/
theorem prod_FgenTFld_YTLFld_zero (a : Fin (rank L)) (β : L.carrier) (e : ℤ) :
    Fld.prod 0 (FgenTFld L hEven hU a) (YTLFld L hEven hU β e)
      = chargeCoord L β a • YTLFld L hEven hU β (e + 1) := by
  apply Subtype.ext
  rw [Fld.prod_of_nonneg le_rfl, Fld.smul_val]
  change cCoeff 0 (bracketDist (FgenT a)
    (resc (YTg (chargeCoord L β) (L.form β β) ((2 : ℂ) ^ (-(L.form β β)))
      (eT L hEven hU β)) 2 e)) = _
  rw [bracketDist_FgenT_YTg, cCoeff_deltaDeriv, if_pos rfl, Nat.factorial_zero,
    Nat.cast_one, one_smul]
  rfl

/-- `Fgen_a ₍ⱼ₎ Ỹ(e^β)_e = 0` for `j ≥ 1`. -/
theorem prod_FgenTFld_YTLFld_pos (a : Fin (rank L)) (β : L.carrier) (e : ℤ) {j : ℤ}
    (hj : 0 < j) : Fld.prod j (FgenTFld L hEven hU a) (YTLFld L hEven hU β e) = 0 := by
  apply Subtype.ext
  rw [Fld.prod_of_nonneg hj.le]
  change cCoeff j.toNat (bracketDist (FgenT a)
    (resc (YTg (chargeCoord L β) (L.form β β) ((2 : ℂ) ^ (-(L.form β β)))
      (eT L hEven hU β)) 2 e)) = _
  rw [bracketDist_FgenT_YTg, cCoeff_deltaDeriv, if_neg (by omega)]
  rfl

/-- **The generating set of the twisted lattice field system**: the rescaled twisted Heisenberg
generators and all rescaled twisted exponential fields. -/
def latGenSet : Set (Fld (FockT (rank L) ⊗[ℂ] Rep (cocMat L) (isUnit_det_cocMat L hEven hU))) :=
  Set.range (FgenTFld L hEven hU) ∪ Set.range (fun p : L.carrier × ℤ => YTLFld L hEven hU p.1 p.2)

theorem latGenSet_local (hPos : L.PosDef) :
    ∀ a ∈ latGenSet L hEven hU, ∀ b ∈ latGenSet L hEven hU, Local a.1 b.1 := by
  rintro a (⟨i, rfl⟩ | ⟨⟨α, e⟩, rfl⟩) b (⟨j, rfl⟩ | ⟨⟨β, e'⟩, rfl⟩)
  · exact FgenT_local i j
  · exact FgenT_YTL_local L hEven hU i β e'
  · exact (FgenT_YTL_local L hEven hU j α e).symm
  · exact YTL_local L hEven hU hPos α β e e'

/-- **The twisted lattice field system is pairwise local**: every field generated from the
rescaled twisted Heisenberg generators and the rescaled `Y^T(e^α)` (all classes) by integer
field products, powers of `z`, sums and scalars is mutually local with every other one — the
locality input of `TwistedReduction.twistedJacobi_of_local_pf` for `V_L^T = S[θ] ⊗ T`. -/
theorem latticeTwistedSystem_local (hPos : L.PosDef)
    {a b : Fld (FockT (rank L) ⊗[ℂ] Rep (cocMat L) (isUnit_det_cocMat L hEven hU))}
    (ha : a ∈ TGenerated (latGenSet L hEven hU)) (hb : b ∈ TGenerated (latGenSet L hEven hU)) :
    Local a.1 b.1 :=
  tgenerated_local (latGenSet_local L hEven hU hPos) ha hb

end Lattice

theorem neg_one_zpow_congr {a b : ℤ} (h : (a - b) % 2 = 0) : (-1 : ℂ) ^ a = (-1 : ℂ) ^ b := by
  obtain ⟨c, hc⟩ : ∃ c, a = b + 2 * c := ⟨(a - b) / 2, by omega⟩
  rw [hc, zpow_add₀ (by norm_num), zpow_mul]
  norm_num

/-- The generic field under `v ↦ −v`: `Y^T_{−v}(k) = (−1)^{k + c₀} Y^T_v(k)`. -/
theorem YTg_neg (v : Fin r → ℂ) (c0 : ℤ) (κ : ℂ) (g : End ℂ Tm) (k : ℤ) :
    YTg (-v) c0 κ g k = (-1 : ℂ) ^ (-k - 2 + c0) • YTg v c0 κ g k := by
  rw [YTg, YTg, DD_neg, TensorProduct.map_smul_left, smul_comm]

/-- `Y^T(𝟙)`: the zero charge with trivial `T`-operator is the identity field. -/
theorem YTg_zero_charge (k : ℤ) :
    YTg (0 : Fin r → ℂ) 0 1 (1 : End ℂ Tm) k = if k = -2 then 1 else 0 := by
  rw [YTg, DD_zero_charge, one_smul]
  split_ifs with h1 h2 h2
  · exact TensorProduct.map_one
  · omega
  · omega
  · exact TensorProduct.map_zero_left _

section LatticeNeg

open IntegralLattice LatGen Extraspecial

variable (L : IntegralLattice) (hEven : L.Even) (hU : IsUnit (gramMat L).det)

/-- **`θ`-compatibility**: `Y^T(e^{−α})₍k/2₎ = (−1)^k Y^T(e^α)₍k/2₎`, i.e.
`Y^T(e^{−α}, z) = Y^T(e^α, z)|_{z^{1/2} ↦ −z^{1/2}}` (`θ e^α = e^{−α}` in `V_L`; `e_{−α} = e_α`
on `T`). -/
theorem YTL_neg (α : L.carrier) (k : ℤ) :
    YTL L hEven hU (-α) k = (-1 : ℂ) ^ k • YTL L hEven hU α k := by
  have hc : chargeCoord L (-α) = -chargeCoord L α := funext (chargeCoord_neg L α)
  have hf : L.form (-α) (-α) = L.form α α := by simp
  rw [YTL, YTL, hc, hf, eT_neg, YTg_neg]
  congr 1
  obtain ⟨c, hc⟩ := hEven α
  exact neg_one_zpow_congr (by omega)

/-- The `θ`-even combination `e^α + e^{−α}` has no odd modes (support condition, `j = 0`). -/
theorem YTL_add_neg_of_odd (α : L.carrier) {k : ℤ} (hk : k % 2 = 1) :
    YTL L hEven hU α k + YTL L hEven hU (-α) k = 0 := by
  rw [YTL_neg, show (-1 : ℂ) ^ k = -1 by
    rw [neg_one_zpow_congr (b := 1) (by omega)]; norm_num, neg_one_smul, add_neg_cancel]

/-- The `θ`-odd combination `e^α − e^{−α}` has no even modes (support condition, `j = 1`). -/
theorem YTL_sub_neg_of_even (α : L.carrier) {k : ℤ} (hk : k % 2 = 0) :
    YTL L hEven hU α k - YTL L hEven hU (-α) k = 0 := by
  rw [YTL_neg, show (-1 : ℂ) ^ k = 1 by
    rw [neg_one_zpow_congr (b := 0) (by omega)]; norm_num, one_smul, sub_self]

/-- `Y^T(e^0) = Y^T(𝟙)` is the identity field: `YTL 0 k = δ_{k,−2}`. -/
theorem YTL_zero (k : ℤ) : YTL L hEven hU 0 k = if k = -2 then 1 else 0 := by
  have hc : chargeCoord L (0 : L.carrier) = 0 := funext (chargeCoord_zero L)
  rw [YTL, hc, map_zero, neg_zero, zpow_zero, eT_zero, YTg_zero_charge]

end LatticeNeg

/-! ## The Leech lattice -/

section Leech

open IntegralLattice Extraspecial

/-- `Y^T(e^α)` for the Leech lattice, on `S[θ] ⊗ T` with `dim T = 4096`. -/
noncomputable abbrev leechYT (α : leech.carrier) (k : ℤ) :
    End ℂ (FockT (rank leech) ⊗[ℂ] Rep (cocMat leech) (isUnit_det_cocMat leech leech_even
      leech_isUnit_det_gramMat)) :=
  YTL leech leech_even leech_isUnit_det_gramMat α k

/-- **The Leech twisted field system is pairwise local.** -/
theorem leechTwistedSystem_local
    {a b : Fld (FockT (rank leech) ⊗[ℂ] Rep (cocMat leech) (isUnit_det_cocMat leech leech_even
      leech_isUnit_det_gramMat))}
    (ha : a ∈ TGenerated (latGenSet leech leech_even leech_isUnit_det_gramMat))
    (hb : b ∈ TGenerated (latGenSet leech leech_even leech_isUnit_det_gramMat)) :
    Local a.1 b.1 :=
  latticeTwistedSystem_local leech leech_even leech_isUnit_det_gramMat leech_posDef ha hb

end Leech

