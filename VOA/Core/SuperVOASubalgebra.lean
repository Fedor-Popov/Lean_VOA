import VOA.Core.SuperNearVOA

/-!
# Subalgebras of a super near-VOA, and the even part

A **super vertex operator subalgebra** of a `SuperNearVOA` is a subspace containing `𝟙`
and `ω`, closed under every product `u₍ₙ₎v`, and compatible with **both** gradings — the
`ℂ`-valued conformal weight *and* the `ZMod 2` parity.  "Compatible" is spelled the way the
bosonic `VOASubalgebra` (`Modularity.Twisted`) spells it: the carrier is stable under the
homogeneous projections, which for an internal grading is exactly the statement that the
carrier is spanned by its homogeneous pieces.

Both gradedness conditions are needed, and for different reasons: weight-gradedness is what
makes the induced weight grading on the carrier internal (so the subalgebra is again a
`SuperVertexAlgebra` at all), and parity-gradedness is what makes the induced *parity*
grading internal (so super-locality still makes sense on the carrier).

## Main definitions

* `SuperVOASubalgebra` — the structure.
* `SuperVOASubalgebra.toSuperNearVOA` — **a subalgebra is a super near-VOA**, with the
  restricted state–field correspondence, both induced gradings, the same central charge,
  Virasoro relation and translation.  Note the target is a *near*-VOA: the CFT-type
  conditions are not inherited and must be proved per example (see `Core.SuperNearVOA`).
* `SuperVOASubalgebra.generated` — the subalgebra generated by a set, as an `sInf`, with
  `generated_le` and the membership induction principle `mem_generated`.
* `SuperVOASubalgebra.evenPart` — the parity-`0` subalgebra, characterised by
  `evenPart_mem_iff`.

## Why `evenPart` is the whole point

The project builds the even part of a super VOA **directly**, as the parity-`0`
subalgebra, rather than as a `ℤ/2`-orbifold of a super VOA.  `parity_isInternal` already
hands over the carrier `𝒱₀̄` as a submodule; a general orbifold would additionally require
an automorphism group of a *super* VOA and the fixed-point machinery, none of which is
needed here.

The one nonobvious obligation is `wt_graded` for `evenPart`: a priori the weight projection
of an even vector need not be even, since `SuperVertexAlgebra` links the two gradings by no
axiom.  It *is* even, by `SuperNearVOA.wtProj_mem_parity`, which is a consequence of `ω`
being even — not of spin–statistics, which genuinely fails for symplectic fermions.

## References
* Gannon §5.3.6 (subalgebras, orbifolds) for the bosonic template; Kac §4.1.
-/

namespace VOA

open Module (End)
open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-- A **super vertex operator subalgebra** of a super near-VOA `W`: a subspace containing
`𝟙` and `ω`, closed under all products `u₍ₙ₎v`, and stable under the weight *and* parity
projections. -/
structure SuperVOASubalgebra (W : SuperNearVOA 𝒱) where
  /-- The underlying subspace. -/
  carrier : Submodule ℂ 𝒱
  /-- The vacuum belongs to the subalgebra. -/
  vacuum_mem : W.vacuum ∈ carrier
  /-- The conformal vector belongs to the subalgebra. -/
  conformal_mem : W.conformalVector ∈ carrier
  /-- Closure under every product `u₍ₙ₎v`, `n ∈ ℤ`. -/
  smul_mem : ∀ u ∈ carrier, ∀ n : ℤ, ∀ v ∈ carrier, mode (W.Y u) n v ∈ carrier
  /-- Stability under the weight projections: the carrier is spanned by its
  weight-homogeneous pieces. -/
  wt_graded : ∀ h : ℂ, ∀ v ∈ carrier, W.wtProj h v ∈ carrier
  /-- Stability under the parity projections: the carrier is spanned by its
  parity-homogeneous pieces. -/
  par_graded : ∀ p : ZMod 2, ∀ v ∈ carrier, W.parProj p v ∈ carrier

namespace SuperVOASubalgebra

variable {W : SuperNearVOA 𝒱} (S : SuperVOASubalgebra W)

/-! ## The restricted state–field correspondence -/

/-- Every coefficient of `Y(u,z)` preserves the subalgebra when `u` does. -/
theorem coeff_mem {u : 𝒱} (hu : u ∈ S.carrier) (k : ℤ) {x : 𝒱} (hx : x ∈ S.carrier) :
    W.Y u k x ∈ S.carrier := by
  have h := S.smul_mem u hu (-k - 1) x hx
  rw [mode_apply, (by ring : -(-k - 1) - 1 = k)] at h
  exact h

/-- The restricted state–field correspondence `Y_S(u,z)` for `u ∈ S`. -/
noncomputable def YS : S.carrier →ₗ[ℂ] (End ℂ S.carrier)⟦z^±⟧ where
  toFun u := fun k => (W.Y u k).restrict (fun x hx => S.coeff_mem u.2 k hx)
  map_add' u v := by
    funext k
    ext x
    simp only [Submodule.coe_add, map_add, LinearMap.restrict_apply]
    rfl
  map_smul' c u := by
    funext k
    ext x
    simp only [Submodule.coe_smul, map_smul, LinearMap.restrict_apply, RingHom.id_apply]
    rfl

@[simp] theorem YS_apply_coe (u : S.carrier) (k : ℤ) (x : S.carrier) :
    ((S.YS u k x : S.carrier) : 𝒱) = W.Y u k x := rfl

@[simp] theorem mode_YS_coe (u : S.carrier) (n : ℤ) (x : S.carrier) :
    ((mode (S.YS u) n x : S.carrier) : 𝒱) = mode (W.Y u) n x := rfl

/-! ## The two induced gradings -/

/-- The induced weight grading `S_h = S ∩ 𝒱_h`. -/
def gradingS (h : ℂ) : Submodule ℂ S.carrier := (W.grading h).comap S.carrier.subtype

/-- The induced parity grading `S_p = S ∩ 𝒱_p`. -/
def parityS (p : ZMod 2) : Submodule ℂ S.carrier := (W.parity p).comap S.carrier.subtype

theorem mem_gradingS {h : ℂ} {x : S.carrier} : x ∈ S.gradingS h ↔ (x : 𝒱) ∈ W.grading h :=
  Iff.rfl

theorem mem_parityS {p : ZMod 2} {x : S.carrier} : x ∈ S.parityS p ↔ (x : 𝒱) ∈ W.parity p :=
  Iff.rfl

/-- The induced weight grading is an internal direct sum. -/
theorem gradingS_isInternal : DirectSum.IsInternal S.gradingS :=
  isInternal_comap W.grading S.carrier S.wt_graded

/-- The induced parity grading is an internal direct sum. -/
theorem parityS_isInternal : DirectSum.IsInternal S.parityS :=
  isInternal_comap W.parity S.carrier S.par_graded

/-- The induced weight spaces are finite-dimensional, being subspaces of the ambient
weight spaces. -/
instance gradingS_finrank (h : ℂ) : FiniteDimensional ℂ (S.gradingS h) := by
  haveI := W.finrank h
  refine Module.Finite.of_injective (LinearMap.codRestrict (W.grading h)
    (S.carrier.subtype.comp (S.gradingS h).subtype) (fun x => x.2)) ?_
  intro x y hxy
  have hcoe := congrArg Subtype.val hxy
  simp only [LinearMap.codRestrict_apply, LinearMap.comp_apply, Submodule.subtype_apply] at hcoe
  exact Subtype.ext (Subtype.ext hcoe)

/-! ## Super-locality survives restriction -/

/-- The restricted `ε`-twisted commutator is the restriction of the ambient one, degree by
degree.  (The `ε`-twisting is why this cannot simply reuse the bosonic lemma.) -/
theorem mulBySubPow_bracketε_coe (ε : ℂ) (u v : S.carrier) (N : ℕ) (m n : ℤ) (x : S.carrier) :
    ((mulBySubPow N (bracketDistε ε (S.YS u) (S.YS v)) m n x : S.carrier) : 𝒱)
      = mulBySubPow N (bracketDistε ε (W.Y u) (W.Y v)) m n x := by
  induction N generalizing m n with
  | zero =>
      simp only [mulBySubPow, LinearMap.id_apply, bracketDistε_apply, LinearMap.sub_apply,
        LinearMap.smul_apply, Module.End.mul_apply, Submodule.coe_sub, Submodule.coe_smul]
      rfl
  | succ N ih =>
      simp only [mulBySubPow, LinearMap.comp_apply, mulBySub_apply, LinearMap.sub_apply,
        Submodule.coe_sub, ih]

/-! ## A subalgebra is a super near-VOA -/

/-- **A super vertex operator subalgebra is a super near-VOA**, with the restricted
state–field correspondence, both induced gradings, and the same central charge.

The target is a *near*-VOA and not a `SuperVertexOperatorAlgebra`: neither `𝒱₀ = ℂ𝟙` nor
positivity is inherited by a subalgebra of an arbitrary near-VOA, and for the doublet the
ambient object genuinely has negative weights.  Use `SuperNearVOA.toSVOA` once those two
are established for the particular subalgebra at hand. -/
noncomputable def toSuperNearVOA : SuperNearVOA S.carrier where
  grading := S.gradingS
  isInternal := S.gradingS_isInternal
  finrank := S.gradingS_finrank
  parity := S.parityS
  parity_isInternal := S.parityS_isInternal
  Y := S.YS
  vacuum := ⟨W.vacuum, S.vacuum_mem⟩
  vacuum_mem := by rw [mem_gradingS]; exact W.vacuum_mem
  vacuum_parity := by rw [mem_parityS]; exact W.vacuum_parity
  grading_mode := by
    intro h k u hu v hv n
    rw [mem_gradingS] at hu hv ⊢
    rw [mode_YS_coe]
    exact W.grading_mode (u : 𝒱) hu (v : 𝒱) hv n
  parity_mode := by
    intro p q u hu v hv n
    rw [mem_parityS] at hu hv ⊢
    rw [mode_YS_coe]
    exact W.parity_mode (u : 𝒱) hu (v : 𝒱) hv n
  vacuum_Y := by
    funext k
    ext x
    rw [YS_apply_coe, W.vacuum_Y, FormalDist.one_apply, FormalDist.one_apply]
    by_cases hk : k = 0
    · simp [hk]
    · simp [hk]
  creation := by
    intro u
    refine ⟨Subtype.ext ?_, fun n hn => Subtype.ext ?_⟩
    · rw [mode_YS_coe]; exact (W.creation (u : 𝒱)).1
    · rw [mode_YS_coe, Submodule.coe_zero]; exact (W.creation (u : 𝒱)).2 n hn
  locality := by
    intro p q u hu v hv
    obtain ⟨N, hN⟩ := W.locality (u : 𝒱) hu (v : 𝒱) hv
    refine ⟨N, ?_⟩
    funext m n
    ext x
    rw [S.mulBySubPow_bracketε_coe (koszul p q) u v N m n x, hN]
    rfl
  regularity := by
    intro u v
    obtain ⟨N, hN⟩ := W.regularity (u : 𝒱) (v : 𝒱)
    exact ⟨N, fun n hn => Subtype.ext (by rw [mode_YS_coe, hN n hn]; rfl)⟩
  conformalVector := ⟨W.conformalVector, S.conformal_mem⟩
  conformal_mem := by rw [mem_gradingS]; exact W.conformal_mem
  conformal_parity := by rw [mem_parityS]; exact W.conformal_parity
  centralCharge := W.centralCharge
  virasoro := by
    intro m n
    ext x
    have h := congrArg (fun T : Module.End ℂ 𝒱 => T (x : 𝒱)) (W.virasoro m n)
    simp only [Ring.lie_def, LinearMap.sub_apply, Module.End.mul_apply, LinearMap.add_apply,
      LinearMap.smul_apply] at h ⊢
    simp only [Submodule.coe_sub, Submodule.coe_add, Submodule.coe_smul, mode_YS_coe]
    rw [h]
    split_ifs <;> simp
  L0_grading := by
    intro h v hv
    rw [mem_gradingS] at hv
    exact Subtype.ext (by rw [mode_YS_coe, Submodule.coe_smul]; exact W.L0_grading (v : 𝒱) hv)
  translation := by
    intro v
    funext k
    ext x
    rw [YS_apply_coe]
    change W.Y (mode (W.Y W.conformalVector) 0 (v : 𝒱)) k (x : 𝒱) = _
    rw [W.translation (v : 𝒱), deriv_apply, deriv_apply, LinearMap.smul_apply,
      LinearMap.smul_apply]
    simp

@[simp] theorem toSuperNearVOA_centralCharge :
    S.toSuperNearVOA.centralCharge = W.centralCharge := rfl

/-! ## Intersections and the generated subalgebra -/

theorem mem_iInf_carrier {T : Set (SuperVOASubalgebra W)} {x : 𝒱} :
    x ∈ (⨅ A ∈ T, (A : SuperVOASubalgebra W).carrier) ↔ ∀ A ∈ T, x ∈ A.carrier := by
  simp only [Submodule.mem_iInf]

/-- Subalgebras are closed under arbitrary intersections, so they carry an `InfSet`.  (The
empty intersection is `⊤`, which is a subalgebra.) -/
instance : InfSet (SuperVOASubalgebra W) where
  sInf T :=
    { carrier := ⨅ A ∈ T, (A : SuperVOASubalgebra W).carrier
      vacuum_mem := mem_iInf_carrier.mpr fun A _ => A.vacuum_mem
      conformal_mem := mem_iInf_carrier.mpr fun A _ => A.conformal_mem
      smul_mem := fun u hu n v hv => mem_iInf_carrier.mpr fun A hA =>
        A.smul_mem u (mem_iInf_carrier.mp hu A hA) n v (mem_iInf_carrier.mp hv A hA)
      wt_graded := fun h v hv => mem_iInf_carrier.mpr fun A hA =>
        A.wt_graded h v (mem_iInf_carrier.mp hv A hA)
      par_graded := fun p v hv => mem_iInf_carrier.mpr fun A hA =>
        A.par_graded p v (mem_iInf_carrier.mp hv A hA) }

theorem mem_sInf {T : Set (SuperVOASubalgebra W)} {x : 𝒱} :
    x ∈ (sInf T).carrier ↔ ∀ A ∈ T, x ∈ A.carrier := mem_iInf_carrier

variable (W) in
/-- The **subalgebra generated by a set** `S`: the smallest one containing `S`. -/
def generated (S : Set 𝒱) : SuperVOASubalgebra W :=
  sInf {A : SuperVOASubalgebra W | S ⊆ A.carrier}

theorem subset_generated (S : Set 𝒱) : S ⊆ (generated W S).carrier :=
  fun _ hx => mem_sInf.mpr fun _ hA => hA hx

/-- **Minimality.**  Any subalgebra containing `S` contains the generated one. -/
theorem generated_le {S : Set 𝒱} (A : SuperVOASubalgebra W) (hA : S ⊆ A.carrier) :
    (generated W S).carrier ≤ A.carrier :=
  fun _ hx => mem_sInf.mp hx A hA

/-- **Membership induction for the generated subalgebra.**  To prove a property of every
element of `⟨S⟩` it suffices to prove it for the elements of `S`, for `𝟙` and `ω`, and to
show it is preserved by the linear structure, by all products `u₍ₙ₎v`, and by both
families of homogeneous projections.

(The projection clauses are unavoidable: `gradedness` is part of what it means to be a
subalgebra here, so the generated subalgebra really does contain the homogeneous pieces of
everything it contains.) -/
theorem mem_generated {S : Set 𝒱} {motive : 𝒱 → Prop}
    (base : ∀ x ∈ S, motive x)
    (zero : motive 0)
    (add : ∀ x y : 𝒱, motive x → motive y → motive (x + y))
    (smul : ∀ (c : ℂ) (x : 𝒱), motive x → motive (c • x))
    (vac : motive W.vacuum)
    (conf : motive W.conformalVector)
    (prod : ∀ u : 𝒱, motive u → ∀ (n : ℤ) (v : 𝒱), motive v → motive (mode (W.Y u) n v))
    (wt : ∀ (h : ℂ) (v : 𝒱), motive v → motive (W.wtProj h v))
    (par : ∀ (p : ZMod 2) (v : 𝒱), motive v → motive (W.parProj p v))
    {x : 𝒱} (hx : x ∈ (generated W S).carrier) : motive x := by
  let A : SuperVOASubalgebra W :=
    { carrier :=
        { carrier := {y : 𝒱 | motive y}
          add_mem' := fun hy hz => add _ _ hy hz
          zero_mem' := zero
          smul_mem' := fun c x hx => smul c x hx }
      vacuum_mem := vac
      conformal_mem := conf
      smul_mem := fun u hu n v hv => prod u hu n v hv
      wt_graded := fun h v hv => wt h v hv
      par_graded := fun p v hv => par p v hv }
  exact generated_le A (fun y hy => base y hy) hx

/-! ## The even part -/

variable (W) in
/-- **The even part** `𝒱₀̄` of a super near-VOA, as a subalgebra.

`vacuum_mem` and `conformal_mem` are the axioms `vacuum_parity` and `conformal_parity`;
closure under products is `parity_mode` (parities add, and `0 + 0 = 0`); parity-gradedness
is immediate; and weight-gradedness is `SuperNearVOA.wtProj_mem_parity`, the compatibility
of the two gradings that follows from `ω` being even.

This is the *direct* construction of the even part.  We deliberately do not present it as a
`ℤ/2`-orbifold: `parity_isInternal` already supplies the carrier, whereas an orbifold would
demand an automorphism group of a super VOA and fixed-point machinery we never need. -/
def evenPart : SuperVOASubalgebra W where
  carrier := W.parity 0
  vacuum_mem := W.vacuum_parity
  conformal_mem := W.conformal_parity
  smul_mem := fun u hu n v hv => by
    have h := W.parity_mode u hu v hv n
    rwa [zero_add] at h
  wt_graded := fun h v hv => W.wtProj_mem_parity h hv
  par_graded := fun p v hv => by
    by_cases hp : p = 0
    · subst hp
      rwa [W.parProj_of_mem hv]
    · rw [W.parProj_of_mem_ne (Ne.symm hp) hv]
      exact Submodule.zero_mem _

/-- **Membership in the even part is exactly evenness.** -/
theorem evenPart_mem_iff {x : 𝒱} : x ∈ (evenPart W).carrier ↔ x ∈ W.parity 0 := Iff.rfl

@[simp] theorem evenPart_carrier : (evenPart W).carrier = W.parity 0 := rfl

/-- A parity-`0` characterisation that does not mention the grading family: `x` is even iff
its even projection is itself. -/
theorem evenPart_mem_iff_parProj {x : 𝒱} : x ∈ (evenPart W).carrier ↔ W.parProj 0 x = x := by
  constructor
  · intro hx
    exact W.parProj_of_mem hx
  · intro hx
    rw [evenPart_mem_iff, ← hx]
    exact W.parProj_mem 0 x

/-- The even part is purely even: as a super near-VOA in its own right, its odd component
vanishes. -/
theorem evenPart_parityS_one : (evenPart W).parityS 1 = ⊥ := by
  refine le_antisymm (fun x hx => ?_) bot_le
  rw [mem_parityS] at hx
  have h0 : (x : 𝒱) ∈ W.parity 0 := x.2
  have : (x : 𝒱) = 0 := by
    have := W.parProj_of_mem hx
    rw [W.parProj_of_mem_ne (by decide : (0 : ZMod 2) ≠ 1) h0] at this
    exact this.symm
  exact (Submodule.mem_bot ℂ).mpr (Subtype.ext this)

end SuperVOASubalgebra

end VOA
