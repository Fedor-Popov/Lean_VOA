import VOA.Modularity.Twisted

/-!
# The bosonic subalgebra generated by a set

`Modularity.Twisted` introduces the bare structure `VOASubalgebra W` — a subspace of a
`VertexOperatorAlgebra W` containing `𝟙` and `ω`, closed under every product `u₍ₙ₎v`, and
stable under the homogeneous projections `piHom W n` — together with
`VOASubalgebra.toVOA`, which says a subalgebra is again a VOA.  What it does **not**
provide is the *closure* operation: given an arbitrary set of states, the smallest
subalgebra containing it.  This file supplies exactly that, and nothing else; `toVOA` is
imported, never re-proved.

This is the bosonic twin of `Core.SuperVOASubalgebra`'s `generated` / `mem_generated`, one
parity level down: where the super version tracks a `ZMod 2` grading in addition to the
`ℂ`-valued weight, the bosonic version carries only the `ℤ`-valued weight, so the parity
component simply disappears and `wt_graded` becomes the single field `graded`.

## Main definitions

* `VOASubalgebra.instInfSetVOASubalgebra` — subalgebras are closed under arbitrary
  intersections (the empty intersection being `⊤`), hence carry an `InfSet`.
* `VOASubalgebra.generated W S` — the subalgebra generated by a set `S ⊆ 𝒱`, as the
  infimum of all subalgebras containing `S`.
* `VOASubalgebra.generatedVOA W S` — the VOA structure on the generated subalgebra,
  obtained by composing `generated` with the imported `toVOA`.

## Main results

* `VOASubalgebra.subset_generated` — `S ⊆ ⟨S⟩`.
* `VOASubalgebra.generated_le` — **minimality**: any subalgebra containing `S` contains `⟨S⟩`.
* `VOASubalgebra.generated_mono` — monotonicity in `S`.
* `VOASubalgebra.mem_generated` — the **membership induction principle**: a property
  holding on `S`, on `𝟙` and `ω`, and stable under the linear structure, under all
  products `u₍ₙ₎v` and under the homogeneous projections, holds on all of `⟨S⟩`.
* `VOASubalgebra.generated_eq_self` — `⟨A⟩ = A` for a subalgebra `A`, so `generated` is a
  genuine closure operator.

## The projection clause is not optional

`mem_generated` carries a hypothesis for `piHom W n`, which the reader may find surprising:
one would like `⟨S⟩` to be built from `S`, `𝟙`, `ω` by products and linear combinations
alone.  It is not, because gradedness is *part of the definition* of `VOASubalgebra` here
(it is what makes the induced grading on the carrier internal, hence what makes `toVOA`
possible at all).  So `⟨S⟩` really does contain the homogeneous pieces of everything it
contains, and any induction over it must account for them.  The same caveat applies to the
super version; see the discussion there.

## References
* Gannon §5.3.6 (subalgebras and orbifolds) — the ambient bosonic setting.
-/

namespace VOA

open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

namespace VOASubalgebra

variable {W : VertexOperatorAlgebra 𝒱}

/-! ## Intersections -/

theorem mem_iInf_carrier {T : Set (VOASubalgebra W)} {x : 𝒱} :
    x ∈ (⨅ A ∈ T, (A : VOASubalgebra W).carrier) ↔ ∀ A ∈ T, x ∈ A.carrier := by
  simp only [Submodule.mem_iInf]

/-- Subalgebras are closed under arbitrary intersections, so they carry an `InfSet`.  (The
empty intersection is `⊤`, which is a subalgebra: `𝟙`, `ω`, all products and all
projections lie in `⊤` trivially.) -/
instance instInfSetVOASubalgebra : InfSet (VOASubalgebra W) where
  sInf T :=
    { carrier := ⨅ A ∈ T, (A : VOASubalgebra W).carrier
      vacuum_mem := mem_iInf_carrier.mpr fun A _ => A.vacuum_mem
      conformal_mem := mem_iInf_carrier.mpr fun A _ => A.conformal_mem
      smul_mem := fun u hu n v hv => mem_iInf_carrier.mpr fun A hA =>
        A.smul_mem u (mem_iInf_carrier.mp hu A hA) n v (mem_iInf_carrier.mp hv A hA)
      graded := fun n v hv => mem_iInf_carrier.mpr fun A hA =>
        A.graded n v (mem_iInf_carrier.mp hv A hA) }

theorem mem_sInf {T : Set (VOASubalgebra W)} {x : 𝒱} :
    x ∈ (sInf T).carrier ↔ ∀ A ∈ T, x ∈ A.carrier := mem_iInf_carrier

@[simp] theorem sInf_carrier (T : Set (VOASubalgebra W)) :
    (sInf T).carrier = ⨅ A ∈ T, (A : VOASubalgebra W).carrier := rfl

/-- Two subalgebras with the same carrier are equal: `carrier` is the only data field, the
rest being propositions. -/
theorem eq_of_carrier_eq {A B : VOASubalgebra W} (h : A.carrier = B.carrier) : A = B := by
  cases A
  cases B
  subst h
  rfl

/-! ## The generated subalgebra -/

variable (W) in
/-- **The subalgebra generated by a set** `S`: the smallest vertex operator subalgebra of
`W` whose carrier contains `S`, realised as the intersection of all of them. -/
def generated (S : Set 𝒱) : VOASubalgebra W :=
  sInf {A : VOASubalgebra W | S ⊆ A.carrier}

variable (W) in
@[simp] theorem generated_carrier (S : Set 𝒱) :
    (generated W S).carrier = ⨅ A ∈ {A : VOASubalgebra W | S ⊆ A.carrier},
      (A : VOASubalgebra W).carrier := rfl

variable (W) in
theorem mem_generated_iff {S : Set 𝒱} {x : 𝒱} :
    x ∈ (generated W S).carrier ↔ ∀ A : VOASubalgebra W, S ⊆ A.carrier → x ∈ A.carrier :=
  mem_sInf

variable (W) in
/-- `S ⊆ ⟨S⟩`. -/
theorem subset_generated (S : Set 𝒱) : S ⊆ (generated W S).carrier :=
  fun _ hx => mem_sInf.mpr fun _ hA => hA hx

variable (W) in
theorem mem_generated_of_mem {S : Set 𝒱} {x : 𝒱} (hx : x ∈ S) : x ∈ (generated W S).carrier :=
  subset_generated W S hx

variable (W) in
@[simp] theorem vacuum_mem_generated (S : Set 𝒱) : W.vacuum ∈ (generated W S).carrier :=
  (generated W S).vacuum_mem

variable (W) in
@[simp] theorem conformal_mem_generated (S : Set 𝒱) :
    W.conformalVector ∈ (generated W S).carrier :=
  (generated W S).conformal_mem

/-- **Minimality.**  Any subalgebra whose carrier contains `S` contains `⟨S⟩`. -/
theorem generated_le {S : Set 𝒱} (A : VOASubalgebra W) (hA : S ⊆ A.carrier) :
    (generated W S).carrier ≤ A.carrier :=
  fun _ hx => mem_sInf.mp hx A hA

/-- **Monotonicity** of the closure operator. -/
theorem generated_mono {S T : Set 𝒱} (h : S ⊆ T) :
    (generated W S).carrier ≤ (generated W T).carrier :=
  generated_le (generated W T) (h.trans (subset_generated W T))

/-! ## The induction principle -/

/-- **Membership induction for the generated subalgebra.**  To prove a property of every
element of `⟨S⟩` it suffices to prove it for the elements of `S`, for `𝟙` and for `ω`, and
to show it is preserved by the linear structure, by all products `u₍ₙ₎v`, and by the
homogeneous projections `piHom W n`.

The projection clause is forced by the definition of `VOASubalgebra`, in which gradedness
is an axiom; see the module docstring. -/
theorem mem_generated {S : Set 𝒱} {motive : 𝒱 → Prop}
    (base : ∀ x ∈ S, motive x)
    (zero : motive 0)
    (add : ∀ x y : 𝒱, motive x → motive y → motive (x + y))
    (smul : ∀ (c : ℂ) (x : 𝒱), motive x → motive (c • x))
    (vac : motive W.vacuum)
    (conf : motive W.conformalVector)
    (prod : ∀ u : 𝒱, motive u → ∀ (n : ℤ) (v : 𝒱), motive v → motive (W.smul u n v))
    (proj : ∀ (n : ℤ) (v : 𝒱), motive v → motive (piHom W n v))
    {x : 𝒱} (hx : x ∈ (generated W S).carrier) : motive x := by
  let A : VOASubalgebra W :=
    { carrier :=
        { carrier := {y : 𝒱 | motive y}
          add_mem' := fun hy hz => add _ _ hy hz
          zero_mem' := zero
          smul_mem' := fun c x hx => smul c x hx }
      vacuum_mem := vac
      conformal_mem := conf
      smul_mem := fun u hu n v hv => prod u hu n v hv
      graded := fun n v hv => proj n v hv }
  exact generated_le A (fun y hy => base y hy) hx

/-- The same induction principle with the product clause written in mode form,
`mode (Y u) n v`, which is definitionally `W.smul u n v`. -/
theorem mem_generated_mode {S : Set 𝒱} {motive : 𝒱 → Prop}
    (base : ∀ x ∈ S, motive x)
    (zero : motive 0)
    (add : ∀ x y : 𝒱, motive x → motive y → motive (x + y))
    (smul : ∀ (c : ℂ) (x : 𝒱), motive x → motive (c • x))
    (vac : motive W.vacuum)
    (conf : motive W.conformalVector)
    (prod : ∀ u : 𝒱, motive u → ∀ (n : ℤ) (v : 𝒱), motive v → motive (mode (W.Y u) n v))
    (proj : ∀ (n : ℤ) (v : 𝒱), motive v → motive (piHom W n v))
    {x : 𝒱} (hx : x ∈ (generated W S).carrier) : motive x :=
  mem_generated base zero add smul vac conf prod proj hx

/-! ## `generated` is a closure operator -/

/-- The carrier of a subalgebra generates that subalgebra back. -/
theorem generated_carrier_of_subalgebra (A : VOASubalgebra W) :
    (generated W (A.carrier : Set 𝒱)).carrier = A.carrier :=
  le_antisymm (generated_le A subset_rfl) (fun _ hx => subset_generated W _ hx)

/-- **Idempotence / closure.**  `⟨A⟩ = A` for a subalgebra `A`. -/
theorem generated_eq_self (A : VOASubalgebra W) : generated W (A.carrier : Set 𝒱) = A :=
  eq_of_carrier_eq (generated_carrier_of_subalgebra A)

theorem generated_idem (S : Set 𝒱) :
    generated W ((generated W S).carrier : Set 𝒱) = generated W S :=
  generated_eq_self _

/-! ## The generated subalgebra is a VOA

`Modularity.Twisted` already supplies `VOASubalgebra.toVOA`; the only thing to add is the
composite, recorded for convenience together with its central charge. -/

variable (W) in
/-- **The VOA generated by a set of states**: the subalgebra `⟨S⟩` carries a
`VertexOperatorAlgebra` structure, namely the restriction of `W`'s. -/
noncomputable def generatedVOA (S : Set 𝒱) :
    VertexOperatorAlgebra (generated W S).carrier :=
  (generated W S).toVOA

variable (W) in
@[simp] theorem generatedVOA_centralCharge (S : Set 𝒱) :
    (generatedVOA W S).centralCharge = W.centralCharge := rfl

variable (W) in
@[simp] theorem generatedVOA_Y_coe (S : Set 𝒱) (u : (generated W S).carrier) (k : ℤ)
    (x : (generated W S).carrier) :
    (((generatedVOA W S).Y u k x : (generated W S).carrier) : 𝒱) = W.Y u k x := rfl

variable (W) in
@[simp] theorem generatedVOA_vacuum_coe (S : Set 𝒱) :
    (((generatedVOA W S).vacuum : (generated W S).carrier) : 𝒱) = W.vacuum := rfl

variable (W) in
@[simp] theorem generatedVOA_conformalVector_coe (S : Set 𝒱) :
    (((generatedVOA W S).conformalVector : (generated W S).carrier) : 𝒱)
      = W.conformalVector := rfl

end VOASubalgebra

end VOA

