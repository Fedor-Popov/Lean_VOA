import VOA.Core.LieAlgebraV1

/-!
# Automorphisms of a VOA  (Gannon §5.2.1, pp. 325; §5.2.2)

"This is how group theory arises in VOAs" — and where the Monster will eventually
appear as `Aut(V♮)`.

* An **automorphism** of a VOA `𝒱` is an invertible linear `α : 𝒱 → 𝒱` with
  `α(Y(u, z) v) = Y(α u, z)(α v)` for all `u, v`, together with `α(1) = 1` and
  `α(ω) = ω` (Gannon §5.2.1). These form the group `Aut(𝒱)`.
* `Aut(𝒱)` is finite iff `𝒱₁ = 0` (for sufficiently nice `𝒱`; Question 5.2.2).
  Examples: `Aut(V♮) = 𝕄` (the Monster, finite, since `V♮₁ = 0`);
  `Aut(𝒱(Λ)) ≅ (ℝˣ)²⁴ ⋊ Co₀` (infinite).
* **Inner automorphisms** (5.2.4): the modes `u₍₀₎` (`u ∈ 𝒱`) are derivations,
  `[u₍₀₎, Y(v,z)] = Y(u₍₀₎ v, z)`, so `exp(u₍₀₎)` is an automorphism when defined. For
  `u ∈ 𝒱₁`, `e^{u₍₀₎}` generates a normal subgroup `Inn(𝒱) ⊴ Aut(𝒱)` (Question 5.2.2);
  hence `Aut(𝒱)` is uncountable if `𝒱₁ ≠ 0`.

## What is proved here (`sorry`-free / axiom-free)

* `structure Aut W` — automorphisms (`toLinearEquiv`, `map_smul'`, `map_vacuum`,
  `map_omega`), with the `CoeFun`/`ext` API.
* `instance : Group (Aut W)` — composition, identity (`Aut.id`), and inverse
  (`Aut.inverse`), the group laws reduced to the underlying `𝒱 ≃ₗ[ℂ] 𝒱`.
* The **derivation (Leibniz) law** `zeroMode_leibniz`: `u₍₀₎(a₍ₙ₎b) = (u₍₀₎a)₍ₙ₎b +
  a₍ₙ₎(u₍₀₎b)`, the operator restatement of `zeroMode_isDerivation` (Gannon 5.2.4) and the
  exact hypothesis the inner-automorphism exponential consumes. (The derivation property
  itself, `zeroMode_isDerivation`, is proved in `Core.LieAlgebraV1`, where the `𝒱₁` Jacobi
  identity first needs it; reused here.)

## Inner automorphisms `inner = exp(u₍₀₎)` and `Inn` (absorbed from `Core.InnerAutomorphism`)

The locally-nilpotent-exponential infrastructure is built in this file (which also contains
the contents of `Core.InnerAutomorphism`).  For `u ∈ 𝒱₁` with `u₍₀₎` *locally nilpotent*
and `u₍₀₎ω = 0`, `exp(u₍₀₎)` is a genuine automorphism:
* `expSum`/`expFun`/`expEquiv` — the locally finite exponential of a locally nilpotent `D`
  as a `ℂ`-linear **equivalence** (inverse `exp(−D)`, via the `e^D e^{−D}=1` convolution);
* `expFun_smul` — **exp of a derivation is a homomorphism** `exp(D)(a₍ₙ₎b) =
  (exp(D)a)₍ₙ₎(exp(D)b)` (the iterated-Leibniz/Cauchy-product identity off `zeroMode_leibniz`);
* `inner u hnilp homega : Aut W` — the inner automorphism `exp(u₍₀₎)`, with `inner_isExpInner`;
* `Inn W : Subgroup (Aut W)` — the **normal** subgroup generated by the inner automorphisms,
  its normality being the content of the conjugation formula `isExpInner_conj`
  (`α exp(u₍₀₎) α⁻¹ = exp((αu)₍₀₎)`).

(`u₍₀₎` local nilpotency is a genuine hypothesis — it fails for e.g. lattice-VOA Cartan
currents — so `inner` carries it; `Inn` is the subgroup over those `u` for which it holds.)

## Dependencies
* `VOA.Core.LieAlgebraV1` (the zero-mode and its derivation property).

## Status
`Aut W`, its `Group` structure, the derivation/Leibniz law, the locally-nilpotent
exponential machinery (`expEquiv`, `expFun_smul`), the inner automorphisms `inner = exp(u₍₀₎)`
and the normal subgroup `Inn` are all `sorry`-free / axiom-free
(`[propext, Classical.choice, Quot.sound]`).

## References
* Gannon §5.2.1–5.2.2, eq. (5.2.4); FLM (`Aut(V♮) = 𝕄`); Dong–Griess–Höhn.
-/

namespace VOA

open Module (End)
open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## The automorphism structure (Gannon §5.2.1) -/

/-- An **automorphism** of a VOA (Gannon §5.2.1): a `ℂ`-linear equivalence `α : 𝒱 ≃ 𝒱`
intertwining every product, `α(u₍ₙ₎v) = (αu)₍ₙ₎(αv)`, and fixing the vacuum `𝟙` and the
conformal vector `ω`.  (Fixing `ω` is equivalent to commuting with all `Lₙ`, hence to
preserving the grading.) -/
structure Aut (W : VertexOperatorAlgebra 𝒱) where
  /-- The underlying `ℂ`-linear equivalence `α : 𝒱 ≃ₗ 𝒱`. -/
  toLinearEquiv : 𝒱 ≃ₗ[ℂ] 𝒱
  /-- `α` intertwines every product: `α(u₍ₙ₎v) = (αu)₍ₙ₎(αv)`. -/
  map_smul' : ∀ (u : 𝒱) (n : ℤ) (v : 𝒱),
    toLinearEquiv (W.smul u n v) = W.smul (toLinearEquiv u) n (toLinearEquiv v)
  /-- `α` fixes the vacuum: `α(𝟙) = 𝟙`. -/
  map_vacuum : toLinearEquiv W.vacuum = W.vacuum
  /-- `α` fixes the conformal vector: `α(ω) = ω`. -/
  map_omega : toLinearEquiv W.conformalVector = W.conformalVector

namespace Aut

variable {W : VertexOperatorAlgebra 𝒱}

/-- Apply an automorphism to a vector (through its underlying linear equivalence). -/
instance : CoeFun (Aut W) (fun _ => 𝒱 → 𝒱) := ⟨fun α => α.toLinearEquiv⟩

@[simp] theorem coe_toLinearEquiv (α : Aut W) (v : 𝒱) : α.toLinearEquiv v = α v := rfl

/-- Two automorphisms agree once their underlying linear equivalences do. -/
@[ext] theorem ext {α β : Aut W} (h : α.toLinearEquiv = β.toLinearEquiv) : α = β := by
  cases α; cases β; cases h; rfl

/-- The product intertwining law in `CoeFun` form: `α(u₍ₙ₎v) = (αu)₍ₙ₎(αv)`. -/
theorem map_smul (α : Aut W) (u : 𝒱) (n : ℤ) (v : 𝒱) :
    α (W.smul u n v) = W.smul (α u) n (α v) := α.map_smul' u n v

/-! ## The group structure: composition, identity, inverse -/

/-- Composition of automorphisms `α ∘ β` (apply `β` first). -/
def comp (α β : Aut W) : Aut W where
  toLinearEquiv := β.toLinearEquiv.trans α.toLinearEquiv
  map_smul' u n v := by
    simp only [LinearEquiv.trans_apply, β.map_smul', α.map_smul']
  map_vacuum := by simp only [LinearEquiv.trans_apply, β.map_vacuum, α.map_vacuum]
  map_omega := by simp only [LinearEquiv.trans_apply, β.map_omega, α.map_omega]

/-- The identity automorphism. -/
def id (W : VertexOperatorAlgebra 𝒱) : Aut W where
  toLinearEquiv := LinearEquiv.refl ℂ 𝒱
  map_smul' _ _ _ := rfl
  map_vacuum := rfl
  map_omega := rfl

/-- The inverse automorphism `α⁻¹` (the inverse linear equivalence, with the intertwining
laws transported across `α`). -/
def inverse (α : Aut W) : Aut W where
  toLinearEquiv := α.toLinearEquiv.symm
  map_smul' u n v := by
    refine α.toLinearEquiv.injective ?_
    simp only [LinearEquiv.apply_symm_apply, α.map_smul']
  map_vacuum := α.toLinearEquiv.injective (by
    rw [LinearEquiv.apply_symm_apply, α.map_vacuum])
  map_omega := α.toLinearEquiv.injective (by
    rw [LinearEquiv.apply_symm_apply, α.map_omega])

instance : Group (Aut W) where
  mul := comp
  one := id W
  inv := inverse
  mul_assoc α β γ := ext (LinearEquiv.ext fun _ => rfl)
  one_mul α := ext (LinearEquiv.ext fun _ => rfl)
  mul_one α := ext (LinearEquiv.ext fun _ => rfl)
  inv_mul_cancel α := ext (LinearEquiv.ext fun x => α.toLinearEquiv.symm_apply_apply x)

@[simp] theorem mul_apply (α β : Aut W) (v : 𝒱) : (α * β) v = α (β v) := rfl

@[simp] theorem one_apply (v : 𝒱) : (1 : Aut W) v = v := rfl

@[simp] theorem inv_apply (α : Aut W) (v : 𝒱) : α⁻¹ v = α.toLinearEquiv.symm v := rfl

end Aut

/-! ## The derivation / Leibniz law for `u₍₀₎` (Gannon 5.2.4)

The derivation property `zeroMode_isDerivation` (`[u₍₀₎, v₍ₙ₎] = (u₍₀₎v)₍ₙ₎`) is proved in
`Core.LieAlgebraV1`, where the `𝒱₁` Jacobi identity first consumes it.  Here we record its
operator/Leibniz restatement — the exact input the inner-automorphism exponential needs. -/

namespace VertexOperatorAlgebra

variable {W : VertexOperatorAlgebra 𝒱}

/-- **The derivation (Leibniz) law** for the zero-mode `u₍₀₎` (Gannon 5.2.4): for all `u`,
`u₍₀₎(a₍ₙ₎b) = (u₍₀₎a)₍ₙ₎b + a₍ₙ₎(u₍₀₎b)`.  This is `zeroMode_isDerivation` rearranged; it
says `u₍₀₎` is a derivation of every product `a₍ₙ₎b`, which is what makes `exp(u₍₀₎)` a VOA
homomorphism (when the exponential converges; see the file docstring). -/
theorem zeroMode_leibniz (W : VertexOperatorAlgebra 𝒱) (u a b : 𝒱) (n : ℤ) :
    W.smul u 0 (W.smul a n b) = W.smul (W.smul u 0 a) n b + W.smul a n (W.smul u 0 b) := by
  have h := W.zeroMode_isDerivation u a b n
  rw [sub_eq_iff_eq_add] at h
  rw [h, add_comm]

end VertexOperatorAlgebra

/-! ## Inner automorphisms `exp(u₍₀₎)` and `Inn` (Gannon 5.2.4)

`IsExpInner u α` says `α` *is* the automorphism `exp(u₍₀₎)`: its action on each vector matches
the (locally finite) exponential series of `u₍₀₎`.  The locally-nilpotent-exponential and the
"exp of a derivation is a homomorphism" infrastructure are built below
(the contents of `Core.InnerAutomorphism`), so the construction `inner u` and the
normal subgroup `Inn W` are realised here. -/

namespace VertexOperatorAlgebra

variable {W : VertexOperatorAlgebra 𝒱}

/-- A predicate witnessing that `α : Aut W` exponentiates the zero-mode `u₍₀₎` (`u ∈ 𝒱₁`):
on each `v`, `α v = ∑_{k≥0} u₍₀₎ᵏ v / k!`, the (locally finite) inner automorphism `exp(u₍₀₎)`
of Gannon 5.2.4.  The construction of such an `α` is `inner` (below). -/
def IsExpInner (u : W.grading 1) (α : Aut W) : Prop :=
  ∀ v : 𝒱, ∃ N : ℕ, α v = ∑ k ∈ Finset.range N,
    ((k.factorial : ℂ)⁻¹) • ((W.zeroMode (u : 𝒱) 1 ^ k) v)

end VertexOperatorAlgebra

noncomputable def expSum (D : End ℂ 𝒱) (N : ℕ) (v : 𝒱) : 𝒱 :=
  ∑ k ∈ Finset.range N, ((k.factorial : ℂ)⁻¹) • ((D ^ k) v)

theorem expSum_succ (D : End ℂ 𝒱) (N : ℕ) (v : 𝒱) :
    expSum D (N+1) v = expSum D N v + ((N.factorial : ℂ)⁻¹) • ((D^N) v) := by
  unfold expSum; rw [Finset.sum_range_succ]

theorem pow_apply_eq_zero_of_le {D : End ℂ 𝒱} {N : ℕ} {v : 𝒱} (h : (D^N) v = 0)
    {k : ℕ} (hk : N ≤ k) : (D^k) v = 0 := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [add_comm, pow_add, Module.End.mul_apply, h, map_zero]

/-- stabilization: once N annihilates, larger sums agree -/
theorem expSum_stab {D : End ℂ 𝒱} {N : ℕ} {v : 𝒱} (h : (D^N) v = 0) {M : ℕ} (hM : N ≤ M) :
    expSum D M v = expSum D N v := by
  unfold expSum
  rw [← Finset.sum_range_add_sum_Ico _ hM]
  have : ∑ k ∈ Finset.Ico N M, ((k.factorial : ℂ)⁻¹) • ((D ^ k) v) = 0 := by
    apply Finset.sum_eq_zero
    intro k hk
    rw [Finset.mem_Ico] at hk
    rw [pow_apply_eq_zero_of_le h hk.1, smul_zero]
  rw [this, add_zero]

/-- well-definedness: any two annihilating indices give the same partial sum -/
theorem expSum_indep {D : End ℂ 𝒱} {N M : ℕ} {v : 𝒱}
    (hN : (D^N) v = 0) (hM : (D^M) v = 0) : expSum D N v = expSum D M v := by
  rw [← expSum_stab hN (le_max_left N M), ← expSum_stab hM (le_max_right N M)]

/-! ### Linearity of the fixed-`N` partial exponential -/

theorem expSum_add (D : End ℂ 𝒱) (N : ℕ) (v w : 𝒱) :
    expSum D N (v + w) = expSum D N v + expSum D N w := by
  unfold expSum
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun k _ => by rw [map_add, smul_add]

theorem expSum_smul (D : End ℂ 𝒱) (N : ℕ) (c : ℂ) (v : 𝒱) :
    expSum D N (c • v) = c • expSum D N v := by
  unfold expSum
  rw [Finset.smul_sum]
  exact Finset.sum_congr rfl fun k _ => by rw [map_smul, smul_comm]

@[simp] theorem expSum_zero_index (D : End ℂ 𝒱) (v : 𝒱) : expSum D 0 v = 0 := by
  simp [expSum]

/-! ### Local nilpotency and the exponential as a linear map -/

/-- `D` is **locally nilpotent**: every vector is annihilated by some power of `D`. -/
def IsLocNilp (D : End ℂ 𝒱) : Prop := ∀ v : 𝒱, ∃ N : ℕ, (D ^ N) v = 0

/-- A chosen annihilating index for `v`. -/
noncomputable def locNilpIdx {D : End ℂ 𝒱} (hD : IsLocNilp D) (v : 𝒱) : ℕ := (hD v).choose

theorem locNilpIdx_spec {D : End ℂ 𝒱} (hD : IsLocNilp D) (v : 𝒱) :
    (D ^ locNilpIdx hD v) v = 0 := (hD v).choose_spec

/-- The locally finite exponential `exp(D) v = ∑ₖ Dᵏ v / k!`, as a function. -/
noncomputable def expFun {D : End ℂ 𝒱} (hD : IsLocNilp D) (v : 𝒱) : 𝒱 :=
  expSum D (locNilpIdx hD v) v

/-- `expFun` agrees with any annihilating partial sum. -/
theorem expFun_eq_expSum {D : End ℂ 𝒱} (hD : IsLocNilp D) {N : ℕ} {v : 𝒱}
    (hN : (D ^ N) v = 0) : expFun hD v = expSum D N v :=
  expSum_indep (locNilpIdx_spec hD v) hN

/-- The locally finite exponential as a **`ℂ`-linear map**. -/
noncomputable def expLN {D : End ℂ 𝒱} (hD : IsLocNilp D) : 𝒱 →ₗ[ℂ] 𝒱 where
  toFun := expFun hD
  map_add' v w := by
    obtain ⟨Nv, hv⟩ := hD v
    obtain ⟨Nw, hw⟩ := hD w
    set N := max Nv Nw with hN
    have hvN : (D ^ N) v = 0 := pow_apply_eq_zero_of_le hv (le_max_left _ _)
    have hwN : (D ^ N) w = 0 := pow_apply_eq_zero_of_le hw (le_max_right _ _)
    have hvwN : (D ^ N) (v + w) = 0 := by rw [map_add, hvN, hwN, add_zero]
    rw [expFun_eq_expSum hD hvwN, expFun_eq_expSum hD hvN, expFun_eq_expSum hD hwN,
      expSum_add]
  map_smul' c v := by
    obtain ⟨N, hv⟩ := hD v
    have hcv : (D ^ N) (c • v) = 0 := by rw [map_smul, hv, smul_zero]
    simp only [RingHom.id_apply]
    rw [expFun_eq_expSum hD hcv, expFun_eq_expSum hD hv, expSum_smul]

@[simp] theorem expLN_apply {D : End ℂ 𝒱} (hD : IsLocNilp D) (v : 𝒱) :
    expLN hD v = expFun hD v := rfl

/-! ### Iterated Leibniz (binomial) identity for a derivation of a product -/

theorem pow_succ'_apply (D : End ℂ 𝒱) (m : ℕ) (v : 𝒱) : (D ^ (m+1)) v = D ((D^m) v) := by
  rw [pow_succ']; rfl

/-- Pascal resummation: `∑ᵢ C(k,i)g(i+1) + ∑ᵢ C(k,i)g(i) = ∑ᵢ C(k+1,i)g(i)`. -/
theorem pascal_resum {M : Type u} [AddCommGroup M] [Module ℂ M] (k : ℕ) (g : ℕ → M) :
    (∑ i ∈ Finset.range (k+1), (k.choose i : ℂ) • g (i+1))
    + (∑ i ∈ Finset.range (k+1), (k.choose i : ℂ) • g i)
    = ∑ i ∈ Finset.range (k+2), ((k+1).choose i : ℂ) • g i := by
  rw [Finset.sum_range_succ' (fun i => ((k+1).choose i : ℂ) • g i) (k+1),
      Finset.sum_range_succ' (fun i => (k.choose i : ℂ) • g i) k]
  simp only [Nat.choose_zero_right, Nat.cast_one]
  rw [← add_assoc]
  congr 1
  rw [Finset.sum_range_succ (fun i => (k.choose i : ℂ) • g (i+1)) k,
      Finset.sum_range_succ (fun i => ((k+1).choose (i+1) : ℂ) • g (i+1)) k,
      add_right_comm, ← Finset.sum_add_distrib]
  congr 1
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [← add_smul]; congr 2
    rw [Nat.choose_succ_succ' k i]; push_cast; ring
  · rw [Nat.choose_self, Nat.choose_self]

/-- **Iterated Leibniz / binomial identity.**  If `D` is a derivation of the `n`-th product
`a₍ₙ₎b`, then `Dᵏ(a₍ₙ₎b) = ∑ᵢ C(k,i) (Dⁱa)₍ₙ₎(D^{k-i}b)`. -/
theorem iter_leibniz {W : VertexOperatorAlgebra 𝒱} (D : End ℂ 𝒱) (n : ℤ)
    (hleib : ∀ a b : 𝒱, D (W.smul a n b) = W.smul (D a) n b + W.smul a n (D b))
    (k : ℕ) (a b : 𝒱) :
    (D ^ k) (W.smul a n b)
      = ∑ i ∈ Finset.range (k+1),
          (k.choose i : ℂ) • W.smul ((D ^ i) a) n ((D ^ (k - i)) b) := by
  induction k generalizing a b with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply, ih a b, map_sum]
    have step : ∀ i ∈ Finset.range (k+1),
        D ((k.choose i : ℂ) • W.smul ((D ^ i) a) n ((D ^ (k - i)) b))
          = (k.choose i : ℂ) • W.smul ((D ^ (i+1)) a) n ((D ^ ((k+1) - (i+1))) b)
            + (k.choose i : ℂ) • W.smul ((D ^ i) a) n ((D ^ ((k+1) - i)) b) := by
      intro i hi
      rw [Finset.mem_range] at hi
      rw [map_smul, hleib, smul_add]
      have h1 : (D ^ (i+1)) a = D ((D^i) a) := pow_succ'_apply D i a
      have h2 : ((k+1) - (i+1)) = k - i := by omega
      have h3 : ((k+1) - i) = (k - i) + 1 := by omega
      rw [h1, h2, h3, pow_succ'_apply D (k-i) b]
    rw [Finset.sum_congr rfl step, Finset.sum_add_distrib]
    set g : ℕ → 𝒱 := fun i => W.smul ((D ^ i) a) n ((D ^ ((k+1) - i)) b) with hg
    have e1 : ∑ i ∈ Finset.range (k+1),
          (k.choose i : ℂ) • W.smul ((D ^ (i+1)) a) n ((D ^ ((k+1) - (i+1))) b)
            = ∑ i ∈ Finset.range (k+1), (k.choose i : ℂ) • g (i+1) := rfl
    have e2 : ∑ i ∈ Finset.range (k+1),
          (k.choose i : ℂ) • W.smul ((D ^ i) a) n ((D ^ ((k+1) - i)) b)
            = ∑ i ∈ Finset.range (k+1), (k.choose i : ℂ) • g i := rfl
    have eT : ∑ i ∈ Finset.range (k+1+1),
          ((k+1).choose i : ℂ) • W.smul ((D ^ i) a) n ((D ^ ((k+1) - i)) b)
            = ∑ i ∈ Finset.range (k+2), ((k+1).choose i : ℂ) • g i := rfl
    rw [e1, e2, eT, pascal_resum k g]

/-! ### Bilinearity of the product over finite sums -/

theorem smul_finsum_left {W : VertexOperatorAlgebra 𝒱} (n : ℤ) (s : Finset ℕ) (p : ℕ → 𝒱)
    (w : 𝒱) : W.smul (∑ i ∈ s, p i) n w = ∑ i ∈ s, W.smul (p i) n w := by
  induction s using Finset.induction with
  | empty => simp [PreVertexAlgebra.smul_zero_left]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, PreVertexAlgebra.smul_add_left, ih, Finset.sum_insert ha]

theorem smul_finsum_right {W : VertexOperatorAlgebra 𝒱} (n : ℤ) (u : 𝒱) (t : Finset ℕ)
    (q : ℕ → 𝒱) : W.smul u n (∑ j ∈ t, q j) = ∑ j ∈ t, W.smul u n (q j) := by
  induction t using Finset.induction with
  | empty => simp [PreVertexAlgebra.smul_zero_right]
  | insert a t ha ih =>
    rw [Finset.sum_insert ha, PreVertexAlgebra.smul_add_right, ih, Finset.sum_insert ha]

theorem smul_sum_sum {W : VertexOperatorAlgebra 𝒱} (n : ℤ) (s t : Finset ℕ) (f g : ℕ → ℂ)
    (p q : ℕ → 𝒱) :
    W.smul (∑ i ∈ s, f i • p i) n (∑ j ∈ t, g j • q j)
      = ∑ i ∈ s, ∑ j ∈ t, (f i * g j) • W.smul (p i) n (q j) := by
  rw [smul_finsum_left]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [smul_finsum_right]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [PreVertexAlgebra.smul_smul_left, PreVertexAlgebra.smul_smul_right, smul_smul]

/-! ### Combinatorial bridges -/

theorem fact_choose (k i : ℕ) (hik : i ≤ k) :
    ((k.factorial : ℂ)⁻¹) * (k.choose i : ℂ)
      = ((i.factorial : ℂ)⁻¹) * (((k-i).factorial : ℂ)⁻¹) := by
  have hkfac : (k.factorial : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
  have hi : (i.factorial : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero i
  have hki : ((k-i).factorial : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero (k-i)
  have key : (k.choose i : ℂ) * (i.factorial : ℂ) * ((k-i).factorial : ℂ)
      = (k.factorial : ℂ) := by
    exact_mod_cast Nat.choose_mul_factorial_mul_factorial hik
  field_simp
  linear_combination key

theorem tri_reindex (M : ℕ) (G : ℕ × ℕ → 𝒱) :
    ∑ k ∈ Finset.range M, ∑ ij ∈ Finset.antidiagonal k, G ij
    = ∑ ij ∈ (Finset.range M ×ˢ Finset.range M).filter (fun ij => ij.1 + ij.2 < M), G ij := by
  rw [Finset.sum_sigma']
  apply Finset.sum_nbij' (fun x => x.2) (fun ij => ⟨ij.1 + ij.2, ij⟩)
  · rintro ⟨k, i, j⟩ h
    simp only [Finset.mem_sigma, Finset.mem_range, Finset.mem_antidiagonal] at h
    simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range]
    refine ⟨⟨?_, ?_⟩, ?_⟩ <;> omega
  · rintro ⟨i, j⟩ h
    rw [Finset.mem_filter] at h
    have h2 : i + j < M := h.2
    simp only [Finset.mem_sigma, Finset.mem_range, Finset.mem_antidiagonal]
    exact ⟨h2, trivial⟩
  · rintro ⟨k, i, j⟩ h
    simp only [Finset.mem_sigma, Finset.mem_range, Finset.mem_antidiagonal] at h
    simp only [Sigma.mk.injEq, heq_eq_eq, and_true]
    omega
  · rintro ⟨i, j⟩ h; rfl
  · rintro ⟨k, i, j⟩ h; rfl

/-! ### Negation, the alternating binomial, and the convolution `exp(D)∘exp(−D) = id` -/

/-- `(−D)ʲ v = (−1)ʲ • (Dʲ v)`. -/
theorem negD_pow (D : End ℂ 𝒱) (j : ℕ) (v : 𝒱) : ((-D)^j) v = (-1 : ℂ)^j • ((D^j) v) := by
  have h : (-D) = ((-1 : ℂ) • D) := by simp
  rw [h, smul_pow, LinearMap.smul_apply]

theorem pow_pow_apply (D : End ℂ 𝒱) (i j : ℕ) (v : 𝒱) :
    (D^i) ((D^j) v) = (D^(i+j)) v := by rw [pow_add, Module.End.mul_apply]

/-- `−D` is locally nilpotent whenever `D` is. -/
theorem IsLocNilp.neg {D : End ℂ 𝒱} (hD : IsLocNilp D) : IsLocNilp (-D) := by
  intro v
  obtain ⟨N, hN⟩ := hD v
  exact ⟨N, by rw [negD_pow, hN, smul_zero]⟩

/-- The alternating binomial sum `∑ᵢ C(k,i)(−1)^{k−i} = δ_{k0}`. -/
theorem alt_binom (k : ℕ) :
    ∑ i ∈ Finset.range (k+1), ((k.choose i : ℂ) * (-1)^(k-i)) = if k = 0 then 1 else 0 := by
  have h := add_pow (1 : ℂ) (-1) k
  simp only [one_pow, one_mul] at h
  rw [show (1 : ℂ) + (-1) = 0 by ring] at h
  have hsum : ∑ i ∈ Finset.range (k+1), ((k.choose i : ℂ) * (-1)^(k-i))
      = ∑ i ∈ Finset.range (k+1), (-1)^(k-i) * (k.choose i : ℂ) := by
    exact Finset.sum_congr rfl fun i _ => by ring
  rw [hsum, ← h]
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; simp
  · rw [if_neg (by omega), zero_pow (by omega : k ≠ 0)]

/-- **The convolution identity** `exp(D)(exp(−D)v) = v` for `D^M v = 0`.  This is the formal
`e^D e^{−D} = 1` at the level of partial sums, the inverse witness for the exponential. -/
theorem expSum_conv (D : End ℂ 𝒱) (M : ℕ) (v : 𝒱) (hMv : (D^M) v = 0) :
    expSum D M (expSum (-D) M v) = v := by
  rcases Nat.eq_zero_or_pos M with hM0 | hMpos
  · subst hM0; simpa using hMv.symm
  unfold expSum
  have e1 : ∑ k ∈ Finset.range M,
        ((k.factorial : ℂ)⁻¹) • ((D^k) (∑ j ∈ Finset.range M,
          ((j.factorial : ℂ)⁻¹) • ((-D)^j) v))
      = ∑ k ∈ Finset.range M, ∑ j ∈ Finset.range M,
          (((k.factorial : ℂ)⁻¹) * ((j.factorial : ℂ)⁻¹) * (-1:ℂ)^j) • ((D^(k+j)) v) := by
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [map_smul, negD_pow, map_smul, pow_pow_apply, smul_smul, smul_smul]
  rw [e1, ← Finset.sum_product']
  rw [show (∑ kj ∈ Finset.range M ×ˢ Finset.range M,
        (((kj.1.factorial : ℂ)⁻¹) * ((kj.2.factorial : ℂ)⁻¹) * (-1:ℂ)^kj.2)
          • ((D^(kj.1+kj.2)) v))
      = ∑ kj ∈ (Finset.range M ×ˢ Finset.range M).filter (fun kj => kj.1 + kj.2 < M),
        (((kj.1.factorial : ℂ)⁻¹) * ((kj.2.factorial : ℂ)⁻¹) * (-1:ℂ)^kj.2)
          • ((D^(kj.1+kj.2)) v) from ?_]
  · rw [← tri_reindex M (fun kj => (((kj.1.factorial : ℂ)⁻¹) * ((kj.2.factorial : ℂ)⁻¹)
        * (-1:ℂ)^kj.2) • ((D^(kj.1+kj.2)) v))]
    have collect : ∀ k ∈ Finset.range M,
        (∑ ij ∈ Finset.antidiagonal k,
          (((ij.1.factorial : ℂ)⁻¹) * ((ij.2.factorial : ℂ)⁻¹) * (-1:ℂ)^ij.2)
            • ((D^(ij.1+ij.2)) v))
        = ((k.factorial : ℂ)⁻¹ * (if k = 0 then 1 else 0)) • ((D^k) v) := by
      intro k _
      rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ
        (fun i j => (((i.factorial : ℂ)⁻¹) * ((j.factorial : ℂ)⁻¹) * (-1:ℂ)^j)
          • ((D^(i+j)) v)) k]
      have term : ∀ i ∈ Finset.range (k+1),
          (((i.factorial : ℂ)⁻¹) * (((k-i).factorial : ℂ)⁻¹) * (-1:ℂ)^(k-i))
            • ((D^(i+(k-i))) v)
            = ((k.factorial : ℂ)⁻¹ * ((k.choose i : ℂ) * (-1:ℂ)^(k-i))) • ((D^k) v) := by
        intro i hi
        rw [Finset.mem_range] at hi
        have hik : i ≤ k := by omega
        rw [show i + (k - i) = k by omega]
        congr 1
        rw [show ((i.factorial : ℂ)⁻¹) * (((k-i).factorial : ℂ)⁻¹) * (-1:ℂ)^(k-i)
              = (((k.factorial : ℂ)⁻¹) * (k.choose i : ℂ)) * (-1:ℂ)^(k-i) by
          rw [fact_choose k i hik]]
        ring
      rw [Finset.sum_congr rfl term, ← Finset.sum_smul]
      congr 1
      rw [← Finset.mul_sum, alt_binom]
    rw [Finset.sum_congr rfl collect, Finset.sum_eq_single 0]
    · simp
    · intro k _ hk0
      rw [if_neg hk0, mul_zero, zero_smul]
    · intro h; exact absurd (Finset.mem_range.2 hMpos) h
  · symm
    apply Finset.sum_subset
    · intro kj hkj
      rw [Finset.mem_filter] at hkj; exact hkj.1
    · intro kj hkj hnot
      rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hkj
      simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range, not_and, not_lt] at hnot
      have : M ≤ kj.1 + kj.2 := hnot ⟨hkj.1, hkj.2⟩
      rw [pow_apply_eq_zero_of_le hMv this, smul_zero]

/-! ### The homomorphism property: `exp(D)` intertwines the product -/

/-- The locally finite exponential of a locally nilpotent derivation `D` of the `n`-th product
**intertwines that product**: `exp(D)(a₍ₙ₎b) = (exp(D)a)₍ₙ₎(exp(D)b)`.  (This is the formal
"exp of a derivation is a homomorphism" identity, proved by the binomial/Cauchy-product
manipulation off `iter_leibniz`; it needs only local nilpotency, no skew.) -/
theorem expFun_smul {W : VertexOperatorAlgebra 𝒱} {D : End ℂ 𝒱} (hD : IsLocNilp D) (n : ℤ)
    (hleib : ∀ a b : 𝒱, D (W.smul a n b) = W.smul (D a) n b + W.smul a n (D b))
    (a b : 𝒱) :
    expFun hD (W.smul a n b) = W.smul (expFun hD a) n (expFun hD b) := by
  -- choose a common annihilation index N for a and b
  obtain ⟨Na, hNa⟩ := hD a
  obtain ⟨Nb, hNb⟩ := hD b
  set N := max Na Nb with hNdef
  have haN : (D ^ N) a = 0 := pow_apply_eq_zero_of_le hNa (le_max_left _ _)
  have hbN : (D ^ N) b = 0 := pow_apply_eq_zero_of_le hNb (le_max_right _ _)
  -- a₍ₙ₎b is annihilated by D^(2N) (each iter_leibniz term has i ≥ N or k-i ≥ N)
  have habN : (D ^ (2 * N)) (W.smul a n b) = 0 := by
    rw [iter_leibniz D n hleib]
    refine Finset.sum_eq_zero fun i hi => ?_
    rw [Finset.mem_range] at hi
    rcases le_or_gt N i with hiN | hiN
    · rw [pow_apply_eq_zero_of_le haN hiN, PreVertexAlgebra.smul_zero_left, smul_zero]
    · rw [pow_apply_eq_zero_of_le hbN (by omega : N ≤ 2 * N - i),
        PreVertexAlgebra.smul_zero_right, smul_zero]
  -- expand the LHS to index 2N, apply iter_leibniz, factor, antidiagonal
  rw [expFun_eq_expSum hD habN, expFun_eq_expSum hD haN, expFun_eq_expSum hD hbN]
  unfold expSum
  -- LHS: ∑_{k<2N} (1/k!) • Dᵏ(a₍ₙ₎b); rewrite Dᵏ(a₍ₙ₎b) by iter_leibniz, factor, antidiagonal
  have lhs_eq : ∀ k ∈ Finset.range (2 * N),
      ((k.factorial : ℂ)⁻¹) • ((D ^ k) (W.smul a n b))
        = ∑ ij ∈ Finset.antidiagonal k,
          (((ij.1.factorial : ℂ)⁻¹) * ((ij.2.factorial : ℂ)⁻¹))
            • W.smul ((D ^ ij.1) a) n ((D ^ ij.2) b) := by
    intro k _
    rw [iter_leibniz D n hleib, Finset.smul_sum, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
      (fun i j => (((i.factorial : ℂ)⁻¹) * ((j.factorial : ℂ)⁻¹))
        • W.smul ((D ^ i) a) n ((D ^ j) b)) k]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [Finset.mem_range] at hi
    rw [smul_smul, fact_choose k i (by omega)]
  rw [Finset.sum_congr rfl lhs_eq]
  -- now LHS = ∑_{k<2N} ∑_{ij∈antidiag k} ... = triangle sum
  rw [tri_reindex (2 * N)
    (fun ij => (((ij.1.factorial : ℂ)⁻¹) * ((ij.2.factorial : ℂ)⁻¹))
      • W.smul ((D ^ ij.1) a) n ((D ^ ij.2) b))]
  -- RHS: expand the product of the two expSums
  rw [smul_sum_sum n (Finset.range N) (Finset.range N)
    (fun i => (i.factorial : ℂ)⁻¹) (fun j => (j.factorial : ℂ)⁻¹)
    (fun i => (D ^ i) a) (fun j => (D ^ j) b)]
  -- RHS = ∑_{i<N}∑_{j<N} (1/i!)(1/j!) • (Dⁱa)₍ₙ₎(Dʲb)
  rw [← Finset.sum_product']
  -- both sides are now sums over Finsets of pairs (i,j); show equal by restricting
  symm
  apply Finset.sum_subset
  · -- range N ×ˢ range N ⊆ triangle filter (i+j < 2N)
    intro ij hij
    simp only [Finset.mem_product, Finset.mem_range] at hij
    simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range]
    refine ⟨⟨by omega, by omega⟩, by omega⟩
  · -- terms in triangle but outside the square vanish
    intro ij hij hnotij
    simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range] at hij
    simp only [Finset.mem_product, Finset.mem_range, not_and, not_lt] at hnotij
    -- either ij.1 ≥ N or ij.2 ≥ N
    rcases le_or_gt N ij.1 with h1 | h1
    · rw [pow_apply_eq_zero_of_le haN h1, PreVertexAlgebra.smul_zero_left, smul_zero]
    · have h2 : N ≤ ij.2 := hnotij (by omega)
      rw [pow_apply_eq_zero_of_le hbN h2, PreVertexAlgebra.smul_zero_right, smul_zero]

/-! ### `exp(D)` is a linear equivalence (inverse `exp(−D)`) -/

/-- `exp(D) ∘ exp(−D) = id` at the `expFun` level. -/
theorem expFun_neg_cancel {D : End ℂ 𝒱} (hD : IsLocNilp D) (v : 𝒱) :
    expFun hD (expFun hD.neg v) = v := by
  obtain ⟨N, hN⟩ := hD v
  have hNneg : ((-D) ^ N) v = 0 := by rw [negD_pow, hN, smul_zero]
  -- choose an index for exp(D) applied to (expFun hD.neg v) large enough
  -- expFun hD.neg v = expSum (-D) N v (annihilated at N); and exp(D) needs D^M(expSum (-D) N v)=0
  have hinner : expFun hD.neg v = expSum (-D) N v := expFun_eq_expSum hD.neg hNneg
  -- D^N (expSum (-D) N v): every term D^N((-D)^j v)= ±D^(N+j)v = 0 since j<N⟹? no, need 2N
  have hMv : (D ^ (2 * N)) (expSum (-D) N v) = 0 := by
    unfold expSum
    rw [map_sum]
    refine Finset.sum_eq_zero fun j hj => ?_
    rw [Finset.mem_range] at hj
    rw [map_smul, negD_pow, map_smul, pow_pow_apply,
      pow_apply_eq_zero_of_le hN (by omega : N ≤ 2 * N + j), smul_zero, smul_zero]
  rw [hinner, expFun_eq_expSum hD hMv]
  -- now expSum D (2N) (expSum (-D) N v); pad inner to 2N then apply expSum_conv
  rw [← expSum_stab hNneg (by omega : N ≤ 2 * N)]
  exact expSum_conv D (2 * N) v (pow_apply_eq_zero_of_le hN (by omega : N ≤ 2 * N))

/-- `exp(−D) ∘ exp(D) = id` at the `expFun` level (the other order). -/
theorem expFun_neg_cancel' {D : End ℂ 𝒱} (hD : IsLocNilp D) (v : 𝒱) :
    expFun hD.neg (expFun hD v) = v := by
  obtain ⟨N, hN⟩ := hD v
  have hinner : expFun hD v = expSum D N v := expFun_eq_expSum hD hN
  have hMv : ((-D) ^ (2 * N)) (expSum D N v) = 0 := by
    unfold expSum
    rw [map_sum]
    refine Finset.sum_eq_zero fun j hj => ?_
    rw [Finset.mem_range] at hj
    rw [map_smul, negD_pow, pow_pow_apply,
      pow_apply_eq_zero_of_le hN (by omega : N ≤ 2 * N + j), smul_zero, smul_zero]
  rw [hinner, expFun_eq_expSum hD.neg hMv]
  have hNneg : ((-D) ^ N) v = 0 := by rw [negD_pow, hN, smul_zero]
  rw [← expSum_stab hN (by omega : N ≤ 2 * N)]
  have key := expSum_conv (-D) (2 * N) v
    (pow_apply_eq_zero_of_le hNneg (by omega : N ≤ 2 * N))
  rwa [neg_neg] at key

/-- The exponential `exp(D)` of a locally nilpotent `D` as a **`ℂ`-linear equivalence**, with
inverse `exp(−D)`. -/
noncomputable def expEquiv {D : End ℂ 𝒱} (hD : IsLocNilp D) : 𝒱 ≃ₗ[ℂ] 𝒱 where
  toLinearMap := expLN hD
  invFun := expLN hD.neg
  left_inv v := by simpa using expFun_neg_cancel' hD v
  right_inv v := by simpa using expFun_neg_cancel hD v

@[simp] theorem expEquiv_apply {D : End ℂ 𝒱} (hD : IsLocNilp D) (v : 𝒱) :
    expEquiv hD v = expFun hD v := rfl

/-! ### `exp(D)` fixes a vector killed by `D` -/

/-- If `D v = 0` then `exp(D) v = v`. -/
theorem expFun_of_apply_eq_zero {D : End ℂ 𝒱} (hD : IsLocNilp D) {v : 𝒱} (hv : D v = 0) :
    expFun hD v = v := by
  have h1 : (D ^ 1) v = 0 := by simpa using hv
  rw [expFun_eq_expSum hD h1]
  simp [expSum]

/-! ## Inner automorphisms `exp(u₍₀₎)` for `u ∈ 𝒱₁` (Gannon 5.2.4) -/

namespace VertexOperatorAlgebra

variable {W : VertexOperatorAlgebra 𝒱}

/-- The zero-mode `u₍₀₎ = o₁(u)` is a **derivation of every product**, in the form
`iter_leibniz`/`expFun_smul` consume. -/
theorem zeroMode_one_leibniz (u : 𝒱) (n : ℤ) (a b : 𝒱) :
    W.zeroMode u 1 (W.smul a n b)
      = W.smul (W.zeroMode u 1 a) n b + W.smul a n (W.zeroMode u 1 b) := by
  simp only [zeroMode_apply, show (1 : ℤ) - 1 = 0 from by norm_num]
  exact W.zeroMode_leibniz u a b n

/-- `u₍₀₎` annihilates the vacuum: `u₍₀₎ 𝟙 = 0` (VA3, creation axiom). -/
theorem zeroMode_one_vacuum (u : 𝒱) : W.zeroMode u 1 W.vacuum = 0 := by
  rw [zeroMode_apply, show (1 : ℤ) - 1 = 0 from by norm_num]
  exact W.toPreVertexAlgebra.smul_vacuum_zero u

/- `inner_of_locallyNilpotent` (the existence form of `exp(u₍₀₎) ∈ Aut W`) lives in
`VOA.Core.ScreeningKernel`, where the condition `u₍₀₎ ω = 0` is discharged automatically by
`Screening.screening_conformalVector`; it needs only local nilpotency. -/

/-! ### Normality of `Inn`: conjugation `α ∘ exp(u₍₀₎) ∘ α⁻¹ = exp((αu)₍₀₎)` (Gannon 5.2.4) -/

/-- An automorphism intertwines the zero-mode: `α(u₍₀₎ v) = (αu)₍₀₎(α v)`. -/
theorem aut_zeroMode (α : Aut W) (u v : 𝒱) :
    α (W.zeroMode u 1 v) = W.zeroMode (α u) 1 (α v) := by
  simp only [zeroMode_apply, show (1 : ℤ) - 1 = 0 from by norm_num]
  exact α.map_smul u 0 v

/-- Iterated intertwining: `α(u₍₀₎ᵏ v) = (αu)₍₀₎ᵏ (α v)`. -/
theorem aut_zeroMode_pow (α : Aut W) (u : 𝒱) (k : ℕ) (v : 𝒱) :
    α ((W.zeroMode u 1 ^ k) v) = (W.zeroMode (α u) 1 ^ k) (α v) := by
  induction k generalizing v with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply, aut_zeroMode, ih, pow_succ', Module.End.mul_apply]

/-- Local nilpotency transports across an automorphism: if `u₍₀₎` is locally nilpotent then so
is `(αu)₍₀₎`. -/
theorem isLocNilp_aut (α : Aut W) (u : 𝒱)
    (hnilp : VOA.IsLocNilp (W.zeroMode u 1)) :
    VOA.IsLocNilp (W.zeroMode (α u) 1) := by
  intro w
  obtain ⟨N, hN⟩ := hnilp (α.toLinearEquiv.symm w)
  refine ⟨N, ?_⟩
  have h := aut_zeroMode_pow α u N (α.toLinearEquiv.symm w)
  rw [hN, map_zero] at h
  simp only [LinearEquiv.apply_symm_apply] at h
  exact h.symm

/-- **Conjugation of the inner exponential** (the normality core, Gannon 5.2.4):
`α(exp(u₍₀₎) v) = exp((αu)₍₀₎)(α v)`.  Hence `α ∘ exp(u₍₀₎) ∘ α⁻¹ = exp((αu)₍₀₎)`, so the
conjugate of an inner automorphism is the inner automorphism for `αu` — the statement that
`Inn W` is normal in `Aut W`. -/
theorem aut_conj_expFun (α : Aut W) (u : 𝒱)
    (hnilp : VOA.IsLocNilp (W.zeroMode u 1)) (v : 𝒱) :
    α (VOA.expFun hnilp v) = VOA.expFun (isLocNilp_aut α u hnilp) (α v) := by
  obtain ⟨N, hN⟩ := hnilp v
  have hN' : (W.zeroMode (α u) 1 ^ N) (α v) = 0 := by
    have := aut_zeroMode_pow α u N v
    rw [hN, map_zero] at this
    exact this.symm
  rw [VOA.expFun_eq_expSum hnilp hN,
    VOA.expFun_eq_expSum (isLocNilp_aut α u hnilp) hN', VOA.expSum,
    VOA.expSum, map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [map_smul, aut_zeroMode_pow]

/- The conjugation form of normality, `isExpInner_conj`, lives in `VOA.Modularity.Twisted`,
right after `Aut.map_grading`, which supplies `α u ∈ 𝒱₁` automatically. -/

/-! ### `inner = exp(u₍₀₎)` and the normal subgroup `Inn` (Gannon 5.2.4) -/

/-- An automorphism commutes with every Virasoro mode `Lₙ`: `α(Lₙ v) = Lₙ(α v)`.  Since
`Lₙ = ω₍ₙ₊₁₎` and `α` fixes `ω` and intertwines every product, `α(ω₍ₙ₊₁₎v) = ω₍ₙ₊₁₎(αv)`. -/
theorem aut_comm_L (α : Aut W) (n : ℤ) (v : 𝒱) : α (W.L n v) = W.L n (α v) := by
  show α (mode (W.Y W.conformalVector) (n + 1) v)
    = mode (W.Y W.conformalVector) (n + 1) (α v)
  rw [← PreVertexAlgebra.smul_def, ← PreVertexAlgebra.smul_def, α.map_smul]
  congr 1
  exact α.map_omega

/-- **Inner automorphism `inner u = exp(u₍₀₎)`** (Gannon 5.2.4).  For `u ∈ 𝒱₁` whose
zero-mode `u₍₀₎` is locally nilpotent (`hnilp`) and fixes the conformal vector `ω`
(`homega`, the condition for `exp(u₍₀₎)` to fix `ω`), the locally finite exponential
`exp(u₍₀₎)` is an automorphism: the vacuum is fixed (`zeroMode_one_vacuum`), `ω` is fixed
(`homega`), the product is intertwined by `expFun_smul` (exp-of-a-derivation-is-a-homomorphism),
and invertibility is `expEquiv` (inverse `exp(−u₍₀₎)`).

`homega` always holds for `u ∈ 𝒱₁` (`Screening.screening_conformalVector`, in
`VOA.Core.ScreeningKernel`, which this file cannot import); it is kept as an argument of this
definition only for import-order reasons. The hypothesis-free existence statement is
`inner_of_locallyNilpotent` (register entry 11). -/
noncomputable def inner (u : W.grading 1)
    (hnilp : VOA.IsLocNilp (W.zeroMode (u : 𝒱) 1))
    (homega : W.zeroMode (u : 𝒱) 1 W.conformalVector = 0) : Aut W where
  toLinearEquiv := VOA.expEquiv hnilp
  map_smul' a n v := by
    show VOA.expFun hnilp (W.smul a n v)
      = W.smul (VOA.expFun hnilp a) n (VOA.expFun hnilp v)
    exact VOA.expFun_smul hnilp n (zeroMode_one_leibniz (u : 𝒱) n) a v
  map_vacuum := by
    show VOA.expFun hnilp W.vacuum = W.vacuum
    exact VOA.expFun_of_apply_eq_zero hnilp (zeroMode_one_vacuum (u : 𝒱))
  map_omega := by
    show VOA.expFun hnilp W.conformalVector = W.conformalVector
    exact VOA.expFun_of_apply_eq_zero hnilp homega

/-- `inner u` is the inner exponential of `u₍₀₎`: it satisfies the interface `IsExpInner`. -/
theorem inner_isExpInner (u : W.grading 1)
    (hnilp : VOA.IsLocNilp (W.zeroMode (u : 𝒱) 1))
    (homega : W.zeroMode (u : 𝒱) 1 W.conformalVector = 0) :
    IsExpInner u (inner u hnilp homega) := by
  intro v
  refine ⟨VOA.locNilpIdx hnilp v, ?_⟩
  show VOA.expFun hnilp v = _
  rw [VOA.expFun, VOA.expSum]

/-- The set of **inner automorphisms** `exp(u₍₀₎)` (`u ∈ 𝒱₁`), characterised by the
exponential interface `IsExpInner` (Gannon 5.2.4). -/
def innerSet (W : VertexOperatorAlgebra 𝒱) : Set (Aut W) :=
  {α | ∃ u : W.grading 1, IsExpInner u α}

/-- **The inner automorphism group `Inn(𝒱) ⊴ Aut(𝒱)`** (Gannon 5.2.4, Question 5.2.2): the
**normal** subgroup generated by the inner automorphisms `exp(u₍₀₎)`, `u ∈ 𝒱₁`.  Its normality
is the content of the conjugation formula `isExpInner_conj` (`α exp(u₍₀₎) α⁻¹ = exp((αu)₍₀₎)`);
we realise `Inn` as the normal closure of the inner set, which is normal by construction and —
since `isExpInner_conj` shows the inner set is stable under conjugation — coincides with the
plain subgroup generated by the inner automorphisms. -/
def Inn (W : VertexOperatorAlgebra 𝒱) : Subgroup (Aut W) :=
  Subgroup.normalClosure (innerSet W)

/-- **`Inn(𝒱)` is normal in `Aut(𝒱)`** (Gannon 5.2.4, Question 5.2.2). -/
instance Inn_normal (W : VertexOperatorAlgebra 𝒱) : (Inn W).Normal :=
  Subgroup.normalClosure_normal

/-- The inner automorphisms lie in `Inn(𝒱)`. -/
theorem inner_mem_Inn (u : W.grading 1)
    (hnilp : VOA.IsLocNilp (W.zeroMode (u : 𝒱) 1))
    (homega : W.zeroMode (u : 𝒱) 1 W.conformalVector = 0) :
    inner u hnilp homega ∈ Inn W :=
  Subgroup.subset_normalClosure ⟨u, inner_isExpInner u hnilp homega⟩

end VertexOperatorAlgebra

end VOA
