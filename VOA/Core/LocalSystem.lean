import VOA.Core.FieldOps

/-!
# Local systems of weak vertex operators  (Li 1996)

The first layer of module-level reconstruction.  A module `M` carries no vacuum, so the
operator-first reconstruction of `Core.ReconstructionExistence` — which pins `Y` through vacuum
creation and Goddard uniqueness — does not transport to it.  Li's replacement is to work inside
the space of **weak vertex operators on `M`**: lower-truncated `End ℂ M`-valued distributions,
with no reference to a vacuum at all.

The load-bearing fact is that mutual locality survives the products, which is Dong's lemma.  The
library already proves it (`dong_neg`, `dong_nonneg`) for an *arbitrary* complex vector space, so
it applies to a module verbatim — no module-specific version is needed.

## What is here

* `Fld M` — weak vertex operators on `M`, i.e. fields, as a subtype;
* `Fld.one`, `Fld.nprod`, `Fld.deriv` — the identity field and the closure operations;
* `Gen S i a` — `a` is built from `S` in `i` operations (a *sized* generation predicate);
* `gen_local` — **the generated system is pairwise local**: if `S` is pairwise local, every two
  fields generated from `S` are mutually local.

## Why `Gen` carries a size

Locality of the generated system is a genuinely *simultaneous* induction: proving
`Local (a₁ ⊛ a₂) b` by Dong needs `Local a₁ a₂` as well as `Local aᵢ b`, and `b` may itself be a
product of any complexity.  Neither induction on `a` alone nor a level filtration closes — each
leaves a hypothesis relating a subterm to an object of unbounded complexity.  Recording the
derivation size and inducting on the *sum* `i + j` does close, because each of Dong's three
hypotheses has a strictly smaller total size than `i + j`.  That is the whole reason for the
index; it is bookkeeping in service of one real obstruction.
-/

namespace VOA

open Module (End)

variable {M : Type*} [AddCommGroup M] [Module ℂ M]

/-- A **weak vertex operator** on `M` (Li 1996): a lower-truncated `End ℂ M`-valued formal
distribution.  Unlike a vertex operator of a VOA this refers to no vacuum and no grading. -/
def Fld (M : Type*) [AddCommGroup M] [Module ℂ M] : Type _ :=
  {a : FormalDist (End ℂ M) // IsField a}

namespace Fld

/-- The identity field `1(z) = id·z⁰`, the vacuum of the local system. -/
noncomputable def one : Fld M := ⟨idField, idField_isField⟩

/-- The normal-ordered product `:a(z)b(z):`, closed on fields by `IsField.nprod`. -/
noncomputable def nprod (a b : Fld M) : Fld M :=
  ⟨VOA.nprod a.2 b.2, a.2.nprod b.2⟩

/-- The formal derivative `∂_z a(z)`, closed on fields by `IsField.deriv`. -/
noncomputable def deriv (a : Fld M) : Fld M :=
  ⟨VOA.deriv a.1, a.2.deriv⟩

@[simp] theorem one_val : (one : Fld M).1 = idField := rfl
@[simp] theorem nprod_val (a b : Fld M) : (a.nprod b).1 = VOA.nprod a.2 b.2 := rfl
@[simp] theorem deriv_val (a : Fld M) : (a.deriv).1 = VOA.deriv a.1 := rfl

end Fld

/-- `Gen S i a` — the field `a` is generated from `S` using `i` operations.  The size index is
what makes the locality induction close; see the module docstring. -/
inductive Gen (S : Set (Fld M)) : ℕ → Fld M → Prop
  | base {a : Fld M} : a ∈ S → Gen S 0 a
  | one : Gen S 0 Fld.one
  | nprod {i j : ℕ} {a b : Fld M} : Gen S i a → Gen S j b → Gen S (i + j + 1) (a.nprod b)
  | deriv {i : ℕ} {a : Fld M} : Gen S i a → Gen S (i + 1) a.deriv

/-- **The system generated by a pairwise-local family is pairwise local.**

This is the closure property a local system must have, and it is exactly what Dong's lemma buys.
The induction is on the total derivation size `i + j`: in the product case each of Dong's three
hypotheses — `Local a₁ a₂`, `Local a₁ b`, `Local a₂ b` — has strictly smaller total size, which is
why the simultaneous recursion terminates. -/
theorem gen_local (S : Set (Fld M)) (hS : ∀ a ∈ S, ∀ b ∈ S, Local a.1 b.1) :
    ∀ (N i j : ℕ) (a b : Fld M), i + j ≤ N → Gen S i a → Gen S j b → Local a.1 b.1 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro i j a b hij ha hb
    -- Peel `a` when it is a product or a derivative; otherwise peel `b`; otherwise both are atoms.
    cases ha with
    | @nprod i₁ i₂ a₁ a₂ ha₁ ha₂ =>
        have h12 : Local a₁.1 a₂.1 :=
          ih (i₁ + i₂) (by omega) i₁ i₂ a₁ a₂ le_rfl ha₁ ha₂
        have h1b : Local a₁.1 b.1 :=
          ih (i₁ + j) (by omega) i₁ j a₁ b le_rfl ha₁ hb
        have h2b : Local a₂.1 b.1 :=
          ih (i₂ + j) (by omega) i₂ j a₂ b le_rfl ha₂ hb
        exact dong_neg a₁.2 a₂.2 h12 h1b h2b
    | @deriv i₁ a₁ ha₁ =>
        exact (ih (i₁ + j) (by omega) i₁ j a₁ b le_rfl ha₁ hb).derivL
    | base haS =>
        cases hb with
        | @nprod j₁ j₂ b₁ b₂ hb₁ hb₂ =>
            have h12 : Local b₁.1 b₂.1 :=
              ih (j₁ + j₂) (by omega) j₁ j₂ b₁ b₂ le_rfl hb₁ hb₂
            have h1a : Local b₁.1 a.1 :=
              ih (j₁ + 0) (by omega) j₁ 0 b₁ a le_rfl hb₁ (Gen.base haS)
            have h2a : Local b₂.1 a.1 :=
              ih (j₂ + 0) (by omega) j₂ 0 b₂ a le_rfl hb₂ (Gen.base haS)
            exact (dong_neg b₁.2 b₂.2 h12 h1a h2a).symm
        | @deriv j₁ b₁ hb₁ =>
            exact ((ih (j₁ + 0) (by omega) j₁ 0 b₁ a le_rfl hb₁ (Gen.base haS)).derivL).symm
        | base hbS => exact hS a haS b hbS
        | one => exact Local_idField_right _
    | one =>
        cases hb with
        | @nprod j₁ j₂ b₁ b₂ hb₁ hb₂ =>
            have h12 : Local b₁.1 b₂.1 :=
              ih (j₁ + j₂) (by omega) j₁ j₂ b₁ b₂ le_rfl hb₁ hb₂
            have h1a : Local b₁.1 (Fld.one : Fld M).1 :=
              ih (j₁ + 0) (by omega) j₁ 0 b₁ Fld.one le_rfl hb₁ Gen.one
            have h2a : Local b₂.1 (Fld.one : Fld M).1 :=
              ih (j₂ + 0) (by omega) j₂ 0 b₂ Fld.one le_rfl hb₂ Gen.one
            exact (dong_neg b₁.2 b₂.2 h12 h1a h2a).symm
        | @deriv j₁ b₁ hb₁ =>
            exact ((ih (j₁ + 0) (by omega) j₁ 0 b₁ Fld.one le_rfl hb₁ Gen.one).derivL).symm
        | base hbS => exact Local_idField_left _
        | one => exact Local_idField_left _

/-- The generated system, forgetting the size. -/
def Generated (S : Set (Fld M)) : Set (Fld M) := {a | ∃ i, Gen S i a}

/-- **Pairwise locality of the generated system**, in the form it will be consumed. -/
theorem generated_local {S : Set (Fld M)} (hS : ∀ a ∈ S, ∀ b ∈ S, Local a.1 b.1)
    {a b : Fld M} (ha : a ∈ Generated S) (hb : b ∈ Generated S) : Local a.1 b.1 := by
  obtain ⟨i, ha⟩ := ha
  obtain ⟨j, hb⟩ := hb
  exact gen_local S hS (i + j) i j a b le_rfl ha hb

theorem subset_generated {S : Set (Fld M)} : S ⊆ Generated S := fun _ h => ⟨0, Gen.base h⟩

theorem one_mem_generated {S : Set (Fld M)} : (Fld.one : Fld M) ∈ Generated S := ⟨0, Gen.one⟩

theorem nprod_mem_generated {S : Set (Fld M)} {a b : Fld M}
    (ha : a ∈ Generated S) (hb : b ∈ Generated S) : a.nprod b ∈ Generated S := by
  obtain ⟨i, ha⟩ := ha; obtain ⟨j, hb⟩ := hb
  exact ⟨i + j + 1, Gen.nprod ha hb⟩

theorem deriv_mem_generated {S : Set (Fld M)} {a : Fld M} (ha : a ∈ Generated S) :
    a.deriv ∈ Generated S := by
  obtain ⟨i, ha⟩ := ha
  exact ⟨i + 1, Gen.deriv ha⟩

end VOA
