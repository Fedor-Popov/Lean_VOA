/-- The brackets: the table `g2T`. -/
def br (a b : ℕ) : SV := VOA.AffineGeneral.SCLie.entry VOA.AffineGeneral.SCLie.g2T a b

/-- Relation `b` of `I₂ⁿˢ`. -/
def relQ (b : ℕ) : List (ℕ × ℕ × ℤ) := quadOf (relRaw.getD b [])

/-- The Casimir. -/
def qQ : List (ℕ × ℕ × ℤ) := quadOf qRaw

/-- Relation `k` (`27` = Casimir). -/
def relZ (k : ℕ) : QV := if k < 27 then relQ k else qQ

/-- Index ranges of the relations. -/
def relRange : Bool :=
  (List.range 28).all fun k => (relZ k).all fun t => decide (t.1 < 14) && decide (t.2.1 < 14)

/-- The U3 check of current `a`. -/
def u3OK (a : ℕ) : Bool :=
  let c := u3Raw.getD a []
  decide (((c.headD 1 : ℕ) : ℤ) ≠ 0) && (certOf c.tail).all (fun t => t.2.2 < 27) &&
    VOA.DeligneAudit.E6Sparse.u3Check relQ qQ a ((c.headD 1 : ℕ) : ℤ) (certOf c.tail)

/-- Decode flat `s μ` pairs. -/
def zpairs : List ℕ → List (ℕ × ℤ)
  | s :: z :: rest => (s, decZ z) :: zpairs rest
  | _ => []

/-- The stability certificate of generator number `i`, relation `r`. -/
def stabCert (i r : ℕ) : Option (ℤ × List (ℕ × ℤ)) :=
  ((stabRaw.getD i []).find? fun l => l.headD 0 == r).map fun l => (((l.getD 1 1 : ℕ) : ℤ), zpairs (l.drop 2))

/-- The stability check of generator number `i`, relation `r`. -/
def stabCheck (i r : ℕ) : Bool :=
  match stabCert i r with
  | none => qzeroSortSym (adQ br (gensL.getD i 0) (relZ r))
  | some (N, ps) => decide (N ≠ 0) && ps.all (fun p => decide (p.1 < 28)) &&
      qzeroSortSym (smulQ N (adQ br (gensL.getD i 0) (relZ r)) ++
        ps.flatMap fun p => smulQ (-p.2) (relZ p.1))

/-- All stability checks. -/
def stabChecks : Bool := (List.range 6).all fun i => (List.range 28).all fun k => stabCheck i k

/-- The weight coordinate `i` of basis vector `c`. -/
def wtZ (c i : ℕ) : ℤ := decZ (wtRaw.getD (2 * c + i) 0)

/-- Weight homogeneity of the brackets. -/
def wtCheck : Bool :=
  (List.range 14).all fun a => (List.range 14).all fun b => (br a b).all fun p =>
    (List.range 2).all fun i => wtZ p.1 i == wtZ a i + wtZ b i

/-- Decode a flat `c z c z …` list. -/
def pairsOf : List ℕ → SV
  | c :: z :: rest => (c, decZ z) :: pairsOf rest
  | _ => []

/-- Word tree vector `i`. -/
def vecs (i : ℕ) : SV := pairsOf (vecR.getD i [])

/-- Word tree data of node `i`. -/
def cpar (i : ℕ) : ℕ × ℕ × ℕ :=
  let l := cparR.getD i []
  (l.getD 0 0, l.getD 1 0, l.getD 2 0)

/-- Bracket rows. -/
def rows (x : ℕ) : List SV := (List.range 14).map (br x)

/-- The cyclicity certificate of `c`. -/
def cyc (c : ℕ) : ℤ × List (ℕ × ℤ) := cycT.getD c (1, [])

/-- The word tree node checks. -/
def cycNodes : Bool :=
  (List.range' 1 (vecR.length - 1)).all fun i =>
    VOA.DeligneAudit.DeligneSector.Generate.cycNodeCheck rows vecs cpar 14 i

/-- The cyclicity check. -/
def cycCheck : Bool :=
  (List.range 14).all fun c =>
    (cyc c).1 != 0 &&
    (cyc c).2.all (fun p => decide (p.1 < vecR.length) && decide ((cpar p.1).2.2 ≤ 10)) &&
    zeroCheck (((cyc c).2.flatMap fun p => smulSV p.2 (vecs p.1)) ++
      smulSV (-1) (smulSV (cyc c).1 [(c, 1)]))

/-- Positive root vectors. -/
def posL : List ℕ := [2, 5, 6, 7, 9, 10]

/-- Negative root vectors. -/
def negL : List ℕ := [3, 4, 8, 11, 12, 13]

