import VOA.DeligneAudit.SL4TMixedGrassmannian

/-! # Prefix ideals and the four-step b-site Thom chain -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

variable {R : Type*} [CommRing R]

/-- The ideal generated by the first `k` entries in a finite ordered family. -/
def principalIdealPrefix {n : ℕ} (g : Fin n → R) (k : ℕ) : Ideal R :=
  Ideal.span {x | ∃ i : Fin n, i.val < k ∧ g i = x}

theorem mem_principalIdealPrefix {n : ℕ} (g : Fin n → R) (k : ℕ)
    (i : Fin n) (hi : i.val < k) : g i ∈ principalIdealPrefix g k :=
  Ideal.subset_span ⟨i, hi, rfl⟩

theorem principalIdealPrefix_mono {n : ℕ} (g : Fin n → R) :
    Monotone (principalIdealPrefix g) := by
  intro a b hab
  apply Ideal.span_mono
  rintro x ⟨i, hi, rfl⟩
  exact ⟨i, hi.trans_le hab, rfl⟩

theorem principalIdealPrefix_zero {n : ℕ} (g : Fin n → R) :
    principalIdealPrefix g 0 = ⊥ := by
  apply le_antisymm _ bot_le
  apply Ideal.span_le.mpr
  rintro x ⟨i, hi, _⟩
  omega

/-- Each step adjoins exactly one principal ideal. -/
theorem principalIdealPrefix_step {n : ℕ} (g : Fin n → R) (i : Fin n) :
    principalIdealPrefix g (i.val + 1) = principalIdealPrefix g i.val ⊔ Ideal.span {g i} := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro x ⟨j, hj, rfl⟩
    by_cases hji : j.val < i.val
    · exact (show principalIdealPrefix g i.val ≤ _ from le_sup_left)
        (mem_principalIdealPrefix g i.val j hji)
    · have he : j = i := Fin.ext (by omega)
      subst j
      exact (show Ideal.span {g i} ≤ _ from le_sup_right)
        (Ideal.subset_span (Set.mem_singleton _))
  · apply sup_le (principalIdealPrefix_mono g (by omega))
    apply Ideal.span_le.mpr
    rintro x rfl
    exact mem_principalIdealPrefix g (i.val + 1) i (by omega)

theorem principalIdealPrefix_top_of_unit {n : ℕ} (g : Fin n → R) (i : Fin n)
    (hi : g i = 1) : principalIdealPrefix g n = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  rw [← hi]
  exact mem_principalIdealPrefix g n i i.isLt

/-- To control multiplication on a two-generator ideal it suffices to control the generators. -/
theorem mul_pair_ideal_mem (I : Ideal R) (t a b : R)
    (ha : t * a ∈ I) (hb : t * b ∈ I) :
    ∀ x ∈ Ideal.span {a, b}, t * x ∈ I := by
  intro x hx
  obtain ⟨u, v, rfl⟩ := Ideal.mem_span_pair.mp hx
  have h : t * (u * a + v * b) = u * (t * a) + v * (t * b) := by ring
  rw [h]
  exact I.add_mem (I.mul_mem_left u ha) (I.mul_mem_left v hb)

/-- The b-site order used in its four-step ideal chain. -/
def mixedBOrder (i : Fin 4) : MixedBState := ![.s1, .d1, .s2, .d2] i

/-- The b-site Thom generators, including the extra first-state factor. -/
def mixedBThom (q : MixedParams) : MixedBState → MixedRing q
  | .s1 => mixedEvaluation q (mixedE 1 q.d2.toNat) *
      mixedEvaluation q (mixedE 3 q.e1.toNat)
  | .d1 => mixedEvaluation q (mixedE 1 q.d2.toNat)
  | .s2 => mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat)
  | .d2 => 1

/-- The increasing b-site chain of ideals. -/
def mixedBChain (q : MixedParams) (k : ℕ) : Ideal (MixedRing q) :=
  principalIdealPrefix (fun i => mixedBThom q (mixedBOrder i)) k

theorem mixedBChain_mono (q : MixedParams) : Monotone (mixedBChain q) :=
  principalIdealPrefix_mono _

theorem mixedBChain_zero (q : MixedParams) : mixedBChain q 0 = ⊥ :=
  principalIdealPrefix_zero _

theorem mixedBChain_step (q : MixedParams) (i : Fin 4) :
    mixedBChain q (i.val + 1) =
      mixedBChain q i.val ⊔ Ideal.span {mixedBThom q (mixedBOrder i)} :=
  principalIdealPrefix_step _ i

theorem mixedBChain_top (q : MixedParams) : mixedBChain q 4 = ⊤ :=
  principalIdealPrefix_top_of_unit _ 3 rfl

/-- Each b-state boundary ideal is killed by its Thom generator modulo the preceding ideal. -/
theorem mixedBThom_stateIdeal (q : MixedParams) (hq : MixedValid q) (hB : 1 ≤ q.B)
    (i : Fin 4) :
    ∀ x ∈ mixedBStateIdeal q (mixedBOrder i),
      mixedBThom q (mixedBOrder i) * x ∈ mixedBChain q i.val := by
  have hcorner := mixedBase_corner_product q hq 1 hB
  change mixedEvaluation q (mixedE 1 q.d2.toNat) *
    mixedEvaluation q (mixedH 1 (q.B - q.d2).toNat) = 0 at hcorner
  have hfirst := (mixedG1prime_top q hq).trans (mixedU_top q hq)
  have hsecond := (mixedG2prime_top q hq).trans (mixedV_top q hq)
  have hmem (k : ℕ) (j : Fin 4) (hj : j.val < k) :
      mixedBThom q (mixedBOrder j) ∈ mixedBChain q k :=
    mem_principalIdealPrefix _ k j hj
  fin_cases i
  · apply mul_pair_ideal_mem
    · rw [mixedBChain_zero]
      change mixedEvaluation q (mixedE 1 q.d2.toNat) *
        mixedEvaluation q (mixedE 3 q.e1.toNat) *
          mixedEvaluation q (mixedH 1 (q.B - q.d2).toNat) = 0
      linear_combination mixedEvaluation q (mixedE 3 q.e1.toNat) * hcorner
    · rw [mixedBChain_zero]
      change (_ * _) * _ = 0
      change mixedEvaluation q (mixedE 1 q.d2.toNat) *
        mixedEvaluation q (mixedE 3 q.e1.toNat) *
          mixedEvaluation q (mixedG1prime (mixedP q - q.e1).toNat) = 0
      linear_combination mixedEvaluation q (mixedE 1 q.d2.toNat) * hfirst +
        (mixedEvaluation q (mixedE 0 q.d1.toNat) * (-1) ^ (q.B - q.d2).toNat) * hcorner
  · apply mul_pair_ideal_mem
    · change mixedEvaluation q (mixedE 1 q.d2.toNat) *
        mixedEvaluation q (mixedH 1 (q.B - q.d2).toNat) ∈ mixedBChain q 1
      rw [show mixedEvaluation q (mixedE 1 q.d2.toNat) *
        mixedEvaluation q (mixedH 1 (q.B - q.d2).toNat) = 0 from hcorner]
      exact Ideal.zero_mem _
    · exact hmem 1 0 (by decide)
  · apply mul_pair_ideal_mem
    · change mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat) *
        mixedEvaluation q (mixedE 1 q.d2.toNat) ∈ mixedBChain q 2
      exact (mixedBChain q 2).mul_mem_left _ (hmem 2 1 (by decide))
    · change mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat) *
        mixedEvaluation q (mixedE 4 q.e2.toNat) ∈ mixedBChain q 2
      rw [mul_comm, hsecond]
      exact (mixedBChain q 2).mul_mem_right _ (hmem 2 1 (by decide))
  · apply mul_pair_ideal_mem
    · change 1 * mixedEvaluation q (mixedE 1 q.d2.toNat) ∈ mixedBChain q 3
      rw [one_mul]
      exact hmem 3 1 (by decide)
    · change 1 * mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat) ∈ mixedBChain q 3
      rw [one_mul]
      exact hmem 3 2 (by decide)

end

end VOA.DeligneAudit.SL4T

