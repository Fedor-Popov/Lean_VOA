-- The multiplicity target is built over nested tensor-product coefficient algebras.
/-- Every positive power sum of the five alphabets is realized by the Cartan algebra. -/
theorem secondLeviCartanRealized_powerSum (i : Fin 5) (s : ℕ) :
    mixedAlphabetPowerSum (mixedEvaluation (mixedLabelBlockParams 1 B d e₁ e₂)) i
        (mixedLengths (mixedLabelBlockParams 1 B d e₁ e₂) i) (s + 1) ∈
      secondLeviCartanRealized ρ w B hW d e₁ e₂ hv := by
  apply mem_of_threeCartanSymbols (secondLeviCartanRealized ρ w B hW d e₁ e₂ hv)
    (fun j => mixedAlphabetPowerSum (mixedEvaluation (mixedLabelBlockParams 1 B d e₁ e₂)) j
      (mixedLengths (mixedLabelBlockParams 1 B d e₁ e₂) j) (s + 1))
  · exact mixedAlphabetPowerSum_outer_label_one B d e₁ e₂ hv 0 (Or.inl rfl) (s + 1) (by omega)
  · exact mixedAlphabetPowerSum_outer_label_one B d e₁ e₂ hv 2 (Or.inr rfl) (s + 1) (by omega)
  · convert secondLeviCartanRealized_outerAlphabet ρ w B hW d e₁ e₂ hv s using 1
    simp [mixedAlphabetCombination, Fin.sum_univ_five]
    module
  · convert secondLeviCartanRealized_middleCartan ρ w B hW d e₁ e₂ hv s using 1
    simp [mixedAlphabetCombination, Fin.sum_univ_five]
    module
  · convert secondLeviCartanRealized_lastCartan ρ w B hW d e₁ e₂ hv s using 1
    simp [mixedAlphabetCombination, Fin.sum_univ_five]
    module

