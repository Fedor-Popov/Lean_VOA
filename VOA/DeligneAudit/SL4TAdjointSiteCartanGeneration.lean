-- Mixed rings are quotients of a polynomial algebra in countably many variables.
/-- At outer labels one, the positive power sums of the outer alphabets `x₁`, `x₃` vanish in the
mixed ring. -/
theorem mixedAlphabetPowerSum_outer_label_one (B : ℕ) (d : Fin 3 → ℕ) (e₁ e₂ : ℕ)
    (hv : MixedValid (mixedLabelBlockParams 1 B d e₁ e₂)) (i : Fin 5) (hi : i = 0 ∨ i = 2)
    (s : ℕ) (hs : 0 < s) :
    mixedAlphabetPowerSum (mixedEvaluation (mixedLabelBlockParams 1 B d e₁ e₂)) i
      (mixedLengths (mixedLabelBlockParams 1 B d e₁ e₂) i) s = 0 := by
  set q := mixedLabelBlockParams 1 B d e₁ e₂ with hq
  have hvq := hv
  simp only [MixedValid, hq, mixedLabelBlockParams, mixedP, mixedQ] at hvq
  apply powerSumOfCoeff_eq_zero_of_tail
  · intro k hk
    suffices h : mixedEvaluation q (mixedE i k) = 0 by rw [h, mul_zero]
    rcases hi with rfl | rfl
    · by_cases hlt : d 0 < k
      · exact mixedRelation_zero q hv _
          (Or.inl ⟨0, k, by simpa [hq, mixedLengths, mixedLabelBlockParams] using hlt, rfl⟩)
      · obtain ⟨rfl, hd⟩ : k = 1 ∧ d 0 = 1 := by omega
        have hh : mixedE 0 1 = mixedH 0 1 := by simp [mixedE, mixedH, complete_one]
        rw [hh]
        exact mixedRelation_zero q hv _ (Or.inr (Or.inl ⟨1,
          by simp [hq, mixedLabelBlockParams, hd], by simp [hq, mixedLabelBlockParams], rfl⟩))
    · by_cases hlt : d 2 < k
      · exact mixedRelation_zero q hv _
          (Or.inl ⟨2, k, by simpa [hq, mixedLengths, mixedLabelBlockParams] using hlt, rfl⟩)
      · obtain ⟨rfl, hd⟩ : k = 1 ∧ d 2 = 1 := by omega
        have hh : mixedE 2 1 = mixedH 2 1 := by simp [mixedE, mixedH, complete_one]
        rw [hh]
        exact mixedRelation_zero q hv _ (Or.inr (Or.inr (Or.inr (Or.inl ⟨1,
          by simp [hq, mixedLabelBlockParams, hd], by simp [hq, mixedLabelBlockParams],
          rfl⟩))))
  · exact hs

/-! ### Source symbols of the alphabet power sums -/

/-- The image of the positive power sum of each mixed alphabet in the labelled-mode source. -/
def secondLeviAlphabetSource (a b c : ℕ) (d : Fin 3 → ℕ) (e₁ e₂ : ℕ) (i : Fin 5) (s : ℕ) :
    MvPolynomial (SecondLeviModeSlot e₁ e₂) (RadicalGrassmannianRing a b c d) :=
  match i with
  | 0 => MvPolynomial.C (radicalGrassmannianPowerSum a b c d 0 s)
  | 1 => MvPolynomial.C (radicalGrassmannianPowerSum a b c d 1 s)
  | 2 => MvPolynomial.C (radicalGrassmannianPowerSum a b c d 2 s)
  | 3 => secondLeviModePowerSum e₁ e₂ 0 s
  | 4 => secondLeviModePowerSum e₁ e₂ 1 s

