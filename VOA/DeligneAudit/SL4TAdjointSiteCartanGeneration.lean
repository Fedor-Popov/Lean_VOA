import VOA.DeligneAudit.SL4TAdjointSiteOuterAlphabet

/-!
# Cartan generation at one adjoint site

Fix a block `(d, e)` of the second Levi filtration of a module with the local Weyl relations of
weight `(1, B, 1)`, and write `π` for the actual second Levi multiplicity evaluation of the
mixed ring `R`. Three commuting families of operators act on the first Levi quotient and
preserve every higher second Levi closure:

* the two Levi Cartan currents `h₂(s)`, `h₃(s)` (sl₃ colours `6`, `7`), with source symbols
  `p_s(x₁) - p_s(x₂) - 2 p_s(g₁) - p_s(g₂)` and `p_s(x₂) - p_s(x₃) + p_s(g₁) - p_s(g₂)`;
* the outer alphabet current `E₁₁ - ¼` (file `SL4TAdjointSiteOuterAlphabet`), with source symbol
  `p_s(x₁) - p_s(g₁) - p_s(g₂)`.

At outer labels one the power sums of `x₁` and `x₃` vanish in `R`
(`mixedAlphabetPowerSum_outer_label_one`), so the three symbols are an invertible linear
transform (determinant `-4`) of `p_s(x₂)`, `p_s(g₁)`, `p_s(g₂)`. The power sums of the five
alphabets generate `R` (Newton's identities, `mixedRing_adjoin_powerSums`). Hence:

**Lemma CI(i)** (`adjointSite_cartanGeneration`). For every `ψ ∈ R` there is an operator `T`
in the algebra `secondLeviCartanAlgebra` generated by the positive modes of the three families
such that `π(ψ φ)` is represented by `T x` whenever `π(φ)` is represented by `x`.

Every element of that algebra preserves every higher second Levi closure, and commutes with
every Levi current of mode `n` once currents of mode at least `n + 1` vanish. Consequently the
kernel of `π` is an ideal (`adjointSite_evaluation_mul_eq_zero`), and so is the kernel of
`φ ↦ F(n) π(φ)` (`adjointSite_lowering_mul_eq_zero`).
-/

namespace VOA.DeligneAudit.SL4T

open MvPolynomial VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.A3Sector

noncomputable section

attribute [local instance 2000] Fin.fintype Fin.instOfNat

/-- The operators preserving a fixed subspace form a subalgebra. -/
def submoduleStabilizerAlgebra {W : Type} [AddCommGroup W] [Module ℂ W] (N : Submodule ℂ W) :
    Subalgebra ℂ (Module.End ℂ W) where
  carrier := {T | N ≤ N.comap T}
  mul_mem' := fun hS hT _ hx => hS (hT hx)
  add_mem' := fun hS hT _ hx => N.add_mem (hS hx) (hT hx)
  algebraMap_mem' := fun c x hx => by
    change (algebraMap ℂ (Module.End ℂ W) c) x ∈ N
    rw [Module.algebraMap_end_apply]
    exact N.smul_mem c hx

/-! ### Newton generation of the mixed ring -/

/-- Newton coefficients lie in the algebra generated by the positive power sums. -/
theorem newtonCoeff_mem_adjoin {R : Type*} [CommRing R] [Algebra ℂ R] (p : ℕ → R) (n : ℕ) :
    newtonCoeff p n ∈ Algebra.adjoin ℂ (Set.range fun s => p (s + 1)) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    cases n with
    | zero => rw [newtonCoeff]; exact Subalgebra.one_mem _
    | succ n =>
      rw [newtonCoeff]
      apply Subalgebra.smul_mem
      apply Subalgebra.sum_mem
      intro i _
      apply Subalgebra.mul_mem
      · have hi : n + 1 - i.val = (n - i.val) + 1 := by have := i.isLt; omega
        rw [hi]
        exact Algebra.subset_adjoin ⟨n - i.val, rfl⟩
      · exact ih i.val (by have := i.isLt; omega)

set_option synthInstance.maxHeartbeats 100000 in
-- Mixed rings are quotients of a polynomial algebra in countably many variables.
/-- The positive power sums of the five alphabets generate the mixed ring. -/
theorem mixedRing_adjoin_powerSums (q : MixedParams) :
    Algebra.adjoin ℂ {x : MixedRing q | ∃ i s,
      x = mixedAlphabetPowerSum (mixedEvaluation q) i (mixedLengths q i) (s + 1)} = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mkₐ_surjective ℂ (mixedIdeal q) x
  change mixedEvaluation q f ∈ _
  induction f using MvPolynomial.induction_on with
  | C z =>
    rw [MvPolynomial.C_eq_smul_one, map_smul, map_one]
    exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) z
  | add f g hf hg => rw [map_add]; exact Subalgebra.add_mem _ hf hg
  | mul_X f z hf =>
    rw [map_mul]
    apply Subalgebra.mul_mem _ hf
    rcases z with ⟨i, n⟩
    have hX : (MvPolynomial.X (i, n) : MixedPoly) = mixedE i (n + 1) := by
      simp [mixedE, mixedAlphabet]
    have hn := newtonCoeff_powerSumOfCoeff (mixedLengths q i)
      (fun k => (-1) ^ k * mixedEvaluation q (mixedE i k))
      (by simp [mixedE, mixedAlphabet]) (n + 1)
    have he : mixedEvaluation q (mixedE i (n + 1)) =
        (-1) ^ (n + 1) * newtonCoeff
          (mixedAlphabetPowerSum (mixedEvaluation q) i (mixedLengths q i)) (n + 1) := by
      rw [mixedAlphabetPowerSum, hn, ← mul_assoc, ← pow_add, ← two_mul, pow_mul]
      simp
    rw [hX, he]
    apply Subalgebra.mul_mem _ (Subalgebra.pow_mem _
      (Subalgebra.neg_mem _ (Subalgebra.one_mem _)) _)
    refine Algebra.adjoin_mono ?_ (newtonCoeff_mem_adjoin _ (n + 1))
    rintro _ ⟨s, rfl⟩
    exact ⟨i, s, rfl⟩

/-! ### The outer alphabets at labels one -/

/-- Power sums of an alphabet all of whose positive elementary classes vanish. -/
theorem powerSumOfCoeff_eq_zero_of_tail {R : Type*} [CommRing R] [Algebra ℂ R] (n : ℕ)
    (e : ℕ → R) (he : ∀ k, 0 < k → e k = 0) (s : ℕ) (hs : 0 < s) :
    powerSumOfCoeff n e s = 0 := by
  obtain ⟨m, rfl⟩ : ∃ m, s = m + 1 := ⟨s - 1, by omega⟩
  rw [powerSumOfCoeff, he (m + 1) (by omega)]
  simp [he _ (Nat.succ_pos _)]

