/-- Linear algebra of the three Cartan symbols at outer labels one: if `p₀ = p₂ = 0` and the
three symbols lie in a subalgebra, so do all five power sums (the determinant is `-4`). -/
theorem mem_of_threeCartanSymbols {R : Type*} [CommRing R] [Algebra ℂ R] (S : Subalgebra ℂ R)
    (p : Fin 5 → R) (hx₁ : p 0 = 0) (hx₃ : p 2 = 0) (h₀ : p 0 - p 3 - p 4 ∈ S)
    (h₆ : p 0 - p 1 - (2 : ℂ) • p 3 - p 4 ∈ S) (h₇ : p 1 - p 2 + p 3 - p 4 ∈ S) (i : Fin 5) :
    p i ∈ S := by
  have hp₀ : p 0 ∈ S := hx₁ ▸ S.zero_mem
  have hp₂ : p 2 ∈ S := hx₃ ▸ S.zero_mem
  have hg₂ : p 4 ∈ S := by
    have he : p 4 = (p 0 - p 3 - p 4) - (p 0 - p 1 - (2 : ℂ) • p 3 - p 4) -
        (p 1 - p 2 + p 3 - p 4) - p 2 := by module
    rw [he]
    exact S.sub_mem (S.sub_mem (S.sub_mem h₀ h₆) h₇) hp₂
  have hg₁ : p 3 ∈ S := by
    have he : p 3 = p 0 - p 4 - (p 0 - p 3 - p 4) := by module
    rw [he]
    exact S.sub_mem (S.sub_mem hp₀ hg₂) h₀
  have hx₂ : p 1 ∈ S := by
    have he : p 1 = (p 1 - p 2 + p 3 - p 4) + p 2 - p 3 + p 4 := by module
    rw [he]
    exact S.add_mem (S.sub_mem (S.add_mem h₇ hp₂) hg₁) hg₂
  match i with
  | 0 => exact hp₀
  | 1 => exact hx₂
  | 2 => exact hp₂
  | 3 => exact hg₁
  | 4 => exact hg₂

