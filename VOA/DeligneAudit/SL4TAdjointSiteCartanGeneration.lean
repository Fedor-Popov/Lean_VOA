-- The multiplicity target is built over nested tensor-product coefficient algebras.
/-- Once currents of mode at least `n + 1` vanish, the kernel of `φ ↦ F(n) π(φ)` is an ideal. -/
theorem adjointSite_lowering_mul_eq_zero (n : ℕ) (ht : ∀ i s v, n + 1 ≤ s → ρ.op i s v = 0)
    (ψ : MixedRing (mixedLabelBlockParams 1 B d e₁ e₂))
    (hψ : secondLeviQuotientLowering (radicalCountQuotCurrent ρ w d)
      (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂ n
        (mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv ψ).val = 0)
    (φ : MixedRing (mixedLabelBlockParams 1 B d e₁ e₂)) :
    secondLeviQuotientLowering (radicalCountQuotCurrent ρ w d)
      (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂ n
        (mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv (φ * ψ)).val = 0 := by
  set N := higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
    (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂ with hN
  obtain ⟨T, hTmem, hT⟩ := adjointSite_cartanGeneration ρ w B hW d e₁ e₂ hv φ
  obtain ⟨x, hx⟩ := N.mkQ_surjective (mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv ψ).val
  rw [← hT ψ x hx]
  have h4 : (radicalCountQuotCurrent ρ w d).op 4 n x ∈ N := by
    have h0 : N.mkQ ((radicalCountQuotCurrent ρ w d).op 4 n x) = 0 := by
      rw [← hψ, ← hx]
      rfl
    exact (Submodule.Quotient.mk_eq_zero N).mp h0
  have hc := (secondLeviCartanAlgebra_commute ρ w B hW d n ht 4 hTmem).eq
  change N.mkQ ((radicalCountQuotCurrent ρ w d).op 4 n (T x)) = 0
  rw [← Module.End.mul_apply, ← hc, Module.End.mul_apply]
  exact (Submodule.Quotient.mk_eq_zero N).mpr
    (secondLeviCartanAlgebra_higherSecondLevi ρ w B hW d e₁ e₂ hTmem h4)

end

