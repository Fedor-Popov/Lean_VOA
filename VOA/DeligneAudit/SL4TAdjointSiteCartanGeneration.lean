-- All five source alphabets share the same nested tensor-product coefficient algebra.
theorem mixedElementaryAlphabet_powerSum_val (a b c : ℕ) (d : Fin 3 → ℕ) (e₁ e₂ : ℕ)
    (i : Fin 5) (s : ℕ) :
    (mixedElementaryAlphabet a b c d e₁ e₂ i
      (powerSumOfCoeff (![d 0, d 1, d 2, e₁, e₂] i)
        (fun k => (-1) ^ k * elementary k) (s + 1))).val =
      secondLeviAlphabetSource a b c d e₁ e₂ i (s + 1) := by
  fin_cases i
  · change MvPolynomial.C (radicalGrassmannianAlphabet a b c d 0
      (powerSumOfCoeff (d 0) (fun k => (-1) ^ k * elementary k) (s + 1))) = _
    rw [radicalGrassmannianAlphabet_abstractPowerSum]
    rfl
  · change MvPolynomial.C (radicalGrassmannianAlphabet a b c d 1
      (powerSumOfCoeff (d 1) (fun k => (-1) ^ k * elementary k) (s + 1))) = _
    rw [radicalGrassmannianAlphabet_abstractPowerSum]
    rfl
  · change MvPolynomial.C (radicalGrassmannianAlphabet a b c d 2
      (powerSumOfCoeff (d 2) (fun k => (-1) ^ k * elementary k) (s + 1))) = _
    rw [radicalGrassmannianAlphabet_abstractPowerSum]
    rfl
  · change (secondLeviElementaryAlphabet e₁ e₂ 0
      (powerSumOfCoeff (if (0 : Fin 2) = 0 then e₁ else e₂)
        (fun k => (-1) ^ k * elementary k) (s + 1))).val = _
    rw [secondLeviElementaryAlphabet_powerSum]
    rfl
  · change (secondLeviElementaryAlphabet e₁ e₂ 1
      (powerSumOfCoeff (if (1 : Fin 2) = 0 then e₁ else e₂)
        (fun k => (-1) ^ k * elementary k) (s + 1))).val = _
    rw [secondLeviElementaryAlphabet_powerSum]
    rfl

/-- A linear combination of the positive power sums of the five mixed alphabets. -/
def mixedAlphabetCombination (q : MixedParams) (coef : Fin 5 → ℂ) (s : ℕ) : MixedRing q :=
  ∑ i, coef i • mixedAlphabetPowerSum (mixedEvaluation q) i (mixedLengths q i) s

/-- The same linear combination of source symbols. -/
def secondLeviAlphabetSourceCombination (a b c : ℕ) (d : Fin 3 → ℕ) (e₁ e₂ : ℕ)
    (coef : Fin 5 → ℂ) (s : ℕ) :
    MvPolynomial (SecondLeviModeSlot e₁ e₂) (RadicalGrassmannianRing a b c d) :=
  ∑ i, coef i • secondLeviAlphabetSource a b c d e₁ e₂ i s

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule bracketTable V) (w : V)

set_option maxHeartbeats 800000 in
-- Descent expands two quotient maps over a tensor-product coefficient algebra.
set_option synthInstance.maxHeartbeats 100000 in
/-- **Intertwining from a source symbol.** If an operator on the first Levi quotient preserves
the higher second Levi closure and acts on labelled-mode words as multiplication by a linear
combination of source symbols, then on the actual second Levi multiplicity it acts as
multiplication by the same combination of mixed power sums. -/
theorem mixedSecondLeviEvaluation_alphabetCombination (a b : ℕ)
    (hW : LocalWeylRel ρ w (weightABC a b a)) (d : Fin 3 → ℕ) (e₁ e₂ : ℕ)
    (hv : MixedValid (mixedLabelBlockParams a b d e₁ e₂)) (coef : Fin 5 → ℂ) (s : ℕ)
    (T : Module.End ℂ (V ⧸ higherRadicalCountClosure ρ w d))
    (hsym : ∀ P, T (secondLeviModeEvaluation (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂ P) =
      secondLeviModeEvaluation (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂
        (secondLeviAlphabetSourceCombination a b a d e₁ e₂ coef (s + 1) * P))
    (hT : higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂ ≤
      (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂).comap T)
    (φ : MixedRing (mixedLabelBlockParams a b d e₁ e₂))
    (x : V ⧸ higherRadicalCountClosure ρ w d)
    (hx : (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂).mkQ x =
      (mixedSecondLeviEvaluation ρ w a b hW d e₁ e₂ hv φ).val) :
    (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂).mkQ (T x) =
      (mixedSecondLeviEvaluation ρ w a b hW d e₁ e₂ hv
        (mixedAlphabetCombination (mixedLabelBlockParams a b d e₁ e₂) coef (s + 1) * φ)).val := by
  set N := higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
    (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂ with hN
  have hstep : N.mkQ (T x) = N.mapQ N T hT (N.mkQ x) := rfl
  rw [hstep, hx]
  have hlen : mixedLengths (mixedLabelBlockParams a b d e₁ e₂) = ![d 0, d 1, d 2, e₁, e₂] := by
    simp [mixedLengths, mixedLabelBlockParams]
  let I := secondLeviRelativeIdeal (B := RadicalGrassmannianRing a b a d) e₁ e₂
    (fun j => (a3KeyLabelInt b a j ⟨d 0, d 1, d 2, 0⟩).toNat) (radicalLeviPowerSum a b a d)
  let Y : secondLeviSymmetricModes (B := RadicalGrassmannianRing a b a d) e₁ e₂ :=
    ∑ i, coef i • mixedElementaryAlphabet a b a d e₁ e₂ i
      (powerSumOfCoeff (![d 0, d 1, d 2, e₁, e₂] i) (fun k => (-1) ^ k * elementary k) (s + 1))
  have hY : mixedToRadicalRelative a b d e₁ e₂ hv
      (mixedAlphabetCombination (mixedLabelBlockParams a b d e₁ e₂) coef (s + 1)) =
      Ideal.Quotient.mk I Y := by
    simp only [mixedAlphabetCombination, map_sum, map_smul, hlen,
      mixedToRadicalRelative_alphabetPowerSum, Y]
    rw [← Ideal.Quotient.mkₐ_eq_mk ℂ]
    simp only [map_smul]
  have hYval : Y.val = secondLeviAlphabetSourceCombination a b a d e₁ e₂ coef (s + 1) := by
    simp only [Y, secondLeviAlphabetSourceCombination, AddSubmonoidClass.coe_finsetSum,
      SetLike.val_smul, mixedElementaryAlphabet_powerSum_val]
  obtain ⟨P, hP⟩ := Ideal.Quotient.mk_surjective (mixedToRadicalRelative a b d e₁ e₂ hv φ)
  have hφ : (mixedSecondLeviEvaluation ρ w a b hW d e₁ e₂ hv φ).val =
      N.mkQ (secondLeviModeEvaluation (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂ P.val) := by
    change (radicalSecondLeviRelativeEvaluation ρ w a b a hW d e₁ e₂
      (mixedLabelBlockParams_dominant a b d e₁ e₂ hv)
      (mixedToRadicalRelative a b d e₁ e₂ hv φ)).val = _
    rw [← hP]
    rfl
  have hψ : (mixedSecondLeviEvaluation ρ w a b hW d e₁ e₂ hv
      (mixedAlphabetCombination (mixedLabelBlockParams a b d e₁ e₂) coef (s + 1) * φ)).val =
      N.mkQ (secondLeviModeEvaluation (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w a b a hW d) e₁ e₂ (Y.val * P.val)) := by
    change (radicalSecondLeviRelativeEvaluation ρ w a b a hW d e₁ e₂
      (mixedLabelBlockParams_dominant a b d e₁ e₂ hv)
      (mixedToRadicalRelative a b d e₁ e₂ hv _)).val = _
    rw [map_mul, hY, ← hP, ← map_mul]
    rfl
  rw [hφ, hψ, hYval, ← hsym]
  rfl

/-! ### The Cartan algebra of the first Levi quotient -/

variable (B : ℕ) (hW : LocalWeylRel ρ w (weightABC 1 B 1)) (d : Fin 3 → ℕ)

/-- The positive modes of the two Levi Cartan currents and of the outer alphabet current. -/
def secondLeviCartanGenerators : Set (Module.End ℂ (V ⧸ higherRadicalCountClosure ρ w d)) :=
  {T | ∃ s, 0 < s ∧ (T = (radicalCountQuotCurrent ρ w d).op 6 s ∨
    T = (radicalCountQuotCurrent ρ w d).op 7 s ∨
      T = radicalAlphabetQuotCurrent ρ w 1 B 1 hW d 0 s)}

/-- The algebra generated by the positive Cartan modes on the first Levi quotient. -/
def secondLeviCartanAlgebra : Subalgebra ℂ (Module.End ℂ (V ⧸ higherRadicalCountClosure ρ w d)) :=
  Algebra.adjoin ℂ (secondLeviCartanGenerators ρ w B hW d)

/-- Every element of the Cartan algebra preserves every higher second Levi closure. -/
theorem secondLeviCartanAlgebra_higherSecondLevi (e₁ e₂ : ℕ)
    {T : Module.End ℂ (V ⧸ higherRadicalCountClosure ρ w d)}
    (hT : T ∈ secondLeviCartanAlgebra ρ w B hW d) :
    higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂ ≤
      (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂).comap T := by
  have hle : secondLeviCartanAlgebra ρ w B hW d ≤ submoduleStabilizerAlgebra
      (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂) := by
    apply Algebra.adjoin_le
    rintro T ⟨s, hs, rfl | rfl | rfl⟩
    · exact a2LeviClosure_inv _ _ 6 s (by simp [a2Levi])
    · exact a2LeviClosure_inv _ _ 7 s (by simp [a2Levi])
    · exact higherSecondLeviCountClosure_outerAlphabet ρ w 1 B 1 hW d e₁ e₂ s hs
  exact hle hT

/-- Once currents of mode at least `n + 1` vanish, every element of the Cartan algebra commutes
with every Levi current of mode `n`. -/
theorem secondLeviCartanAlgebra_commute (n : ℕ) (ht : ∀ i s v, n + 1 ≤ s → ρ.op i s v = 0)
    (j : Fin 8) {T : Module.End ℂ (V ⧸ higherRadicalCountClosure ρ w d)}
    (hT : T ∈ secondLeviCartanAlgebra ρ w B hW d) :
    Commute T ((radicalCountQuotCurrent ρ w d).op j n) := by
  have hz (e : Fin 8) (s : ℕ) (hs : 0 < s) (x : V ⧸ higherRadicalCountClosure ρ w d) :
      (radicalCountQuotCurrent ρ w d).op e (s + n) x = 0 :=
    radicalCountQuot_truncated ρ w (n + 1) ht d e _ (by omega) x
  have hle : secondLeviCartanAlgebra ρ w B hW d ≤
      Subalgebra.centralizer ℂ {(radicalCountQuotCurrent ρ w d).op j n} := by
    apply Algebra.adjoin_le
    rintro T ⟨s, hs, hT⟩
    rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
    rintro _ rfl
    apply LinearMap.ext
    intro x
    change (radicalCountQuotCurrent ρ w d).op j n (T x) =
      T ((radicalCountQuotCurrent ρ w d).op j n x)
    rcases hT with rfl | rfl | rfl
    · have hc := (radicalCountQuotCurrent ρ w d).comm 6 j s n x
      rw [Finset.sum_eq_zero (fun e _ => by rw [hz e s hs x, smul_zero])] at hc
      exact (sub_eq_zero.mp hc).symm
    · have hc := (radicalCountQuotCurrent ρ w d).comm 7 j s n x
      rw [Finset.sum_eq_zero (fun e _ => by rw [hz e s hs x, smul_zero])] at hc
      exact (sub_eq_zero.mp hc).symm
    · rw [radicalAlphabetQuotCurrent_outer_levi_comm, hz j s hs x, smul_zero, add_zero]
  exact ((Subalgebra.mem_centralizer_iff ℂ).mp (hle hT) _ rfl).symm

/-! ### Lemma CI(i) -/

variable (e₁ e₂ : ℕ) (hv : MixedValid (mixedLabelBlockParams 1 B d e₁ e₂))

set_option synthInstance.maxHeartbeats 100000 in
-- The multiplicity target is built over nested tensor-product coefficient algebras.
/-- The mixed-ring elements whose multiplication on the second Levi multiplicity is realized by
an element of the Cartan algebra, for every choice of representatives. -/
def secondLeviCartanRealized :
    Subalgebra ℂ (MixedRing (mixedLabelBlockParams 1 B d e₁ e₂)) where
  carrier := {ψ | ∃ T ∈ secondLeviCartanAlgebra ρ w B hW d, ∀ φ x,
    (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
      (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂).mkQ x =
      (mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv φ).val →
    (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
      (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂).mkQ (T x) =
      (mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv (ψ * φ)).val}
  mul_mem' := by
    rintro ψ₁ ψ₂ ⟨T₁, hT₁, h₁⟩ ⟨T₂, hT₂, h₂⟩
    refine ⟨T₁ * T₂, Subalgebra.mul_mem _ hT₁ hT₂, fun φ x hx => ?_⟩
    rw [mul_assoc]
    exact h₁ _ _ (h₂ φ x hx)
  add_mem' := by
    rintro ψ₁ ψ₂ ⟨T₁, hT₁, h₁⟩ ⟨T₂, hT₂, h₂⟩
    refine ⟨T₁ + T₂, Subalgebra.add_mem _ hT₁ hT₂, fun φ x hx => ?_⟩
    rw [LinearMap.add_apply, map_add, h₁ φ x hx, h₂ φ x hx, add_mul, map_add]
    rfl
  algebraMap_mem' := by
    intro z
    refine ⟨algebraMap ℂ _ z, Subalgebra.algebraMap_mem _ z, fun φ x hx => ?_⟩
    rw [Module.algebraMap_end_apply, map_smul, hx, ← Algebra.smul_def, map_smul]
    rfl

set_option synthInstance.maxHeartbeats 100000 in
-- The multiplicity target is built over nested tensor-product coefficient algebras.
/-- The symbol of the middle Levi Cartan current `h₂(s)`. -/
theorem secondLeviCartanRealized_middleCartan (s : ℕ) :
    mixedAlphabetCombination (mixedLabelBlockParams 1 B d e₁ e₂) ![1, -1, 0, -2, -1] (s + 1) ∈
      secondLeviCartanRealized ρ w B hW d e₁ e₂ hv := by
  refine ⟨(radicalCountQuotCurrent ρ w d).op 6 (s + 1),
    Algebra.subset_adjoin ⟨s + 1, by omega, Or.inl rfl⟩, fun φ x hx => ?_⟩
  refine mixedSecondLeviEvaluation_alphabetCombination ρ w 1 B hW d e₁ e₂ hv _ s _ (fun P => ?_)
    (a2LeviClosure_inv _ _ 6 (s + 1) (by simp [a2Levi])) φ x hx
  have hc := secondLeviModeEvaluation_cartan (radicalCountQuotCurrent ρ w d)
    (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂ 0 (s + 1) _
    (radicalGrassmannianAmbientEvaluation_cartan ρ w 1 B 1 hW d 0 (s + 1) (by omega)) P
  simp only [↓reduceIte] at hc
  rw [hc]
  congr 2
  simp [secondLeviAlphabetSourceCombination, Fin.sum_univ_five, secondLeviAlphabetSource,
    radicalLeviPowerSum]
  module

