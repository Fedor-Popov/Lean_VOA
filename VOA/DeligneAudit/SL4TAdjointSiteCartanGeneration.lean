-- The multiplicity target is built over nested tensor-product coefficient algebras.
/-- **Lemma CI(i), Cartan generation at one adjoint site.** For every `ψ` in the mixed ring
there is an element `T` of the Cartan algebra such that, whenever `x` represents `π(φ)` in the
second Levi quotient, `T x` represents `π(ψ φ)`. -/
theorem adjointSite_cartanGeneration (ψ : MixedRing (mixedLabelBlockParams 1 B d e₁ e₂)) :
    ∃ T ∈ secondLeviCartanAlgebra ρ w B hW d, ∀ φ x,
      (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂).mkQ x =
        (mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv φ).val →
      (higherSecondLeviCountClosure (radicalCountQuotCurrent ρ w d)
        (radicalGrassmannianAmbientEvaluation ρ w 1 B 1 hW d) e₁ e₂).mkQ (T x) =
        (mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv (ψ * φ)).val := by
  have hle : Algebra.adjoin ℂ {x : MixedRing (mixedLabelBlockParams 1 B d e₁ e₂) | ∃ i s,
      x = mixedAlphabetPowerSum (mixedEvaluation (mixedLabelBlockParams 1 B d e₁ e₂)) i
        (mixedLengths (mixedLabelBlockParams 1 B d e₁ e₂) i) (s + 1)} ≤
      secondLeviCartanRealized ρ w B hW d e₁ e₂ hv := by
    apply Algebra.adjoin_le
    rintro _ ⟨i, s, rfl⟩
    exact secondLeviCartanRealized_powerSum ρ w B hW d e₁ e₂ hv i s
  rw [mixedRing_adjoin_powerSums] at hle
  exact hle Algebra.mem_top

