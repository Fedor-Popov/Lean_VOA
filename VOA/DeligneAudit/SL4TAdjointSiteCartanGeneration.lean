-- The multiplicity target is built over nested tensor-product coefficient algebras.
/-- The kernel of the second Levi multiplicity evaluation is an ideal. -/
theorem adjointSite_evaluation_mul_eq_zero (ψ : MixedRing (mixedLabelBlockParams 1 B d e₁ e₂))
    (hψ : mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv ψ = 0)
    (φ : MixedRing (mixedLabelBlockParams 1 B d e₁ e₂)) :
    mixedSecondLeviEvaluation ρ w 1 B hW d e₁ e₂ hv (φ * ψ) = 0 := by
  obtain ⟨T, -, hT⟩ := adjointSite_cartanGeneration ρ w B hW d e₁ e₂ hv φ
  have h := hT ψ 0 (by rw [map_zero, hψ]; rfl)
  rw [map_zero, map_zero] at h
  exact Subtype.ext h.symm

