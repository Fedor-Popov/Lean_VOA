import VOA.DeligneAudit.SL4TSecondLeviBlockRelations
import VOA.DeligneAudit.SL4TMixedCellBound

/-! The mixed cell bound on actual last-root orbits in a truncated sl₄ current module. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.A3Sector

variable {B V : Type} [CommRing B] [Algebra ℂ B]
variable [AddCommGroup V] [Module ℂ V]

/-- The last-root current module generated by the actual second multiplicity subspace. -/
def secondLeviOrbit (Q : CurrentModule VOA.AffineSl3.bracketTable V)
    (β : B →ₗ[ℂ] V) (e₁ e₂ : ℕ) :
    Submodule ℂ (V ⧸ higherSecondLeviCountClosure Q β e₁ e₂) :=
  currentSpan (secondLeviQuotientRaising Q β e₁ e₂)
    (secondLeviQuotientCartan Q β e₁ e₂ 1) (secondLeviQuotientLowering Q β e₁ e₂)
      (secondLeviMultiplicity Q β e₁ e₂)

variable (ρ : CurrentModule bracketTable V) (w : V)
variable (a b c : ℕ) (h : LocalWeylRel ρ w (weightABC a b c))

/-- The first multiplicity image has the natural dominant last-root weight. -/
theorem radicalGrassmannianAmbientEvaluation_weight (d : Fin 3 → ℕ)
    (i : Fin 2) (hm : 0 ≤ a3KeyLabelInt b c i ⟨d 0, d 1, d 2, 0⟩)
    (φ : RadicalGrassmannianRing a b c d) :
    (radicalCountQuotCurrent ρ w d).op (if i = 0 then 6 else 7) 0
      (radicalGrassmannianAmbientEvaluation ρ w a b c h d φ) =
        ((a3KeyLabelInt b c i ⟨d 0, d 1, d 2, 0⟩).toNat : ℂ) •
          radicalGrassmannianAmbientEvaluation ρ w a b c h d φ := by
  obtain ⟨v, hv, he⟩ := (radicalGrassmannianEvaluation ρ w a b c h d φ).property
  change (radicalCountQuotCurrent ρ w d).op _ 0
    (radicalGrassmannianEvaluation ρ w a b c h d φ).val = _
  change _ = _ • (radicalGrassmannianEvaluation ρ w a b c h d φ).val
  rw [← he, radicalCountQuot_cartan_zero ρ w a b c h d i hv, a3KeyLabel_eq_int]
  rw [← Int.cast_natCast, Int.toNat_of_nonneg hm]

/-- The current cutoff survives the first Levi quotient. -/
theorem radicalCountQuot_truncated (M : ℕ)
    (ht : ∀ i s v, M ≤ s → ρ.op i s v = 0) (d : Fin 3 → ℕ)
    (i : Fin 8) (s : ℕ) (hs : M ≤ s) (x : V ⧸ higherRadicalCountClosure ρ w d) :
    (radicalCountQuotCurrent ρ w d).op i s x = 0 := by
  obtain ⟨v, rfl⟩ := (higherRadicalCountClosure ρ w d).mkQ_surjective x
  change (higherRadicalCountClosure ρ w d).mkQ (ρ.op (a3LeviColour i) s v) = 0
  rw [ht _ _ _ hs, map_zero]

set_option synthInstance.maxHeartbeats 100000 in
-- The multiplicity source is a tensor product of quotient algebras.
/-- Every valid mixed block in a truncated current module obeys its cell contribution bound. -/
theorem mixedSecondLeviOrbit_bound
    (h : LocalWeylRel ρ w (weightABC a b a))
    (ht : ∀ i s v, a + b ≤ s → ρ.op i s v = 0)
    (d : Fin 3 → ℕ) (e₁ e₂ : ℕ)
    (hv : MixedValid (mixedLabelBlockParams a b d e₁ e₂)) :
    let Q := radicalCountQuotCurrent ρ w d
    let β := radicalGrassmannianAmbientEvaluation ρ w a b a h d
    FiniteDimensional ℂ (secondLeviOrbit Q β e₁ e₂) ∧
      Module.finrank ℂ (secondLeviOrbit Q β e₁ e₂) ≤
        mixedBlockBound (mixedLabelBlockParams a b d e₁ e₂) := by
  let Q := radicalCountQuotCurrent ρ w d
  let β := radicalGrassmannianAmbientEvaluation ρ w a b a h d
  let N := higherSecondLeviCountClosure Q β e₁ e₂
  let q := mixedLabelBlockParams a b d e₁ e₂
  let E := secondLeviQuotientRaising Q β e₁ e₂
  let H := secondLeviQuotientCartan Q β e₁ e₂ 1
  let F := secondLeviQuotientLowering Q β e₁ e₂
  let π := (secondLeviMultiplicity Q β e₁ e₂).subtype.comp
    (mixedSecondLeviEvaluation ρ w a b h d e₁ e₂ hv)
  let q₀ := (a3KeyLabelInt b a 1 ⟨d 0, d 1, d 2, 0⟩).toNat
  have hm := mixedLabelBlockParams_dominant a b d e₁ e₂ hv 1
  have hw : mixedWeight q = (q₀ : ℤ) + e₁ - e₂ := by
    dsimp only [q₀]
    rw [Int.toNat_of_nonneg hm]
    simp [q, mixedWeight, mixedQ, mixedLabelBlockParams, a3KeyLabelInt]
    ring
  have hwpos : 0 ≤ mixedWeight q := by
    have : MixedValid q := hv
    simp only [MixedValid] at this
    unfold mixedWeight
    omega
  have he : ∀ s φ, Q.op 1 s (β φ) = 0 :=
    fun s φ => radicalGrassmannianAmbientEvaluation_raising ρ w a b a h d 1 s φ
  have hh : ∀ φ, Q.op 7 0 (β φ) = (q₀ : ℂ) • β φ :=
    radicalGrassmannianAmbientEvaluation_weight ρ w a b a h d 1 hm
  have hf : ∀ φ, (Q.op 4 0 ^ (q₀ + 1)) (β φ) = 0 :=
    radicalGrassmannianAmbientEvaluation_lowering ρ w a b a h d 1 hm
  have hb := mixedRingImage_bound q hv (secondLeviQuotient_currentRelations Q β e₁ e₂) π
    (fun s φ => secondLeviMultiplicity_raising Q β he e₁ e₂ s
      (mixedSecondLeviEvaluation ρ w a b h d e₁ e₂ hv φ))
    (fun φ => by
      have hz := secondLeviMultiplicity_weight Q β q₀ hh e₁ e₂
        (mixedSecondLeviEvaluation ρ w a b h d e₁ e₂ hv φ)
      rw [← hw] at hz
      rw [← Int.cast_natCast, Int.toNat_of_nonneg hwpos]
      exact hz)
    (fun s hs φ => mixedSecondLeviEvaluation_cartan ρ w a b h d e₁ e₂ hv s hs φ)
    (fun φ => by
      have hz := (secondLeviMultiplicity_lowering_sharp Q β q₀ he hh hf e₁ e₂
        (mixedSecondLeviEvaluation ρ w a b h d e₁ e₂ hv φ)).2
      rw [← hw] at hz
      exact hz hwpos)
    (fun s hs φ => by
      obtain ⟨x, hx⟩ := N.mkQ_surjective (π φ)
      rw [← hx]
      change N.mkQ (Q.op 4 s x) = 0
      rw [radicalCountQuot_truncated ρ w (a + b) ht d 4 s (by
        simpa [q, mixedLabelBlockParams, Int.toNat_add] using hs) x, map_zero])
  have hr : Set.range π = (secondLeviMultiplicity Q β e₁ e₂ : Set _) := by
    ext x
    constructor
    · rintro ⟨φ, rfl⟩
      exact (mixedSecondLeviEvaluation ρ w a b h d e₁ e₂ hv φ).property
    · intro hx
      obtain ⟨φ, hφ⟩ := mixedSecondLeviEvaluation_surjective ρ w a b h d e₁ e₂ hv ⟨x, hx⟩
      exact ⟨φ, congrArg Subtype.val hφ⟩
  rw [hr] at hb
  exact hb

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.radicalGrassmannianAmbientEvaluation_weight
#print axioms VOA.DeligneAudit.SL4T.radicalCountQuot_truncated
#print axioms VOA.DeligneAudit.SL4T.mixedSecondLeviOrbit_bound
