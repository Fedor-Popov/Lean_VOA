def pairsOf : List ℕ → SVL
  | c :: z :: r => (c, decZ z) :: pairsOf r
  | _ => []

/-- The `𝔢₈` brackets: the cert table `e8T`. -/
def br (a b : ℕ) : SVL := VOA.AffineGeneral.SCLie.entry VOA.DeligneAudit.DeligneCarrier.E8.e8T a b

/-- Relation `k` (`3875` = Casimir), as an integer sparse form. -/
def relZ8 (k : ℕ) : QVL :=
  if k < 3875 then VOA.DeligneAudit.DeligneCarrier.E8.relQ k else VOA.DeligneAudit.DeligneCarrier.E8.qQ

/-- Index ranges of the relations. -/
def relRange8 : Bool :=
  (List.range 3876).all fun r => (relZ8 r).all fun t => decide (t.1 < 248) && decide (t.2.1 < 248)

/-- Decode flat `j z` pairs. -/
def zpairs : List ℕ → List (ℕ × ℤ)
  | j :: z :: r => (j, decZ z) :: zpairs r
  | _ => []

/-- Table `i`. -/
def tab (i : ℕ) : QVL := quadOf ((tabR.getD (i / 248) []).getD (i % 248) [])

/-- Tree data of node `i`. -/
def par (i : ℕ) : ℕ × Bool × ℕ × ℕ × ℕ :=
  let l := (parR.getD (i / 248) []).getD (i % 248) []
  (l.getD 0 0, l.getD 1 0 == 1, l.getD 2 0, l.getD 3 0, l.getD 4 0)

/-- The table `U_k`. -/
def Uq (k : ℕ) : QVL := quadOf ((UR.getD (k / 204) []).getD (k % 204) [])

/-- The certificate of `U_k`. -/
def Ucert (k : ℕ) : List (ℕ × ℤ) := zpairs ((UcR.getD (k / 204) []).getD (k % 204) [])

/-- The antisymmetric certificate of `(c, d)`. -/
def antiCert (c d : ℕ) : List (ℕ × ℤ) := zpairs ((antiR.getD c []).getD d [])

/-- The symmetric certificate of `(c, d)`. -/
def symCert (c d : ℕ) : List (ℕ × ℤ) := zpairs ((symR.getD c []).getD d [])

/-- The relations containing the monomial `{c, d}`. -/
def psiT (c d : ℕ) : List ℕ := (psiR.getD c []).getD d []

/-- Bracket columns. -/
def colE8 (x e : ℕ) : SVL := pairsOf ((colR.getD x []).getD e [])

/-- `ψ_k(c,d) = q_k(c,d) + q_k(d,c)`. -/
def psiZ (k c d : ℕ) : ℤ := qgetL (relZ8 k) c d + qgetL (relZ8 k) d c

/-- `e_c⊗e_d + e_d⊗e_c`. -/
def symQ (c d : ℕ) : QVL := [(c, d, 1), (d, c, 1)]

/-- `e_c⊗e_d - e_d⊗e_c`. -/
def antiQ (c d : ℕ) : QVL := [(c, d, 1), (d, c, -1)]

/-- All entries are tree nodes of level `≤ ℓ`. -/
def levOf (L : List (ℕ × ℤ)) (ℓ : ℕ) : Bool :=
  L.all fun p => decide (p.1 < 61504) && decide ((par p.1).2.2.2.2 ≤ ℓ)

/-! ## Range checks (chunked kernel checks are glued by `rangeAll_split`) -/

/-- `f i = true` for all `i ∈ [lo, hi)`. -/
def rangeAll (f : ℕ → Bool) (lo hi : ℕ) : Bool := (List.range' lo (hi - lo)).all f

theorem rangeAll_split (f : ℕ → Bool) {lo mid hi : ℕ} (h1 : lo ≤ mid) (h2 : mid ≤ hi)
    (ha : rangeAll f lo mid = true) (hb : rangeAll f mid hi = true) : rangeAll f lo hi = true := by
  unfold rangeAll at *
  have e : hi - lo = (mid - lo) + (hi - mid) := by omega
  have e2 : lo + (mid - lo) = mid := by omega
  rw [e, ← List.range'_append_1, List.all_append, Bool.and_eq_true, e2]
  exact ⟨ha, hb⟩

theorem rangeAll_sound {f : ℕ → Bool} {lo hi : ℕ} (h : rangeAll f lo hi = true) {i : ℕ}
    (h1 : lo ≤ i) (h2 : i < hi) : f i = true := by
  simp only [rangeAll, List.all_eq_true, List.mem_range'_1] at h
  exact h i ⟨h1, by omega⟩

/-- Tree node check. -/
def nodeP (i : ℕ) : Bool := nodeCheckCL 248 colE8 tab par i

/-- Column check of row `x`. -/
def colP (x : ℕ) : Bool := colCheckL br colE8 248 x

/-- Depth bound of node `i`. -/
def depthP (i : ℕ) : Bool := decide ((par i).2.2.2.1 ≤ 4)

/-- The antisymmetric check for `(c, d)`. -/
def antiCheck (c d : ℕ) : Bool :=
  levOf (antiCert c d) 1 && encLinL 248 tab (smulQL 120 (antiQ c d)) (antiCert c d)

/-- The check of `U_k`. -/
def UCheck (k : ℕ) : Bool :=
  levOf (Ucert k) 2 && encLinL 248 tab (Uq k) (Ucert k)

/-- Tree tables (`i < 61504`) followed by the complement tables (`61504 + k`). -/
def tabX (i : ℕ) : QVL := if i < 61504 then tab i else Uq (i - 61504)

/-- The full symmetric certificate: tree tables and `ψ_k(c,d) U_k`. -/
def symCertX (c d : ℕ) : List (ℕ × ℤ) :=
  symCert c d ++ (psiT c d).map fun k => (61504 + k, psiZ k c d)

/-- The symmetric check for `(c, d)`. -/
def symCheck (c d : ℕ) : Bool :=
  levOf (symCert c d) 0 && (psiT c d).Nodup && (psiT c d).all (fun k => decide (k < 3876)) &&
    encLinL 248 tabX (smulQL 96 (symQ c d)) (symCertX c d)

/-- Completeness of `psiT` for relation `k`: every term `(i, j)` is listed under `{min, max}`. -/
def psiP (k : ℕ) : Bool :=
  (relZ8 k).all fun t => decide (k ∈ psiT (min t.1 t.2.1) (max t.1 t.2.1))

/-- The antisymmetric check at the pair index `p = 248 c + d` (vacuous unless `c < d`). -/
def antiP (p : ℕ) : Bool := !decide (p / 248 < p % 248) || antiCheck (p / 248) (p % 248)

/-- The symmetric check at the pair index `p = 248 c + d` (vacuous unless `c ≤ d`). -/
def symP (p : ℕ) : Bool := !decide (p / 248 ≤ p % 248) || symCheck (p / 248) (p % 248)

end VOA.DeligneAudit.DeligneDivisor.E8
