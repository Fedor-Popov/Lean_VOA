import VOA.DeligneAudit.SL4TSinglyMarkedFlagConfiguration
import VOA.DeligneAudit.SL4TMarkedFlagLayerBound

/-!
# The unmarked product in the singly marked full flag

Since the singly marked ring has exactly its configuration dimension
(`singlyMarkedFlag_finrank_eq`), every layer of an unmarked root has the dimension of its child
ring (`singlyMarkedLayer_finrank_eq_same`, `singlyMarkedLayer_finrank_eq_lower`), so the layer
maps are isomorphisms.

The ideal generated by the product `π` of the unmarked roots then has dimension at least the
number of configurations whose first double site carries two marked roots,
`q · C(q - 1, 2) · (B - 2)!/2^(k-1)` (`singlyMarkedFlag_unmarkedProduct_finrank_ge`). The proof
deletes an unmarked root `y`: `π = y π'`, and in the layer `j ≥ 1` the image of `π' C` is the
image of the product ideal of the child, through the injective layer map; the layer lower bound
`layer_finrank_sum_le` adds these up.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

/-- Removing the first double site: `B!/2^k = C(B, 2) · (B - 2)!/2^(k-1)`. -/
theorem fullFlagConfiguration_card_two_less (B k : ℕ) (hk1 : 1 ≤ k) (hk : 2 * k ≤ B) :
    Nat.card (FullFlagConfiguration B k) =
      B.choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 1)) := by
  have h1 := fullFlagConfiguration_card_closed B k hk
  have h2 := fullFlagConfiguration_card_closed (B - 2) (k - 1) (by omega)
  have h3 := Nat.choose_mul_factorial_mul_factorial (show 2 ≤ B by omega)
  have hp : 0 < 2 ^ k := by positivity
  apply Nat.eq_of_mul_eq_mul_left hp
  rw [h1]
  calc B.factorial = B.choose 2 * Nat.factorial 2 * (B - 2).factorial := h3.symm
    _ = B.choose 2 * 2 * (2 ^ (k - 1) * Nat.card (FullFlagConfiguration (B - 2) (k - 1))) := by
        rw [h2]; rfl
    _ = 2 ^ (k - 1 + 1) * (B.choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 1))) := by
        ring
    _ = 2 ^ k * (B.choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 1))) := by
        rw [Nat.sub_add_cancel hk1]

/-! ### Exact layers -/

section Exact

variable (B k : ℕ) (hk : 2 * k ≤ B + 1) (V : Finset (Fin (B + 2))) (hV : V.Nonempty)
  (u : Fin (B + 2)) (hu : u ∉ V)
include hk hV hu

/-- The layer bound of every layer of an unmarked root is attained. -/
theorem singlyMarkedLayer_finrank_eq (i : ℕ) (hi : i < B + 1 - k) :
    Module.finrank ℂ (SinglyMarkedFlagRing (B + 2) V (B + 1 - k) ⧸ rootPowerLayerIdeal
        (quotientRoot (singlyMarkedFlagIdeal (B + 2) V (B + 1 - k)) u) i) =
      if i < k then Module.finrank ℂ (SinglyMarkedFlagRing (B + 1) (deletedGroup u V) (B + 1 - k))
      else Module.finrank ℂ (SinglyMarkedFlagRing (B + 1) (deletedGroup u V) (B - k)) := by
  classical
  set h := B + 1 - k with hh
  set r := quotientRoot (singlyMarkedFlagIdeal (B + 2) V h)
  have hV' : (deletedGroup u V).Nonempty := by
    rw [← Finset.card_pos, deletedGroup_card_of_notMem V u hu]
    exact Finset.card_pos.mpr hV
  have hcard := deletedGroup_card_of_notMem V u hu
  let a : ℕ → ℕ := fun j => Module.finrank ℂ (SinglyMarkedFlagRing (B + 2) V h ⧸
    rootPowerLayerIdeal (r u) j)
  let b : ℕ → ℕ := fun j => if j < k then
    Module.finrank ℂ (SinglyMarkedFlagRing (B + 1) (deletedGroup u V) h)
    else Module.finrank ℂ (SinglyMarkedFlagRing (B + 1) (deletedGroup u V) (B - k))
  have hab : ∀ j ∈ Finset.range h, a j ≤ b j := by
    intro j hj
    simp only [a, b]
    split_ifs with hjk
    · exact singlyMarkedLayer_finrank_le_same (B + 1) V h u hu j
    · have hl := singlyMarkedLayer_finrank_le_lower (B + 1) V h k (by omega) (by omega) u hu j
        (by omega)
      rwa [show h - 1 = B - k by omega] at hl
  have hb : ∀ j ∈ Finset.range h, b j = if j < k then
      V.card * Nat.card (FullFlagConfiguration B (k - 1))
      else V.card * Nat.card (FullFlagConfiguration B k) := by
    intro j hj
    simp only [b]
    split_ifs with hjk
    · rw [show h = B - (k - 1) by omega, singlyMarkedFlag_finrank_eq B (k - 1) (by omega) _ hV',
        hcard]
    · rw [singlyMarkedFlag_finrank_eq B k (by have := Finset.mem_range.mp hj; omega) _ hV', hcard]
  have hsum : ∑ j ∈ Finset.range h, a j = ∑ j ∈ Finset.range h, b j := by
    rw [Finset.sum_congr rfl hb, sum_range_ite_lt h k _ _ (by omega)]
    simp only [a]
    rw [← rootPowerFiltration_finrank (r u) h (singlyMarkedFlag_unmarked_cutoff _ _ _ _ hu),
      show h = (B + 1) - k by rfl, singlyMarkedFlag_finrank_eq (B + 1) k hk V hV,
      fullFlagConfiguration_card_recursion B k hk, show B + 1 - k - k = B + 1 - k - k by rfl]
    rw [show (B + 1 - k - k) = h - k by omega]
    ring
  exact ((Finset.sum_eq_sum_iff_of_le hab).mp hsum) i (Finset.mem_range.mpr hi)

/-- The layer maps of an unmarked root with the same cutoff are injective. -/
theorem singlyMarkedLayerMap_injective_same (i : ℕ) (hi : i < k) (hik : i < B + 1 - k) :
    Function.Injective (deletedLayerMap
      (quotientRoot (singlyMarkedFlagIdeal (B + 2) V (B + 1 - k))) u i _
      (singlyMarkedLayer_same_le_ker (B + 1) V (B + 1 - k) u hu i)) := by
  have he := singlyMarkedLayer_finrank_eq B k hk V hV u hu i hik
  rw [if_pos hi] at he
  have hs := deletedLayerMap_surjective _ (quotientRoot_aeval_surjective _) u i _
    (singlyMarkedLayer_same_le_ker (B + 1) V (B + 1 - k) u hu i)
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (f := (deletedLayerMap _ u i _ (singlyMarkedLayer_same_le_ker (B + 1) V (B + 1 - k) u hu
      i)).toLinearMap) he.symm).mpr hs

/-- The layer maps of an unmarked root with lowered cutoff are injective. -/
theorem singlyMarkedLayerMap_injective_lower (i : ℕ) (hi : k ≤ i) (hik : i < B + 1 - k) :
    Function.Injective (deletedLayerMap
      (quotientRoot (singlyMarkedFlagIdeal (B + 2) V (B + 1 - k))) u i _
      (singlyMarkedLayer_lower_le_ker (B + 1) V (B + 1 - k) k (by omega) (by omega) u hu i
        hi)) := by
  have he := singlyMarkedLayer_finrank_eq B k hk V hV u hu i hik
  rw [if_neg (by omega)] at he
  rw [show B - k = B + 1 - k - 1 by omega] at he
  have hs := deletedLayerMap_surjective _ (quotientRoot_aeval_surjective _) u i _
    (singlyMarkedLayer_lower_le_ker (B + 1) V (B + 1 - k) k (by omega) (by omega) u hu i hi)
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (f := (deletedLayerMap _ u i _ (singlyMarkedLayer_lower_le_ker (B + 1) V (B + 1 - k) k
      (by omega) (by omega) u hu i hi)).toLinearMap) he.symm).mpr hs

end Exact

/-! ### The product ideal -/

/-- Through an injective layer map, the product ideal of the child is at most as large as the
image of the product ideal of the remaining unmarked roots in the layer. -/
theorem childProduct_finrank_le_layer {C : Type*} [CommRing C] [Algebra ℂ C]
    [FiniteDimensional ℂ C] {n : ℕ}
    (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ) (I' : Ideal (MvPolynomial (Fin n) ℂ))
    (hI' : I' ≤ RingHom.ker (aeval (deletedLayerRoot r u i)).toRingHom)
    (hinj : Function.Injective (deletedLayerMap r u i I' hI')) (S : Finset (Fin n)) :
    Module.finrank ℂ ((Ideal.span {∏ j ∈ S, quotientRoot I' j}).restrictScalars ℂ) ≤
      Module.finrank ℂ (((Ideal.span {∏ j ∈ S, r (u.succAbove j)}).restrictScalars ℂ).map
        (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) i)).toLinearMap) := by
  let ψ := deletedLayerMap r u i I' hI'
  haveI : FiniteDimensional ℂ (C ⧸ rootPowerLayerIdeal (r u) i) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ ℂ _).toLinearMap
      (Ideal.Quotient.mkₐ_surjective ℂ _)
  rw [LinearEquiv.finrank_eq (Submodule.equivMapOfInjective ψ.toLinearMap hinj
    ((Ideal.span {∏ j ∈ S, quotientRoot I' j}).restrictScalars ℂ))]
  apply Submodule.finrank_mono
  rintro _ ⟨x, hx, rfl⟩
  rw [SetLike.mem_coe, Submodule.restrictScalars_mem, Ideal.mem_span_singleton'] at hx
  obtain ⟨a, rfl⟩ := hx
  obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (ψ a)
  refine ⟨c * ∏ j ∈ S, r (u.succAbove j), ?_, ?_⟩
  · rw [SetLike.mem_coe, Submodule.restrictScalars_mem]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  · have hp : ψ (∏ j ∈ S, quotientRoot I' j) =
        Ideal.Quotient.mk _ (∏ j ∈ S, r (u.succAbove j)) := by
      rw [show (∏ j ∈ S, quotientRoot I' j) = Ideal.Quotient.mk I' (∏ j ∈ S, X j) by
        simp [quotientRoot]]
      change aeval (deletedLayerRoot r u i) (∏ j ∈ S, X j) = _
      simp [deletedLayerRoot]
    change Ideal.Quotient.mk _ (c * ∏ j ∈ S, r (u.succAbove j)) =
      ψ (a * ∏ j ∈ S, quotientRoot I' j)
    rw [map_mul, map_mul, hp, hc]

/-- **The unmarked product bound.** In the singly marked flag on `B + 1` roots with `k ≥ 1`
doubles and a nonempty marked group `V` of size `q`, the ideal generated by the product of the
unmarked roots has dimension at least `q · C(q - 1, 2) · (B - 2)!/2^(k-1)`. -/
theorem singlyMarkedFlag_unmarkedProduct_finrank_ge (B k : ℕ) (hk1 : 1 ≤ k) (hk : 2 * k ≤ B)
    (V : Finset (Fin (B + 1))) (hV : V.Nonempty) :
    V.card * (V.card - 1).choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 1)) ≤
      Module.finrank ℂ ((Ideal.span {∏ i ∈ Vᶜ,
        quotientRoot (singlyMarkedFlagIdeal (B + 1) V (B - k)) i}).restrictScalars ℂ) := by
  classical
  induction B generalizing k with
  | zero => omega
  | succ B ih =>
      by_cases hU : V = Finset.univ
      · subst hU
        have h1 : ∏ i ∈ (Finset.univ : Finset (Fin (B + 2)))ᶜ,
            quotientRoot (singlyMarkedFlagIdeal (B + 2) Finset.univ (B + 1 - k)) i = 1 :=
          Finset.prod_eq_one (by simp)
        rw [h1, Ideal.span_singleton_one, Submodule.restrictScalars_top, finrank_top,
          singlyMarkedFlag_finrank_eq (B + 1) k hk Finset.univ Finset.univ_nonempty,
          Finset.card_univ, Fintype.card_fin,
          fullFlagConfiguration_card_two_less (B + 1) k hk1 hk, Nat.add_sub_cancel, mul_assoc]
      obtain ⟨u, hu⟩ : ∃ u, u ∉ V := by
        by_contra hn
        apply hU
        apply Finset.eq_univ_iff_forall.mpr
        intro i
        by_contra hi
        exact hn ⟨i, hi⟩
      have hV' : (deletedGroup u V).Nonempty := by
        rw [← Finset.card_pos, deletedGroup_card_of_notMem V u hu]
        exact Finset.card_pos.mpr hV
      have hcard := deletedGroup_card_of_notMem V u hu
      let r := quotientRoot (singlyMarkedFlagIdeal (B + 2) V (B + 1 - k))
      let π' := ∏ j ∈ (deletedGroup u V)ᶜ, r (u.succAbove j)
      have hπ : ∏ i ∈ Vᶜ, r i = r u * π' := by
        rw [prod_eq_deletedGroup r Vᶜ u, if_pos (Finset.mem_compl.mpr hu), deletedGroup_compl]
      let I : Submodule ℂ (SinglyMarkedFlagRing (B + 2) V (B + 1 - k)) :=
        (Ideal.span {∏ i ∈ Vᶜ, r i}).restrictScalars ℂ
      let W : ℕ → Submodule ℂ (SinglyMarkedFlagRing (B + 2) V (B + 1 - k)) := fun j =>
        (Ideal.span {π' * r u ^ (1 - j)}).restrictScalars ℂ
      have hW : ∀ j < B + 1 - k, ∀ c ∈ W j, r u ^ j * c ∈
          I ⊔ (Ideal.span {r u ^ (j + 1)}).restrictScalars ℂ := by
        intro j _ c hc
        apply Submodule.mem_sup_left
        rw [Submodule.restrictScalars_mem, Ideal.mem_span_singleton'] at hc
        obtain ⟨d, rfl⟩ := hc
        change r u ^ j * (d * (π' * r u ^ (1 - j))) ∈ Ideal.span {∏ i ∈ Vᶜ, r i}
        rw [hπ]
        rcases Nat.eq_zero_or_pos j with rfl | hj
        · simp only [Nat.sub_zero, pow_zero, pow_one, one_mul]
          rw [show d * (π' * r u) = d * (r u * π') by ring]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
        · rw [show 1 - j = 0 by omega, pow_zero, mul_one]
          obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
          rw [show r u ^ (j' + 1) * (d * π') = (r u ^ j' * d) * (r u * π') by ring]
          exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      have hsum := layer_finrank_sum_le (r u) (B + 1 - k)
        (singlyMarkedFlag_unmarked_cutoff _ _ _ _ hu) I W hW
      have hterm : ∀ j ∈ Finset.range (B + 1 - k), (if j = 0 then 0 else if j < k then
          V.card * (V.card - 1).choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 2))
          else V.card * (V.card - 1).choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 1)))
          ≤ Module.finrank ℂ ((W j).map
            (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) j)).toLinearMap) := by
        intro j hj
        have hjh := Finset.mem_range.mp hj
        split_ifs with hj0 hjk
        · exact Nat.zero_le _
        · have hrec := ih (k - 1) (by omega) (by omega) (deletedGroup u V) hV'
          rw [show B - (k - 1) = B + 1 - k by omega, hcard,
            show k - 1 - 1 = k - 2 by omega] at hrec
          apply hrec.trans
          have hl := childProduct_finrank_le_layer r u j _
            (singlyMarkedLayer_same_le_ker (B + 1) V (B + 1 - k) u hu j)
            (singlyMarkedLayerMap_injective_same B k hk V hV u hu j hjk hjh)
            (deletedGroup u V)ᶜ
          change _ ≤ Module.finrank ℂ (((Ideal.span {π' * r u ^ (1 - j)}).restrictScalars ℂ).map
            (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) j)).toLinearMap)
          rw [show 1 - j = 0 by omega, pow_zero, mul_one]
          exact hl
        · have hrec := ih k hk1 (by omega) (deletedGroup u V) hV'
          rw [show B - k = B + 1 - k - 1 by omega, hcard] at hrec
          apply hrec.trans
          have hl := childProduct_finrank_le_layer r u j _
            (singlyMarkedLayer_lower_le_ker (B + 1) V (B + 1 - k) k (by omega) (by omega) u hu j
              (by omega))
            (singlyMarkedLayerMap_injective_lower B k hk V hV u hu j (by omega) hjh)
            (deletedGroup u V)ᶜ
          change _ ≤ Module.finrank ℂ (((Ideal.span {π' * r u ^ (1 - j)}).restrictScalars ℂ).map
            (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) j)).toLinearMap)
          rw [show 1 - j = 0 by omega, pow_zero, mul_one]
          exact hl
      refine le_trans ?_ ((Finset.sum_le_sum hterm).trans hsum)
      by_cases hB : B < 2
      · have hq : V.card - 1 < 2 := by
          have hlt : V.card < Finset.univ.card := Finset.card_lt_card
            (Finset.ssubset_iff_subset_ne.mpr ⟨Finset.subset_univ _, hU⟩)
          rw [Finset.card_univ, Fintype.card_fin] at hlt
          omega
        rw [Nat.choose_eq_zero_of_lt hq]
        simp
      obtain ⟨h', hh'⟩ : ∃ h', B + 1 - k = h' + 1 := ⟨B - k, by omega⟩
      rw [hh', Finset.sum_range_succ']
      simp only [Nat.succ_ne_zero, if_false, if_true, add_zero]
      have hshift : ∀ j ∈ Finset.range h', (if j + 1 < k then
          V.card * (V.card - 1).choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 2))
          else V.card * (V.card - 1).choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 1)))
          = if j < k - 1 then
            V.card * (V.card - 1).choose 2 * Nat.card (FullFlagConfiguration (B - 2) (k - 2))
          else V.card * (V.card - 1).choose 2 *
            Nat.card (FullFlagConfiguration (B - 2) (k - 1)) := by
        intro j _
        by_cases hj : j < k - 1
        · rw [if_pos (by omega), if_pos hj]
        · rw [if_neg (by omega), if_neg hj]
      rw [Finset.sum_congr rfl hshift, sum_range_ite_lt h' (k - 1) _ _ (by omega)]
      have hrec := fullFlagConfiguration_card_recursion (B - 2) (k - 1) (by omega)
      rw [show B - 2 + 1 = B + 1 - 2 by omega, show k - 1 - 1 = k - 2 by omega,
        show B + 1 - 2 - (k - 1) - (k - 1) = h' - (k - 1) by omega] at hrec
      rw [hrec]
      apply le_of_eq
      ring

end

end VOA.DeligneAudit.SL4T

