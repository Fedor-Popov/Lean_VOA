import VOA.DeligneAudit.SL4TSecondLeviGeneration

/-! Generation of the merged Levi quotients by their successive count layers. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.A3Sector
open VOA.DeligneAudit.LeviTypeA VOA.DeligneAudit.UnivG

variable {B V : Type} [CommRing B] [Algebra ℂ B]
variable [AddCommGroup V] [Module ℂ V]
variable (Q : CurrentModule VOA.AffineSl3.bracketTable V) (β : B →ₗ[ℂ] V)

/-- Every radical current word has a definite second count layer. -/
theorem secondLevi_radicalWord_mem_count (φ : B) (l : List (Fin 8 × ℕ))
    (hl : l.Forall (fun x => a2Radical x.1)) :
    ∃ e : ℕ × ℕ, wordOp Q l (β φ) ∈ secondLeviCountLayer Q β e.1 e.2 := by
  have hk : ∃ k, wordOp Q l (β φ) ∈ a2KeyLayer Q (β φ) k := by
    induction l with
    | nil =>
      exact ⟨a2WordKey [], by
        simpa [wordOp, radicalWord] using radicalWord_mem_own_key Q (β φ) []⟩
    | cons x l ih =>
      simp only [List.forall_cons] at hl
      obtain ⟨k, hk⟩ := ih hl.2
      rcases x with ⟨i, s⟩
      rcases hl.1 with hi | hi
      · change i = 3 at hi
        subst i
        exact ⟨a2KeyInsert 0 s k, a2RadicalOp_maps_key Q (β φ) 0 s k hk⟩
      · change i = 5 at hi
        subst i
        exact ⟨a2KeyInsert 1 s k, a2RadicalOp_maps_key Q (β φ) 1 s k hk⟩
  obtain ⟨k, hk⟩ := hk
  exact ⟨(k.d₁, k.d₂), Submodule.mem_iSup_of_mem φ
    (Submodule.mem_iSup_of_mem k.degree hk)⟩

/-- All second count closures together generate the Levi span of every coefficient vector. -/
theorem secondLevi_allCountClosures_eq_spans :
    (⨆ e : ℕ × ℕ, a2LeviClosure Q (secondLeviCountLayer Q β e.1 e.2)) =
      ⨆ φ : B, a2LeviSpan Q (β φ) := by
  apply le_antisymm
  · apply iSup_le
    intro e
    apply a2LeviClosure_le_of_inv
    · apply iSup_le
      intro φ
      apply iSup_le
      intro degree
      rw [a2KeyLayer, Submodule.span_le]
      rintro v ⟨l, _, _, _, _, rfl⟩
      apply Submodule.mem_iSup_of_mem φ
      have hw := secondRadical_word_eq_currentWord Q (β φ) l
      rw [← hw]
      exact normal_mem Q (β φ) [] _ (by simp) (by
        rw [List.forall_iff_forall_mem]
        intro y hy
        obtain ⟨x, _, rfl⟩ := List.mem_map.mp hy
        by_cases hx : x.1 = 0 <;> simp [a2Radical, hx])
    · intro i s hi
      apply iSup_le
      intro φ x hx
      change Q.op i s x ∈ (⨆ φ : B, a2LeviSpan Q (β φ))
      exact Submodule.mem_iSup_of_mem φ (levi_inv Q (β φ) i s hi hx)
  · apply iSup_le
    intro φ
    rw [a2LeviSpan, Submodule.span_le]
    rintro v ⟨l, r, hl, hr, rfl⟩
    obtain ⟨e, he⟩ := secondLevi_radicalWord_mem_count Q β φ r hr
    apply Submodule.mem_iSup_of_mem e
    have hb := a2LeviClosure_contains Q (secondLeviCountLayer Q β e.1 e.2) he
    rw [wordOp_append]
    induction l with
    | nil => exact hb
    | cons x l ih =>
      simp only [List.forall_cons] at hl
      exact a2LeviClosure_inv Q _ x.1 x.2 hl.1 (ih hl.2)

/-- Highest coefficient vectors generate the same module as all second Levi count closures. -/
theorem secondLevi_allCountClosures_eq_cyclic
    (he : ∀ i s φ, a2Positive i → Q.op i s (β φ) = 0) :
    (⨆ e : ℕ × ℕ, a2LeviClosure Q (secondLeviCountLayer Q β e.1 e.2)) =
      ⨆ φ : B, cycSubG Q (β φ) := by
  rw [secondLevi_allCountClosures_eq_spans]
  apply iSup_congr
  intro φ
  exact (secondLevi_cyclic_eq_leviSpan Q (β φ) (fun i s hi => he i s φ hi)).symm

variable (ρ : CurrentModule bracketTable V) (w : V)
variable (a b c : ℕ) (h : LocalWeylRel ρ w (weightABC a b c))

/-- Levi words commute with the projection to the first count quotient. -/
theorem radicalCountQuot_word (d : Fin 3 → ℕ) (l : List (Fin 8 × ℕ)) (v : V) :
    wordOp (radicalCountQuotCurrent ρ w d) l ((higherRadicalCountClosure ρ w d).mkQ v) =
      (higherRadicalCountClosure ρ w d).mkQ
        (wordOp ρ (l.map fun x => (a3LeviColour x.1, x.2)) v) := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    simp only [List.map_cons, wordOp, ih]
    rfl

set_option synthInstance.maxHeartbeats 100000 in
-- The actual source is a nested Grassmannian tensor product.
/-- The first quotient orbit is generated by the image of the three-Grassmannian source. -/
theorem radicalCountClosure_map_eq_cyclic (d : Fin 3 → ℕ) :
    (a3LeviClosure ρ (radicalCountLayer ρ w d)).map
      (higherRadicalCountClosure ρ w d).mkQ =
        ⨆ φ : RadicalGrassmannianRing a b c d,
          cycSubG (radicalCountQuotCurrent ρ w d)
            (radicalGrassmannianAmbientEvaluation ρ w a b c h d φ) := by
  let N := higherRadicalCountClosure ρ w d
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap, a3LeviClosure, Submodule.span_le]
    rintro v ⟨l, x, hx, rfl⟩
    obtain ⟨φ, hφ⟩ := radicalGrassmannianEvaluation_surjective ρ w a b c h d
      ⟨N.mkQ x, ⟨x, hx, rfl⟩⟩
    have hφ' : radicalGrassmannianAmbientEvaluation ρ w a b c h d φ = N.mkQ x :=
      congrArg Subtype.val hφ
    change N.mkQ (wordOp ρ (l.map fun x => (a3LeviColour x.1, x.2)) x) ∈
      (⨆ φ : RadicalGrassmannianRing a b c d,
        cycSubG (radicalCountQuotCurrent ρ w d)
          (radicalGrassmannianAmbientEvaluation ρ w a b c h d φ))
    rw [← radicalCountQuot_word ρ w d l x, ← hφ']
    exact Submodule.mem_iSup_of_mem φ (wordOp_mem_cycSubG _ _ l)
  · apply iSup_le
    intro φ
    rw [cycSubG, Submodule.span_le]
    rintro v ⟨l, rfl⟩
    obtain ⟨x, hx, he⟩ := (radicalGrassmannianEvaluation ρ w a b c h d φ).property
    change wordOp _ l (radicalGrassmannianEvaluation ρ w a b c h d φ).val ∈ _
    rw [← he, radicalCountQuot_word]
    exact ⟨_, Submodule.subset_span ⟨l, x, hx, rfl⟩, rfl⟩

set_option synthInstance.maxHeartbeats 100000 in
-- Keep synthesis local to the tensor-product source.
/-- The actual first quotient orbit is the sum of the second count closures. -/
theorem radicalCountClosure_map_eq_secondCounts (d : Fin 3 → ℕ) :
    let Q := radicalCountQuotCurrent ρ w d
    let β := radicalGrassmannianAmbientEvaluation ρ w a b c h d
    (a3LeviClosure ρ (radicalCountLayer ρ w d)).map
      (higherRadicalCountClosure ρ w d).mkQ =
        ⨆ e : ℕ × ℕ, a2LeviClosure Q (secondLeviCountLayer Q β e.1 e.2) := by
  dsimp only
  rw [radicalCountClosure_map_eq_cyclic ρ w a b c h d]
  symm
  apply secondLevi_allCountClosures_eq_cyclic
  intro i s φ hi
  obtain ⟨v, hv, he⟩ := (radicalGrassmannianEvaluation ρ w a b c h d φ).property
  change (radicalCountQuotCurrent ρ w d).op i s
    (radicalGrassmannianEvaluation ρ w a b c h d φ).val = 0
  rw [← he]
  rcases hi with rfl | rfl
  · exact radicalCountQuot_raising ρ w a b c h d 0 s hv
  · exact radicalCountQuot_raising ρ w a b c h d 1 s hv

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.secondLevi_radicalWord_mem_count
#print axioms VOA.DeligneAudit.SL4T.secondLevi_allCountClosures_eq_spans
#print axioms VOA.DeligneAudit.SL4T.secondLevi_allCountClosures_eq_cyclic
#print axioms VOA.DeligneAudit.SL4T.radicalCountQuot_word
#print axioms VOA.DeligneAudit.SL4T.radicalCountClosure_map_eq_cyclic
#print axioms VOA.DeligneAudit.SL4T.radicalCountClosure_map_eq_secondCounts
