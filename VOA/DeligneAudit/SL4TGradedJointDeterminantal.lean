import VOA.DeligneAudit.SL4TGradedPolynomialRemainder
import VOA.DeligneAudit.SL4TRelationLineFlag
import VOA.DeligneAudit.SL4TRemainderCramer

/-!
# The graded determinantal level theorem for a homogeneous relation ideal

Let `A` be a `ℤ`-graded commutative `ℂ`-algebra, `P ∈ A[t]` monic of degree `r` and homogeneous
of degree `r` (with `deg t = 1`), and `S ⊆ A[t]` a set of homogeneous polynomials. The ideal
`(S)` of `A[t]` is a `t`-stable `A`-submodule `U`, and `G_j` is the ideal of top-row `j`-minors
of the remainders modulo `P` of columns in `U` (`polynomialSubmoduleTopIdeal`). This file proves:

* the determinant of polynomial columns is multilinear, so `G_j` is generated by the top-row
  minors of homogeneous columns (`topIdeal_eq_span_homogeneousTopMinors`), and is therefore a
  homogeneous ideal (`jointTopIdeal_isHomogeneous`);
* `G_0 = A`, `G_(j+1) ⊆ G_j` for `j < r` (Laplace expansion along the first row), and
  `G_(r+1) = 0`;
* **the graded Cramer certificate** (`jointTopIdeal_certificate`): every homogeneous
  `σ ∈ G_j` of degree `d` satisfies `σ t^(r-j) + c ∈ (P) + (S)` with a correction `c` whose
  coefficients lie in `G_j` and whose coefficient of `t^l` has degree `d + (r - j) - l > d`;
* **the graded level theorem with a general relation ideal**
  (`gradedJointRelationLineFlag`): if `A` is finite dimensional and the positive power sums
  have positive degree, there is a power-sum-stable line flag of `A` with level relations in
  `(P) + (S)` and cost `Σ_j (dim G_j - dim G_(j+1)) · cost(L_j)`, for any levels
  `L_j ≥ r - j`.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open Polynomial

section Multilinear

variable {A V : Type*} [CommRing A] [AddCommGroup V] [Module A V]

/-- A determinant of linear functionals applied to columns in the span of `T` lies in the ideal
generated by the determinants of columns from `T`. -/
theorem det_linearColumns_mem_span {j : ℕ} (L : Fin j → V →ₗ[A] A) (T : Set V)
    (p : Fin j → V) (hp : ∀ b, p b ∈ Submodule.span A T) :
    Matrix.det (fun i b => L i (p b)) ∈
      Ideal.span {a | ∃ u : Fin j → V, (∀ b, u b ∈ T) ∧
        Matrix.det (fun i b => L i (u b)) = a} := by
  classical
  set I := Ideal.span {a | ∃ u : Fin j → V, (∀ b, u b ∈ T) ∧
    Matrix.det (fun i b => L i (u b)) = a}
  have hupd (p : Fin j → V) (b : Fin j) (x : V) :
      (fun i c => L i (Function.update p b x c)) =
        Matrix.updateCol (fun i c => L i (p c)) b (fun i => L i x) := by
    ext i c
    by_cases hc : c = b
    · subst hc
      simp
    · simp [Function.update_of_ne hc, Matrix.updateCol_ne hc]
  suffices h : ∀ s : Finset (Fin j), ∀ p : Fin j → V, (∀ b, p b ∈ Submodule.span A T) →
      (∀ b ∉ s, p b ∈ T) → Matrix.det (fun i b => L i (p b)) ∈ I from
    h Finset.univ p hp (fun b hb => absurd (Finset.mem_univ b) hb)
  intro s
  induction s using Finset.induction_on with
  | empty =>
      intro p _ hT
      exact Ideal.subset_span ⟨p, fun b => hT b (by simp), rfl⟩
  | insert b s hb ih =>
      intro p hp hT
      have key : ∀ x ∈ Submodule.span A T,
          Matrix.det (fun i c => L i (Function.update p b x c)) ∈ I := by
        intro x hx
        induction hx using Submodule.span_induction with
        | mem x hx =>
            apply ih
            · intro c
              by_cases hc : c = b
              · subst hc
                rw [Function.update_self]
                exact Submodule.subset_span hx
              · rw [Function.update_of_ne hc]
                exact hp c
            · intro c hc
              by_cases hcb : c = b
              · subst hcb
                rw [Function.update_self]
                exact hx
              · rw [Function.update_of_ne hcb]
                exact hT c (fun h => (Finset.mem_insert.mp h).elim hcb hc)
        | zero =>
            rw [hupd p b 0, Matrix.det_eq_zero_of_column_eq_zero b (fun i => by simp)]
            exact I.zero_mem
        | add x y _ _ hx hy =>
            rw [hupd p b x] at hx
            rw [hupd p b y] at hy
            rw [hupd p b (x + y)]
            have he : (fun i => L i (x + y)) = (fun i => L i x) + (fun i => L i y) := by
              ext i
              simp
            rw [he, Matrix.det_updateCol_add]
            exact I.add_mem hx hy
        | smul a x _ hx =>
            rw [hupd p b x] at hx
            rw [hupd p b (a • x)]
            have he : (fun i => L i (a • x)) = a • (fun i => L i x) := by
              ext i
              simp
            rw [he, Matrix.det_updateCol_smul]
            exact I.mul_mem_left a hx
      have h := key (p b) (hp b)
      rwa [Function.update_eq_self] at h

end Multilinear

section Joint

variable {A : Type*} [CommRing A] [Algebra ℂ A] (𝒜 : ℤ → Submodule ℂ A) [GradedAlgebra 𝒜]

/-- The homogeneous polynomials in the ideal of `A[t]` generated by `S`. -/
def homogeneousIdealColumns (S : Set A[X]) : Set A[X] :=
  {u | u ∈ Ideal.span S ∧ ∃ δ : ℤ, PolynomialHomogeneous 𝒜 δ u}

/-- An ideal of `A[t]` generated by homogeneous polynomials is spanned over `A` by its
homogeneous elements. -/
theorem idealSpan_le_span_homogeneousIdealColumns (S : Set A[X])
    (hS : ∀ g ∈ S, ∃ δ : ℤ, PolynomialHomogeneous 𝒜 δ g) (u : A[X])
    (hu : u ∈ Ideal.span S) :
    u ∈ Submodule.span A (homogeneousIdealColumns 𝒜 S) := by
  have hmul : ∀ f : A[X], ∀ y ∈ Submodule.span A (homogeneousIdealColumns 𝒜 S),
      f * y ∈ Submodule.span A (homogeneousIdealColumns 𝒜 S) := by
    intro f y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
        induction f using Polynomial.induction_on' with
        | add f g hf hg =>
            rw [add_mul]
            exact Submodule.add_mem _ hf hg
        | monomial n a =>
            rw [← C_mul_X_pow_eq_monomial, mul_assoc, ← smul_eq_C_mul]
            apply Submodule.smul_mem
            apply Submodule.subset_span
            obtain ⟨hyI, δ, hδ⟩ := hy
            exact ⟨Ideal.mul_mem_left _ _ hyI, n + δ, (polynomialHomogeneous_X_pow n).mul hδ⟩
    | zero =>
        rw [mul_zero]
        exact Submodule.zero_mem _
    | add y z _ _ hy hz =>
        rw [mul_add]
        exact Submodule.add_mem _ hy hz
    | smul a y _ hy =>
        rw [mul_smul_comm]
        exact Submodule.smul_mem _ a hy
  induction hu using Submodule.span_induction with
  | mem g hg => exact Submodule.subset_span ⟨Ideal.subset_span hg, hS g hg⟩
  | zero => exact Submodule.zero_mem _
  | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
  | smul f x _ hx => exact hmul f x hx

variable (P : A[X]) (r : ℕ) (S : Set A[X])

/-- The top-row minor of `j` polynomial columns reduced modulo `P`. -/
def reducedTopMinor (j : ℕ) (u : Fin j → A[X]) : A :=
  Matrix.det (fun i b : Fin j => ((u b) %ₘ P).coeff (r - j + i.val))

/-- The top-row minors of homogeneous columns of the ideal generated by `S`. -/
def homogeneousTopMinorSet (j : ℕ) : Set A :=
  {a | ∃ u : Fin j → A[X], (∀ b, u b ∈ homogeneousIdealColumns 𝒜 S) ∧
    reducedTopMinor P r j u = a}

/-- The top-row ideal of the ideal generated by homogeneous polynomials is generated by the
top-row minors of homogeneous columns. -/
theorem topIdeal_eq_span_homogeneousTopMinors
    (hS : ∀ g ∈ S, ∃ δ : ℤ, PolynomialHomogeneous 𝒜 δ g) (j : ℕ) :
    polynomialSubmoduleTopIdeal P r j ((Ideal.span S).restrictScalars A) =
      Ideal.span (homogeneousTopMinorSet 𝒜 P r S j) := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro a ⟨p, rfl⟩
    have h := det_linearColumns_mem_span
      (fun i : Fin j => (lcoeff A (r - j + i.val)).comp (modByMonicHom P))
      (homogeneousIdealColumns 𝒜 S) (fun b => (p b).val)
      (fun b => idealSpan_le_span_homogeneousIdealColumns 𝒜 S hS _ (p b).property)
    refine Ideal.span_mono ?_ h
    rintro a ⟨u, hu, rfl⟩
    exact ⟨u, hu, rfl⟩
  · apply Ideal.span_le.mpr
    rintro a ⟨u, hu, rfl⟩
    exact Ideal.subset_span ⟨fun b => ⟨u b, (hu b).1⟩, rfl⟩

variable {P r}

/-- A top-row minor of homogeneous columns is homogeneous. -/
theorem reducedTopMinor_mem_graded (hP : P.Monic) (hr : P.natDegree = r)
    (hPh : PolynomialHomogeneous 𝒜 r P) (j : ℕ) (u : Fin j → A[X]) (δ : Fin j → ℤ)
    (hu : ∀ b, PolynomialHomogeneous 𝒜 (δ b) (u b)) :
    reducedTopMinor P r j u ∈
      𝒜 ((∑ b, δ b) - ∑ a : Fin j, ((r - j + a.val : ℕ) : ℤ)) :=
  det_mem_graded _ _ _ fun a b => (hu b).modByMonic P r hP hr hPh (r - j + a.val)

/-- The joint top-row ideal is homogeneous. -/
theorem jointTopIdeal_isHomogeneous (hP : P.Monic) (hr : P.natDegree = r)
    (hPh : PolynomialHomogeneous 𝒜 r P)
    (hS : ∀ g ∈ S, ∃ δ : ℤ, PolynomialHomogeneous 𝒜 δ g) (j : ℕ) :
    (polynomialSubmoduleTopIdeal P r j ((Ideal.span S).restrictScalars A)).IsHomogeneous 𝒜 := by
  rw [topIdeal_eq_span_homogeneousTopMinors 𝒜 P r S hS j]
  apply Ideal.homogeneous_span
  rintro a ⟨u, hu, rfl⟩
  choose δ hδ using fun b => (hu b).2
  exact ⟨_, reducedTopMinor_mem_graded 𝒜 hP hr hPh j u δ hδ⟩

omit [Algebra ℂ A] in
/-- The zero-size top-row ideal is the whole ring. -/
theorem polynomialSubmoduleTopIdeal_zero_eq_top (U : Submodule A A[X]) :
    polynomialSubmoduleTopIdeal P r 0 U = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  apply Ideal.subset_span
  exact ⟨fun i => i.elim0, Matrix.det_isEmpty⟩

omit [Algebra ℂ A] in
/-- Laplace expansion along the first row: the top-row ideals descend for `j < r`. -/
theorem polynomialSubmoduleTopIdeal_succ_le (U : Submodule A A[X]) (j : ℕ) (hj : j + 1 ≤ r) :
    polynomialSubmoduleTopIdeal P r (j + 1) U ≤ polynomialSubmoduleTopIdeal P r j U := by
  apply Ideal.span_le.mpr
  rintro a ⟨p, rfl⟩
  rw [Matrix.det_succ_row_zero]
  apply Ideal.sum_mem
  intro b _
  apply Ideal.mul_mem_left
  apply Ideal.subset_span
  refine ⟨fun c => p (b.succAbove c), ?_⟩
  congr 1
  ext i c
  simp only [Matrix.submatrix_apply, Fin.val_succ]
  congr 1
  omega

omit [Algebra ℂ A] in
/-- There are no top-row minors of size `r + 1`. -/
theorem polynomialSubmoduleTopIdeal_succ_eq_bot (hP : P.Monic) (hr : P.natDegree = r)
    (U : Submodule A A[X]) : polynomialSubmoduleTopIdeal P r (r + 1) U = ⊥ := by
  rcases subsingleton_or_nontrivial A with hA | hA
  · rw [eq_bot_iff]
    intro x _
    rw [Subsingleton.elim x 0]
    exact Submodule.zero_mem _
  rw [polynomialSubmoduleTopIdeal, Ideal.span_eq_bot]
  rintro a ⟨p, rfl⟩
  apply Matrix.det_eq_zero_of_row_eq_zero (Fin.last r)
  intro b
  have hlt := degree_modByMonic_lt (p b).val hP
  rw [degree_eq_natDegree hP.ne_zero, hr] at hlt
  change (((p b).val %ₘ P).coeff (r - (r + 1) + (Fin.last r).val)) = 0
  rw [Fin.val_last, show r - (r + 1) + r = r by omega]
  exact coeff_eq_zero_of_degree_lt hlt

/-! ### Homogeneous level certificates -/

variable (P r)

/-- A homogeneous level certificate for `σ` in degree `d` and level `L`: a correction `c` with
coefficients in `G`, whose coefficient of `t^l` has degree `d + L - l` and vanishes for
`l ≥ L`, such that `σ t^L + c ∈ Rel`. -/
def HomogeneousLevelCertificate (G : Ideal A) (Rel : Ideal A[X]) (d : ℤ) (L : ℕ) (σ : A) :
    Prop :=
  ∃ c : A[X], (∀ l, c.coeff l ∈ G) ∧ (∀ l : ℕ, c.coeff l ∈ 𝒜 (d + L - l)) ∧
    (∀ l, L ≤ l → c.coeff l = 0) ∧ Polynomial.C σ * X ^ L + c ∈ Rel

variable {𝒜 P r}

omit [GradedAlgebra 𝒜] in
theorem homogeneousLevelCertificate_zero (G : Ideal A) (Rel : Ideal A[X]) (d : ℤ) (L : ℕ) :
    HomogeneousLevelCertificate 𝒜 G Rel d L 0 := by
  refine ⟨0, fun l => by simp, fun l => by simp, fun l _ => by simp, by simp⟩

omit [GradedAlgebra 𝒜] in
theorem HomogeneousLevelCertificate.add {G : Ideal A} {Rel : Ideal A[X]} {d : ℤ} {L : ℕ}
    {σ τ : A} (hσ : HomogeneousLevelCertificate 𝒜 G Rel d L σ)
    (hτ : HomogeneousLevelCertificate 𝒜 G Rel d L τ) :
    HomogeneousLevelCertificate 𝒜 G Rel d L (σ + τ) := by
  obtain ⟨c, hcG, hcd, hcz, hcR⟩ := hσ
  obtain ⟨c', hcG', hcd', hcz', hcR'⟩ := hτ
  refine ⟨c + c', fun l => ?_, fun l => ?_, fun l hl => ?_, ?_⟩
  · rw [coeff_add]
    exact G.add_mem (hcG l) (hcG' l)
  · rw [coeff_add]
    exact Submodule.add_mem _ (hcd l) (hcd' l)
  · rw [coeff_add, hcz l hl, hcz' l hl, add_zero]
  · have h := Rel.add_mem hcR hcR'
    rw [map_add]
    convert h using 1
    ring

omit [GradedAlgebra 𝒜] in
theorem homogeneousLevelCertificate_sum {G : Ideal A} {Rel : Ideal A[X]} {d : ℤ} {L : ℕ}
    {ι : Type*} (s : Finset ι) (σ : ι → A)
    (h : ∀ i ∈ s, HomogeneousLevelCertificate 𝒜 G Rel d L (σ i)) :
    HomogeneousLevelCertificate 𝒜 G Rel d L (∑ i ∈ s, σ i) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      rw [Finset.sum_empty]
      exact homogeneousLevelCertificate_zero G Rel d L
  | insert i s hi ih =>
      rw [Finset.sum_insert hi]
      exact (h i (Finset.mem_insert_self i s)).add
        (ih fun k hk => h k (Finset.mem_insert_of_mem hk))

theorem HomogeneousLevelCertificate.mul_left {G : Ideal A} {Rel : Ideal A[X]} {d e : ℤ}
    {L : ℕ} {σ a : A} (ha : a ∈ 𝒜 e) (hσ : HomogeneousLevelCertificate 𝒜 G Rel d L σ) :
    HomogeneousLevelCertificate 𝒜 G Rel (e + d) L (a * σ) := by
  obtain ⟨c, hcG, hcd, hcz, hcR⟩ := hσ
  refine ⟨Polynomial.C a * c, fun l => ?_, fun l => ?_, fun l hl => ?_, ?_⟩
  · rw [coeff_C_mul]
    exact G.mul_mem_left a (hcG l)
  · rw [coeff_C_mul]
    have h := SetLike.mul_mem_graded ha (hcd l)
    rw [show e + (d + (L : ℤ) - (l : ℤ)) = e + d + L - l by ring] at h
    exact h
  · rw [coeff_C_mul, hcz l hl, mul_zero]
  · have h := Rel.mul_mem_left (Polynomial.C a) hcR
    convert h using 1
    rw [map_mul]
    ring

omit [GradedAlgebra 𝒜] in
theorem HomogeneousLevelCertificate.of_degree_eq {G : Ideal A} {Rel : Ideal A[X]} {d e : ℤ}
    {L : ℕ} {σ : A} (hσ : HomogeneousLevelCertificate 𝒜 G Rel d L σ) (h : d = e) :
    HomogeneousLevelCertificate 𝒜 G Rel e L σ := h ▸ hσ

omit [GradedAlgebra 𝒜] in
/-- A relation at level `L` gives one at every higher level. -/
theorem HomogeneousLevelCertificate.raise {G : Ideal A} {Rel : Ideal A[X]} {d : ℤ} {L : ℕ}
    {σ : A} (hσ : HomogeneousLevelCertificate 𝒜 G Rel d L σ) (k : ℕ) :
    HomogeneousLevelCertificate 𝒜 G Rel d (L + k) σ := by
  obtain ⟨c, hcG, hcd, hcz, hcR⟩ := hσ
  refine ⟨X ^ k * c, fun l => ?_, fun l => ?_, fun l hl => ?_, ?_⟩
  · rw [coeff_X_pow_mul']
    split_ifs
    · exact hcG _
    · exact G.zero_mem
  · rw [coeff_X_pow_mul']
    split_ifs with hkl
    · have h := hcd (l - k)
      rw [show d + (L : ℤ) - ((l - k : ℕ) : ℤ) = d + ((L + k : ℕ) : ℤ) - (l : ℤ) by
        push_cast [Nat.cast_sub hkl]
        ring] at h
      exact h
    · exact Submodule.zero_mem _
  · rw [coeff_X_pow_mul']
    split_ifs
    · exact hcz _ (by omega)
    · rfl
  · have h := Rel.mul_mem_left (X ^ k) hcR
    convert h using 1
    rw [pow_add]
    ring

/-! ### The Cramer certificate of a homogeneous top-row minor -/

/-- **The graded Cramer certificate for one top-row minor of homogeneous columns.** -/
theorem reducedTopMinor_certificate (hP : P.Monic) (hr : P.natDegree = r)
    (hPh : PolynomialHomogeneous 𝒜 r P) (j : ℕ) (hjr : j ≤ r)
    (u : Fin j → A[X]) (hu : ∀ b, u b ∈ homogeneousIdealColumns 𝒜 S) (δ : Fin j → ℤ)
    (hδ : ∀ b, PolynomialHomogeneous 𝒜 (δ b) (u b)) :
    HomogeneousLevelCertificate 𝒜
      (polynomialSubmoduleTopIdeal P r j ((Ideal.span S).restrictScalars A))
      (Ideal.span {P} ⊔ Ideal.span S)
      ((∑ b, δ b) - ∑ a : Fin j, ((r - j + a.val : ℕ) : ℤ)) (r - j)
      (reducedTopMinor P r j u) := by
  classical
  set Rel := Ideal.span {P} ⊔ Ideal.span S
  have hPRel : P ∈ Rel := Ideal.mem_sup_left (Ideal.subset_span rfl)
  have hremRel (f : A[X]) (hf : f ∈ Ideal.span S) : f %ₘ P ∈ Rel := by
    rw [modByMonic_eq_sub_mul_div]
    exact Rel.sub_mem (Ideal.mem_sup_right hf) (Rel.mul_mem_right _ hPRel)
  rcases subsingleton_or_nontrivial A with hA | hA
  · refine ⟨0, fun l => by simp, fun l => by simp, fun l _ => by simp, ?_⟩
    rw [Subsingleton.elim (reducedTopMinor P r j u) 0]
    simp
  rcases Nat.eq_zero_or_pos j with hj0 | hj
  · -- The empty minor is `1`; use the monic relation `P` itself.
    subst hj0
    have h1 : reducedTopMinor P r 0 u = 1 := Matrix.det_isEmpty
    rw [h1]
    refine ⟨P - X ^ r, fun l => ?_, fun l => ?_, fun l hl => ?_, ?_⟩
    · rw [polynomialSubmoduleTopIdeal_zero_eq_top]
      exact Submodule.mem_top
    · have h := hPh.sub (polynomialHomogeneous_X_pow (𝒜 := 𝒜) r) l
      simpa using h
    · rw [coeff_sub, coeff_X_pow]
      have hl' : r ≤ l := by omega
      rcases eq_or_lt_of_le hl' with he | hlt
      · subst he
        rw [if_pos rfl, ← hr, coeff_natDegree, hP.leadingCoeff, sub_self]
      · rw [if_neg (by omega), coeff_eq_zero_of_natDegree_lt (by omega), sub_zero]
    · have he : Polynomial.C (1 : A) * X ^ (r - 0) + (P - X ^ r) = P := by
        rw [map_one, one_mul, Nat.sub_zero]
        ring
      rw [he]
      exact hPRel
  -- `j ≥ 1`: the Cramer combination of the reduced columns.
  let b0 : Fin j := ⟨0, hj⟩
  let M : Matrix (Fin j) (Fin j) A := fun a c => ((u c) %ₘ P).coeff (r - j + a.val)
  let μ := reducedTopMinor P r j u
  have hμ : μ = M.det := rfl
  let w : A[X] := ∑ c, Polynomial.C (Matrix.cramer M (Pi.single b0 1) c) * ((u c) %ₘ P)
  have hw (l : ℕ) : w.coeff l = (M.updateRow b0 (fun c => ((u c) %ₘ P).coeff l)).det := by
    rw [← determinant_row_cramer]
    simp only [w, finsetSum_coeff, coeff_C_mul]
    exact Finset.sum_congr rfl fun c _ => mul_comm _ _
  have hdeg (c : Fin j) : ((u c) %ₘ P).degree < (r : WithBot ℕ) := by
    have h := degree_modByMonic_lt (u c) hP
    rwa [degree_eq_natDegree hP.ne_zero, hr] at h
  have hU : ∀ p ∈ (Ideal.span S).restrictScalars A, X * p ∈ (Ideal.span S).restrictScalars A :=
    fun p hp => (Ideal.span S).mul_mem_left X hp
  have hμG : μ ∈ polynomialSubmoduleTopIdeal P r j ((Ideal.span S).restrictScalars A) :=
    Ideal.subset_span ⟨fun b => ⟨u b, (hu b).1⟩, rfl⟩
  have hwG (l : ℕ) :
      w.coeff l ∈ polynomialSubmoduleTopIdeal P r j ((Ideal.span S).restrictScalars A) := by
    by_cases hl : l < r
    · rw [hw l]
      have hall := stableSubmodule_allIdeal_eq_topIdeal P r j hP hr hjr _ hU
      rw [← hall]
      apply Ideal.subset_span
      refine ⟨fun a => if a = b0 then ⟨l, hl⟩ else ⟨r - j + a.val, by omega⟩,
        fun b => ⟨u b, (hu b).1⟩, ?_⟩
      congr 1
      ext a c
      by_cases ha : a = b0
      · subst ha
        simp
      · simp [ha, M]
    · rw [hw l, Matrix.det_eq_zero_of_row_eq_zero b0 (fun c => ?_)]
      · exact Submodule.zero_mem _
      · rw [Matrix.updateRow_self]
        exact coeff_eq_zero_of_degree_lt (lt_of_lt_of_le (hdeg c) (by exact_mod_cast
          (show r ≤ l by omega)))
  have hμdeg := reducedTopMinor_mem_graded 𝒜 hP hr hPh j u δ hδ
  set e := (∑ b, δ b) - ∑ a : Fin j, ((r - j + a.val : ℕ) : ℤ) with he
  have hwdeg (l : ℕ) : w.coeff l ∈ 𝒜 (e + ((r - j : ℕ) : ℤ) - l) := by
    rw [hw l]
    let row : Fin j → ℤ := fun a => ((r - j + a.val : ℕ) : ℤ) +
      if a = b0 then (l : ℤ) - ((r - j : ℕ) : ℤ) else 0
    have hrow : ∑ a, row a = (∑ a : Fin j, ((r - j + a.val : ℕ) : ℤ)) +
        ((l : ℤ) - ((r - j : ℕ) : ℤ)) := by
      simp [row, Finset.sum_add_distrib]
    have h := det_mem_graded (M.updateRow b0 (fun c => ((u c) %ₘ P).coeff l)) row δ
      (fun a c => by
        by_cases ha : a = b0
        · subst ha
          have hrb : row b0 = (l : ℤ) := by simp [row, b0]
          rw [Matrix.updateRow_self, hrb]
          exact (hδ c).modByMonic P r hP hr hPh l
        · have hra : row a = ((r - j + a.val : ℕ) : ℤ) := by simp [row, ha]
          rw [Matrix.updateRow_ne ha, hra]
          exact (hδ c).modByMonic P r hP hr hPh (r - j + a.val))
    rw [hrow] at h
    convert h using 2
    rw [he]
    ring
  refine ⟨w - Polynomial.C μ * X ^ (r - j), fun l => ?_, fun l => ?_, fun l hl => ?_, ?_⟩
  · rw [coeff_sub, coeff_C_mul_X_pow]
    apply Submodule.sub_mem _ (hwG l)
    split_ifs
    · exact hμG
    · exact Submodule.zero_mem _
  · rw [coeff_sub, coeff_C_mul_X_pow]
    apply Submodule.sub_mem _ (hwdeg l)
    split_ifs with hl
    · subst hl
      rw [add_sub_cancel_right]
      exact hμdeg
    · exact Submodule.zero_mem _
  · rw [coeff_sub, coeff_C_mul_X_pow, hw l]
    by_cases hlr : l < r
    · let a : Fin j := ⟨l - (r - j), by omega⟩
      have hrowa : (fun c => ((u c) %ₘ P).coeff l) = M a := by
        ext c
        simp only [M, a]
        congr 1
        omega
      rw [hrowa]
      by_cases ha : a = b0
      · have hl0 : l = r - j := by
          have := congrArg Fin.val ha
          simp only [a, b0] at this
          omega
        rw [ha, Matrix.updateRow_eq_self, if_pos hl0, ← hμ, sub_self]
      · have hne : l ≠ r - j := by
          intro hl0
          apply ha
          ext
          simp only [a, b0]
          omega
        rw [if_neg hne, sub_zero]
        apply Matrix.det_zero_of_row_eq ha
        rw [Matrix.updateRow_self, Matrix.updateRow_ne ha]
    · rw [if_neg (by omega), sub_zero]
      apply Matrix.det_eq_zero_of_row_eq_zero b0
      intro c
      rw [Matrix.updateRow_self]
      exact coeff_eq_zero_of_degree_lt (lt_of_lt_of_le (hdeg c) (by exact_mod_cast
        (show r ≤ l by omega)))
  · have hw' : Polynomial.C μ * X ^ (r - j) + (w - Polynomial.C μ * X ^ (r - j)) = w := by
      ring
    rw [hw']
    apply Rel.sum_mem
    intro c _
    exact Rel.mul_mem_left _ (hremRel (u c) (hu c).1)

/-- **The graded Cramer certificate** for every degree component of every element of the
joint top-row ideal. -/
theorem jointTopIdeal_certificate (hP : P.Monic) (hr : P.natDegree = r)
    (hPh : PolynomialHomogeneous 𝒜 r P)
    (hS : ∀ g ∈ S, ∃ δ : ℤ, PolynomialHomogeneous 𝒜 δ g) (j : ℕ) (hjr : j ≤ r)
    (x : A) (hx : x ∈ polynomialSubmoduleTopIdeal P r j ((Ideal.span S).restrictScalars A))
    (d : ℤ) :
    HomogeneousLevelCertificate 𝒜
      (polynomialSubmoduleTopIdeal P r j ((Ideal.span S).restrictScalars A))
      (Ideal.span {P} ⊔ Ideal.span S) d (r - j) (DirectSum.decompose 𝒜 x d) := by
  classical
  rw [topIdeal_eq_span_homogeneousTopMinors 𝒜 P r S hS j] at hx
  revert d
  induction hx using Submodule.span_induction with
  | mem μ hμ =>
      intro d
      obtain ⟨u, hu, rfl⟩ := hμ
      choose δ hδ using fun b => (hu b).2
      have hmem := reducedTopMinor_mem_graded 𝒜 hP hr hPh j u δ hδ
      have hcert := reducedTopMinor_certificate S hP hr hPh j hjr u hu δ hδ
      by_cases hd : (∑ b, δ b) - ∑ a : Fin j, ((r - j + a.val : ℕ) : ℤ) = d
      · rw [← hd, DirectSum.decompose_of_mem_same 𝒜 hmem]
        exact hcert
      · rw [DirectSum.decompose_of_mem_ne 𝒜 hmem hd]
        exact homogeneousLevelCertificate_zero _ _ _ _
  | zero =>
      intro d
      rw [← GradedRing.proj_apply, map_zero]
      exact homogeneousLevelCertificate_zero _ _ _ _
  | add x y _ _ hx hy =>
      intro d
      rw [← GradedRing.proj_apply, map_add, GradedRing.proj_apply, GradedRing.proj_apply]
      exact (hx d).add (hy d)
  | smul a x _ hx =>
      intro d
      rw [smul_eq_mul, decompose_mul_eq_sum]
      apply homogeneousLevelCertificate_sum
      intro e _
      exact ((hx (d - e)).mul_left (DirectSum.decompose 𝒜 a e).2).of_degree_eq (by ring)

/-! ### The graded level theorem -/

/-- **The graded level theorem for a homogeneous relation ideal.** For a finite-dimensional
graded algebra with positive power sums of positive degree, a homogeneous monic `P` of degree
`r` and homogeneous generators `S`, the top-row strata `G_j` of the ideal `(S)` refine into a
power-sum-stable line flag with level relations in `(P) + (S)`; the stratum `j` costs
`cost(L_j)` per dimension for any choice of levels `L_j ≥ r - j`. -/
theorem gradedJointRelationLineFlag [FiniteDimensional ℂ A]
    (hneg : ∀ d : ℤ, d < 0 → 𝒜 d = ⊥) (p : ℕ → A)
    (hp : ∀ s : ℕ, 1 ≤ s → p s ∈ 𝒜 (s : ℤ))
    (hP : P.Monic) (hr : P.natDegree = r) (hPh : PolynomialHomogeneous 𝒜 r P)
    (hS : ∀ g ∈ S, ∃ δ : ℤ, PolynomialHomogeneous 𝒜 δ g)
    (L : ℕ → ℕ) (hL : ∀ j ≤ r, r - j ≤ L j) :
    RelationLineFlagFrom p (Ideal.span {P} ⊔ Ideal.span S) r ⊥
      (∑ j ∈ Finset.range (r + 1),
        (Module.finrank ℂ ((polynomialSubmoduleTopIdeal P r j
            ((Ideal.span S).restrictScalars A)).restrictScalars ℂ) -
          Module.finrank ℂ ((polynomialSubmoduleTopIdeal P r (j + 1)
            ((Ideal.span S).restrictScalars A)).restrictScalars ℂ)) *
          lineLevelCost r (L j)) := by
  classical
  obtain ⟨D, hD⟩ := graded_eventually_bot (𝒜 := 𝒜)
  set U := (Ideal.span S).restrictScalars A
  let G : ℕ → Ideal A := fun j => polynomialSubmoduleTopIdeal P r j U
  apply relationLineFlagFrom_gradedStrata (fun j => (G j).restrictScalars ℂ) (r + 1)
    ?_ ?_ ?_ ?_ 𝒜 D ?_ hD ?_ L ?_
  · simp only [G, polynomialSubmoduleTopIdeal_zero_eq_top, Submodule.restrictScalars_top]
  · simp only [G, polynomialSubmoduleTopIdeal_succ_eq_bot hP hr,
      Submodule.restrictScalars_bot]
  · intro j hj x hx
    by_cases hjr : j + 1 ≤ r
    · exact polynomialSubmoduleTopIdeal_succ_le U j hjr hx
    · have hx' : x ∈ polynomialSubmoduleTopIdeal P r (r + 1) U := by
        rw [show r + 1 = j + 1 by omega]
        exact hx
      rw [polynomialSubmoduleTopIdeal_succ_eq_bot hP hr] at hx'
      rw [(Submodule.mem_bot A).mp hx']
      exact Submodule.zero_mem _
  · intro j s _ a ha
    exact (G j).mul_mem_left (p s) ha
  · intro s hs d a ha
    have h := SetLike.mul_mem_graded (hp s hs) ha
    rwa [add_comm] at h
  · intro j hj x hx
    have hhom := jointTopIdeal_isHomogeneous 𝒜 S hP hr hPh hS j
    rw [← DirectSum.sum_support_decompose 𝒜 x]
    apply Submodule.sum_mem
    intro i _
    have hxi : (DirectSum.decompose 𝒜 x i : A) ∈ G j := hhom i hx
    have hdi : (DirectSum.decompose 𝒜 x i : A) ∈ 𝒜 i := (DirectSum.decompose 𝒜 x i).2
    by_cases hi : i < 0 ∨ (D : ℤ) < i
    · have hbot : 𝒜 i = ⊥ := hi.elim (hneg i) (hD i)
      rw [(Submodule.eq_bot_iff _).mp hbot _ hdi]
      exact Submodule.zero_mem _
    · have hi0 : 0 ≤ i := by omega
      have htn : ((i.toNat : ℕ) : ℤ) = i := Int.toNat_of_nonneg hi0
      apply Submodule.mem_iSup_of_mem i.toNat
      apply Submodule.mem_iSup_of_mem (show i.toNat ≤ D by omega)
      refine ⟨hxi, ?_⟩
      rw [htn]
      exact hdi
  · intro j hj d a ha
    obtain ⟨haG, had⟩ := ha
    have hcert := jointTopIdeal_certificate S hP hr hPh hS j (by omega) a haG d
    rw [DirectSum.decompose_of_mem_same 𝒜 had] at hcert
    have hraise := hcert.raise (L j - (r - j))
    rw [show r - j + (L j - (r - j)) = L j by have := hL j (by omega); omega] at hraise
    obtain ⟨c, hcG, hcd, hcz, hcR⟩ := hraise
    refine ⟨c, hcG, fun l hl => ?_, hcR⟩
    have hlt : l < L j := by
      by_contra hge
      exact hl (hcz l (by omega))
    exact ⟨(d : ℤ) + L j - l, by omega, hcd l⟩

end Joint

