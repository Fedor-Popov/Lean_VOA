/-- All propagation steps `(g, j, k)`: `P_k = ad(g) P_j`. -/
def f4Steps : List (ℕ × ℕ × ℕ) := f4StepsA ++ f4StepsB ++ f4StepsC ++ f4StepsD

/-- One step: `ad(g) P_j = P_k`, `j < k < 324`, `g < 52`. -/
def stepOK (st : ℕ × ℕ × ℕ) : Bool :=
  decide (st.1 < 52) && decide (st.2.1 < st.2.2) && decide (st.2.2 < 324) &&
    quadZero (adS VOA.AffineGeneral.SCLie.f4T st.1 (relQ st.2.1) ++ scaleQ (-1) (relQ st.2.2))

theorem f4Steps_targets : f4Steps.map (·.2.2) = List.range' 1 323 := by decide +kernel

