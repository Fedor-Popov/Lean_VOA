def single1 (c : Fin 133) (k : ℤ) : List (Fin 133 × ℤ) := if k = 0 then [] else [(c, k)]

/-- The lattice-model bracket table. -/
def modelL (a b : Fin 133) : List (Fin 133 × ℤ) :=
  if a.val < 7 then
    if b.val < 7 then [] else single1 b (formZ (hvec a) (wt b))
  else if b.val < 7 then single1 a (-formZ (hvec b) (wt a))
  else if formZ (wt a) (wt b) = -2 then cartanList (u a * u b * sgn (ep (wt a) (wt b))) (wt a)
  else if formZ (wt a) (wt b) = -1 then single1 (tgt a b) (u a * u b * sgn (ep (wt a) (wt b)) * u (tgt a b))
  else []

/-- `wt`, with the Cartan indices sent to a root. -/
def wtR (a : Fin 133) : Lat := if 7 ≤ a.val then wt a else wt 7

theorem wtR_root (a : Fin 133) (h : 7 ≤ a.val) : wtR a = wt a := by rw [wtR, if_pos h]

/-- Everything checked about the pair `(a, b)`: the model entry is the cert entry, and for two roots
the form is `≥ -2`, `-2` means opposite, `-1` means `tgt a b` is the root `wt a + wt b`. -/
def pairOK (a b : Fin 133) : Bool :=
  decide (sL a b = modelL a b) &&
  (if 7 ≤ a.val ∧ 7 ≤ b.val then
     decide (-2 ≤ formZ (wt a) (wt b)) &&
     (if formZ (wt a) (wt b) = -2 then decide (wt b = -wt a) else true) &&
     (if formZ (wt a) (wt b) = -1 then
        decide (7 ≤ (tgt a b).val ∧ wt (tgt a b) = wt a + wt b) else true)
   else true)

end VOA.DeligneAudit.E7Lie
