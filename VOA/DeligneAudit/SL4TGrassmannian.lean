import VOA.DeligneAudit.SL4TCell
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# A stable presentation of the Grassmannian rings

Use the polynomial ring in all elementary generators, then kill `e_j` for `j > d` and
`h_j` for `j > T`. Here `T = M - d`. This is a presentation in a fixed ambient ring,
so both boundary quotients are obtained by adding one relation. The theorem
`grassIdeal_finite` reduces the complete tail to `h_(T+1), ..., h_(T+d)`.
Thus only the first `d` free elementary generators survive.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

/-- The polynomial ring in the elementary generators `e_1, e_2, ...`. -/
abbrev SymPoly := MvPolynomial ℕ ℂ

/-- The elementary generators, with `e_0 = 1`. -/
def elementary : ℕ → SymPoly
  | 0 => 1
  | n + 1 => MvPolynomial.X n

/-- Complete symmetric functions defined by the inverse-series recursion. -/
def complete : ℕ → SymPoly
  | 0 => 1
  | n + 1 => -∑ i ∈ Finset.range (n + 1),
      (-1) ^ (i + 1) * elementary (i + 1) * complete (n - i)
termination_by n => n
decreasing_by omega

@[simp] theorem elementary_zero : elementary 0 = 1 := rfl

@[simp] theorem elementary_succ (n : ℕ) : elementary (n + 1) = MvPolynomial.X n := rfl

@[simp] theorem complete_zero : complete 0 = 1 := by rw [complete]

theorem complete_succ (n : ℕ) : complete (n + 1) =
    -∑ i ∈ Finset.range (n + 1),
      (-1) ^ (i + 1) * elementary (i + 1) * complete (n - i) := by rw [complete]

/-- The defining convolution identity `E(-t) H(t) = 1` in positive degree. -/
theorem complete_relation (n : ℕ) (hn : 0 < n) :
    ∑ i ∈ Finset.range (n + 1), (-1) ^ i * elementary i * complete (n - i) = 0 := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  rw [Finset.sum_range_succ']
  simp only [Nat.add_sub_add_right, pow_zero, elementary_zero, one_mul, Nat.sub_zero]
  rw [complete_succ]
  exact add_neg_cancel _

/-- The ideal generated by the terms of a sequence strictly above a cutoff. -/
def tailIdeal (f : ℕ → SymPoly) (k : ℕ) : Ideal SymPoly :=
  Ideal.span {p | ∃ j, k < j ∧ f j = p}

theorem tailIdeal_le_iff (f : ℕ → SymPoly) (k : ℕ) (I : Ideal SymPoly) :
    tailIdeal f k ≤ I ↔ ∀ j, k < j → f j ∈ I := by
  rw [tailIdeal, Ideal.span_le]
  exact ⟨fun h j hj => h ⟨j, hj, rfl⟩, fun h _ ⟨j, hj, hp⟩ => hp ▸ h j hj⟩

theorem mem_tailIdeal (f : ℕ → SymPoly) {k j : ℕ} (hj : k < j) :
    f j ∈ tailIdeal f k := Ideal.subset_span ⟨j, hj, rfl⟩

theorem tailIdeal_mono (f : ℕ → SymPoly) {k l : ℕ} (h : k ≤ l) :
    tailIdeal f l ≤ tailIdeal f k :=
  (tailIdeal_le_iff _ _ _).mpr fun _ hj => mem_tailIdeal f (h.trans_lt hj)

theorem tailIdeal_succ (f : ℕ → SymPoly) (k : ℕ) :
    tailIdeal f k = tailIdeal f (k + 1) ⊔ Ideal.span {f (k + 1)} := by
  apply le_antisymm
  · apply (tailIdeal_le_iff _ _ _).mpr
    intro j hj
    rcases Classical.em (j = k + 1) with he | he
    · subst j
      exact (show Ideal.span {f (k + 1)} ≤ _ from le_sup_right)
        (Ideal.subset_span (Set.mem_singleton _))
    · exact (show tailIdeal f (k + 1) ≤ _ from le_sup_left) (mem_tailIdeal f (by omega))
  · refine sup_le (tailIdeal_mono f (by omega)) ?_
    exact Ideal.span_le.mpr fun _ hp => (Set.mem_singleton_iff.mp hp) ▸
      mem_tailIdeal f (Nat.lt_succ_self k)

/-- The rectangle ideal with height `d` and width `T`. -/
def grassIdeal (d T : ℕ) : Ideal SymPoly :=
  tailIdeal elementary d ⊔ tailIdeal complete T

/-- The Grassmannian ring in rectangle coordinates. -/
abbrev GrassRing (d T : ℕ) := SymPoly ⧸ grassIdeal d T

/-- `H(d,M)`; geometric use is restricted to `d ≤ M`. -/
abbrev H (d M : ℕ) := GrassRing d (M - d)

/-- The image of an elementary generator in the Grassmannian ring. -/
def eClass (d T j : ℕ) : GrassRing d T := Ideal.Quotient.mk _ (elementary j)

/-- The image of a complete symmetric function in the Grassmannian ring. -/
def hClass (d T j : ℕ) : GrassRing d T := Ideal.Quotient.mk _ (complete j)

theorem eClass_eq_zero (d T j : ℕ) (hj : d < j) : eClass d T j = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr
    ((show tailIdeal elementary d ≤ grassIdeal d T from le_sup_left)
    (mem_tailIdeal elementary hj))

theorem hClass_eq_zero (d T j : ℕ) (hj : T < j) : hClass d T j = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr ((show tailIdeal complete T ≤ grassIdeal d T from le_sup_right)
      (mem_tailIdeal complete hj))

theorem grassIdeal_peel_e (d T : ℕ) :
    grassIdeal d T = grassIdeal (d + 1) T ⊔ Ideal.span {elementary (d + 1)} := by
  unfold grassIdeal
  rw [tailIdeal_succ elementary d]
  ac_rfl

theorem grassIdeal_peel_h (d T : ℕ) :
    grassIdeal d T = grassIdeal d (T + 1) ⊔ Ideal.span {complete (T + 1)} := by
  unfold grassIdeal
  rw [tailIdeal_succ complete T, sup_assoc]

/-- The infinite complete tail is generated by the usual `d` consecutive relations. -/
theorem grassIdeal_finite (d T : ℕ) :
    grassIdeal d T = tailIdeal elementary d ⊔
      Ideal.span {p | ∃ j, T < j ∧ j ≤ T + d ∧ complete j = p} := by
  let J := tailIdeal elementary d ⊔
    Ideal.span {p | ∃ j, T < j ∧ j ≤ T + d ∧ complete j = p}
  have hh : ∀ j, T < j → complete j ∈ J := by
    intro j
    induction j using Nat.strong_induction_on with
    | h j ih =>
        intro hj
        by_cases htop : j ≤ T + d
        · exact (show Ideal.span _ ≤ J from le_sup_right)
            (Ideal.subset_span ⟨j, hj, htop, rfl⟩)
        · obtain ⟨n, rfl⟩ : ∃ n, j = n + 1 := ⟨j - 1, by omega⟩
          rw [complete_succ]
          apply J.neg_mem
          apply J.sum_mem
          intro i _
          by_cases he : d < i + 1
          · exact J.mul_mem_right _ (J.mul_mem_left _
              ((show tailIdeal elementary d ≤ J from le_sup_left)
                (mem_tailIdeal elementary he)))
          · exact J.mul_mem_left _ (ih (n - i) (by omega) (by omega))
  apply le_antisymm
  · exact sup_le le_sup_left ((tailIdeal_le_iff _ _ _).mpr hh)
  · refine sup_le le_sup_left (Ideal.span_le.mpr ?_)
    rintro _ ⟨j, hj, _, rfl⟩
    exact (show tailIdeal complete T ≤ grassIdeal d T from le_sup_right)
      (mem_tailIdeal complete hj)

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.complete_relation
#print axioms VOA.DeligneAudit.SL4T.grassIdeal_finite
