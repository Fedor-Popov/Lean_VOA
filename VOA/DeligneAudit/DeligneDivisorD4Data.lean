  [[], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(34, 384)], [(16, -192), (28, 384)], [(15, -192), (21, 384)], [(13, 384)], [(4, -384)]],
  [[], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(27, 384)], [(14, -192), (20, 384)], [(12, 384)], [(3, -384)]],
  [[], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(19, 384)], [(11, 384)], [(2, -384)]],
  [[], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(10, 384)], [(1, -384)]],
  [[], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [(0, 768)]]]

/-- Table `i`. -/
def tab (i : ℕ) : QV := (tabB.getD (i / 28) []).getD (i % 28) []

/-- Tree data of node `i`. -/
def par (i : ℕ) : ℕ × Bool × ℕ × ℕ × ℕ := (parB.getD (i / 28) []).getD (i % 28) (0, false, 0, 0, 0)

/-- The table `U_k`. -/
def Uq (k : ℕ) : QV := UT.getD k []

/-- The certificate of `U_k`. -/
def Ucert (k : ℕ) : List (ℕ × ℤ) := UcertT.getD k []

/-- The antisymmetric certificate of `(c, d)`. -/
def antiCert (c d : ℕ) : List (ℕ × ℤ) := (antiCT.getD c []).getD d []

/-- The symmetric certificate of `(c, d)`. -/
def symCert (c d : ℕ) : List (ℕ × ℤ) := (symCT.getD c []).getD d []

/-- `ψ_k(c,d) = q_k(c,d) + q_k(d,c)`. -/
def psiZ (k c d : ℕ) : ℤ := qget (relZ k) c d + qget (relZ k) d c

/-- `-Σ_k ψ_k(c,d) U_k`, skipping zero coefficients. -/
def psiList (c d : ℕ) : QV :=
  (List.range 106).flatMap fun k => if psiZ k c d = 0 then [] else smulQ (-(psiZ k c d)) (Uq k)

/-- `e_c⊗e_d + e_d⊗e_c`. -/
def symQ (c d : ℕ) : QV := [(c, d, 1), (d, c, 1)]

/-- `e_c⊗e_d - e_d⊗e_c`. -/
def antiQ (c d : ℕ) : QV := [(c, d, 1), (d, c, -1)]

/-- All entries are tree nodes of level `≤ ℓ`. -/
def levOf (L : List (ℕ × ℤ)) (ℓ : ℕ) : Bool :=
  L.all fun p => decide (p.1 < 784) && decide ((par p.1).2.2.2.2 ≤ ℓ)

/-- Tree node checks for `i ∈ [lo, hi)`. -/
def nodeChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun i => nodeCheck br 28 tab par i

/-- Depth bound. -/
def depthCheck : Bool := (List.range 784).all fun i => decide ((par i).2.2.2.1 ≤ 4)

/-- The antisymmetric check for `(c, d)`. -/
def antiCheck (c d : ℕ) : Bool :=
  levOf (antiCert c d) 1 && ozeroCheckB 28 (smulQ 8 (antiQ c d) ++ smulQ (-1) (combQ tab (antiCert c d)))

/-- The check of `U_k`. -/
def UCheck (k : ℕ) : Bool :=
  levOf (Ucert k) 2 && ozeroCheckB 28 (Uq k ++ smulQ (-1) (combQ tab (Ucert k)))

/-- The symmetric check for `(c, d)`. -/
def symCheck (c d : ℕ) : Bool :=
  levOf (symCert c d) 0 &&
    ozeroCheckB 28 (smulQ 384 (symQ c d) ++ psiList c d ++ smulQ (-1) (combQ tab (symCert c d)))

/-- Antisymmetric checks for rows `c ∈ [lo, hi)`. -/
def antiChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun c => (List.range 28).all fun d => !decide (c < d) || antiCheck c d

/-- Symmetric checks for rows `c ∈ [lo, hi)`. -/
def symChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun c => (List.range 28).all fun d => !decide (c ≤ d) || symCheck c d

