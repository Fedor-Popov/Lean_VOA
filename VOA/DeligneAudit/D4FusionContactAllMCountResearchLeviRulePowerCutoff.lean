import VOA.DeligneAudit.D4FusionContactAllMCountResearchLeviRuleComponentBounds

/-! A fixed bound on seed powers cannot generate the original D4 ideal.
Every bounded-power source has positive current degree when R<=m, whereas
an actual unbounded seed U_0^(m+1) has current degree zero and is nonzero. -/
namespace VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
open VOA.DeligneAudit.D4FusionContact.Polynomial
noncomputable section

abbrev PowerBoundedSourceIndex (m R : ℕ) := {i : OrbitSourceIndex m // i.seed.val.2.1 ≤ R}

def powerBoundedSource (m R : ℕ) (i : PowerBoundedSourceIndex m R) : Ring ℂ m :=
  orbitSourcePoly m i.val

def powerBoundedIdeal (m R : ℕ) : Ideal (Ring ℂ m) :=
  Ideal.span (Set.range (powerBoundedSource m R))

def sourceCurrent (m R : ℕ) (i : PowerBoundedSourceIndex m R) : ℤ :=
  (i.val.seed.val.2.2 + i.val.shifts.sum + (i.val.outer.map Prod.snd).sum : ℕ)

theorem sourceCurrent_pos (m R : ℕ) (hR : R ≤ m) (i : PowerBoundedSourceIndex m R) :
    0 < sourceCurrent m R i := by
  have hs := i.val.seed.property.2
  have hr := i.property
  have ht : m ≤ AllM.seedThreshold m i.val.seed.val.1 := by
    unfold AllM.seedThreshold
    split_ifs <;> omega
  have hp : 0 < i.val.seed.val.2.2 := by omega
  unfold sourceCurrent
  exact_mod_cast (show 0 < i.val.seed.val.2.2 + i.val.shifts.sum +
    (i.val.outer.map Prod.snd).sum by omega)

theorem powerBoundedSource_graded (m R : ℕ) (i : PowerBoundedSourceIndex m R) :
    (powerBoundedSource m R i).IsWeightedHomogeneous (modeWeight m (fun _ => 0) 1)
      (sourceCurrent m R i) := sourceWord_current m i.val.seed i.val.shifts i.val.outer

theorem currentMonomial_nonneg (m : ℕ) (e : (Fin 9 × Fin m) →₀ ℕ) :
    0 ≤ Finsupp.weight (modeWeight m (fun _ => 0) 1) e := by
  simp only [Finsupp.weight_apply,Finsupp.sum,nsmul_eq_mul]
  apply Finset.sum_nonneg
  intro x _
  apply mul_nonneg (Nat.cast_nonneg _)
  simp only [modeWeight,zero_add,one_mul]
  exact Nat.cast_nonneg _

/-- The whole ideal generated by bounded powers has no current-degree-zero part. -/
theorem powerBoundedIdeal_current_zero (m R : ℕ) (hR : R ≤ m) {p : Ring ℂ m}
    (hp : p ∈ powerBoundedIdeal m R)
    (hg : p.IsWeightedHomogeneous (modeWeight m (fun _ => 0) 1) 0) : p = 0 := by
  have he : matchingGradeProducts (modeWeight m (fun _ => 0) 1)
      (powerBoundedSource m R) (sourceCurrent m R) 0 = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro q ⟨i,e,hm,_⟩
    have hs := sourceCurrent_pos m R hR i
    have hw := currentMonomial_nonneg m e
    omega
  have hh := homogeneous_ideal_mem_matching_span (modeWeight m (fun _ => 0) 1)
    (powerBoundedSource m R) (sourceCurrent m R) (powerBoundedSource_graded m R) hp hg
  rw [he,Submodule.span_empty] at hh
  exact hh

def zeroModeWitness (m : ℕ) : Ring ℂ m := mode ℂ m 0 0 ^ (m+1)

theorem zeroModeWitness_mem (m : ℕ) : zeroModeWitness m ∈ AllM.candidateIdeal m := by
  have h := AllM.seed_mem_candidate m
    (⟨(false,m+1,0),by
      constructor <;> simp only [AllM.seedThreshold,Bool.false_eq_true,if_false] <;> omega⟩)
  change PowerSeries.coeff 0 (colorCurrent ℂ m 0 ^ (m+1)) ∈ AllM.candidateIdeal m at h
  simpa only [PowerSeries.coeff_zero_eq_constantCoeff,map_pow,colorCurrent,
    PowerSeries.constantCoeff_mk] using h

theorem zeroModeWitness_graded (m : ℕ) :
    (zeroModeWitness m).IsWeightedHomogeneous (modeWeight m (fun _ => 0) 1) 0 := by
  have hh := (mode_graded ℂ m (fun _ => 0) 1 0 0).pow (m+1)
  simpa only [zero_mul,add_zero,nsmul_zero] using hh

theorem zeroModeWitness_ne_zero (m : ℕ) (hm : 1 ≤ m) : zeroModeWitness m ≠ 0 := by
  unfold zeroModeWitness
  rw [mode,dif_pos (show 0 < m by omega)]
  exact pow_ne_zero _ (MvPolynomial.X_ne_zero _)

theorem powerBoundedIdeal_le_candidate (m R : ℕ) :
    powerBoundedIdeal m R ≤ AllM.candidateIdeal m := by
  apply Ideal.span_le.mpr
  rintro p ⟨i,rfl⟩
  exact word_mem_candidate m i.val.outer (shiftWord_seed_mem m i.val.seed i.val.shifts)

/-- No fixed power bound works for all m, even with all shifts, outer words and multipliers. -/
theorem powerBoundedIdeal_lt_candidate (m R : ℕ) (hm : 1 ≤ m) (hR : R ≤ m) :
    powerBoundedIdeal m R < AllM.candidateIdeal m := by
  apply lt_of_le_of_ne (powerBoundedIdeal_le_candidate m R)
  intro he
  have hw : zeroModeWitness m ∈ powerBoundedIdeal m R := by rw [he]; exact zeroModeWitness_mem m
  exact zeroModeWitness_ne_zero m hm
    (powerBoundedIdeal_current_zero m R hR hw (zeroModeWitness_graded m))

end
#print axioms powerBoundedIdeal_current_zero
#print axioms zeroModeWitness_mem
#print axioms powerBoundedIdeal_lt_candidate
end VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
