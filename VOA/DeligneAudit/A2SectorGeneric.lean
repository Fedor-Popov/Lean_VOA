import VOA.DeligneAudit.A2SectorB8

/-!
# The generic comparison: `Δ^3 W_m ⊂ M_m`

Interpolation (audit repair 1): over the full polynomial ring `P_m = ℂ[z₁,…,z_m]` the operator
`Σ_r c_r (x ⊗ t^r)` with `Σ_r c_r t^r = ∏_{j ≠ i}(t - z_j)` equals `D_i · x^{(i)}` (`x` acting in slot
`i` only), `D_i = ∏_{j≠i}(z_i - z_j)`.  So the `P_m`-span of `M_m` is stable under `D_i x^{(i)}`.
The coadjoint representation of `sl₃` is generated by `f₁₂*` in at most three steps, hence every
basis tensor, times `Δ³ = ∏_i D_i³`, lies in `P_m M_m`.  The Reynolds operator then brings the
coefficients of a symmetric tensor back into `B_m`, and `M_m` is a `B_m`-module.
-/

namespace VOA.DeligneAudit.A2

open MvPolynomial VOA.AffineSl3 VOA.DeligneAudit.SectorLoop VOA.DeligneAudit.SectorFiber
open VOA.DeligneAudit.SectorFiberModule VOA.QuadraticCurrentFunctionalCarrier

noncomputable section

variable {m : ℕ}

/-- The ambient tensor polynomials. -/
abbrev TP (m : ℕ) := TensorPolynomial (K := ℂ) (σ := Fin 8) m 0

/-- The full polynomial ring of the roots. -/
abbrev Pm (m : ℕ) := MvPolynomial (Fin (m + 0)) ℂ

theorem psmul_apply (p : Pm m) (v : TP m) (t : Fin m → Fin 8) : (p • v) t = p * v t := rfl

/-- `x` acting in slot `i` only (coadjoint). -/
def slotOp (x : Fin 8) (i : Fin m) : TP m →ₗ[ℂ] TP m where
  toFun p t := -∑ c, MvPolynomial.C (bracketTable x (t i) c) * p (Function.update t i c)
  map_add' p q := by funext t; simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib, neg_add]
  map_smul' a p := by
    funext t
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_C_mul, Finset.mul_sum, mul_neg]
    congr 1
    refine Finset.sum_congr rfl fun c _ => ?_
    ring

theorem loopOp_eq_sum_slot (x : Fin 8) (r : ℕ) (v : TP m) :
    loopOp bracketTable m x r v = ∑ i, (zr (K := ℂ) i ^ r : Pm m) • slotOp x i v := by
  funext t
  simp only [loopOp, slotOp, LinearMap.coe_mk, AddHom.coe_mk, Finset.sum_apply, psmul_apply,
    mul_neg, Finset.sum_neg_distrib]

theorem slotOp_psmul (x : Fin 8) (i : Fin m) (p : Pm m) (v : TP m) :
    slotOp x i (p • v) = p • slotOp x i v := by
  funext t
  simp only [slotOp, LinearMap.coe_mk, AddHom.coe_mk, psmul_apply, Finset.mul_sum, mul_neg]
  congr 1
  refine Finset.sum_congr rfl fun c _ => ?_
  ring

theorem loopOp_psmul (x : Fin 8) (r : ℕ) (p : Pm m) (v : TP m) :
    loopOp bracketTable m x r (p • v) = p • loopOp bracketTable m x r v := by
  rw [loopOp_eq_sum_slot, loopOp_eq_sum_slot, Finset.smul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [slotOp_psmul, smul_smul, smul_smul, mul_comm]

theorem loopOp_mem_Mspace (x : Fin 8) (r : ℕ) {v : TP m}
    (hv : v ∈ Mspace bracketTable m (5 : Fin 8)) :
    loopOp bracketTable m x r v ∈ Mspace bracketTable m 5 := by
  induction hv using Submodule.span_induction with
  | mem w hw =>
      obtain ⟨l, rfl⟩ := hw
      exact Submodule.subset_span ⟨(x, r) :: l, rfl⟩
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha

/-- `P_m · M_m`. -/
def MP (m : ℕ) : Submodule (Pm m) (TP m) :=
  Submodule.span (Pm m) (Mspace bracketTable m (5 : Fin 8) : Set (TP m))

theorem loopOp_mem_MP (x : Fin 8) (r : ℕ) {v : TP m} (hv : v ∈ MP m) :
    loopOp bracketTable m x r v ∈ MP m := by
  induction hv using Submodule.span_induction with
  | mem w hw => exact Submodule.subset_span (loopOp_mem_Mspace x r hw)
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul p a _ ha => rw [loopOp_psmul]; exact Submodule.smul_mem _ p ha

/-! ## Interpolation -/

/-- `D_i = ∏_{j ≠ i} (z_i - z_j)`. -/
def Dslot (i : Fin m) : Pm m := ∏ j : Fin m, if j = i then 1 else (zr (K := ℂ) i - zr j)

/-- `L_i(t) = ∏_{j ≠ i} (t - z_j)`. -/
def Lpoly (i : Fin m) : Polynomial (Pm m) :=
  ∏ j : Fin m, if j = i then 1 else (Polynomial.X - Polynomial.C (zr (K := ℂ) j))

theorem eval_Lpoly (i k : Fin m) :
    (Lpoly i).eval (zr (K := ℂ) k) = if k = i then Dslot i else 0 := by
  rw [Lpoly, Polynomial.eval_prod]
  split_ifs with hk
  · subst hk
    rw [Dslot]
    refine Finset.prod_congr rfl fun j _ => ?_
    split_ifs <;> simp
  · apply Finset.prod_eq_zero (Finset.mem_univ k)
    rw [if_neg hk]
    simp

/-- **Interpolation**: a `P_m`-combination of loop operators acts in one slot only. -/
theorem interp (x : Fin 8) (i : Fin m) (v : TP m) :
    ∑ r ∈ Finset.range ((Lpoly i).natDegree + 1),
        ((Lpoly i).coeff r) • loopOp bracketTable m x r v = Dslot i • slotOp x i v := by
  simp only [loopOp_eq_sum_slot, Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  simp only [← Finset.sum_smul]
  have h : ∀ k : Fin m, (∑ r ∈ Finset.range ((Lpoly i).natDegree + 1),
      (Lpoly i).coeff r * zr (K := ℂ) k ^ r) = if k = i then Dslot i else 0 := by
    intro k
    rw [← eval_Lpoly, Polynomial.eval_eq_sum_range]
  simp only [h, ite_smul, zero_smul, Finset.sum_ite_eq', Finset.mem_univ, if_true]

theorem Dslot_slotOp_mem_MP (x : Fin 8) (i : Fin m) {v : TP m} (hv : v ∈ MP m) :
    Dslot i • slotOp x i v ∈ MP m := by
  rw [← interp]
  exact Submodule.sum_mem _ fun r _ => Submodule.smul_mem _ _ (loopOp_mem_MP x r hv)

/-! ## Basis tensors and the single-slot recipes -/

/-- The basis tensor `δ_t`. -/
def deltaT (t : Fin m → Fin 8) : TP m := fun t' => if t' = t then 1 else 0

theorem slotOp_deltaT (x : Fin 8) (i : Fin m) (t : Fin m → Fin 8) :
    slotOp x i (deltaT t) =
      ∑ y, (MvPolynomial.C (-bracketTable x y (t i)) : Pm m) • deltaT (Function.update t i y) := by
  funext t'
  simp only [slotOp, LinearMap.coe_mk, AddHom.coe_mk, deltaT, Finset.sum_apply, psmul_apply,
    mul_ite, mul_one, mul_zero]
  by_cases h : ∀ j, j ≠ i → t' j = t j
  · have h1 : ∀ c, (Function.update t' i c = t ↔ c = t i) := by
      intro c
      constructor
      · intro hc; rw [← hc]; simp
      · rintro rfl; funext j; by_cases hj : j = i
        · subst hj; simp
        · rw [Function.update_of_ne hj, h j hj]
    have h2 : ∀ y, (t' = Function.update t i y ↔ y = t' i) := by
      intro y
      constructor
      · rintro rfl; simp
      · rintro rfl; funext j; by_cases hj : j = i
        · subst hj; simp
        · rw [Function.update_of_ne hj, h j hj]
    simp only [h1, h2, Finset.sum_ite_eq', Finset.mem_univ, if_true, map_neg]
  · have h1 : ∀ c, ¬ (Function.update t' i c = t) := by
      intro c hc; apply h; intro j hj; rw [← hc, Function.update_of_ne hj]
    have h2 : ∀ y, ¬ (t' = Function.update t i y) := by
      intro y hy; apply h; intro j hj; rw [hy, Function.update_of_ne hj]
    simp [h1, h2]

theorem deltaT_update_update (t : Fin m → Fin 8) (i : Fin m) (a b : Fin 8) :
    deltaT (m := m) (Function.update (Function.update t i a) i b) =
      deltaT (Function.update t i b) := by
  rw [Function.update_idem]

/-- One slot-step of the recipe, in closed form. -/
theorem slotOp_e (x : Fin 8) (i : Fin m) (t : Fin m → Fin 8) (a : Fin 8) :
    slotOp x i (deltaT (Function.update t i a)) =
      ∑ y, (MvPolynomial.C (-bracketTable x y a) : Pm m) • deltaT (Function.update t i y) := by
  rw [slotOp_deltaT]
  simp only [Function.update_self, deltaT_update_update]

section Recipes

variable (i : Fin m) (t : Fin m → Fin 8)

/-- `e c = δ_{t[i ↦ c]}`. -/
abbrev ee (c : Fin 8) : TP m := deltaT (Function.update t i c)

theorem slotOp_ee (x : Fin 8) (a : Fin 8) :
    slotOp x i (ee i t a) = ∑ y, (MvPolynomial.C (-bracketTable x y a) : Pm m) • ee i t y :=
  slotOp_e x i t a

theorem slotOp_sum_smul (x : Fin 8) (g : Fin 8 → Pm m) :
    slotOp x i (∑ y, g y • ee i t y) = ∑ y, g y • slotOp x i (ee i t y) := by
  rw [map_sum]
  exact Finset.sum_congr rfl fun y _ => slotOp_psmul x i _ _

set_option maxHeartbeats 1000000 in -- explicit coadjoint computations
theorem rec4 : slotOp 3 i (ee i t 5) = ee i t 4 := by
  rw [slotOp_ee]; simp [Fin.sum_univ_eight, bracketTable]

set_option maxHeartbeats 1000000 in -- explicit coadjoint computations
theorem rec3 : slotOp 4 i (ee i t 5) = -ee i t 3 := by
  rw [slotOp_ee]; simp [Fin.sum_univ_eight, bracketTable]

set_option maxHeartbeats 1000000 in -- explicit coadjoint computations
theorem rec0 : slotOp 5 i (slotOp 3 i (ee i t 5)) = -ee i t 0 := by
  rw [rec4, slotOp_ee]; simp [Fin.sum_univ_eight, bracketTable]

set_option maxHeartbeats 1000000 in -- explicit coadjoint computations
theorem rec1 : slotOp 5 i (slotOp 4 i (ee i t 5)) = -ee i t 1 := by
  rw [rec3, map_neg, slotOp_ee]; simp [Fin.sum_univ_eight, bracketTable]

set_option maxHeartbeats 1000000 in -- explicit coadjoint computations
theorem rec2 : slotOp 5 i (slotOp 5 i (ee i t 5)) = -ee i t 2 + -ee i t 2 := by
  rw [slotOp_ee, slotOp_sum_smul]
  simp only [slotOp_ee]
  simp [Fin.sum_univ_eight, bracketTable]

set_option maxHeartbeats 2000000 in -- explicit coadjoint computations
theorem rec6 : slotOp 1 i (slotOp 5 i (slotOp 4 i (ee i t 5))) =
    ee i t 6 + -ee i t 7 + -ee i t 7 := by
  rw [rec1, map_neg, slotOp_ee]
  simp [Fin.sum_univ_eight, bracketTable]
  rw [show (MvPolynomial.C (2 : ℂ) : Pm m) • ee i t 7 = ee i t 7 + ee i t 7 by
    rw [map_ofNat, two_smul]]
  abel

set_option maxHeartbeats 2000000 in -- explicit coadjoint computations
theorem rec7 : slotOp 5 i (slotOp 1 i (slotOp 4 i (ee i t 5))) = -ee i t 6 + -ee i t 7 := by
  rw [rec3, map_neg, slotOp_ee, map_neg, slotOp_sum_smul]
  simp only [slotOp_ee]
  simp [Fin.sum_univ_eight, bracketTable]

end Recipes

/-! ## Reaching every basis tensor in one slot -/

theorem step_MP (x : Fin 8) (i : Fin m) {k : ℕ} {v : TP m} (hv : Dslot i ^ k • v ∈ MP m) :
    Dslot i ^ (k + 1) • slotOp x i v ∈ MP m := by
  rw [pow_succ', mul_smul, ← slotOp_psmul]
  exact Dslot_slotOp_mem_MP x i hv

theorem mono_MP (i : Fin m) {k : ℕ} {v : TP m} (hv : Dslot i ^ k • v ∈ MP m) :
    Dslot i ^ (k + 1) • v ∈ MP m := by
  rw [pow_succ', mul_smul]
  exact Submodule.smul_mem _ _ hv

theorem mem_of_nsmul_MP (n : ℕ) (hn : n ≠ 0) {v : TP m} (hv : (n : Pm m) • v ∈ MP m) :
    v ∈ MP m := by
  have h := Submodule.smul_mem (MP m) (MvPolynomial.C ((n : ℂ)⁻¹)) hv
  rwa [smul_smul, show (MvPolynomial.C ((n : ℂ)⁻¹) : Pm m) * (n : Pm m) = 1 by
    rw [← map_natCast MvPolynomial.C n, ← map_mul, inv_mul_cancel₀ (by exact_mod_cast hn),
      map_one], one_smul] at h

set_option maxHeartbeats 1000000 in -- case analysis over the eight basis vectors
/-- **One slot**: from `Q • δ_{t[i↦f₁₂]} ∈ P_m M_m`, every `D_i³ Q δ_{t[i↦c]}` lies in `P_m M_m`. -/
theorem slot_all (i : Fin m) (t : Fin m → Fin 8) (Q : Pm m) (hQ : Q • ee i t 5 ∈ MP m)
    (c : Fin 8) : (Dslot i ^ 3 * Q) • ee i t c ∈ MP m := by
  have h0 : Dslot i ^ 0 • (Q • ee i t 5) ∈ MP m := by rwa [pow_zero, one_smul]
  have s1 := fun x => step_MP x i h0
  have s2 := fun x y => step_MP y i (s1 x)
  have s3 := fun x y z => step_MP z i (s2 x y)
  have m1 := fun x => mono_MP i (mono_MP i (s1 x))
  have m2 := fun x y => mono_MP i (s2 x y)
  have m0 := mono_MP i (mono_MP i (mono_MP i h0))
  simp only [← slotOp_psmul] at s1 s2 s3 m1 m2
  simp only [zero_add, Nat.reduceAdd] at s1 s2 s3 m0 m1 m2
  rw [mul_smul]
  fin_cases c
  · -- e₁
    have h := m2 3 5
    simp only [slotOp_psmul, rec0, smul_neg] at h
    simpa using Submodule.neg_mem _ h
  · -- e₂
    have h := m2 4 5
    simp only [slotOp_psmul, rec1, smul_neg] at h
    simpa using Submodule.neg_mem _ h
  · -- e₁₂
    have h := m2 5 5
    simp only [slotOp_psmul, rec2, smul_add, smul_neg] at h
    apply mem_of_nsmul_MP 2 (by norm_num)
    have h' := Submodule.neg_mem _ h
    convert h' using 1
    simp only [Nat.cast_ofNat, neg_add_rev, neg_neg]
    rw [two_smul]
    rfl
  · -- f₁
    have h := m1 4
    simp only [slotOp_psmul, rec3, smul_neg] at h
    simpa using Submodule.neg_mem _ h
  · -- f₂
    have h := m1 3
    simpa only [slotOp_psmul, rec4] using h
  · -- f₁₂
    simpa using m0
  · -- h₁
    have h6 := s3 4 5 1
    have h7 := s3 4 1 5
    simp only [slotOp_psmul, rec6, rec7] at h6 h7
    apply mem_of_nsmul_MP 3 (by norm_num)
    have := Submodule.sub_mem _ h6 (Submodule.smul_mem _ (2 : Pm m) h7)
    convert this using 1
    have e3 : ∀ y : TP m, (3 : Pm m) • y = y + y + y := fun y => by
      rw [show (3 : Pm m) = 1 + 1 + 1 by norm_num, add_smul, add_smul, one_smul]
    simp only [Nat.cast_ofNat, e3, two_smul, smul_add, smul_neg]
    abel
  · -- h₂
    have h6 := s3 4 5 1
    have h7 := s3 4 1 5
    simp only [slotOp_psmul, rec6, rec7] at h6 h7
    apply mem_of_nsmul_MP 3 (by norm_num)
    have := Submodule.neg_mem _ (Submodule.add_mem _ h6 h7)
    convert this using 1
    have e3 : ∀ y : TP m, (3 : Pm m) • y = y + y + y := fun y => by
      rw [show (3 : Pm m) = 1 + 1 + 1 by norm_num, add_smul, add_smul, one_smul]
    simp only [Nat.cast_ofNat, e3, smul_add, smul_neg]
    abel

/-! ## All slots -/

theorem all_slots (J : Finset (Fin m)) :
    ∀ t : Fin m → Fin 8, (∀ j, j ∉ J → t j = 5) →
      (∏ j ∈ J, Dslot j ^ 3) • deltaT t ∈ MP m := by
  classical
  induction J using Finset.induction_on with
  | empty =>
      intro t ht
      have : t = fun _ => (5 : Fin 8) := funext fun j => ht j (Finset.notMem_empty j)
      subst this
      rw [Finset.prod_empty, one_smul]
      exact Submodule.subset_span (Submodule.subset_span ⟨[], rfl⟩)
  | insert i J hi ih =>
      intro t ht
      set t' := Function.update t i 5 with ht'
      have hJ : ∀ j, j ∉ J → t' j = 5 := by
        intro j hj
        by_cases hji : j = i
        · subst hji; simp [t']
        · rw [ht', Function.update_of_ne hji]
          exact ht j (by simp [hji, hj])
      have h1 := ih t' hJ
      have he5 : ee i t' 5 = deltaT t' := by
        simp only [ee, t', Function.update_idem]
      rw [← he5] at h1
      have h2 := slot_all i t' _ h1 (t i)
      have het : ee i t' (t i) = deltaT t := by
        simp only [ee, t', Function.update_idem, Function.update_eq_self]
      rw [het] at h2
      rwa [Finset.prod_insert hi]

theorem discS_coe (m : ℕ) : ((discS m : SymAlg (K := ℂ) m) : Pm m) = ∏ j : Fin m, Dslot j := by
  simp only [discS, Dslot]
  refine Finset.prod_congr rfl fun i _ => Finset.prod_congr rfl fun j _ => ?_
  by_cases h : i = j
  · subst h; simp
  · rw [if_neg h, if_neg (Ne.symm h)]
    rfl

theorem tensor_eq_sum (x : TP m) : x = ∑ t, x t • deltaT t := by
  funext t'
  simp [Finset.sum_apply, deltaT]

/-- **`Δ³ · v ∈ P_m M_m` for every tensor polynomial `v`.** -/
theorem disc_cube_mem_MP (x : TP m) : ((discS m : Pm m) ^ 3) • x ∈ MP m := by
  rw [tensor_eq_sum x, Finset.smul_sum]
  refine Submodule.sum_mem _ fun t _ => ?_
  rw [smul_comm]
  refine Submodule.smul_mem _ _ ?_
  rw [discS_coe, ← Finset.prod_pow]
  exact all_slots Finset.univ t (fun j hj => absurd (Finset.mem_univ j) hj)

/-! ## The Reynolds operator -/

/-- Simultaneous permutation of slots and roots. -/
def act (g : Equiv.Perm (Fin m)) (v : TP m) : TP m := fun t => rename (⇑g) (v (t ∘ g))

theorem act_of_symmetric {v : TP m} (hv : Symmetric v) (g : Equiv.Perm (Fin m)) :
    act g v = v := by
  funext t
  have h := hv (g : Equiv.Perm (Fin (m + 0))) g (fun i => rfl) (t ∘ g)
  simp only [act]
  rw [h, Function.comp_assoc, Equiv.self_comp_symm, Function.comp_id]

theorem act_psmul (g : Equiv.Perm (Fin m)) (p : Pm m) (v : TP m) :
    act g (p • v) = rename (⇑g) p • act g v := by
  funext t
  simp only [act, psmul_apply, map_mul]

theorem act_add (g : Equiv.Perm (Fin m)) (v w : TP m) : act g (v + w) = act g v + act g w := by
  funext t; simp [act]

theorem act_sum (g : Equiv.Perm (Fin m)) {ι : Type*} (S : Finset ι) (v : ι → TP m) :
    act g (∑ k ∈ S, v k) = ∑ k ∈ S, act g (v k) := by
  funext t; simp [act, Finset.sum_apply, map_sum]

/-- The symmetrization of a polynomial. -/
def symP (p : Pm m) : SymAlg (K := ℂ) m :=
  ⟨MvPolynomial.C ((Fintype.card (Equiv.Perm (Fin m)) : ℂ)⁻¹) *
      ∑ g : Equiv.Perm (Fin m), rename (⇑g) p, by
    intro h
    rw [map_mul, rename_C, map_sum]
    congr 1
    refine Fintype.sum_equiv (Equiv.mulLeft (h : Equiv.Perm (Fin m))) _ _ fun g => ?_
    rw [rename_rename]
    rfl⟩

theorem card_perm_ne_zero : (Fintype.card (Equiv.Perm (Fin m)) : ℂ) ≠ 0 := by
  exact_mod_cast Fintype.card_ne_zero

/-- **Reynolds**: a symmetric tensor in `P_m M_m` lies in `M_m`. -/
theorem mem_Mspace_of_symmetric {v : TP m} (hv : v ∈ MP m) (hs : Symmetric v) :
    v ∈ Mspace bracketTable m (5 : Fin 8) := by
  classical
  obtain ⟨n, f, y, rfl⟩ := Submodule.mem_span_set'.mp hv
  -- average over the symmetric group
  have hsum : (∑ i, f i • (y i : TP m)) =
      ∑ i, (symP (f i) : SymAlg (K := ℂ) m) • (y i : TP m) := by
    have hy : ∀ i, Symmetric (y i : TP m) := fun i =>
      (Mspace_le_carrier m (y i).2).1
    have key : ∀ g : Equiv.Perm (Fin m), act g (∑ i, f i • (y i : TP m)) = ∑ i, f i • (y i : TP m) :=
      fun g => act_of_symmetric hs g
    have havg : (∑ i, f i • (y i : TP m)) =
        (MvPolynomial.C ((Fintype.card (Equiv.Perm (Fin m)) : ℂ)⁻¹) : Pm m) •
          ∑ g : Equiv.Perm (Fin m), act g (∑ i, f i • (y i : TP m)) := by
      simp only [key, Finset.sum_const, Finset.card_univ]
      rw [← Nat.cast_smul_eq_nsmul (Pm m), smul_smul, ← map_natCast MvPolynomial.C, ← map_mul,
        inv_mul_cancel₀ card_perm_ne_zero, map_one, one_smul]
    rw [havg]
    simp only [act_sum, act_psmul, act_of_symmetric (hy _)]
    rw [Finset.sum_comm, Finset.smul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    funext t
    simp only [psmul_apply, smul_apply_sym, symP, Finset.sum_apply, Finset.sum_mul, mul_assoc]
  rw [hsum]
  exact Submodule.sum_mem _ fun i _ => smul_mem_Mspace m _ (y i).2

/-! ## The generic comparison -/

theorem disc_symmetric_smul {x : TP m} (hx : Symmetric x) :
    Symmetric (((discS m : Pm m) ^ 3) • x) := by
  intro e g he t
  rw [psmul_apply, psmul_apply, map_mul, map_pow, hx e g he t]
  congr 2
  exact (discS m).2 e

/-- **Generic comparison, proved**: `Δ³ W_m ⊂ M_m`. -/
theorem genericComparison : GenericComparison := by
  refine ⟨fun m x hx => ⟨3, ?_⟩⟩
  have h1 := mem_Mspace_of_symmetric (disc_cube_mem_MP x) (disc_symmetric_smul hx.1)
  convert h1 using 1

open VOA.DeligneHigherRankConditionalCapstone in
/-- **A₂ Deligne classical freeness from seven named inputs** (the generic comparison of B8 is
proved): `CasimirLayerBound` (B1), `MFreeness` (B6), `DivisorComparison` (B8 at `(Δ)`),
`FusionModuleBound F` (U5), `MixedFusionRecursion F demazureHilbSeries` (U6), `StarIdentity`,
`KacWakimotoLowerBound`. -/
theorem classicallyFree_of_divisorInputs (F : ℕ → PowerSeries ℚ)
    (hL : CasimirLayerBound) (hF : MFreeness) (hD : DivisorComparison)
    (hU5 : SectorWeyl.FusionModuleBound F)
    (hU6 : MixedFusionRecursion F demazureHilbSeries)
    (hstar : StarIdentity) (hkw : KacWakimotoLowerBound) :
    CaseClassicallyFree .A2 W explicitPresentation ∧
      RingHom.ker (MvPolynomial.aeval fun i =>
        liDegreeZeroClass W 1 ⟨explicitPresentation.gen i,
          explicitPresentation.gen_weight_one i⟩).toRingHom = I2ns :=
  classicallyFree_of_B8Inputs F hL hF genericComparison hD hU5 hU6 hstar hkw

end

