import VOA.DeligneAudit.E6CarrierTables
import VOA.AffineGeneral.E6Table
import VOA.DeligneAudit.E6SectorDefs

set_option linter.style.longLine false

/-!
# E₆ sector tables: stability of `I₂` under the Chevalley generators

`Pq s` is the `s`-th quadratic of `I₂ = I₂ⁿˢ ⊕ ℂQ` (`s < 650`: a relation, `s = 650`: the Casimir).
`stabOK g rows` checks, for every `r ≤ 650`, the certificate `L · adDer g (P_r) = Σ λ · P_s`
(rows `[L, z s, …]`, generated by a script not included in this release), by `E6Sparse.quadZero`.
-/

set_option maxRecDepth 100000

namespace VOA.DeligneAudit.DeligneCarrier.E6

open VOA.DeligneAudit.E6Sparse VOA.DeligneAudit.E6SectorSparse VOA.AffineGeneral.SCLie

/-- The quadratics of `I₂`. -/
def Pq (s : ℕ) : List (ℕ × ℕ × ℤ) := if s < 650 then relQ s else qQ

/-- Pairs `(λ, s)` from flat `z s` data. -/
def pairsOf : List ℕ → List (ℤ × ℕ)
  | z :: s :: rest => (E6Sparse.decZ z, s) :: pairsOf rest
  | _ => []

/-- Negate a sparse quadratic. -/
def negQ (l : List (ℕ × ℕ × ℤ)) : List (ℕ × ℕ × ℤ) := scaleQ (-1) l

/-- One stability certificate. -/
def stabRowOK (g r : ℕ) (c : List ℕ) : Bool :=
  decide (certL c ≠ 0) && (pairsOf c.tail).all (fun p => p.2 ≤ 650) &&
    quadZero (scaleQ (certL c) (adS e6T g (Pq r)) ++
      negQ ((pairsOf c.tail).flatMap fun p => scaleQ p.1 (Pq p.2)))

/-- All 651 certificates of a generator. -/
def stabOK (g : ℕ) (rows : List (List ℕ)) : Bool :=
  decide (rows.length = 651) && (List.range 651).all fun r => stabRowOK g r (rows.getD r [])

/-- Certificates `lo ≤ r < hi` of a generator. -/
def stabPart (g : ℕ) (rows : List (List ℕ)) (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun r => stabRowOK g r (rows.getD r [])

theorem stabOK_of_parts (g : ℕ) (rows : List (List ℕ)) (hlen : rows.length = 651)
    (h1 : stabPart g rows 0 217 = true) (h2 : stabPart g rows 217 434 = true)
    (h3 : stabPart g rows 434 651 = true) : stabOK g rows = true := by
  simp only [stabOK, hlen, decide_true, Bool.true_and]
  refine List.all_eq_true.mpr fun r hr => ?_
  have hr' := List.mem_range.mp hr
  rcases (show r < 217 ∨ (217 ≤ r ∧ r < 434) ∨ (434 ≤ r ∧ r < 651) by omega) with h | h | h
  · exact List.all_eq_true.mp h1 r (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
  · exact List.all_eq_true.mp h2 r (List.mem_range'_1.mpr ⟨h.1, by omega⟩)
  · exact List.all_eq_true.mp h3 r (List.mem_range'_1.mpr ⟨h.1, by omega⟩)

theorem Pq_inRange : (List.range 651).all (fun s => qInRange 78 (Pq s)) = true := by decide +kernel

end VOA.DeligneAudit.DeligneCarrier.E6
