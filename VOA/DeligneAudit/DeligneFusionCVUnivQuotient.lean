import VOA.DeligneAudit.DeligneFusionCVUniv
import VOA.DeligneAudit.DeligneFusionCVQuotient
import VOA.DeligneAudit.DeligneFusionGrade

/-!
# The actual universal CV quotient map and its exact kernel

The quotient map is surjective. Its kernel is exactly the sum of the cyclic
submodules generated by the two simple-root top modes. The proof uses the
checked presentation equivalence and constructs an inverse map into that
explicit quotient. No dimension or exactness premise is assumed.
-/

namespace VOA.DeligneAudit.A2.CVUniv

open VOA.AffineSl3 VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.A2.CVFamily

noncomputable section

/-- Words on the universal generator span the entire actual CV module. -/
theorem cv_span_top (ε ν ϱ : Weight) (j : ℕ) :
    Submodule.span ℂ (Set.range fun l : List (UnivG.Ltr 8) =>
      wordOp (cvUnivRep ε ν ϱ j) l (cv_wU ε ν ϱ j)) = ⊤ := by
  apply top_unique
  intro v hv
  clear hv
  induction v using Submodule.Quotient.induction_on with
  | H v =>
      induction v using Finsupp.induction_linear with
      | zero => exact Submodule.zero_mem _
      | add x y hx hy =>
          simpa only [Submodule.Quotient.mk_add] using Submodule.add_mem _ hx hy
      | single l c =>
          have hc : Finsupp.single l c = c • UnivG.sw l := by simp [UnivG.sw]
          rw [hc, Submodule.Quotient.mk_smul]
          apply Submodule.smul_mem
          exact Submodule.subset_span ⟨l, UnivG.wordOp_univG bracketTable (cvSpec ε ν ϱ j) l⟩

/-- The actual universal map to the quotient member of the auxiliary family. -/
def cvQuotientMap (ε ν ϱ : Weight) (k : ℕ) :
    CVMod ε ν ϱ (k + 2) →ₗ[ℂ] CVMod ε (ν + (1, 1)) ϱ k :=
  cvMap ((quotient_rel_iff (ε := ε) (ν := ν) (ϱ := ϱ) (k := k)).mp
    (cvUniv_rel ε (ν + (1, 1)) ϱ k)).1

theorem cvQuotientMap_wordOp (ε ν ϱ : Weight) (k : ℕ) (l : List (UnivG.Ltr 8)) :
    cvQuotientMap ε ν ϱ k (wordOp (cvUnivRep ε ν ϱ (k + 2)) l (cv_wU ε ν ϱ (k + 2))) =
      wordOp (cvUnivRep ε (ν + (1, 1)) ϱ k) l (cv_wU ε (ν + (1, 1)) ϱ k) :=
  cvMap_wordOp _ l

/-- Every exact current-degree piece maps onto the corresponding target piece. -/
theorem cvQuotientMap_cycDeg (ε ν ϱ : Weight) (k d : ℕ) :
    (cycDeg (cvUnivRep ε ν ϱ (k + 2)) (cv_wU ε ν ϱ (k + 2)) d).map
        (cvQuotientMap ε ν ϱ k) =
      cycDeg (cvUnivRep ε (ν + (1, 1)) ϱ k) (cv_wU ε (ν + (1, 1)) ϱ k) d :=
  map_cycDeg _ d

/-- Surjectivity follows from universal word spanning, without a count. -/
theorem cvQuotientMap_surjective (ε ν ϱ : Weight) (k : ℕ) :
    Function.Surjective (cvQuotientMap ε ν ϱ k) := by
  apply LinearMap.range_eq_top.mp
  apply top_unique
  rw [← cv_span_top ε (ν + (1, 1)) ϱ k]
  apply Submodule.span_le.mpr
  rintro _ ⟨l, rfl⟩
  exact ⟨wordOp (cvUnivRep ε ν ϱ (k + 2)) l (cv_wU ε ν ϱ (k + 2)),
    cvQuotientMap_wordOp ε ν ϱ k l⟩

/-- The first simple-root top vector in the larger universal module. -/
def cvTopFirst (ε ν ϱ : Weight) (k : ℕ) : CVMod ε ν ϱ (k + 2) :=
  (cvUnivRep ε ν ϱ (k + 2)).op 3 (ε.1 + ν.1 + ϱ.1 + k + 1)
    (cv_wU ε ν ϱ (k + 2))

/-- The second simple-root top vector in the larger universal module. -/
def cvTopSecond (ε ν ϱ : Weight) (k : ℕ) : CVMod ε ν ϱ (k + 2) :=
  (cvUnivRep ε ν ϱ (k + 2)).op 4 (ε.2 + ν.2 + ϱ.2 + k + 1)
    (cv_wU ε ν ϱ (k + 2))

/-- The explicit proposed kernel: the sum of the two cyclic submodules. -/
def cvKernelSpan (ε ν ϱ : Weight) (k : ℕ) : Submodule ℂ (CVMod ε ν ϱ (k + 2)) :=
  cycSub (cvUnivRep ε ν ϱ (k + 2)) (cvTopFirst ε ν ϱ k) ⊔
    cycSub (cvUnivRep ε ν ϱ (k + 2)) (cvTopSecond ε ν ϱ k)

theorem cvKernelSpan_inv (ε ν ϱ : Weight) (k : ℕ) (c : Fin 8) (r : ℕ) :
    cvKernelSpan ε ν ϱ k ≤
      (cvKernelSpan ε ν ϱ k).comap ((cvUnivRep ε ν ϱ (k + 2)).op c r) := by
  apply sup_le
  · exact (cycSub_inv _ _ c r).trans (Submodule.comap_mono le_sup_left)
  · exact (cycSub_inv _ _ c r).trans (Submodule.comap_mono le_sup_right)

theorem cvTopFirst_mem (ε ν ϱ : Weight) (k : ℕ) :
    cvTopFirst ε ν ϱ k ∈ cvKernelSpan ε ν ϱ k :=
  (le_sup_left : cycSub (cvUnivRep ε ν ϱ (k + 2)) (cvTopFirst ε ν ϱ k) ≤
    cvKernelSpan ε ν ϱ k) (wordOp_mem_cycSub _ _ [])

theorem cvTopSecond_mem (ε ν ϱ : Weight) (k : ℕ) :
    cvTopSecond ε ν ϱ k ∈ cvKernelSpan ε ν ϱ k :=
  (le_sup_right : cycSub (cvUnivRep ε ν ϱ (k + 2)) (cvTopSecond ε ν ϱ k) ≤
    cvKernelSpan ε ν ϱ k) (wordOp_mem_cycSub _ _ [])

/-- Both cyclic submodules lie in the kernel of the actual quotient map. -/
theorem cvKernelSpan_le_ker (ε ν ϱ : Weight) (k : ℕ) :
    cvKernelSpan ε ν ϱ k ≤ LinearMap.ker (cvQuotientMap ε ν ϱ k) := by
  have ht := ((quotient_rel_iff (ε := ε) (ν := ν) (ϱ := ϱ) (k := k)).mp
    (cvUniv_rel ε (ν + (1, 1)) ϱ k)).2
  apply sup_le
  · rw [cycSub, Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    change cvQuotientMap ε ν ϱ k
      (wordOp (cvUnivRep ε ν ϱ (k + 2)) l (cvTopFirst ε ν ϱ k)) = 0
    have hw : wordOp (cvUnivRep ε ν ϱ (k + 2)) l (cvTopFirst ε ν ϱ k) =
        wordOp (cvUnivRep ε ν ϱ (k + 2))
          (l ++ [(3, ε.1 + ν.1 + ϱ.1 + k + 1)]) (cv_wU ε ν ϱ (k + 2)) := by
      rw [wordOp_append]
      rfl
    rw [hw, cvQuotientMap_wordOp, wordOp_append]
    change wordOp (cvUnivRep ε (ν + (1, 1)) ϱ k) l
      ((cvUnivRep ε (ν + (1, 1)) ϱ k).op 3 (ε.1 + ν.1 + ϱ.1 + k + 1)
        (cv_wU ε (ν + (1, 1)) ϱ k)) = 0
    rw [ht.1, wordOp_zero]
  · rw [cycSub, Submodule.span_le]
    rintro _ ⟨l, rfl⟩
    change cvQuotientMap ε ν ϱ k
      (wordOp (cvUnivRep ε ν ϱ (k + 2)) l (cvTopSecond ε ν ϱ k)) = 0
    have hw : wordOp (cvUnivRep ε ν ϱ (k + 2)) l (cvTopSecond ε ν ϱ k) =
        wordOp (cvUnivRep ε ν ϱ (k + 2))
          (l ++ [(4, ε.2 + ν.2 + ϱ.2 + k + 1)]) (cv_wU ε ν ϱ (k + 2)) := by
      rw [wordOp_append]
      rfl
    rw [hw, cvQuotientMap_wordOp, wordOp_append]
    change wordOp (cvUnivRep ε (ν + (1, 1)) ϱ k) l
      ((cvUnivRep ε (ν + (1, 1)) ϱ k).op 4 (ε.2 + ν.2 + ϱ.2 + k + 1)
        (cv_wU ε (ν + (1, 1)) ϱ k)) = 0
    rw [ht.2, wordOp_zero]

/-- The current module on the quotient by the two explicit cyclic submodules. -/
def cvKernelQuotientRep (ε ν ϱ : Weight) (k : ℕ) :
    CurrentModule bracketTable (CVMod ε ν ϱ (k + 2) ⧸ cvKernelSpan ε ν ϱ k) :=
  quotRep (cvUnivRep ε ν ϱ (k + 2)) (cvKernelSpan ε ν ϱ k) (cvKernelSpan_inv ε ν ϱ k)

/-- The quotient generator satisfies the actual smaller CV presentation. -/
theorem cvKernelQuotient_rel (ε ν ϱ : Weight) (k : ℕ) :
    CV3Rel (cvKernelQuotientRep ε ν ϱ k)
      ((cvKernelSpan ε ν ϱ k).mkQ (cv_wU ε ν ϱ (k + 2)))
      ε (ν + (1, 1)) ϱ k := by
  have hs := sat_cvSpec_iff.mpr (cvUniv_rel ε ν ϱ (k + 2))
  have hq : UnivG.Sat bracketTable (cvKernelQuotientRep ε ν ϱ k)
      ((cvKernelSpan ε ν ϱ k).mkQ (cv_wU ε ν ϱ (k + 2))) (cvSpec ε ν ϱ (k + 2)) := by
    refine ⟨?_, ?_⟩
    · intro t ht
      dsimp only [cvKernelQuotientRep]
      rw [quot_wordOp, hs.tail t ht, map_zero]
    · intro p hp
      dsimp only [cvKernelQuotientRep]
      rw [quotRep_op, hs.eig p hp, map_smul]
  apply quotient_rel (sat_cvSpec_iff.mp hq)
  · dsimp only [cvKernelQuotientRep]
    rw [quotRep_op]
    exact (Submodule.Quotient.mk_eq_zero _).mpr (cvTopFirst_mem ε ν ϱ k)
  · dsimp only [cvKernelQuotientRep]
    rw [quotRep_op]
    exact (Submodule.Quotient.mk_eq_zero _).mpr (cvTopSecond_mem ε ν ϱ k)

/-- The universal map from the smaller presentation back to the explicit quotient. -/
def cvQuotientInverse (ε ν ϱ : Weight) (k : ℕ) :
    CVMod ε (ν + (1, 1)) ϱ k →ₗ[ℂ]
      (CVMod ε ν ϱ (k + 2) ⧸ cvKernelSpan ε ν ϱ k) :=
  cvMap (cvKernelQuotient_rel ε ν ϱ k)

/-- On the larger module, the constructed inverse composed with the actual
quotient map is the canonical quotient by the explicit kernel span. -/
theorem cvQuotientInverse_comp (ε ν ϱ : Weight) (k : ℕ) :
    (cvQuotientInverse ε ν ϱ k).comp (cvQuotientMap ε ν ϱ k) =
      (cvKernelSpan ε ν ϱ k).mkQ := by
  apply LinearMap.ext_on_range (cv_span_top ε ν ϱ (k + 2))
  intro l
  rw [LinearMap.comp_apply, cvQuotientMap_wordOp]
  change cvMap (cvKernelQuotient_rel ε ν ϱ k)
    (wordOp (cvUnivRep ε (ν + (1, 1)) ϱ k) l (cv_wU ε (ν + (1, 1)) ϱ k)) = _
  rw [cvMap_wordOp]
  dsimp only [cvKernelQuotientRep]
  rw [quot_wordOp]

/-- The kernel is exactly the sum of the two actual cyclic submodules.
No exactness, dimension, or recurrence hypothesis is used. -/
theorem cvQuotientMap_ker (ε ν ϱ : Weight) (k : ℕ) :
    LinearMap.ker (cvQuotientMap ε ν ϱ k) = cvKernelSpan ε ν ϱ k := by
  apply le_antisymm _ (cvKernelSpan_le_ker ε ν ϱ k)
  intro x hx
  have he := congrArg (fun f => f x) (cvQuotientInverse_comp ε ν ϱ k)
  change cvQuotientInverse ε ν ϱ k (cvQuotientMap ε ν ϱ k x) =
    (cvKernelSpan ε ν ϱ k).mkQ x at he
  rw [LinearMap.mem_ker.mp hx, map_zero] at he
  exact (Submodule.Quotient.mk_eq_zero _).mp he.symm

end

end VOA.DeligneAudit.A2.CVUniv

