import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.LinearAlgebra.LinearIndependent.Defs
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.Analysis.Complex.Basic

/-!
# The explicit A₂ relation ideal `I₂ⁿˢ`

For `g = sl₃` at the Deligne level `k = -3/2`, Perše's weight-two singular vectors of
`V^{-3/2}(sl₃)` span an adjoint copy `V(θ)` inside `V^k_2`, and their `C₂` symbols span the
adjoint summand `V(θ) ⊂ Sym² sl₃` (the Casimir is *not* among them).  This file records the
eight symbols as explicit quadratic polynomials, and the ideal they generate.

## Coordinates

The variable `X a` stands for the current of `VOA.AffineSl3.generator a`, i.e. the order is

`X 0 = e₁ = E₁₂`, `X 1 = e₂ = E₂₃`, `X 2 = e₁₂ = E₁₃`, `X 3 = f₁ = E₂₁`, `X 4 = f₂ = E₃₂`,
`X 5 = f₁₂ = E₃₁`, `X 6 = h₁`, `X 7 = h₂`.

## Origin of the polynomials

Let `Z` be the `3 × 3` matrix with polynomial entries

```
Z = [[2h₁ + h₂, 3f₁,      3f₁₂     ],
     [3e₁,      h₂ - h₁,  3f₂      ],
     [3e₁₂,     3e₂,      -h₁ - 2h₂]],
```

i.e. `Z = 3 Σ_a X_a · g^a`, where `g^a` is the trace-dual basis of `generator`.  The map
`X ↦ Z` is `sl₃`-equivariant, so the traceless part of `Z²` spans an adjoint copy in
`Sym² sl₃`.  `relationPoly a` is one third of the entry of `Z²` sitting at the matrix position of
`generator a` (for `a = 0,…,5`), and one third of the diagonal differences `(Z²)₀₀ - (Z²)₁₁`,
`(Z²)₁₁ - (Z²)₂₂` for `a = 6, 7`.  Hence `relationPoly a` has the `sl₃`-weight of `generator a`.
The highest-weight member is

`relationPoly 2 = (h₁ - h₂) e₁₂ + 3 e₁ e₂`.

(The span was checked to be `ad`-stable and eight-dimensional by an exact rational computation
outside Lean.)

## Map from the certificate basis

The external `A₂` singular-vector certificate (`singular_cert/cert_A2.json`) uses the basis
`(H₁, H₂, E₂, E₁, E_θ, F₂, F₁, F_θ)` (indices `0,…,7`).  It matches `generator` by

`H₁ = h₁`, `H₂ = h₂`, `E₂ = e₂`, `E₁ = e₁`, `E_θ = -e₁₂`, `F₂ = f₂`, `F₁ = f₁`, `F_θ = f₁₂`

(checked against every bracket and every form entry of the certificate).  The certificate's
singular vector

`v = -2 H₁(-1)E_θ(-1)𝟙 + 2 H₂(-1)E_θ(-1)𝟙 + 6 E₂(-1)E₁(-1)𝟙 - 3 E_θ(-2)𝟙`

reads `v = 2 h₁(-1)e₁₂(-1)𝟙 - 2 h₂(-1)e₁₂(-1)𝟙 + 6 e₂(-1)e₁(-1)𝟙 + 3 e₁₂(-2)𝟙` in `generator`
coordinates, and its `C₂` symbol is `2 · relationPoly 2`.
-/

namespace VOA.DeligneAudit.A2

open MvPolynomial

noncomputable section

/-- The quadratic monomial `X a * X b`. -/
abbrev q (a b : Fin 8) : MvPolynomial (Fin 8) ℂ := X a * X b

/-- **The eight `C₂` symbols of the weight-two singular vectors**, in the coordinates of
`VOA.AffineSl3.generator` (`e₁, e₂, e₁₂, f₁, f₂, f₁₂, h₁, h₂`).  `relationPoly a` has the weight of
`generator a`; together they span the adjoint summand `V(θ) ⊂ Sym² sl₃`. -/
def relationPoly : Fin 8 → MvPolynomial (Fin 8) ℂ :=
  ![ -- weight α₁:  e₁ (h₁ + 2h₂) + 3 e₁₂ f₂
     q 0 6 + 2 * q 0 7 + 3 * q 2 4,
     -- weight α₂:  -e₂ (2h₁ + h₂) + 3 e₁₂ f₁
     -(2 * q 1 6) - q 1 7 + 3 * q 2 3,
     -- weight θ (highest):  e₁₂ (h₁ - h₂) + 3 e₁ e₂
     q 2 6 - q 2 7 + 3 * q 0 1,
     -- weight -α₁:  f₁ (h₁ + 2h₂) + 3 e₂ f₁₂
     q 3 6 + 2 * q 3 7 + 3 * q 1 5,
     -- weight -α₂:  -f₂ (2h₁ + h₂) + 3 e₁ f₁₂
     -(2 * q 4 6) - q 4 7 + 3 * q 0 5,
     -- weight -θ:  f₁₂ (h₁ - h₂) + 3 f₁ f₂
     q 5 6 - q 5 7 + 3 * q 3 4,
     -- weight 0:  h₁² + 2 h₁h₂ + 3 e₁₂ f₁₂ - 3 e₂ f₂
     q 6 6 + 2 * q 6 7 + 3 * q 2 5 - 3 * q 1 4,
     -- weight 0:  -h₂² - 2 h₁h₂ - 3 e₁₂ f₁₂ + 3 e₁ f₁
     -q 7 7 - 2 * q 6 7 - 3 * q 2 5 + 3 * q 0 3 ]

/-- **The explicit relation ideal `I₂ⁿˢ`** for A₂: generated by the adjoint copy
`V(θ) ⊂ Sym² sl₃` of `C₂` symbols of the weight-two singular vectors. -/
def I2ns : Ideal (MvPolynomial (Fin 8) ℂ) := Ideal.span (Set.range relationPoly)

theorem relationPoly_mem_I2ns (a : Fin 8) : relationPoly a ∈ I2ns :=
  Ideal.subset_span ⟨a, rfl⟩

/-- The highest-weight relation, in closed form. -/
theorem relationPoly_two :
    relationPoly 2 = X 2 * X 6 - X 2 * X 7 + 3 * (X 0 * X 1) := rfl

theorem q_mem (a b : Fin 8) : q a b ∈ homogeneousSubmodule (Fin 8) ℂ 2 := by
  rw [mem_homogeneousSubmodule]
  exact (isHomogeneous_X ℂ a).mul (isHomogeneous_X ℂ b)

theorem C_mul_mem (c : ℂ) {p : MvPolynomial (Fin 8) ℂ}
    (hp : p ∈ homogeneousSubmodule (Fin 8) ℂ 2) :
    C c * p ∈ homogeneousSubmodule (Fin 8) ℂ 2 := by
  rw [← MvPolynomial.smul_eq_C_mul]
  exact Submodule.smul_mem _ _ hp

theorem ofNat_mul_mem (n : ℕ) [n.AtLeastTwo] {p : MvPolynomial (Fin 8) ℂ}
    (hp : p ∈ homogeneousSubmodule (Fin 8) ℂ 2) :
    (OfNat.ofNat n : MvPolynomial (Fin 8) ℂ) * p ∈ homogeneousSubmodule (Fin 8) ℂ 2 := by
  have : (OfNat.ofNat n : MvPolynomial (Fin 8) ℂ) = C (OfNat.ofNat n : ℂ) := by
    rw [map_ofNat]
  rw [this]
  exact C_mul_mem _ hp

/-- **Each relation is homogeneous of degree two.** -/
theorem relationPoly_isHomogeneous (a : Fin 8) : (relationPoly a).IsHomogeneous 2 := by
  rw [← mem_homogeneousSubmodule]
  fin_cases a <;>
    · dsimp only [relationPoly]
      repeat' first
        | exact q_mem _ _
        | apply ofNat_mul_mem
        | apply Submodule.add_mem
        | apply Submodule.sub_mem
        | apply Submodule.neg_mem

/-- The relation ideal is generated by homogeneous quadrics. -/
theorem I2ns_span_homogeneous :
    ∀ p ∈ Set.range relationPoly, p.IsHomogeneous 2 := by
  rintro _ ⟨a, rfl⟩
  exact relationPoly_isHomogeneous a


/-- The second-derivative functional `p ↦ ∂_a ∂_b p (0)`. -/
def d2 (a b : Fin 8) : MvPolynomial (Fin 8) ℂ →ₗ[ℂ] ℂ :=
  (MvPolynomial.aeval (fun _ => (0 : ℂ))).toLinearMap ∘ₗ
    ((pderiv a).toLinearMap ∘ₗ (pderiv b).toLinearMap)

theorem d2_q (a b i j : Fin 8) :
    d2 a b (q i j) = (Pi.single (M := fun _ => ℂ) b 1 i) * (Pi.single (M := fun _ => ℂ) a 1 j)
      + (Pi.single (M := fun _ => ℂ) b 1 j) * (Pi.single (M := fun _ => ℂ) a 1 i) := by
  have hb : ∀ c d : Fin 8, (Pi.single (M := fun _ => MvPolynomial (Fin 8) ℂ) c 1 d) =
      C (Pi.single (M := fun _ => ℂ) c 1 d) := by
    intro c d
    by_cases h : c = d
    · subst h; simp
    · simp [Ne.symm h]
  simp only [d2, q, LinearMap.coe_comp, Function.comp_apply, Derivation.coeFn_coe,
    Derivation.leibniz, pderiv_X, hb, smul_eq_mul, map_add, pderiv_C, mul_zero, zero_add,
    AlgHom.toLinearMap_apply, map_mul, aeval_C, Algebra.algebraMap_self, RingHom.id_apply]
  ring

theorem d2_ofNat_mul (a b : Fin 8) (n : ℕ) [n.AtLeastTwo] (p : MvPolynomial (Fin 8) ℂ) :
    d2 a b ((OfNat.ofNat n : MvPolynomial (Fin 8) ℂ) * p) = (OfNat.ofNat n : ℂ) * d2 a b p := by
  have : (OfNat.ofNat n : MvPolynomial (Fin 8) ℂ) * p = (OfNat.ofNat n : ℂ) • p := by
    rw [MvPolynomial.smul_eq_C_mul, map_ofNat]
  rw [this, map_smul, smul_eq_mul]

theorem d2_two_mul (a b : Fin 8) (p : MvPolynomial (Fin 8) ℂ) :
    d2 a b (2 * p) = 2 * d2 a b p := d2_ofNat_mul a b 2 p

theorem d2_three_mul (a b : Fin 8) (p : MvPolynomial (Fin 8) ℂ) :
    d2 a b (3 * p) = 3 * d2 a b p := d2_ofNat_mul a b 3 p

/-- Test monomials `X (pa j) * X (pb j)`, one per relation. -/
def pa : Fin 8 → Fin 8 := ![2, 2, 0, 1, 0, 3, 6, 7]
/-- Second index of the test monomial. -/
def pb : Fin 8 → Fin 8 := ![4, 3, 1, 5, 5, 4, 6, 7]
/-- The diagonal values `d2 (pa j) (pb j) (relationPoly j)`. -/
def dg : Fin 8 → ℂ := ![3, 3, 3, 3, 3, 3, 2, -2]

theorem d2_relationPoly (i j : Fin 8) :
    d2 (pa j) (pb j) (relationPoly i) = if i = j then dg j else 0 := by
  fin_cases i <;> fin_cases j <;>
    simp [relationPoly, pa, pb, dg, map_add, map_sub, map_neg, d2_q, d2_two_mul,
      d2_three_mul] <;> norm_num

/-- **The eight relations are linearly independent**: the second-derivative functionals at the
test monomials `X (pa j) X (pb j)` are diagonal on them, with nonzero diagonal `dg`. -/
theorem relationPoly_linearIndependent : LinearIndependent ℂ relationPoly := by
  rw [Fintype.linearIndependent_iff]
  intro g hg j
  have h := congrArg (d2 (pa j) (pb j)) hg
  simp only [map_sum, map_smul, d2_relationPoly, smul_eq_mul, mul_ite, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true, map_zero] at h
  have hd : dg j ≠ 0 := by fin_cases j <;> norm_num [dg]
  exact (mul_eq_zero.mp h).resolve_right hd

end

end VOA.DeligneAudit.A2

section AxiomAudit
#print axioms VOA.DeligneAudit.A2.relationPoly_isHomogeneous
#print axioms VOA.DeligneAudit.A2.I2ns
#print axioms VOA.DeligneAudit.A2.relationPoly_linearIndependent
end AxiomAudit
