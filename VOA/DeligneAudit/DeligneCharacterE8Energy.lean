set_option maxHeartbeats 4000000 in
theorem e8_letters (i : ℕ) (hi : i < 8) :
    ∀ φ ∈ e8CorootOrbit, reflFunFin 8 cartanE8 i φ ∈ e8CorootOrbit := by
  interval_cases i <;> decide +kernel

set_option maxHeartbeats 4000000 in
theorem e8_theta : ∀ φ ∈ e8CorootOrbit, reflFunTheta 8 cartanE8 thetaE8 φ ∈ e8CorootOrbit := by
  decide +kernel

set_option maxHeartbeats 4000000 in
theorem e8OrbitData : OrbitData 8 cartanE8 thetaE8 wordE8 e8CorootOrbit :=
  OrbitData.of_letters rfl (by decide) e8_letters e8_theta (by decide +kernel) (by decide +kernel)

/-- **`E₈` Demazure energies are nonnegative.** -/
theorem e8DemazureEnergy (m : ℕ) :
    ∀ t ∈ demazureChar cartanE8 thetaE8 wordE8 m, 0 ≤ t.1.2 + (m : ℤ) * m :=
  energy_of_orbit e8OrbitData m

end VOA.DeligneAudit.DeligneCharacter.DemCount

section AxiomAudit
#print axioms VOA.DeligneAudit.DeligneCharacter.DemCount.e8DemazureEnergy
end AxiomAudit
