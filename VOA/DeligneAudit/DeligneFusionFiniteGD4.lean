import VOA.DeligneAudit.DeligneFusionFiniteG
import VOA.DeligneAudit.DeligneSectorD4

/-!
# The finiteness clause for `D4`

Generated by `Notes/deligne/campaign/generators/gen_finite_cert.py d4`.

A 8-step nilpotency certificate (`d4Cert`, each step `(X, Y, path)` an `ad X`-string from a
known letter `Y` to its top) reaches every low letter of `D4sector` from the raising letters and
the simple lowering letters. Hence

`d4_finiteTable : FiniteTableG D4sector` and
`d4_fusionTotalBoundG_of_dim : FusionTotalDimG D4sector → FusionTotalBoundG D4sector`.
-/

set_option maxRecDepth 100000

namespace VOA.DeligneAudit.FiniteG.D4

open VOA.DeligneAudit.DeligneSector VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneSector.D4 VOA.DeligneAudit.DeligneSector.Sparse

/-- Raising letters and simple lowering letters. -/
def d4Kn (c : Fin 28) : Bool := decide (4 ≤ c.val ∧ c.val < 16) || decide (16 ≤ c.val ∧ c.val < 20)

/-- The integer structure constants. -/
def d4Fz (a b c : Fin 28) : ℤ := fZ br a.val b.val c.val

/-- The certificate. -/
def d4Cert : List (Step 28) := [(16, 18, [20]),
  (17, 18, [21]),
  (17, 20, [23]),
  (18, 19, [22]),
  (19, 20, [24]),
  (19, 21, [25]),
  (19, 23, [26]),
  (18, 26, [27])]

theorem d4_certValid :
    certValid D4sector.wt (fun a b c => d4Fz a b c != 0) d4Kn d4Cert = true := by
  decide +kernel

theorem d4_cov : ∀ c : Fin 28, (certKnown d4Kn d4Cert c && !wEqB (D4sector.wt c) 0) = true ∨
    D4sector.raising c ∨ D4sector.cartan c ∨ D4sector.cartanN c := by
  change ∀ c : Fin 28, (certKnown d4Kn d4Cert c &&
      !wEqB (wtD4 c) 0) = true ∨
    (4 ≤ c.val ∧ c.val < 16) ∨ (c.val < 4) ∨ (False)
  decide +kernel

theorem d4_kn : ∀ c : Fin 28, d4Kn c = true → D4sector.raising c ∨ D4sector.lowering c := by
  change ∀ c : Fin 28, d4Kn c = true →
    (4 ≤ c.val ∧ c.val < 16) ∨ (16 ≤ c.val ∧ c.val < 20)
  intro c h
  simpa [d4Kn] using h

/-- **The finiteness table facts for `D4`.** -/
theorem d4_finiteTable : FiniteTableG D4sector :=
  finiteTableG_of_cert (fnz_of_table (fz := d4Fz) (fun _ _ _ => rfl)) d4Kn d4Cert d4_kn
    d4_certValid d4_cov

/-- **`FusionTotalBoundG D4sector` reduces to the bare dimension bound.** -/
theorem d4_fusionTotalBoundG_of_dim (h : FusionTotalDimG D4sector) :
    FusionTotalBoundG D4sector :=
  fusionTotalBoundG_of_dim d4_finiteTable h

end VOA.DeligneAudit.FiniteG.D4

section AxiomAudit
#print axioms VOA.DeligneAudit.FiniteG.D4.d4_finiteTable
#print axioms VOA.DeligneAudit.FiniteG.D4.d4_fusionTotalBoundG_of_dim
end AxiomAudit
