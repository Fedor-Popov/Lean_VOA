import VOA.DeligneAudit.SL4TJointTopIdealSplitting
import VOA.DeligneAudit.SL4TMarkedFlagStrataJointAudit

/-!
# The one-minor stratum ideals in complement form

Let `x` be a coinvariant alphabet on `n` roots (`∏ (1 - x_i t) = 1`), `Y` a nonempty set of roots
with complement `Z`, `r = |Y|`, and `P_Y = ∏_{y ∈ Y} (t - x_y)`.

* The top row of the remainder of `t^m` modulo `P_Y` is the complete function `h_(m+1-r)(Y)`, and
  since `∏_Y (1 - x t)⁻¹ = ∏_Z (1 - x t)`, it is the coefficient of `t^(m+1-r)` in `∏_Z (1 - x t)`
  (`topRemainder_eq_complement`).
* Hence the top-row one-minor ideal of `(t^L)` is generated by the coefficients of
  `∏_Z (1 - x t)` from `t^(L+1-r)` on (`topIdeal_one_power_complement`); it is `(∏ Z)` when
  `L + 1 - r = |Z|` (`topIdeal_one_power_eq_prod`) and `(∏ Z, c(Z))` one step lower
  (`topIdeal_one_power_eq_pair`), `c(Z)` the subleading coefficient.
* With the splitting `G_1(t^(h+1), s t^h) = G_1(t^(h+1)) + (s) G_1(t^h)`: when `h + 2 - r = |Z|`
  (the singly marked flag with one double, `n = h + 2`), the joint one-minor ideal is
  `(∏ Z, s · c(Z))` (`jointTopIdeal_one_eq_pair`); when `h + 3 - r = |Z|` and `s = 0` (the doubly
  marked flag, `n = h + 3`), it is `(∏ Z, c(Z))` (`jointTopIdeal_one_eq_pair_of_zero`). These are
  the ideals bounded below in `SL4TMarkedFlagStrataJointAudit`.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open Polynomial

variable {C : Type*} [CommRing C] {n : ℕ} (x : Fin n → C)

theorem ksHSeries_toList_map (Y : Finset (Fin n)) :
    D4Levi.ksHSeries (Y.toList.map x) = groupCompleteSeries x Y := by
  rw [D4Levi.ksHSeries, List.map_map, groupCompleteSeries]
  exact Finset.prod_map_toList Y _

theorem ksEPoly_toList_map (Y : Finset (Fin n)) :
    D4Levi.ksEPoly (Y.toList.map x) = groupElementaryPolynomial x Y := by
  rw [D4Levi.ksEPoly, List.map_map, groupElementaryPolynomial]
  exact Finset.prod_map_toList Y _

theorem groupElementaryPolynomial_coeff_zero (S : Finset (Fin n)) :
    (groupElementaryPolynomial x S).coeff 0 = 1 := by
  simp [groupElementaryPolynomial, Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_prod]

/-- `(a) + (s)(a, b) = (a, s b)`. -/
theorem span_sup_mul_span_pair {A : Type*} [CommRing A] (a b s : A) :
    Ideal.span {a} ⊔ Ideal.span {s} * Ideal.span {a, b} = Ideal.span {a, s * b} := by
  apply le_antisymm
  · refine sup_le (Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))) ?_
    apply Ideal.mul_le.mpr
    intro y hy z hz
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨α, β, rfl⟩ := Ideal.mem_span_pair.mp hz
    apply Ideal.mem_span_pair.mpr
    exact ⟨t * s * α, t * β, by ring⟩
  · apply Ideal.span_le.mpr
    intro c hc
    rcases hc with rfl | hc
    · exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
    · rw [Set.mem_singleton_iff] at hc
      rw [hc]
      exact Ideal.mem_sup_right (Ideal.mul_mem_mul (Ideal.mem_span_singleton_self s)
        (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))

variable (hE : groupElementaryPolynomial x Finset.univ = 1)
include hE

/-- **The top row of a remainder in complement form.** -/
theorem topRemainder_eq_complement (Y : Finset (Fin n)) (hY : Y.Nonempty) (m : ℕ) :
    ((X : C[X]) ^ m %ₘ alphabetCharacteristic (Y.toList.map x)).coeff (Y.card - 1) =
      if Y.card ≤ m + 1 then (groupElementaryPolynomial x Yᶜ).coeff (m + 1 - Y.card) else 0 := by
  have hlen : (Y.toList.map x).length = Y.card := by simp
  have hr : 1 ≤ Y.card := Finset.card_pos.mpr hY
  have h := alphabetPowerRemainder_coeff (Y.toList.map x) m (Y.card - 1) (by rw [hlen]; omega)
  rw [hlen, show Y.card - (Y.card - 1) = 1 by omega] at h
  simp only [Finset.sum_range_one, Nat.add_zero, Nat.sub_zero] at h
  change alphabetPowerRemainder (Y.toList.map x) m (Y.card - 1) = _
  rw [h, ksEPoly_toList_map, groupElementaryPolynomial_coeff_zero, one_mul,
    ksHSeries_toList_map, groupCompleteSeries_eq_complement x Y hE, Polynomial.coeff_coe]
  by_cases hm : Y.card ≤ m + 1
  · rw [if_pos (by omega), if_pos hm, show m - (Y.card - 1) = m + 1 - Y.card by omega]
  · rw [if_neg (by omega), if_neg hm]

/-- **The one-minor ideal of `(t^L)` in complement form.** -/
theorem topIdeal_one_power_complement (Y : Finset (Fin n)) (hY : Y.Nonempty) (L : ℕ) :
    polynomialSubmoduleTopIdeal (alphabetCharacteristic (Y.toList.map x)) Y.card 1
        ((Ideal.span {(X : C[X]) ^ L}).restrictScalars C) =
      Ideal.span {a | ∃ k, L + 1 - Y.card ≤ k ∧ (groupElementaryPolynomial x Yᶜ).coeff k = a} := by
  have hr : 1 ≤ Y.card := Finset.card_pos.mpr hY
  apply le_antisymm
  · refine topIdeal_le_of_span _ _ _ _ {u | ∃ c, u = X ^ c * X ^ L} ?_ _ ?_
    · intro f hf
      rw [Submodule.restrictScalars_mem] at hf
      obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hf
      exact mul_mem_span_X_pow_mul _ g
    · intro u hu
      obtain ⟨c, hc⟩ := hu 0
      simp only [Matrix.det_fin_one, topRowFunctional_apply, Fin.val_zero, Nat.add_zero]
      rw [hc, ← pow_add, topRemainder_eq_complement x hE Y hY]
      split_ifs with hm
      · exact Ideal.subset_span ⟨c + L + 1 - Y.card, by omega, rfl⟩
      · exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro a ⟨k, hk, rfl⟩
    have hmem := topIdeal_det_mem (alphabetCharacteristic (Y.toList.map x)) Y.card 1
      ((Ideal.span {(X : C[X]) ^ L}).restrictScalars C) (fun _ => X ^ (k + Y.card - 1))
      (fun _ => by
        rw [Submodule.restrictScalars_mem,
          show (X : C[X]) ^ (k + Y.card - 1) = X ^ (k + Y.card - 1 - L) * X ^ L by
            rw [← pow_add, Nat.sub_add_cancel (by omega)]]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
    simp only [Matrix.det_fin_one, topRowFunctional_apply, Fin.val_zero, Nat.add_zero] at hmem
    rw [topRemainder_eq_complement x hE Y hY, if_pos (by omega),
      show k + Y.card - 1 + 1 - Y.card = k by omega] at hmem
    exact hmem

/-- At the top: `(∏ Z)`. -/
theorem topIdeal_one_power_eq_prod (Y : Finset (Fin n)) (hY : Y.Nonempty) (L : ℕ)
    (hL : L + 1 - Y.card = Yᶜ.card) :
    polynomialSubmoduleTopIdeal (alphabetCharacteristic (Y.toList.map x)) Y.card 1
        ((Ideal.span {(X : C[X]) ^ L}).restrictScalars C) = Ideal.span {∏ i ∈ Yᶜ, x i} := by
  rw [topIdeal_one_power_complement x hE Y hY L, hL]
  have hsq : ((-1 : C) ^ Yᶜ.card) * (-1) ^ Yᶜ.card = 1 := by
    rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro a ⟨k, hk, rfl⟩
    rcases Nat.eq_or_lt_of_le hk with hk | hk
    · rw [← hk, groupElementaryPolynomial_coeff_card]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · rw [groupElementaryPolynomial_coeff_eq_zero _ _ _ hk]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    rintro a rfl
    have h1 : ∏ i ∈ Yᶜ, x i = (-1) ^ Yᶜ.card * (groupElementaryPolynomial x Yᶜ).coeff Yᶜ.card := by
      rw [groupElementaryPolynomial_coeff_card, ← mul_assoc, hsq, one_mul]
    rw [SetLike.mem_coe, h1]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨Yᶜ.card, le_rfl, rfl⟩)

/-- One step below the top: `(∏ Z, c(Z))`. -/
theorem topIdeal_one_power_eq_pair (Y : Finset (Fin n)) (hY : Y.Nonempty) (hZ : Yᶜ.Nonempty)
    (L : ℕ) (hL : L + 2 - Y.card = Yᶜ.card) :
    polynomialSubmoduleTopIdeal (alphabetCharacteristic (Y.toList.map x)) Y.card 1
        ((Ideal.span {(X : C[X]) ^ L}).restrictScalars C) =
      Ideal.span {∏ i ∈ Yᶜ, x i, groupSubtopCoefficient x Yᶜ} := by
  have hZ1 : 1 ≤ Yᶜ.card := Finset.card_pos.mpr hZ
  have hr : 1 ≤ Y.card := Finset.card_pos.mpr hY
  rw [topIdeal_one_power_complement x hE Y hY L, show L + 1 - Y.card = Yᶜ.card - 1 by omega]
  have hsq : ((-1 : C) ^ Yᶜ.card) * (-1) ^ Yᶜ.card = 1 := by
    rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro a ⟨k, hk, rfl⟩
    rcases (show k = Yᶜ.card - 1 ∨ k = Yᶜ.card ∨ Yᶜ.card < k by omega) with hk | hk | hk
    · rw [hk]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    · rw [hk, groupElementaryPolynomial_coeff_card]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
    · rw [groupElementaryPolynomial_coeff_eq_zero _ _ _ hk]
      exact Ideal.zero_mem _
  · apply Ideal.span_le.mpr
    intro a ha
    rcases ha with rfl | ha
    · have h1 : ∏ i ∈ Yᶜ, x i =
          (-1) ^ Yᶜ.card * (groupElementaryPolynomial x Yᶜ).coeff Yᶜ.card := by
        rw [groupElementaryPolynomial_coeff_card, ← mul_assoc, hsq, one_mul]
      rw [SetLike.mem_coe, h1]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨Yᶜ.card, by omega, rfl⟩)
    · rw [Set.mem_singleton_iff] at ha
      rw [ha]
      exact Ideal.subset_span ⟨Yᶜ.card - 1, le_rfl, rfl⟩

/-- **The joint one-minor ideal of the singly marked flag with one double** (`n = h + 2`):
`(∏ Z, s · c(Z))`. -/
theorem jointTopIdeal_one_eq_pair (Y : Finset (Fin n)) (hY : Y.Nonempty) (hZ : Yᶜ.Nonempty)
    (h : ℕ) (hh : h + 2 - Y.card = Yᶜ.card) (s : C) :
    polynomialSubmoduleTopIdeal (alphabetCharacteristic (Y.toList.map x)) Y.card 1
        ((Ideal.span {(X : C[X]) ^ (h + 1), Polynomial.C s * X ^ h}).restrictScalars C) =
      Ideal.span {∏ i ∈ Yᶜ, x i, s * groupSubtopCoefficient x Yᶜ} := by
  rw [jointTopIdeal_eq_sup, topIdeal_one_power_eq_prod x hE Y hY (h + 1) (by omega),
    topIdeal_one_power_eq_pair x hE Y hY hZ h hh, span_sup_mul_span_pair]

/-- **The joint one-minor ideal of the doubly marked flag** (`s = 0`, `n = h + 3`):
`(∏ Z, c(Z))`. -/
theorem jointTopIdeal_one_eq_pair_of_zero (Y : Finset (Fin n)) (hY : Y.Nonempty)
    (hZ : Yᶜ.Nonempty) (h : ℕ) (hh : h + 3 - Y.card = Yᶜ.card) :
    polynomialSubmoduleTopIdeal (alphabetCharacteristic (Y.toList.map x)) Y.card 1
        ((Ideal.span {(X : C[X]) ^ (h + 1), Polynomial.C 0 * X ^ h}).restrictScalars C) =
      Ideal.span {∏ i ∈ Yᶜ, x i, groupSubtopCoefficient x Yᶜ} := by
  rw [jointTopIdeal_eq_sup, Ideal.span_singleton_eq_bot.mpr rfl, Ideal.bot_mul, sup_bot_eq,
    topIdeal_one_power_eq_pair x hE Y hY hZ (h + 1) (by omega)]

end

