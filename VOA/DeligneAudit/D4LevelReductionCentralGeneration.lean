import VOA.DeligneAudit.D4LevelReductionAdjointAssembly
import VOA.DeligneAudit.D4LeviKSLemma0YZ

/-! Generation of the zero-adjoint boundary by central radical words modulo the next level. -/

namespace VOA.DeligneAudit.D4LevelReduction

open VOA.DeligneAudit.D4Levi
open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4

/-- A pure highest-root radical key with fixed length and current degree. -/
def centralLetterKey (c d : ℕ) : RadicalKey := ⟨0, 0, 0, 0, 0, c, d⟩

/-- At zero adjoint count, every radical word uses only the last two radical colours. -/
theorem boundaryKey_word_colours (m : ℕ) (l : List (Fin 6 × ℕ))
    (hp : keyLeviLevel m (wordKey l) = keyAlphaGrade m (wordKey l)) :
    l.Forall (fun q => q.1 = 4 ∨ q.1 = 5) := by
  have hcounts : (wordKey l).e = 0 ∧ (wordKey l).x = 0 ∧
      (wordKey l).u = 0 ∧ (wordKey l).up = 0 := by
    simp only [keyLeviLevel, keyAlphaGrade, keyDepth, Nat.cast_add] at hp
    omega
  rw [List.forall_iff_forall_mem]
  intro q hq
  have hzero (j : Fin 6) (hj : l.countP (fun p => p.1 = j) = 0) : q.1 ≠ j := by
    intro heq
    have hpos : 0 < l.countP (fun p => p.1 = j) :=
      List.countP_pos_iff.mpr ⟨q, hq, by simpa using heq⟩
    omega
  have he := hzero 0 hcounts.1
  have hx := hzero 1 hcounts.2.1
  have hu := hzero 2 hcounts.2.2.1
  have hup := hzero 3 hcounts.2.2.2
  rcases q with ⟨j, s⟩
  fin_cases j <;> simp_all

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule D4sector.f V) (w : V)

/-- A Y letter with Y and Z spectators is a Levi derivative from the next level. -/
theorem boundaryYWord_mem_next (m : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) (κ : ℤ) (r : ℕ)
    (l : List (Fin 6 × ℕ)) (hl : l.Forall (fun q => q.1 = 4 ∨ q.1 = 5))
    (hg : keyAlphaGrade m (wordKey ((4, r) :: l)) = κ)
    (hp : keyLeviLevel m (wordKey ((4, r) :: l)) = κ) :
    radicalWord ρ w ((4, r) :: l) ∈ levelFiltration ρ w m κ (κ + 1) := by
  have hsource : radicalWord ρ w ((2, r) :: l) ∈
      levelFiltration ρ w m κ (κ + 1) := by
    apply keyOrbit_le_levelFiltration_of_sat ρ w m h _ _ _ _ _
      (keyLayer_le_orbit ρ w _ (radicalWord_mem_key ρ w _))
    · simp [keyAlphaGrade, keyDepth, wordKey] at hg ⊢
      omega
    · simp [keyLeviLevel, wordKey] at hp ⊢
      omega
  have hd := levelFiltration_stable ρ w m κ (κ + 1) 17 0 ⟨7, rfl⟩ hsource
  change ρ.op (17 : Fin 28) 0 (radicalWord ρ w ((2, r) :: l)) ∈
    levelFiltration ρ w m κ (κ + 1) at hd
  rw [fThree_radicalWord ρ w m h] at hd
  have htail := fThreeDerivative_yz_zero ρ 0 l w hl
  have hneg : -radicalWord ρ w ((4, r) :: l) ∈
      levelFiltration ρ w m κ (κ + 1) := by
    simpa [fThreeDerivative, fThreeLetter, htail, radicalWord, radicalColour, wordOp] using hd
  simpa using (levelFiltration ρ w m κ (κ + 1)).neg_mem hneg

/-- Every boundary key containing a Y letter is absorbed by the next level. -/
theorem boundaryKey_le_next_of_Y (m : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) (κ : ℤ) (k : RadicalKey)
    (hg : keyAlphaGrade m k = κ) (hp : keyLeviLevel m k = κ) (hy : 0 < k.y) :
    keyOrbit ρ w k ≤ levelFiltration ρ w m κ (κ + 1) := by
  apply keyOrbit_le_levelFiltration_of_layer
  rw [keyLayer, Submodule.span_le]
  rintro v ⟨l, hl, rfl⟩
  have hcount : 0 < l.countP (fun q => q.1 = 4) := by
    simpa only [← hl, wordKey] using hy
  obtain ⟨⟨j, r⟩, hmem, hj⟩ := List.countP_pos_iff.mp hcount
  have hj' : j = 4 := of_decide_eq_true hj
  subst j
  have hperm := List.perm_cons_erase hmem
  have hkey := (wordKey_perm hperm).symm.trans hl
  rw [radicalWord_perm ρ w hperm]
  apply boundaryYWord_mem_next ρ w m h κ r (l.erase (4, r))
  · have hc := boundaryKey_word_colours m ((4, r) :: l.erase (4, r)) (by rw [hkey, hg, hp])
    simp only [List.forall_cons] at hc
    exact hc.2
  · rwa [hkey]
  · rwa [hkey]

/-- The zero-adjoint boundary is generated by pure central words modulo its next level. -/
theorem centralBoundary_eq_orbits_sup_next (m c : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    levelFiltration ρ w m ((m : ℤ) - c) ((m : ℤ) - c) =
      (⨆ d : ℕ, keyOrbit ρ w (centralLetterKey c d)) ⊔
        levelFiltration ρ w m ((m : ℤ) - c) ((m : ℤ) - c + 1) := by
  apply le_antisymm
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    apply iSup_le
    intro hg
    apply iSup_le
    intro hp
    by_cases heq : keyLeviLevel m k = (m : ℤ) - c
    · by_cases hy : k.y = 0
      · have he : k.e = 0 := by
          simp only [keyAlphaGrade, keyLeviLevel, keyDepth, Nat.cast_add] at hg heq
          omega
        have hx : k.x = 0 := by
          simp only [keyAlphaGrade, keyLeviLevel, keyDepth, Nat.cast_add] at hg heq
          omega
        have hu : k.u = 0 := by
          simp only [keyAlphaGrade, keyLeviLevel, keyDepth, Nat.cast_add] at hg heq
          omega
        have hup : k.up = 0 := by
          simp only [keyAlphaGrade, keyLeviLevel, keyDepth, Nat.cast_add] at hg heq
          omega
        have hz : k.z = c := by
          simp only [keyAlphaGrade, keyDepth, he, hx, hu, hup, hy] at hg
          omega
        have hkey : k = centralLetterKey c k.degree := by
          cases k
          simp_all [centralLetterKey]
        apply le_sup_of_le_left
        exact le_iSup_of_le k.degree (by conv_lhs => rw [hkey])
      · exact (boundaryKey_le_next_of_Y ρ w m h _ k hg heq
          (Nat.pos_of_ne_zero hy)).trans le_sup_right
    · exact (keyOrbit_le_levelFiltration ρ w m _ _ k hk hg (by omega)).trans le_sup_right
  · apply sup_le
    · apply iSup_le
      intro d
      apply keyOrbit_le_levelFiltration_of_sat ρ w m h
      · simp [keyAlphaGrade, keyDepth, centralLetterKey]
      · simp [keyLeviLevel, centralLetterKey]
    · exact levelFiltration_antitone ρ w m _ (by omega)

end VOA.DeligneAudit.D4LevelReduction

