/-- Raising letters and simple lowering letters. -/
def e8Kn (c : Fin 248) : Bool := decide (8 ≤ c.val ∧ c.val < 128) || decide (c.val ∈ ([135, 134, 133, 132, 131, 130, 129, 128] : List ℕ))

/-- The integer structure constants. -/
def e8Fz (a b c : Fin 248) : ℤ := coef (entry e8T a.val b.val) c.val

