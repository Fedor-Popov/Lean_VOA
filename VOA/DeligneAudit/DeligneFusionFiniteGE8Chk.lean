    certValid VOA.DeligneAudit.E8Lie.wt (fun a b c => e8Fz a b c != 0) e8Kn e8Cert = true := by
  decide +kernel

theorem e8_covL : ∀ c : Fin 248, (certKnown e8Kn e8Cert c && !wEqB (VOA.DeligneAudit.E8Lie.wt c) 0) = true ∨
    (8 ≤ c.val ∧ c.val < 128) ∨ (c.val < 8) ∨ (False) := by
