import VOA.DeligneAudit.DeligneFusionFiniteG
import VOA.DeligneAudit.E6SectorData

/-!
# The finiteness clause for `E6`

Generated by `Notes/deligne/campaign/generators/gen_finite_cert.py e6`.

A 30-step nilpotency certificate (`e6Cert`, each step `(X, Y, path)` an `ad X`-string from a
known letter `Y` to its top) reaches every low letter of `E6sector` from the raising letters and
the simple lowering letters. Hence

`e6_finiteTable : FiniteTableG E6sector` and
`e6_fusionTotalBoundG_of_dim : FusionTotalDimG E6sector → FusionTotalBoundG E6sector`.
-/

set_option maxRecDepth 100000

namespace VOA.DeligneAudit.FiniteG.E6

open VOA.DeligneAudit.DeligneSector VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneCarrier.E6 VOA.AffineGeneral.SCLie

/-- Raising letters and simple lowering letters. -/
def e6Kn (c : Fin 78) : Bool := decide (6 ≤ c.val ∧ c.val < 42) || decide (c.val ∈ ([47, 46, 45, 44, 43, 42] : List ℕ))

/-- The integer structure constants. -/
def e6Fz (a b c : Fin 78) : ℤ := coef (entry e6T a.val b.val) c.val

/-- The certificate. -/
def e6Cert : List (Step 78) := [(42, 43, [48]),
  (43, 44, [49]),
  (44, 45, [50]),
  (44, 46, [51]),
  (44, 48, [53]),
  (45, 47, [52]),
  (45, 49, [54]),
  (45, 51, [56]),
  (45, 53, [58]),
  (46, 49, [55]),
  (46, 53, [59]),
  (46, 54, [60]),
  (46, 58, [63]),
  (47, 50, [57]),
  (47, 54, [61]),
  (47, 56, [62]),
  (47, 58, [65]),
  (47, 60, [66]),
  (47, 63, [68]),
  (44, 60, [64]),
  (44, 63, [67]),
  (44, 66, [69]),
  (44, 68, [71]),
  (45, 69, [72]),
  (45, 71, [74]),
  (48, 64, [70]),
  (48, 69, [73]),
  (48, 72, [75]),
  (49, 74, [76]),
  (51, 75, [77])]

theorem e6_certValid :
    certValid E6sector.wt (fun a b c => e6Fz a b c != 0) e6Kn e6Cert = true := by
  decide +kernel

theorem e6_cov : ∀ c : Fin 78, (certKnown e6Kn e6Cert c && !wEqB (E6sector.wt c) 0) = true ∨
    E6sector.raising c ∨ E6sector.cartan c ∨ E6sector.cartanN c := by
  change ∀ c : Fin 78, (certKnown e6Kn e6Cert c &&
      !wEqB (wtE6 c) 0) = true ∨
    (6 ≤ c.val ∧ c.val < 42) ∨ (c.val < 6) ∨ (False)
  decide +kernel

theorem e6_kn : ∀ c : Fin 78, e6Kn c = true → E6sector.raising c ∨ E6sector.lowering c := by
  change ∀ c : Fin 78, e6Kn c = true →
    (6 ≤ c.val ∧ c.val < 42) ∨ (c.val ∈ ([47, 46, 45, 44, 43, 42] : List ℕ))
  intro c h
  simpa [e6Kn] using h

/-- **The finiteness table facts for `E6`.** -/
theorem e6_finiteTable : FiniteTableG E6sector :=
  finiteTableG_of_cert (fnz_of_table (fz := e6Fz) (fun _ _ _ => rfl)) e6Kn e6Cert e6_kn
    e6_certValid e6_cov

/-- **`FusionTotalBoundG E6sector` reduces to the bare dimension bound.** -/
theorem e6_fusionTotalBoundG_of_dim (h : FusionTotalDimG E6sector) :
    FusionTotalBoundG E6sector :=
  fusionTotalBoundG_of_dim e6_finiteTable h

end VOA.DeligneAudit.FiniteG.E6

section AxiomAudit
#print axioms VOA.DeligneAudit.FiniteG.E6.e6_finiteTable
#print axioms VOA.DeligneAudit.FiniteG.E6.e6_fusionTotalBoundG_of_dim
end AxiomAudit
