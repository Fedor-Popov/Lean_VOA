def recipe (k : ℕ) : ℕ × ℕ × ℤ := (recRaw.getD (k / 25) []).getD (k % 25) (0, 0, 0)

/-- `[x_b, x_i]` as sparse `(index, coefficient)` pairs over `ℕ`. -/
def sLn (b : Fin 133) (i : ℕ) : List (ℕ × ℤ) :=
  if h : i < 133 then (sL b ⟨i, h⟩).map fun s => (s.1.val, s.2) else []

/-- The coadjoint derivation of `x_b` on a sparse quadric. -/
def adQ (b : Fin 133) (l : List (ℕ × ℕ × ℤ)) : List (ℕ × ℕ × ℤ) :=
  l.flatMap fun t => ((sLn b t.1).map fun s => (s.1, t.2.1, t.2.2 * s.2)) ++
    ((sLn b t.2.1).map fun s => (t.1, s.1, t.2.2 * s.2))

/-- The check of step `k`: `j < k`, `b < 133`, `p ≠ 0`, and `ad_b P_j - p P_k = 0`. -/
def stepOK (k : ℕ) : Bool :=
  let r := recipe k
  decide (r.1 < k) && decide (r.2.1 < 133) && decide (r.2.2 ≠ 0) &&
    quadZero (adQ ⟨r.2.1 % 133, Nat.mod_lt _ (by decide)⟩ (DeligneCarrier.E7.relQ r.1) ++
      scaleQ (-r.2.2) (DeligneCarrier.E7.relQ k))

