import VOA.DeligneAudit.SL4TColourStratumGrading

/-!
# Level certificates in the Young-invariant truncated flag ring

The characteristic polynomial of an alphabet is the descending Newton polynomial of its power
sums. For the selected colours of a colouring this identifies the characteristic polynomial of
the selected roots with the Newton polynomial of the selected colour power sums, an invariant
polynomial.

Coefficientwise Young-subgroup averaging of polynomials with polynomial coefficients is linear
over invariant coefficients. Hence membership in the ideal generated by an invariant monic
polynomial and a power of the variable descends from all coefficients to invariant
coefficients. Applying this to the graded top-row Cramer certificate gives, for every
homogeneous element of a stratum of the truncated invariant ring, a characteristic relation
of the stratum's level whose correction coefficients lie in the same stratum and in strictly
larger degrees.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial
open scoped Polynomial

/-! ## The characteristic polynomial as a Newton polynomial -/

/-- The characteristic polynomial of an alphabet is the descending Newton polynomial of its
power sums. -/
theorem alphabetCharacteristic_eq_newton {A : Type*} [CommRing A] [Algebra ℂ A]
    (xs : List A) :
    alphabetCharacteristic xs =
      descendingPoly (newtonCoeff (fun s => (xs.map (· ^ s)).sum)) xs.length := by
  classical
  let v : Fin xs.length → A := fun i => xs[i.1]
  let f : MvPolynomial (Fin xs.length) ℂ →ₐ[ℂ] A := aeval v
  have hps (s : ℕ) : (xs.map (· ^ s)).sum = f (psum (Fin xs.length) ℂ s) := by
    simp only [f, psum, map_sum, map_pow, aeval_X, v]
    exact (Fin.sum_univ_fun_getElem xs (· ^ s)).symm
  have hmul : (Finset.univ.val.map v : Multiset A) = (xs : Multiset A) := by
    rw [Fin.univ_val_map]
    congr 1
    exact List.ofFn_getElem
  have hcoeff (i : ℕ) : newtonCoeff (fun s => (xs.map (· ^ s)).sum) i =
      (-1) ^ i * (xs : Multiset A).esymm i := by
    rw [funext hps, newtonCoeff_psum_map, aeval_esymm_eq_multiset_esymm, hmul]
  rw [descendingPoly_eq_sum, alphabetCharacteristic_product]
  have hv := Multiset.prod_X_sub_X_eq_sum_esymm (xs : Multiset A)
  rw [Multiset.map_coe, Multiset.prod_coe, Multiset.coe_card] at hv
  rw [hv]
  apply Finset.sum_congr rfl
  intro i _
  rw [hcoeff]
  simp only [map_mul, map_pow, map_neg, map_one]
  ring

variable {C : Type*} {B : ℕ} (colour : Fin B → C)

/-- The local finite-type instance used for Young-subgroup averaging. -/
local instance colourCertificatePermutationFintype : Fintype (positionColourSubgroup colour) :=
  Fintype.ofFinite _

/-! ## Coefficientwise averaging of polynomials -/

/-- Average every coefficient of a polynomial over the colour-preserving permutations. -/
def colourAverageCoefficients (F : (MvPolynomial (Fin B) ℂ)[X]) :
    (ColourPolynomialRing colour)[X] :=
  ∑ l ∈ Finset.range (F.natDegree + 1),
    Polynomial.monomial l (colourPolynomialAverage colour (F.coeff l))

theorem colourAverageCoefficients_coeff (F : (MvPolynomial (Fin B) ℂ)[X]) (l : ℕ) :
    (colourAverageCoefficients colour F).coeff l = colourPolynomialAverage colour (F.coeff l) := by
  rw [colourAverageCoefficients, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_monomial]
  rw [Finset.sum_ite_eq']
  split_ifs with h
  · rfl
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by
      have := Finset.mem_range.not.mp h
      omega), map_zero]

theorem colourAverageCoefficients_add (F G : (MvPolynomial (Fin B) ℂ)[X]) :
    colourAverageCoefficients colour (F + G) =
      colourAverageCoefficients colour F + colourAverageCoefficients colour G := by
  ext l : 1
  simp only [Polynomial.coeff_add, colourAverageCoefficients_coeff, map_add]

theorem colourAverageCoefficients_sub (F G : (MvPolynomial (Fin B) ℂ)[X]) :
    colourAverageCoefficients colour (F - G) =
      colourAverageCoefficients colour F - colourAverageCoefficients colour G := by
  ext l : 1
  simp only [Polynomial.coeff_sub, colourAverageCoefficients_coeff, map_sub]

/-- Averaging is linear over invariant polynomial factors. -/
theorem colourAverageCoefficients_mul_map (F : (MvPolynomial (Fin B) ℂ)[X])
    (H : (ColourPolynomialRing colour)[X]) :
    colourAverageCoefficients colour (F * H.map (ColourPolynomialRing colour).val.toRingHom) =
      colourAverageCoefficients colour F * H := by
  ext l : 1
  rw [colourAverageCoefficients_coeff, Polynomial.coeff_mul, Polynomial.coeff_mul, map_sum]
  apply Finset.sum_congr rfl
  intro x _
  rw [Polynomial.coeff_map, colourAverageCoefficients_coeff]
  exact finiteActionAverageToFixed_mul _ (H.coeff x.2) (F.coeff x.1)

/-- Averaging fixes polynomials with invariant coefficients. -/
theorem colourAverageCoefficients_map (H : (ColourPolynomialRing colour)[X]) :
    colourAverageCoefficients colour (H.map (ColourPolynomialRing colour).val.toRingHom) = H := by
  ext l : 1
  rw [colourAverageCoefficients_coeff, Polynomial.coeff_map]
  exact colourPolynomialAverage_fixed colour (H.coeff l)

theorem colourAverageCoefficients_monomial (x : MvPolynomial (Fin B) ℂ) (L : ℕ) :
    colourAverageCoefficients colour (Polynomial.C x * Polynomial.X ^ L) =
      Polynomial.C (colourPolynomialAverage colour x) * Polynomial.X ^ L := by
  ext l : 1
  rw [colourAverageCoefficients_coeff, Polynomial.coeff_C_mul_X_pow,
    Polynomial.coeff_C_mul_X_pow]
  split_ifs <;> simp

/-- Membership in the ideal of an invariant polynomial and a power of the variable descends
to invariant coefficients. -/
theorem colourAverageCoefficients_mem_span (P : (ColourPolynomialRing colour)[X]) (N : ℕ)
    (F : (MvPolynomial (Fin B) ℂ)[X])
    (hF : F ∈ Ideal.span {P.map (ColourPolynomialRing colour).val.toRingHom,
      Polynomial.X ^ N}) :
    colourAverageCoefficients colour F ∈ Ideal.span {P, Polynomial.X ^ N} := by
  obtain ⟨u, w, huw⟩ := Ideal.mem_span_pair.mp hF
  have hX : (Polynomial.X ^ N : (MvPolynomial (Fin B) ℂ)[X]) =
      (Polynomial.X ^ N : (ColourPolynomialRing colour)[X]).map
        (ColourPolynomialRing colour).val.toRingHom := by
    rw [Polynomial.map_pow, Polynomial.map_X]
  rw [← huw, colourAverageCoefficients_add, colourAverageCoefficients_mul_map, hX,
    colourAverageCoefficients_mul_map]
  exact Ideal.mem_span_pair.mpr ⟨_, _, rfl⟩

/-! ## Stability and homogeneity of the polynomial strata -/

section Strata

variable [DecidableEq C]

/-- The top-row ideal of the selected colours is generated by invariant polynomials, so it is
stable under the colour-preserving permutations, for every cutoff. -/
theorem selectedRemainderTopIdeal_stable (selected : Finset C) (N j : ℕ)
    (g : positionColourSubgroup colour) :
    remainderTopIdeal (fullFlagSubalphabet (selectedColourPositions colour selected)) N j ≤
      (remainderTopIdeal (fullFlagSubalphabet (selectedColourPositions colour selected))
        N j).comap (rename (R := ℂ) g.val).toRingHom := by
  apply Ideal.span_le.mpr
  rintro x ⟨cols, rfl⟩
  rw [SetLike.mem_coe, Ideal.mem_comap]
  have hfix : rename (R := ℂ) g.val (remainderTopMinor
      (fullFlagSubalphabet (selectedColourPositions colour selected)) N j cols) =
        remainderTopMinor (fullFlagSubalphabet (selectedColourPositions colour selected))
          N j cols :=
    colourRemainderTopMinor_fixed colour selected N j cols g
  rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hfix]
  exact remainderTopMinor_mem _ N j cols

/-- The full stratum ideal is stable under the colour-preserving permutations, for every
cutoff. -/
theorem selectedStratumIdeal_stable (selected : Finset C) (N j : ℕ)
    (g : positionColourSubgroup colour) (x : MvPolynomial (Fin B) ℂ)
    (hx : x ∈ fullFlagTruncationIdeal B N ⊔
      remainderTopIdeal (fullFlagSubalphabet (selectedColourPositions colour selected)) N j) :
    rename g.val x ∈ fullFlagTruncationIdeal B N ⊔
      remainderTopIdeal (fullFlagSubalphabet (selectedColourPositions colour selected)) N j := by
  have hJ : fullFlagTruncationIdeal B N ≤
      (fullFlagTruncationIdeal B N).comap (rename g.val).toRingHom :=
    fullFlagTruncationIdeal_stable B N g.val
  have hle : fullFlagTruncationIdeal B N ⊔
      remainderTopIdeal (fullFlagSubalphabet (selectedColourPositions colour selected)) N j ≤
        (fullFlagTruncationIdeal B N ⊔ remainderTopIdeal
          (fullFlagSubalphabet (selectedColourPositions colour selected)) N j).comap
            (rename (R := ℂ) g.val).toRingHom :=
    sup_le (hJ.trans (Ideal.comap_mono le_sup_left))
      ((selectedRemainderTopIdeal_stable colour selected N j g).trans
        (Ideal.comap_mono le_sup_right))
  exact hle hx

/-- Homogeneous components stay in the top-row ideal of any position set. -/
theorem fullFlagSubalphabet_topIdeal_component_mem (Y : Finset (Fin B)) (N j : ℕ) (d : ℤ)
    (p : MvPolynomial (Fin B) ℂ) (hp : p ∈ remainderTopIdeal (fullFlagSubalphabet Y) N j) :
    weightedHomogeneousComponent (fun _ => (1 : ℤ)) d p ∈
      remainderTopIdeal (fullFlagSubalphabet Y) N j := by
  have hxs : ∀ x ∈ fullFlagSubalphabet Y, x.IsWeightedHomogeneous (fun _ => (1 : ℤ)) 1 := by
    intro x hx
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
    exact isWeightedHomogeneous_X ℂ _ i
  exact homogeneous_span_component_mem (fun _ => (1 : ℤ))
    (remainderTopMinor (fullFlagSubalphabet Y) N j)
    (fun cols => remainderMinorDegree N j
      (fun a => (fullFlagSubalphabet Y).length - j + a.val) cols)
    (fun cols => remainderRowMinor_homogeneous _ _ hxs N j _ cols) p hp d

/-- The selected characteristic polynomial is the Newton polynomial of the selected colour
power sums. -/
theorem selectedColourCharacteristic_map (selected : Finset C) :
    (descendingPoly (newtonCoeff (selectedColourPowerSum colour selected))
        (selectedColourPositions colour selected).card).map
      (ColourPolynomialRing colour).val.toRingHom =
        alphabetCharacteristic (fullFlagSubalphabet (selectedColourPositions colour selected)) := by
  rw [alphabetCharacteristic_eq_newton, descendingPoly_map]
  have hlen : (fullFlagSubalphabet (selectedColourPositions colour selected)).length =
      (selectedColourPositions colour selected).card := by
    simp [fullFlagSubalphabet]
  rw [hlen]
  congr 1
  funext i
  rw [show (ColourPolynomialRing colour).val.toRingHom
      (newtonCoeff (selectedColourPowerSum colour selected) i) =
      (ColourPolynomialRing colour).val (newtonCoeff (selectedColourPowerSum colour selected) i)
      from rfl, ← newtonCoeff_map]
  congr 1
  funext s
  rw [Subalgebra.val_apply, selectedColourPowerSum_val]
  simp [fullFlagSubalphabet, List.map_map, Function.comp_def]

/-- Every homogeneous element of a stratum has a characteristic relation of the stratum's
level, with corrections in the same stratum and in strictly larger degrees. -/
theorem colourTruncatedStratum_certificate (selected : Finset C) (N j : ℕ)
    (hj : j ≤ (selectedColourPositions colour selected).card) (d : ℕ)
    (a : ColourTruncatedFlagRing colour N)
    (ha : a ∈ colourTruncatedStratum colour selected N j)
    (hd : a ∈ colourTruncatedDegree colour N d) :
    ∃ c : (ColourTruncatedFlagRing colour N)[X],
      (∀ l, c.coeff l ∈ colourTruncatedStratum colour selected N j) ∧
      (∀ l, c.coeff l ≠ 0 → ∃ e : ℤ, (d : ℤ) < e ∧
        c.coeff l ∈ colourTruncatedDegree colour N e) ∧
      Polynomial.C a * Polynomial.X ^ ((selectedColourPositions colour selected).card - j) +
          c ∈
        Ideal.span {descendingPoly (newtonCoeff (colourTruncatedPowerSum colour selected N))
          (selectedColourPositions colour selected).card} ⊔
          Ideal.span {Polynomial.X ^ N} := by
  classical
  let Y := selectedColourPositions colour selected
  let xs := fullFlagSubalphabet Y
  let K := colourTruncationIdeal colour N
  let w : Fin B → ℤ := fun _ => 1
  let π := Ideal.Quotient.mkₐ ℂ K
  have hlen : xs.length = Y.card := by simp [xs, fullFlagSubalphabet]
  obtain ⟨f, hfhom, rfl⟩ := hd
  change π f ∈ colourTruncatedStratum colour selected N j at ha
  have hfZ := (colourTruncatedStratum_mem_iff colour selected N j f).mp ha
  have hfI : f.val ∈ fullFlagTruncationIdeal B N ⊔ remainderTopIdeal xs N j := hfZ
  obtain ⟨g, hg, h, hh, hgh⟩ := Submodule.mem_sup.mp hfI
  have hfd : weightedHomogeneousComponent w d f.val = f.val :=
    (show f.val.IsWeightedHomogeneous w d from hfhom).weightedHomogeneousComponent_same
  have hgd := fullFlagTruncationIdeal_component_mem B N d g hg
  have hhd := fullFlagSubalphabet_topIdeal_component_mem Y N j d h hh
  have hsplit : f.val =
      weightedHomogeneousComponent w d g + weightedHomogeneousComponent w d h := by
    rw [← map_add, hgh, hfd]
  have hxs : ∀ x ∈ xs, x.IsWeightedHomogeneous w 1 := by
    intro x hx
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
    exact isWeightedHomogeneous_X ℂ _ i
  obtain ⟨p, hpdeg, hpmem, hphom, hprel⟩ :=
    remainderTopIdeal_all_sizes_graded_certificate w xs hxs N j (by rw [hlen]; exact hj)
      (weightedHomogeneousComponent w d h) d
      (weightedHomogeneousComponent_isWeightedHomogeneous _ _) hhd
  let L := xs.length - j
  let F : (MvPolynomial (Fin B) ℂ)[X] := Polynomial.C f.val * Polynomial.X ^ L + p -
    Polynomial.C (weightedHomogeneousComponent w d g) * Polynomial.X ^ L
  have hF : F ∈ Ideal.span {(descendingPoly (newtonCoeff (selectedColourPowerSum colour selected))
      Y.card).map (ColourPolynomialRing colour).val.toRingHom, Polynomial.X ^ N} := by
    rw [selectedColourCharacteristic_map]
    have he : F = Polynomial.C (weightedHomogeneousComponent w d h) * Polynomial.X ^ L + p := by
      simp only [F]
      rw [hsplit, map_add]
      ring
    rw [he]
    exact hprel
  have havg := colourAverageCoefficients_mem_span colour _ N F hF
  let g₀ := colourPolynomialAverage colour (weightedHomogeneousComponent w d g)
  have hg₀ : g₀ ∈ K := by
    change g₀.val ∈ fullFlagTruncationIdeal B N
    exact colourPolynomialAverage_mem_stable colour
      ((fullFlagTruncationIdeal B N).restrictScalars ℂ)
      (fun g' x hx => fullFlagTruncationIdeal_stable B N g'.val hx) _ hgd
  have hFavg : colourAverageCoefficients colour F =
      Polynomial.C f * Polynomial.X ^ L + colourAverageCoefficients colour p -
        Polynomial.C g₀ * Polynomial.X ^ L := by
    simp only [F]
    rw [colourAverageCoefficients_sub, colourAverageCoefficients_add,
      colourAverageCoefficients_monomial, colourAverageCoefficients_monomial,
      colourPolynomialAverage_fixed]
  have hmap := Ideal.mem_map_of_mem (Polynomial.mapRingHom π.toRingHom) havg
  rw [Ideal.map_span, Set.image_pair] at hmap
  have hPπ : (descendingPoly (newtonCoeff (selectedColourPowerSum colour selected)) Y.card).map
      π.toRingHom =
        descendingPoly (newtonCoeff (colourTruncatedPowerSum colour selected N)) Y.card := by
    rw [descendingPoly_map]
    congr 1
    funext i
    rw [show π.toRingHom (newtonCoeff (selectedColourPowerSum colour selected) i) =
      π (newtonCoeff (selectedColourPowerSum colour selected) i) from rfl, ← newtonCoeff_map]
    rfl
  have hπg₀ : π g₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hg₀
  refine ⟨(colourAverageCoefficients colour p).map π.toRingHom, ?_, ?_, ?_⟩
  · intro l
    rw [Polynomial.coeff_map, colourAverageCoefficients_coeff]
    apply (colourTruncatedStratum_mem_iff colour selected N j _).mpr
    change (colourPolynomialAverage colour (p.coeff l)).val ∈
      fullFlagTruncationIdeal B N ⊔ remainderTopIdeal xs N j
    exact colourPolynomialAverage_mem_stable colour
      ((fullFlagTruncationIdeal B N ⊔ remainderTopIdeal xs N j).restrictScalars ℂ)
      (fun g' x hx => selectedStratumIdeal_stable colour selected N j g' x hx) _
      (Ideal.mem_sup_right (hpmem l))
  · intro l hl
    rw [Polynomial.coeff_map, colourAverageCoefficients_coeff] at hl ⊢
    have hlt : l < L := by
      by_contra hge
      apply hl
      rw [Polynomial.coeff_eq_zero_of_degree_lt (lt_of_lt_of_le hpdeg
        (by exact_mod_cast (show xs.length - j ≤ l by omega))), map_zero, map_zero]
    refine ⟨(d : ℤ) + (xs.length - j : ℕ) - l, by omega, ?_⟩
    exact ⟨_, colourPolynomialAverage_homogeneous colour _ _ (hphom l), rfl⟩
  · simp only [Polynomial.coe_mapRingHom] at hmap
    rw [Ideal.span_insert, hPπ] at hmap
    have he : (colourAverageCoefficients colour F).map π.toRingHom =
        Polynomial.C (π f) * Polynomial.X ^ L +
          (colourAverageCoefficients colour p).map π.toRingHom := by
      rw [hFavg]
      simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
        Polynomial.map_pow, Polynomial.map_X]
      rw [show π.toRingHom g₀ = π g₀ from rfl, hπg₀, map_zero, zero_mul, sub_zero]
      rfl
    have hmem : (colourAverageCoefficients colour F).map π.toRingHom ∈
        Ideal.span {descendingPoly (newtonCoeff (colourTruncatedPowerSum colour selected N))
          Y.card} ⊔ Ideal.span {Polynomial.X ^ N} := by
      simpa only [Polynomial.map_pow, Polynomial.map_X] using hmap
    have hL : L = (selectedColourPositions colour selected).card - j := by
      simp only [L]
      rw [hlen]
    rw [he, hL] at hmem
    exact hmem

end Strata

end

end VOA.DeligneAudit.SL4T
