theorem e7_certValidL :
    certValid VOA.DeligneAudit.E7Lie.wt (fun a b c => e7Fz a b c != 0) e7Kn e7Cert = true := by
  decide +kernel

theorem e7_covL : ∀ c : Fin 133, (certKnown e7Kn e7Cert c && !wEqB (VOA.DeligneAudit.E7Lie.wt c) 0) = true ∨
    (7 ≤ c.val ∧ c.val < 70) ∨ (c.val < 7) ∨ (False) := by
