set_option maxRecDepth 100000

namespace VOA.DeligneAudit.FiniteG.E7

open VOA.AffineGeneral.SCLie VOA.DeligneAudit.DeligneCarrier.E7

/-- Raising letters and simple lowering letters. -/
def e7Kn (c : Fin 133) : Bool := decide (7 ≤ c.val ∧ c.val < 70) || decide (c.val ∈ ([76, 75, 74, 73, 72, 71, 70] : List ℕ))

/-- The integer structure constants. -/
def e7Fz (a b c : Fin 133) : ℤ := coef (entry e7T a.val b.val) c.val

