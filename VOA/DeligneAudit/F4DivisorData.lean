/-- Relations containing the monomial `{c, d}`, index `n c + d`, all blocks. -/
def psiR : List (List (List ℕ)) :=
  [psiR0, psiR1, psiR2, psiR3, psiR4, psiR5, psiR6, psiR7, psiR8, psiR9, psiR10, psiR11, psiR12, psiR13, psiR14, psiR15, psiR16, psiR17, psiR18, psiR19, psiR20, psiR21, psiR22, psiR23, psiR24, psiR25, psiR26, psiR27, psiR28, psiR29, psiR30, psiR31, psiR32, psiR33, psiR34, psiR35, psiR36, psiR37, psiR38, psiR39, psiR40, psiR41, psiR42, psiR43, psiR44, psiR45, psiR46, psiR47, psiR48, psiR49, psiR50, psiR51]



/-- Decode flat `j z` pairs. -/
def zpairs : List ℕ → List (ℕ × ℤ)
  | j :: z :: r => (j, decZ z) :: zpairs r
  | _ => []

/-- Table `i`. -/
def tab (i : ℕ) : QV := quadOf ((tabR.getD (i / 52) []).getD (i % 52) [])

/-- Tree data of node `i`. -/
def par (i : ℕ) : ℕ × Bool × ℕ × ℕ × ℕ :=
  let l := (parR.getD (i / 52) []).getD (i % 52) []
  (l.getD 0 0, l.getD 1 0 == 1, l.getD 2 0, l.getD 3 0, l.getD 4 0)

/-- The table `U_k`. -/
def Uq (k : ℕ) : QV := quadOf ((UR.getD (k / 52) []).getD (k % 52) [])

/-- The certificate of `U_k`. -/
def Ucert (k : ℕ) : List (ℕ × ℤ) := zpairs ((UcR.getD (k / 52) []).getD (k % 52) [])

/-- The antisymmetric certificate of `(c, d)`. -/
def antiCert (c d : ℕ) : List (ℕ × ℤ) := zpairs ((antiR.getD c []).getD d [])

/-- The symmetric certificate of `(c, d)`. -/
def symCert (c d : ℕ) : List (ℕ × ℤ) := zpairs ((symR.getD c []).getD d [])

/-- The relations containing the monomial `{c, d}`. -/
def psiT (c d : ℕ) : List ℕ := (psiR.getD c []).getD d []

/-- Bracket columns. -/
def colS (x e : ℕ) : SV := pairsOf ((colR.getD x []).getD e [])

/-- `ψ_k(c,d) = q_k(c,d) + q_k(d,c)`. -/
def psiZ (k c d : ℕ) : ℤ := qget (relZ k) c d + qget (relZ k) d c

/-- `-Σ_{k ∈ psiT c d} ψ_k(c,d) U_k`. -/
def psiList (c d : ℕ) : QV := (psiT c d).flatMap fun k => smulQ (-(psiZ k c d)) (Uq k)

/-- `e_c⊗e_d + e_d⊗e_c`. -/
def symQ (c d : ℕ) : QV := [(c, d, 1), (d, c, 1)]

/-- `e_c⊗e_d - e_d⊗e_c`. -/
def antiQ (c d : ℕ) : QV := [(c, d, 1), (d, c, -1)]

/-- All entries are tree nodes of level `≤ ℓ`. -/
def levOf (L : List (ℕ × ℤ)) (ℓ : ℕ) : Bool :=
  L.all fun p => decide (p.1 < 2704) && decide ((par p.1).2.2.2.2 ≤ ℓ)

/-- Tree node checks for `i ∈ [lo, hi)`. -/
def nodeChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun i => nodeCheckC 52 colS tab par i

/-- Column checks. -/
def colChecks : Bool := (List.range 52).all fun x => colCheck br colS 52 x

/-- Depth bound. -/
def depthCheck : Bool := (List.range 2704).all fun i => decide ((par i).2.2.2.1 ≤ 4)

/-- The antisymmetric check for `(c, d)`. -/
def antiCheck (c d : ℕ) : Bool :=
  levOf (antiCert c d) 1 && encLin 52 tab (smulQ 48 (antiQ c d)) (antiCert c d)

/-- The check of `U_k`. -/
def UCheck (k : ℕ) : Bool :=
  levOf (Ucert k) 2 && encLin 52 tab (Uq k) (Ucert k)

/-- Tree tables (`i < 2704`) followed by the complement tables (`2704 + k`). -/
def tabX (i : ℕ) : QV := if i < 2704 then tab i else Uq (i - 2704)

/-- The full symmetric certificate: tree tables and `ψ_k(c,d) U_k`. -/
def symCertX (c d : ℕ) : List (ℕ × ℤ) :=
  symCert c d ++ (psiT c d).map fun k => (2704 + k, psiZ k c d)

/-- The symmetric check for `(c, d)`. -/
def symCheck (c d : ℕ) : Bool :=
  levOf (symCert c d) 0 && (psiT c d).Nodup && (psiT c d).all (fun k => decide (k < 325)) &&
    encLin 52 tabX (smulQ 559104 (symQ c d)) (symCertX c d)

/-- Completeness of `psiT`: every relation term `(i, j)` is listed under `{min, max}`. -/
def psiComplete : Bool :=
  (List.range 325).all fun k => (relZ k).all fun t =>
    decide (k ∈ psiT (min t.1 t.2.1) (max t.1 t.2.1))

/-- Antisymmetric checks for rows `c ∈ [lo, hi)`. -/
def antiChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun c => (List.range 52).all fun d => !decide (c < d) || antiCheck c d

/-- Symmetric checks for rows `c ∈ [lo, hi)`. -/
def symChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun c => (List.range 52).all fun d => !decide (c ≤ d) || symCheck c d

