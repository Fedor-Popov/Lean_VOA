import VOA.DeligneAudit.DeligneFusionFiniteG
import VOA.DeligneAudit.DeligneFusionFiniteGE7Chk
import VOA.DeligneAudit.E7SectorData

/-!
# The finiteness clause for `E7`

Generated by `Notes/deligne/campaign/generators/gen_finite_cert.py e7`. The 56-step
nilpotency certificate is kernel-checked in the light file `DeligneFusionFiniteGE7Chk`
(`e7_certValidL`, `e7_covL`); here it is read against `E7sector` by definitional unfolding.

`e7_finiteTable : FiniteTableG E7sector` and
`e7_fusionTotalBoundG_of_dim : FusionTotalDimG E7sector → FusionTotalBoundG E7sector`.
-/

set_option maxRecDepth 100000

namespace VOA.DeligneAudit.FiniteG.E7

open VOA.DeligneAudit.DeligneSector VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneCarrier.E7 VOA.AffineGeneral.SCLie

theorem e7_certValid :
    certValid E7sector.wt (fun a b c => e7Fz a b c != 0) e7Kn e7Cert = true :=
  e7_certValidL

theorem e7_cov : ∀ c : Fin 133, (certKnown e7Kn e7Cert c && !wEqB (E7sector.wt c) 0) = true ∨
    E7sector.raising c ∨ E7sector.cartan c ∨ E7sector.cartanN c :=
  e7_covL

theorem e7_kn : ∀ c : Fin 133, e7Kn c = true → E7sector.raising c ∨ E7sector.lowering c := by
  change ∀ c : Fin 133, e7Kn c = true →
    (7 ≤ c.val ∧ c.val < 70) ∨ (c.val ∈ ([76, 75, 74, 73, 72, 71, 70] : List ℕ))
  intro c h
  simpa [e7Kn] using h

theorem e7_hfz : ∀ a b c, E7sector.f a b c = (e7Fz a b c : ℂ) := fun _ _ _ => rfl

/-- **The finiteness table facts for `E7`.** -/
theorem e7_finiteTable : FiniteTableG E7sector :=
  finiteTableG_of_cert (fnz_of_table e7_hfz) e7Kn e7Cert e7_kn e7_certValid e7_cov

/-- **`FusionTotalBoundG E7sector` reduces to the bare dimension bound.** -/
theorem e7_fusionTotalBoundG_of_dim (h : FusionTotalDimG E7sector) :
    FusionTotalBoundG E7sector :=
  fusionTotalBoundG_of_dim e7_finiteTable h

end VOA.DeligneAudit.FiniteG.E7

section AxiomAudit
#print axioms VOA.DeligneAudit.FiniteG.E7.e7_finiteTable
#print axioms VOA.DeligneAudit.FiniteG.E7.e7_fusionTotalBoundG_of_dim
end AxiomAudit
