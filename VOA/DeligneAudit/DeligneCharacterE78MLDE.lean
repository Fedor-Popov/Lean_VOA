import VOA.DeligneAudit.DeligneCharacterMLDEClosed

/-!
# Closed forms of the E₇ and E₈ MLDE solutions

Instances of the generic `MLDEClosed.eq_mldeCoeff_of_HOde` (with `h∨ = 6(t+1)`):

* **E₇** (`h∨ = 18`, `L_{-4}(E₇)`): `mldeCoeff 18 N = [q^{N+3}] H_{E₇}·P⁻³⁴ / 42343741440`, with
  `H_{E₇} = 77E₂E₄⁴ + 211E₂E₄E₆² - 197E₄³E₆ - 91E₆³`;
* **E₈** (`h∨ = 30`, `L_{-6}(E₈)`): `mldeCoeff 30 N = [q^{N+5}] H_{E₈}·P⁻⁵⁸ / 13909248338175590400`,
  with `H_{E₈} = 33649E₂E₄⁷ + 318910E₂E₄⁴E₆² + 145105E₂E₄E₆⁴ - 139129E₄⁶E₆ - 315310E₄³E₆³ - 43225E₆⁵`.

Each instance needs (i) `HOde t H`, a Ramanujan-only polynomial certificate (generated by
a script not included in this release), and (ii) the first `t+2` coefficients of `H`, computed by
`Agrees` bookkeeping with `decide` on integer lists. Both are unconditional.
-/

namespace VOA.DeligneAudit.DeligneCharacter.MLDEClosed

open PowerSeries VOA.QSeries VOA.QSeries.JTP VOA.DeligneAudit.DeligneCharacter.D4MLDE

noncomputable section

/-- `H` for `E7` (`h∨ = 18`), weight 18, depth 1, integer-normalised. -/
def HE7 : PowerSeries ℚ :=
  211 * (E2s * (E4s * (E6s * E6s))) + 77 * (E2s * (E4s * (E4s * (E4s * E4s)))) - 91 * (E6s * (E6s * E6s)) - 197 * (E4s * (E4s * (E4s * E6s)))

theorem HE7_ode (hR : RamanujanIdentities) : HOde 2 HE7 := by
  unfold HOde
  have h2 : 12 * eulerOp E2s = E2s ^ 2 - E4s := hR.e2
  have h4 : 3 * eulerOp E4s = E2s * E4s - E6s := hR.e4
  have h6 : 2 * eulerOp E6s = E2s * E6s - E4s ^ 2 := hR.e6
  have h2d : 12 * eulerOp (eulerOp E2s) = 2 * E2s * eulerOp E2s - eulerOp E4s := by
    have := congrArg eulerOp h2
    rwa [eulerOp_ofNat_mul, eulerOp_sub, eulerOp_sq] at this
  have h4d : 3 * eulerOp (eulerOp E4s) = eulerOp E2s * E4s + E2s * eulerOp E4s - eulerOp E6s := by
    have := congrArg eulerOp h4
    rwa [eulerOp_ofNat_mul, eulerOp_sub, eulerOp_mul] at this
  have h6d : 2 * eulerOp (eulerOp E6s) = eulerOp E2s * E6s + E2s * eulerOp E6s - 2 * E4s * eulerOp E4s := by
    have := congrArg eulerOp h6
    rwa [eulerOp_ofNat_mul, eulerOp_sub, eulerOp_mul, eulerOp_sq] at this
  have n77 : eulerOp (77 : PowerSeries ℚ) = 0 := eulerOp_ofNat 77
  have n91 : eulerOp (91 : PowerSeries ℚ) = 0 := eulerOp_ofNat 91
  have n197 : eulerOp (197 : PowerSeries ℚ) = 0 := eulerOp_ofNat 197
  have n211 : eulerOp (211 : PowerSeries ℚ) = 0 := eulerOp_ofNat 211
  rw [HE7]
  simp only [eulerOp_add, eulerOp_sub, eulerOp_mul, n77, n91, n197, n211, zero_mul, zero_add]
  push_cast
  set A := E2s
  set B := E4s
  set C := E6s
  set a := eulerOp A
  set b := eulerOp B
  set c := eulerOp C
  set aa := eulerOp a
  set bb := eulerOp b
  set cc := eulerOp c
  linear_combination (2532 * B * C ^ 2 + 924 * B ^ 4) * h2d +
    (-28368 * B ^ 2 * C + 10128 * A * C ^ 2 + 14784 * A * B ^ 3) * h4d +
    (-19656 * C ^ 2 - 14184 * B ^ 3 + 30384 * A * B * C) * h6d +
    (5064 * C ^ 2 * b - 1638 * C ^ 3 + 10128 * B * C * c + 7392 * B ^ 3 * b - 3546 * B ^ 3 * C - 3798 * A * B * C ^ 2 - 1386 * A * B ^ 4) * h2 +
    (-56736 * B * C * b + 29484 * B * C ^ 2 - 56736 * B ^ 2 * c + 6684 * B ^ 4 + 40512 * A * C * c + 44352 * A * B ^ 2 * b + 21696 * A * B ^ 2 * C - 25320 * A ^ 2 * C ^ 2 - 22176 * A ^ 2 * B ^ 3) * h4 +
    (-39312 * C * c + 57144 * B ^ 2 * C + 4164 * A * C ^ 2 + 30384 * A * B * c - 15492 * A * B ^ 3 - 35448 * A ^ 2 * B * C) * h6

