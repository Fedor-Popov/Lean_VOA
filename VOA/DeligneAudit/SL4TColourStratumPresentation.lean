import VOA.DeligneAudit.SL4TColourPowerSumContraction

/-! Explicit elementary, power-sum, and minor presentations of colour-invariant strata. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

variable {C : Type*} [DecidableEq C] {B : ℕ} (colour : Fin B → C)

/-- An elementary symmetric polynomial of all positions, in the fixed coefficient algebra. -/
def colourFullElementary (s : ℕ) : ColourPolynomialRing colour :=
  ⟨esymm (Fin B) ℂ s, fun g => rename_esymm (Fin B) ℂ s g.val⟩

/-- The elementary coinvariant relations inside the colour-invariant polynomial algebra. -/
def colourSymmetricIdeal : Ideal (ColourPolynomialRing colour) :=
  Ideal.span {p | ∃ s : ℕ, 0 < s ∧ colourFullElementary colour s = p}

/-- Extending the invariant elementary ideal gives the full symmetric ideal. -/
theorem colourSymmetricIdeal_map :
    (colourSymmetricIdeal colour).map (ColourPolynomialRing colour).val.toRingHom =
      fullFlagSymmetricIdeal B := by
  rw [colourSymmetricIdeal, Ideal.map_span, fullFlagSymmetricIdeal]
  congr 1
  ext p
  constructor
  · rintro ⟨a, ⟨s, hs, rfl⟩, rfl⟩
    exact ⟨s, hs, rfl⟩
  · rintro ⟨s, hs, rfl⟩
    exact ⟨colourFullElementary colour s, ⟨s, hs, rfl⟩, rfl⟩

/-- Each selected-alphabet top minor is fixed when selection is by whole colour classes. -/
theorem colourRemainderTopMinor_fixed (selected : Finset C) (N j : ℕ)
    (cols : Fin j → ℕ) :
    remainderTopMinor (fullFlagSubalphabet (selectedColourPositions colour selected)) N j cols ∈
      ColourPolynomialRing colour := by
  intro g
  change (rename (R := ℂ) g.val).toRingHom (remainderTopMinor
    (fullFlagSubalphabet (selectedColourPositions colour selected)) N j cols) = _
  rw [remainderTopMinor_map (rename (R := ℂ) g.val).toRingHom
    (fullFlagSubalphabet (selectedColourPositions colour selected)) N j cols]
  have hp := selectedAlphabet_map_perm (selectedColourPositions colour selected)
    g.val.toEmbedding (fun i => (X i : MvPolynomial (Fin B) ℂ))
  have hg := positionColourSubgroup_preserves_selected colour selected g
  change (selectedColourPositions colour selected).map g.val.toEmbedding =
    selectedColourPositions colour selected at hg
  rw [hg] at hp
  have he : (fullFlagSubalphabet (selectedColourPositions colour selected)).map
      (rename g.val).toRingHom =
      (selectedColourPositions colour selected).toList.map (fun i =>
        (X (g.val i) : MvPolynomial (Fin B) ℂ)) := by
    simp only [fullFlagSubalphabet, List.map_map]
    apply List.map_congr_left
    intro i _
    exact rename_X g.val i
  rw [he]
  exact remainderTopMinor_perm hp.symm N j cols

/-- A selected-alphabet top minor as an element of the colour-invariant polynomial ring. -/
def colourRemainderTopMinor (selected : Finset C) (N j : ℕ) (cols : Fin j → ℕ) :
    ColourPolynomialRing colour :=
  ⟨remainderTopMinor (fullFlagSubalphabet (selectedColourPositions colour selected)) N j cols,
    colourRemainderTopMinor_fixed colour selected N j cols⟩

/-- The top-row stratum ideal with invariant coefficients and invariant minor generators. -/
def colourRemainderTopIdeal (selected : Finset C) (N j : ℕ) :
    Ideal (ColourPolynomialRing colour) :=
  Ideal.span (Set.range (colourRemainderTopMinor colour selected N j))

/-- Extending the invariant top-minor ideal gives the ordinary selected-alphabet ideal. -/
theorem colourRemainderTopIdeal_map (selected : Finset C) (N j : ℕ) :
    (colourRemainderTopIdeal colour selected N j).map
      (ColourPolynomialRing colour).val.toRingHom =
        remainderTopIdeal (fullFlagSubalphabet (selectedColourPositions colour selected)) N j := by
  rw [colourRemainderTopIdeal, Ideal.map_span, ← Set.range_comp]
  rfl

/-- The invariant full-flag ideal is generated by elementary relations and block tails. -/
theorem colourFullFlagIdeal_contract (N : ℕ) :
    (fullFlagTruncationIdeal B N).comap (ColourPolynomialRing colour).val.toRingHom =
      colourSymmetricIdeal colour ⊔ colourPowerSumTailIdeal colour N := by
  rw [fullFlagTruncationIdeal, ← colourSymmetricIdeal_map colour, sup_comm,
    colourCoordinateIdeal_contract_sup colour N, sup_comm]

/-- The actual contracted stratum ideal has the elementary, tail, and top-minor generators. -/
theorem colourStratumIdeal_contract (selected : Finset C) (N j : ℕ) :
    (fullFlagTruncationIdeal B N ⊔
      remainderTopIdeal (fullFlagSubalphabet (selectedColourPositions colour selected)) N j).comap
        (ColourPolynomialRing colour).val.toRingHom =
          colourSymmetricIdeal colour ⊔ colourPowerSumTailIdeal colour N ⊔
            colourRemainderTopIdeal colour selected N j := by
  rw [fullFlagTruncationIdeal, ← colourSymmetricIdeal_map colour,
    ← colourRemainderTopIdeal_map colour selected N j]
  have he (I J K : Ideal (MvPolynomial (Fin B) ℂ)) : I ⊔ J ⊔ K = J ⊔ (I ⊔ K) := by
    ac_rfl
  rw [he, ← Ideal.map_sup, colourCoordinateIdeal_contract_sup colour N]
  ac_rfl

/-- The explicit colour-tail stratum quotient, using generators in the invariant ring. -/
abbrev ColourTailStratumRing (selected : Finset C) (N j : ℕ) :=
  ColourPolynomialRing colour ⧸
    (colourSymmetricIdeal colour ⊔ colourPowerSumTailIdeal colour N ⊔
      colourRemainderTopIdeal colour selected N j)

/-- The explicit tail and minor presentation has the exact refined colour-orbit dimension. -/
theorem colourTailStratum_finrank (k j : ℕ) (hk : 2 * k ≤ B)
    (selected : Finset C) :
    FiniteDimensional ℂ (ColourTailStratumRing colour selected (B - k) j) ∧
      Module.finrank ℂ (ColourTailStratumRing colour selected (B - k) j) =
        Nat.card (Set.range (fun f : FullFlagStratumConfiguration B k j
          (selectedColourPositions colour selected) =>
            configurationColourMultiplicity colour f.val)) := by
  have h := colourStratum_contracted_finrank B k j hk colour selected
  dsimp only at h
  change FiniteDimensional ℂ (ColourPolynomialRing colour ⧸ _) ∧
    Module.finrank ℂ (ColourPolynomialRing colour ⧸ _) = _ at h
  rw [colourStratumIdeal_contract colour selected (B - k) j] at h
  exact h

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.colourSymmetricIdeal_map
#print axioms VOA.DeligneAudit.SL4T.colourRemainderTopMinor_fixed
#print axioms VOA.DeligneAudit.SL4T.colourRemainderTopIdeal_map
#print axioms VOA.DeligneAudit.SL4T.colourFullFlagIdeal_contract
#print axioms VOA.DeligneAudit.SL4T.colourStratumIdeal_contract
#print axioms VOA.DeligneAudit.SL4T.colourTailStratum_finrank
