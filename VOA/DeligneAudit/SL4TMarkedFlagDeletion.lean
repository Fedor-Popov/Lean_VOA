import VOA.DeligneAudit.SL4TMarkedFlagIdentities

/-!
# Deleting a root: layer rings and their child presentations

Let `C` be a commutative algebra generated by roots `r : Fin (n + 1) → C` and let `u` be a
position. The `i`-th power layer of the root `r u` is presented as `C ⧸ ((r u)^(i+1) : (r u)^i)`
(`rootPowerLayerIdeal`), which is isomorphic to `(r u)^i C / (r u)^(i+1) C`. In this layer ring
the deleted root is zero and the remaining roots `r (u.succAbove j)` generate it
(`deletedRoots_aeval_surjective`). Hence any presented algebra on `n` roots whose relations hold
for the remaining layer roots surjects onto the layer (`deletedLayer_finrank_le`). A relation of
the child holds in the layer exactly when its value times `(r u)^i` lies in `((r u)^(i+1))`
(`deletedLayerRoot_zero_of_mem`).

Groups of positions are transported along the deletion by `deletedGroup`, with the product, sum
and cardinality bookkeeping.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

/-! ### Groups of positions after a deletion -/

/-- The positions of a group that survive the deletion of the position `u`, reindexed by
`u.succAbove`. -/
def deletedGroup {n : ℕ} (u : Fin (n + 1)) (V : Finset (Fin (n + 1))) : Finset (Fin n) :=
  Finset.univ.filter fun j => u.succAbove j ∈ V

theorem mem_deletedGroup {n : ℕ} (u : Fin (n + 1)) (V : Finset (Fin (n + 1))) (j : Fin n) :
    j ∈ deletedGroup u V ↔ u.succAbove j ∈ V := by
  simp [deletedGroup]

theorem deletedGroup_compl {n : ℕ} (u : Fin (n + 1)) (V : Finset (Fin (n + 1))) :
    deletedGroup u Vᶜ = (deletedGroup u V)ᶜ := by
  ext j
  simp [deletedGroup]

/-- A product over a group splits into the deleted position and the surviving positions. -/
theorem prod_eq_deletedGroup {M : Type*} [CommMonoid M] {n : ℕ} (f : Fin (n + 1) → M)
    (V : Finset (Fin (n + 1))) (u : Fin (n + 1)) :
    ∏ i ∈ V, f i = (if u ∈ V then f u else 1) * ∏ j ∈ deletedGroup u V, f (u.succAbove j) := by
  have h : ∏ i ∈ V, f i = ∏ i, if i ∈ V then f i else 1 := by
    rw [Finset.prod_ite_mem, Finset.univ_inter]
  rw [h, Fin.prod_univ_succAbove _ u, deletedGroup, Finset.prod_filter]

/-- A sum over a group splits into the deleted position and the surviving positions. -/
theorem sum_eq_deletedGroup {M : Type*} [AddCommMonoid M] {n : ℕ} (f : Fin (n + 1) → M)
    (V : Finset (Fin (n + 1))) (u : Fin (n + 1)) :
    ∑ i ∈ V, f i = (if u ∈ V then f u else 0) + ∑ j ∈ deletedGroup u V, f (u.succAbove j) := by
  have h : ∑ i ∈ V, f i = ∑ i, if i ∈ V then f i else 0 := by
    rw [Finset.sum_ite_mem, Finset.univ_inter]
  rw [h, Fin.sum_univ_succAbove _ u, deletedGroup, Finset.sum_filter]

theorem prod_deletedGroup_of_notMem {M : Type*} [CommMonoid M] {n : ℕ} (f : Fin (n + 1) → M)
    (V : Finset (Fin (n + 1))) (u : Fin (n + 1)) (hu : u ∉ V) :
    ∏ j ∈ deletedGroup u V, f (u.succAbove j) = ∏ i ∈ V, f i := by
  rw [prod_eq_deletedGroup f V u, if_neg hu, one_mul]

theorem sum_deletedGroup_of_notMem {M : Type*} [AddCommMonoid M] {n : ℕ} (f : Fin (n + 1) → M)
    (V : Finset (Fin (n + 1))) (u : Fin (n + 1)) (hu : u ∉ V) :
    ∑ j ∈ deletedGroup u V, f (u.succAbove j) = ∑ i ∈ V, f i := by
  rw [sum_eq_deletedGroup f V u, if_neg hu, zero_add]

theorem card_eq_deletedGroup {n : ℕ} (V : Finset (Fin (n + 1))) (u : Fin (n + 1)) :
    V.card = (if u ∈ V then 1 else 0) + (deletedGroup u V).card := by
  have h := sum_eq_deletedGroup (fun _ => (1 : ℕ)) V u
  simpa only [Finset.sum_const, smul_eq_mul, mul_one] using h

theorem deletedGroup_card_of_notMem {n : ℕ} (V : Finset (Fin (n + 1))) (u : Fin (n + 1))
    (hu : u ∉ V) : (deletedGroup u V).card = V.card := by
  rw [card_eq_deletedGroup V u, if_neg hu, zero_add]

theorem deletedGroup_card_of_mem {n : ℕ} (V : Finset (Fin (n + 1))) (u : Fin (n + 1))
    (hu : u ∈ V) : (deletedGroup u V).card + 1 = V.card := by
  rw [card_eq_deletedGroup V u, if_pos hu, add_comm]

/-! ### The deleted elementary polynomial -/

variable {A : Type*} [CommRing A]

/-- Deleting a zero root from a coinvariant alphabet leaves a coinvariant alphabet. -/
theorem ksEPoly_delete_zero_root {n : ℕ} (x : Fin (n + 1) → A) (u : Fin (n + 1))
    (hx : x u = 0) (he : D4Levi.ksEPoly (List.ofFn x) = 1) :
    D4Levi.ksEPoly (List.ofFn fun j => x (u.succAbove j)) = 1 := by
  rw [ksEPoly_ofFn_eq_group] at he ⊢
  rw [groupElementaryPolynomial, Fin.prod_univ_succAbove _ u, hx, map_zero, zero_mul, sub_zero,
    one_mul] at he
  exact he

/-! ### Layer rings -/

section Layer

variable {C : Type*} [CommRing C] [Algebra ℂ C]

/-- After killing an ideal containing the deleted root, the remaining roots generate the
quotient. -/
theorem deletedRoots_aeval_surjective {n : ℕ} (r : Fin (n + 1) → C)
    (hr : Function.Surjective (aeval r : MvPolynomial (Fin (n + 1)) ℂ →ₐ[ℂ] C))
    (u : Fin (n + 1)) (J : Ideal C) (hu : r u ∈ J) :
    Function.Surjective
      (aeval (fun j => Ideal.Quotient.mk J (r (u.succAbove j))) :
        MvPolynomial (Fin n) ℂ →ₐ[ℂ] C ⧸ J) := by
  have hall : Function.Surjective
      (aeval (fun i => Ideal.Quotient.mkₐ ℂ J (r i)) :
        MvPolynomial (Fin (n + 1)) ℂ →ₐ[ℂ] C ⧸ J) := by
    rw [← MvPolynomial.comp_aeval]
    exact (Ideal.Quotient.mkₐ_surjective ℂ J).comp hr
  rw [← AlgHom.range_eq_top] at hall ⊢
  apply eq_top_iff.mpr
  rw [← hall, ← Algebra.adjoin_range_eq_range_aeval, Algebra.adjoin_le_iff]
  rintro c ⟨i, rfl⟩
  dsimp only
  rcases Fin.eq_self_or_eq_succAbove u i with h | ⟨j, rfl⟩
  · rw [h, show Ideal.Quotient.mkₐ ℂ J (r u) = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr hu]
    exact Subalgebra.zero_mem _
  · exact ⟨X j, aeval_X _ _⟩

/-- The remaining roots in the `i`-th power layer of the deleted root. -/
def deletedLayerRoot {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ) (j : Fin n) :
    C ⧸ rootPowerLayerIdeal (r u) i :=
  Ideal.Quotient.mk _ (r (u.succAbove j))

/-- An element whose product with `(r u)^i` lies in `((r u)^(i+1))` vanishes in the layer. -/
theorem layer_mk_eq_zero {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ) (c : C)
    (hc : c * r u ^ i ∈ Ideal.span {r u ^ (i + 1)}) :
    Ideal.Quotient.mk (rootPowerLayerIdeal (r u) i) c = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr ((rootPowerLayerIdeal_mem _ _ _).mpr hc)

theorem deletedLayer_elementary {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ)
    (he : D4Levi.ksEPoly (List.ofFn r) = 1) :
    D4Levi.ksEPoly (List.ofFn (deletedLayerRoot r u i)) = 1 := by
  let q := Ideal.Quotient.mk (rootPowerLayerIdeal (r u) i)
  have hm := congrArg (Polynomial.map q) he
  rw [alphabetElementary_map, List.map_ofFn, Polynomial.map_one] at hm
  exact ksEPoly_delete_zero_root (q ∘ r) u
    (Ideal.Quotient.eq_zero_iff_mem.mpr (root_mem_powerLayerIdeal _ _)) hm

theorem deletedLayerRoot_prod {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ)
    (S : Finset (Fin n)) (e : ℕ) :
    ∏ j ∈ S, deletedLayerRoot r u i j ^ e =
      Ideal.Quotient.mk _ (∏ j ∈ S, r (u.succAbove j) ^ e) := by
  simp [deletedLayerRoot]

theorem deletedLayerRoot_sum {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ)
    (S : Finset (Fin n)) (e : ℕ) :
    ∑ j ∈ S, deletedLayerRoot r u i j ^ e =
      Ideal.Quotient.mk _ (∑ j ∈ S, r (u.succAbove j) ^ e) := by
  simp [deletedLayerRoot]

theorem deletedLayerRoot_pow_eq_zero {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ)
    (j : Fin n) (e : ℕ) (hc : r (u.succAbove j) ^ e * r u ^ i ∈ Ideal.span {r u ^ (i + 1)}) :
    deletedLayerRoot r u i j ^ e = 0 := by
  rw [deletedLayerRoot, ← map_pow]
  exact layer_mk_eq_zero r u i _ hc

/-- A presented algebra on `n` roots whose relations hold for the remaining layer roots
surjects onto the layer, so the layer has at most its dimension. -/
theorem deletedLayer_finrank_le {n : ℕ} (r : Fin (n + 1) → C)
    (hr : Function.Surjective (aeval r : MvPolynomial (Fin (n + 1)) ℂ →ₐ[ℂ] C))
    (u : Fin (n + 1)) (i : ℕ) (I' : Ideal (MvPolynomial (Fin n) ℂ))
    [FiniteDimensional ℂ (MvPolynomial (Fin n) ℂ ⧸ I')]
    (hI' : I' ≤ RingHom.ker (aeval (deletedLayerRoot r u i)).toRingHom) :
    Module.finrank ℂ (C ⧸ rootPowerLayerIdeal (r u) i) ≤
      Module.finrank ℂ (MvPolynomial (Fin n) ℂ ⧸ I') :=
  finrank_le_of_aeval_surjective I' _ hI'
    (deletedRoots_aeval_surjective r hr u _ (root_mem_powerLayerIdeal _ _))

/-- The layer map from a presented child algebra, as an algebra homomorphism. -/
def deletedLayerMap {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ)
    (I' : Ideal (MvPolynomial (Fin n) ℂ))
    (hI' : I' ≤ RingHom.ker (aeval (deletedLayerRoot r u i)).toRingHom) :
    (MvPolynomial (Fin n) ℂ ⧸ I') →ₐ[ℂ] C ⧸ rootPowerLayerIdeal (r u) i :=
  Ideal.Quotient.liftₐ I' (aeval (deletedLayerRoot r u i)) (fun p hp => RingHom.mem_ker.mp (hI' hp))

theorem deletedLayerMap_mk {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ)
    (I' : Ideal (MvPolynomial (Fin n) ℂ))
    (hI' : I' ≤ RingHom.ker (aeval (deletedLayerRoot r u i)).toRingHom)
    (p : MvPolynomial (Fin n) ℂ) :
    deletedLayerMap r u i I' hI' (Ideal.Quotient.mk I' p) =
      aeval (deletedLayerRoot r u i) p := rfl

theorem deletedLayerMap_surjective {n : ℕ} (r : Fin (n + 1) → C)
    (hr : Function.Surjective (aeval r : MvPolynomial (Fin (n + 1)) ℂ →ₐ[ℂ] C))
    (u : Fin (n + 1)) (i : ℕ) (I' : Ideal (MvPolynomial (Fin n) ℂ))
    (hI' : I' ≤ RingHom.ker (aeval (deletedLayerRoot r u i)).toRingHom) :
    Function.Surjective (deletedLayerMap r u i I' hI') := by
  intro c
  obtain ⟨p, rfl⟩ := deletedRoots_aeval_surjective r hr u _ (root_mem_powerLayerIdeal _ _) c
  exact ⟨Ideal.Quotient.mk I' p, rfl⟩

/-- A vanishing element times anything lies in every ideal. -/
theorem mul_mem_of_eq_zero {R : Type*} [CommRing R] {x : R} (y : R) (I : Ideal R) (hx : x = 0) :
    x * y ∈ I := by
  rw [hx, zero_mul]
  exact I.zero_mem

/-- The relations of a generic marked full flag on the remaining roots hold in the `i`-th layer
of the deleted root as soon as each generator times `(r u)^i` lies in `((r u)^(i+1))`. -/
theorem deletedLayer_markedFlagIdeal_le_ker {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1))
    (i : ℕ) (marked : Set (Finset (Fin n))) (cut : Fin n → ℕ) (tail : Finset (Fin n)) (L : ℕ)
    (he : D4Levi.ksEPoly (List.ofFn r) = 1)
    (hm : ∀ S ∈ marked,
      (∏ j ∈ S, r (u.succAbove j)) * r u ^ i ∈ Ideal.span {r u ^ (i + 1)})
    (hc : ∀ j, r (u.succAbove j) ^ cut j * r u ^ i ∈ Ideal.span {r u ^ (i + 1)})
    (ht : ∀ s, L ≤ s →
      (∑ j ∈ tail, r (u.succAbove j) ^ s) * r u ^ i ∈ Ideal.span {r u ^ (i + 1)}) :
    markedFlagIdeal n marked cut tail L ≤
      RingHom.ker (aeval (deletedLayerRoot r u i)).toRingHom := by
  apply markedFlagIdeal_le_ker
  · exact deletedLayer_elementary r u i he
  · intro S hS
    have h := layer_mk_eq_zero r u i _ (hm S hS)
    simpa [deletedLayerRoot, map_prod] using h
  · intro j
    exact deletedLayerRoot_pow_eq_zero r u i j _ (hc j)
  · intro s hs
    have h := layer_mk_eq_zero r u i _ (ht s hs)
    simpa [deletedLayerRoot, map_sum] using h

end Layer

end

