import VOA.DeligneAudit.D4LeviKSSymmetricFamilies

/-! Symmetric polynomials on one colour embed in the XYZ shift algebra. -/

namespace VOA.DeligneAudit.D4Levi

open MvPolynomial

variable {σ : Type*} [Fintype σ]

theorem colourPsum_rename_psum (shape : σ → Fin 6) (j : Fin 6) (r : ℕ) :
    colourPsum shape j r =
      rename (fun i : {t : σ // shape t = j} => i.1)
        (psum {t : σ // shape t = j} ℂ r) := by
  classical
  rw [colourPsum, Finset.sum_map_toList]
  simp only [psum, map_sum, map_pow, rename_X]
  simp only [Finset.sum_ite, Finset.sum_const_zero, add_zero]
  rw [← Finset.sum_subtype_eq_sum_filter]
  simp

/-- An arbitrary symmetric shift on the letters of one colour belongs to
    the algebra generated by that colour's positive power sums. -/
theorem colourSymmetric_mem_xyzPowerSumAlgebra
    (shape : σ → Fin 6) (j : Fin 6)
    (hj : j = 1 ∨ j = 4 ∨ j = 5)
    (P : MvPolynomial {t : σ // shape t = j} ℂ)
    (hP : P ∈ symmetricSubalgebra {t : σ // shape t = j} ℂ) :
    rename (fun i : {t : σ // shape t = j} => i.1) P ∈
      xyzPowerSumAlgebra shape := by
  let φ : MvPolynomial {t : σ // shape t = j} ℂ →ₐ[ℂ]
      MvPolynomial σ ℂ := rename (fun i => i.1)
  have hsub : powerSumAlgebra {t : σ // shape t = j} ≤
      (xyzPowerSumAlgebra shape).comap φ := by
    apply Algebra.adjoin_le
    rintro Q ⟨r, rfl⟩
    by_cases hr : r = 0
    · subst r
      simp [φ, psum_zero]
    · have hrpos : 0 < r := Nat.pos_of_ne_zero hr
      change φ (psum {t : σ // shape t = j} ℂ r) ∈
        xyzPowerSumAlgebra shape
      rw [← colourPsum_rename_psum shape j r]
      exact Algebra.subset_adjoin ⟨j, r, hj, hrpos, rfl⟩
  exact hsub (symmetric_mem_powerSumAlgebra _ P hP)

end VOA.DeligneAudit.D4Levi

#print axioms VOA.DeligneAudit.D4Levi.colourPsum_rename_psum
#print axioms VOA.DeligneAudit.D4Levi.colourSymmetric_mem_xyzPowerSumAlgebra
