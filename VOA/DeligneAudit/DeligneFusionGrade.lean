#print axioms VOA.DeligneAudit.SectorWeyl.projF_J
#print axioms VOA.DeligneAudit.SectorWeyl.mabRel_quot
#print axioms VOA.DeligneAudit.SectorWeyl.fd_step
#print axioms VOA.DeligneAudit.SectorWeyl.finrank_step
end AxiomAudit
