import VOA.DeligneAudit.DeligneFusionUniv

/-!
# The `t`-grading of `U_{a,b}` and the recursion inequality

All generators of `Jrel a b` are homogeneous for the word degree, so the degree projections of the
free space descend to `U_{a,b}`.  With them, the cyclic submodule `S` generated by Ravinder's kernel
vector `v = (f_θ ⊗ t^{2a+b+1}) w` of `U_{a+1,b}` meets the degree-`N` piece inside the image of
`U_{a,b}` shifted by `2a+b+1`, while `U_{a+1,b}/S` is generated by a vector with the relations of
`M_{a,b+1}`.  Rank–nullity gives `rec_le`; the same exact sequence gives finite-dimensionality of
all degree pieces, by induction on `a` from `FusionTotalBound` at `a = 0`.
-/

namespace VOA.DeligneAudit.SectorWeyl

open VOA.AffineSl3

noncomputable section

local notation "deg" => VOA.DeligneAudit.SectorGraded.wordDeg

theorem degL_cons (x : Ltr) (l : List Ltr) : deg (x :: l) = x.2 + deg l := by
  simp [VOA.DeligneAudit.SectorGraded.wordDeg]

theorem degL_nil : deg ([] : List Ltr) = 0 := rfl

theorem degL_append (l m : List Ltr) : deg (l ++ m) = deg l + deg m := by
  simp [VOA.DeligneAudit.SectorGraded.wordDeg]

/-! ## Degree projections -/

/-- The projection of formal combinations of words onto word degree `N`. -/
def projF (N : ℕ) : FreeW →ₗ[ℂ] FreeW :=
  Finsupp.linearCombination ℂ (fun l => if deg l = N then sw l else 0)

theorem projF_sw (N : ℕ) (l : List Ltr) : projF N (sw l) = if deg l = N then sw l else 0 := by
  simp [projF, sw]

theorem projF_J (a b N : ℕ) : Jrel a b ≤ (Jrel a b).comap (projF N) := by
  rw [Jrel, Submodule.span_le]
  intro g hg
  have hmem : g ∈ Jrel a b := Submodule.subset_span hg
  change projF N g ∈ Jrel a b
  rcases hg with ⟨p, ⟨s, x, y, rfl⟩ | ⟨t, ht, rfl⟩ | ⟨hh, h6, rfl⟩⟩
  · by_cases hD : deg p + (x.2 + (y.2 + deg s)) = N
    · have h2 : deg p + (y.2 + (x.2 + deg s)) = N := by omega
      have h3 : deg p + (x.2 + y.2 + deg s) = N := by omega
      have : projF N (commInst p s x y) = commInst p s x y := by
        simp only [commInst, map_sub, map_sum, map_smul, projF_sw, degL_append, degL_cons]
        simp [hD, h2, h3]
      rw [this]; exact hmem
    · have h2 : ¬ deg p + (y.2 + (x.2 + deg s)) = N := by omega
      have h3 : ¬ deg p + (x.2 + y.2 + deg s) = N := by omega
      have : projF N (commInst p s x y) = 0 := by
        simp only [commInst, map_sub, map_sum, map_smul, projF_sw, degL_append, degL_cons]
        simp [hD, h2, h3]
      rw [this]; exact zero_mem _
  · rw [projF_sw]; split_ifs
    · exact hmem
    · exact zero_mem _
  · by_cases hD : deg p = N
    · have : projF N (sw (p ++ [(hh, 0)]) - ((a + b : ℕ) : ℂ) • sw p) =
          sw (p ++ [(hh, 0)]) - ((a + b : ℕ) : ℂ) • sw p := by
        simp only [map_sub, map_smul, projF_sw, degL_append, degL_cons, degL_nil, add_zero]
        simp [hD]
      rw [this]; exact hmem
    · have : projF N (sw (p ++ [(hh, 0)]) - ((a + b : ℕ) : ℂ) • sw p) = 0 := by
        simp only [map_sub, map_smul, projF_sw, degL_append, degL_cons, degL_nil, add_zero]
        simp [hD]
      rw [this]; exact zero_mem _

/-- The degree projection on `U_{a,b}`. -/
def projU (a b N : ℕ) : UMod a b →ₗ[ℂ] UMod a b := (Jrel a b).mapQ (Jrel a b) (projF N) (projF_J a b N)

theorem projU_mk (a b N : ℕ) (l : List Ltr) :
    projU a b N (Submodule.Quotient.mk (sw l)) =
      if deg l = N then (Submodule.Quotient.mk (sw l) : UMod a b) else 0 := by
  rw [projU, Submodule.mapQ_apply, projF_sw]
  split_ifs <;> simp

theorem projU_cyc (a b N : ℕ) {x : UMod a b} (hx : x ∈ cycDeg (univRep a b) (wU a b) N) :
    projU a b N x = x := by
  induction hx using Submodule.span_induction with
  | mem v hv =>
      obtain ⟨l, hl, rfl⟩ := hv
      rw [wordOp_univ, projU_mk, if_pos hl]
  | zero => exact map_zero _
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | smul c x _ hx => rw [map_smul, hx]

/-! ## Quotients of current modules by invariant submodules -/

section Quot

variable {V : Type} [AddCommGroup V] [Module ℂ V] (ρ : CurrentModule (bracketTable) V)

/-- The cyclic submodule generated by `v`. -/
def cycSub (v : V) : Submodule ℂ V := Submodule.span ℂ (Set.range fun l : List Ltr => wordOp ρ l v)

theorem wordOp_mem_cycSub (v : V) (l : List Ltr) : wordOp ρ l v ∈ cycSub ρ v :=
  Submodule.subset_span ⟨l, rfl⟩

theorem cycSub_inv (v : V) (c : Fin 8) (r : ℕ) : cycSub ρ v ≤ (cycSub ρ v).comap (ρ.op c r) := by
  rw [cycSub, Submodule.span_le]
  rintro _ ⟨l, rfl⟩
  exact wordOp_mem_cycSub ρ v ((c, r) :: l)

variable (S : Submodule ℂ V) (hS : ∀ c r, S ≤ S.comap (ρ.op c r))

/-- The quotient current module. -/
def quotRep : CurrentModule (bracketTable) (V ⧸ S) where
  op c r := S.mapQ S (ρ.op c r) (hS c r)
  comm c d r s x := by
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective S x
    have := congrArg S.mkQ (ρ.comm c d r s y)
    simpa [Submodule.mapQ_apply, map_sum, map_smul, map_sub] using this

theorem quotRep_op (c : Fin 8) (r : ℕ) (v : V) :
    (quotRep ρ S hS).op c r (S.mkQ v) = S.mkQ (ρ.op c r v) := rfl

theorem quot_wordOp (v : V) : ∀ l : List Ltr,
    wordOp (quotRep ρ S hS) l (S.mkQ v) = S.mkQ (wordOp ρ l v)
  | [] => rfl
  | (x :: l) => by
      change (quotRep ρ S hS).op x.1 x.2 (wordOp (quotRep ρ S hS) l (S.mkQ v)) = _
      rw [quot_wordOp v l, quotRep_op]; rfl

theorem quot_cycDeg (w : V) (N : ℕ) :
    cycDeg (quotRep ρ S hS) (S.mkQ w) N = (cycDeg ρ w N).map S.mkQ := by
  rw [cycDeg, cycDeg, Submodule.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨l, hl, rfl⟩; exact ⟨_, ⟨l, hl, rfl⟩, (quot_wordOp ρ S hS w l).symm⟩
  · rintro ⟨u, ⟨l, hl, rfl⟩, rfl⟩; exact ⟨l, hl, (quot_wordOp ρ S hS w l).symm⟩

theorem quot_iterate (x : Ltr) (w : V) (n : ℕ) :
    ((quotRep ρ S hS).op x.1 x.2)^[n] (S.mkQ w) = S.mkQ ((ρ.op x.1 x.2)^[n] w) := by
  rw [iterate_eq_wordOp, iterate_eq_wordOp, quot_wordOp]

/-- Killing `(f_θ ⊗ t^{2a+b+1}) w` turns the relations of `M_{a+1,b}` into those of `M_{a,b+1}`. -/
theorem mabRel_quot {w : V} {a b : ℕ} (h : MabRel ρ w (a + 1) b)
    (hv : ρ.op 5 (2 * a + b + 1) w ∈ S) : MabRel (quotRep ρ S hS) (S.mkQ w) a (b + 1) where
  raising e he r := by rw [quotRep_op, h.raising e he r, map_zero]
  cartan_pos hh h6 r hr := by rw [quotRep_op, h.cartan_pos hh h6 r hr, map_zero]
  cartan_zero hh h6 := by
    rw [quotRep_op, h.cartan_zero hh h6, map_smul, show a + (b + 1) = a + 1 + b by omega]
  lowering_f1 := by
    have := quot_iterate ρ S hS (3, 0) w (a + 1 + b + 1)
    rw [show a + (b + 1) + 1 = a + 1 + b + 1 by omega]
    rw [this]; erw [h.lowering_f1]; exact map_zero _
  lowering_f2 := by
    have := quot_iterate ρ S hS (4, 0) w (a + 1 + b + 1)
    rw [show a + (b + 1) + 1 = a + 1 + b + 1 by omega]
    rw [this]; erw [h.lowering_f2]; exact map_zero _
  trunc_f1 := by
    rw [quotRep_op, show a + (b + 1) = a + 1 + b by omega, h.trunc_f1, map_zero]
  trunc_f2 := by
    rw [quotRep_op, show a + (b + 1) = a + 1 + b by omega, h.trunc_f2, map_zero]
  trunc_theta := by
    rw [quotRep_op, show 2 * a + (b + 1) = 2 * a + b + 1 by omega]
    exact (Submodule.Quotient.mk_eq_zero S).mpr hv

end Quot

/-! ## Rank–nullity for a submodule -/

theorem finrank_le_map_add_inf {V W : Type} [AddCommGroup V] [Module ℂ V] [AddCommGroup W]
    [Module ℂ W] (f : V →ₗ[ℂ] W) (P : Submodule ℂ V) [FiniteDimensional ℂ P] :
    Module.finrank ℂ P ≤ Module.finrank ℂ (P.map f) + Module.finrank ℂ (P ⊓ LinearMap.ker f : Submodule ℂ V) := by
  have h := (f.domRestrict P).finrank_range_add_finrank_ker
  rw [LinearMap.range_domRestrict, LinearMap.ker_domRestrict] at h
  have e : Module.finrank ℂ ((LinearMap.ker f).comap P.subtype) =
      Module.finrank ℂ (P ⊓ LinearMap.ker f : Submodule ℂ V) := by
    rw [← Submodule.map_comap_subtype]
    exact (Submodule.equivMapOfInjective P.subtype P.injective_subtype _).finrank_eq
  omega

/-! ## The kernel vector of `U_{a+1,b}` -/

section Step

variable (a b : ℕ)

/-- Ravinder's kernel vector `(f_θ ⊗ t^{2a+b+1}) w` of `U_{a+1,b}`. -/
def vK : UMod (a + 1) b := (univRep (a + 1) b).op 5 (2 * a + b + 1) (wU (a + 1) b)

theorem wordOp_vK (l : List Ltr) :
    wordOp (univRep (a + 1) b) l (vK a b) = Submodule.Quotient.mk (sw (l ++ [(5, 2 * a + b + 1)])) := by
  rw [vK, show (univRep (a + 1) b).op 5 (2 * a + b + 1) (wU (a + 1) b) =
    wordOp (univRep (a + 1) b) [(5, 2 * a + b + 1)] (wU (a + 1) b) from rfl, ← wordOp_append,
    wordOp_univ]

theorem vK_mabRel (hR : RavinderKernelRel) : MabRel (univRep (a + 1) b) (vK a b) a b := by
  have := hR (a + 1) b _ (univRep (a + 1) b) (wU (a + 1) b) (by omega) (univ_mabRel _ _)
  rwa [show 2 * (a + 1) + b - 1 = 2 * a + b + 1 by omega, show a + 1 - 1 = a by omega] at this

/-- The submodule generated by the kernel vector. -/
abbrev SK : Submodule ℂ (UMod (a + 1) b) := cycSub (univRep (a + 1) b) (vK a b)

theorem projU_SK (N : ℕ) {x : UMod (a + 1) b} (hx : x ∈ SK a b) :
    projU (a + 1) b N x ∈ cycDeg (univRep (a + 1) b) (vK a b) (N - (2 * a + b + 1)) ∧
      (N < 2 * a + b + 1 → projU (a + 1) b N x = 0) := by
  induction hx using Submodule.span_induction with
  | mem v hv =>
      obtain ⟨l, rfl⟩ := hv
      dsimp only
      rw [wordOp_vK, projU_mk, degL_append, degL_cons, degL_nil]
      dsimp only
      split_ifs with hl
      · refine ⟨?_, fun h => by omega⟩
        rw [← wordOp_vK]; exact Submodule.subset_span ⟨l, by omega, rfl⟩
      · exact ⟨zero_mem _, fun _ => rfl⟩
  | zero => simp
  | add x y _ _ hx hy =>
      rw [map_add]; exact ⟨add_mem hx.1 hy.1, fun h => by rw [hx.2 h, hy.2 h, add_zero]⟩
  | smul c x _ hx =>
      rw [map_smul]; exact ⟨Submodule.smul_mem _ c hx.1, fun h => by rw [hx.2 h, smul_zero]⟩

theorem inf_SK_le (N : ℕ) :
    cycDeg (univRep (a + 1) b) (wU (a + 1) b) N ⊓ SK a b ≤
      cycDeg (univRep (a + 1) b) (vK a b) (N - (2 * a + b + 1)) := by
  rintro x ⟨hP, hS⟩
  rw [← projU_cyc (a + 1) b N hP]
  exact (projU_SK a b N hS).1

theorem inf_SK_bot (N : ℕ) (hN : N < 2 * a + b + 1) :
    cycDeg (univRep (a + 1) b) (wU (a + 1) b) N ⊓ SK a b = ⊥ := by
  rw [eq_bot_iff]
  rintro x ⟨hP, hS⟩
  rw [Submodule.mem_bot, ← projU_cyc (a + 1) b N hP]
  exact (projU_SK a b N hS).2 hN

theorem vK_mem : vK a b ∈ SK a b := wordOp_mem_cycSub (univRep (a + 1) b) (vK a b) []

/-- The quotient `U_{a+1,b}/S` and its generator, with the relations of `M_{a,b+1}`. -/
theorem quotK_mabRel :
    MabRel (quotRep (univRep (a + 1) b) (SK a b) (cycSub_inv _ _)) ((SK a b).mkQ (wU (a + 1) b)) a
      (b + 1) :=
  mabRel_quot _ _ _ (univ_mabRel (a + 1) b) (vK_mem a b)

theorem map_cyc_mkQ (N : ℕ) :
    (cycDeg (univRep (a + 1) b) (wU (a + 1) b) N).map (SK a b).mkQ =
      (cycDeg (univRep a (b + 1)) (wU a (b + 1)) N).map (univMap (quotK_mabRel a b)) := by
  rw [← quot_cycDeg (univRep (a + 1) b) (SK a b) (cycSub_inv _ _), map_cycDeg]

theorem cyc_vK (hR : RavinderKernelRel) (M : ℕ) :
    cycDeg (univRep (a + 1) b) (vK a b) M =
      (cycDeg (univRep a b) (wU a b) M).map (univMap (vK_mabRel a b hR)) :=
  (map_cycDeg _ M).symm

/-- **Finite-dimensionality propagates** from `U_{a,b+1}` and `U_{a,b}` to `U_{a+1,b}`. -/
theorem fd_step (hR : RavinderKernelRel) (N : ℕ)
    [FiniteDimensional ℂ (cycDeg (univRep a (b + 1)) (wU a (b + 1)) N)]
    [FiniteDimensional ℂ (cycDeg (univRep a b) (wU a b) (N - (2 * a + b + 1)))] :
    FiniteDimensional ℂ (cycDeg (univRep (a + 1) b) (wU (a + 1) b) N) := by
  apply Module.Finite.iff_fg.mpr
  refine Submodule.fg_of_fg_map_of_fg_inf_ker (SK a b).mkQ ?_ ?_
  · rw [map_cyc_mkQ]
    exact (Module.Finite.iff_fg.mp inferInstance).map _
  · rw [Submodule.ker_mkQ, ← Module.Finite.iff_fg]
    have h1 := inf_SK_le a b N
    rw [cyc_vK a b hR] at h1
    exact Submodule.finiteDimensional_of_le h1

/-- **The recursion inequality, degree by degree.** -/
theorem finrank_step (hR : RavinderKernelRel) (N : ℕ)
    [FiniteDimensional ℂ (cycDeg (univRep a (b + 1)) (wU a (b + 1)) N)]
    [FiniteDimensional ℂ (cycDeg (univRep a b) (wU a b) (N - (2 * a + b + 1)))] :
    Module.finrank ℂ (cycDeg (univRep (a + 1) b) (wU (a + 1) b) N) ≤
      Module.finrank ℂ (cycDeg (univRep a (b + 1)) (wU a (b + 1)) N) +
        if 2 * a + b + 1 ≤ N then
          Module.finrank ℂ (cycDeg (univRep a b) (wU a b) (N - (2 * a + b + 1))) else 0 := by
  haveI := fd_step a b hR N
  have h := finrank_le_map_add_inf (SK a b).mkQ (cycDeg (univRep (a + 1) b) (wU (a + 1) b) N)
  rw [Submodule.ker_mkQ, map_cyc_mkQ] at h
  have h1 : Module.finrank ℂ ((cycDeg (univRep a (b + 1)) (wU a (b + 1)) N).map
      (univMap (quotK_mabRel a b))) ≤ Module.finrank ℂ (cycDeg (univRep a (b + 1)) (wU a (b + 1)) N) :=
    Submodule.finrank_map_le _ _
  have h2 : Module.finrank ℂ (cycDeg (univRep (a + 1) b) (wU (a + 1) b) N ⊓ SK a b :
      Submodule ℂ (UMod (a + 1) b)) ≤ if 2 * a + b + 1 ≤ N then
          Module.finrank ℂ (cycDeg (univRep a b) (wU a b) (N - (2 * a + b + 1))) else 0 := by
    split_ifs with hN
    · have h3 := inf_SK_le a b N
      rw [cyc_vK a b hR] at h3
      exact (Submodule.finrank_mono h3).trans (Submodule.finrank_map_le _ _)
    · rw [inf_SK_bot a b N (by omega), finrank_bot]
  omega

end Step

end

end VOA.DeligneAudit.SectorWeyl

