/-- The stability certificates of the lowering generators. -/
def stabOf : ℕ → List (List ℕ)
  | 42 => stab42 | 43 => stab43 | 44 => stab44 | 45 => stab45 | 46 => stab46 | 47 => stab47 | _ => []

/-- The single term of a certificate row. -/
def rowPairs (g r : ℕ) : List (ℤ × ℕ) := pairsOf ((stabOf g).getD r []).tail

/-- One propagation step. -/
def stepOK (known : List ℕ) (st : ℕ × ℕ × ℕ) : Bool :=
  decide (42 ≤ st.1) && decide (st.1 ≤ 47) && known.contains st.2.1 && decide (st.2.1 < 651) &&
    rowPairs st.1 st.2.1 == [(((rowPairs st.1 st.2.1).headD (0, 0)).1, st.2.2)] &&
    ((rowPairs st.1 st.2.1).headD (0, 0)).1 != 0 && decide (st.2.2 < 650)

/-- A propagation chain. -/
def propOK : List ℕ → List (ℕ × ℕ × ℕ) → Bool
  | _, [] => true
  | known, st :: rest => stepOK known st && propOK (st.2.2 :: known) rest

