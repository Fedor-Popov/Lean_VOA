import VOA.DeligneAudit.SL4TGradedJointDeterminantal
import VOA.DeligneAudit.SL4THomogeneousIdealExpansion
import VOA.DeligneAudit.SL4TRadicalGrassmannianPowerSums
import VOA.DeligneAudit.SL4TAlphabetPeel
import VOA.DeligneAudit.SL4TMixedTruncationIdentity
import VOA.DeligneAudit.SL4TMixedPowerSum

/-!
# The grading of the one-adjoint-site coefficient ring

Give the generator `X(i, n) = e_(n+1)` of the `i`-th alphabet of the mixed polynomial ring the
weight `n + 1`. Then every elementary and complete symmetric function of every alphabet, every
relative series `U`, `V`, `g₁′`, `g₂′`, and every power sum is homogeneous; hence the block
relations and the ring kernel `I_J(h)` are generated by homogeneous polynomials. This file
proves:

* the kernel of the evaluation `MixedPoly → A = R / I_J(h)` is generated by homogeneous
  polynomials, so it contains the homogeneous components of its elements
  (`adjointSiteEvaluation_component_eq_zero`);
* the images of the homogeneous pieces form a grading of `A`
  (`adjointSiteGradedAlgebra`), vanishing in negative degrees;
* `A` is finite dimensional, since every elementary generator of every alphabet is nilpotent
  in the block ring (`mixedRing_finiteDimensional`,
  `adjointSiteCoefficientRing_finiteDimensional`);
* the characteristic polynomial `P_y` is monic and homogeneous of degree `r`, the positive
  power sums `p_s` have degree `s`, and the joint symbol `s` is homogeneous.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open Polynomial

/-! ### Weights on the mixed polynomial ring -/

/-- The weight `n + 1` of the generator `X(i, n) = e_(n+1)` of the `i`-th alphabet. -/
def mixedPolyWeight (x : Fin 5 × ℕ) : ℤ := (x.2 : ℤ) + 1

/-- The weighted homogeneous pieces of the mixed polynomial ring. -/
abbrev mixedPolyGrading : ℤ → Submodule ℂ MixedPoly :=
  MvPolynomial.weightedHomogeneousSubmodule ℂ mixedPolyWeight

instance mixedPolyGrading_gradedMonoid : SetLike.GradedMonoid mixedPolyGrading :=
  MvPolynomial.WeightedHomogeneousSubmodule.gradedMonoid

theorem neg_one_pow_mem_mixedPolyGrading (n : ℕ) :
    ((-1 : MixedPoly) ^ n) ∈ mixedPolyGrading 0 := by
  have h : (-1 : MixedPoly) ∈ mixedPolyGrading 0 :=
    Submodule.neg_mem _ (SetLike.one_mem_graded mixedPolyGrading)
  have hp := SetLike.pow_mem_graded n h
  rwa [smul_zero] at hp

theorem mixedE_mem_grading (i : Fin 5) (j : ℕ) : mixedE i j ∈ mixedPolyGrading j := by
  cases j with
  | zero =>
      simp only [mixedE, elementary_zero, map_one, Nat.cast_zero]
      exact SetLike.one_mem_graded mixedPolyGrading
  | succ n =>
      simp only [mixedE, mixedAlphabet, elementary_succ, MvPolynomial.rename_X]
      have h := MvPolynomial.isWeightedHomogeneous_X ℂ mixedPolyWeight (i, n)
      simpa [mixedPolyWeight] using h

theorem mixedH_mem_grading (i : Fin 5) (j : ℕ) : mixedH i j ∈ mixedPolyGrading j := by
  induction j using Nat.strong_induction_on with
  | h j ih =>
      cases j with
      | zero =>
          simp only [mixedH, complete_zero, map_one, Nat.cast_zero]
          exact SetLike.one_mem_graded mixedPolyGrading
      | succ n =>
          have hrec : mixedH i (n + 1) = -∑ k ∈ Finset.range (n + 1),
              (-1) ^ (k + 1) * mixedE i (k + 1) * mixedH i (n - k) := by
            simp only [mixedH, mixedE, complete_succ, map_neg, map_sum, map_mul, map_pow,
              map_one]
          rw [hrec]
          apply Submodule.neg_mem
          apply Submodule.sum_mem
          intro k hk
          have hk' := Finset.mem_range.mp hk
          have h := SetLike.mul_mem_graded
            (SetLike.mul_mem_graded (neg_one_pow_mem_mixedPolyGrading (k + 1))
              (mixedE_mem_grading i (k + 1))) (ih (n - k) (by omega))
          rw [show (0 : ℤ) + ((k + 1 : ℕ) : ℤ) + ((n - k : ℕ) : ℤ) = ((n + 1 : ℕ) : ℤ) by
            push_cast [Nat.cast_sub (show k ≤ n by omega)]
            ring] at h
          exact h

theorem signed_mem_grading (f : ℕ → MixedPoly) (hf : ∀ j : ℕ, f j ∈ mixedPolyGrading (j : ℤ))
    (j : ℕ) :
    (-1) ^ j * f j ∈ mixedPolyGrading j := by
  have h := SetLike.mul_mem_graded (neg_one_pow_mem_mixedPolyGrading j) (hf j)
  rwa [zero_add] at h

theorem mixedConv_mem_grading (f g : ℕ → MixedPoly)
    (hf : ∀ j : ℕ, f j ∈ mixedPolyGrading (j : ℤ)) (hg : ∀ j : ℕ, g j ∈ mixedPolyGrading (j : ℤ))
    (n : ℕ) : mixedConv f g n ∈ mixedPolyGrading n := by
  unfold mixedConv
  apply Submodule.sum_mem
  intro i hi
  have hi' := Finset.mem_range.mp hi
  have h := SetLike.mul_mem_graded (hf i) (hg (n - i))
  rw [show ((i : ℕ) : ℤ) + ((n - i : ℕ) : ℤ) = (n : ℤ) by
    push_cast [Nat.cast_sub (show i ≤ n by omega)]
    ring] at h
  exact h

theorem mixedG1prime_mem_grading (j : ℕ) : mixedG1prime j ∈ mixedPolyGrading j :=
  mixedConv_mem_grading _ _
    (mixedConv_mem_grading _ _ (mixedE_mem_grading 0)
      (signed_mem_grading _ (mixedH_mem_grading 1)))
    (signed_mem_grading _ (mixedH_mem_grading 3)) j

theorem mixedG2prime_mem_grading (j : ℕ) : mixedG2prime j ∈ mixedPolyGrading j :=
  mixedConv_mem_grading _ _
    (mixedConv_mem_grading _ _ (mixedE_mem_grading 1)
      (signed_mem_grading _ (mixedH_mem_grading 2)))
    (signed_mem_grading _ (mixedH_mem_grading 4)) j

/-- Every defining relation of a block ring is homogeneous. -/
theorem mixedRelations_homogeneous (q : MixedParams) (f : MixedPoly)
    (hf : f ∈ mixedRelations q) : ∃ d : ℤ, f ∈ mixedPolyGrading d := by
  rcases hf with ⟨i, j, _, rfl⟩ | ⟨j, _, _, rfl⟩ | ⟨j, _, _, rfl⟩ | ⟨j, _, _, rfl⟩ |
      ⟨j, _, _, rfl⟩ | ⟨j, _, _, rfl⟩
  · exact ⟨j, mixedE_mem_grading i j⟩
  · exact ⟨j, mixedH_mem_grading 0 j⟩
  · exact ⟨j, mixedH_mem_grading 1 j⟩
  · exact ⟨j, mixedH_mem_grading 2 j⟩
  · exact ⟨j, mixedG1prime_mem_grading j⟩
  · exact ⟨j, mixedG2prime_mem_grading j⟩

/-- A polynomial of negative weighted degree vanishes. -/
theorem mixedPolyGrading_neg_eq_zero (d : ℤ) (hd : d < 0) (p : MixedPoly)
    (hp : p ∈ mixedPolyGrading d) : p = 0 := by
  ext m
  rw [MvPolynomial.coeff_zero]
  by_contra hm
  have hw := hp hm
  have hnn : 0 ≤ Finsupp.weight mixedPolyWeight m := by
    rw [Finsupp.weight_apply, Finsupp.sum]
    apply Finset.sum_nonneg
    intro x _
    apply nsmul_nonneg
    simp only [mixedPolyWeight]
    omega
  omega

/-! ### Lifts of the ring kernel -/

/-- The lift to the mixed polynomial ring of the power sum `p_s` of the `i`-th alphabet. -/
def adjointSiteKernelLift (q : MixedParams) (i : Fin 5) (s : ℕ) : MixedPoly :=
  powerSumOfCoeff (mixedLengths q i) (fun n => (-1) ^ n * mixedE i n) s

theorem adjointSiteKernelLift_mem_grading (q : MixedParams) (i : Fin 5) (s : ℕ) :
    adjointSiteKernelLift q i s ∈ mixedPolyGrading s :=
  powerSumOfCoeff_mem_graded mixedPolyGrading _ _
    (signed_mem_grading _ (mixedE_mem_grading i)) s

theorem mixedEvaluation_adjointSiteKernelLift (q : MixedParams) (i : Fin 5) (s : ℕ) :
    mixedEvaluation q (adjointSiteKernelLift q i s) =
      mixedAlphabetPowerSum (mixedEvaluation q) i (mixedLengths q i) s := by
  rw [adjointSiteKernelLift, powerSumOfCoeff_map, mixedAlphabetPowerSum]
  congr 1

/-- The six families of power sums whose span is the ring kernel `I_J(h)`. -/
def AdjointSiteKernelActive (q : MixedParams) (h : ℕ) (i : Fin 5) (L : ℕ) : Prop :=
  (i = 1 ∧ L = h + 1) ∨ (i = 3 ∧ L = h + 1) ∨ (i = 4 ∧ L = h + 1) ∨ (i = 1 ∧ L = h) ∨
    (q.d1 = 0 ∧ i = 3 ∧ L = h) ∨ (q.d3 = 1 ∧ i = 4 ∧ L = h)

/-- The homogeneous generators of the kernel of `MixedPoly → R / I_J(h)`. -/
def adjointSiteKernelGenerators (q : MixedParams) (h : ℕ) : Set MixedPoly :=
  mixedRelations q ∪ {f | ∃ (i : Fin 5) (L s : ℕ), AdjointSiteKernelActive q h i L ∧ L ≤ s ∧
    adjointSiteKernelLift q i s = f}

theorem adjointSiteKernelGenerators_homogeneous (q : MixedParams) (h : ℕ) (f : MixedPoly)
    (hf : f ∈ adjointSiteKernelGenerators q h) : ∃ d : ℤ, f ∈ mixedPolyGrading d := by
  rcases hf with hf | ⟨i, L, s, _, _, rfl⟩
  · exact mixedRelations_homogeneous q f hf
  · exact ⟨s, adjointSiteKernelLift_mem_grading q i s⟩

/-- An active tail ideal lies in the ring kernel. -/
theorem mixedAlphabetModeTailIdeal_le_adjointSiteKernelIdeal (q : MixedParams) (h : ℕ)
    (i : Fin 5) (L : ℕ) (hact : AdjointSiteKernelActive q h i L) :
    mixedAlphabetModeTailIdeal q i L ≤ adjointSiteKernelIdeal q h := by
  unfold adjointSiteKernelIdeal
  rcases hact with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨hd, rfl, rfl⟩ |
      ⟨hd, rfl, rfl⟩
  · exact le_sup_left.trans (le_sup_left.trans (le_sup_left.trans (le_sup_left.trans
      le_sup_left)))
  · exact le_sup_right.trans (le_sup_left.trans (le_sup_left.trans (le_sup_left.trans
      le_sup_left)))
  · exact le_sup_right.trans (le_sup_left.trans (le_sup_left.trans le_sup_left))
  · exact le_sup_right.trans (le_sup_left.trans le_sup_left)
  · rw [if_pos hd]
    exact le_sup_right.trans le_sup_left
  · rw [if_pos hd]
    exact le_sup_right

/-- The ring kernel is the image of the span of the active lifts. -/
theorem adjointSiteKernelIdeal_le_map (q : MixedParams) (h : ℕ) :
    adjointSiteKernelIdeal q h ≤ Ideal.map (mixedEvaluation q)
      (Ideal.span {f | ∃ (i : Fin 5) (L s : ℕ), AdjointSiteKernelActive q h i L ∧ L ≤ s ∧
        adjointSiteKernelLift q i s = f}) := by
  have hpiece (i : Fin 5) (L : ℕ) (hact : AdjointSiteKernelActive q h i L) :
      mixedAlphabetModeTailIdeal q i L ≤ Ideal.map (mixedEvaluation q)
        (Ideal.span {f | ∃ (i : Fin 5) (L s : ℕ), AdjointSiteKernelActive q h i L ∧ L ≤ s ∧
          adjointSiteKernelLift q i s = f}) := by
    apply Ideal.span_le.mpr
    rintro a ⟨s, hs, rfl⟩
    rw [← mixedEvaluation_adjointSiteKernelLift]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, L, s, hact, hs, rfl⟩)
  unfold adjointSiteKernelIdeal
  refine sup_le (sup_le (sup_le (sup_le (sup_le ?_ ?_) ?_) ?_) ?_) ?_
  · exact hpiece 1 (h + 1) (Or.inl ⟨rfl, rfl⟩)
  · exact hpiece 3 (h + 1) (Or.inr (Or.inl ⟨rfl, rfl⟩))
  · exact hpiece 4 (h + 1) (Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩)))
  · exact hpiece 1 h (Or.inr (Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))))
  · split_ifs with hd
    · exact hpiece 3 h (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hd, rfl, rfl⟩)))))
    · exact bot_le
  · split_ifs with hd
    · exact hpiece 4 h (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr ⟨hd, rfl, rfl⟩)))))
    · exact bot_le

/-- The evaluation into the one-adjoint-site coefficient ring. -/
abbrev adjointSiteEvaluation (q : MixedParams) (h : ℕ) :
    MixedPoly →ₐ[ℂ] AdjointSiteCoefficientRing q h :=
  mixedStateEvaluation q (adjointSiteKernelIdeal q h)

theorem adjointSiteEvaluation_surjective (q : MixedParams) (h : ℕ) :
    Function.Surjective (adjointSiteEvaluation q h) :=
  mixedStateEvaluation_surjective q _

/-- For a valid block the kernel of the evaluation is generated by homogeneous polynomials. -/
theorem adjointSiteEvaluation_eq_zero_iff (q : MixedParams) (hq : MixedValid q) (h : ℕ)
    (p : MixedPoly) :
    adjointSiteEvaluation q h p = 0 ↔ p ∈ Ideal.span (adjointSiteKernelGenerators q h) := by
  constructor
  · intro hp
    have hK : mixedEvaluation q p ∈ adjointSiteKernelIdeal q h :=
      Ideal.Quotient.eq_zero_iff_mem.mp hp
    obtain ⟨x, hx, hxp⟩ := (Ideal.mem_map_iff_of_surjective (mixedEvaluation q)
      (Ideal.Quotient.mkₐ_surjective ℂ (mixedIdeal q))).mp (adjointSiteKernelIdeal_le_map q h hK)
    have hdiff : p - x ∈ mixedIdeal q := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      change mixedEvaluation q (p - x) = 0
      rw [map_sub, hxp, sub_self]
    have hdiff' : p - x ∈ Ideal.span (adjointSiteKernelGenerators q h) := by
      rw [mixedIdeal, if_pos hq] at hdiff
      exact Ideal.span_mono Set.subset_union_left hdiff
    have hx' : x ∈ Ideal.span (adjointSiteKernelGenerators q h) :=
      Ideal.span_mono Set.subset_union_right hx
    have := Ideal.add_mem _ hx' hdiff'
    rwa [add_sub_cancel] at this
  · intro hp
    have hle : Ideal.span (adjointSiteKernelGenerators q h) ≤
        RingHom.ker (adjointSiteEvaluation q h) := by
      apply Ideal.span_le.mpr
      rintro f (hf | ⟨i, L, s, hact, hs, rfl⟩)
      · exact mixedStateEvaluation_relation q hq _ f hf
      · change Ideal.Quotient.mk _ (mixedEvaluation q (adjointSiteKernelLift q i s)) = 0
        rw [mixedEvaluation_adjointSiteKernelLift]
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        apply mixedAlphabetModeTailIdeal_le_adjointSiteKernelIdeal q h i L hact
        exact Ideal.subset_span ⟨s, hs, rfl⟩
    exact hle hp

/-- The kernel of the evaluation contains the homogeneous components of its elements. -/
theorem adjointSiteEvaluation_component_eq_zero (q : MixedParams) (h : ℕ) (d : ℤ)
    (p : MixedPoly) (hp : adjointSiteEvaluation q h p = 0) :
    adjointSiteEvaluation q h (MvPolynomial.weightedHomogeneousComponent mixedPolyWeight d p) =
      0 := by
  by_cases hq : MixedValid q
  · rw [adjointSiteEvaluation_eq_zero_iff q hq] at hp ⊢
    choose deg hdeg using fun f : adjointSiteKernelGenerators q h =>
      adjointSiteKernelGenerators_homogeneous q h f.val f.property
    have hspan : Ideal.span (Set.range (fun f : adjointSiteKernelGenerators q h => f.val)) =
        Ideal.span (adjointSiteKernelGenerators q h) := by
      rw [Subtype.range_coe]
    rw [← hspan] at hp ⊢
    exact homogeneous_span_component_mem mixedPolyWeight _ deg hdeg p hp d
  · haveI := mixedRing_invalid q hq
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective
      (adjointSiteEvaluation q h (MvPolynomial.weightedHomogeneousComponent mixedPolyWeight d p))
    rw [← hx, Subsingleton.elim x 0, map_zero]

/-! ### The grading of the coefficient ring -/

/-- The degree pieces of `A = R / I_J(h)`: images of the weighted homogeneous pieces. -/
def adjointSiteGrading (q : MixedParams) (h : ℕ) :
    ℤ → Submodule ℂ (AdjointSiteCoefficientRing q h) :=
  fun d => (mixedPolyGrading d).map (adjointSiteEvaluation q h).toLinearMap

theorem adjointSiteEvaluation_mem_grading (q : MixedParams) (h : ℕ) {d : ℤ} {p : MixedPoly}
    (hp : p ∈ mixedPolyGrading d) : adjointSiteEvaluation q h p ∈ adjointSiteGrading q h d :=
  ⟨p, hp, rfl⟩

theorem adjointSiteGrading_gradedMonoid (q : MixedParams) (h : ℕ) :
    SetLike.GradedMonoid (adjointSiteGrading q h) where
  one_mem := ⟨1, SetLike.one_mem_graded mixedPolyGrading, map_one (adjointSiteEvaluation q h)⟩
  mul_mem := by
    rintro i j _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
    exact ⟨a * b, SetLike.mul_mem_graded ha hb, map_mul (adjointSiteEvaluation q h) a b⟩

/-- The degree-`d` component map of the coefficient ring. -/
def adjointSiteComponent (q : MixedParams) (h : ℕ) (d : ℤ) :
    AdjointSiteCoefficientRing q h →ₗ[ℂ] AdjointSiteCoefficientRing q h :=
  ((LinearMap.ker (adjointSiteEvaluation q h).toLinearMap).liftQ
      ((adjointSiteEvaluation q h).toLinearMap ∘ₗ
        MvPolynomial.weightedHomogeneousComponent mixedPolyWeight d)
      (fun p hp => by
        rw [LinearMap.mem_ker] at hp ⊢
        exact adjointSiteEvaluation_component_eq_zero q h d p hp)) ∘ₗ
    ((adjointSiteEvaluation q h).toLinearMap.quotKerEquivOfSurjective
      (adjointSiteEvaluation_surjective q h)).symm.toLinearMap

theorem adjointSiteComponent_apply (q : MixedParams) (h : ℕ) (d : ℤ) (p : MixedPoly) :
    adjointSiteComponent q h d (adjointSiteEvaluation q h p) =
      adjointSiteEvaluation q h
        (MvPolynomial.weightedHomogeneousComponent mixedPolyWeight d p) := by
  have hs : ((adjointSiteEvaluation q h).toLinearMap.quotKerEquivOfSurjective
      (adjointSiteEvaluation_surjective q h)).symm (adjointSiteEvaluation q h p) =
        Submodule.Quotient.mk p := by
    rw [LinearEquiv.symm_apply_eq]
    rfl
  simp only [adjointSiteComponent, LinearMap.coe_comp, LinearEquiv.coe_coe,
    Function.comp_apply]
  rw [hs, Submodule.liftQ_apply]
  rfl

theorem adjointSiteGrading_isInternal (q : MixedParams) (h : ℕ) :
    DirectSum.IsInternal (adjointSiteGrading q h) := by
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  · rw [iSupIndep_def]
    intro i
    rw [Submodule.disjoint_def]
    intro x hx hx'
    have hker : (⨆ (j : ℤ) (_ : j ≠ i), adjointSiteGrading q h j) ≤
        LinearMap.ker (adjointSiteComponent q h i) := by
      apply iSup₂_le
      rintro j hj _ ⟨b, hb, rfl⟩
      rw [LinearMap.mem_ker]
      change adjointSiteComponent q h i (adjointSiteEvaluation q h b) = 0
      rw [adjointSiteComponent_apply,
        MvPolynomial.IsWeightedHomogeneous.weightedHomogeneousComponent_ne i hb (Ne.symm hj),
        map_zero]
    have h0 := hker hx'
    rw [LinearMap.mem_ker] at h0
    obtain ⟨a, ha, rfl⟩ := hx
    change adjointSiteComponent q h i (adjointSiteEvaluation q h a) = 0 at h0
    rw [adjointSiteComponent_apply,
      MvPolynomial.IsWeightedHomogeneous.weightedHomogeneousComponent_same ha] at h0
    exact h0
  · rw [eq_top_iff]
    rintro y -
    obtain ⟨p, rfl⟩ := adjointSiteEvaluation_surjective q h y
    induction p using MvPolynomial.induction_on' with
    | monomial u a =>
        apply Submodule.mem_iSup_of_mem (Finsupp.weight mixedPolyWeight u)
        exact adjointSiteEvaluation_mem_grading q h
          (MvPolynomial.isWeightedHomogeneous_monomial mixedPolyWeight u a rfl)
    | add p p' hp hp' =>
        rw [map_add]
        exact Submodule.add_mem _ hp hp'

/-- The grading of the one-adjoint-site coefficient ring. -/
@[reducible] def adjointSiteGradedAlgebra (q : MixedParams) (h : ℕ) :
    GradedAlgebra (adjointSiteGrading q h) :=
  { adjointSiteGrading_gradedMonoid q h,
    (adjointSiteGrading_isInternal q h).chooseDecomposition with }

theorem adjointSiteGrading_neg (q : MixedParams) (h : ℕ) (d : ℤ) (hd : d < 0) :
    adjointSiteGrading q h d = ⊥ := by
  rw [eq_bot_iff]
  rintro _ ⟨p, hp, rfl⟩
  rw [mixedPolyGrading_neg_eq_zero d hd p hp, map_zero]
  exact Submodule.zero_mem _

/-! ### Finite dimensionality -/

/-- In a valid block ring every positive elementary generator of every alphabet is
nilpotent. -/
theorem mixedEvaluation_elementary_isNilpotent (q : MixedParams) (hq : MixedValid q)
    (i : Fin 5) (j : ℕ) (hj : 1 ≤ j) : IsNilpotent (mixedEvaluation q (mixedE i j)) := by
  by_cases htail : mixedLengths q i < j
  · rw [mixedElementary_tail q hq i j htail]
    exact IsNilpotent.zero
  have hcoeff (d : ℕ) (f : ℕ → MixedRing q) (hu : IsUnit (coefficientPoly f d)) (hjd : j ≤ d)
      (hf : f j = (-1) ^ j * mixedEvaluation q (mixedE i j)) :
      IsNilpotent (mixedEvaluation q (mixedE i j)) := by
    have hn := (Polynomial.isUnit_iff_coeff_isUnit_isNilpotent.mp hu).2 j (by omega)
    rw [coefficientPoly_coeff, if_pos hjd, hf] at hn
    have hm := (Commute.all ((-1 : MixedRing q) ^ j) _).isNilpotent_mul_left hn
    rwa [← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_mul] at hm
  have hv := hq
  simp only [MixedValid, mixedP, mixedQ] at hv
  have hjl : j ≤ mixedLengths q i := not_lt.mp htail
  fin_cases i
  · have hjl' : j ≤ (mixedBaseLength q 0).toNat := by
      simpa [mixedLengths, mixedBaseLength] using hjl
    exact hcoeff _ _ (mixedBase_series_units q hq 0).1 hjl' rfl
  · have hjl' : j ≤ (mixedBaseLength q 1).toNat := by
      simpa [mixedLengths, mixedBaseLength] using hjl
    exact hcoeff _ _ (mixedBase_series_units q hq 1).1 hjl' rfl
  · have hjl' : j ≤ (mixedBaseLength q 2).toNat := by
      simpa [mixedLengths, mixedBaseLength] using hjl
    exact hcoeff _ _ (mixedBase_series_units q hq 2).1 hjl' rfl
  · have hjl' : j ≤ q.e1.toNat := by simpa [mixedLengths] using hjl
    exact hcoeff _ _ (mixedRelative_series_units q hq).1 hjl' rfl
  · have hlen : q.e2.toNat + (mixedQ q - q.e2).toNat =
        q.d2.toNat + (q.A - q.d3).toNat := by simp only [mixedQ]; omega
    have ht := coefficient_product_of_descending _ _ _ _ _ _ _ _ hlen
      (mixedSecond_relative_factorization q hq)
    have hu := (mixedBase_series_units q hq 1).1.mul (mixedBase_series_units q hq 2).2
    have h2 : IsUnit (coefficientPoly (fun j => (-1) ^ j * mixedEvaluation q (mixedE 4 j))
        q.e2.toNat * coefficientPoly (fun j => (-1) ^ j * mixedEvaluation q (mixedG2prime j))
          (mixedQ q - q.e2).toNat) := by
      rw [ht]
      exact hu
    have hjl' : j ≤ q.e2.toNat := by simpa [mixedLengths] using hjl
    exact hcoeff _ _ (isUnit_of_mul_isUnit_left h2) hjl' rfl

/-- A valid block ring is finite dimensional. -/
theorem mixedRing_finiteDimensional (q : MixedParams) (hq : MixedValid q) :
    FiniteDimensional ℂ (MixedRing q) := by
  let S : Set (MixedRing q) := ⋃ i : Fin 5,
    (fun n => mixedEvaluation q (MvPolynomial.X (i, n))) '' Set.Iio (mixedLengths q i)
  have hfin : S.Finite := Set.finite_iUnion fun i => (Set.finite_Iio _).image _
  have hX (i : Fin 5) (n : ℕ) : MvPolynomial.X (i, n) = mixedE i (n + 1) := by
    simp only [mixedE, mixedAlphabet, elementary_succ, MvPolynomial.rename_X]
  have hint : ∀ x ∈ S, IsIntegral ℂ x := by
    intro x hx
    obtain ⟨i, n, -, rfl⟩ : ∃ i n, n < mixedLengths q i ∧
        mixedEvaluation q (MvPolynomial.X (i, n)) = x := by
      obtain ⟨_, ⟨i, rfl⟩, hx⟩ := hx
      obtain ⟨n, hn, rfl⟩ := hx
      exact ⟨i, n, hn, rfl⟩
    obtain ⟨k, hk⟩ := mixedEvaluation_elementary_isNilpotent q hq i (n + 1) (by omega)
    rw [← hX] at hk
    exact ⟨X ^ k, monic_X_pow k, by rw [eval₂_X_pow, hk]⟩
  have hadj : Algebra.adjoin ℂ S = ⊤ := by
    rw [eq_top_iff]
    rintro y -
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective ℂ (mixedIdeal q) y
    change mixedEvaluation q p ∈ Algebra.adjoin ℂ S
    induction p using MvPolynomial.induction_on with
    | C a =>
        have h := (mixedEvaluation q).commutes a
        rw [MvPolynomial.algebraMap_eq] at h
        rw [h]
        exact Subalgebra.algebraMap_mem _ a
    | add p p' hp hp' =>
        rw [map_add]
        exact Subalgebra.add_mem _ hp hp'
    | mul_X p x hp =>
        rw [map_mul]
        apply Subalgebra.mul_mem _ hp
        obtain ⟨i, n⟩ := x
        by_cases hn : n < mixedLengths q i
        · exact Algebra.subset_adjoin (Set.mem_iUnion.mpr ⟨i, n, hn, rfl⟩)
        · rw [hX, mixedElementary_tail q hq i (n + 1) (by omega)]
          exact Subalgebra.zero_mem _
  have hfg := fg_adjoin_of_finite hfin hint
  rw [hadj, Algebra.top_toSubmodule] at hfg
  exact ⟨hfg⟩

/-- The one-adjoint-site coefficient ring of a valid block is finite dimensional. -/
theorem adjointSiteCoefficientRing_finiteDimensional (q : MixedParams) (hq : MixedValid q)
    (h : ℕ) : FiniteDimensional ℂ (AdjointSiteCoefficientRing q h) := by
  haveI := mixedRing_finiteDimensional q hq
  exact Module.Finite.of_surjective
    (Ideal.Quotient.mkₐ ℂ (adjointSiteKernelIdeal q h)).toLinearMap
    (Ideal.Quotient.mkₐ_surjective ℂ _)

/-! ### Homogeneity of the characteristic polynomial, the power sums and the joint symbol -/

section Abstract

variable {A : Type*} [CommRing A] [Algebra ℂ A] {𝒜 : ℤ → Submodule ℂ A} [GradedAlgebra 𝒜]

/-- A descending polynomial with graded coefficients is homogeneous. -/
theorem descendingPoly_polynomialHomogeneous (F : ℕ → A) (hF : ∀ i : ℕ, F i ∈ 𝒜 i) (d : ℕ) :
    PolynomialHomogeneous 𝒜 d (descendingPoly F d) := by
  rw [descendingPoly_eq_sum]
  apply polynomialHomogeneous_sum
  intro i hi
  have hi' := Finset.mem_range.mp hi
  exact ((polynomialHomogeneous_C (hF i)).mul (polynomialHomogeneous_X_pow (d - i))).of_eq
    (by push_cast [Nat.cast_sub (show i ≤ d by omega)]; ring)

end Abstract

/-- A descending polynomial with leading coefficient `1` is monic of its length. -/
theorem descendingPoly_monic_natDegree {R : Type*} [CommRing R] [Nontrivial R] (F : ℕ → R)
    (hF : F 0 = 1) (d : ℕ) :
    (descendingPoly F d).Monic ∧ (descendingPoly F d).natDegree = d := by
  have hcoeff (l : ℕ) : (descendingPoly F d).coeff l = if l ≤ d then F (d - l) else 0 := by
    rw [descendingPoly_eq_sum, finsetSum_coeff]
    simp only [coeff_C_mul, coeff_X_pow]
    split_ifs with hl
    · rw [Finset.sum_eq_single (d - l)]
      · rw [if_pos (by omega)]
        ring
      · intro i hi hne
        rw [if_neg (by have := Finset.mem_range.mp hi; omega), mul_zero]
      · intro hn
        exact absurd (Finset.mem_range.mpr (by omega)) hn
    · apply Finset.sum_eq_zero
      intro i hi
      rw [if_neg (by have := Finset.mem_range.mp hi; omega), mul_zero]
  have hle : (descendingPoly F d).natDegree ≤ d := by
    apply natDegree_le_iff_coeff_eq_zero.mpr
    intro l hl
    rw [hcoeff, if_neg (by
      have : d < l := by exact_mod_cast hl
      omega)]
  have htop : (descendingPoly F d).coeff d = 1 := by rw [hcoeff, if_pos le_rfl, Nat.sub_self, hF]
  exact ⟨monic_of_natDegree_le_of_coeff_eq_one d hle htop,
    natDegree_eq_of_le_of_coeff_ne_zero hle (by rw [htop]; exact one_ne_zero)⟩

theorem adjointSiteCharacteristic_eq (q : MixedParams) (h : ℕ) :
    adjointSiteCharacteristic q h =
      descendingPoly (fun i => adjointSiteEvaluation q h ((-1) ^ i * mixedE 3 i)) q.e1.toNat *
        descendingPoly (fun i => adjointSiteEvaluation q h ((-1) ^ i * mixedG2prime i))
          (mixedQ q - q.e2).toNat := by
  rw [adjointSiteCharacteristic, mixedCharacteristic, Polynomial.map_mul, descendingPoly_map,
    descendingPoly_map]
  congr 1

theorem adjointSiteCharacteristic_monic (q : MixedParams) (hq : MixedValid q) (h : ℕ)
    [Nontrivial (AdjointSiteCoefficientRing q h)] :
    (adjointSiteCharacteristic q h).Monic ∧
      (adjointSiteCharacteristic q h).natDegree = (mixedWeight q).toNat := by
  rw [adjointSiteCharacteristic_eq, mixedWeight_length q hq]
  obtain ⟨h₁, h₂⟩ := descendingPoly_monic_natDegree
    (fun i => adjointSiteEvaluation q h ((-1) ^ i * mixedE 3 i))
    (by simp [(mixed_series_zero).1]) q.e1.toNat
  obtain ⟨h₃, h₄⟩ := descendingPoly_monic_natDegree
    (fun i => adjointSiteEvaluation q h ((-1) ^ i * mixedG2prime i))
    (by simp [(mixed_series_zero).2.2.2.2.2]) (mixedQ q - q.e2).toNat
  exact ⟨h₁.mul h₃, by rw [h₁.natDegree_mul h₃, h₂, h₄]⟩

theorem adjointSiteCharacteristic_homogeneous (q : MixedParams) (hq : MixedValid q) (h : ℕ) :
    letI := adjointSiteGradedAlgebra q h
    PolynomialHomogeneous (adjointSiteGrading q h) ((mixedWeight q).toNat : ℤ)
      (adjointSiteCharacteristic q h) := by
  letI := adjointSiteGradedAlgebra q h
  rw [adjointSiteCharacteristic_eq, mixedWeight_length q hq]
  have h₁ := descendingPoly_polynomialHomogeneous (𝒜 := adjointSiteGrading q h)
    (fun i => adjointSiteEvaluation q h ((-1) ^ i * mixedE 3 i))
    (fun i => adjointSiteEvaluation_mem_grading q h
      (signed_mem_grading _ (mixedE_mem_grading 3) i)) q.e1.toNat
  have h₂ := descendingPoly_polynomialHomogeneous (𝒜 := adjointSiteGrading q h)
    (fun i => adjointSiteEvaluation q h ((-1) ^ i * mixedG2prime i))
    (fun i => adjointSiteEvaluation_mem_grading q h
      (signed_mem_grading _ mixedG2prime_mem_grading i)) (mixedQ q - q.e2).toNat
  exact (h₁.mul h₂).of_eq (by push_cast; ring)

/-- The positive power sums of `y` have their own degree in the coefficient ring. -/
theorem adjointSitePowerSum_mem_grading (q : MixedParams) (h : ℕ) (s : ℕ) :
    Ideal.Quotient.mk (adjointSiteKernelIdeal q h) (mixedPowerSum q s) ∈
      adjointSiteGrading q h s := by
  haveI := adjointSiteGrading_gradedMonoid q h
  rw [mixedPowerSum, ← Ideal.Quotient.mkₐ_eq_mk ℂ, powerSumOfCoeff_map]
  apply powerSumOfCoeff_mem_graded
  intro n
  rw [mixedCoefficientSeries, coeff_mul, map_sum]
  apply Submodule.sum_mem
  intro x hx
  have hn := Finset.mem_antidiagonal.mp hx
  rw [coefficientPoly_coeff, coefficientPoly_coeff, map_mul]
  have h₁ : Ideal.Quotient.mkₐ ℂ (adjointSiteKernelIdeal q h)
      (if x.1 ≤ q.e1.toNat then (-1) ^ x.1 * mixedEvaluation q (mixedE 3 x.1) else 0) ∈
        adjointSiteGrading q h x.1 := by
    split_ifs
    · have := adjointSiteEvaluation_mem_grading q h
        (signed_mem_grading _ (mixedE_mem_grading 3) x.1)
      simpa [adjointSiteEvaluation, mixedStateEvaluation] using this
    · rw [map_zero]
      exact Submodule.zero_mem _
  have h₂ : Ideal.Quotient.mkₐ ℂ (adjointSiteKernelIdeal q h)
      (if x.2 ≤ (mixedQ q - q.e2).toNat then
        (-1) ^ x.2 * mixedEvaluation q (mixedG2prime x.2) else 0) ∈
        adjointSiteGrading q h x.2 := by
    split_ifs
    · have := adjointSiteEvaluation_mem_grading q h
        (signed_mem_grading _ mixedG2prime_mem_grading x.2)
      simpa [adjointSiteEvaluation, mixedStateEvaluation] using this
    · rw [map_zero]
      exact Submodule.zero_mem _
  have hm := SetLike.mul_mem_graded h₁ h₂
  rw [← Nat.cast_add, hn] at hm
  exact hm

/-- The joint symbol is homogeneous. -/
theorem adjointSiteJointSymbol_homogeneous (q : MixedParams) (h : ℕ) :
    ∃ e : ℤ, Ideal.Quotient.mk (adjointSiteKernelIdeal q h) (adjointSiteJointSymbol q) ∈
      adjointSiteGrading q h e := by
  have hev (p : MixedPoly) : Ideal.Quotient.mk (adjointSiteKernelIdeal q h)
      (mixedEvaluation q p) = adjointSiteEvaluation q h p := rfl
  unfold adjointSiteJointSymbol
  split_ifs
  · rw [map_one]
    exact ⟨0, ⟨1, SetLike.one_mem_graded mixedPolyGrading, map_one (adjointSiteEvaluation q h)⟩⟩
  · rw [adjointSiteFlatSymbol, hev]
    exact ⟨_, adjointSiteEvaluation_mem_grading q h (mixedG2prime_mem_grading _)⟩
  · rw [adjointSiteMarkedSymbol, hev]
    exact ⟨_, adjointSiteEvaluation_mem_grading q h (mixedE_mem_grading 3 _)⟩
  · rw [map_zero]
    exact ⟨0, Submodule.zero_mem _⟩

end

