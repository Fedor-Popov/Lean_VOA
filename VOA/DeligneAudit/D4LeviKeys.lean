import VOA.DeligneAudit.D4LeviAssembly

/-! Six-letter radical keys for the D4 node-one Levi filtration. -/

namespace VOA.DeligneAudit.D4Levi

open VOA.DeligneAudit.SectorWeyl

/-- Counts of E, X, U, U', Y, Z, followed by total current-mode degree. -/
structure RadicalKey where
  e : ℕ
  x : ℕ
  u : ℕ
  up : ℕ
  y : ℕ
  z : ℕ
  degree : ℕ
  deriving DecidableEq, Repr

/-- The key of a word in the six negative-radical currents. -/
def wordKey (l : List (Fin 6 × ℕ)) : RadicalKey :=
  ⟨l.countP (fun p => p.1 = 0), l.countP (fun p => p.1 = 1),
    l.countP (fun p => p.1 = 2), l.countP (fun p => p.1 = 3),
    l.countP (fun p => p.1 = 4), l.countP (fun p => p.1 = 5),
    (l.map Prod.snd).sum⟩

/-- The three simple-Cartan labels of the sl4 Levi. -/
def keyLabel (m : ℕ) (i : Fin 3) (k : RadicalKey) : ℤ :=
  if i = 0 then (k.x : ℤ) + k.u - k.up - k.y else
  if i = 1 then (m : ℤ) + k.e - k.x + k.y - k.z else
    (k.x : ℤ) - k.u + k.up - k.y

/-- Twice the pairing of the key weight with the sl4 dual Weyl vector. -/
def keyHeight (m : ℕ) (k : RadicalKey) : ℤ :=
  4 * (m : ℤ) + 4 * k.e + 2 * k.x - 2 * k.y - 4 * k.z

theorem keyHeight_eq_labels (m : ℕ) (k : RadicalKey) :
    keyHeight m k =
      3 * keyLabel m 0 k + 4 * keyLabel m 1 k +
        3 * keyLabel m 2 k := by
  simp [keyHeight, keyLabel]
  ring

/-- Lexicographic order by Levi height, degree, then six counts. -/
def keyLess (m : ℕ) (a b : RadicalKey) : Prop :=
  keyHeight m a < keyHeight m b ∨
    keyHeight m a = keyHeight m b ∧
      (a.degree < b.degree ∨ a.degree = b.degree ∧
        (a.e < b.e ∨ a.e = b.e ∧
          (a.x < b.x ∨ a.x = b.x ∧
            (a.u < b.u ∨ a.u = b.u ∧
              (a.up < b.up ∨ a.up = b.up ∧
                (a.y < b.y ∨ a.y = b.y ∧ a.z < b.z))))))

theorem keyLess_irrefl (m : ℕ) (k : RadicalKey) : ¬ keyLess m k k := by
  simp [keyLess]

theorem keyLess_trans (m : ℕ) {a b c : RadicalKey}
    (hab : keyLess m a b) (hbc : keyLess m b c) : keyLess m a c := by
  rcases a with ⟨ae, ax, au, ap, ay, az, ad⟩
  rcases b with ⟨be, bx, bu, bp, b_y, bz, bd⟩
  rcases c with ⟨ce, cx, cu, cp, cy, cz, cd⟩
  dsimp [keyLess, keyHeight] at *
  omega

theorem keyLess_trichotomy (m : ℕ) (a b : RadicalKey) :
    keyLess m a b ∨ a = b ∨ keyLess m b a := by
  rcases a with ⟨ae, ax, au, ap, ay, az, ad⟩
  rcases b with ⟨be, bx, bu, bp, b_y, bz, bd⟩
  dsimp [keyLess, keyHeight]
  simp only [RadicalKey.mk.injEq]
  omega

theorem keyLess_degree (m : ℕ) (k : RadicalKey) (r : ℕ) (hr : 0 < r) :
    keyLess m k { k with degree := k.degree + r } := by
  simp [keyLess, keyHeight]
  omega

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule VOA.DeligneAudit.DeligneSector.D4.fD4 V) (w : V)

/-- A word in the six negative-radical currents, applied to the source vector. -/
noncomputable def radicalWord (l : List (Fin 6 × ℕ)) : V :=
  wordOp ρ (l.map fun p => (radicalColour p.1, p.2)) w

/-- The vector space generated by radical words of one exact key. -/
def keyLayer (k : RadicalKey) : Submodule ℂ V :=
  Submodule.span ℂ {v | ∃ l : List (Fin 6 × ℕ), wordKey l = k ∧
    v = radicalWord ρ w l}

theorem radicalWord_mem_key (l : List (Fin 6 × ℕ)) :
    radicalWord ρ w l ∈ keyLayer ρ w (wordKey l) :=
  Submodule.subset_span ⟨l, rfl, rfl⟩

end VOA.DeligneAudit.D4Levi

