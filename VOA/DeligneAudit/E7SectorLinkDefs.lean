import VOA.DeligneAudit.E7LieTable
import VOA.DeligneAudit.E7SectorIntegerTable

/-! Integer row and weight comparison predicates for the E7 sector checks.
The original definitions and literal weight table are preserved unchanged. -/
namespace VOA.DeligneAudit.DeligneCarrier.E7
open VOA.AffineGeneral.SCLie
set_option linter.style.longLine false

/-- Row `a` of `e7T` agrees with `E7Lie.sL`. -/
def rowLinkOK (a : ℕ) : Bool :=
  (List.finRange 133).all fun b => entry e7T a b == (E7Lie.sL ⟨a % 133, Nat.mod_lt _ (by decide)⟩ b).map fun t => (t.1.val, t.2)

