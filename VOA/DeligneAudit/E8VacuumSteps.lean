/-- The step of relation `s`. -/
def stepOf (s : ℕ) : ℕ × ℕ × ℤ := (stepRows.getD (s / 250) []).getD (s % 250) (0, 0, 0)

/-- Row `i` of the cert structure constants of `x_f`, with natural indices. -/
def sLn (f i : ℕ) : List (ℕ × ℤ) :=
  ((E8Lie.sLRows.getD f []).getD i []).map fun t => (t.1.val, t.2)

/-- The derivation `ad x_f` on a sparse quadratic list. -/
def dQuad (f : ℕ) (P : List (ℕ × ℕ × ℤ)) : List (ℕ × ℕ × ℤ) :=
  P.flatMap fun t =>
    (sLn f t.1).map (fun kv => (kv.1, t.2.1, t.2.2 * kv.2)) ++
      (sLn f t.2.1).map (fun kv => (t.1, kv.1, t.2.2 * kv.2))

/-- The step identity `ad x_f (P_p) - g · P_s = 0`, as a cubic check after multiplying by `X_0`. -/
def stepList (s : ℕ) : List (ℕ × ℕ × ℤ) :=
  dQuad (stepOf s).2.1 (relQ (stepOf s).1) ++
    (relQ s).map fun x => (x.1, x.2.1, -((stepOf s).2.2 * x.2.2))

/-- The check of step `s`. -/
def stepOK (s : ℕ) : Bool :=
  decide ((stepOf s).1 < s) && decide ((stepOf s).2.1 < 248) && decide ((stepOf s).2.2 ≠ 0) &&
    cubicZero (mulX 1 0 (stepList s))

