import VOA.DeligneAudit.A2SectorWeyl

/-!
# The fibre of the current carrier as a current-algebra module

Let `W = W_m` be the current carrier, `B₊ W` the span of `s • y` with `s` a symmetric polynomial
of positive degree and `y ∈ W` (`augT`).  The loop operators preserve `W` and `B₊ W`, so the
fibre `V = W / B₊ W` is a `CurrentModule` (`fiberRep`), generated by the class `w` of the constant
vector `δ_{c₀}`.

If the carrier is generated by `δ_{c₀}` (step B8, `W ⊆ M`), the Nakayama fibre dimension of `W`
in degree `b` is at most the dimension of the degree-`b` loop span of `w` (`fiberDim_le_cycDeg`).
-/

namespace VOA.DeligneAudit.SectorFiberModule

open MvPolynomial VOA.DeligneAuxiliaryCollision VOA.QuadraticCurrentFunctionalCarrier
open VOA.DeligneAudit.SectorLoop VOA.DeligneAudit.SectorGraded VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.SectorFiber VOA.DeligneAudit.SectorNakayama

noncomputable section

variable {K σ ρ : Type*} [Field K] [CharZero K] [Fintype σ] [DecidableEq σ]
  (f : σ → σ → σ → K) (Q : ρ → σ × σ → K) [Fintype ρ] (m : ℕ)

/-- `B₊ W`: symmetric polynomials of positive degree times carrier vectors. -/
def augT : Submodule K (TensorPolynomial (K := K) (σ := σ) m 0) :=
  Submodule.span K {z | ∃ n, 1 ≤ n ∧ ∃ s ∈ symDeg (K := K) m n, ∃ y ∈ currentCarrier Q m 0,
    z = s • y}

theorem smul_apply_sym (s : SymAlg (K := K) m) (y : TensorPolynomial (K := K) (σ := σ) m 0)
    (t : Fin m → σ) : (s • y) t = s.1 * y t := rfl

theorem augT_le : augT Q m ≤ currentCarrier (K := K) Q m 0 := by
  rw [augT, Submodule.span_le]
  rintro _ ⟨n, _, s, _, y, hy, rfl⟩
  exact mul_mem_currentCarrier Q m s.1 s.2 hy

theorem loopOp_smul (x : σ) (r : ℕ) (s : SymAlg (K := K) m)
    (y : TensorPolynomial (K := K) (σ := σ) m 0) :
    loopOp f m x r (s • y) = s • loopOp f m x r y := by
  funext t
  simp only [loopOp, LinearMap.coe_mk, AddHom.coe_mk, smul_apply_sym, Finset.mul_sum, mul_neg]
  congr 1
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun c _ => ?_
  ring

theorem loopOp_mem_augT (hQ : RelationsStable f Q) (x : σ) (r : ℕ)
    {z : TensorPolynomial (K := K) (σ := σ) m 0} (hz : z ∈ augT Q m) :
    loopOp f m x r z ∈ augT Q m := by
  induction hz using Submodule.span_induction with
  | mem v hv =>
      obtain ⟨n, hn, s, hs, y, hy, rfl⟩ := hv
      rw [loopOp_smul]
      exact Submodule.subset_span ⟨n, hn, s, hs, _, loopOp_mem f hQ hy x r, rfl⟩
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha

/-- The carrier as a type. -/
abbrev Wc := currentCarrier (K := K) Q m 0

/-- `B₊ W` inside `W`. -/
def augW : Submodule K (Wc Q m) := (augT Q m).comap (Wc Q m).subtype

/-- The fibre `W / B₊ W`. -/
abbrev Fib := Wc Q m ⧸ augW Q m

variable {Q}

/-- The loop operators restricted to the carrier. -/
def opW (hQ : RelationsStable f Q) (x : σ) (r : ℕ) : Wc Q m →ₗ[K] Wc Q m :=
  (loopOp f m x r).restrict fun _ hp => loopOp_mem f hQ hp x r

/-- The loop operators on the fibre. -/
def opF (hQ : RelationsStable f Q) (x : σ) (r : ℕ) : Fib Q m →ₗ[K] Fib Q m :=
  (augW Q m).mapQ (augW Q m) (opW f m hQ x r) fun _z hz => loopOp_mem_augT f Q m hQ x r hz

theorem opF_mk (hQ : RelationsStable f Q) (x : σ) (r : ℕ) (y : Wc Q m) :
    opF f m hQ x r (Submodule.Quotient.mk y) =
      Submodule.Quotient.mk ⟨loopOp f m x r y.1, loopOp_mem f hQ y.2 x r⟩ := rfl

/-- **The fibre is a current-algebra module.** -/
def fiberRep (hQ : RelationsStable f Q) (hJ : JacobiCoord f) : CurrentModule f (Fib Q m) where
  op := opF f m hQ
  comm a b r s v := by
    induction v using Submodule.Quotient.induction_on with
    | H y =>
        simp only [opF_mk]
        rw [← Submodule.Quotient.mk_sub]
        have h := loopOp_comm f hJ m a b r s y.1
        have hsum : ∀ (S : Finset σ), (∑ e ∈ S, f a b e • (Submodule.Quotient.mk
            ⟨loopOp f m e (r + s) y.1, loopOp_mem f hQ y.2 e (r + s)⟩ : Fib Q m)) =
            Submodule.Quotient.mk ⟨∑ e ∈ S, f a b e • loopOp f m e (r + s) y.1,
              Submodule.sum_mem _ fun e _ => Submodule.smul_mem _ _
                (loopOp_mem f hQ y.2 e (r + s))⟩ := by
          intro S
          induction S using Finset.induction_on with
          | empty => simp; rfl
          | insert e S he ih =>
              rw [Finset.sum_insert he, ih, ← Submodule.Quotient.mk_smul,
                ← Submodule.Quotient.mk_add]
              congr 1
              apply Subtype.ext
              simp [Finset.sum_insert he]
        rw [hsum]
        congr 1
        apply Subtype.ext
        simpa using h

/-! ## Degrees -/

variable (Q) in
theorem carrierDeg_le (b : ℕ) : carrierDeg Q m b ≤ currentCarrier (K := K) Q m 0 := by
  rintro _ ⟨y, _, rfl⟩
  exact y.2

variable (Q) in
theorem mem_carrierDeg {x : TensorPolynomial (K := K) (σ := σ) m 0} {b : ℕ}
    (hx : x ∈ currentCarrier Q m 0) (hb : IsHomT b x) : x ∈ carrierDeg Q m b :=
  ⟨⟨x, hx⟩, fun t => hb t, rfl⟩

theorem isHomT_of_mem_carrierDeg {x : TensorPolynomial (K := K) (σ := σ) m 0} {b : ℕ}
    (hx : x ∈ carrierDeg Q m b) : IsHomT b x := by
  obtain ⟨y, hy, rfl⟩ := hx
  exact fun t => hy t

theorem projT_smul_sym {n : ℕ} {s : SymAlg (K := K) m} (hs : s ∈ symDeg (K := K) m n) (b : ℕ)
    (y : TensorPolynomial (K := K) (σ := σ) m 0) :
    projT b (s • y) = if n ≤ b then s • projT (b - n) y else 0 := by
  have hsh : s.1.IsHomogeneous n := (mem_homogeneousSubmodule _ _).mp hs
  funext t
  have h := homogeneousComponent_map_shift (LinearMap.mulLeft K s.1) n
    (fun c P hP => by have := hsh.mul hP; rwa [Nat.add_comm n c] at this) b (y t)
  change homogeneousComponent b (s.1 * y t) = _
  rw [show s.1 * y t = LinearMap.mulLeft K s.1 (y t) from rfl, h]
  split_ifs <;> rfl

/-- **`B₊ W` is graded by the Nakayama `plus` pieces.** -/
theorem projT_mem_plus {z : TensorPolynomial (K := K) (σ := σ) m 0} (hz : z ∈ augT Q m)
    (b : ℕ) : projT b z ∈ plus (symDeg (K := K) m) (carrierDeg Q m) b := by
  induction hz using Submodule.span_induction with
  | mem v hv =>
      obtain ⟨n, hn, s, hs, y, hy, rfl⟩ := hv
      rw [projT_smul_sym m hs]
      split_ifs with hnb
      · exact Submodule.subset_span ⟨n, hn, hnb, s, hs, _,
          mem_carrierDeg Q m (SectorGraded.projT_mem_carrier hy _) (isHomT_projT _ _), rfl⟩
      · exact Submodule.zero_mem _
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a c _ _ ha hc => rw [map_add]; exact Submodule.add_mem _ ha hc
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha

theorem plus_le_augT (b : ℕ) : plus (symDeg (K := K) m) (carrierDeg Q m) b ≤ augT Q m := by
  rw [plus, Submodule.span_le]
  rintro _ ⟨n, hn, _, r, hr, y, hy, rfl⟩
  exact Submodule.subset_span ⟨n, hn, r, hr, y, carrierDeg_le Q m _ hy, rfl⟩

/-! ## The generating vector and the fibre dimension -/

section Gen

variable (hQ : RelationsStable f Q) (hJ : JacobiCoord f) (c₀ : σ) (hdiag : ∀ r, Q r (c₀, c₀) = 0)

include hQ hdiag in
theorem applyWord_mem (l : List (σ × ℕ)) :
    applyWord f m l (deltaVec (K := K) m c₀) ∈ currentCarrier Q m 0 :=
  Mspace_le f hQ c₀ hdiag (Submodule.subset_span ⟨l, rfl⟩)

/-- The class of `δ_{c₀}` in the fibre. -/
def wF : Fib Q m := Submodule.Quotient.mk ⟨deltaVec m c₀, deltaVec_mem c₀ hdiag⟩

theorem wordOp_wF (l : List (σ × ℕ)) :
    wordOp (fiberRep f m hQ hJ) l (wF m c₀ hdiag) =
      Submodule.Quotient.mk ⟨applyWord f m l (deltaVec m c₀), applyWord_mem f m hQ c₀ hdiag l⟩ := by
  induction l with
  | nil => rfl
  | cons xs l ih =>
      change opF f m hQ xs.1 xs.2 (wordOp (fiberRep f m hQ hJ) l (wF m c₀ hdiag)) = _
      rw [ih, opF_mk]
      rfl

/-- **Fibre dimension ≤ loop-span dimension of the generator**, given step B8 (`W ⊆ M`). -/
theorem fiberDim_le_cycDeg (hgen : currentCarrier Q m 0 ≤ Mspace (K := K) f m c₀) (b : ℕ) :
    fiberDim (symDeg (K := K) m) (carrierDeg Q m) b ≤
      Module.finrank K (cycDeg (fiberRep f m hQ hJ) (wF m c₀ hdiag) b) := by
  classical
  set Φ : carrierDeg Q m b →ₗ[K] Fib Q m :=
    (augW Q m).mkQ ∘ₗ Submodule.inclusion (carrierDeg_le Q m b) with hΦ
  have hker : (plus (symDeg (K := K) m) (carrierDeg Q m) b).comap (carrierDeg Q m b).subtype ≤
      LinearMap.ker Φ := by
    intro x hx
    rw [LinearMap.mem_ker, hΦ, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    exact plus_le_augT m b hx
  set Φb := (Submodule.comap (carrierDeg Q m b).subtype
    (plus (symDeg (K := K) m) (carrierDeg Q m) b)).liftQ Φ hker with hΦb
  have hinj : Function.Injective Φb := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    induction x using Submodule.Quotient.induction_on with
    | H y =>
        rw [hΦb, Submodule.liftQ_apply, hΦ, LinearMap.comp_apply, Submodule.mkQ_apply,
          Submodule.Quotient.mk_eq_zero] at hx
        rw [Submodule.Quotient.mk_eq_zero]
        change y.1 ∈ plus _ _ b
        have hy := projT_mem_plus m hx b
        change projT b y.1 ∈ _ at hy
        rwa [projT_of_isHomT (isHomT_of_mem_carrierDeg m y.2), if_pos rfl] at hy
  have hrange : LinearMap.range Φb ≤ cycDeg (fiberRep f m hQ hJ) (wF m c₀ hdiag) b := by
    rintro _ ⟨x, rfl⟩
    induction x using Submodule.Quotient.induction_on with
    | H y =>
        rw [hΦb, Submodule.liftQ_apply, hΦ, LinearMap.comp_apply, Submodule.mkQ_apply]
        have hyM := hgen (carrierDeg_le Q m b y.2)
        have hw := projT_mem_wordSpan f c₀ b hyM
        rw [projT_of_isHomT (isHomT_of_mem_carrierDeg m y.2), if_pos rfl] at hw
        -- push the span through the quotient map
        have key : ∀ z (hz : z ∈ wordSpan (K := K) f (m := m) c₀ b),
            (Submodule.Quotient.mk ⟨z, Mspace_le f hQ c₀ hdiag (wordSpan_le_Mspace f c₀ b hz)⟩ :
              Fib Q m) ∈ cycDeg (fiberRep f m hQ hJ) (wF m c₀ hdiag) b := by
          intro z hz
          induction hz using Submodule.span_induction with
          | mem v hv =>
              obtain ⟨l, hl, rfl⟩ := hv
              apply Submodule.subset_span
              exact ⟨l, hl, (wordOp_wF f m hQ hJ c₀ hdiag l).symm⟩
          | zero => exact Submodule.zero_mem _
          | add a c ha hc iha ihc =>
              have := Submodule.add_mem _ iha ihc
              rwa [← Submodule.Quotient.mk_add] at this
          | smul a v hv ihv =>
              have := Submodule.smul_mem _ a ihv
              rwa [← Submodule.Quotient.mk_smul] at this
        exact key y.1 hw
  haveI : FiniteDimensional K (LinearMap.range Φb) := inferInstance
  have hfin : FiniteDimensional K (cycDeg (fiberRep f m hQ hJ) (wF m c₀ hdiag) b) := by
    refine Submodule.finiteDimensional_of_le (S₂ := LinearMap.range Φb) ?_
    -- every generator of `cycDeg` comes from a degree-`b` carrier vector
    rw [cycDeg, Submodule.span_le]
    rintro _ ⟨l, hl, rfl⟩
    rw [wordOp_wF]
    have hmem : applyWord f m l (deltaVec (K := K) m c₀) ∈ carrierDeg Q m b :=
      mem_carrierDeg Q m (applyWord_mem f m hQ c₀ hdiag l) (by
        rw [← hl]; exact isHomT_applyWord f c₀ l)
    refine ⟨Submodule.Quotient.mk ⟨_, hmem⟩, ?_⟩
    rw [hΦb, Submodule.liftQ_apply, hΦ, LinearMap.comp_apply, Submodule.mkQ_apply]
    rfl
  calc fiberDim (symDeg (K := K) m) (carrierDeg Q m) b
      = Module.finrank K (LinearMap.range Φb) := (LinearMap.finrank_range_of_inj hinj).symm
    _ ≤ _ := Submodule.finrank_mono hrange

end Gen

end

end VOA.DeligneAudit.SectorFiberModule
