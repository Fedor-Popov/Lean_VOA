import VOA.DeligneAudit.D4LevelReductionCoreEndomorphisms

/-! Current submodules generated by coefficient ideals and their cyclic successive quotients. -/

namespace VOA.DeligneAudit.D4LevelReduction

noncomputable section

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.UnivG

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (a b c : ℕ) (Q : CurrentModule A3Sector.bracketTable V)
variable (π : CoreBaseRing a b c →ₗ[ℂ] V)

/-- The current submodule generated by the image of a coefficient ideal. -/
def coreIdealSpan (I : Ideal (CoreBaseRing a b c)) : Submodule ℂ V :=
  Submodule.span ℂ {v | ∃ (l : List (Ltr 15)) (φ : CoreBaseRing a b c),
    φ ∈ I ∧ v = wordOp Q l (π φ)}

theorem coreIdealSpan_contains (I : Ideal (CoreBaseRing a b c))
    {φ : CoreBaseRing a b c} (hφ : φ ∈ I) : π φ ∈ coreIdealSpan a b c Q π I :=
  Submodule.subset_span ⟨[], φ, hφ, rfl⟩

/-- Every ideal-generated term is stable under every Levi current. -/
theorem coreIdealSpan_stable (I : Ideal (CoreBaseRing a b c)) (e : Fin 15) (r : ℕ) :
    coreIdealSpan a b c Q π I ≤ (coreIdealSpan a b c Q π I).comap (Q.op e r) := by
  apply Submodule.span_le.mpr
  rintro v ⟨l, φ, hφ, rfl⟩
  exact Submodule.subset_span ⟨(e, r) :: l, φ, hφ, rfl⟩

theorem coreIdealSpan_mono {I J : Ideal (CoreBaseRing a b c)} (h : I ≤ J) :
    coreIdealSpan a b c Q π I ≤ coreIdealSpan a b c Q π J := by
  apply Submodule.span_mono
  rintro v ⟨l, φ, hφ, rfl⟩
  exact ⟨l, φ, h hφ, rfl⟩

theorem coreIdealSpan_bot : coreIdealSpan a b c Q π ⊥ = ⊥ := by
  apply bot_unique
  apply Submodule.span_le.mpr
  rintro v ⟨l, φ, hφ, rfl⟩
  have hz : φ = 0 := hφ
  change wordOp Q l (π φ) = 0
  rw [hz, map_zero, wordOp_zero]

/-- The last coefficient ideal generates the entire cyclic core module. -/
theorem coreIdealSpan_top (hcyclic : cycSubG Q (π 1) = ⊤) :
    coreIdealSpan a b c Q π ⊤ = ⊤ := by
  apply top_unique
  rw [← hcyclic]
  apply Submodule.span_le.mpr
  rintro v ⟨l, rfl⟩
  exact Submodule.subset_span ⟨l, 1, Submodule.mem_top, rfl⟩

/-- A one-generator step in the coefficient ring gives a one-generator current-module step. -/
theorem coreIdealSpan_step (I J : Ideal (CoreBaseRing a b c)) (σ : CoreBaseRing a b c)
    (hstep : J.restrictScalars ℂ = I.restrictScalars ℂ ⊔ ℂ ∙ σ) :
    coreIdealSpan a b c Q π J = coreIdealSpan a b c Q π I ⊔ cycSubG Q (π σ) := by
  have hIJ : I ≤ J := by
    intro φ hφ
    change φ ∈ J.restrictScalars ℂ
    rw [hstep]
    exact Submodule.mem_sup_left hφ
  have hσ : σ ∈ J := by
    change σ ∈ J.restrictScalars ℂ
    rw [hstep]
    exact Submodule.mem_sup_right (Submodule.mem_span_singleton_self σ)
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro v ⟨l, φ, hφ, rfl⟩
    change φ ∈ J.restrictScalars ℂ at hφ
    rw [hstep] at hφ
    obtain ⟨ψ, hψ, τ, hτ, he⟩ := Submodule.mem_sup.mp hφ
    obtain ⟨z, rfl⟩ := Submodule.mem_span_singleton.mp hτ
    rw [← he, map_add, map_smul, wordOp_add, wordOp_smul]
    exact Submodule.add_mem _
      (Submodule.mem_sup_left (Submodule.subset_span ⟨l, ψ, hψ, rfl⟩))
      (Submodule.mem_sup_right (Submodule.smul_mem _ z (wordOp_mem_cycSubG Q (π σ) l)))
  · apply sup_le (coreIdealSpan_mono a b c Q π hIJ)
    apply Submodule.span_le.mpr
    rintro v ⟨l, rfl⟩
    exact Submodule.subset_span ⟨l, σ, hσ, rfl⟩

/-- The quotient current representation below an ideal cell. -/
def coreIdealQuotientCurrent (I : Ideal (CoreBaseRing a b c)) :
    CurrentModule A3Sector.bracketTable (V ⧸ coreIdealSpan a b c Q π I) :=
  quotRepG Q (coreIdealSpan a b c Q π I) (coreIdealSpan_stable a b c Q π I)

/-- Cyclic current spans commute with passage to the ideal quotient. -/
theorem coreIdealQuotient_cyclic (I : Ideal (CoreBaseRing a b c)) (v : V) :
    (cycSubG Q v).map (coreIdealSpan a b c Q π I).mkQ =
      cycSubG (coreIdealQuotientCurrent a b c Q π I)
        ((coreIdealSpan a b c Q π I).mkQ v) := by
  rw [cycSubG, Submodule.map_span, cycSubG]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨l, rfl⟩, rfl⟩
    exact ⟨l, quot_wordOpG Q _ (coreIdealSpan_stable a b c Q π I) v l⟩
  · rintro ⟨l, rfl⟩
    exact ⟨wordOp Q l v, ⟨l, rfl⟩,
      (quot_wordOpG Q _ (coreIdealSpan_stable a b c Q π I) v l).symm⟩

/-- Each successive module quotient is generated by the image of its single cell vector. -/
theorem coreIdealSpan_step_quotient (I J : Ideal (CoreBaseRing a b c))
    (σ : CoreBaseRing a b c)
    (hstep : J.restrictScalars ℂ = I.restrictScalars ℂ ⊔ ℂ ∙ σ) :
    (coreIdealSpan a b c Q π J).map (coreIdealSpan a b c Q π I).mkQ =
      cycSubG (coreIdealQuotientCurrent a b c Q π I)
        ((coreIdealSpan a b c Q π I).mkQ (π σ)) := by
  rw [coreIdealSpan_step a b c Q π I J σ hstep, Submodule.map_sup,
    Submodule.mkQ_map_self, bot_sup_eq, coreIdealQuotient_cyclic]

variable (A : CoreCoefficientAction Q a b c π)

/-- The coefficient endomorphisms commute with every current word. -/
theorem coreCoefficientAction_word (σ : CoreBaseRing a b c) (l : List (Ltr 15)) (v : V) :
    A.action σ (wordOp Q l v) = wordOp Q l (A.action σ v) := by
  induction l with
  | nil => rfl
  | cons x l ih =>
      change A.action σ (Q.op x.1 x.2 (wordOp Q l v)) = _
      rw [show A.action σ (Q.op x.1 x.2 (wordOp Q l v)) =
        Q.op x.1 x.2 (A.action σ (wordOp Q l v)) from
          congrArg (fun T : Module.End ℂ V => T (wordOp Q l v)) (A.commute σ x.1 x.2).eq]
      rw [ih]
      rfl

/-- Ideal multiples of arbitrary vectors lie in the corresponding ideal-generated submodule. -/
theorem coreCoefficientAction_mem (hcyclic : cycSubG Q (π 1) = ⊤)
    (I : Ideal (CoreBaseRing a b c)) (σ : CoreBaseRing a b c) (hσ : σ ∈ I) (v : V) :
    A.action σ v ∈ coreIdealSpan a b c Q π I := by
  have hv : v ∈ cycSubG Q (π 1) := hcyclic.symm ▸ Submodule.mem_top
  induction hv using Submodule.span_induction with
  | mem v hv =>
      obtain ⟨l, rfl⟩ := hv
      rw [coreCoefficientAction_word a b c Q π A, A.unit]
      exact Submodule.subset_span ⟨l, σ, hσ, rfl⟩
  | zero => simp only [map_zero, Submodule.zero_mem]
  | add v w hv hw ihv ihw => simpa only [map_add] using Submodule.add_mem _ ihv ihw
  | smul z v hv ih => simpa only [map_smul] using Submodule.smul_mem _ z ih

/-- The ideal-generated term agrees with the ideal times the whole module. -/
theorem coreIdealSpan_eq_coefficientSpan (hcyclic : cycSubG Q (π 1) = ⊤)
    (I : Ideal (CoreBaseRing a b c)) :
    coreIdealSpan a b c Q π I =
      Submodule.span ℂ {z | ∃ σ ∈ I, ∃ v : V, z = A.action σ v} := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro z ⟨l, φ, hφ, rfl⟩
    apply Submodule.subset_span
    refine ⟨φ, hφ, wordOp Q l (π 1), ?_⟩
    rw [coreCoefficientAction_word a b c Q π A, A.unit]
  · apply Submodule.span_le.mpr
    rintro z ⟨σ, hσ, v, rfl⟩
    exact coreCoefficientAction_mem a b c Q π A hcyclic I σ hσ v

end

end VOA.DeligneAudit.D4LevelReduction

