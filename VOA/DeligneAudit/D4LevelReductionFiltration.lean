import VOA.DeligneAudit.D4LevelReduction

/-!
The letter-count layers and descending Levi-level filtration. Each term is a sum of
the existing key orbits. Keys are grouped by letter count and the sum of the three
Levi Cartan labels; current degree and the individual labels are not ordered here.
The existing finite key box loses no nonzero orbit of a saturated source module.
-/

namespace VOA.DeligneAudit.D4LevelReduction

open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4
open VOA.DeligneAudit.D4Levi

/-- The vector-node grade, normalized so that the cyclic generator has grade `m`. -/
def keyAlphaGrade (m : ℕ) (k : RadicalKey) : ℤ := (m : ℤ) - keyDepth k

/-- The eigenvalue of the highest-root coroot of the semisimple Levi. -/
def keyLeviLevel (m : ℕ) (k : RadicalKey) : ℤ :=
  (m : ℤ) + k.e + k.x - k.y - k.z

theorem keyLeviLevel_eq_labels (m : ℕ) (k : RadicalKey) :
    keyLeviLevel m k = keyLabel m 0 k + keyLabel m 1 k + keyLabel m 2 k := by
  simp [keyLeviLevel, keyLabel]
  ring

/-- The finite set of grade and level pairs represented in the existing key box. -/
def levelIndices (m : ℕ) : Finset (ℤ × ℤ) :=
  (globalKeyBox m).image (fun k => (keyAlphaGrade m k, keyLeviLevel m k))

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule D4sector.f V) (w : V)

/-- The vector-node layer generated by radical words of one letter count. -/
noncomputable def alphaLayer (m : ℕ) (κ : ℤ) : Submodule ℂ V :=
  ⨆ k ∈ globalKeyBox m, ⨆ (_ : keyAlphaGrade m k = κ), keyOrbit ρ w k

/-- Levi closure of the radical key layers at or above a given coroot eigenvalue. -/
noncomputable def levelFiltration (m : ℕ) (κ p : ℤ) : Submodule ℂ V :=
  ⨆ k ∈ globalKeyBox m, ⨆ (_ : keyAlphaGrade m k = κ),
    ⨆ (_ : p ≤ keyLeviLevel m k), keyOrbit ρ w k

theorem keyOrbit_le_levelFiltration (m : ℕ) (κ p : ℤ) (k : RadicalKey)
    (hk : k ∈ globalKeyBox m) (hκ : keyAlphaGrade m k = κ)
    (hp : p ≤ keyLeviLevel m k) : keyOrbit ρ w k ≤ levelFiltration ρ w m κ p :=
  le_iSup_of_le k (le_iSup_of_le hk (le_iSup_of_le hκ (le_iSup_of_le hp le_rfl)))

theorem levelFiltration_le_alphaLayer (m : ℕ) (κ p : ℤ) :
    levelFiltration ρ w m κ p ≤ alphaLayer ρ w m κ := by
  apply iSup_le
  intro k
  apply iSup_le
  intro hk
  apply iSup_le
  intro hκ
  apply iSup_le
  intro _
  exact le_iSup_of_le k (le_iSup_of_le hk (le_iSup_of_le hκ le_rfl))

/-- Increasing the level threshold decreases the filtration term. -/
theorem levelFiltration_antitone (m : ℕ) (κ : ℤ) :
    Antitone (levelFiltration ρ w m κ) := by
  intro p q hpq
  apply iSup_le
  intro k
  apply iSup_le
  intro hk
  apply iSup_le
  intro hκ
  apply iSup_le
  intro hq
  exact keyOrbit_le_levelFiltration ρ w m κ p k hk hκ (hpq.trans hq)

/-- Each filtration term is a submodule for every reductive Levi current. -/
theorem levelFiltration_stable (m : ℕ) (κ p : ℤ) (a : Fin 28) (r : ℕ)
    (ha : IsLevi a) :
    levelFiltration ρ w m κ p ≤ (levelFiltration ρ w m κ p).comap (ρ.op a r) := by
  apply iSup_le
  intro k
  apply iSup_le
  intro hk
  apply iSup_le
  intro hκ
  apply iSup_le
  intro hp v hv
  exact keyOrbit_le_levelFiltration ρ w m κ p k hk hκ hp
    (levi_op_orbit ρ w k a r ha hv)

theorem levelFiltration_le_cyclic (m : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) (κ p : ℤ) :
    levelFiltration ρ w m κ p ≤ cycSubG ρ w := by
  rw [source_cyc_eq_iSup_keyOrbit ρ w m h]
  apply iSup_le
  intro k
  apply iSup_le
  intro _
  apply iSup_le
  intro _
  apply iSup_le
  intro _
  exact le_iSup (keyOrbit ρ w) k

/-- The finite collection of level filtration terms spans the whole cyclic module. -/
theorem levelFiltration_spans (m : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    (⨆ i ∈ levelIndices m, levelFiltration ρ w m i.1 i.2) = cycSubG ρ w := by
  apply le_antisymm
  · exact iSup_le fun i => iSup_le fun _ => levelFiltration_le_cyclic ρ w m h i.1 i.2
  · rw [source_cyc_eq_iSup_keyOrbit ρ w m h]
    apply iSup_le
    intro k
    by_cases hk : k ∈ globalKeyBox m
    · exact le_iSup_of_le (keyAlphaGrade m k, keyLeviLevel m k)
        (le_iSup_of_le (Finset.mem_image.mpr ⟨k, hk, rfl⟩)
          (keyOrbit_le_levelFiltration ρ w m _ _ k hk rfl le_rfl))
    · have hz : keyLayer ρ w k = ⊥ := by
        by_contra hn
        exact hk (keyBox_contains_nonzero_global ρ w m h k hn)
      rw [keyOrbit_eq_bot_of_keyLayer_bot ρ w k hz]
      exact bot_le

/-- The next level is spanned by strictly higher levels in the same letter-count layer. -/
theorem levelFiltration_next_le (m : ℕ) (κ p : ℤ) :
    levelFiltration ρ w m κ (p + 1) ≤
      ⨆ j ∈ levelIndices m, ⨆ (_ : p < j.2), levelFiltration ρ w m j.1 j.2 := by
  apply iSup_le
  intro k
  apply iSup_le
  intro hk
  apply iSup_le
  intro hκ
  apply iSup_le
  intro hp
  exact le_iSup_of_le (κ, keyLeviLevel m k)
    (le_iSup_of_le (Finset.mem_image.mpr ⟨k, hk, by simp [hκ]⟩)
      (le_iSup_of_le (by omega : p < keyLeviLevel m k)
        (keyOrbit_le_levelFiltration ρ w m _ _ k hk hκ le_rfl)))

/-- A level quotient before imposing the current cutoff. -/
abbrev LevelPiece (m : ℕ) (κ p : ℤ) :=
  levelFiltration ρ w m κ p ⧸
    (levelFiltration ρ w m κ (p + 1)).comap (levelFiltration ρ w m κ p).subtype

/-- The level coinvariants, presented by higher-level vectors and high Levi images. -/
abbrev TruncatedLevelPiece (m : ℕ) (κ p : ℤ) :=
  levelFiltration ρ w m κ p ⧸
    (levelFiltration ρ w m κ (p + 1) ⊔
      currentTail ρ (levelFiltration ρ w m κ p) {c | IsLevi c} m).comap
        (levelFiltration ρ w m κ p).subtype

end VOA.DeligneAudit.D4LevelReduction

