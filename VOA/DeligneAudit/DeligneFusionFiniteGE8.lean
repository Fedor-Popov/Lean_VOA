import VOA.DeligneAudit.DeligneFusionFiniteG
import VOA.DeligneAudit.DeligneFusionFiniteGE8Chk
import VOA.DeligneAudit.E8SectorData

/-!
# The finiteness clause for `E8`

Generated by `Notes/deligne/campaign/generators/gen_finite_cert.py e8`. The 112-step
nilpotency certificate is kernel-checked in the light file `DeligneFusionFiniteGE8Chk`
(`e8_certValidL`, `e8_covL`); here it is read against `E8sector` by definitional unfolding.

`e8_finiteTable : FiniteTableG E8sector` and
`e8_fusionTotalBoundG_of_dim : FusionTotalDimG E8sector → FusionTotalBoundG E8sector`.
-/

set_option maxRecDepth 100000

namespace VOA.DeligneAudit.FiniteG.E8

open VOA.DeligneAudit.DeligneSector VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneCarrier.E8 VOA.AffineGeneral.SCLie

theorem e8_certValid :
    certValid E8sector.wt (fun a b c => e8Fz a b c != 0) e8Kn e8Cert = true :=
  e8_certValidL

theorem e8_cov : ∀ c : Fin 248, (certKnown e8Kn e8Cert c && !wEqB (E8sector.wt c) 0) = true ∨
    E8sector.raising c ∨ E8sector.cartan c ∨ E8sector.cartanN c :=
  e8_covL

theorem e8_kn : ∀ c : Fin 248, e8Kn c = true → E8sector.raising c ∨ E8sector.lowering c := by
  change ∀ c : Fin 248, e8Kn c = true →
    (8 ≤ c.val ∧ c.val < 128) ∨ (c.val ∈ ([135, 134, 133, 132, 131, 130, 129, 128] : List ℕ))
  intro c h
  simpa [e8Kn] using h

theorem e8_hfz : ∀ a b c, E8sector.f a b c = (e8Fz a b c : ℂ) := fun _ _ _ => rfl

/-- **The finiteness table facts for `E8`.** -/
theorem e8_finiteTable : FiniteTableG E8sector :=
  finiteTableG_of_cert (fnz_of_table e8_hfz) e8Kn e8Cert e8_kn e8_certValid e8_cov

/-- **`FusionTotalBoundG E8sector` reduces to the bare dimension bound.** -/
theorem e8_fusionTotalBoundG_of_dim (h : FusionTotalDimG E8sector) :
    FusionTotalBoundG E8sector :=
  fusionTotalBoundG_of_dim e8_finiteTable h

end VOA.DeligneAudit.FiniteG.E8

section AxiomAudit
#print axioms VOA.DeligneAudit.FiniteG.E8.e8_finiteTable
#print axioms VOA.DeligneAudit.FiniteG.E8.e8_fusionTotalBoundG_of_dim
end AxiomAudit
