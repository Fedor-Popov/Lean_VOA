import VOA.DeligneAudit.SL4TColourStratumCertificate
import VOA.DeligneAudit.SL4TMiddleFlagInvariantQuotient

/-!
# Stratum line flags and their transport to the middle multiplicity rings

The Young-invariant truncated flag ring is filtered by its determinantal strata, and each
stratum is refined by degree. The graded refinement, the stratum dimensions and the level
certificates give a power-sum-stable line flag whose cost is the weighted stratum count: the
number of attained site colour multiplicities with exactly `j` selected doubles, times the
cost of level `r - j`, summed over `j`.

For a valid middle tuple with zero outer label the canonical colouring has four blocks; the
selected colours are the two blocks of the characteristic alphabet. The truncated invariant
ring maps onto the actual mixed coefficient ring modulo its all-tail ideal: the contracted
truncation ideal is generated by the elementary relations, which vanish, and by the block
power sums above the cutoff, which map onto the all-tail ideal. The selected power sums map
to the mixed power sums, so the Newton characteristic polynomial maps to the mixed
characteristic polynomial, and the number of selected positions is the mixed weight. The
line flag therefore transports to a `MultiDoubledSiteCoefficientFlag`, once the weighted
stratum count is bounded by the word count of the block.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial
open scoped Polynomial

section Ring

variable {C : Type*} [DecidableEq C] {B : ℕ} (colour : Fin B → C)

/-- The number of attained site colour multiplicities with fewer than `j` selected doubles. -/
def colourStratumCount (k j : ℕ) (selected : Finset C) : ℕ :=
  Nat.card (Set.range (fun f : FullFlagStratumConfiguration B k j
    (selectedColourPositions colour selected) => configurationColourMultiplicity colour f.val))

/-- The weighted stratum count: each stratum's dimension times the cost of its level. -/
def colourStratumCost (k : ℕ) (selected : Finset C) : ℕ :=
  ∑ j ∈ Finset.range ((selectedColourPositions colour selected).card + 1),
    (colourStratumCount colour k (j + 1) selected - colourStratumCount colour k j selected) *
      lineLevelCost (selectedColourPositions colour selected).card
        ((selectedColourPositions colour selected).card - j)

/-- The dimension of a stratum is the drop of the quotient dimensions. -/
theorem ideal_restrictScalars_finrank {R : Type*} [CommRing R] [Algebra ℂ R]
    [FiniteDimensional ℂ R] (I : Ideal R) :
    Module.finrank ℂ (I.restrictScalars ℂ) =
      Module.finrank ℂ R - Module.finrank ℂ (R ⧸ I) := by
  have h := Submodule.finrank_quotient_add_finrank (I.restrictScalars ℂ)
  have he := (Submodule.Quotient.restrictScalarsEquiv ℂ I).finrank_eq
  omega

/-- The graded stratification of the truncated invariant ring is a line flag whose cost is
the weighted stratum count. -/
theorem colourTruncatedFlagRing_lineFlag (k : ℕ) (hk : 2 * k ≤ B) (selected : Finset C) :
    LineFlagFrom (colourTruncatedPowerSum colour selected (B - k))
      (descendingPoly (newtonCoeff (colourTruncatedPowerSum colour selected (B - k)))
        (selectedColourPositions colour selected).card)
      (B - k) (selectedColourPositions colour selected).card ⊥
      (colourStratumCost colour k selected) := by
  letI := colourTruncatedFlagRing_finite colour k hk
  let r := (selectedColourPositions colour selected).card
  let G : ℕ → Submodule ℂ (ColourTruncatedFlagRing colour (B - k)) := fun j =>
    (colourTruncatedStratum colour selected (B - k) j).restrictScalars ℂ
  have h := lineFlagFrom_gradedStrata (r := r)
    (p := colourTruncatedPowerSum colour selected (B - k))
    (P := descendingPoly (newtonCoeff (colourTruncatedPowerSum colour selected (B - k))) r)
    (M := B - k) G (r + 1)
    (by
      simp only [G]
      rw [colourTruncatedStratum_zero, Submodule.restrictScalars_top])
    (by
      simp only [G]
      rw [colourTruncatedStratum_eq_bot colour selected (B - k) (r + 1) (by omega),
        Submodule.restrictScalars_bot])
    (fun j _ x hx => colourTruncatedStratum_succ_le colour selected (B - k) j hx)
    (fun j s _ a ha => Ideal.mul_mem_left _ _ ha)
    (colourTruncatedDegree colour (B - k)) (B * (B - k))
    (fun s _ d a ha => colourTruncatedDegree_powerSum_mul colour selected (B - k) s d a ha)
    (fun d hd => colourTruncatedDegree_eq_bot colour (B - k) d hd)
    (fun j _ => colourTruncatedStratum_homogeneous colour k hk selected j)
    (fun j => r - j)
    (fun j hj d a ha => colourTruncatedStratum_certificate colour selected (B - k) j
      (by omega) d a ha.1 ha.2)
  apply lineFlagFrom_mono h
  apply Finset.sum_le_sum
  intro j _
  apply Nat.mul_le_mul_right
  have hj := (colourTruncatedStratum_quotient_finrank colour k hk selected j).2
  have hj' := (colourTruncatedStratum_quotient_finrank colour k hk selected (j + 1)).2
  simp only [G]
  rw [ideal_restrictScalars_finrank, ideal_restrictScalars_finrank, hj, hj']
  simp only [colourStratumCount]
  omega

end Ring

section Middle

variable (q : MixedParams) (hq : MixedValid q) (hA : q.A = 0)

include hq hA

/-- With zero outer label the mixed power sums are the sums of the two characteristic block
symbols. -/
theorem mixedPowerSum_eq_middleFlagTail (s : ℕ) (hs : 0 < s) :
    mixedPowerSum q s = middleFlagTailSymbols q s 1 + middleFlagTailSymbols q s 3 := by
  obtain ⟨_, hd3⟩ := middleFlag_outer_lengths q hq hA
  have h2 : mixedAlphabetPowerSum (mixedEvaluation q) 2 q.d3.toNat s = 0 :=
    mixedAlphabetPowerSum_empty q hq 2 (by simp [mixedLengths, hd3]) s hs
  rw [mixedPowerSum_eq_lastCartan q hq s hs]
  simp only [mixedLastCartanPowerSum, middleFlagTailSymbols, mixedLengths, h2]
  simp

/-- The actual all-tail quotient is a quotient of the truncated invariant ring. -/
def middleFlagTruncatedEvaluation (N : ℕ) (hN : 0 < N) :
    ColourTruncatedFlagRing (middleFlagPositionColour q hq hA) N →ₐ[ℂ]
      MixedRing q ⧸ middleFlagAllTailIdeal q N :=
  Ideal.Quotient.liftₐ (colourTruncationIdeal (middleFlagPositionColour q hq hA) N)
    ((Ideal.Quotient.mkₐ ℂ (middleFlagAllTailIdeal q N)).comp
      (middleFlagInvariantEvaluation q (middleFlagPositionColour q hq hA)
        (middleFlagPositionFibre q hq hA))) (by
      intro x hx
      have hx' : x ∈ colourSymmetricIdeal (middleFlagPositionColour q hq hA) ⊔
          colourPowerSumTailIdeal (middleFlagPositionColour q hq hA) N := by
        rw [← colourFullFlagIdeal_contract]
        exact hx
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx'
      have hy0 := colourSymmetricIdeal_le_middleFlagKernel q hq hA
        (middleFlagPositionColour q hq hA) (middleFlagPositionFibre q hq hA) hy
      have hz0 : middleFlagInvariantEvaluation q (middleFlagPositionColour q hq hA)
          (middleFlagPositionFibre q hq hA) z ∈ middleFlagAllTailIdeal q N := by
        rw [← middleFlagInvariantEvaluation_tailIdeal q (middleFlagPositionColour q hq hA)
          (middleFlagPositionFibre q hq hA) hq hA N hN]
        exact Ideal.mem_map_of_mem _ hz
      change Ideal.Quotient.mk _ (middleFlagInvariantEvaluation q _ _ (y + z)) = 0
      rw [map_add, show middleFlagInvariantEvaluation q (middleFlagPositionColour q hq hA)
          (middleFlagPositionFibre q hq hA) y = 0 from hy0, zero_add]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hz0)

theorem middleFlagTruncatedEvaluation_surjective (N : ℕ) (hN : 0 < N) :
    Function.Surjective (middleFlagTruncatedEvaluation q hq hA N hN) := by
  intro x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective ℂ (middleFlagAllTailIdeal q N) x
  obtain ⟨f, hf⟩ := middleFlagInvariantEvaluation_surjective q hq hA
    (middleFlagPositionColour q hq hA) (middleFlagPositionFibre q hq hA) a
  refine ⟨Ideal.Quotient.mk _ f, ?_⟩
  change Ideal.Quotient.mk _ (middleFlagInvariantEvaluation q _ _ f) = _
  rw [hf]
  rfl

/-- The selected power sums map to the mixed power sums. -/
theorem middleFlagTruncatedEvaluation_powerSum (N : ℕ) (hN : 0 < N) (s : ℕ) (hs : 1 ≤ s) :
    middleFlagTruncatedEvaluation q hq hA N hN
        (colourTruncatedPowerSum (middleFlagPositionColour q hq hA) {1, 3} N s) =
      Ideal.Quotient.mk (middleFlagAllTailIdeal q N) (mixedPowerSum q s) := by
  change Ideal.Quotient.mk _ (middleFlagInvariantEvaluation q _ _
    (selectedColourPowerSum (middleFlagPositionColour q hq hA) {1, 3} s)) = _
  rw [selectedColourPowerSum, map_sum, Finset.sum_pair (by decide),
    middleFlagInvariantEvaluation_powerSum q _ _ hq hA 1 s hs,
    middleFlagInvariantEvaluation_powerSum q _ _ hq hA 3 s hs,
    mixedPowerSum_eq_middleFlagTail q hq hA s (by omega)]

/-- The selected positions of the canonical colouring number exactly the mixed weight. -/
theorem middleFlagSelected_card :
    (selectedColourPositions (middleFlagPositionColour q hq hA) {1, 3}).card =
      (mixedWeight q).toNat := by
  classical
  have hc (c : Fin 4) : (Finset.univ.filter
      fun i => middleFlagPositionColour q hq hA i = c).card = middleFlagLength q c := by
    rw [← Fintype.card_subtype, ← Fintype.card_congr (middleFlagPositionFibre q hq hA c),
      Fintype.card_fin]
  have hsplit : selectedColourPositions (middleFlagPositionColour q hq hA) {1, 3} =
      (Finset.univ.filter fun i => middleFlagPositionColour q hq hA i = 1) ∪
        (Finset.univ.filter fun i => middleFlagPositionColour q hq hA i = 3) := by
    ext i
    simp [selectedColourPositions]
  rw [hsplit, Finset.card_union_of_disjoint, hc, hc, mixedWeight_length q hq]
  · simp [middleFlagLength]
  · rw [Finset.disjoint_filter]
    intro i _ h1 h3
    rw [h1] at h3
    exact absurd h3 (by decide)

/-- The Newton characteristic polynomial of the selected power sums maps to the mixed
characteristic polynomial. -/
theorem middleFlagTruncatedEvaluation_characteristic (N : ℕ) (hN : 0 < N) :
    (descendingPoly (newtonCoeff (colourTruncatedPowerSum (middleFlagPositionColour q hq hA)
        {1, 3} N)) (selectedColourPositions (middleFlagPositionColour q hq hA) {1, 3}).card).map
      (middleFlagTruncatedEvaluation q hq hA N hN).toRingHom =
        (mixedCharacteristic q).map (Ideal.Quotient.mk (middleFlagAllTailIdeal q N)) := by
  rw [← mixedPowerSum_descending q hq, descendingPoly_map, descendingPoly_map,
    middleFlagSelected_card q hq hA]
  congr 1
  funext i
  rw [show (middleFlagTruncatedEvaluation q hq hA N hN).toRingHom
      (newtonCoeff (colourTruncatedPowerSum (middleFlagPositionColour q hq hA) {1, 3} N) i) =
      middleFlagTruncatedEvaluation q hq hA N hN
        (newtonCoeff (colourTruncatedPowerSum (middleFlagPositionColour q hq hA) {1, 3} N) i)
      from rfl, ← newtonCoeff_map,
    show Ideal.Quotient.mk (middleFlagAllTailIdeal q N) (newtonCoeff (mixedPowerSum q) i) =
      Ideal.Quotient.mkₐ ℂ (middleFlagAllTailIdeal q N) (newtonCoeff (mixedPowerSum q) i)
      from rfl, ← newtonCoeff_map]
  apply newtonCoeff_congr_positive
  intro s hs
  exact middleFlagTruncatedEvaluation_powerSum q hq hA N hN s hs

/-- The concrete coefficient flag exists whenever the weighted stratum count of the block is
bounded by its word count. -/
theorem multiDoubledSiteCoefficientFlag_of_stratumCost (k : ℕ) (hk : 1 ≤ k)
    (hkB : 2 * k ≤ q.B.toNat)
    (hcost : colourStratumCost (middleFlagPositionColour q hq hA) k {1, 3} ≤
      multiDoubledSiteBlockBound q.B.toNat k q) :
    MultiDoubledSiteCoefficientFlag q.B.toNat k q := by
  have hN : 0 < q.B.toNat - k := by omega
  have h := colourTruncatedFlagRing_lineFlag (middleFlagPositionColour q hq hA) k hkB {1, 3}
  have hm := lineFlagFrom_map (middleFlagTruncatedEvaluation q hq hA (q.B.toNat - k) hN)
    (middleFlagTruncatedEvaluation_surjective q hq hA (q.B.toNat - k) hN)
    (fun s => Ideal.Quotient.mk (middleFlagAllTailIdeal q (q.B.toNat - k)) (mixedPowerSum q s))
    (middleFlagTruncatedEvaluation_powerSum q hq hA (q.B.toNat - k) hN) h
  rw [middleFlagTruncatedEvaluation_characteristic q hq hA (q.B.toNat - k) hN,
    middleFlagSelected_card q hq hA] at hm
  exact mixedQuotientSubspaceFlag_of_lineFlag q _ _ _ (lineFlagFrom_mono hm hcost)

end Middle

end

end VOA.DeligneAudit.SL4T
