import VOA.DeligneAudit.SL4TGradedJointDeterminantal
import VOA.DeligneAudit.SL4TAdjointSiteResiduals

/-!
# The joint top-row ideal splits into two pure determinantal ideals

Over any commutative ring `A`, for any polynomial `P`, any row count `r`, any `j`, `h` and any
symbol `s ∈ A`, let `U ⊆ A[t]` be the ideal generated by `t^(h+1)` and `s t^h`, and `G_j(U)` its
ideal of top-row `j`-minors modulo `P`. Then

`G_j(t^(h+1), s t^h) = G_j(t^(h+1)) + (s) G_j(t^h)`   (`jointTopIdeal_eq_sup`).

Proof. The ideal `U` is spanned over `A` by the columns `t^c t^(h+1)` and `t^c s t^h`, and a minor
is multilinear in its columns (`det_linearColumns_mem_span`). A minor of such columns with one
column `s t^(h+c)` is `s` times a minor of columns in `(t^h)`. Conversely, `s` times a minor of
columns `t^(h+c)` either vanishes (two columns `t^h`) or equals a minor of columns of `U`, putting
`s` on the column `t^h` if there is one.

Consequently the joint-ideal equation in `OneAdjointStratumCount` holds for every block, every
`h` and every `j` (`adjointSiteJointTopIdeal_eq_sup`).
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open Polynomial

variable {A : Type*} [CommRing A]

/-- Multiples of a fixed polynomial are spanned by its monomial multiples. -/
theorem mul_mem_span_X_pow_mul (v g : A[X]) :
    g * v ∈ Submodule.span A {u | ∃ c, u = X ^ c * v} := by
  induction g using Polynomial.induction_on' with
  | add f g hf hg =>
      rw [add_mul]
      exact Submodule.add_mem _ hf hg
  | monomial n a =>
      rw [← C_mul_X_pow_eq_monomial, mul_assoc, ← smul_eq_C_mul]
      exact Submodule.smul_mem _ a (Submodule.subset_span ⟨n, rfl⟩)

/-- Replacing one column of a matrix of functionals applied to columns. -/
theorem det_update_column {V : Type*} [AddCommGroup V] [Module A V] {j : ℕ}
    (L : Fin j → V →ₗ[A] A) (u : Fin j → V) (b : Fin j) (x : V) :
    (fun i c => L i (Function.update u b x c)) =
      Matrix.updateCol (fun i c => L i (u c)) b (fun i => L i x) := by
  ext i c
  by_cases hc : c = b
  · subst hc
    simp
  · simp [Function.update_of_ne hc, Matrix.updateCol_ne hc]

section Splitting

variable (P : A[X]) (r j : ℕ)

/-- The reduced top-row functionals. -/
def topRowFunctional (i : Fin j) : A[X] →ₗ[A] A :=
  (lcoeff A (r - j + i.val)).comp (modByMonicHom P)

theorem topRowFunctional_apply (i : Fin j) (f : A[X]) :
    topRowFunctional P r j i f = (f %ₘ P).coeff (r - j + i.val) :=
  rfl

theorem topIdeal_det_mem (U : Submodule A A[X]) (u : Fin j → A[X]) (hu : ∀ b, u b ∈ U) :
    Matrix.det (fun i b => topRowFunctional P r j i (u b)) ∈
      polynomialSubmoduleTopIdeal P r j U :=
  Ideal.subset_span ⟨fun b => ⟨u b, hu b⟩, rfl⟩

theorem topIdeal_mono {U U' : Submodule A A[X]} (h : U ≤ U') :
    polynomialSubmoduleTopIdeal P r j U ≤ polynomialSubmoduleTopIdeal P r j U' := by
  apply Ideal.span_le.mpr
  rintro a ⟨p, rfl⟩
  exact topIdeal_det_mem P r j U' (fun b => (p b).val) (fun b => h (p b).property)

/-- A top-row ideal is bounded by any ideal containing the minors of spanning columns. -/
theorem topIdeal_le_of_span (U : Submodule A A[X]) (T : Set A[X])
    (hU : U ≤ Submodule.span A T) (I : Ideal A)
    (hT : ∀ u : Fin j → A[X], (∀ b, u b ∈ T) →
      Matrix.det (fun i b => topRowFunctional P r j i (u b)) ∈ I) :
    polynomialSubmoduleTopIdeal P r j U ≤ I := by
  apply Ideal.span_le.mpr
  rintro a ⟨p, rfl⟩
  have h := det_linearColumns_mem_span (topRowFunctional P r j) T (fun b => (p b).val)
    (fun b => hU (p b).property)
  refine (Ideal.span_le.mpr ?_) h
  rintro a ⟨u, hu, rfl⟩
  exact hT u hu

/-- Multiplying one column by `s`. -/
theorem det_topRow_smul_column (u : Fin j → A[X]) (b : Fin j) (s : A) :
    Matrix.det (fun i c =>
        topRowFunctional P r j i (Function.update u b (Polynomial.C s * u b) c)) =
      s * Matrix.det (fun i c => topRowFunctional P r j i (u c)) := by
  rw [det_update_column]
  have hcol : (fun i => topRowFunctional P r j i (Polynomial.C s * u b)) =
      s • fun i => topRowFunctional P r j i (u b) := by
    ext i
    rw [← smul_eq_C_mul, map_smul]
    rfl
  rw [hcol, Matrix.det_updateCol_smul, Matrix.updateCol_eq_self]

/-- **The joint top-row ideal splits.** -/
theorem jointTopIdeal_eq_sup (h : ℕ) (s : A) :
    polynomialSubmoduleTopIdeal P r j
        ((Ideal.span {(X : A[X]) ^ (h + 1), Polynomial.C s * X ^ h}).restrictScalars A) =
      polynomialSubmoduleTopIdeal P r j ((Ideal.span {(X : A[X]) ^ (h + 1)}).restrictScalars A) ⊔
        Ideal.span {s} *
          polynomialSubmoduleTopIdeal P r j ((Ideal.span {(X : A[X]) ^ h}).restrictScalars A) := by
  classical
  set U := (Ideal.span {(X : A[X]) ^ (h + 1), Polynomial.C s * X ^ h}).restrictScalars A with hUdef
  have hUmem1 : ∀ c, (X : A[X]) ^ c * X ^ (h + 1) ∈ U := fun c => by
    rw [hUdef, Submodule.restrictScalars_mem]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
  have hUmem2 : ∀ c, (X : A[X]) ^ c * (Polynomial.C s * X ^ h) ∈ U := fun c => by
    rw [hUdef, Submodule.restrictScalars_mem]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  apply le_antisymm
  · -- every minor of spanning columns lies in the right side
    refine topIdeal_le_of_span P r j U ({u | ∃ c, u = X ^ c * X ^ (h + 1)} ∪
      {u | ∃ c, u = X ^ c * (Polynomial.C s * X ^ h)}) ?_ _ ?_
    · intro f hf
      rw [hUdef, Submodule.restrictScalars_mem] at hf
      obtain ⟨g₁, g₂, rfl⟩ := Ideal.mem_span_pair.mp hf
      exact Submodule.add_mem _
        (Submodule.span_mono Set.subset_union_left (mul_mem_span_X_pow_mul _ g₁))
        (Submodule.span_mono Set.subset_union_right (mul_mem_span_X_pow_mul _ g₂))
    · intro u hu
      by_cases h2 : ∃ b₀ c₀, u b₀ = X ^ c₀ * (Polynomial.C s * X ^ h)
      · obtain ⟨b₀, c₀, hb₀⟩ := h2
        set u' := Function.update u b₀ (X ^ c₀ * X ^ h) with hu'
        have hu'u : Function.update u' b₀ (Polynomial.C s * u' b₀) = u := by
          funext b
          by_cases hb : b = b₀
          · subst hb
            rw [Function.update_self, hu', Function.update_self, hb₀]
            ring
          · rw [Function.update_of_ne hb, hu', Function.update_of_ne hb]
        have hdet := det_topRow_smul_column P r j u' b₀ s
        rw [hu'u] at hdet
        rw [hdet]
        apply Ideal.mem_sup_right
        apply Ideal.mul_mem_mul (Ideal.mem_span_singleton_self s)
        apply topIdeal_det_mem
        intro b
        rw [Submodule.restrictScalars_mem]
        by_cases hb : b = b₀
        · subst hb
          rw [hu', Function.update_self]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
        · rw [hu', Function.update_of_ne hb]
          rcases hu b with ⟨c, hc⟩ | ⟨c, hc⟩
          · rw [hc, show (X : A[X]) ^ c * X ^ (h + 1) = X ^ (c + 1) * X ^ h by ring]
            exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
          · rw [hc, show (X : A[X]) ^ c * (Polynomial.C s * X ^ h) =
              (X ^ c * Polynomial.C s) * X ^ h by ring]
            exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      · apply Ideal.mem_sup_left
        apply topIdeal_det_mem
        intro b
        rw [Submodule.restrictScalars_mem]
        rcases hu b with ⟨c, hc⟩ | ⟨c, hc⟩
        · rw [hc]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
        · exact absurd ⟨b, c, hc⟩ h2
  · apply sup_le
    · apply topIdeal_mono
      intro f hf
      rw [Submodule.restrictScalars_mem] at hf
      rw [hUdef, Submodule.restrictScalars_mem]
      exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) hf
    · -- `s` times a minor of columns `t^(h+c)`
      have hcolon : polynomialSubmoduleTopIdeal P r j
          ((Ideal.span {(X : A[X]) ^ h}).restrictScalars A) ≤
          (polynomialSubmoduleTopIdeal P r j U).colon {s} := by
        refine topIdeal_le_of_span P r j _ {u | ∃ c, u = X ^ c * X ^ h} ?_ _ ?_
        · intro f hf
          rw [Submodule.restrictScalars_mem] at hf
          obtain ⟨g, rfl⟩ := Ideal.mem_span_singleton'.mp hf
          exact mul_mem_span_X_pow_mul _ g
        · intro u hu
          rw [Submodule.mem_colon_singleton, smul_eq_mul]
          have hu' : ∀ b, ∃ c, u b = X ^ c * X ^ h := hu
          choose c hc using hu'
          by_cases hz : ∃ b₀, c b₀ = 0
          · obtain ⟨b₀, hb₀⟩ := hz
            by_cases hz2 : ∃ b₁, b₁ ≠ b₀ ∧ c b₁ = 0
            · obtain ⟨b₁, hne, hb₁⟩ := hz2
              rw [Matrix.det_zero_of_column_eq hne (fun i => by rw [hc b₁, hc b₀, hb₁, hb₀]),
                zero_mul]
              exact Ideal.zero_mem _
            · have hpos : ∀ b, b ≠ b₀ → 1 ≤ c b := fun b hb => by
                by_contra hlt
                exact hz2 ⟨b, hb, by omega⟩
              rw [show Matrix.det (fun i b => topRowFunctional P r j i (u b)) * s =
                s * Matrix.det (fun i b => topRowFunctional P r j i (u b)) from mul_comm _ _,
                ← det_topRow_smul_column P r j u b₀ s]
              apply topIdeal_det_mem
              intro b
              by_cases hb : b = b₀
              · rw [hb, Function.update_self, hc b₀, hb₀]
                have h0 := hUmem2 0
                rwa [show (X : A[X]) ^ 0 * (Polynomial.C s * X ^ h) =
                  Polynomial.C s * (X ^ 0 * X ^ h) by ring] at h0
              · rw [Function.update_of_ne hb, hc b]
                obtain ⟨c', hc'⟩ : ∃ c', c b = c' + 1 := ⟨c b - 1, by have := hpos b hb; omega⟩
                rw [hc', show (X : A[X]) ^ (c' + 1) * X ^ h = X ^ c' * X ^ (h + 1) by ring]
                exact hUmem1 c'
          · simp only [not_exists] at hz
            apply Ideal.mul_mem_right
            apply topIdeal_det_mem
            intro b
            rw [hc b]
            obtain ⟨c', hc'⟩ : ∃ c', c b = c' + 1 := ⟨c b - 1, by have := hz b; omega⟩
            rw [hc', show (X : A[X]) ^ (c' + 1) * X ^ h = X ^ c' * X ^ (h + 1) by ring]
            exact hUmem1 c'
      apply Ideal.mul_le.mpr
      intro x hx y hy
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      have hy' := Submodule.mem_colon_singleton.mp (hcolon hy)
      rw [smul_eq_mul] at hy'
      rw [mul_assoc, mul_comm s y]
      exact Ideal.mul_mem_left _ _ hy'

end Splitting

/-- **The joint-ideal equation at one adjoint site**, for every block, `h` and `j`. -/
theorem adjointSiteJointTopIdeal_eq_sup (q : MixedParams) (h j : ℕ) :
    adjointSiteJointTopIdeal q h j =
      adjointSiteRemainderTopIdeal q h (h + 1) j ⊔
        Ideal.span {Ideal.Quotient.mk _ (adjointSiteJointSymbol q)} *
          adjointSiteRemainderTopIdeal q h h j :=
  jointTopIdeal_eq_sup (adjointSiteCharacteristic q h) (mixedWeight q).toNat j h
    (Ideal.Quotient.mk _ (adjointSiteJointSymbol q))

end

