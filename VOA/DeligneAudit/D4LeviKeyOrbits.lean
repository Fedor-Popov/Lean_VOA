import VOA.DeligneAudit.D4LeviKeyFinite

/-! The PBW source is the span of the Levi orbits of all radical keys. -/

namespace VOA.DeligneAudit.D4Levi

open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule D4sector.f V) (w : V)

/-- Levi words applied to radical words of a single exact key. -/
def keyOrbit (k : RadicalKey) : Submodule ℂ V :=
  Submodule.span ℂ {z | ∃ l : List (Fin 28 × ℕ), ∃ r : List (Fin 6 × ℕ),
    l.Forall (fun p => IsLevi p.1) ∧ wordKey r = k ∧
      z = wordOp ρ (l ++ r.map fun p => (radicalColour p.1, p.2)) w}

theorem keyLayer_le_orbit (k : RadicalKey) :
    keyLayer ρ w k ≤ keyOrbit ρ w k := by
  rw [keyLayer, Submodule.span_le]
  rintro z ⟨r, hr, rfl⟩
  exact Submodule.subset_span ⟨[], r, by simp, hr, rfl⟩

private theorem mapped_radical_forall (r : List (Fin 6 × ℕ)) :
    (r.map fun p => (radicalColour p.1, p.2)).Forall
      (fun p => IsRadical p.1) := by
  induction r with
  | nil => simp
  | cons p r ih =>
      rcases p with ⟨i, s⟩
      simp only [List.map_cons, List.forall_cons]
      exact ⟨⟨i, rfl⟩, ih⟩

theorem keyOrbit_le_leviSpan (k : RadicalKey) :
    keyOrbit ρ w k ≤ leviSpan ρ w := by
  rw [keyOrbit, Submodule.span_le]
  rintro z ⟨l, r, hl, _, rfl⟩
  exact normal_mem ρ w l (r.map fun p => (radicalColour p.1, p.2))
    hl (mapped_radical_forall r)

theorem levi_op_orbit (k : RadicalKey) (a : Fin 28) (s : ℕ)
    (ha : IsLevi a) {v : V} (hv : v ∈ keyOrbit ρ w k) :
    ρ.op a s v ∈ keyOrbit ρ w k := by
  induction hv using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨l, r, hl, hk, rfl⟩ := hz
      apply Submodule.subset_span
      exact ⟨(a, s) :: l, r, by simp [ha, hl], hk, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => simpa using (keyOrbit ρ w k).add_mem hx hy
  | smul c x _ hx => simpa using (keyOrbit ρ w k).smul_mem c hx

private theorem encode_radical : ∀ r : List (Fin 28 × ℕ),
    r.Forall (fun p => IsRadical p.1) →
      ∃ q : List (Fin 6 × ℕ),
        r = q.map fun p => (radicalColour p.1, p.2) := by
  intro r
  induction r with
  | nil => intro _; exact ⟨[], rfl⟩
  | cons p r ih =>
      intro hr
      rcases p with ⟨a, s⟩
      simp only [List.forall_cons] at hr
      obtain ⟨i, hi⟩ := hr.1
      obtain ⟨q, hq⟩ := ih hr.2
      refine ⟨(i, s) :: q, ?_⟩
      simp [← hi, hq]

/-- Every PBW normal word belongs to exactly one indexed key orbit. -/
theorem leviSpan_eq_iSup_keyOrbit :
    leviSpan ρ w = ⨆ k : RadicalKey, keyOrbit ρ w k := by
  apply le_antisymm
  · rw [leviSpan, Submodule.span_le]
    rintro z ⟨l, r, hl, hr, rfl⟩
    obtain ⟨q, hq⟩ := encode_radical r hr
    subst r
    apply Submodule.mem_iSup_of_mem (wordKey q)
    exact Submodule.subset_span ⟨l, q, hl, rfl, rfl⟩
  · exact iSup_le fun k => keyOrbit_le_leviSpan ρ w k

/-- The presented all-m cyclic module is generated by its key orbits. -/
theorem source_cyc_eq_iSup_keyOrbit (m : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    cycSubG ρ w = ⨆ k : RadicalKey, keyOrbit ρ w k := by
  exact (source_generation ρ w m h).trans (leviSpan_eq_iSup_keyOrbit ρ w)

end VOA.DeligneAudit.D4Levi

