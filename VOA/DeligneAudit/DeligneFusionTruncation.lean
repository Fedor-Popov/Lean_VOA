import VOA.DeligneAudit.A2SectorWeyl

/-!
# Fusion modules are truncated: `t^m g[t]` acts by zero

Generic part (any structure constants `f`): if a set `I` of loop generators `(a, r)` is an *ideal*
(`[I, g[t]] ⊆ span I`) and every element of `I` kills `w`, then every element of `I` kills the whole
cyclic module generated by `w` (`op_wordOp_of_ideal`).  Consequently a loop word containing a letter
of `I` acts by zero on `w` (`wordOp_eq_zero_of_mem`).

For `sl₃` and the local Weyl + fusion relations of `mθ` (`m ≥ 1`), `I = {(a, r) : m ≤ r}` (that is
`t^m g[t]`) kills `w` (`ideal_kills_w`): the raising and Cartan relations give it for `e`, `h`; the fusion
relation gives `(f_α ⊗ t^m) w = 0`; and `[h₁ ⊗ t^{r-m}, f_α ⊗ t^m] = c_α f_α ⊗ t^r` with `c_α ≠ 0` gives
`r > m`.  Hence the fusion module is a module over the truncated current algebra `g ⊗ ℂ[t]/t^m`,
and its degree pieces are spanned by words in the letters of degree `< m` (`cycDeg_le_truncated`).
-/

namespace VOA.DeligneAudit.SectorWeyl

open VOA.DeligneAudit.SectorGraded

noncomputable section

section Generic

variable {K σ : Type*} [Field K] {f : σ → σ → σ → K} [Fintype σ] {V : Type*} [AddCommGroup V]
  [Module K V]

/-- An ideal of loop generators: brackets of its elements with anything stay inside it. -/
def IsLoopIdeal (f : σ → σ → σ → K) (I : σ → ℕ → Prop) : Prop :=
  ∀ a r, I a r → ∀ b s e, f a b e ≠ 0 → I e (r + s)

theorem op_wordOp_of_ideal (ρ : CurrentModule f V) {I : σ → ℕ → Prop} (hI : IsLoopIdeal f I)
    {w : V} (hw : ∀ a r, I a r → ρ.op a r w = 0) :
    ∀ (l : List (σ × ℕ)) a r, I a r → ρ.op a r (wordOp ρ l w) = 0
  | [], a, r, h => hw a r h
  | (bs :: l), a, r, h => by
      have hc := ρ.comm a bs.1 r bs.2 (wordOp ρ l w)
      have h1 : ρ.op a r (wordOp ρ l w) = 0 := op_wordOp_of_ideal ρ hI hw l a r h
      have h2 : ∀ e, f a bs.1 e • ρ.op e (r + bs.2) (wordOp ρ l w) = 0 := by
        intro e
        by_cases he : f a bs.1 e = 0
        · rw [he, zero_smul]
        · rw [op_wordOp_of_ideal ρ hI hw l e (r + bs.2) (hI a r h bs.1 bs.2 e he), smul_zero]
      rw [h1, map_zero, sub_zero, Finset.sum_eq_zero fun e _ => h2 e] at hc
      exact hc

/-- A word containing a letter of the ideal kills `w`. -/
theorem wordOp_eq_zero_of_mem (ρ : CurrentModule f V) {I : σ → ℕ → Prop} (hI : IsLoopIdeal f I)
    {w : V} (hw : ∀ a r, I a r → ρ.op a r w = 0) :
    ∀ (l : List (σ × ℕ)), (∃ x ∈ l, I x.1 x.2) → wordOp ρ l w = 0
  | [], ⟨x, hx, _⟩ => absurd hx (List.not_mem_nil)
  | (bs :: l), ⟨x, hx, hxI⟩ => by
      rcases List.mem_cons.mp hx with rfl | hx'
      · exact op_wordOp_of_ideal ρ hI hw l x.1 x.2 hxI
      · change ρ.op bs.1 bs.2 (wordOp ρ l w) = 0
        rw [wordOp_eq_zero_of_mem ρ hI hw l ⟨x, hx', hxI⟩, map_zero]

end Generic

/-! ## `sl₃`: the fusion module is a `g ⊗ ℂ[t]/t^m`-module -/

open VOA.AffineSl3

theorem truncIdeal (m : ℕ) : IsLoopIdeal (bracketTable) (fun _ r => m ≤ r) :=
  fun _ _ h _ _ _ _ => le_trans h (Nat.le_add_right _ _)

theorem bracket_h1_f (fα : Fin 8) (h3 : 3 ≤ fα.val) (h6 : fα.val < 6) :
    ∃ c : ℂ, c ≠ 0 ∧ ∀ e : Fin 8, bracketTable 6 fα e = if e = fα then c else 0 := by
  have : fα = 3 ∨ fα = 4 ∨ fα = 5 := by omega
  rcases this with rfl | rfl | rfl
  · exact ⟨-2, by norm_num, by intro e; fin_cases e <;> simp [bracketTable]⟩
  · exact ⟨1, by norm_num, by intro e; fin_cases e <;> simp [bracketTable]⟩
  · exact ⟨-1, by norm_num, by intro e; fin_cases e <;> simp [bracketTable]⟩

/-- **`t^m g[t]` kills the generator** of a module with the local Weyl and fusion relations for
`mθ`, `m ≥ 1`. -/
theorem ideal_kills_w {V : Type} [AddCommGroup V] [Module ℂ V]
    {ρ : CurrentModule (bracketTable) V} {w : V} {m : ℕ} (hm : 1 ≤ m) (hW : LocalWeylRel ρ w m) :
    ∀ (a : Fin 8) r, m ≤ r → ρ.op a r w = 0 := by
  intro a r hr
  by_cases ha : a.val < 3
  · exact hW.raising a ha r
  by_cases hh : 6 ≤ a.val
  · exact hW.cartan_pos a hh r (by omega)
  have h3 : 3 ≤ a.val := by omega
  have h6 : a.val < 6 := by omega
  obtain ⟨k, rfl⟩ : ∃ k, r = m + k := ⟨r - m, by omega⟩
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simpa using hW.fusion a h3 h6
  obtain ⟨c, hc, hce⟩ := bracket_h1_f a h3 h6
  have hcomm := ρ.comm 6 a k m w
  rw [hW.fusion a h3 h6, map_zero, hW.cartan_pos 6 (by decide) k hk, map_zero, sub_zero] at hcomm
  rw [Finset.sum_eq_single a (fun e _ he => by rw [hce, if_neg he, zero_smul]) (by simp),
    hce, if_pos rfl, add_comm k m] at hcomm
  exact (smul_eq_zero.mp hcomm.symm).resolve_left hc

/-- **The fusion module is spanned by words in the letters of degree `< m`.** -/
theorem cycDeg_le_truncated {V : Type} [AddCommGroup V] [Module ℂ V]
    {ρ : CurrentModule (bracketTable) V} {w : V} {m : ℕ} (hm : 1 ≤ m) (hW : LocalWeylRel ρ w m)
    (b : ℕ) :
    cycDeg ρ w b ≤ Submodule.span ℂ
      {v | ∃ l : List (Fin 8 × ℕ), VOA.DeligneAudit.SectorGraded.wordDeg l = b ∧ (∀ x ∈ l, x.2 < m) ∧ v = wordOp ρ l w} := by
  rw [cycDeg, Submodule.span_le]
  rintro _ ⟨l, hl, rfl⟩
  by_cases hall : ∀ x ∈ l, x.2 < m
  · exact Submodule.subset_span ⟨l, hl, hall, rfl⟩
  · push_neg at hall
    rw [wordOp_eq_zero_of_mem ρ (truncIdeal m) (ideal_kills_w hm hW) l hall]
    exact Submodule.zero_mem _

end

end VOA.DeligneAudit.SectorWeyl

section AxiomAudit
#print axioms VOA.DeligneAudit.SectorWeyl.op_wordOp_of_ideal
#print axioms VOA.DeligneAudit.SectorWeyl.ideal_kills_w
#print axioms VOA.DeligneAudit.SectorWeyl.cycDeg_le_truncated
end AxiomAudit
