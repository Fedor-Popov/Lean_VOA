import VOA.DeligneAudit.SL4TAdjointSiteModule

/-!
# Transported relations at one adjoint site

Colours of the six lowering matrix units, in the 0-based convention of `A3Sector.bracketTable`:
`x = f₁ = E₁₀` is colour 6, `y = f₁₂ = E₂₀` is 7, `z = f_θ = E₃₀` is 8, `g = f₂ = E₂₁` is 9,
`q = f₂₃ = E₃₁` is 10 and `F = f₃ = E₃₂` is 11. The nonzero brackets used are

    [F, g] = q,   [F, y] = z,   [q, x] = z,   [g, x] = y,

and the brackets `[F, x]`, `[F, q]`, `[F, z]`, `[x, z]`, `[y, z]`, `[x, y]` vanish.

The main result, `adjointSite_transported_relations`, is the pair of identities

    q(h) F v = 0,      z(h) x F v = 0

in any module generated by a vector `v` with the local Weyl relations of weight `(1, B, 1)` and
`f₂(h) v = 0`. No current cutoff and no group action is used: the first identity comes from
`F² g(h) v = 0` and the second from applying `x²` to the first.
-/

namespace VOA.DeligneAudit.SL4T

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.A3Sector

noncomputable section

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule bracketTable V)

/-- Commutation of two currents whose bracket is a single multiple of one colour. -/
theorem op_comm_of_single_bracket {a b c : Fin 15} {k : ℤ}
    (hab : ∀ e, bracketInt a b e = if e = c then k else 0) (r s : ℕ) (v : V) :
    ρ.op a r (ρ.op b s v) = ρ.op b s (ρ.op a r v) + (k : ℂ) • ρ.op c (r + s) v := by
  have h := ρ.comm a b r s v
  have hs : (∑ e, bracketTable a b e • ρ.op e (r + s) v) = (k : ℂ) • ρ.op c (r + s) v := by
    simp only [bracketTable, hab, Int.cast_ite, Int.cast_zero, ite_smul, zero_smul,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]
  rw [hs] at h
  exact sub_eq_iff_eq_add'.mp h

/-- Commutation of two currents with vanishing bracket. -/
theorem op_comm_of_zero_bracket {a b : Fin 15} (hab : ∀ e, bracketInt a b e = 0)
    (r s : ℕ) (v : V) : ρ.op a r (ρ.op b s v) = ρ.op b s (ρ.op a r v) := by
  have h := ρ.comm a b r s v
  simp only [bracketTable, hab, Int.cast_zero, zero_smul, Finset.sum_const_zero] at h
  exact sub_eq_zero.mp h

/-- `[F, g] = q`. -/
theorem bracket_last_middle (e : Fin 15) :
    bracketInt 11 9 e = if e = 10 then 1 else 0 := by
  fin_cases e <;> decide

/-- `[F, y] = z`. -/
theorem bracket_last_compound (e : Fin 15) :
    bracketInt 11 7 e = if e = 8 then 1 else 0 := by
  fin_cases e <;> decide

/-- `[x, q] = -z`. -/
theorem bracket_first_lastPair (e : Fin 15) :
    bracketInt 6 10 e = if e = 8 then -1 else 0 := by
  fin_cases e <;> decide

/-- `[g, x] = y`. -/
theorem bracket_middle_first (e : Fin 15) :
    bracketInt 9 6 e = if e = 7 then 1 else 0 := by
  fin_cases e <;> decide

/-- `[F, q] = 0`. -/
theorem bracket_last_lastPair (e : Fin 15) : bracketInt 11 10 e = 0 := by
  fin_cases e <;> decide

/-- `[F, x] = 0`. -/
theorem bracket_last_first (e : Fin 15) : bracketInt 11 6 e = 0 := by
  fin_cases e <;> decide

/-- `[F, z] = 0`. -/
theorem bracket_last_highest (e : Fin 15) : bracketInt 11 8 e = 0 := by
  fin_cases e <;> decide

/-- `[x, z] = 0`. -/
theorem bracket_first_highest (e : Fin 15) : bracketInt 6 8 e = 0 := by
  fin_cases e <;> decide

/-- `[x, y] = 0`. -/
theorem bracket_first_compound (e : Fin 15) : bracketInt 6 7 e = 0 := by
  fin_cases e <;> decide

/-- `[z, y] = 0`. -/
theorem bracket_highest_compound (e : Fin 15) : bracketInt 8 7 e = 0 := by
  fin_cases e <;> decide

/-- `[x, F] = 0`. -/
theorem bracket_first_last (e : Fin 15) : bracketInt 6 11 e = 0 := by
  fin_cases e <;> decide

/-- `[z, F] = 0`. -/
theorem bracket_highest_last (e : Fin 15) : bracketInt 8 11 e = 0 := by
  fin_cases e <;> decide

/-- At a node with label one, the square of the zero-mode lowering current kills the generator. -/
theorem lowering_square_of_label_one (w : V) (weight : Fin 3 → ℕ)
    (h : LocalWeylRel ρ w weight) (i : Fin 3) (hi : weight i = 1) :
    ρ.op (simpleF i) 0 (ρ.op (simpleF i) 0 w) = 0 := by
  have hl := h.lowering i
  rw [hi] at hl
  simpa only [Function.iterate_succ, Function.comp_apply, Function.iterate_zero,
    id_eq] using hl

/-- **Transported relations.** If `v` satisfies the local Weyl relations of weight `(1, B, 1)`
and `f₂(h) v = 0`, then `q(h) F v = 0` and `z(h) x F v = 0`. -/
theorem adjointSite_transported_relations (w : V) (B h : ℕ)
    (hW : LocalWeylRel ρ w (weightABC 1 B 1)) (hg : ρ.op 9 h w = 0) :
    ρ.op 10 h (ρ.op 11 0 w) = 0 ∧ ρ.op 8 h (ρ.op 6 0 (ρ.op 11 0 w)) = 0 := by
  have hF2 : ρ.op 11 0 (ρ.op 11 0 w) = 0 :=
    lowering_square_of_label_one ρ w _ hW 2 rfl
  have hx2 : ρ.op 6 0 (ρ.op 6 0 w) = 0 :=
    lowering_square_of_label_one ρ w _ hW 0 rfl
  -- `F g(h) = g(h) F + q(h)` and `F q(h) = q(h) F`.
  have hFg (u : V) : ρ.op 11 0 (ρ.op 9 h u) = ρ.op 9 h (ρ.op 11 0 u) + ρ.op 10 h u := by
    simpa only [zero_add, Int.cast_one, one_smul] using
      op_comm_of_single_bracket ρ bracket_last_middle 0 h u
  have hFq (u : V) : ρ.op 11 0 (ρ.op 10 h u) = ρ.op 10 h (ρ.op 11 0 u) :=
    op_comm_of_zero_bracket ρ bracket_last_lastPair 0 h u
  have hq : ρ.op 10 h (ρ.op 11 0 w) = 0 := by
    have h0 : ρ.op 11 0 (ρ.op 11 0 (ρ.op 9 h w)) = 0 := by rw [hg, map_zero, map_zero]
    rw [hFg, map_add, hFg, hFq, hF2, map_zero, zero_add] at h0
    have h2 : (2 : ℂ) • ρ.op 10 h (ρ.op 11 0 w) = 0 := by rw [two_smul]; exact h0
    exact (smul_eq_zero.mp h2).resolve_left (by norm_num)
  refine ⟨hq, ?_⟩
  -- `x q(h) = q(h) x - z(h)` and `x z(h) = z(h) x`.
  have hxq (u : V) : ρ.op 6 0 (ρ.op 10 h u) = ρ.op 10 h (ρ.op 6 0 u) - ρ.op 8 h u := by
    have hc := op_comm_of_single_bracket ρ bracket_first_lastPair 0 h u
    rw [zero_add] at hc
    rw [hc]
    simp [sub_eq_add_neg]
  have hxz (u : V) : ρ.op 6 0 (ρ.op 8 h u) = ρ.op 8 h (ρ.op 6 0 u) :=
    op_comm_of_zero_bracket ρ bracket_first_highest 0 h u
  have hxF (u : V) : ρ.op 6 0 (ρ.op 11 0 u) = ρ.op 11 0 (ρ.op 6 0 u) :=
    op_comm_of_zero_bracket ρ bracket_first_last 0 0 u
  have hxxF : ρ.op 6 0 (ρ.op 6 0 (ρ.op 11 0 w)) = 0 := by
    rw [hxF, hxF, hx2, map_zero]
  have h0 : ρ.op 6 0 (ρ.op 6 0 (ρ.op 10 h (ρ.op 11 0 w))) = 0 := by
    rw [hq, map_zero, map_zero]
  rw [hxq, map_sub, hxq, hxz, hxxF, map_zero, zero_sub] at h0
  have h2 : (2 : ℂ) • ρ.op 8 h (ρ.op 6 0 (ρ.op 11 0 w)) = 0 := by
    rw [two_smul, ← neg_eq_zero, neg_add']
    exact h0
  exact (smul_eq_zero.mp h2).resolve_left (by norm_num)

end

end VOA.DeligneAudit.SL4T
