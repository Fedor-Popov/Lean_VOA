import VOA.DeligneAudit.D4LeviKSSymmetricXYZ
import VOA.DeligneAudit.D4LeviKSRzShift
import VOA.DeligneAudit.D4LeviKSMixedXLower
import VOA.DeligneAudit.D4LeviKSMixedYLower

/-! Closure of fixed-shape XYZ relations under the colour power-sum algebra. -/

namespace VOA.DeligneAudit.D4Levi

open MvPolynomial
open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4
open VOA.DeligneAudit.LeviConversion

/-- The algebra generated by positive positional power sums in X, Y, Z. -/
noncomputable def xyzPowerSumAlgebra {σ : Type*} [Fintype σ]
    (shape : σ → Fin 6) : Subalgebra ℂ (MvPolynomial σ ℂ) :=
  Algebra.adjoin ℂ {P | ∃ (j : Fin 6) (r : ℕ),
    (j = 1 ∨ j = 4 ∨ j = 5) ∧ 0 < r ∧ P = colourPsum shape j r}

variable {V : Type} [AddCommGroup V] [Module ℂ V]

/-- Every polynomial in the three colour power sums preserves an evaluated
    XYZ relation in a fixed descending key prefix. -/
theorem xyzPowerSumAlgebra_prefix {σ : Type*} [Fintype σ]
    (ρ : CurrentModule D4sector.f V) (w : V) (m i : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0))
    (hi : i < (globalKeyBox m).card)
    (shape : σ → Fin 6)
    (hshape : ∀ t, shape t = 1 ∨ shape t = 4 ∨ shape t = 5)
    (P : MvPolynomial σ ℂ) (hP : P ∈ xyzPowerSumAlgebra shape)
    (W : MvPolynomial σ ℂ)
    (hW : xyzEvaluation ρ w shape W ∈ keyPrefix ρ w m i) :
    xyzEvaluation ρ w shape (symmetricShiftAction σ P W) ∈
      keyPrefix ρ w m i := by
  let N := (keyPrefix ρ w m i).comap (xyzEvaluation ρ w shape)
  have hInv (q : Fin 3) (r : ℕ) (v : V)
      (hv : v ∈ keyPrefix ρ w m i) :
      selectiveCartan ρ q r v ∈ keyPrefix ρ w m i := by
    rw [keyPrefix_eq_higher ρ w m h i hi] at hv ⊢
    exact selectiveCartan_higher ρ w m q r _ hv
  have hgen : ∀ Q ∈ {P | ∃ (j : Fin 6) (r : ℕ),
      (j = 1 ∨ j = 4 ∨ j = 5) ∧ 0 < r ∧ P = colourPsum shape j r},
      Q ∈ preservingShiftAlgebra (MvPolynomial σ ℂ)
        (symmetricShiftAction σ) N := by
    intro Q hQ
    obtain ⟨j, r, hj, hr, rfl⟩ := hQ
    intro U hU
    change xyzEvaluation ρ w shape
      (symmetricShiftAction σ (colourPsum shape j r) U) ∈
        keyPrefix ρ w m i
    have hc := xyzEvaluation_psum_intertwine ρ w m h shape hshape j hj r hr U
    have hh := hInv (if j = 1 then 0 else if j = 4 then 1 else 2)
      r _ hU
    rw [hc] at hh
    have hne : (if j = 5 then (1 : ℂ) else 2) ≠ 0 := by
      split_ifs <;> norm_num
    have hdiv := (keyPrefix ρ w m i).smul_mem
      (if j = 5 then (1 : ℂ) else 2)⁻¹ hh
    simpa only [smul_smul, inv_mul_cancel₀ hne, one_smul] using hdiv
  have hsub : xyzPowerSumAlgebra shape ≤
      preservingShiftAlgebra (MvPolynomial σ ℂ)
        (symmetricShiftAction σ) N := by
    exact Algebra.adjoin_le hgen
  exact hsub hP W hW

/-- Rx after any colour power-sum polynomial, given a word-polynomial
    representation of the existing XZG contraction. -/
theorem rx_family_prefix_of_evaluation {σ : Type*} [Fintype σ]
    (ρ : CurrentModule D4sector.f V) (w : V) (m i : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0))
    (rs ys : List ℕ) (c s : ℕ)
    (hK : 1 ≤ rs.length) (hks : m + 1 ≤ c + rs.length + s)
    (hi : i < (globalKeyBox m).card)
    (hkey : keyEnum m ⟨i, hi⟩ =
      rzKey (List.replicate rs.length 0) ys [] c (rs.sum + ys.sum + s))
    (shape : σ → Fin 6)
    (hshape : ∀ t, shape t = 1 ∨ shape t = 4 ∨ shape t = 5)
    (W P : MvPolynomial σ ℂ)
    (hW : xyzEvaluation ρ w shape W =
      mixedTop (yOp ρ) (zOp ρ) c s (ys ++ List.replicate c 0)
        (rs.map (transportCurrent (xOp ρ))).prod w)
    (hP : P ∈ xyzPowerSumAlgebra shape) :
    xyzEvaluation ρ w shape (symmetricShiftAction σ P W) ∈
      keyPrefix ρ w m i := by
  apply xyzPowerSumAlgebra_prefix ρ w m i h hi shape hshape P hP W
  rw [hW]
  exact xz_full_contractions_prefix ρ w m h rs ys c s i hK hks hi hkey

/-- Ry after any colour power-sum polynomial, given a word-polynomial
    representation of the existing YZG contraction. -/
theorem ry_family_prefix_of_evaluation {σ : Type*} [Fintype σ]
    (ρ : CurrentModule D4sector.f V) (w : V) (m i : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0))
    (rs xs : List ℕ) (c s : ℕ)
    (hK : 1 ≤ rs.length) (hks : m + 1 ≤ c + rs.length + s)
    (hi : i < (globalKeyBox m).card)
    (hkey : keyEnum m ⟨i, hi⟩ =
      rzKey xs (List.replicate rs.length 0) [] c (rs.sum + xs.sum + s))
    (shape : σ → Fin 6)
    (hshape : ∀ t, shape t = 1 ∨ shape t = 4 ∨ shape t = 5)
    (W P : MvPolynomial σ ℂ)
    (hW : xyzEvaluation ρ w shape W =
      mixedTop (xOp ρ) (zOp ρ) c s (xs ++ List.replicate c 0)
        (rs.map (transportCurrent (yOp ρ))).prod w)
    (hP : P ∈ xyzPowerSumAlgebra shape) :
    xyzEvaluation ρ w shape (symmetricShiftAction σ P W) ∈
      keyPrefix ρ w m i := by
  apply xyzPowerSumAlgebra_prefix ρ w m i h hi shape hshape P hP W
  rw [hW]
  exact yz_full_contractions_prefix ρ w m h rs xs c s i hK hks hi hkey

/-- Rz after any colour power-sum polynomial, given a word-polynomial
    representation of the existing graded Y to Z contraction. -/
theorem rz_family_prefix_of_evaluation {σ : Type*} [Fintype σ]
    (ρ : CurrentModule D4sector.f V) (w : V) (m i : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0))
    (xs ys zs : List ℕ) (k s : ℕ)
    (hk : 1 ≤ k) (hks : m + 1 ≤ k + s)
    (hi : i < (globalKeyBox m).card)
    (hkey : keyEnum m ⟨i, hi⟩ =
      rzKey xs ys zs k (xs.sum + ys.sum + zs.sum + s))
    (shape : σ → Fin 6)
    (hshape : ∀ t, shape t = 1 ∨ shape t = 4 ∨ shape t = 5)
    (W P : MvPolynomial σ ℂ)
    (hW : xyzEvaluation ρ w shape W =
      topSum (yOp ρ) (zOp ρ) k s (ys ++ List.replicate k 0) •
        (((xs.map (xOp ρ)).prod * (zs.map (zOp ρ)).prod) • w))
    (hP : P ∈ xyzPowerSumAlgebra shape) :
    xyzEvaluation ρ w shape (symmetricShiftAction σ P W) ∈
      keyPrefix ρ w m i := by
  apply xyzPowerSumAlgebra_prefix ρ w m i h hi shape hshape P hP W
  rw [hW]
  exact rz_top_prefix ρ w m h xs ys zs k s i hk hks hi hkey

end VOA.DeligneAudit.D4Levi

