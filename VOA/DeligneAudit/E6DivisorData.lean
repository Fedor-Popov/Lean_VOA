import VOA.DeligneAudit.DeligneDivisorNumeric
import VOA.DeligneAudit.E6DivisorRawTab
import VOA.DeligneAudit.E6DivisorRawPar
import VOA.DeligneAudit.E6DivisorRawU
import VOA.DeligneAudit.E6DivisorRawUc
import VOA.DeligneAudit.E6DivisorRawAnti
import VOA.DeligneAudit.E6DivisorRawSym
import VOA.DeligneAudit.E6DivisorRawPsi
import VOA.DeligneAudit.E6DivisorRawCol
import VOA.DeligneAudit.E6CarrierTables
import VOA.AffineGeneral.E6Table

/-!
# E₆ two-slot data for the pair comparison (generated)

Generated by `Notes/deligne/campaign/generators/gen_e6_pair.py` from `cert_E6.json` and the relations
(flat natural-number encodings, sign-magnitude integers `E6Sparse.decZ`).

* `tabR`, `parR`: the generation tree of `g* ⊗ g*` (6084 tables) from `δ₇₇⊗δ₇₇` by `S_x`, `A_x`:
  level 0 (2430, `V(2θ)`), level 1 (3003, `Λ²`), level 2 (651); depth `≤ 4`;
* `UR`, `UcR`: the complement tables `U_r` (432 × the `ψ`-dual of level 2) and their level-2 certificates;
* `antiR`, `symR`: certificates for `12 (e_c⊗e_d - e_d⊗e_c)` (level ≤ 1) and
  `216 (e_c⊗e_d + e_d⊗e_c) - Σ_r ψ_r(c,d) U_r` (level 0); `psiR`: relations containing `{c, d}`.

The Boolean checks are defined here and evaluated in `E6DivisorChecks*`.
-/

namespace VOA.DeligneAudit.DeligneDivisor.E6

open VOA.DeligneAudit.DeligneSector.Sparse
open VOA.DeligneAudit.DeligneDivisor
open VOA.DeligneAudit.E6Sparse (decZ quadOf)

set_option linter.style.longLine false
set_option maxRecDepth 100000

/-- Decode a flat `c z c z …` list. -/
def pairsOf : List ℕ → SV
  | c :: z :: r => (c, decZ z) :: pairsOf r
  | _ => []

/-- The `𝔢₆` brackets: the table `e6T` (the field `structure` of `cert_E6.json`). -/
def br (a b : ℕ) : SV := VOA.AffineGeneral.SCLie.entry VOA.AffineGeneral.SCLie.e6T a b

/-- Relation `k` (`650` = Casimir), as an integer sparse form. -/
def relZ6 (k : ℕ) : QV :=
  if k < 650 then VOA.DeligneAudit.DeligneCarrier.E6.relQ k else VOA.DeligneAudit.DeligneCarrier.E6.qQ

/-- Index ranges of the relations. -/
def relRange6 : Bool :=
  (List.range 651).all fun r => (relZ6 r).all fun t => decide (t.1 < 78) && decide (t.2.1 < 78)

/-- Decode flat `j z` pairs. -/
def zpairs : List ℕ → List (ℕ × ℤ)
  | j :: z :: r => (j, decZ z) :: zpairs r
  | _ => []

/-- Table `i`. -/
def tab (i : ℕ) : QV := quadOf ((tabR.getD (i / 78) []).getD (i % 78) [])

/-- Tree data of node `i`. -/
def par (i : ℕ) : ℕ × Bool × ℕ × ℕ × ℕ :=
  let l := (parR.getD (i / 78) []).getD (i % 78) []
  (l.getD 0 0, l.getD 1 0 == 1, l.getD 2 0, l.getD 3 0, l.getD 4 0)

/-- The table `U_k`. -/
def Uq (k : ℕ) : QV := quadOf ((UR.getD (k / 93) []).getD (k % 93) [])

/-- The certificate of `U_k`. -/
def Ucert (k : ℕ) : List (ℕ × ℤ) := zpairs ((UcR.getD (k / 93) []).getD (k % 93) [])

/-- The antisymmetric certificate of `(c, d)`. -/
def antiCert (c d : ℕ) : List (ℕ × ℤ) := zpairs ((antiR.getD c []).getD d [])

/-- The symmetric certificate of `(c, d)`. -/
def symCert (c d : ℕ) : List (ℕ × ℤ) := zpairs ((symR.getD c []).getD d [])

/-- The relations containing the monomial `{c, d}`. -/
def psiT (c d : ℕ) : List ℕ := (psiR.getD c []).getD d []

/-- Bracket columns. -/
def colE6 (x e : ℕ) : SV := pairsOf ((colR.getD x []).getD e [])

/-- `ψ_k(c,d) = q_k(c,d) + q_k(d,c)`. -/
def psiZ (k c d : ℕ) : ℤ := qget (relZ6 k) c d + qget (relZ6 k) d c

/-- `-Σ_{k ∈ psiT c d} ψ_k(c,d) U_k`. -/
def psiList (c d : ℕ) : QV := (psiT c d).flatMap fun k => smulQ (-(psiZ k c d)) (Uq k)

/-- `e_c⊗e_d + e_d⊗e_c`. -/
def symQ (c d : ℕ) : QV := [(c, d, 1), (d, c, 1)]

/-- `e_c⊗e_d - e_d⊗e_c`. -/
def antiQ (c d : ℕ) : QV := [(c, d, 1), (d, c, -1)]

/-- All entries are tree nodes of level `≤ ℓ`. -/
def levOf (L : List (ℕ × ℤ)) (ℓ : ℕ) : Bool :=
  L.all fun p => decide (p.1 < 6084) && decide ((par p.1).2.2.2.2 ≤ ℓ)

/-- Tree node checks for `i ∈ [lo, hi)`. -/
def nodeChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun i => nodeCheckC 78 colE6 tab par i

/-- Column checks. -/
def colChecks : Bool := (List.range 78).all fun x => colCheck br colE6 78 x

/-- Depth bound. -/
def depthCheck : Bool := (List.range 6084).all fun i => decide ((par i).2.2.2.1 ≤ 4)

/-- The antisymmetric check for `(c, d)`. -/
def antiCheck (c d : ℕ) : Bool :=
  levOf (antiCert c d) 1 && encLin 78 tab (smulQ 12 (antiQ c d)) (antiCert c d)

/-- The check of `U_k`. -/
def UCheck (k : ℕ) : Bool :=
  levOf (Ucert k) 2 && encLin 78 tab (Uq k) (Ucert k)

/-- Tree tables (`i < 6084`) followed by the complement tables (`6084 + k`). -/
def tabX (i : ℕ) : QV := if i < 6084 then tab i else Uq (i - 6084)

/-- The full symmetric certificate: tree tables and `ψ_k(c,d) U_k`. -/
def symCertX (c d : ℕ) : List (ℕ × ℤ) :=
  symCert c d ++ (psiT c d).map fun k => (6084 + k, psiZ k c d)

/-- The symmetric check for `(c, d)`. -/
def symCheck (c d : ℕ) : Bool :=
  levOf (symCert c d) 0 && (psiT c d).Nodup && (psiT c d).all (fun k => decide (k < 651)) &&
    encLin 78 tabX (smulQ 216 (symQ c d)) (symCertX c d)

/-- Completeness of `psiT`: every relation term `(i, j)` is listed under `{min, max}`. -/
def psiComplete : Bool :=
  (List.range 651).all fun k => (relZ6 k).all fun t =>
    decide (k ∈ psiT (min t.1 t.2.1) (max t.1 t.2.1))

/-- Antisymmetric checks for rows `c ∈ [lo, hi)`. -/
def antiChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun c => (List.range 78).all fun d => !decide (c < d) || antiCheck c d

/-- Symmetric checks for rows `c ∈ [lo, hi)`. -/
def symChecks (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun c => (List.range 78).all fun d => !decide (c ≤ d) || symCheck c d

end VOA.DeligneAudit.DeligneDivisor.E6
