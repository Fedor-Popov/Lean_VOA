import VOA.DeligneAudit.SL4TColourStratumPresentation

/-! Tail ideals and exact stratum dimensions in the colour partial-flag coefficient ring. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

variable {C : Type*} [DecidableEq C] {B : ℕ} (colour : Fin B → C)

/-- The partial-flag coefficient ring, with positive full-alphabet elementary functions zero. -/
abbrev ColourFlagRing := ColourPolynomialRing colour ⧸ colourSymmetricIdeal colour

/-- A colour-block power sum in the partial-flag coefficient ring. -/
def colourFlagPowerSum (c : C) (s : ℕ) : ColourFlagRing colour :=
  Ideal.Quotient.mk _ (colourPolynomialPowerSum colour c s)

/-- The image of all colour-block power sums above the cutoff in the partial-flag ring. -/
def colourFlagTailIdeal (N : ℕ) : Ideal (ColourFlagRing colour) :=
  (colourPowerSumTailIdeal colour N).map (Ideal.Quotient.mk _)

/-- In the partial-flag ring the tail is still generated by the actual block power sums. -/
theorem colourFlagTailIdeal_eq_span (N : ℕ) :
    colourFlagTailIdeal colour N =
      Ideal.span {p | ∃ c s, N ≤ s ∧ colourFlagPowerSum colour c s = p} := by
  rw [colourFlagTailIdeal, colourPowerSumTailIdeal, Ideal.map_span]
  congr 1
  ext p
  constructor
  · rintro ⟨a, ⟨c, s, hs, rfl⟩, rfl⟩
    exact ⟨c, s, hs, rfl⟩
  · rintro ⟨c, s, hs, rfl⟩
    exact ⟨colourPolynomialPowerSum colour c s, ⟨c, s, hs, rfl⟩, rfl⟩

/-- The top-minor stratum ideal in the partial-flag coefficient ring. -/
def colourFlagTopIdeal (selected : Finset C) (N j : ℕ) : Ideal (ColourFlagRing colour) :=
  (colourRemainderTopIdeal colour selected N j).map (Ideal.Quotient.mk _)

/-- Imposing the tail and the stratum after the elementary relations is the same quotient. -/
def colourFlagStratumQuotientEquiv (selected : Finset C) (N j : ℕ) :
    (ColourFlagRing colour ⧸
      (colourFlagTailIdeal colour N ⊔ colourFlagTopIdeal colour selected N j)) ≃ₐ[ℂ]
        ColourTailStratumRing colour selected N j := by
  change ((ColourPolynomialRing colour ⧸ colourSymmetricIdeal colour) ⧸
    ((colourPowerSumTailIdeal colour N).map (Ideal.Quotient.mk _) ⊔
      (colourRemainderTopIdeal colour selected N j).map (Ideal.Quotient.mk _))) ≃ₐ[ℂ] _
  rw [← Ideal.map_sup]
  exact (DoubleQuot.quotQuotEquivQuotSupₐ ℂ (colourSymmetricIdeal colour)
    (colourPowerSumTailIdeal colour N ⊔ colourRemainderTopIdeal colour selected N j)).trans
      (Ideal.quotientEquivAlgOfEq ℂ (sup_assoc _ _ _).symm)

/-- The tail-plus-stratum quotient of the partial-flag ring has the refined orbit dimension. -/
theorem colourFlagTailStratum_finrank (k j : ℕ) (hk : 2 * k ≤ B) (selected : Finset C) :
    let R := ColourFlagRing colour ⧸
      (colourFlagTailIdeal colour (B - k) ⊔ colourFlagTopIdeal colour selected (B - k) j)
    FiniteDimensional ℂ R ∧ Module.finrank ℂ R =
      Nat.card (Set.range (fun f : FullFlagStratumConfiguration B k j
        (selectedColourPositions colour selected) =>
          configurationColourMultiplicity colour f.val)) := by
  obtain ⟨hf, hd⟩ := colourTailStratum_finrank colour k j hk selected
  letI := hf
  let e := (colourFlagStratumQuotientEquiv colour selected (B - k) j).toLinearEquiv
  exact ⟨Module.Finite.of_injective e.toLinearMap e.injective, e.finrank_eq.trans hd⟩

/-- Reynolds descent with the concrete tail and minor generators, as an algebra equivalence. -/
def colourFlagStratumInvariantEquiv (k j : ℕ) (hk : 2 * k ≤ B) (selected : Finset C) :
    let η := (positionColourSubgroup colour).subtype
    let hY := positionColourSubgroup_preserves_selected colour selected
    let Y := selectedColourPositions colour selected
    (ColourFlagRing colour ⧸
      (colourFlagTailIdeal colour (B - k) ⊔ colourFlagTopIdeal colour selected (B - k) j)) ≃ₐ[ℂ]
        finiteActionFixedSubalgebra
          (stableIdealQuotientAlgebraAction (polynomialPositionAlgebraAction η)
            (fullFlagTruncationIdeal B (B - k) ⊔
              remainderTopIdeal (fullFlagSubalphabet Y) (B - k) j)
            (fullFlagStratumIdeal_algebra_stable B k j Y hk η hY)) := by
  letI := Fintype.ofFinite (positionColourSubgroup colour)
  dsimp only
  refine (colourFlagStratumQuotientEquiv colour selected (B - k) j).trans ?_
  exact (Ideal.quotientEquivAlgOfEq ℂ
    (colourStratumIdeal_contract colour selected (B - k) j).symm).trans
      (fixedPolynomialQuotientEquiv
        (polynomialPositionAlgebraAction (positionColourSubgroup colour).subtype) _
        (fullFlagStratumIdeal_algebra_stable B k j _ hk _
          (positionColourSubgroup_preserves_selected colour selected)))

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.colourFlagTailIdeal_eq_span
#print axioms VOA.DeligneAudit.SL4T.colourFlagStratumQuotientEquiv
#print axioms VOA.DeligneAudit.SL4T.colourFlagTailStratum_finrank
#print axioms VOA.DeligneAudit.SL4T.colourFlagStratumInvariantEquiv
