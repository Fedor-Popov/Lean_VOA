import VOA.DeligneAudit.D4FusionToroidalGarland2

/-!
# The uniform corrected-lift expansion and the full `Jprime` package

The corrected universal lift `d4_correctedLift m j N` is expressed through Garland
coefficients multiplied by low theta modes (`d4_lowGarland`), for every `m`.  The
identity is pure commutative algebra in the subalgebra generated by the pairwise
commuting theta modes `f_r = d4Ftheta m r`: with `A(z) = ∑_{r<m} f_r z^r`,
`B(z) = ∑_s f_{m+s} z^s`, `f(z) = A(z) + z^m B(z)`, `x = A`, `y = z^m B`, `w = x + y`,

`x y^j + (j/(j+1)) y^{j+1} = ∑_{a<j} c_a x^a w^{j+1-a} + ((-1)^j/(j+1)) x^{j+1}`,

and the last term has no coefficient in degree `N + jm` because `A` is a polynomial of
degree below `m`.  Extracting the coefficient of `z^{N+jm}` and evaluating on the
generator gives `D4CorrectedLiftExpansion m`, hence `JprimeLeAnnGr m hm` for every `m`.
-/

namespace VOA.DeligneAudit.Toroidal

open VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneSector.D4
  VOA.DeligneAudit.SectorWeyl

open PowerSeries
open scoped IsMulCommutative

noncomputable section

/-! ## The abstract identity in a commutative `ℂ`-algebra -/

section Abstract

variable {R : Type*} [CommRing R] [Algebra ℂ R]

/-- The signed binomial expansion of `(w - x)^j`, with `ℂ`-scalar coefficients. -/
theorem d4_signed_binomial (x w : R) (j : ℕ) :
    (w - x) ^ j = ∑ a ∈ Finset.range (j + 1),
      ((-1 : ℂ) ^ a * (j.choose a : ℂ)) • (x ^ a * w ^ (j - a)) := by
  rw [sub_eq_neg_add, add_pow]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [neg_pow, Algebra.smul_def, map_mul, map_pow, map_neg, map_one, map_natCast]
  ring

/-- The uniform identity behind the corrected lift, in formal commuting variables. -/
theorem d4_abstract_identity (x y : R) (j : ℕ) (hj : 1 ≤ j) :
    x * y ^ j + ((j : ℂ) / (j + 1)) • y ^ (j + 1) =
      ∑ a ∈ Finset.range j,
        d4_identityCoeff j a • (x ^ a * (x + y) ^ (j + 1 - a)) +
        ((-1 : ℂ) ^ j / (j + 1)) • x ^ (j + 1) := by
  obtain ⟨k, rfl⟩ : ∃ k, j = k + 1 := ⟨j - 1, by omega⟩
  set D : ℕ → R := fun a =>
    ((-1 : ℂ) ^ a * ((k + 1).choose a : ℂ)) • (x ^ a * (x + y) ^ (k + 1 - a)) with hD
  have hS : ∑ a ∈ Finset.range (k + 1 + 1), D a = y ^ (k + 1) := by
    simp only [hD]
    rw [← d4_signed_binomial x (x + y) (k + 1), add_sub_cancel_left]
  have hS1 : ∑ a ∈ Finset.range (k + 1), D a = y ^ (k + 1) - D (k + 1) := by
    rw [Finset.sum_range_succ] at hS
    rw [← hS]; abel
  have hS2 : ∑ a ∈ Finset.range k, D a = y ^ (k + 1) - D (k + 1) - D k := by
    rw [Finset.sum_range_succ, Finset.sum_range_succ] at hS
    rw [← hS]; abel
  have h1 : ∑ a ∈ Finset.range (k + 1),
      ((1 / (((k + 1 : ℕ) : ℂ) + 1)) * ((-1 : ℂ) ^ a * ((k + 1 : ℕ) : ℂ) *
        ((k + 1).choose a : ℂ))) • (x ^ a * (x + y) ^ (k + 1 + 1 - a)) =
      ((1 / (((k + 1 : ℕ) : ℂ) + 1)) * ((k + 1 : ℕ) : ℂ)) •
        ((x + y) * ∑ a ∈ Finset.range (k + 1), D a) := by
    rw [Finset.mul_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl fun a ha => ?_
    have ha' : a < k + 1 := Finset.mem_range.mp ha
    rw [show k + 1 + 1 - a = (k + 1 - a) + 1 by omega, pow_succ, hD]
    simp only [Algebra.smul_def, map_mul, map_pow, map_neg, map_one, map_natCast]
    ring
  have h2 : ∑ a ∈ Finset.range (k + 1),
      ((1 / (((k + 1 : ℕ) : ℂ) + 1)) * ((-1 : ℂ) ^ a *
        (if a = 0 then 0 else ((k + 1).choose (a - 1) : ℂ)))) •
        (x ^ a * (x + y) ^ (k + 1 + 1 - a)) =
      -((1 / (((k + 1 : ℕ) : ℂ) + 1)) • (x * ∑ b ∈ Finset.range k, D b)) := by
    rw [Finset.sum_range_succ', Finset.mul_sum, Finset.smul_sum, ← Finset.sum_neg_distrib]
    rw [if_pos rfl, mul_zero, mul_zero, zero_smul, add_zero]
    refine Finset.sum_congr rfl fun b hb => ?_
    rw [if_neg (Nat.succ_ne_zero b), Nat.add_sub_cancel,
      show k + 1 + 1 - (b + 1) = k + 1 - b by omega, hD]
    simp only [Algebra.smul_def, map_mul, map_pow, map_neg, map_one, map_natCast, pow_succ]
    ring
  have hc : ∀ a, d4_identityCoeff (k + 1) a =
      (1 / (((k + 1 : ℕ) : ℂ) + 1)) * ((-1 : ℂ) ^ a * ((k + 1 : ℕ) : ℂ) *
        ((k + 1).choose a : ℂ)) -
      (1 / (((k + 1 : ℕ) : ℂ) + 1)) *
        ((-1 : ℂ) ^ a * (if a = 0 then 0 else ((k + 1).choose (a - 1) : ℂ))) := by
    intro a
    unfold d4_identityCoeff
    ring
  simp_rw [hc, sub_smul]
  rw [Finset.sum_sub_distrib, h1, h2, hS1, hS2]
  have hu : algebraMap ℂ R (1 / (((k + 1 : ℕ) : ℂ) + 1)) * (((k + 1 : ℕ) : R) + 1) = 1 := by
    rw [← map_natCast (algebraMap ℂ R), ← map_one (algebraMap ℂ R), ← map_add,
      ← map_mul, one_div, inv_mul_cancel₀ (Nat.cast_add_one_ne_zero (k + 1)), map_one]
  have hDk : D k = ((-1 : ℂ) ^ k * ((k + 1 : ℕ) : ℂ)) • (x ^ k * (x + y)) := by
    simp only [hD, Nat.choose_succ_self_right, Nat.add_sub_cancel_left, pow_one, Nat.cast_add,
      Nat.cast_one]
  have hDk1 : D (k + 1) = ((-1 : ℂ) ^ (k + 1)) • x ^ (k + 1) := by
    simp only [hD, Nat.choose_self, Nat.sub_self, pow_zero, mul_one, Nat.cast_one]
  rw [hDk, hDk1, div_eq_mul_one_div ((k + 1 : ℕ) : ℂ),
    div_eq_mul_one_div ((-1 : ℂ) ^ (k + 1))]
  simp only [Algebra.smul_def, map_mul, map_pow, map_neg, map_one, map_natCast, pow_succ]
  push_cast at hu ⊢
  linear_combination (-(x * y ^ (k + 1))) * hu

end Abstract

/-! ## Coefficient vanishing for powers of a truncated series -/

/-- If `A` has no coefficients from degree `m` on, `A^k` has none beyond `k (m - 1)`. -/
theorem coeff_pow_eq_zero_of_coeff_eq_zero {S : Type*} [Semiring S] (A : PowerSeries S)
    (m : ℕ) (hA : ∀ i, m ≤ i → coeff i A = 0) (k : ℕ) :
    ∀ n, k * (m - 1) < n → coeff n (A ^ k) = 0 := by
  induction k with
  | zero =>
      intro n hn
      rw [pow_zero, coeff_one, if_neg]
      omega
  | succ k ih =>
      intro n hn
      rw [pow_succ', coeff_mul]
      apply Finset.sum_eq_zero
      intro p hp
      have hpq := Finset.mem_antidiagonal.mp hp
      rw [add_mul, one_mul] at hn
      by_cases hpm : m ≤ p.1
      · rw [hA p.1 hpm, zero_mul]
      · rw [ih p.2 (by omega), mul_zero]

/-! ## Coefficient bookkeeping and the generic assembly -/

section Generic

variable {R : Type*} [CommRing R]

theorem coeff_shift_low (A B : PowerSeries R) (m j N : ℕ) :
    coeff (N + j * m) (A * (X ^ m * B) ^ j) = coeff N (A * B ^ j) := by
  rw [mul_pow, ← pow_mul, mul_left_comm, show N + j * m = N + m * j by ring,
    coeff_X_pow_mul]

theorem coeff_shift_high (B : PowerSeries R) (m j N : ℕ) :
    coeff (N + j * m) ((X ^ m * B) ^ (j + 1)) = coeff N (X ^ m * B ^ (j + 1)) := by
  rw [mul_pow, ← pow_mul, show m * (j + 1) = m * j + m by ring, pow_add, mul_assoc,
    show N + j * m = N + m * j by ring, coeff_X_pow_mul]

theorem coeff_pow_zero_of_range (A : PowerSeries R) (m j N : ℕ) (hm : 1 ≤ m)
    (hN : m ≤ N + j) (hA : ∀ i, m ≤ i → coeff i A = 0) :
    coeff (N + j * m) (A ^ (j + 1)) = 0 := by
  apply coeff_pow_eq_zero_of_coeff_eq_zero A m hA
  have h1 : (j + 1) * (m - 1) + (j + 1) = (j + 1) * m := by
    calc
      (j + 1) * (m - 1) + (j + 1) = (j + 1) * ((m - 1) + 1) := by ring
      _ = (j + 1) * m := by rw [Nat.sub_add_cancel hm]
  have h2 : (j + 1) * m = j * m + m := by ring
  omega

/-- The coefficient identity, transported along a `ℂ`-linear ring map to a possibly
noncommutative target; all instance searches happen at generic types here. -/
theorem generic_assembly [Algebra ℂ R] {S : Type*} [Ring S] [Module ℂ S] (ι : R →+* S)
    (hι : ∀ (c : ℂ) (a : R), ι (c • a) = c • ι a) (A B : PowerSeries R) (m j N : ℕ)
    (hm : 1 ≤ m) (hj : 1 ≤ j) (hN : m ≤ N + j) (hA : ∀ i, m ≤ i → coeff i A = 0) :
    coeff N (PowerSeries.map ι A * (PowerSeries.map ι B) ^ j) +
        ((j : ℂ) / (j + 1)) • coeff N (X ^ m * (PowerSeries.map ι B) ^ (j + 1)) =
      ∑ a ∈ Finset.range j, d4_identityCoeff j a •
        coeff (N + j * m) ((PowerSeries.map ι A) ^ a *
          (PowerSeries.map ι (A + X ^ m * B)) ^ (j + 1 - a)) := by
  have hid := d4_abstract_identity (R := PowerSeries R) A (X ^ m * B) j hj
  have hcoef := congrArg (fun φ => ι (coeff (N + j * m) φ)) hid
  simp only [map_add, coeff_smul, map_sum, hι, coeff_shift_low, coeff_shift_high,
    coeff_pow_zero_of_range A m j N hm hN hA, smul_zero, add_zero, ← coeff_map,
    map_mul, map_pow, PowerSeries.map_X] at hcoef
  rw [hcoef]
  simp only [map_add, map_mul, map_pow, PowerSeries.map_X]

end Generic

/-! ## The commutative subalgebra of theta modes on `U_m` -/

section D4

/-- The commutative subalgebra of `End(U_m)` generated by the theta modes. -/
def d4ThetaAlg (m : ℕ) :
    Subalgebra ℂ (Module.End ℂ (UModG D4sector.f (ravFam D4sector m 0))) :=
  Algebra.adjoin ℂ (Set.range (d4Ftheta m))

instance d4ThetaAlg_isMulCommutative (m : ℕ) : IsMulCommutative (d4ThetaAlg m) :=
  Algebra.isMulCommutative_adjoin ℂ (by
    rintro _ ⟨r, rfl⟩ _ ⟨s, rfl⟩
    refine LinearMap.ext fun v => ?_
    exact d4Ftheta_comm m r s v)

/-- A theta mode as an element of the commutative subalgebra. -/
def d4fR (m r : ℕ) : d4ThetaAlg m :=
  ⟨d4Ftheta m r, Algebra.subset_adjoin ⟨r, rfl⟩⟩

/-- The inclusion of the commutative subalgebra. -/
def d4ι (m : ℕ) :
    d4ThetaAlg m →+* Module.End ℂ (UModG D4sector.f (ravFam D4sector m 0)) :=
  (d4ThetaAlg m).val.toRingHom

@[simp] theorem d4ι_d4fR (m r : ℕ) : d4ι m (d4fR m r) = d4Ftheta m r := rfl

@[simp] theorem d4ι_smul (m : ℕ) (c : ℂ) (a : d4ThetaAlg m) :
    d4ι m (c • a) = c • d4ι m a :=
  map_smul (d4ThetaAlg m).val c a

/-- `A(z) = ∑_{r<m} f_r z^r`. -/
def d4Aser (m : ℕ) : PowerSeries (d4ThetaAlg m) :=
  PowerSeries.mk fun r => if r < m then d4fR m r else 0

/-- `B(z) = ∑_s f_{m+s} z^s`. -/
def d4Bser (m : ℕ) : PowerSeries (d4ThetaAlg m) :=
  PowerSeries.mk fun s => d4fR m (m + s)

/-- `f(z) = ∑_r f_r z^r`. -/
def d4Fser (m : ℕ) : PowerSeries (d4ThetaAlg m) :=
  PowerSeries.mk (d4fR m)

theorem d4Fser_eq (m : ℕ) : d4Fser m = d4Aser m + X ^ m * d4Bser m := by
  ext n
  simp only [d4Fser, d4Aser, d4Bser, coeff_mk, map_add, coeff_X_pow_mul']
  by_cases h : n < m
  · simp [h, Nat.not_le.mpr h]
  · simp [h, Nat.le_of_not_lt h, Nat.add_sub_cancel' (Nat.le_of_not_lt h)]

theorem d4Aser_coeff_zero (m : ℕ) (i : ℕ) (hi : m ≤ i) : coeff i (d4Aser m) = 0 := by
  simp [d4Aser, coeff_mk, Nat.not_lt.mpr hi]

theorem d4_map_Fser (m : ℕ) :
    PowerSeries.map (d4ι m) (d4Fser m) = Garland.Fs (d4Ftheta m) := by
  ext n
  simp [coeff_map, d4Fser, coeff_mk, Garland.Fs]

theorem d4_map_Bser (m : ℕ) :
    PowerSeries.map (d4ι m) (d4Bser m) = Garland.Fs (fun s => d4Ftheta m (m + s)) := by
  ext n
  simp [coeff_map, d4Bser, coeff_mk, Garland.Fs]

theorem d4_coeff_map_Aser_apply (m r : ℕ) (w : UModG D4sector.f (ravFam D4sector m 0)) :
    (coeff r (PowerSeries.map (d4ι m) (d4Aser m))) w =
      if r < m then d4Ftheta m r w else 0 := by
  simp only [coeff_map, d4Aser, coeff_mk]
  split_ifs <;> simp

/-! ## Matching the explicit nested sums with coefficients -/

/-- A generic regrouping, stated once so that no instance search runs at the concrete type. -/
theorem pow_succ_mul_assoc {S : Type*} [Semiring S] (A G : PowerSeries S) (a : ℕ) :
    A ^ (a + 1) * G = A * (A ^ a * G) := by
  rw [pow_succ', mul_assoc]

theorem d4_highPow_eq_garlandVec (m : ℕ) : ∀ (j s : ℕ)
    (x : UModG D4sector.f (ravFam D4sector m 0)),
    d4_highPow m j s x = garlandVec (fun s => d4Ftheta m (m + s)) j s x
  | 0, s, x => by simp [d4_highPow, garlandVec]
  | j + 1, s, x => by
      simp only [d4_highPow, garlandVec]
      exact Finset.sum_congr rfl fun p _ => by rw [d4_highPow_eq_garlandVec m j]

theorem d4_highPow_eq_coeff (m j s : ℕ) (x : UModG D4sector.f (ravFam D4sector m 0)) :
    d4_highPow m j s x =
      (coeff s ((PowerSeries.map (d4ι m) (d4Bser m)) ^ j)) x := by
  rw [d4_highPow_eq_garlandVec, garlandVec_eq_coeff, d4_map_Bser]

theorem d4_lowLift_eq_coeff (m j N : ℕ) :
    d4_lowLift m j N =
      (coeff N (PowerSeries.map (d4ι m) (d4Aser m) *
        (PowerSeries.map (d4ι m) (d4Bser m)) ^ j)) (d4Gen m) := by
  rw [coeff_mul, LinearMap.coe_sum, Finset.sum_apply]
  unfold d4_lowLift
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [Module.End.mul_apply, d4_coeff_map_Aser_apply, d4_highPow_eq_coeff]

theorem d4_correction_eq_coeff (m j N : ℕ) :
    d4_correction m j N =
      (coeff N ((X : PowerSeries (Module.End ℂ (UModG D4sector.f (ravFam D4sector m 0)))) ^ m *
        (PowerSeries.map (d4ι m) (d4Bser m)) ^ (j + 1))) (d4Gen m) := by
  rw [coeff_X_pow_mul']
  unfold d4_correction
  split_ifs
  · exact d4_highPow_eq_coeff m (j + 1) (N - m) (d4Gen m)
  · simp

theorem d4_lowGarland_eq_coeff (m k : ℕ) : ∀ (a M : ℕ),
    d4_lowGarland m k a M =
      (coeff M ((PowerSeries.map (d4ι m) (d4Aser m)) ^ a *
        Garland.Fs (d4Ftheta m) ^ k)) (d4Gen m)
  | 0, M => by
      simp only [d4_lowGarland, pow_zero, one_mul]
      exact garlandVec_eq_coeff _ k M _
  | a + 1, M => by
      rw [pow_succ_mul_assoc, coeff_mul, LinearMap.coe_sum, Finset.sum_apply,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
      simp only [d4_lowGarland, Module.End.mul_apply, d4_coeff_map_Aser_apply,
        d4_lowGarland_eq_coeff m k a]
      rw [← Finset.sum_filter, ← Finset.sum_filter]
      congr 1
      ext r
      simp only [Finset.mem_filter, Finset.mem_range]
      omega

/-! ## The expansion theorem and the `Jprime` package -/

/-- The corrected lift expands in low-mode multiples of Garland coefficients. -/
theorem d4_correctedLift_expansion (m : ℕ) : D4CorrectedLiftExpansion m := by
  intro j N hj hjm hN
  have hm : 1 ≤ m := by omega
  have key := generic_assembly (d4ι m) (d4ι_smul m) (d4Aser m) (d4Bser m) m j N hm hj hN
    (d4Aser_coeff_zero m)
  rw [← d4Fser_eq, d4_map_Fser] at key
  have hv := congrArg (fun T => T (d4Gen m)) key
  simp only [LinearMap.add_apply, LinearMap.smul_apply, LinearMap.coe_sum,
    Finset.sum_apply] at hv
  rw [d4_correctedLift, d4_lowLift_eq_coeff, d4_correction_eq_coeff]
  refine hv.trans (Finset.sum_congr rfl fun a _ => ?_)
  rw [d4_lowGarland_eq_coeff]

/-- The full `Jprime` annihilator package holds at every multiplicity. -/
theorem Jprime_le_annGr (m : ℕ) (hm : 1 ≤ m) : JprimeLeAnnGr m hm :=
  Jprime_le_annGr_of_expansion m hm (d4_correctedLift_expansion m)

end D4

end

