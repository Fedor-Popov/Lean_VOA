import VOA.DeligneAudit.DeligneFusionFiniteG
import VOA.DeligneAudit.F4Sector

/-!
# The finiteness clause for `F4`

Generated by `Notes/deligne/campaign/generators/gen_finite_cert.py f4`.

A 20-step nilpotency certificate (`f4Cert`, each step `(X, Y, path)` an `ad X`-string from a
known letter `Y` to its top) reaches every low letter of `F4sector` from the raising letters and
the simple lowering letters. Hence

`f4_finiteTable : FiniteTableG F4sector` and
`f4_fusionTotalBoundG_of_dim : FusionTotalDimG F4sector → FusionTotalBoundG F4sector`.
-/

set_option maxRecDepth 100000

namespace VOA.DeligneAudit.FiniteG.F4

open VOA.DeligneAudit.DeligneSector VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneSector.F4 VOA.DeligneAudit.DeligneSector.Sparse

/-- Raising letters and simple lowering letters. -/
def f4Kn (c : Fin 52) : Bool := decide (c.val ∈ posL) || decide (c.val ∈ ([26, 13, 46, 47] : List ℕ))

/-- The integer structure constants. -/
def f4Fz (a b c : Fin 52) : ℤ := fZ br a.val b.val c.val

/-- The certificate. -/
def f4Cert : List (Step 52) := [(13, 46, [38]),
  (26, 38, [20]),
  (26, 46, [11]),
  (26, 47, [12]),
  (46, 11, [40]),
  (46, 12, [39, 51]),
  (46, 20, [29]),
  (47, 11, [39]),
  (47, 20, [28]),
  (47, 29, [48]),
  (11, 28, [9]),
  (11, 39, [31]),
  (11, 48, [41]),
  (13, 9, [18]),
  (13, 29, [10]),
  (13, 41, [32]),
  (13, 48, [43]),
  (20, 41, [6]),
  (28, 40, [41, 45]),
  (29, 47, [48, 49])]

theorem f4_certValid :
    certValid F4sector.wt (fun a b c => f4Fz a b c != 0) f4Kn f4Cert = true := by
  decide +kernel

theorem f4_cov : ∀ c : Fin 52, (certKnown f4Kn f4Cert c && !wEqB (F4sector.wt c) 0) = true ∨
    F4sector.raising c ∨ F4sector.cartan c ∨ F4sector.cartanN c := by
  change ∀ c : Fin 52, (certKnown f4Kn f4Cert c &&
      !wEqB (wtS c) 0) = true ∨
    (c.val ∈ posL) ∨ (c.val ∈ ([0, 1, 2] : List ℕ)) ∨ (c.val ∈ ([3] : List ℕ))
  decide +kernel

theorem f4_kn : ∀ c : Fin 52, f4Kn c = true → F4sector.raising c ∨ F4sector.lowering c := by
  change ∀ c : Fin 52, f4Kn c = true →
    (c.val ∈ posL) ∨ (c.val ∈ ([26, 13, 46, 47] : List ℕ))
  intro c h
  simpa [f4Kn] using h

/-- **The finiteness table facts for `F4`.** -/
theorem f4_finiteTable : FiniteTableG F4sector :=
  finiteTableG_of_cert (fnz_of_table (fz := f4Fz) (fun _ _ _ => rfl)) f4Kn f4Cert f4_kn
    f4_certValid f4_cov

/-- **`FusionTotalBoundG F4sector` reduces to the bare dimension bound.** -/
theorem f4_fusionTotalBoundG_of_dim (h : FusionTotalDimG F4sector) :
    FusionTotalBoundG F4sector :=
  fusionTotalBoundG_of_dim f4_finiteTable h

end VOA.DeligneAudit.FiniteG.F4

section AxiomAudit
#print axioms VOA.DeligneAudit.FiniteG.F4.f4_finiteTable
#print axioms VOA.DeligneAudit.FiniteG.F4.f4_fusionTotalBoundG_of_dim
end AxiomAudit
