/-- The Casimir, flat `i j z` triples. -/
def qRaw : List ℕ := [0, 0, 4, 0, 1, 6, 0, 2, 10, 0, 3, 12, 0, 4, 8, 0, 5, 4, 1, 1, 6, 1, 2, 12, 1, 3, 18, 1, 4, 12, 1, 5, 6, 2, 2, 10, 2, 3, 24, 2, 4, 16, 2, 5, 8, 3, 3, 18, 3, 4, 24, 3, 5, 12, 4, 4, 10, 4, 5, 10, 5, 5, 4, 6, 42, 6, 7, 43, 6, 8, 44, 6, 9, 45, 6, 10, 46, 6, 11, 47, 6, 12, 48, 7, 13, 49, 7, 14, 50, 7, 15, 51, 7, 16, 52, 7, 17, 53, 7, 18, 54, 7, 19, 55, 7, 20, 56, 7, 21, 57, 7, 22, 58, 7, 23, 59, 7, 24, 60, 7, 25, 61, 7, 26, 62, 7, 27, 63, 7, 28, 64, 7, 29, 65, 7, 30, 66, 7, 31, 67, 7, 32, 68, 7, 33, 69, 7, 34, 70, 7, 35, 71, 7, 36, 72, 7, 37, 73, 7, 38, 74, 7, 39, 75, 7, 40, 76, 7, 41, 77, 7]

/-- Relation `b` as sparse quadratic terms. -/
def relQ (b : ℕ) : List (ℕ × ℕ × ℤ) := quadOf ((relRaw.getD (b / 25) []).getD (b % 25) [])

/-- The Casimir as sparse quadratic terms. -/
def qQ : List (ℕ × ℕ × ℤ) := quadOf qRaw

/-- All indices are `< 78`. -/
def inRange78 (l : List (ℕ × ℕ × ℤ)) : Bool := l.all fun t => t.1 < 78 && t.2.1 < 78

theorem rel_inRange : (List.range 650).all (fun b => inRange78 (relQ b)) = true := by decide +kernel

theorem qQ_inRange : inRange78 qQ = true := by decide +kernel

/-- Certificate data: first entry `L`, then flat `z x b` triples. -/
def certL (c : List ℕ) : ℤ := ((c.headD 1 : ℕ) : ℤ)

def certT (c : List ℕ) : List (ℤ × ℕ × ℕ) := certOf c.tail

/-- The full check of the U3 certificate `c` of current `a`. -/
def u3OK (a : ℕ) (c : List ℕ) : Bool :=
  decide (certL c ≠ 0) && (certT c).all (fun t => t.2.2 < 650) && u3Check relQ qQ a (certL c) (certT c)

