import VOA.DeligneAudit.SL4TTruncatedMiddleModule

/-! Cartan separation and ideal descent for truncated multiplicity evaluations. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

variable {R V : Type*} [CommRing R] [Algebra ℂ R]
variable [AddCommGroup V] [Module ℂ V]

/-- Elements whose every multiple vanishes under a linear multiplicity evaluation. -/
def evaluationAnnihilator (π : R →ₗ[ℂ] V) : Ideal R where
  carrier := {x | ∀ y, π (x * y) = 0}
  zero_mem' := by simp
  add_mem' := by intro x y hx hy z; simp [add_mul, hx z, hy z]
  smul_mem' := by
    intro x y hy z
    change π ((x * y) * z) = 0
    simpa only [mul_left_comm, mul_assoc] using hy (x * z)

/-- Annihilation of all multiples implies ordinary membership in the linear kernel. -/
theorem evaluationAnnihilator_le_kernel (π : R →ₗ[ℂ] V) :
    (evaluationAnnihilator π).restrictScalars ℂ ≤ LinearMap.ker π := by
  intro x hx
  simpa only [LinearMap.mem_ker, mul_one] using hx 1

/-- The three type-A Cartan symbols separate the two chosen alphabets and their base. -/
theorem threeCartan_symbols_annihilate (π : R →ₗ[ℂ] V) (g₁ g₂ x : R)
    (hfirst : ∀ φ, π ((g₁ + g₂ - x) * φ) = 0)
    (hmiddle : ∀ φ, π ((-(2 : ℂ) • g₁ - g₂ - x) * φ) = 0)
    (hlast : ∀ φ, π ((g₁ - g₂ + x) * φ) = 0) :
    g₁ ∈ evaluationAnnihilator π ∧ g₂ ∈ evaluationAnnihilator π ∧
      x ∈ evaluationAnnihilator π := by
  have hsolve (φ : R) : π (g₁ * φ) = 0 ∧ π (g₂ * φ) = 0 ∧ π (x * φ) = 0 := by
    have h₁ := hfirst φ
    have h₂ := hmiddle φ
    have h₃ := hlast φ
    simp only [sub_mul, add_mul, smul_mul_assoc, map_sub, map_add, map_smul] at h₁ h₂ h₃
    have hg₁ : (2 : ℂ) • π (g₁ * φ) = 0 := by
      calc
        _ = (π (g₁ * φ) + π (g₂ * φ) - π (x * φ)) +
            (π (g₁ * φ) - π (g₂ * φ) + π (x * φ)) := by module
        _ = 0 := by rw [h₁, h₃, add_zero]
    have hg₂ : (4 : ℂ) • π (g₂ * φ) = 0 := by
      calc
        _ = -(π (g₁ * φ) + π (g₂ * φ) - π (x * φ)) -
            (2 : ℂ) • (-(2 : ℂ) • π (g₁ * φ) - π (g₂ * φ) - π (x * φ)) -
            (3 : ℂ) • (π (g₁ * φ) - π (g₂ * φ) + π (x * φ)) := by module
        _ = 0 := by rw [h₁, h₂, h₃]; simp
    have hx : (4 : ℂ) • π (x * φ) = 0 := by
      calc
        _ = -(3 : ℂ) • (π (g₁ * φ) + π (g₂ * φ) - π (x * φ)) -
            (2 : ℂ) • (-(2 : ℂ) • π (g₁ * φ) - π (g₂ * φ) - π (x * φ)) -
            (π (g₁ * φ) - π (g₂ * φ) + π (x * φ)) := by module
        _ = 0 := by rw [h₁, h₂, h₃]; simp
    exact ⟨(smul_eq_zero.mp hg₁).resolve_left (by norm_num),
      (smul_eq_zero.mp hg₂).resolve_left (by norm_num),
      (smul_eq_zero.mp hx).resolve_left (by norm_num)⟩
  exact ⟨fun φ => (hsolve φ).1, fun φ => (hsolve φ).2.1, fun φ => (hsolve φ).2.2⟩

/-- The ideal generated by a fixed power sum in each of four flag blocks. -/
def fourBlockPowerSumIdeal (p : Fin 4 → ℕ → R) (N : ℕ) : Ideal R :=
  Ideal.span (Set.range (fun i => p i N))

/-- Truncated Cartan symbols kill the entire four-block power-sum ideal. -/
theorem fourBlockPowerSumIdeal_le_kernel (π : R →ₗ[ℂ] V)
    (p : Fin 4 → ℕ → R) (N : ℕ)
    (htotal : p 0 N + p 1 N + p 2 N + p 3 N = 0)
    (hfirst : ∀ φ, π ((p 1 N + p 2 N - (p 2 N + p 3 N)) * φ) = 0)
    (hmiddle : ∀ φ,
      π ((-(2 : ℂ) • p 1 N - p 2 N - (p 2 N + p 3 N)) * φ) = 0)
    (hlast : ∀ φ, π ((p 1 N - p 2 N + (p 2 N + p 3 N)) * φ) = 0) :
    (fourBlockPowerSumIdeal p N).restrictScalars ℂ ≤ LinearMap.ker π := by
  obtain ⟨h₁, h₂, h₂₃⟩ := threeCartan_symbols_annihilate π
    (p 1 N) (p 2 N) (p 2 N + p 3 N) hfirst hmiddle hlast
  have h₃ : p 3 N ∈ evaluationAnnihilator π := by
    simpa only [add_sub_cancel_left] using (evaluationAnnihilator π).sub_mem h₂₃ h₂
  have h₀ : p 0 N ∈ evaluationAnnihilator π := by
    have he : p 0 N = -(p 1 N + p 2 N + p 3 N) := by
      apply eq_neg_of_add_eq_zero_left
      simpa only [add_assoc] using htotal
    rw [he]
    exact (evaluationAnnihilator π).neg_mem
      ((evaluationAnnihilator π).add_mem ((evaluationAnnihilator π).add_mem h₁ h₂) h₃)
  have hle : fourBlockPowerSumIdeal p N ≤ evaluationAnnihilator π := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    fin_cases i
    · exact h₀
    · exact h₁
    · exact h₂
    · exact h₃
  exact fun x hx => evaluationAnnihilator_le_kernel π (hle hx)

/-- A linear multiplicity map descends through any ideal that it kills. -/
def multiplicityQuotientEvaluation (π : R →ₗ[ℂ] V) (I : Ideal R)
    (hI : I.restrictScalars ℂ ≤ LinearMap.ker π) : (R ⧸ I) →ₗ[ℂ] V :=
  (I.restrictScalars ℂ).liftQ π hI

/-- Ideal descent preserves the multiplicity image. -/
theorem multiplicityQuotientEvaluation_range (π : R →ₗ[ℂ] V) (I : Ideal R)
    (hI : I.restrictScalars ℂ ≤ LinearMap.ker π) :
    LinearMap.range (multiplicityQuotientEvaluation π I hI) = LinearMap.range π := by
  ext v
  constructor
  · rintro ⟨x, rfl⟩
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact ⟨y, rfl⟩
  · rintro ⟨x, rfl⟩
    exact ⟨Ideal.Quotient.mk I x, rfl⟩

/-- A surjective multiplicity map remains surjective after killing an ideal in its kernel. -/
theorem multiplicityQuotientEvaluation_surjective (π : R →ₗ[ℂ] V) (I : Ideal R)
    (hI : I.restrictScalars ℂ ≤ LinearMap.ker π) (hπ : Function.Surjective π) :
    Function.Surjective (multiplicityQuotientEvaluation π I hI) := by
  intro v
  obtain ⟨x, rfl⟩ := hπ v
  exact ⟨Ideal.Quotient.mk I x, rfl⟩

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.evaluationAnnihilator_le_kernel
#print axioms VOA.DeligneAudit.SL4T.threeCartan_symbols_annihilate
#print axioms VOA.DeligneAudit.SL4T.fourBlockPowerSumIdeal_le_kernel
#print axioms VOA.DeligneAudit.SL4T.multiplicityQuotientEvaluation_range
#print axioms VOA.DeligneAudit.SL4T.multiplicityQuotientEvaluation_surjective
