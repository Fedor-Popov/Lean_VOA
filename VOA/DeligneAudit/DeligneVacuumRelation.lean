import VOA.DeligneAudit.DeligneMLDEBlock
import VOA.Modularity.ZhuCoordinateGrading

/-!
# The vacuum quartic relation from a square-bracket current calculus (type-generic)

Residual 1 of the MLDE route is the trace identity `VacuumQuarticRelation W κ`:
`S(L[-2]²|0⟩) = κ·G₄⋆S(|0⟩)` with `κ = (h+1)(5h-6)`.  This file reduces it, for any VOA generated
(at the level needed) by primary weight-one currents with a Sugawara conformal vector, to a
**polynomial statement about the C₂ symbols**, with **no** Zhu change-of-coordinates isomorphism.

## §1 Trace side: `κ` is forced
* `exists_kappa_of_mem_sqC2Span` — on the weighted square-bracket `C₂` span `sqC2Span W 4` every
  torus one-point function is a multiple of `G₄ ⋆ f` (Zhu's recursion, `torusOnePoint_sqC2Term`);
* `kappa_eq_of_vacuumQuarticRelation` — the multiple is forced by the lowest coefficient:
  `κ = 5c²/4 + 11c/2` (`= 36` at `c = -8`, `= (h+1)(5h-6)` at `c = -2(h+1)`);
* `vacuumQuarticRelation_of_mem_sqC2Span`.

## §2 Square Sugawara
`SqCurrentData` packages currents `g`, structure constants `T`, the form `F`, the level, the inverse
form `K`, the dual Coxeter number and the Sugawara formula.  Then
* `Lsq_neg_two_vacuum_eq` — `L[-2]|0⟩ = (2(k+h))⁻¹ Σ K_{ij} g_i[-1] g_j[-1]|0⟩`;
* `Lsq_sq_vacuum_mem_sqC2Span` — if every `g_i[-1]L[-2]|0⟩` lies in the square current `C₂`
  span, then `L[-2]²|0⟩ ∈ sqC2Span W 4`.

## §3 Symbol calculus
In `Q = V ⧸ currentC2` the operators `g_i[-1]` commute (`sqCurrent_comm`), so polynomials act
(`ev`); the zero modes act by the coadjoint derivation `adG`.  `sym p := ev p [|0⟩]`.
* `sym_eq_zero_of_mem_span` — `sym` vanishes on the ideal generated by polynomials with vanishing
  symbol;
* `sym_adG` — `sym (adG c p) = Z_c (sym p)`; so vanishing propagates along the coadjoint orbit;
* `vacuumQuarticRelation_of_symbols` — the final generic reduction.
-/

namespace VOA.DeligneAudit.VacuumRelation

open VOA VOA.ZhuCoordinate VOA.DeligneAudit.DeligneMLDE MvPolynomial

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] (W : VertexOperatorAlgebra 𝒱)

/-! ## §1 The trace side -/

theorem exists_kappa_of_mem_sqC2Span {M : Type u} [AddCommGroup M] [Module ℂ M]
    (N : OrdVModule W M) {x : 𝒱} (hx : x ∈ sqC2Span W 4) :
    ∃ κ : ℂ, torusOnePoint N x = κ • qConv (zhuG 2) (torusPartition N) := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨p, a, b, hp, ha, hb, rfl⟩ := hx
      have h2 : vSqZ W a p 2 b ∈ gradeLE W 0 := by
        have := vSqZ_mem_gradeLE W ha p 2 hb
        rwa [show (p : ℤ) + (4 - p - 1) - 2 - 1 = 0 by ring] at this
      rw [gradeLE_zero, Submodule.mem_span_singleton] at h2
      obtain ⟨lam, hlam⟩ := h2
      let t : SqC2Term W :=
        { ka := p, a := a, b := b, lam := lam, one_le := hp, mem := ha, two := hlam.symm,
          high := fun m hm => by
            have := vSqZ_mem_gradeLE W ha p (2 * (m : ℤ)) hb
            rw [gradeLE_eq_bot W (by omega)] at this
            exact (Submodule.mem_bot ℂ).mp this }
      exact ⟨-3 * lam, torusOnePoint_sqC2Term W N t⟩
  | zero => exact ⟨0, by rw [torusOnePoint_zero, zero_smul]⟩
  | add x y _ _ hx hy =>
      obtain ⟨κ₁, h₁⟩ := hx
      obtain ⟨κ₂, h₂⟩ := hy
      exact ⟨κ₁ + κ₂, by rw [torusOnePoint_add, h₁, h₂, add_smul]⟩
  | smul c x _ hx =>
      obtain ⟨κ, h⟩ := hx
      exact ⟨c * κ, by rw [torusOnePoint_smul, h, smul_smul]⟩

/-- **`κ` is forced by the lowest coefficient**: `κ = 5c²/4 + 11c/2`. -/
theorem kappa_eq_of_vacuumQuarticRelation (hvac : W.vacuum ≠ 0) {κ : ℂ}
    (h : VacuumQuarticRelation W κ) :
    κ = 5 / 4 * W.centralCharge ^ 2 + 11 / 2 * W.centralCharge := by
  have hE := congrFun ((torusOnePoint_Lsq_sq_vacuum (adjointModule W)).symm.trans h.eq)
    (((0 : ℕ) : ℂ) - W.centralCharge / 24)
  have hfe : ∀ m : ℕ, torusPartition (adjointModule W) (((0 : ℕ) : ℂ) - W.centralCharge / 24 - m)
      = if m ≤ 0 then (Module.finrank ℂ (W.grading ((0 - m : ℕ) : ℤ)) : ℂ) else 0 :=
    fun m => torusPartition_adjoint_sub W 0 m
  have hvan : ∀ m : ℕ, 0 < m →
      torusPartition (adjointModule W) (((0 : ℕ) : ℂ) - W.centralCharge / 24 - m) = 0 :=
    fun m hm => by rw [hfe, if_neg (by omega)]
  have hvan' : ∀ m : ℕ, 0 < m → ((2 : ℂ) • qDeriv (torusPartition (adjointModule W)))
      (((0 : ℕ) : ℂ) - W.centralCharge / 24 - m) = 0 := fun m hm => by
    simp only [Pi.smul_apply, qDeriv, hvan m hm, mul_zero, smul_zero]
  have hvan'' : ∀ m : ℕ, 0 < m → ((W.centralCharge / 2) • torusPartition (adjointModule W))
      (((0 : ℕ) : ℂ) - W.centralCharge / 24 - m) = 0 := fun m hm => by
    simp only [Pi.smul_apply, hvan m hm, smul_zero]
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at hE
  rw [qConv_eval _ _ _ 0 hvan', qConv_eval _ _ _ 0 hvan'', qConv_eval _ _ _ 0 hvan] at hE
  have hf0 : torusPartition (adjointModule W) (0 - W.centralCharge / 24) = 1 := by
    have := hfe 0
    simp only [Nat.cast_zero, sub_zero, le_refl, if_true, Nat.sub_zero] at this
    rw [this, Nat.cast_zero, W.vacuum_grade, finrank_span_singleton hvac, Nat.cast_one]
  simp only [zero_add, Finset.sum_range_one, Nat.cast_zero, sub_zero, Pi.smul_apply,
    smul_eq_mul, qDeriv, zhuG_one_zero', zhuG_two_zero] at hE
  rw [hf0] at hE
  linear_combination (720 : ℂ) * hE.symm

/-- **The trace identity from the square-bracket `C₂` membership.** -/
theorem vacuumQuarticRelation_of_mem_sqC2Span (hvac : W.vacuum ≠ 0)
    (hx : Lsq W (-2) (Lsq W (-2) W.vacuum) ∈ sqC2Span W 4) :
    VacuumQuarticRelation W (5 / 4 * W.centralCharge ^ 2 + 11 / 2 * W.centralCharge) := by
  obtain ⟨κ, hκ⟩ := exists_kappa_of_mem_sqC2Span W (adjointModule W) hx
  have hrel : VacuumQuarticRelation W κ := ⟨hκ⟩
  rw [← kappa_eq_of_vacuumQuarticRelation W hvac hrel]
  exact hrel

/-! ## §2 Square Sugawara -/

/-- Linearity of square modes in the state. -/
theorem vSqZ_add_left (a b : 𝒱) (k : ℕ) (m : ℤ) :
    vSqZ W (a + b) k m = vSqZ W a k m + vSqZ W b k m := by
  ext x
  simp only [vSqZ_apply, LinearMap.add_apply]
  rw [← finsum_add_distrib (sqModeZ_support_finite W a k m x) (sqModeZ_support_finite W b k m x)]
  refine finsum_congr fun i => ?_
  rw [← smul_add]
  congr 1
  exact PreVertexAlgebra.smul_add_left _ a b i x

theorem vSqZ_smul_left (c : ℂ) (a : 𝒱) (k : ℕ) (m : ℤ) :
    vSqZ W (c • a) k m = c • vSqZ W a k m := by
  ext x
  simp only [vSqZ_apply, LinearMap.smul_apply]
  rw [smul_finsum' c (sqModeZ_support_finite W a k m x)]
  refine finsum_congr fun i => ?_
  rw [show mode (W.Y (c • a)) i x = W.smul (c • a) i x from rfl, PreVertexAlgebra.smul_smul_left,
    smul_comm]
  rfl

theorem vSqZ_sum_smul_left {ι : Type*} (s : Finset ι) (t : ι → ℂ) (a : ι → 𝒱) (k : ℕ) (m : ℤ)
    (x : 𝒱) : vSqZ W (∑ c ∈ s, t c • a c) k m x = ∑ c ∈ s, t c • vSqZ W (a c) k m x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [show vSqZ W (0 : 𝒱) k m = 0 by
      rw [show (0 : 𝒱) = (0 : ℂ) • (0 : 𝒱) by simp, vSqZ_smul_left, zero_smul]]
  | insert c s hc ih =>
      rw [Finset.sum_insert hc, Finset.sum_insert hc, vSqZ_add_left, LinearMap.add_apply,
        vSqZ_smul_left, LinearMap.smul_apply, ih]

/-- **Affine current data** for a VOA: primary weight-one currents `g`, brackets `T`, form `F` at
level `level`, inverse form `K`, dual Coxeter number `hdual`, and the Sugawara formula. -/
structure SqCurrentData (ι : Type*) [Fintype ι] where
  g : ι → 𝒱
  mem : ∀ i, g i ∈ W.grading 1
  primary : ∀ i, W.L 1 (g i) = 0
  T : ι → ι → ι → ℂ
  bracket : ∀ i j, W.smul (g i) 0 (g j) = ∑ c, T i j c • g c
  F : ι → ι → ℂ
  level : ℂ
  form : ∀ i j, W.smul (g i) 1 (g j) = (level * F i j) • W.vacuum
  K : ι → ι → ℂ
  hdual : ℂ
  ne : level + hdual ≠ 0
  sugawara : W.conformalVector
    = (2 * (level + hdual))⁻¹ • ∑ i, ∑ j, K i j • W.smul (g i) (-1) (g j)
  bracket_trace : ∀ c, ∑ i, ∑ j, K i j * T i j c = 0
  central : W.centralCharge * (level + hdual) = level * ∑ i, ∑ j, K i j * F i j

variable {W}
variable {ι : Type*} [Fintype ι] (D : SqCurrentData W ι)

namespace SqCurrentData

/-- `g_i[-1]`. -/
noncomputable abbrev sq (i : ι) (n : ℤ) : 𝒱 →ₗ[ℂ] 𝒱 := vSqZ W (D.g i) 1 n

/-- **Square Sugawara at the vacuum**: `L[-2]|0⟩ = (2(k+h))⁻¹ Σ K_{ij} g_i[-1]g_j[-1]|0⟩`. -/
theorem Lsq_neg_two_vacuum_eq :
    Lsq W (-2) W.vacuum = (2 * (D.level + D.hdual))⁻¹ •
      ∑ i, ∑ j, D.K i j • D.sq i (-1) (D.sq j (-1) W.vacuum) := by
  have hexp : ∀ i j, D.sq i (-1) (D.sq j (-1) W.vacuum)
      = W.smul (D.g i) (-1) (D.g j) + (1 / 2 : ℂ) • W.smul (D.g i) 0 (D.g j)
        - (1 / 12 : ℂ) • W.smul (D.g i) 1 (D.g j) := by
    intro i j
    rw [sq, sq, vSqZ_neg_one_vacuum, vSqZ_neg_one_current W (D.mem i) (D.mem j)]
  have hB : ∑ i, ∑ j, D.K i j • W.smul (D.g i) 0 (D.g j) = 0 := by
    have e1 : ∀ i, ∑ j, D.K i j • W.smul (D.g i) 0 (D.g j)
        = ∑ c, ∑ j, (D.K i j * D.T i j c) • D.g c := by
      intro i
      simp only [D.bracket, Finset.smul_sum, smul_smul]
      exact Finset.sum_comm
    simp only [e1]
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero fun c _ => ?_
    simp only [← Finset.sum_smul]
    rw [D.bracket_trace c, zero_smul]
  have hC : ∑ i, ∑ j, D.K i j • W.smul (D.g i) 1 (D.g j)
      = (W.centralCharge * (D.level + D.hdual)) • W.vacuum := by
    simp only [D.form, smul_smul, ← Finset.sum_smul]
    rw [D.central, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    ring
  have key : ∑ i, ∑ j, D.K i j • D.sq i (-1) (D.sq j (-1) W.vacuum)
      = ∑ i, ∑ j, D.K i j • W.smul (D.g i) (-1) (D.g j)
        + (1 / 2 : ℂ) • ∑ i, ∑ j, D.K i j • W.smul (D.g i) 0 (D.g j)
        - (1 / 12 : ℂ) • ∑ i, ∑ j, D.K i j • W.smul (D.g i) 1 (D.g j) := by
    simp only [hexp, smul_add, smul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib,
      Finset.smul_sum, smul_comm (D.K _ _) ((1 / 2 : ℂ)), smul_comm (D.K _ _) ((1 / 12 : ℂ))]
  rw [key, hB, hC, Lsq_neg_two_vacuum]
  conv_lhs => rw [D.sugawara]
  have hne : (2 * (D.level + D.hdual)) ≠ 0 := mul_ne_zero two_ne_zero D.ne
  rw [smul_zero, add_zero, smul_sub, smul_smul, smul_smul]
  congr 2
  have hne' : D.level + D.hdual ≠ 0 := D.ne
  field_simp
  ring

theorem sq_mem_sqWeightSpace (i : ι) (n : ℤ) {w : ℂ} {x : 𝒱} (hx : x ∈ sqWeightSpace W w) :
    D.sq i n x ∈ sqWeightSpace W (w - n) :=
  vSqZ_mem_sqWeightSpace W (D.mem i) (D.primary i) n hx

/-- Non-positive square current modes preserve the square current `C₂` span. -/
theorem sq_mem_currentC2 (i : ι) {m : ℤ} (hm : m ≤ 0) {x : 𝒱} (hx : x ∈ currentC2 W D.g) :
    D.sq i m x ∈ currentC2 W D.g := by
  induction hx using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨c, n, y, hn, rfl⟩ := hz
      have h := sqCurrent_comm W (D.mem i) (D.mem c) (D.form i c) m (-(n : ℤ)) y
      rw [if_neg (by omega), add_zero, D.bracket, vSqZ_sum_smul_left] at h
      rw [sq, sub_eq_iff_eq_add'.mp h]
      refine Submodule.add_mem _ (Submodule.subset_span ⟨c, n, _, hn, rfl⟩)
        (Submodule.sum_mem _ fun e _ => Submodule.smul_mem _ _ ?_)
      refine Submodule.subset_span ⟨e, ((n : ℤ) - m).toNat, y, by omega, ?_⟩
      rw [show m + -(n : ℤ) = -((((n : ℤ) - m).toNat : ℕ) : ℤ) by omega]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [map_smul]; exact Submodule.smul_mem _ c hx

/-- `L[-2] g_i[-1] = g_i[-1] L[-2] + g_i[-3]`. -/
theorem Lsq_neg_two_sq (i : ι) (y : 𝒱) :
    Lsq W (-2) (D.sq i (-1) y) = D.sq i (-1) (Lsq W (-2) y) + D.sq i (-3) y := by
  have h := Lsq_sqCurrent_comm W (D.mem i) (D.primary i) (-2) (-1) y
  rw [sub_eq_iff_eq_add'] at h
  rw [sq, sq, h]
  norm_num

/-- **The main reduction**: if every `g_i[-1] L[-2]|0⟩` lies in the square current `C₂` span,
then `L[-2]²|0⟩ ∈ C₂[V]` with the weight-four bound. -/
theorem Lsq_sq_vacuum_mem_sqC2Span
    (hrel : ∀ i, D.sq i (-1) (Lsq W (-2) W.vacuum) ∈ currentC2 W D.g) :
    Lsq W (-2) (Lsq W (-2) W.vacuum) ∈ sqC2Span W 4 := by
  set ω' := Lsq W (-2) W.vacuum with hω'
  set s : ℂ := (2 * (D.level + D.hdual))⁻¹
  have hω := D.Lsq_neg_two_vacuum_eq
  have hterm : ∀ i j, Lsq W (-2) (D.sq i (-1) (D.sq j (-1) W.vacuum))
      = D.sq i (-1) (D.sq j (-1) ω' + D.sq j (-3) W.vacuum)
        + D.sq i (-3) (D.sq j (-1) W.vacuum) := by
    intro i j
    rw [Lsq_neg_two_sq, Lsq_neg_two_sq]
  have hexp : Lsq W (-2) ω' = s • ∑ i, ∑ j, D.K i j •
      (D.sq i (-1) (D.sq j (-1) ω' + D.sq j (-3) W.vacuum)
        + D.sq i (-3) (D.sq j (-1) W.vacuum)) := by
    conv_lhs => rw [hω', hω]
    simp only [map_smul, map_sum, hterm]
    rfl
  -- membership in the square current `C₂` span
  have hC : Lsq W (-2) ω' ∈ currentC2 W D.g := by
    rw [hexp]
    refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun i _ => Submodule.sum_mem _ fun j _ =>
      Submodule.smul_mem _ _ (Submodule.add_mem _ ?_ ?_))
    · refine D.sq_mem_currentC2 i (by norm_num) (Submodule.add_mem _ (hrel j) ?_)
      exact Submodule.subset_span ⟨j, 3, W.vacuum, by norm_num, by simp⟩
    · exact Submodule.subset_span ⟨i, 3, D.sq j (-1) W.vacuum, by norm_num, by simp⟩
  -- the `L[0]`-weight is four
  have hv : W.vacuum ∈ sqWeightSpace W 0 := by
    rw [mem_sqWeightSpace_iff, Lsq_zero_vacuum, zero_smul]
  have hw2 : ω' ∈ sqWeightSpace W 2 := by
    rw [hω', hω]
    refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun i _ => Submodule.sum_mem _ fun j _ =>
      Submodule.smul_mem _ _ ?_)
    have := D.sq_mem_sqWeightSpace i (-1) (D.sq_mem_sqWeightSpace j (-1) hv)
    convert this using 2; push_cast; ring
  have hW : Lsq W (-2) ω' ∈ sqWeightSpace W ((4 : ℤ) : ℂ) := by
    rw [hexp]
    refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun i _ => Submodule.sum_mem _ fun j _ =>
      Submodule.smul_mem _ _ (Submodule.add_mem _ ?_ ?_))
    · have h1 := D.sq_mem_sqWeightSpace j (-1) hw2
      have h2 := D.sq_mem_sqWeightSpace j (-3) hv
      have h12 : D.sq j (-1) ω' + D.sq j (-3) W.vacuum ∈ sqWeightSpace W 3 := by
        refine Submodule.add_mem _ ?_ ?_
        · convert h1 using 2; push_cast; ring
        · convert h2 using 2; push_cast; ring
      have := D.sq_mem_sqWeightSpace i (-1) h12
      convert this using 2; push_cast; ring
    · have := D.sq_mem_sqWeightSpace i (-3) (D.sq_mem_sqWeightSpace j (-1) hv)
      convert this using 2; push_cast; ring
  exact currentC2At_le_sqC2Span W D.mem 4
    (mem_currentC2At_of_mem W D.mem D.primary hC hW)

/-- **The vacuum quartic relation from the current condition.** -/
theorem vacuumQuarticRelation_of_currentC2 (hvac : W.vacuum ≠ 0)
    (hrel : ∀ i, D.sq i (-1) (Lsq W (-2) W.vacuum) ∈ currentC2 W D.g) :
    VacuumQuarticRelation W (5 / 4 * W.centralCharge ^ 2 + 11 / 2 * W.centralCharge) :=
  vacuumQuarticRelation_of_mem_sqC2Span W hvac (D.Lsq_sq_vacuum_mem_sqC2Span hrel)

/-! ## §3 The symbol calculus in `V ⧸ currentC2` -/

/-- `g_i[m]` (`m ≤ 0`) on the quotient by the square current `C₂` span. -/
noncomputable def opQ (i : ι) (m : ℤ) (hm : m ≤ 0) :
    Module.End ℂ (𝒱 ⧸ currentC2 W D.g) :=
  (currentC2 W D.g).mapQ (currentC2 W D.g) (D.sq i m) (fun _ hx => D.sq_mem_currentC2 i hm hx)

/-- The creation operators `g_i[-1]` on the quotient. -/
noncomputable abbrev Tq (i : ι) : Module.End ℂ (𝒱 ⧸ currentC2 W D.g) := D.opQ i (-1) (by norm_num)

/-- The zero modes `g_i[0]` on the quotient. -/
noncomputable abbrev Zq (i : ι) : Module.End ℂ (𝒱 ⧸ currentC2 W D.g) := D.opQ i 0 le_rfl

theorem opQ_mk (i : ι) (m : ℤ) (hm : m ≤ 0) (x : 𝒱) :
    D.opQ i m hm ((currentC2 W D.g).mkQ x) = (currentC2 W D.g).mkQ (D.sq i m x) := rfl

theorem mkQ_sq_neg_mem (i : ι) (n : ℕ) (hn : 2 ≤ n) (y : 𝒱) :
    (currentC2 W D.g).mkQ (D.sq i (-(n : ℤ)) y) = 0 := by
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact Submodule.subset_span ⟨i, n, y, hn, rfl⟩

/-- The creation operators commute on the quotient. -/
theorem Tq_comm (i j : ι) : D.Tq i * D.Tq j = D.Tq j * D.Tq i := by
  refine Submodule.linearMap_qext _ (LinearMap.ext fun x => ?_)
  simp only [LinearMap.comp_apply, Module.End.mul_apply, Tq, opQ_mk]
  rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
  have h := sqCurrent_comm W (D.mem i) (D.mem j) (D.form i j) (-1) (-1) x
  rw [if_neg (by norm_num), add_zero, D.bracket, vSqZ_sum_smul_left] at h
  rw [sq, sq, h]
  refine Submodule.sum_mem _ fun e _ => Submodule.smul_mem _ _ ?_
  exact Submodule.subset_span ⟨e, 2, x, le_rfl, by norm_num⟩

/-- The zero modes act on the creation operators by the structure constants. -/
theorem Zq_Tq_comm (c i : ι) :
    D.Zq c * D.Tq i - D.Tq i * D.Zq c = ∑ e, D.T c i e • D.Tq e := by
  refine Submodule.linearMap_qext _ (LinearMap.ext fun x => ?_)
  simp only [LinearMap.comp_apply, LinearMap.sub_apply, Module.End.mul_apply, Tq, Zq, opQ_mk,
    LinearMap.sum_apply, LinearMap.smul_apply]
  rw [← map_sub, show ∑ e, D.T c i e • (currentC2 W D.g).mkQ (D.sq e (-1) x)
      = (currentC2 W D.g).mkQ (∑ e, D.T c i e • D.sq e (-1) x) by simp [map_sum, map_smul]]
  congr 1
  have h := sqCurrent_comm W (D.mem c) (D.mem i) (D.form c i) 0 (-1) x
  rw [if_neg (by norm_num), add_zero, D.bracket, vSqZ_sum_smul_left, zero_add] at h
  exact h

theorem Tq_hcomm : ∀ a ∈ Set.range D.Tq, ∀ b ∈ Set.range D.Tq, a * b = b * a := by
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
  exact D.Tq_comm i j

set_option linter.deprecated false in
/-- Polynomials in the commuting creation operators. -/
noncomputable def ev (p : MvPolynomial ι ℂ) : Module.End ℂ (𝒱 ⧸ currentC2 W D.g) :=
  letI : CommRing (Algebra.adjoin ℂ (Set.range D.Tq)) :=
    Algebra.adjoinCommRingOfComm ℂ D.Tq_hcomm
  ((MvPolynomial.aeval (R := ℂ) (S₁ := Algebra.adjoin ℂ (Set.range D.Tq))
    fun i => ⟨D.Tq i, Algebra.subset_adjoin ⟨i, rfl⟩⟩) p : Module.End ℂ (𝒱 ⧸ currentC2 W D.g))

theorem ev_X (i : ι) : D.ev (X i) = D.Tq i := by simp [ev]

theorem ev_mul (p q : MvPolynomial ι ℂ) : D.ev (p * q) = D.ev p * D.ev q := by
  simp only [ev, map_mul]; rfl

theorem ev_add (p q : MvPolynomial ι ℂ) : D.ev (p + q) = D.ev p + D.ev q := by
  simp only [ev, map_add]; rfl

theorem ev_smul (c : ℂ) (p : MvPolynomial ι ℂ) : D.ev (c • p) = c • D.ev p := by
  simp only [ev, map_smul]; rfl

theorem ev_C (c : ℂ) : D.ev (MvPolynomial.C c) = c • 1 := by
  simp only [ev, MvPolynomial.aeval_C]; rfl

theorem ev_zero : D.ev 0 = 0 := by
  simpa using D.ev_smul 0 0

theorem ev_mul_comm (p q : MvPolynomial ι ℂ) : D.ev p * D.ev q = D.ev q * D.ev p := by
  rw [← ev_mul, ← ev_mul, mul_comm]

theorem ev_sum {κ : Type*} (s : Finset κ) (f : κ → MvPolynomial ι ℂ) :
    D.ev (∑ k ∈ s, f k) = ∑ k ∈ s, D.ev (f k) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using D.ev_zero
  | insert k s hk ih => rw [Finset.sum_insert hk, Finset.sum_insert hk, ev_add, ih]

end SqCurrentData

/-- The coadjoint derivation of the polynomial ring defined by structure constants `T`. -/
noncomputable def adG {ι : Type*} [Fintype ι] (T : ι → ι → ι → ℂ) (b : ι) :
    Derivation ℂ (MvPolynomial ι ℂ) (MvPolynomial ι ℂ) :=
  MvPolynomial.mkDerivation ℂ fun i => ∑ c, T b i c • X c

theorem adG_X {ι : Type*} [Fintype ι] (T : ι → ι → ι → ℂ) (b i : ι) :
    adG T b (X i) = ∑ c, T b i c • X c := by
  rw [adG, MvPolynomial.mkDerivation_X]

namespace SqCurrentData

/-- **Zero modes act on polynomials in the creation operators by the coadjoint derivation.** -/
theorem ev_adG (c : ι) (p : MvPolynomial ι ℂ) :
    D.Zq c * D.ev p - D.ev p * D.Zq c = D.ev (adG D.T c p) := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      rw [ev_C, ← MvPolynomial.algebraMap_eq, Derivation.map_algebraMap, ev_zero]
      simp
  | add p q hp hq =>
      rw [map_add, ev_add, ev_add, mul_add, add_mul, ← hp, ← hq]
      abel
  | mul_X p i hp =>
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, ev_add, ev_mul, ev_mul, ev_mul, ev_X,
        adG_X, ← hp]
      have hS : D.ev (∑ e, D.T c i e • X e) = ∑ e, D.T c i e • D.Tq e := by
        rw [ev_sum]
        refine Finset.sum_congr rfl fun e _ => ?_
        rw [ev_smul, ev_X]
      rw [hS, ← Zq_Tq_comm]
      have hc : D.Tq i * (D.Zq c * D.ev p - D.ev p * D.Zq c)
          = (D.Zq c * D.ev p - D.ev p * D.Zq c) * D.Tq i := by
        rw [hp, ← ev_X, ev_mul_comm]
      rw [hc]
      noncomm_ring

/-- The symbol of a polynomial: `p(g[-1])|0⟩` in `V ⧸ currentC2`. -/
noncomputable def sym (p : MvPolynomial ι ℂ) : 𝒱 ⧸ currentC2 W D.g :=
  D.ev p ((currentC2 W D.g).mkQ W.vacuum)

theorem Zq_vacuum (c : ι) : D.Zq c ((currentC2 W D.g).mkQ W.vacuum) = 0 := by
  rw [Zq, opQ_mk, sq, vSqZ_vacuum_of_nonneg W _ _ le_rfl, map_zero]

/-- `sym (ad_c p) = g_c[0] (sym p)`. -/
theorem sym_adG (c : ι) (p : MvPolynomial ι ℂ) : D.sym (adG D.T c p) = D.Zq c (D.sym p) := by
  have h := LinearMap.congr_fun (D.ev_adG c p) ((currentC2 W D.g).mkQ W.vacuum)
  rw [LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply, Zq_vacuum, map_zero,
    sub_zero] at h
  exact h.symm

theorem sym_mul (f p : MvPolynomial ι ℂ) : D.sym (f * p) = D.ev f (D.sym p) := by
  rw [sym, ev_mul, Module.End.mul_apply]; rfl

theorem sym_add (p q : MvPolynomial ι ℂ) : D.sym (p + q) = D.sym p + D.sym q := by
  rw [sym, ev_add, LinearMap.add_apply]; rfl

theorem sym_zero : D.sym 0 = 0 := by
  rw [sym, ev_zero, LinearMap.zero_apply]

theorem sym_C_mul (c : ℂ) (p : MvPolynomial ι ℂ) : D.sym (MvPolynomial.C c * p) = c • D.sym p := by
  rw [sym_mul, ev_C, LinearMap.smul_apply, Module.End.one_apply]

theorem sym_sub (p q : MvPolynomial ι ℂ) : D.sym (p - q) = D.sym p - D.sym q := by
  rw [sub_eq_add_neg, sym_add, neg_eq_neg_one_mul,
    show (-1 : MvPolynomial ι ℂ) = MvPolynomial.C (-1) by simp, sym_C_mul, neg_one_smul,
    ← sub_eq_add_neg]

theorem sym_X_mul_X (i j : ι) :
    D.sym (X i * X j) = (currentC2 W D.g).mkQ (D.sq i (-1) (D.sq j (-1) W.vacuum)) := by
  rw [sym, ev_mul, ev_X, ev_X]
  rfl

/-- The symbol of a combination of three quadratic monomials, as one vector. -/
theorem sym_three (a b c d e f : ι) (α β γ : ℂ) :
    D.sym (MvPolynomial.C α * (X a * X b) + MvPolynomial.C β * (X c * X d)
        + MvPolynomial.C γ * (X e * X f))
      = (currentC2 W D.g).mkQ (α • D.sq a (-1) (D.sq b (-1) W.vacuum)
          + β • D.sq c (-1) (D.sq d (-1) W.vacuum) + γ • D.sq e (-1) (D.sq f (-1) W.vacuum)) := by
  rw [sym_add, sym_add, sym_C_mul, sym_C_mul, sym_C_mul, sym_X_mul_X, sym_X_mul_X, sym_X_mul_X,
    map_add, map_add, map_smul, map_smul, map_smul]

/-- **Square symbols of weight-two relations** (type-generic).  If the ordinary weight-two
vector `Σ c_{ab} g_a(-1)g_b + Σ d_a g_a(-2)|0⟩` vanishes in `W` (a singular vector of the
universal VOA), its weight-one shadow `Σ d_a g_a + ½ Σ c_{ab} g_a(0)g_b` vanishes, and
`Σ c_{ab} F_{ab} = 0`, then the square symbol of `Σ c_{ab} X_a X_b` vanishes. -/
theorem sym_quadratic_of_relation (c : ι → ι → ℂ) (d : ι → ℂ)
    (hrel : ∑ a, ∑ b, c a b • W.smul (D.g a) (-1) (D.g b)
      + ∑ a, d a • W.smul (D.g a) (-2) W.vacuum = 0)
    (h1 : ∑ a, d a • D.g a + (1 / 2 : ℂ) • ∑ a, ∑ b, c a b • W.smul (D.g a) 0 (D.g b) = 0)
    (h0 : ∑ a, ∑ b, c a b * D.F a b = 0) :
    D.sym (∑ a, ∑ b, MvPolynomial.C (c a b) * (X a * X b)) = 0 := by
  have hsym : D.sym (∑ a, ∑ b, MvPolynomial.C (c a b) * (X a * X b))
      = (currentC2 W D.g).mkQ (∑ a, ∑ b, c a b • D.sq a (-1) (D.sq b (-1) W.vacuum)) := by
    simp only [sym, ev_sum, LinearMap.sum_apply, map_sum, map_smul]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    rw [ev_mul, ev_C, ev_mul, ev_X, ev_X]
    simp only [Module.End.mul_apply, LinearMap.smul_apply, Module.End.one_apply, Tq, opQ_mk]
  have hexp : ∀ a b, D.sq a (-1) (D.sq b (-1) W.vacuum)
      = W.smul (D.g a) (-1) (D.g b) + (1 / 2 : ℂ) • W.smul (D.g a) 0 (D.g b)
        - (1 / 12 : ℂ) • W.smul (D.g a) 1 (D.g b) := by
    intro a b
    rw [sq, sq, vSqZ_neg_one_vacuum, vSqZ_neg_one_current W (D.mem a) (D.mem b)]
  have hF : ∑ a, ∑ b, c a b • W.smul (D.g a) 1 (D.g b) = 0 := by
    simp only [D.form, smul_smul, ← Finset.sum_smul]
    rw [show ∑ a, ∑ b, c a b * (D.level * D.F a b) = D.level * ∑ a, ∑ b, c a b * D.F a b by
      rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun a _ => ?_
      rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun b _ => ?_; ring, h0, mul_zero,
      zero_smul]
  have hv : ∑ a, ∑ b, c a b • D.sq a (-1) (D.sq b (-1) W.vacuum)
      = -∑ a, d a • D.sq a (-2) W.vacuum := by
    have hsq2 : ∀ a, D.sq a (-2) W.vacuum = W.smul (D.g a) (-2) W.vacuum + D.g a := by
      intro a
      rw [sq, vSqZ_neg_two_vacuum W (D.mem a), ← VertexOperatorAlgebra.T_eq_Lneg1]
      rfl
    simp only [hexp, smul_add, smul_sub, Finset.sum_add_distrib, Finset.sum_sub_distrib,
      smul_comm (c _ _) ((1 / 2 : ℂ)), smul_comm (c _ _) ((1 / 12 : ℂ)), ← Finset.smul_sum, hF,
      smul_zero, sub_zero, hsq2]
    linear_combination (norm := module) hrel + h1
  rw [hsym, hv, map_neg, map_sum]
  simp only [map_smul]
  rw [neg_eq_zero]
  refine Finset.sum_eq_zero fun a _ => ?_
  have h := D.mkQ_sq_neg_mem a 2 le_rfl W.vacuum
  rw [show (-((2 : ℕ) : ℤ)) = -2 by norm_num] at h
  rw [h, smul_zero]

/-- **Symbols vanish on the ideal generated by polynomials with vanishing symbol.** -/
theorem sym_eq_zero_of_mem_span {κ : Type*} (r : κ → MvPolynomial ι ℂ)
    (hr : ∀ e, D.sym (r e) = 0) {p : MvPolynomial ι ℂ} (hp : p ∈ Ideal.span (Set.range r)) :
    D.sym p = 0 := by
  induction hp using Submodule.span_induction with
  | mem x hx => obtain ⟨e, rfl⟩ := hx; exact hr e
  | zero => exact D.sym_zero
  | add x y _ _ hx hy => rw [sym_add, hx, hy, add_zero]
  | smul a x _ hx => rw [smul_eq_mul, sym_mul, hx, map_zero]

/-- The Casimir polynomial `Σ K_{ij} X_i X_j`. -/
noncomputable def casPoly : MvPolynomial ι ℂ :=
  ∑ i, ∑ j, MvPolynomial.C (D.K i j) * (X i * X j)

theorem mkQ_Lsq_neg_two_vacuum :
    (currentC2 W D.g).mkQ (Lsq W (-2) W.vacuum)
      = (2 * (D.level + D.hdual))⁻¹ • D.sym D.casPoly := by
  rw [D.Lsq_neg_two_vacuum_eq, map_smul, casPoly]
  congr 1
  simp only [sym, ev_sum, LinearMap.sum_apply, map_sum, map_smul]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  rw [ev_mul, ev_C, ev_mul, ev_X, ev_X]
  simp only [Module.End.mul_apply, LinearMap.smul_apply, Module.End.one_apply, Tq, opQ_mk]

/-- **The current condition from the cubic symbols.** -/
theorem currentCondition_of_sym (h : ∀ i, D.sym (X i * D.casPoly) = 0) (i : ι) :
    D.sq i (-1) (Lsq W (-2) W.vacuum) ∈ currentC2 W D.g := by
  rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, ← opQ_mk (hm := by norm_num),
    mkQ_Lsq_neg_two_vacuum, map_smul]
  change _ • D.Tq i (D.sym D.casPoly) = 0
  rw [sym, ← Module.End.mul_apply, ← ev_X, ← ev_mul, ← sym, h i, smul_zero]

/-- **The vacuum quartic relation from the symbol identities** (type-generic): if the cubic
polynomials `X_i · Σ K_{jk} X_j X_k` have vanishing square symbol (e.g. lie in an ideal generated by
polynomials of vanishing symbol), then `S(L[-2]²|0⟩) = (5c²/4 + 11c/2)·G₄⋆S(|0⟩)`. -/
theorem vacuumQuarticRelation_of_symbols (hvac : W.vacuum ≠ 0)
    (h : ∀ i, D.sym (X i * D.casPoly) = 0) :
    VacuumQuarticRelation W (5 / 4 * W.centralCharge ^ 2 + 11 / 2 * W.centralCharge) :=
  D.vacuumQuarticRelation_of_currentC2 hvac (D.currentCondition_of_sym h)

