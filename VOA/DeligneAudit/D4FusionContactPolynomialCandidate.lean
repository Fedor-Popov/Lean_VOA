import VOA.DeligneAudit.D4FusionContactPolynomialDerivations
import VOA.DeligneAudit.D4FusionContactPolynomialSeeds

/-!
# The m=2 differential candidate ideal lies in the actual annihilator

The candidate is generated by all iterated current derivations of the
seven seeds. Its ideal closure includes arbitrary polynomial multipliers;
Leibniz proves that this full ideal is stable under every candidate
current derivation. Actual source inclusion uses the proved graded
intertwiners on all polynomials.
-/

namespace VOA.DeligneAudit.D4FusionContact.Polynomial

open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.DeligneSector
open VOA.DeligneAudit.DeligneSector.D4

noncomputable section

abbrev DerivIndex := (Fin 10 × Fin 2) ⊕ (Fin 8 × Fin 2)

def candidateDeriv : DerivIndex →
    Derivation ℂ (MvPolynomial (Vars 2) ℂ) (MvPolynomial (Vars 2) ℂ)
  | .inl x => g0Deriv 2 x.1 x.2.val
  | .inr x => eDeriv 2 x.1 x.2.val

def derivWord : List DerivIndex → MvPolynomial (Vars 2) ℂ → MvPolynomial (Vars 2) ℂ
  | [], p => p
  | d::l, p => candidateDeriv d (derivWord l p)

def candidateIdeal : Ideal (MvPolynomial (Vars 2) ℂ) :=
  Ideal.span (Set.range fun x : List DerivIndex × Fin 7 => derivWord x.1 (seedPoly x.2))

theorem seed_mem_candidate (j : Fin 7) : seedPoly j ∈ candidateIdeal :=
  Ideal.subset_span ⟨([],j),rfl⟩

theorem derivWord_seed_mem_candidate (l : List DerivIndex) (j : Fin 7) :
    derivWord l (seedPoly j) ∈ candidateIdeal := Ideal.subset_span ⟨(l,j),rfl⟩

/-- Leibniz handles multiplied relations, so the entire candidate ideal
is stable, not just the initially listed seed derivatives. -/
theorem candidateIdeal_deriv (d : DerivIndex) {p : MvPolynomial (Vars 2) ℂ}
    (hp : p ∈ candidateIdeal) : candidateDeriv d p ∈ candidateIdeal := by
  change p ∈ Submodule.span (MvPolynomial (Vars 2) ℂ) _ at hp
  induction hp using Submodule.span_induction with
  | mem p hp =>
      obtain ⟨⟨l,j⟩,rfl⟩ := hp
      exact derivWord_seed_mem_candidate (d::l) j
  | zero => rw [map_zero]; exact Ideal.zero_mem _
  | add p q hp hq ihp ihq => rw [map_add]; exact Ideal.add_mem _ ihp ihq
  | smul a p hp ih =>
      change candidateDeriv d (a*p) ∈ candidateIdeal
      rw [(candidateDeriv d).leibniz]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ ih) (Ideal.mul_mem_right _ _ hp)

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable {R : CurrentModule D4sector.f V} {w : V}

theorem source_candidate_deriv_closed (h : LocalWeylRelG D4sector R w 2) (d : DerivIndex) :
    ∀ p ∈ annIdeal R w (modeLetter 2), candidateDeriv d p ∈ annIdeal R w (modeLetter 2) := by
  cases d with
  | inl x => exact source_g0_ann_closed (by decide) h x.1 x.2.val
  | inr x => exact source_e_ann_closed (by decide) h x.1 x.2.val

theorem source_derivWord_seed_mem_ann (h : LocalWeylRelG D4sector R w 2)
    (l : List DerivIndex) (j : Fin 7) :
    derivWord l (seedPoly j) ∈ annIdeal R w (modeLetter 2) := by
  induction l with
  | nil => exact source_seed_mem_ann h j
  | cons d l ih => exact source_candidate_deriv_closed h d _ ih

/-- The whole concrete candidate ideal, including all multiplied and
iterated differentiated seed relations, annihilates the actual PBW source. -/
theorem source_candidateIdeal_le_ann (h : LocalWeylRelG D4sector R w 2) :
    candidateIdeal ≤ annIdeal R w (modeLetter 2) := by
  apply Ideal.span_le.mpr
  rintro _ ⟨⟨l,j⟩,rfl⟩
  exact source_derivWord_seed_mem_ann h l j

def candidateQuotientMap (h : LocalWeylRelG D4sector R w 2) :
    (MvPolynomial (Vars 2) ℂ ⧸ candidateIdeal.restrictScalars ℂ) →ₗ[ℂ] Gr R w :=
  polyQuotientMap R w (modeLetter 2) candidateIdeal (source_candidateIdeal_le_ann h)

theorem candidateQuotientMap_surjective (h : LocalWeylRelG D4sector R w 2) :
    Function.Surjective (candidateQuotientMap h) := by
  apply polyQuotientMap_surjective
  apply modeLetter_cover
  intro i r hr
  exact localWeyl_high_kills (by decide) h (radIndex i) r hr

end
end VOA.DeligneAudit.D4FusionContact.Polynomial

