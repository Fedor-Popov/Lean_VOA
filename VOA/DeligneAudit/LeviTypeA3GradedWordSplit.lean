import VOA.DeligneAudit.LeviTypeA3GradedPairKey
import VOA.DeligneAudit.LeviTypeA3CountCutoff

/-! Sort a radical word into its three commuting colours. -/

namespace VOA.DeligneAudit.A3Sector

open VOA.DeligneAudit.LeviTypeA VOA.DeligneAudit.LeviConversion

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : VOA.DeligneAudit.SectorWeyl.CurrentModule bracketTable V) (w : V)

private theorem a3_colour_prod_comm (i j : Fin 3) (s : ℕ) (xs : List ℕ) :
    radicalOp ρ i s * (xs.map fun t => radicalOp ρ j t).prod =
      (xs.map fun t => radicalOp ρ j t).prod * radicalOp ρ i s := by
  induction xs with
  | nil => simp
  | cons t xs ih =>
      simp only [List.map_cons, List.prod_cons]
      calc
        radicalOp ρ i s * (radicalOp ρ j t *
            (xs.map fun u => radicalOp ρ j u).prod) =
            (radicalOp ρ i s * radicalOp ρ j t) *
              (xs.map fun u => radicalOp ρ j u).prod := by rw [mul_assoc]
        _ = (radicalOp ρ j t * radicalOp ρ i s) *
              (xs.map fun u => radicalOp ρ j u).prod := by rw [radicalOp_comm]
        _ = radicalOp ρ j t *
              (radicalOp ρ i s * (xs.map fun u => radicalOp ρ j u).prod) := by
                rw [mul_assoc]
        _ = radicalOp ρ j t *
              ((xs.map fun u => radicalOp ρ j u).prod * radicalOp ρ i s) := by
                rw [ih]
        _ = _ := by rw [mul_assoc]

private theorem a3ColourModes_cons (i j : Fin 3) (s : ℕ)
    (l : List (Fin 3 × ℕ)) :
    a3ColourModes j ((i, s) :: l) =
      if i = j then s :: a3ColourModes j l else a3ColourModes j l := by
  by_cases h : i = j <;> simp [a3ColourModes, h]

/-- The three colour lists give the original radical operator word. -/
theorem a3_radicalWord_split_three (l : List (Fin 3 × ℕ)) :
    radicalWord (radicalOp ρ) l =
      (aWord (fun s => ρ.op (F 0) s) (a3ColourModes 0 l) *
        ((a3ColourModes 1 l).map fun s => ρ.op (F 1) s).prod) *
          ((a3ColourModes 2 l).map fun s => ρ.op (F 2) s).prod := by
  induction l with
  | nil => simp [radicalWord, a3ColourModes, aWord]
  | cons x l ih =>
      rcases x with ⟨i, s⟩
      fin_cases i
      · change _ * radicalWord (radicalOp ρ) l = _
        rw [ih]
        simp [a3ColourModes_cons, radicalOp, aWord, mul_assoc]
      · change _ * radicalWord (radicalOp ρ) l = _
        rw [ih]
        have hc : ρ.op (F 1) s *
            ((a3ColourModes 0 l).map fun t => ρ.op (F 0) t).prod =
            ((a3ColourModes 0 l).map fun t => ρ.op (F 0) t).prod *
              ρ.op (F 1) s := by
          simpa [radicalOp] using
            a3_colour_prod_comm ρ 1 0 s (a3ColourModes 0 l)
        simp [a3ColourModes_cons, radicalOp, aWord, ← mul_assoc]
        rw [hc]
      · change _ * radicalWord (radicalOp ρ) l = _
        rw [ih]
        have hc0 : ρ.op (F 2) s *
            ((a3ColourModes 0 l).map fun t => ρ.op (F 0) t).prod =
            ((a3ColourModes 0 l).map fun t => ρ.op (F 0) t).prod *
              ρ.op (F 2) s := by
          simpa [radicalOp] using
            a3_colour_prod_comm ρ 2 0 s (a3ColourModes 0 l)
        have hc1 : ρ.op (F 2) s *
            ((a3ColourModes 1 l).map fun t => ρ.op (F 1) t).prod =
            ((a3ColourModes 1 l).map fun t => ρ.op (F 1) t).prod *
              ρ.op (F 2) s := by
          simpa [radicalOp] using
            a3_colour_prod_comm ρ 2 1 s (a3ColourModes 1 l)
        simp [a3ColourModes_cons, radicalOp, aWord, ← mul_assoc]
        rw [hc0]
        simp only [mul_assoc]
        rw [← mul_assoc (ρ.op (F 2) s)
          ((a3ColourModes 1 l).map fun t => ρ.op (F 1) t).prod
          ((a3ColourModes 2 l).map fun t => ρ.op (F 2) t).prod, hc1]
        simp only [mul_assoc]

private theorem a3ColourModes_sum (l : List (Fin 3 × ℕ)) :
    (a3ColourModes 0 l).sum + (a3ColourModes 1 l).sum +
      (a3ColourModes 2 l).sum = (l.map Prod.snd).sum := by
  induction l with
  | nil => simp [a3ColourModes]
  | cons x l ih =>
      rcases x with ⟨i, s⟩
      fin_cases i <;>
        simp [a3ColourModes_cons] at * <;> omega

/-- The fixed-key layer is generated by sorted three-colour words. -/
def a3SortedKeySpan (k : A3RadicalKey) : Submodule ℂ V :=
  Submodule.span ℂ {v | ∃ xs ys zs : List ℕ,
    xs.length = k.d₁ ∧ ys.length = k.d₂ ∧ zs.length = k.d₃ ∧
      xs.sum + ys.sum + zs.sum = k.degree ∧
        v = (aWord (fun s => ρ.op (F 0) s) xs *
          (ys.map fun s => ρ.op (F 1) s).prod *
            (zs.map fun s => ρ.op (F 2) s).prod) w}

theorem a3KeyLayer_le_sorted (k : A3RadicalKey) :
    a3KeyLayer ρ w k ≤ a3SortedKeySpan ρ w k := by
  rw [a3KeyLayer, a3SortedKeySpan, Submodule.span_le]
  intro v hv
  obtain ⟨l, h₁, h₂, h₃, hdegree, _, rfl⟩ := hv
  let xs := a3ColourModes 0 l
  let ys := a3ColourModes 1 l
  let zs := a3ColourModes 2 l
  have hx : xs.length = k.d₁ := (a3ColourModes_length 0 l).trans h₁
  have hy : ys.length = k.d₂ := (a3ColourModes_length 1 l).trans h₂
  have hz : zs.length = k.d₃ := (a3ColourModes_length 2 l).trans h₃
  have hd : xs.sum + ys.sum + zs.sum = k.degree :=
    (a3ColourModes_sum l).trans hdegree
  have hw := a3_radicalWord_split_three ρ l
  apply Submodule.subset_span
  refine ⟨xs, ys, zs, hx, hy, hz, hd, ?_⟩
  rw [hw]
  rfl

theorem a3SortedKeySpan_le_layer (k : A3RadicalKey) :
    a3SortedKeySpan ρ w k ≤ a3KeyLayer ρ w k := by
  rw [a3SortedKeySpan, Submodule.span_le]
  intro v hv
  obtain ⟨xs, ys, zs, hx, hy, hz, hd, rfl⟩ := hv
  have hw := a3_three_mode_mem_key ρ w xs ys zs
  simpa only [hx, hy, hz, hd] using hw

theorem a3KeyLayer_eq_sorted (k : A3RadicalKey) :
    a3KeyLayer ρ w k = a3SortedKeySpan ρ w k :=
  le_antisymm (a3KeyLayer_le_sorted ρ w k)
    (a3SortedKeySpan_le_layer ρ w k)

end VOA.DeligneAudit.A3Sector

#print axioms VOA.DeligneAudit.A3Sector.a3_radicalWord_split_three
#print axioms VOA.DeligneAudit.A3Sector.a3KeyLayer_le_sorted
#print axioms VOA.DeligneAudit.A3Sector.a3SortedKeySpan_le_layer
#print axioms VOA.DeligneAudit.A3Sector.a3KeyLayer_eq_sorted
