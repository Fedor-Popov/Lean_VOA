import VOA.DeligneAudit.D4CoreCellTruncationAudit

/-!
Polynomial identities for the common-root relation of the two Grassmannian alphabets.
The four site transitions preserve the ideal generated by the adjoint characteristic
and the complementary characteristic.
-/

namespace VOA.DeligneAudit.D4LevelReduction

noncomputable section

open Polynomial

variable {R : Type*} [CommRing R]

/-- The common-root ideal of two characteristic polynomials. -/
def commonRootIdeal (p q : R[X]) : Ideal R[X] :=
  Ideal.span {p} ⊔ Ideal.span {q}

theorem commonRootIdeal_left (p q : R[X]) : p ∈ commonRootIdeal p q :=
  (show Ideal.span {p} ≤ commonRootIdeal p q from le_sup_left)
    (Ideal.subset_span (Set.mem_singleton _))

theorem commonRootIdeal_right (p q : R[X]) : q ∈ commonRootIdeal p q :=
  (show Ideal.span {q} ≤ commonRootIdeal p q from le_sup_right)
    (Ideal.subset_span (Set.mem_singleton _))

/-- Removing an unused site preserves the divided complementary characteristic. -/
theorem commonRoot_unusedSite (p q : R[X]) (z : R) (hz : z * q.coeff 0 = 0) :
    Polynomial.C (z * p.coeff 0) * q.divX ∈ commonRootIdeal p q := by
  have hp := X_mul_divX_add p
  have hq := X_mul_divX_add q
  have he : Polynomial.C (z * p.coeff 0) * q.divX =
      Polynomial.C z * q.divX * p - Polynomial.C z * p.divX * q := by
    have hc : Polynomial.C z * Polynomial.C (q.coeff 0) = 0 := by
      rw [← map_mul, hz, map_zero]
    rw [map_mul]
    linear_combination Polynomial.C z * q.divX * hp -
      Polynomial.C z * p.divX * hq + p.divX * hc
  rw [he]
  exact (commonRootIdeal p q).sub_mem
    ((commonRootIdeal p q).mul_mem_left _ (commonRootIdeal_left p q))
    ((commonRootIdeal p q).mul_mem_left _ (commonRootIdeal_right p q))

/-- A site belonging to both common-root alphabets contributes one power of the variable. -/
theorem commonRoot_sharedSite (p q : R[X]) (z : R) (I : Ideal R)
    (hp : z * p.coeff 0 ∈ I) (hq : z * q.coeff 0 ∈ I) :
    Polynomial.C z * X * p.divX ∈ I.map Polynomial.C ⊔ commonRootIdeal p q ∧
      Polynomial.C z * X * q.divX ∈ I.map Polynomial.C ⊔ commonRootIdeal p q := by
  let J := I.map Polynomial.C ⊔ commonRootIdeal p q
  have hmem (r : R[X]) (hr : r ∈ commonRootIdeal p q) (hz : z * r.coeff 0 ∈ I) :
      Polynomial.C z * X * r.divX ∈ J := by
    have he : Polynomial.C z * X * r.divX =
        Polynomial.C z * r - Polynomial.C (z * r.coeff 0) := by
      rw [map_mul]
      linear_combination Polynomial.C z * X_mul_divX_add r
    rw [he]
    exact J.sub_mem
      (J.mul_mem_left _ ((show commonRootIdeal p q ≤ J from le_sup_right) hr))
      ((show I.map Polynomial.C ≤ J from le_sup_left)
        (Ideal.mem_map_of_mem Polynomial.C hz))
  exact ⟨hmem p (commonRootIdeal_left p q) hp,
    hmem q (commonRootIdeal_right p q) hq⟩

/-- Removing a site from the first alphabet transfers the complementary factorization. -/
theorem commonRoot_containedSite (p pb g gb : R[X]) (m : ℕ) (I : Ideal R)
    (hp : p * pb = X ^ (m + 1)) (hg : g * gb = X ^ (m + 1))
    (hgc : g.coeff 0 ∈ I) :
    Polynomial.C (pb.coeff 0) * p.divX ∈ I.map Polynomial.C ⊔ commonRootIdeal p gb := by
  let J := I.map Polynomial.C ⊔ commonRootIdeal p gb
  have he : Polynomial.C (pb.coeff 0) * p.divX =
      g.divX * gb + Polynomial.C (g.coeff 0) * gb.divX - pb.divX * p := by
    have hfirst := SL4T.polynomial_complement_divX p pb m hp
    have hsecond := congrArg Polynomial.divX hg
    rw [SL4T.polynomial_divX_mul, divX_X_pow, if_neg (by omega),
      Nat.add_sub_cancel] at hsecond
    linear_combination -hfirst - hsecond
  rw [he]
  have hleft : p ∈ J :=
    (show commonRootIdeal p gb ≤ J from le_sup_right) (commonRootIdeal_left p gb)
  have hright : gb ∈ J :=
    (show commonRootIdeal p gb ≤ J from le_sup_right) (commonRootIdeal_right p gb)
  have hc : Polynomial.C (g.coeff 0) ∈ J :=
    (show I.map Polynomial.C ≤ J from le_sup_left) (Ideal.mem_map_of_mem Polynomial.C hgc)
  exact J.sub_mem (J.add_mem (J.mul_mem_left _ hright) (J.mul_mem_right _ hc))
    (J.mul_mem_left _ hleft)

end

end VOA.DeligneAudit.D4LevelReduction

#print axioms VOA.DeligneAudit.D4LevelReduction.commonRoot_unusedSite
#print axioms VOA.DeligneAudit.D4LevelReduction.commonRoot_sharedSite
#print axioms VOA.DeligneAudit.D4LevelReduction.commonRoot_containedSite
