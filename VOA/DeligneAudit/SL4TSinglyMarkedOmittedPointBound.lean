import VOA.DeligneAudit.SL4TSinglyMarkedOmittedPointTools

/-!
# The omitted-point stratum of the singly marked full flag without doubles

Let `T` be the singly marked full flag on `n` roots without doubles (cutoff `n - 1` on the first
group `U = Vᶜ`, `n` on the marked group `V`, `q = |V| ≥ 1`). For a set `Y` of roots with complement
`Z`, the omitted-point stratum ideal is `(∏ Z, ∏ (V ∩ Y) · c(Z))` (`omittedPointStratumIdeal`), with
`c(Z)` the subleading coefficient. Its dimension is at least the number of configurations whose
root at the first nonzero point lies in `Y`:

`(|U ∩ Y| · q + |V ∩ Y| · (q - 1)) · (n - 2)!`   (`singlyMarkedFlag_omittedPoint_finrank_ge`).

The proof is by induction on `n`. With `U = ∅` it is the product stratum of the unmarked flag
without doubles. Otherwise delete a root `u ∈ U`:

* if `u ∉ Y` for some such `u`, both generators lie in `u T` (`u · c(Z') = top(Z') - c(Z)`, and
  `∏ (V ∩ Y) · ∏ Z'` contains `∏ V = 0`), and the positive layers receive the child stratum;
* if `U ⊆ Y`, the top layer lies in the ideal because `u^(n-2) = ± ∏(U ∖ u) · c(V)` and
  `c(V) ∈ (∏ Z, ∏(V ∖ Z) · c(Z))`; the other layers receive the child stratum, generated by the
  same two elements.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

/-- The omitted-point stratum ideal `(∏ Z, ∏ (V ∩ Y) · c(Z))`, `Z = Yᶜ`. -/
def omittedPointStratumIdeal {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ))
    (V Y : Finset (Fin n)) : Ideal (MvPolynomial (Fin n) ℂ ⧸ I) :=
  Ideal.span {∏ i ∈ Yᶜ, quotientRoot I i,
    (∏ i ∈ V ∩ Y, quotientRoot I i) * groupSubtopCoefficient (quotientRoot I) Yᶜ}

/-- The two generators of the stratum ideal are images of polynomials. -/
theorem omittedPointStratumIdeal_eq_span {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ))
    (V Y : Finset (Fin n)) :
    omittedPointStratumIdeal I V Y = Ideal.span {Ideal.Quotient.mk I (∏ i ∈ Yᶜ, X i),
      Ideal.Quotient.mk I ((∏ i ∈ V ∩ Y, X i) * groupSubtopCoefficient X Yᶜ)} := by
  rw [omittedPointStratumIdeal, map_mul, groupSubtopCoefficient_map, map_prod, map_prod]
  rfl

/-- Evaluation of the two generator polynomials. -/
theorem aeval_omittedPointGenerators {A : Type*} [CommRing A] [Algebra ℂ A] {n : ℕ}
    (x : Fin n → A) (V Y : Finset (Fin n)) :
    aeval x (∏ i ∈ Yᶜ, (X i : MvPolynomial (Fin n) ℂ)) = ∏ i ∈ Yᶜ, x i ∧
      aeval x ((∏ i ∈ V ∩ Y, (X i : MvPolynomial (Fin n) ℂ)) *
        groupSubtopCoefficient (X : Fin n → MvPolynomial (Fin n) ℂ) Yᶜ) =
        (∏ i ∈ V ∩ Y, x i) * groupSubtopCoefficient x Yᶜ := by
  constructor
  · simp
  · rw [map_mul, map_prod]
    simp only [aeval_X]
    congr 1
    have h := groupSubtopCoefficient_map (aeval x).toRingHom
      (X : Fin n → MvPolynomial (Fin n) ℂ) Yᶜ
    simpa using h

theorem deletedGroup_inter {n : ℕ} (u : Fin (n + 1)) (S T : Finset (Fin (n + 1))) :
    deletedGroup u (S ∩ T) = deletedGroup u S ∩ deletedGroup u T := by
  ext j
  simp [deletedGroup]

/-- **The omitted-point stratum.** -/
theorem singlyMarkedFlag_omittedPoint_finrank_ge (n : ℕ) (V Y : Finset (Fin n))
    (hV : V.Nonempty) :
    ((Vᶜ ∩ Y).card * V.card + (V ∩ Y).card * (V.card - 1)) * (n - 2).factorial ≤
      Module.finrank ℂ ((omittedPointStratumIdeal (singlyMarkedFlagIdeal n V (n - 1)) V Y
        ).restrictScalars ℂ) := by
  classical
  induction n with
  | zero =>
      obtain ⟨a, _⟩ := hV
      exact a.elim0
  | succ n ih =>
      by_cases hU : V = Finset.univ
      · -- every root marked: the product stratum of the unmarked flag
        subst hU
        rw [singlyMarkedFlagIdeal_univ_eq (n + 1) (by omega)]
        have hprod := unmarkedFlag_noDouble_product_finrank_ge (n + 1) Yᶜ
        have hmono : (Ideal.span {∏ i ∈ Yᶜ, quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1)) i}
            ).restrictScalars ℂ ≤ (omittedPointStratumIdeal (unmarkedFlagIdeal (n + 1) (n + 1))
              Finset.univ Y).restrictScalars ℂ := fun x hx =>
          Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) hx
        refine le_trans ?_ (hprod.trans (Submodule.finrank_mono hmono))
        rw [Finset.compl_univ, Finset.empty_inter, Finset.card_empty, Finset.univ_inter,
          Finset.card_univ, Fintype.card_fin, Finset.card_compl, Fintype.card_fin,
          show n + 1 - (n + 1 - Y.card) = Y.card by
            have := Finset.card_le_univ Y; rw [Fintype.card_fin] at this; omega,
          Nat.add_sub_cancel, zero_mul, zero_add]
        have hf : n * (n + 1 - 2).factorial ≤ n.factorial := by
          rcases n with _ | n
          · simp
          · rw [show n + 1 + 1 - 2 = n by omega, Nat.factorial_succ]
        calc Y.card * n * (n + 1 - 2).factorial = Y.card * (n * (n + 1 - 2).factorial) := by
              ring
          _ ≤ Y.card * n.factorial := Nat.mul_le_mul_left _ hf
      obtain ⟨u₀, hu₀⟩ := exists_notMem_of_ne_univ V hU
      obtain ⟨B, rfl⟩ : ∃ B, n = B + 1 := by
        obtain ⟨v, hv⟩ := hV
        refine ⟨n - 1, ?_⟩
        rcases n with _ | n
        · exact absurd ((show u₀ = v from Fin.ext (by omega)) ▸ hv) hu₀
        · omega
      have hk0 : 2 * 0 ≤ B + 1 := by omega
      show ((Vᶜ ∩ Y).card * V.card + (V ∩ Y).card * (V.card - 1)) * B.factorial ≤
        Module.finrank ℂ ((omittedPointStratumIdeal (singlyMarkedFlagIdeal (B + 2) V (B + 1 - 0))
          V Y).restrictScalars ℂ)
      set r := quotientRoot (singlyMarkedFlagIdeal (B + 2) V (B + 1 - 0)) with hr
      have hE : groupElementaryPolynomial r Finset.univ = 1 :=
        singlyMarkedFlag_group_elementary _ _ _
      have hVprod : ∏ i ∈ V, r i = 0 := singlyMarkedFlag_product_zero _ _ _
      have hcardV : V.card + Vᶜ.card = B + 2 := by
        rw [Finset.card_compl, Fintype.card_fin]
        have := Finset.card_le_univ V
        rw [Fintype.card_fin] at this
        omega
      have hq1 : 1 ≤ V.card := Finset.card_pos.mpr hV
      set I := omittedPointStratumIdeal (singlyMarkedFlagIdeal (B + 2) V (B + 1 - 0)) V Y with hI
      have hIgen : I = Ideal.span {∏ i ∈ Yᶜ, r i,
          (∏ i ∈ V ∩ Y, r i) * groupSubtopCoefficient r Yᶜ} := rfl
      have hcutu : ∀ u, u ∉ V → r u ^ (B + 1) = 0 := fun u hu =>
        singlyMarkedFlag_unmarked_cutoff _ _ _ u hu
      -- the child data after deleting `u ∉ V`
      have hchild : ∀ u (hu : u ∉ V) (i : ℕ) (hi : i < B + 1),
          Module.finrank ℂ ((omittedPointStratumIdeal
              (singlyMarkedFlagIdeal (B + 1) (deletedGroup u V) (B + 1 - 1)) (deletedGroup u V)
                (deletedGroup u Y)).restrictScalars ℂ) ≤
            Module.finrank ℂ (((Ideal.span {∏ j ∈ (deletedGroup u Y)ᶜ, r (u.succAbove j),
              (∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
                groupSubtopCoefficient (fun j => r (u.succAbove j)) (deletedGroup u Y)ᶜ}
                ).restrictScalars ℂ).map
              (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) i)).toLinearMap) := by
        intro u hu i hi
        have hinj := singlyMarkedLayerMap_injective_lower B 0 hk0 V hV u hu i (Nat.zero_le i)
          (by omega)
        have hl := childPair_finrank_le_layer r u i _
          (singlyMarkedLayer_lower_le_ker (B + 1) V (B + 1 - 0) 0 (by omega) (by omega) u hu i
            (Nat.zero_le i)) hinj (∏ j ∈ (deletedGroup u Y)ᶜ, X j)
          ((∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, X j) *
            groupSubtopCoefficient X (deletedGroup u Y)ᶜ)
        have hg := aeval_omittedPointGenerators (fun j => r (u.succAbove j)) (deletedGroup u V)
          (deletedGroup u Y)
        rw [hg.1, hg.2, ← omittedPointStratumIdeal_eq_span] at hl
        exact hl
      have hcount : ∀ u, u ∉ V →
          (deletedGroup u V).card = V.card ∧
            (deletedGroup u V ∩ deletedGroup u Y).card = (V ∩ Y).card ∧
              (deletedGroup u V)ᶜ ∩ deletedGroup u Y = deletedGroup u (Vᶜ ∩ Y) := by
        intro u hu
        refine ⟨deletedGroup_card_of_notMem V u hu, ?_, ?_⟩
        · rw [← deletedGroup_inter]
          exact deletedGroup_card_of_notMem _ u (fun h => hu (Finset.mem_inter.mp h).1)
        · rw [deletedGroup_inter, deletedGroup_compl]
      by_cases hcase : ∃ u, u ∉ V ∧ u ∉ Y
      · -- a first-group root outside `Y`
        obtain ⟨u, hu, huY⟩ := hcase
        have hY' : u ∈ Yᶜ := Finset.mem_compl.mpr huY
        have hV' : (deletedGroup u V).Nonempty := by
          rw [← Finset.card_pos, deletedGroup_card_of_notMem V u hu]
          exact Finset.card_pos.mpr hV
        obtain ⟨hcV, hcVY, hcUY⟩ := hcount u hu
        have hcUY' : ((deletedGroup u V)ᶜ ∩ deletedGroup u Y).card = (Vᶜ ∩ Y).card := by
          rw [hcUY]
          exact deletedGroup_card_of_notMem _ u (fun h => huY (Finset.mem_inter.mp h).2)
        have hs : ∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j) =
            ∏ i ∈ V ∩ Y, r i := by
          rw [← deletedGroup_inter]
          exact prod_deletedGroup_of_notMem r (V ∩ Y) u (fun h => hu (Finset.mem_inter.mp h).1)
        have hzero : (∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
            ∏ j ∈ (deletedGroup u Y)ᶜ, r (u.succAbove j) = 0 := by
          rw [← Finset.prod_union (Finset.disjoint_left.mpr fun j hj hj' =>
            (Finset.mem_compl.mp hj') (Finset.mem_inter.mp hj).2)]
          apply prod_eq_zero_of_subset (fun j => r (u.succAbove j)) _
            ((prod_deletedGroup_of_notMem r V u hu).trans hVprod)
          intro j hj
          by_cases hjY : j ∈ deletedGroup u Y
          · exact Finset.mem_union_left _ (Finset.mem_inter.mpr ⟨hj, hjY⟩)
          · exact Finset.mem_union_right _ (Finset.mem_compl.mpr hjY)
        have hJ : ∀ c ∈ Ideal.span {∏ j ∈ (deletedGroup u Y)ᶜ, r (u.succAbove j),
            (∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
              groupSubtopCoefficient (fun j => r (u.succAbove j)) (deletedGroup u Y)ᶜ},
            r u * c ∈ I := by
          intro c hc
          obtain ⟨s, t, rfl⟩ := Ideal.mem_span_pair.mp hc
          have hm1 : r u * ∏ j ∈ (deletedGroup u Y)ᶜ, r (u.succAbove j) ∈ I := by
            rw [← deletedGroup_compl, ← prod_eq_mul_deletedGroup_of_mem r Yᶜ u hY', hIgen]
            exact Ideal.subset_span (Set.mem_insert _ _)
          have hm2 : r u * ((∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
              groupSubtopCoefficient (fun j => r (u.succAbove j)) (deletedGroup u Y)ᶜ) ∈ I := by
            by_cases hne : (deletedGroup u Yᶜ).Nonempty
            · have hsub := groupSubtopCoefficient_deleted_of_mem r Yᶜ u hY' hne
              have htop := groupElementaryPolynomial_coeff_card (fun j => r (u.succAbove j))
                (deletedGroup u Y)ᶜ
              rw [deletedGroup_compl] at hsub
              have heq : r u * ((∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
                  groupSubtopCoefficient (fun j => r (u.succAbove j)) (deletedGroup u Y)ᶜ) =
                  -((∏ i ∈ V ∩ Y, r i) * groupSubtopCoefficient r Yᶜ) +
                    (-1) ^ ((deletedGroup u Y)ᶜ).card *
                      ((∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
                        ∏ j ∈ (deletedGroup u Y)ᶜ, r (u.succAbove j)) := by
                rw [hsub, htop, ← hs]
                ring
              rw [heq, hzero, mul_zero, add_zero, hIgen]
              exact I.neg_mem (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
            · have hYu : ∏ i ∈ Yᶜ, r i = r u := by
                rw [prod_eq_mul_deletedGroup_of_mem r Yᶜ u hY',
                  Finset.not_nonempty_iff_eq_empty.mp hne, Finset.prod_empty, mul_one]
              rw [← hYu, hIgen]
              exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _))
          rw [mul_add, mul_left_comm, mul_left_comm (r u) t]
          exact I.add_mem (I.mul_mem_left _ hm1) (I.mul_mem_left _ hm2)
        have hsum := pairStratum_layers_le (r u) (B + 1) (hcutu u hu) I _ hJ
        rw [Nat.add_sub_cancel] at hsum
        refine le_trans ?_ hsum
        have hterm : ∀ i ∈ Finset.range B,
            ((Vᶜ ∩ Y).card * V.card + (V ∩ Y).card * (V.card - 1)) * (B - 1).factorial ≤
              Module.finrank ℂ (((Ideal.span {∏ j ∈ (deletedGroup u Y)ᶜ, r (u.succAbove j),
                (∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
                  groupSubtopCoefficient (fun j => r (u.succAbove j)) (deletedGroup u Y)ᶜ}
                  ).restrictScalars ℂ).map
                (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) (i + 1))).toLinearMap) := by
          intro i hi
          have hrec := ih (deletedGroup u V) (deletedGroup u Y) hV'
          rw [hcV, hcVY, hcUY', show B + 1 - 2 = B - 1 by omega] at hrec
          exact hrec.trans (hchild u hu (i + 1) (by have := Finset.mem_range.mp hi; omega))
        refine le_trans ?_ (Finset.sum_le_sum hterm)
        rw [Finset.sum_const, Finset.card_range, smul_eq_mul]
        rcases Nat.eq_zero_or_pos B with hB | hB
        · subst hB
          have hU1 : Vᶜ.card = 1 := by
            have : 1 ≤ Vᶜ.card := Finset.card_pos.mpr ⟨u, Finset.mem_compl.mpr hu⟩
            omega
          have ha : (Vᶜ ∩ Y).card = 0 := by
            have hsub : Vᶜ ∩ Y ⊆ Vᶜ.erase u := fun i hi => Finset.mem_erase.mpr
              ⟨fun h => huY (h ▸ (Finset.mem_inter.mp hi).2), (Finset.mem_inter.mp hi).1⟩
            have := Finset.card_le_card hsub
            rw [Finset.card_erase_of_mem (Finset.mem_compl.mpr hu), hU1] at this
            omega
          rw [ha, show V.card = 1 by omega]
          simp
        · rw [← Nat.mul_factorial_pred (show B ≠ 0 by omega)]
          apply le_of_eq
          ring
      · -- every first-group root lies in `Y`
        have hUY : ∀ u, u ∉ V → u ∈ Y := fun u hu => by
          by_contra h
          exact hcase ⟨u, hu, h⟩
        set u := u₀
        have hu : u ∉ V := hu₀
        have huY : u ∈ Y := hUY u hu
        have hY' : u ∉ Yᶜ := fun h => (Finset.mem_compl.mp h) huY
        have hV' : (deletedGroup u V).Nonempty := by
          rw [← Finset.card_pos, deletedGroup_card_of_notMem V u hu]
          exact Finset.card_pos.mpr hV
        obtain ⟨hcV, hcVY, hcUY⟩ := hcount u hu
        have hcUY' : ((deletedGroup u V)ᶜ ∩ deletedGroup u Y).card + 1 = (Vᶜ ∩ Y).card := by
          rw [hcUY]
          exact deletedGroup_card_of_mem _ u
            (Finset.mem_inter.mpr ⟨Finset.mem_compl.mpr hu, huY⟩)
        -- the child generators are the parent generators
        have hgen : Ideal.span {∏ j ∈ (deletedGroup u Y)ᶜ, r (u.succAbove j),
            (∏ j ∈ deletedGroup u V ∩ deletedGroup u Y, r (u.succAbove j)) *
              groupSubtopCoefficient (fun j => r (u.succAbove j)) (deletedGroup u Y)ᶜ} = I := by
          rw [← deletedGroup_compl, prod_deletedGroup_of_notMem r Yᶜ u hY',
            ← deletedGroup_inter,
            prod_deletedGroup_of_notMem r (V ∩ Y) u (fun h => hu (Finset.mem_inter.mp h).1),
            groupSubtopCoefficient_deleted_of_notMem r Yᶜ u hY', hIgen]
        -- the top layer lies in the stratum
        have hZV : Yᶜ ⊆ V := fun i hi => by
          by_contra hiV
          exact (Finset.mem_compl.mp hi) (hUY i hiV)
        have hcV' : (Vᶜ.erase u).card + (V.card - 1) = B := by
          rw [Finset.card_erase_of_mem (Finset.mem_compl.mpr hu)]
          have : 1 ≤ Vᶜ.card := Finset.card_pos.mpr ⟨u, Finset.mem_compl.mpr hu⟩
          omega
        have hkey : r u ^ B ∈ I := by
          have hid := coinvariant_product_topCoefficient r hE V hVprod u hu
          rw [hcV'] at hid
          rw [← hid]
          apply Ideal.mul_mem_left
          by_cases hZ : (Yᶜ).Nonempty
          · have hm := groupSubtopCoefficient_mem_span r V Yᶜ hZV hZ
            rw [sdiff_compl, Finset.inf_eq_inter] at hm
            exact hm
          · rw [Finset.not_nonempty_iff_eq_empty] at hZ
            have h1 : (1 : SinglyMarkedFlagRing (B + 2) V (B + 1 - 0)) ∈ I := by
              rw [hIgen, ← Finset.prod_empty (f := r), ← hZ]
              exact Ideal.subset_span (Set.mem_insert _ _)
            exact (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one).symm ▸ Submodule.mem_top
        let W : ℕ → Submodule ℂ (SinglyMarkedFlagRing (B + 2) V (B + 1 - 0)) := fun j =>
          if j < B then I.restrictScalars ℂ else ⊤
        have hW : ∀ j < B + 1, ∀ c ∈ W j, r u ^ j * c ∈
            I.restrictScalars ℂ ⊔ (Ideal.span {r u ^ (j + 1)}).restrictScalars ℂ := by
          intro j hj c hc
          apply Submodule.mem_sup_left
          rw [Submodule.restrictScalars_mem]
          by_cases hjB : j < B
          · have hc' : c ∈ I := by
              have : W j = I.restrictScalars ℂ := if_pos hjB
              rw [this, Submodule.restrictScalars_mem] at hc
              exact hc
            exact I.mul_mem_left _ hc'
          · obtain rfl : j = B := by omega
            exact I.mul_mem_right _ hkey
        have hsum := layer_finrank_sum_le (r u) (B + 1) (hcutu u hu) _ W hW
        rw [Finset.sum_range_succ] at hsum
        have hWB : W B = ⊤ := if_neg (lt_irrefl B)
        have hconv : ∀ i ∈ Finset.range B, Module.finrank ℂ ((W i).map
            (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) i)).toLinearMap) =
            Module.finrank ℂ ((I.restrictScalars ℂ).map
              (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) i)).toLinearMap) := by
          intro i hi
          have : W i = I.restrictScalars ℂ := if_pos (Finset.mem_range.mp hi)
          rw [this]
        rw [Finset.sum_congr rfl hconv, hWB, Submodule.map_top,
          LinearMap.range_eq_top.mpr (Ideal.Quotient.mkₐ_surjective ℂ _), finrank_top] at hsum
        have hlayer := singlyMarkedLayer_finrank_eq B 0 hk0 V hV u hu B (by omega)
        rw [if_neg (by omega), singlyMarkedFlag_finrank_eq B 0 (by omega) _ hV', hcV,
          ← hr] at hlayer
        have hc0 := fullFlagConfiguration_card_closed B 0 (by omega)
        rw [pow_zero, one_mul] at hc0
        rw [hc0] at hlayer
        rw [hlayer] at hsum
        refine le_trans ?_ hsum
        have hterm : ∀ i ∈ Finset.range B,
            (((Vᶜ ∩ Y).card - 1) * V.card + (V ∩ Y).card * (V.card - 1)) * (B - 1).factorial ≤
              Module.finrank ℂ ((I.restrictScalars ℂ).map
                (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) i)).toLinearMap) := by
          intro i hi
          have hrec := ih (deletedGroup u V) (deletedGroup u Y) hV'
          rw [hcV, hcVY, show ((deletedGroup u V)ᶜ ∩ deletedGroup u Y).card =
            (Vᶜ ∩ Y).card - 1 by omega, show B + 1 - 2 = B - 1 by omega] at hrec
          have hl := hchild u hu i (by have := Finset.mem_range.mp hi; omega)
          rw [hgen] at hl
          exact hrec.trans hl
        refine le_trans ?_ (Nat.add_le_add_right (Finset.sum_le_sum hterm) _)
        rw [Finset.sum_const, Finset.card_range, smul_eq_mul]
        have ha1 : 1 ≤ (Vᶜ ∩ Y).card := Finset.card_pos.mpr
          ⟨u, Finset.mem_inter.mpr ⟨Finset.mem_compl.mpr hu, huY⟩⟩
        rcases Nat.eq_zero_or_pos B with hB | hB
        · subst hB
          have hU1 : Vᶜ.card = 1 := by
            have : 1 ≤ Vᶜ.card := Finset.card_pos.mpr ⟨u, Finset.mem_compl.mpr hu⟩
            omega
          have ha : (Vᶜ ∩ Y).card = 1 := by
            have := Finset.card_le_card (Finset.inter_subset_left : Vᶜ ∩ Y ⊆ Vᶜ)
            omega
          rw [ha, show V.card = 1 by omega]
          simp
        · obtain ⟨a', ha'⟩ : ∃ a', (Vᶜ ∩ Y).card = a' + 1 := ⟨_, (Nat.sub_add_cancel ha1).symm⟩
          rw [ha', Nat.add_sub_cancel, ← Nat.mul_factorial_pred (show B ≠ 0 by omega)]
          apply le_of_eq
          ring

end

end VOA.DeligneAudit.SL4T
