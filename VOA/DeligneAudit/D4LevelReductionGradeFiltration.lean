import VOA.DeligneAudit.D4LevelReductionUniversal

/-! The Levi-level rank estimate restricted to one vector-node grade. -/

namespace VOA.DeligneAudit.D4LevelReduction

open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4
open VOA.DeligneAudit.D4Levi

/-- The finite set of levels represented by keys of one fixed grade. -/
def gradeLevelIndices (m : ℕ) (κ : ℤ) : Finset (ℤ × ℤ) :=
  (levelIndices m).filter (fun i => i.1 = κ)

variable {V W : Type} [AddCommGroup V] [Module ℂ V]
variable [AddCommGroup W] [Module ℂ W]
variable (ρ : CurrentModule D4sector.f V) (w : V)

/-- The level filtration exhausts each individual radical letter-count layer. -/
theorem alphaLayer_eq_levelSup (m : ℕ) (κ : ℤ) :
    alphaLayer ρ w m κ =
      ⨆ i ∈ gradeLevelIndices m κ, levelFiltration ρ w m i.1 i.2 := by
  apply le_antisymm
  · apply iSup_le
    intro k
    apply iSup_le
    intro hk
    apply iSup_le
    intro hκ
    exact le_iSup_of_le (κ, keyLeviLevel m k)
      (le_iSup_of_le (Finset.mem_filter.mpr
        ⟨Finset.mem_image.mpr ⟨k, hk, by simp [hκ]⟩, rfl⟩)
        (keyOrbit_le_levelFiltration ρ w m _ _ k hk hκ le_rfl))
  · apply iSup_le
    intro i
    apply iSup_le
    intro hi
    have hκ := (Finset.mem_filter.mp hi).2
    simpa only [hκ] using levelFiltration_le_alphaLayer ρ w m i.1 i.2

/-- Successive levels are generated by higher levels at the same grade. -/
theorem levelFiltration_next_le_same_grade (m : ℕ) (κ p : ℤ) :
    levelFiltration ρ w m κ (p + 1) ≤
      ⨆ i ∈ gradeLevelIndices m κ, ⨆ (_ : p < i.2),
        levelFiltration ρ w m i.1 i.2 := by
  apply iSup_le
  intro k
  apply iSup_le
  intro hk
  apply iSup_le
  intro hκ
  apply iSup_le
  intro hp
  exact le_iSup_of_le (κ, keyLeviLevel m k)
    (le_iSup_of_le (Finset.mem_filter.mpr
      ⟨Finset.mem_image.mpr ⟨k, hk, by simp [hκ]⟩, rfl⟩)
      (le_iSup_of_le (by omega : p < keyLeviLevel m k)
        (keyOrbit_le_levelFiltration ρ w m _ _ k hk hκ le_rfl)))

/-- A map killing the high Levi currents satisfies the level estimate at each grade. -/
theorem alphaLayer_image_rank_le [FiniteDimensional ℂ V] [FiniteDimensional ℂ W]
    (m : ℕ) (h : Sat D4sector.f ρ w (ravFam D4sector m 0))
    (f : V →ₗ[ℂ] W) (hf : leviCurrentTail ρ w m ≤ LinearMap.ker f) (κ : ℤ) :
    Module.finrank ℂ ((alphaLayer ρ w m κ).map f) ≤
      ∑ i ∈ gradeLevelIndices m κ,
        Module.finrank ℂ (TruncatedLevelPiece ρ w m i.1 i.2) := by
  classical
  let S := fun i : ℤ × ℤ => (levelFiltration ρ w m i.1 i.2).map f
  let H := fun i : ℤ × ℤ => (levelFiltration ρ w m i.1 (i.2 + 1)).map f
  have hnext : ∀ i ∈ gradeLevelIndices m κ,
      H i ≤ ⨆ j ∈ gradeLevelIndices m κ, ⨆ (_ : -j.2 < -i.2), S j := by
    intro i hi
    have hiκ := (Finset.mem_filter.mp hi).2
    have hh := Submodule.map_mono (f := f)
      (levelFiltration_next_le_same_grade ρ w m i.1 i.2)
    rw [hiκ] at hh
    simp only [Submodule.map_iSup] at hh
    change (levelFiltration ρ w m i.1 (i.2 + 1)).map f ≤ _
    rw [hiκ]
    apply hh.trans
    apply iSup_le
    intro j
    apply iSup_le
    intro hj
    apply iSup_le
    intro hp
    exact le_iSup_of_le j (le_iSup_of_le hj
      (le_iSup_of_le (by omega : -j.2 < -i.2) le_rfl))
  have hpiece : ∀ i ∈ gradeLevelIndices m κ,
      Module.finrank ℂ ((S i).map (H i).mkQ) ≤
        Module.finrank ℂ (TruncatedLevelPiece ρ w m i.1 i.2) := by
    intro i _
    let L := levelFiltration ρ w m i.1 i.2
    let U := levelFiltration ρ w m i.1 (i.2 + 1)
    let T := currentTail ρ L {c | IsLevi c} m
    let g := (H i).mkQ.comp f
    have hT : T ≤ leviCurrentTail ρ w m :=
      currentTail_mono_subspace ρ _ m (levelFiltration_le_cyclic ρ w m h _ _)
    have hker : U ⊔ T ≤ LinearMap.ker g := by
      apply sup_le
      · intro v hv
        exact (Submodule.Quotient.mk_eq_zero _).mpr ⟨v, hv, rfl⟩
      · intro v hv
        change (H i).mkQ (f v) = 0
        rw [show f v = 0 from hf (hT hv), map_zero]
    have hb := linearImage_finrank_le_quotient g L (U ⊔ T) hker
    change Module.finrank ℂ ((L.map f).map (H i).mkQ) ≤ _
    rw [← Submodule.map_comp]
    exact hb
  have hb := SL4T.finiteFiltration_finrank_le S H (fun i => -i.2)
    (fun i => Module.finrank ℂ (TruncatedLevelPiece ρ w m i.1 i.2))
    (gradeLevelIndices m κ) hnext hpiece
  have hspan : (⨆ i ∈ gradeLevelIndices m κ, S i) = (alphaLayer ρ w m κ).map f := by
    simp only [S, ← Submodule.map_iSup, ← alphaLayer_eq_levelSup]
  rwa [hspan] at hb

/-- The image of a Demazure grade in the universal truncated module. -/
noncomputable def truncatedGradeImage (m : ℕ) (hm : 1 ≤ m) (κ : ℤ) :
    Submodule ℂ (TruncatedModule m) :=
  (alphaLayer (demazureCurrent m) (demazureGenerator m) m κ).map
    (demazureToTruncated m hm)

/-- Each truncated grade image is bounded by its own universal level coinvariants. -/
theorem truncatedGradeImage_rank_le_levelSum (m : ℕ) (hm : 1 ≤ m) (κ : ℤ) :
    Module.finrank ℂ (truncatedGradeImage m hm κ) ≤
      ∑ i ∈ gradeLevelIndices m κ, Module.finrank ℂ (UniversalLevelPiece m i.1 i.2) := by
  haveI : FiniteDimensional ℂ (DemazureModule m) := (d4_demazureUnivRank m hm).1
  haveI := (truncatedModule_rank_le_leviCoinvariants m hm).1
  apply alphaLayer_image_rank_le
    (demazureCurrent m) (demazureGenerator m) m
    (univG_sat D4sector.f (ravFam D4sector m 0))
  exact (leviCurrentTail_le_full _ _ m).trans (fullCurrentTail_le_truncation_kernel m hm)

end VOA.DeligneAudit.D4LevelReduction

