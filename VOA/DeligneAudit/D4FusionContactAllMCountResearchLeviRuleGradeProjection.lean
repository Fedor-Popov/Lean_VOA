import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
import Mathlib.RingTheory.Ideal.Span
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! An ideal generated by homogeneous rows has its homogeneous component
spanned by exactly the monomial-row products of the matching degree.
The finite multiplier expansion is derived from ideal membership. -/
namespace VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
noncomputable section

variable {K σ ι M : Type*} [CommSemiring K] [AddCommMonoid M]

def matchingGradeProducts (w : σ → M) (f : ι → MvPolynomial σ K)
    (d : ι → M) (n : M) : Set (MvPolynomial σ K) :=
  {p | ∃ i e, Finsupp.weight w e+d i=n ∧ p=MvPolynomial.monomial e 1*f i}

/-- Project any ideal member to the linear span of matching monomial products. -/
theorem ideal_component_mem_matching_span (w : σ → M)
    (f : ι → MvPolynomial σ K) (d : ι → M)
    (hf : ∀ i, (f i).IsWeightedHomogeneous w (d i))
    {p : MvPolynomial σ K} (hp : p ∈ Ideal.span (Set.range f)) (n : M) :
    MvPolynomial.weightedHomogeneousComponent w n p ∈
      Submodule.span K (matchingGradeProducts w f d n) := by
  classical
  obtain ⟨c,hc⟩ := (Finsupp.mem_span_range_iff_exists_finsupp
    (R:=MvPolynomial σ K) (v:=f)).mp hp
  rw [← hc]
  change MvPolynomial.weightedHomogeneousComponent w n
    (∑ i ∈ c.support, c i*f i) ∈ _
  rw [map_sum]
  apply Submodule.sum_mem
  intro i _
  rw [MvPolynomial.as_sum (c i),Finset.sum_mul,map_sum]
  apply Submodule.sum_mem
  intro e _
  have hg := (MvPolynomial.isWeightedHomogeneous_monomial w e
    (MvPolynomial.coeff e (c i)) rfl).mul (hf i)
  by_cases he : Finsupp.weight w e+d i=n
  · rw [he] at hg
    rw [hg.weightedHomogeneousComponent_same]
    have hs := (Submodule.span K (matchingGradeProducts w f d n)).smul_mem
      (MvPolynomial.coeff e (c i))
      (Submodule.subset_span (show MvPolynomial.monomial e 1*f i ∈
        matchingGradeProducts w f d n from ⟨i,e,he,rfl⟩))
    rw [← smul_mul_assoc,MvPolynomial.smul_monomial,smul_eq_mul,mul_one] at hs
    exact hs
  · rw [hg.weightedHomogeneousComponent_ne n (Ne.symm he)]
    exact Submodule.zero_mem _

/-- No multiplier decomposition or homogeneous-ideal datum is assumed. -/
theorem homogeneous_ideal_mem_matching_span (w : σ → M)
    (f : ι → MvPolynomial σ K) (d : ι → M)
    (hf : ∀ i, (f i).IsWeightedHomogeneous w (d i))
    {p : MvPolynomial σ K} {n : M}
    (hp : p ∈ Ideal.span (Set.range f)) (hn : p.IsWeightedHomogeneous w n) :
    p ∈ Submodule.span K (matchingGradeProducts w f d n) := by
  rw [← hn.weightedHomogeneousComponent_same]
  exact ideal_component_mem_matching_span w f d hf hp n

end
#print axioms ideal_component_mem_matching_span
#print axioms homogeneous_ideal_mem_matching_span
end VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
