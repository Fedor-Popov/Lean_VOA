import VOA.DeligneAudit.LeviConversionBox
import VOA.DeligneAudit.LeviKeyFiltrationSurj
import VOA.DeligneAudit.DeligneFusionSl2Module

/-!
Lean layout for the all-rank type-A local Weyl bound.

The generic current-algebra interface is `UnivG.RelSpec`/`UModG`; the existing
concrete A₂ structure constants live in `A2SectorGeneric` and the sector
modules.  A₃ needs a structure-constant table, or a generic matrix-unit
realization, before the following abstract induction is instantiated.

At the node-1 Levi step, the commuting radical letters are Fᵢ(s), for roots
α₁+⋯+αᵢ.  Their orbit S is generated by these modes.  The elementary cutoff
below derives Fᵢ(s)w = 0 for s ≥ Mᵢ = m₁+⋯+mᵢ from the simple-root cutoff.
Consequently each fixed-length part Sⱼ has finitely many mode words.  Keys
are the letter counts (d₁,…,dₙ) and total mode degree, refined to a total
order at equal Levi height.

`LeviKeyFiltration.key_filtered_generated_bound` bounds the assembled Levi
layers once the key quotient has a finite box spanning set.  The latter
uses `LeviConversion.box_conversion` for Fᵢ₋₁ to Fᵢ and the sl₂ box theorem.
The relevant inputs are `Garland.garland`, `Sl2Weyl.J`, `box_span`, and
`span_box`/`box_mod` from the Sl2Weyl modules.  The final count sums only
dominant keys and is bounded by the unrestricted binomial product (R-3).
-/

namespace VOA.DeligneAudit.LeviTypeA

variable {A V : Type*} [Ring A] [AddCommGroup V] [Module A V]

/-- One node of the type-A root-string cutoff.  In matrix-unit conventions
the structure constant is one; a nonzero constant can be rescaled into F. -/
theorem next_root_mode_zero (f prev next : ℕ → A) (m s : ℕ) (w : V)
    (hbr : f m * prev (s - m) - prev (s - m) * f m = next s)
    (hf : f m • w = 0)
    (hp : prev (s - m) • w = 0) : next s • w = 0 := by
  have h := congrArg (fun x : A => x • w) hbr
  simp only [sub_smul, mul_smul, hf, hp, smul_zero, sub_zero] at h
  exact h.symm

/-- All nodes of an abstract type-A root string have the expected mode cutoff.
The bracket and simple-root relations are the only Lie-specific inputs. -/
theorem root_mode_zero_all (n : ℕ) (F : ℕ → ℕ → A) (f : ℕ → ℕ → A)
    (M m : ℕ → ℕ) (w : V)
    (hM : ∀ i, M (i + 1) = M i + m (i + 1))
    (hbase : ∀ s, M 0 ≤ s → F 0 s • w = 0)
    (hbr : ∀ i s, M (i + 1) ≤ s →
      f (i + 1) (m (i + 1)) * F i (s - m (i + 1)) -
        F i (s - m (i + 1)) * f (i + 1) (m (i + 1)) = F (i + 1) s)
    (hf : ∀ i, f (i + 1) (m (i + 1)) • w = 0)
    (i : ℕ) (hi : i ≤ n) (s : ℕ) (hs : M i ≤ s) : F i s • w = 0 := by
  induction i generalizing s with
  | zero => exact hbase s hs
  | succ i ih =>
    have hbound : M i ≤ s - m (i + 1) := by rw [hM i] at hs; omega
    exact next_root_mode_zero (f (i + 1)) (F i) (F (i + 1))
      (m (i + 1)) s w
      (hbr i s hs) (hf i) (ih (by omega) (s - m (i + 1)) hbound)

end VOA.DeligneAudit.LeviTypeA

#print axioms VOA.DeligneAudit.LeviTypeA.next_root_mode_zero
#print axioms VOA.DeligneAudit.LeviTypeA.root_mode_zero_all
