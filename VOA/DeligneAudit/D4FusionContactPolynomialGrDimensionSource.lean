import VOA.DeligneAudit.D4FusionContactPolynomialGrDimension

/-! From the finite actual PBW grading to the full current cyclic source.
HighestRel supplies the established contact PBW spanning reduction. Source
finite-dimensionality is a conclusion, never a premise. -/
namespace VOA.DeligneAudit.D4FusionContact.Polynomial

open VOA.DeligneAudit.SectorWeyl

noncomputable section
variable {V : Type*} [AddCommGroup V] [Module ℂ V]
variable (R : CurrentModule contactF V) (w : V)

/-- The actual cyclic span of all 28 current colors. -/
def sourceCyclic : Submodule ℂ V :=
  Submodule.span ℂ (Set.range fun l : List (Fin 28 × ℕ) => wordOp R l w)

private theorem exists_radical_letters (l : List (Fin 28 × ℕ))
    (hl : ∀ x ∈ l, active x.1) :
    ∃ a : List CurrentLetter, l = a.map (fun x => (radIndex x.1, x.2)) := by
  induction l with
  | nil => exact ⟨[], rfl⟩
  | cons x l ih =>
      obtain ⟨i, hi⟩ := (active_iff_index x.1).mp (hl x (by simp))
      obtain ⟨a, ha⟩ := ih (fun y hy => hl y (by simp [hy]))
      refine ⟨(i, x.2) :: a, ?_⟩
      rw [List.map_cons, hi, ← ha]

/-- Actual highest-weight relations make the full cyclic source equal
its nine-color radical cyclic span, by the proved current PBW reduction. -/
theorem sourceCyclic_eq_negativeCyclic {m : ℕ} (h : HighestRel R w m) :
    sourceCyclic R w = negativeCyclic R w := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨l, rfl⟩
    have hv : wordOp R l w ∈ cycDeg R w (SectorGraded.wordDeg l) :=
      Submodule.subset_span ⟨l, rfl, rfl⟩
    have hp := cycDeg_le_contact h (SectorGraded.wordDeg l) hv
    apply (Submodule.span_le.mpr ?_) hp
    rintro _ ⟨a, _, ha, _, rfl⟩
    obtain ⟨b, hb⟩ := exists_radical_letters a ha
    rw [hb]
    exact Submodule.subset_span ⟨b, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨l, rfl⟩
    exact Submodule.subset_span ⟨l.map (fun x => (radIndex x.1, x.2)), rfl⟩

variable [FiniteDimensional ℂ (Gr R w)]

/-- Finiteness and rank of the actual full cyclic source follow from the
finite restricted PBW graded module and genuine highest-weight relations. -/
theorem sourceCyclic_bound {m : ℕ} (h : HighestRel R w m) :
    FiniteDimensional ℂ (sourceCyclic R w) ∧
      Module.finrank ℂ (sourceCyclic R w) ≤ Module.finrank ℂ (Gr R w) := by
  rw [sourceCyclic_eq_negativeCyclic R w h]
  exact negativeCyclic_bound R w

/-- If the source is generated by its displayed vector, its entire space
is finite and bounded. No source finiteness or homogeneous independence
hypothesis is added. -/
theorem source_bound_of_span {m : ℕ} (h : HighestRel R w m)
    (hspan : Submodule.span ℂ
      (Set.range fun l : List (Fin 28 × ℕ) => wordOp R l w) = ⊤) :
    FiniteDimensional ℂ V ∧ Module.finrank ℂ V ≤ Module.finrank ℂ (Gr R w) := by
  obtain ⟨hfd, hdim⟩ := sourceCyclic_bound R w h
  change sourceCyclic R w = ⊤ at hspan
  rw [hspan] at hfd hdim
  haveI : FiniteDimensional ℂ (⊤ : Submodule ℂ V) := hfd
  haveI : FiniteDimensional ℂ V := Module.Finite.of_surjective
    (⊤ : Submodule ℂ V).subtype (fun v => ⟨⟨v, Submodule.mem_top⟩, rfl⟩)
  exact ⟨inferInstance, by simpa using hdim⟩

/-- Individual current-degree pieces are finite without an ambient-source
finiteness premise; total degree sums require the separate universal bridge. -/
theorem source_cycDeg_finite {m : ℕ} (h : HighestRel R w m) (d : ℕ) :
    FiniteDimensional ℂ (cycDeg R w d) := by
  haveI := (sourceCyclic_bound R w h).1
  apply Submodule.finiteDimensional_of_le (show cycDeg R w d ≤ sourceCyclic R w from ?_)
  apply Submodule.span_le.mpr
  rintro _ ⟨l, _, rfl⟩
  exact Submodule.subset_span ⟨l, rfl⟩

end
end VOA.DeligneAudit.D4FusionContact.Polynomial

#print axioms VOA.DeligneAudit.D4FusionContact.Polynomial.sourceCyclic_bound
#print axioms VOA.DeligneAudit.D4FusionContact.Polynomial.source_bound_of_span
