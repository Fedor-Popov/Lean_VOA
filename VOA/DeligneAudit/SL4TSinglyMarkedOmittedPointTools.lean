import VOA.DeligneAudit.SL4TSinglyMarkedOmittedPointStratum

/-!
# Tools for the omitted-point stratum: two-generator layer steps and the zero-point layer

* `pairStratum_layers_le`: if `z · J ⊆ I` for ideals `I, J` of a finite-dimensional algebra and
  `z^N = 0`, the images of `J` in the positive layers of `z` add up to at most `dim I`.
* `childPair_finrank_le_layer`: through an injective layer map, the child ideal generated by two
  polynomials has at most the dimension of the image, in the layer, of the parent ideal generated
  by their evaluations at the remaining roots.
* `groupSubtopCoefficient_deleted_of_notMem`, `groupSubtopCoefficient_deleted_of_mem`: the
  subleading coefficient after deleting a root outside, respectively inside, the group.
* `groupSubtopCoefficient_mem_span`: if `Z ⊆ V` is nonempty, the subleading coefficient of `V`
  lies in the ideal `(∏ Z, ∏ (V ∖ Z) · c(Z))`.
* `singlyMarkedFlagIdeal_univ_eq`: with every root marked and no doubles, the singly marked ideal
  is the unmarked ideal without doubles.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

/-- **Two-generator layer step.** -/
theorem pairStratum_layers_le {C : Type*} [CommRing C] [Algebra ℂ C] [FiniteDimensional ℂ C]
    (z : C) (N : ℕ) (hz : z ^ N = 0) (I J : Ideal C) (hJ : ∀ c ∈ J, z * c ∈ I) :
    ∑ i ∈ Finset.range (N - 1), Module.finrank ℂ ((J.restrictScalars ℂ).map
        (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal z (i + 1))).toLinearMap) ≤
      Module.finrank ℂ (I.restrictScalars ℂ) := by
  let W : ℕ → Submodule ℂ C := fun j => ((Ideal.span {z}) ^ (1 - j) * J).restrictScalars ℂ
  have hW : ∀ j < N, ∀ c ∈ W j, z ^ j * c ∈
      I.restrictScalars ℂ ⊔ (Ideal.span {z ^ (j + 1)}).restrictScalars ℂ := by
    intro j _ c hc
    apply Submodule.mem_sup_left
    rw [Submodule.restrictScalars_mem] at hc ⊢
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · rw [pow_zero, one_mul]
      rw [Nat.sub_zero, pow_one] at hc
      refine (Ideal.mul_le.mpr ?_) hc
      intro a ha b hb
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [mul_comm t z, mul_assoc, mul_comm t b, ← mul_assoc]
      exact Ideal.mul_mem_right _ _ (hJ b hb)
    · rw [show 1 - j = 0 by omega, pow_zero, Ideal.one_eq_top, Ideal.top_mul] at hc
      obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      rw [pow_succ, mul_assoc]
      exact Ideal.mul_mem_left _ _ (hJ c hc)
  rcases Nat.eq_zero_or_pos N with hN | hN
  · subst hN
    simp
  have hsum := layer_finrank_sum_le z N hz _ W hW
  obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
  rw [Finset.sum_range_succ'] at hsum
  have hconv : ∀ x ∈ Finset.range N', Module.finrank ℂ ((W (x + 1)).map
      (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal z (x + 1))).toLinearMap) =
      Module.finrank ℂ ((J.restrictScalars ℂ).map
        (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal z (x + 1))).toLinearMap) := by
    intro x _
    have hWx : W (x + 1) = J.restrictScalars ℂ := by
      simp only [W]
      rw [show 1 - (x + 1) = 0 by omega, pow_zero, Ideal.one_eq_top, Ideal.top_mul]
    rw [hWx]
  rw [Finset.sum_congr rfl hconv] at hsum
  rw [Nat.add_sub_cancel]
  exact (Nat.le_add_right _ _).trans hsum

/-- Evaluating at the layer roots is evaluating at the remaining roots and projecting. -/
theorem aeval_deletedLayerRoot {C : Type*} [CommRing C] [Algebra ℂ C] {n : ℕ}
    (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ) (p : MvPolynomial (Fin n) ℂ) :
    aeval (deletedLayerRoot r u i) p =
      Ideal.Quotient.mk _ (aeval (fun j => r (u.succAbove j)) p) := by
  have h := AlgHom.congr_fun (MvPolynomial.comp_aeval (R := ℂ) (fun j => r (u.succAbove j))
    (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) i))) p
  rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h
  rw [h]
  rfl

/-- **Transport of a two-generator child ideal through an injective layer map.** -/
theorem childPair_finrank_le_layer {C : Type*} [CommRing C] [Algebra ℂ C]
    [FiniteDimensional ℂ C] {n : ℕ} (r : Fin (n + 1) → C) (u : Fin (n + 1)) (i : ℕ)
    (I' : Ideal (MvPolynomial (Fin n) ℂ))
    (hI' : I' ≤ RingHom.ker (aeval (deletedLayerRoot r u i)).toRingHom)
    (hinj : Function.Injective (deletedLayerMap r u i I' hI'))
    (p₁ p₂ : MvPolynomial (Fin n) ℂ) :
    Module.finrank ℂ ((Ideal.span {Ideal.Quotient.mk I' p₁, Ideal.Quotient.mk I' p₂}
        ).restrictScalars ℂ) ≤
      Module.finrank ℂ (((Ideal.span {aeval (fun j => r (u.succAbove j)) p₁,
        aeval (fun j => r (u.succAbove j)) p₂}).restrictScalars ℂ).map
          (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r u) i)).toLinearMap) := by
  let ψ := deletedLayerMap r u i I' hI'
  haveI : FiniteDimensional ℂ (C ⧸ rootPowerLayerIdeal (r u) i) :=
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ ℂ _).toLinearMap
      (Ideal.Quotient.mkₐ_surjective ℂ _)
  rw [LinearEquiv.finrank_eq (Submodule.equivMapOfInjective ψ.toLinearMap hinj
    ((Ideal.span {Ideal.Quotient.mk I' p₁, Ideal.Quotient.mk I' p₂}).restrictScalars ℂ))]
  apply Submodule.finrank_mono
  rintro _ ⟨x, hx, rfl⟩
  rw [SetLike.mem_coe, Submodule.restrictScalars_mem, Ideal.mem_span_pair] at hx
  obtain ⟨a, b, rfl⟩ := hx
  obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (ψ a)
  obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (ψ b)
  refine ⟨c * aeval (fun j => r (u.succAbove j)) p₁ + d * aeval (fun j => r (u.succAbove j)) p₂,
    ?_, ?_⟩
  · rw [SetLike.mem_coe, Submodule.restrictScalars_mem, Ideal.mem_span_pair]
    exact ⟨c, d, rfl⟩
  · have hψ : ∀ p, ψ (Ideal.Quotient.mk I' p) =
        Ideal.Quotient.mk _ (aeval (fun j => r (u.succAbove j)) p) := fun p =>
      aeval_deletedLayerRoot r u i p
    change Ideal.Quotient.mk _ (c * aeval (fun j => r (u.succAbove j)) p₁ +
        d * aeval (fun j => r (u.succAbove j)) p₂) =
      ψ (a * Ideal.Quotient.mk I' p₁ + b * Ideal.Quotient.mk I' p₂)
    rw [map_add ψ, map_mul ψ, map_mul ψ, hψ, hψ, ← hc, ← hd, map_add, map_mul, map_mul]

/-! ### The subleading coefficient after a deletion -/

section Deleted

variable {A : Type*} [CommRing A] {n : ℕ} (x : Fin (n + 1) → A) (Z : Finset (Fin (n + 1)))
  (u : Fin (n + 1))

theorem groupElementaryPolynomial_deleted_of_notMem (hu : u ∉ Z) :
    groupElementaryPolynomial (fun j => x (u.succAbove j)) (deletedGroup u Z) =
      groupElementaryPolynomial x Z :=
  prod_deletedGroup_of_notMem (fun i => 1 - Polynomial.C (x i) * Polynomial.X) Z u hu

theorem groupSubtopCoefficient_deleted_of_notMem (hu : u ∉ Z) :
    groupSubtopCoefficient (fun j => x (u.succAbove j)) (deletedGroup u Z) =
      groupSubtopCoefficient x Z := by
  rw [groupSubtopCoefficient, groupSubtopCoefficient, deletedGroup_card_of_notMem Z u hu,
    groupElementaryPolynomial_deleted_of_notMem x Z u hu]

theorem groupSubtopCoefficient_deleted_of_mem (hu : u ∈ Z)
    (hne : (deletedGroup u Z).Nonempty) :
    groupSubtopCoefficient x Z =
      (groupElementaryPolynomial (fun j => x (u.succAbove j)) (deletedGroup u Z)).coeff
          (deletedGroup u Z).card -
        x u * groupSubtopCoefficient (fun j => x (u.succAbove j)) (deletedGroup u Z) := by
  have hE : groupElementaryPolynomial x Z = (1 - Polynomial.C (x u) * Polynomial.X) *
      groupElementaryPolynomial (fun j => x (u.succAbove j)) (deletedGroup u Z) := by
    rw [groupElementaryPolynomial, prod_eq_deletedGroup _ Z u, if_pos hu]
    rfl
  have hc := deletedGroup_card_of_mem Z u hu
  have hpos : 1 ≤ (deletedGroup u Z).card := Finset.card_pos.mpr hne
  obtain ⟨m, hm⟩ : ∃ m, (deletedGroup u Z).card = m + 1 := ⟨_, (Nat.sub_add_cancel hpos).symm⟩
  rw [groupSubtopCoefficient, groupSubtopCoefficient, hE, ← hc, Nat.add_sub_cancel, hm,
    sub_mul, one_mul, Polynomial.coeff_sub, mul_assoc, Polynomial.coeff_C_mul,
    Polynomial.coeff_X_mul, Nat.add_sub_cancel]

end Deleted

/-! ### The subleading coefficient of a group with a vanishing part -/

/-- If `Z ⊆ V`, the subleading coefficient of `V` lies in `(∏ Z, ∏ (V ∖ Z) · c(Z))`. -/
theorem groupSubtopCoefficient_mem_span {A : Type*} [CommRing A] {ι : Type*} [DecidableEq ι]
    (x : ι → A) (V Z : Finset ι) (hZV : Z ⊆ V) (hZ : Z.Nonempty) :
    groupSubtopCoefficient x V ∈ Ideal.span {∏ i ∈ Z, x i,
      (∏ i ∈ V \ Z, x i) * groupSubtopCoefficient x Z} := by
  by_cases hA : (V \ Z).Nonempty
  · have hsplit : groupElementaryPolynomial x V =
        groupElementaryPolynomial x (V \ Z) * groupElementaryPolynomial x Z := by
      rw [groupElementaryPolynomial, groupElementaryPolynomial, groupElementaryPolynomial,
        ← Finset.prod_union Finset.sdiff_disjoint, Finset.sdiff_union_of_subset hZV]
    have hcard : V.card = (V \ Z).card + Z.card := by
      rw [Finset.card_sdiff_of_subset hZV]
      have := Finset.card_le_card hZV
      omega
    have ha := Finset.card_pos.mpr hA
    have hb := Finset.card_pos.mpr hZ
    simp only [groupSubtopCoefficient]
    rw [hsplit, hcard,
      coeff_mul_top_sub_one _ _ _ _ ha hb (groupElementaryPolynomial_natDegree_le x _)
        (groupElementaryPolynomial_natDegree_le x _),
      groupElementaryPolynomial_coeff_card, groupElementaryPolynomial_coeff_card]
    rw [Ideal.mem_span_pair]
    refine ⟨(groupElementaryPolynomial x (V \ Z)).coeff ((V \ Z).card - 1) * (-1) ^ Z.card,
      (-1) ^ (V \ Z).card, ?_⟩
    ring
  · have hVZ : V = Z := by
      apply le_antisymm _ hZV
      intro i hi
      by_contra hiZ
      exact hA ⟨i, Finset.mem_sdiff.mpr ⟨hi, hiZ⟩⟩
    subst hVZ
    rw [Finset.sdiff_self, Finset.prod_empty, one_mul]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-! ### All roots marked, no doubles -/

/-- The elementary function of top degree is the product of all roots. -/
theorem esymm_card_eq_prod (n : ℕ) :
    esymm (Fin n) ℂ n = ∏ i, (X i : MvPolynomial (Fin n) ℂ) := by
  have h := Finset.powersetCard_self (Finset.univ : Finset (Fin n))
  rw [Finset.card_univ, Fintype.card_fin] at h
  rw [esymm, h, Finset.sum_singleton]

/-- With every root marked and no doubles, the singly marked ideal is the unmarked ideal
without doubles. -/
theorem singlyMarkedFlagIdeal_univ_eq (n : ℕ) (hn : 1 ≤ n) :
    singlyMarkedFlagIdeal n Finset.univ (n - 1) = unmarkedFlagIdeal n n := by
  have hcut : singlyMarkedCutoff (Finset.univ : Finset (Fin n)) (n - 1) = fun _ => n := by
    funext i
    simp [singlyMarkedCutoff]
    omega
  unfold singlyMarkedFlagIdeal unmarkedFlagIdeal
  rw [hcut]
  apply le_antisymm
  · refine sup_le (sup_le (sup_le (le_sup_left.trans (le_sup_left.trans le_sup_left)) ?_)
      (le_sup_right.trans le_sup_left)) le_sup_right
    apply Ideal.span_le.mpr
    rintro p ⟨S, hS, rfl⟩
    rw [Set.mem_singleton_iff] at hS
    subst hS
    apply (le_sup_left.trans (le_sup_left.trans le_sup_left) :
      fullFlagSymmetricIdeal n ≤ markedFlagIdeal n ∅ (fun _ => n) ∅ 0)
    rw [flagGroupProduct, ← esymm_card_eq_prod]
    exact Ideal.subset_span ⟨n, hn, rfl⟩
  · refine sup_le (sup_le (sup_le (le_sup_left.trans (le_sup_left.trans le_sup_left)) ?_)
      (le_sup_right.trans le_sup_left)) le_sup_right
    rw [Set.image_empty, Ideal.span_empty]
    exact bot_le

end

end VOA.DeligneAudit.SL4T
