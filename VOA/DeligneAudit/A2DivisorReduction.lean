import VOA.DeligneAudit.A2DivisorAvoid

/-!
# `DivisorComparison` from a pairwise local comparison

`PairComparison`: for every `x ∈ W_m` and every pair `a ≠ b`, some power of
`E_{ab} = ∏_{{i,j} ≠ {a,b}} (z_i - z_j)` moves `x` into `P_m M_m`.  This is the content of the paper's
B8 at `(Δ)`: away from all collisions other than `z_a = z_b`, the comparison reduces to the
two-point computation B7.

**`divisorComparison_of_pair`**: `PairComparison → DivisorComparison`.  Since
`w = Σ_{a ≠ b} E_{ab}`, a power of `w` lies in the ideal generated by the `E_{ab}^N`
(`Ideal.sum_pow_mem_span_pow`), so `w^K x ∈ P_m M_m`; `w^K x` is symmetric, hence in `M_m` by the
Reynolds operator (`mem_Mspace_of_symmetric`); and `w^K` lies in no height-one prime containing
`Δ` (`wS_not_mem`).
-/

namespace VOA.DeligneAudit.A2

open MvPolynomial VOA.AffineSl3 VOA.DeligneAudit.SectorLoop VOA.DeligneAudit.SectorFiber
open VOA.DeligneAudit.SectorFiberModule VOA.QuadraticCurrentFunctionalCarrier
open VOA.HeightOneGlobalization

noncomputable section

/-- **Pairwise local comparison** (B7 with the slot interpolation of the other roots). -/
structure PairComparison : Prop where
  le : ∀ m, ∀ x ∈ currentCarrier fullMatrix m 0, ∀ a b : Fin (m + 0), a ≠ b →
    ∃ N : ℕ, (pairE a b) ^ N • x ∈ MP m

theorem symmetric_psmul {m : ℕ} {f : Pm m} (hf : f.IsSymmetric) {x : TP m} (hx : Symmetric x) :
    Symmetric (f • x) := by
  intro e g he t
  rw [psmul_apply, psmul_apply, map_mul, hx e g he t]
  congr 1
  exact hf e

/-- **`DivisorComparison` from the pairwise local comparison.** -/
theorem divisorComparison_of_pair (h : PairComparison) : DivisorComparison := by
  classical
  refine ⟨fun m x hx p hp => ?_⟩
  -- per-pair exponents
  let f : Fin (m + 0) × Fin (m + 0) → Pm m := fun ab =>
    if ab.1 = ab.2 then 0 else pairE ab.1 ab.2
  have hN : ∀ ab, ∃ N : ℕ, f ab ^ (N + 1) • x ∈ MP m := by
    intro ab
    by_cases hab : ab.1 = ab.2
    · refine ⟨0, ?_⟩
      simp only [f, if_pos hab, zero_pow (Nat.succ_ne_zero 0), zero_smul]
      exact Submodule.zero_mem _
    · obtain ⟨N, hN⟩ := h.le m x hx ab.1 ab.2 hab
      refine ⟨N, ?_⟩
      simp only [f, if_neg hab]
      rw [pow_succ, mul_comm, mul_smul]
      exact Submodule.smul_mem _ _ hN
  choose Nf hNf using hN
  set n := Finset.univ.sup Nf
  have hterm : ∀ ab, f ab ^ (n + 1) • x ∈ MP m := by
    intro ab
    have hle : Nf ab ≤ n := Finset.le_sup (Finset.mem_univ ab)
    rw [show n + 1 = (n - Nf ab) + (Nf ab + 1) by omega, pow_add, mul_smul]
    exact Submodule.smul_mem _ _ (hNf ab)
  set K := (Finset.univ : Finset (Fin (m + 0) × Fin (m + 0))).card * n + 1
  have hspan := Ideal.sum_pow_mem_span_pow (Finset.univ : Finset (Fin (m + 0) × Fin (m + 0))) f n
  have hsum : (∑ ab, f ab) = wSum m := by
    rw [wSum, ← Finset.sum_product']
    rfl
  have hwK : (wSum m) ^ K • x ∈ MP m := by
    rw [← hsum]
    refine Submodule.span_induction (p := fun g _ => g • x ∈ MP m) ?_ ?_ ?_ ?_ hspan
    · rintro _ ⟨ab, _, rfl⟩
      exact hterm ab
    · show (0 : Pm m) • x ∈ MP m
      rw [zero_smul]; exact Submodule.zero_mem _
    · intro g g' _ _ hg hg'
      show (g + g') • x ∈ MP m
      rw [add_smul]; exact Submodule.add_mem _ hg hg'
    · intro r g _ hg
      show (r • g) • x ∈ MP m
      rw [smul_eq_mul, mul_smul]
      exact Submodule.smul_mem _ _ hg
  have hsym : Symmetric ((wSum m) ^ K • x) :=
    symmetric_psmul (fun e => by rw [map_pow, wSum_isSymmetric m e]) hx.1
  have hM := mem_Mspace_of_symmetric hwK hsym
  refine ⟨(wS m) ^ K, fun hmem => wS_not_mem p hp (p.isPrime.mem_of_pow_mem K hmem), ?_⟩
  convert hM using 1

end

end VOA.DeligneAudit.A2

section AxiomAudit
#print axioms VOA.DeligneAudit.A2.divisorComparison_of_pair
end AxiomAudit
