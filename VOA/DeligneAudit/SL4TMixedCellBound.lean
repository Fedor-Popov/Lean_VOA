import VOA.DeligneAudit.SL4TMixedPowerSum

/-! # The mixed-site ring-image dimension bound -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open Polynomial VOA.DeligneAudit.CVsl2

/-- The dimension contribution of a cell with its double and triple counts. -/
def mixedCellContribution (c : MixedCellCounts) : ℕ := 3 ^ c.2 * 2 ^ c.1

/-- The balanced rank-one bound equals the double and triple cell contribution. -/
theorem mixedCell_balanced_product (q : MixedParams) (hq : MixedValid q)
    (c : MixedCellCounts) (hc : c ∈ mixedCellData (q.A + q.B).toNat q) :
    ((bal (mixedWeight q).toNat (mixedCellLevel c)).map (· + 1)).prod =
      mixedCellContribution c := by
  have hw := mixedCellData_weight (q.A + q.B).toNat q hq rfl c hc
  have hn : (mixedWeight q).toNat = c.1 + 2 * c.2 := by omega
  rw [hn]
  unfold mixedCellLevel mixedCellContribution
  by_cases hz : c.1 + c.2 = 0
  · have hD : c.1 = 0 := by omega
    have hT : c.2 = 0 := by omega
    simp [hD, hT, bal]
  · rw [bal_prod_two (by omega) (by omega) (by omega),
      show c.1 + 2 * c.2 - (c.1 + c.2) = c.2 by omega,
      show 2 * (c.1 + c.2) - (c.1 + 2 * c.2) = c.1 by omega]

/-- The total bound for a mixed parameter block. -/
def mixedBlockBound (q : MixedParams) : ℕ :=
  ((mixedCellData (q.A + q.B).toNat q).map mixedCellContribution).sum

theorem mixedCell_balanced_sum (q : MixedParams) (hq : MixedValid q) :
    (∑ i ∈ Finset.range (mixedCellLevels (q.A + q.B).toNat q).length,
      ((bal (mixedWeight q).toNat
        ((mixedCellLevels (q.A + q.B).toNat q).getD i 0)).map (· + 1)).prod) =
      mixedBlockBound q := by
  rw [list_sum_getD (mixedCellLevels (q.A + q.B).toNat q)
    (fun n => ((bal (mixedWeight q).toNat n).map (· + 1)).prod)]
  unfold mixedCellLevels mixedBlockBound
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  intro c hc
  exact mixedCell_balanced_product q hq c hc

variable {V : Type*} [AddCommGroup V] [Module ℂ V]
variable {E H F : ℕ → Module.End ℂ V}

/-- The mixed cell bound for the current-algebra module generated by a ring image. -/
theorem mixedRingImage_bound (q : MixedParams) (hq : MixedValid q) (hS : SL2 E H F)
    (π : MixedRing q →ₗ[ℂ] V)
    (hE : ∀ s φ, E s (π φ) = 0)
    (hH0 : ∀ φ, H 0 (π φ) = ((mixedWeight q).toNat : ℂ) • π φ)
    (hH : ∀ s, 1 ≤ s → ∀ φ, H s (π φ) = π (mixedPowerSum q s * φ))
    (hF0 : ∀ φ, (F 0 ^ ((mixedWeight q).toNat + 1)) (π φ) = 0)
    (hM : ∀ s, (q.A + q.B).toNat ≤ s → ∀ φ, F s (π φ) = 0) :
    FiniteDimensional ℂ (currentSpan E H F (Set.range π)) ∧
      Module.finrank ℂ (currentSpan E H F (Set.range π)) ≤ mixedBlockBound q := by
  have hP := piCharacteristic_of_highest hS π (mixedPowerSum q) hE hH
    (mixedWeight q).toNat hF0 (mixedPowerSum_newton_tail q hq)
  rw [mixedPowerSum_descending q hq] at hP
  obtain ⟨fd, hd⟩ := SpanningChain.pi_bound_of_characteristic hS π (mixedPowerSum q)
    (mixedCharacteristic q) (mixedWeight q).toNat (q.A + q.B).toNat
    (mixedCellFlag_recursive (q.A + q.B).toNat q hq rfl) (mixedPowerSum_nilpotent q hq)
    hE hH0 hH hF0 hM hP
  exact ⟨fd, hd.trans_eq (mixedCell_balanced_sum q hq)⟩

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.mixedCell_balanced_product
#print axioms VOA.DeligneAudit.SL4T.mixedCell_balanced_sum
#print axioms VOA.DeligneAudit.SL4T.mixedRingImage_bound
