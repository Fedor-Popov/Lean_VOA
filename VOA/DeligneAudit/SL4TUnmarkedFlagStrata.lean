import VOA.DeligneAudit.SL4TMarkedFlagLayerIsomorphisms

/-!
# Unmarked full flags: exact layers and the product strata with at most one double

The unmarked full flag on `n` roots with common cutoff `N` is presented as a marked full flag
without marked groups (`unmarkedFlagIdeal`); it is the truncated coinvariant ring
(`unmarkedFlagIdeal_eq`) and has dimension `n!/2^(n-N)` (`unmarkedFlag_finrank_eq`). Deleting any
root `y`, the layers of `y` below `n - N` are the unmarked flag with one root fewer and the same
cutoff, and the later ones the unmarked flag with cutoff lowered by one; all these layer maps are
isomorphisms (`unmarkedLayerMap_injective_same`, `unmarkedLayerMap_injective_lower`).

Product strata. For a set `Z` of roots:

* without doubles (`N = n`), the ideal generated by `∏ Z` has dimension at least
  `(n - |Z|) (n - 1)!`, the number of arrangements of the roots on `n` distinct points with a root
  outside `Z` at the first point (`unmarkedFlag_noDouble_product_finrank_ge`);
* with one double (`N = n - 1`), it has dimension at least `C(n - |Z|, 2) (n - 2)!`, the number of
  arrangements whose double point carries two roots outside `Z`
  (`unmarkedFlag_oneDouble_product_finrank_ge`).
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

/-- The unmarked full flag on `n` roots with common cutoff `N`. -/
def unmarkedFlagIdeal (n N : ℕ) : Ideal (MvPolynomial (Fin n) ℂ) :=
  markedFlagIdeal n ∅ (fun _ => N) ∅ 0

/-- The unmarked full-flag ring. -/
abbrev UnmarkedFlagRing (n N : ℕ) := MvPolynomial (Fin n) ℂ ⧸ unmarkedFlagIdeal n N

instance unmarkedFlag_finite (n N : ℕ) : FiniteDimensional ℂ (UnmarkedFlagRing n N) :=
  markedFlag_finite _ _ _ _ _

theorem unmarkedFlagIdeal_eq (n N : ℕ) : unmarkedFlagIdeal n N = fullFlagTruncationIdeal n N := by
  apply le_antisymm
  · refine sup_le (sup_le (sup_le le_sup_left ?_) le_sup_right) ?_
    · rw [Set.image_empty, Ideal.span_empty]
      exact bot_le
    · apply Ideal.span_le.mpr
      rintro p ⟨s, _, rfl⟩
      simp only [flagGroupPowerSum, Finset.sum_empty, SetLike.mem_coe]
      exact Ideal.zero_mem _
  · exact sup_le (le_sup_left.trans (le_sup_left.trans le_sup_left))
      (le_sup_right.trans le_sup_left)

/-- The unmarked full flag has dimension `n!/2^k` with `k = n - N`. -/
theorem unmarkedFlag_finrank_eq (n k : ℕ) (hk : 2 * k ≤ n) :
    Module.finrank ℂ (UnmarkedFlagRing n (n - k)) = Nat.card (FullFlagConfiguration n k) := by
  rw [(Ideal.quotientEquivAlgOfEq ℂ (unmarkedFlagIdeal_eq n (n - k))).toLinearEquiv.finrank_eq]
  exact fullFlag_finrank_eq_configurations n k hk

theorem unmarkedFlag_elementary (n N : ℕ) :
    D4Levi.ksEPoly (List.ofFn (quotientRoot (unmarkedFlagIdeal n N))) = 1 :=
  markedFlag_elementary _ _ _ _ _

theorem unmarkedFlag_cutoff (n N : ℕ) (i : Fin n) :
    quotientRoot (unmarkedFlagIdeal n N) i ^ N = 0 :=
  markedFlag_cutoff _ _ _ _ _ i

/-! ### Layers -/

section Layers

variable (n N : ℕ) (u : Fin (n + 1))

theorem unmarkedLayer_same_le_ker (i : ℕ) :
    unmarkedFlagIdeal n N ≤ RingHom.ker (aeval (deletedLayerRoot
      (quotientRoot (unmarkedFlagIdeal (n + 1) N)) u i)).toRingHom := by
  apply deletedLayer_markedFlagIdeal_le_ker _ u i
  · exact unmarkedFlag_elementary _ _
  · intro S hS
    exact absurd hS (Set.notMem_empty S)
  · intro j
    exact mul_mem_of_eq_zero _ _ (unmarkedFlag_cutoff _ _ _)
  · intro s _
    simp

theorem unmarkedLayer_lower_le_ker (k : ℕ) (hN : 0 < N) (hn : n + 1 ≤ N + k) (i : ℕ)
    (hi : k ≤ i) :
    unmarkedFlagIdeal n (N - 1) ≤ RingHom.ker (aeval (deletedLayerRoot
      (quotientRoot (unmarkedFlagIdeal (n + 1) N)) u i)).toRingHom := by
  set r := quotientRoot (unmarkedFlagIdeal (n + 1) N)
  have hE : groupElementaryPolynomial r Finset.univ = 1 := by
    rw [← ksEPoly_ofFn_eq_group]
    exact unmarkedFlag_elementary _ _
  apply deletedLayer_markedFlagIdeal_le_ker r u i
  · exact unmarkedFlag_elementary _ _
  · intro S hS
    exact absurd hS (Set.notMem_empty S)
  · intro j
    apply mem_span_pow_succ_of_le _ _ k i hi
    exact pair_boundary_mem_of_card r hE (u.succAbove j) u (Fin.succAbove_ne u j) N k hN hn
      (unmarkedFlag_cutoff _ _ _)
  · intro s _
    simp

end Layers

/-- The layer bound of a root of the unmarked flag on `n + 1` roots with `k` doubles. -/
def unmarkedLayerBound (n k i : ℕ) : ℕ :=
  if i < k then Nat.card (FullFlagConfiguration n (k - 1))
  else Nat.card (FullFlagConfiguration n k)

section Exact

variable (n k : ℕ) (hk : 2 * k ≤ n + 1) (u : Fin (n + 1))
include hk

theorem unmarkedLayer_child_same_eq (hk1 : 1 ≤ k) :
    Module.finrank ℂ (UnmarkedFlagRing n (n + 1 - k)) = unmarkedLayerBound n k 0 := by
  rw [show n + 1 - k = n - (k - 1) by omega, unmarkedFlag_finrank_eq n (k - 1) (by omega)]
  simp [unmarkedLayerBound, show 0 < k by omega]

theorem unmarkedLayer_child_lower_eq (i : ℕ) (hik : k ≤ i) (hi : i < n + 1 - k) :
    Module.finrank ℂ (UnmarkedFlagRing n (n + 1 - k - 1)) = unmarkedLayerBound n k i := by
  rw [show n + 1 - k - 1 = n - k by omega, unmarkedFlag_finrank_eq n k (by omega)]
  simp [unmarkedLayerBound, show ¬ i < k by omega]

theorem unmarkedLayer_finrank_le_bound (i : ℕ) (hi : i < n + 1 - k) :
    Module.finrank ℂ (UnmarkedFlagRing (n + 1) (n + 1 - k) ⧸ rootPowerLayerIdeal
        (quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1 - k)) u) i) ≤
      unmarkedLayerBound n k i := by
  by_cases hik : i < k
  · have h := deletedLayer_finrank_le _ (quotientRoot_aeval_surjective _) u i _
      (unmarkedLayer_same_le_ker n (n + 1 - k) u i)
    rw [unmarkedLayer_child_same_eq n k hk (by omega)] at h
    simpa [unmarkedLayerBound, hik, show 0 < k by omega] using h
  · have h := deletedLayer_finrank_le _ (quotientRoot_aeval_surjective _) u i _
      (unmarkedLayer_lower_le_ker n (n + 1 - k) u k (by omega) (by omega) i (by omega))
    rwa [unmarkedLayer_child_lower_eq n k hk i (by omega) hi] at h

theorem unmarkedLayer_finrank_eq_bound (i : ℕ) (hi : i < n + 1 - k) :
    Module.finrank ℂ (UnmarkedFlagRing (n + 1) (n + 1 - k) ⧸ rootPowerLayerIdeal
        (quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1 - k)) u) i) =
      unmarkedLayerBound n k i := by
  set r := quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1 - k))
  have htot := rootPowerFiltration_finrank (r u) (n + 1 - k) (unmarkedFlag_cutoff _ _ u)
  rw [unmarkedFlag_finrank_eq (n + 1) k hk] at htot
  have hsum : ∑ j ∈ Finset.range (n + 1 - k), unmarkedLayerBound n k j =
      Nat.card (FullFlagConfiguration (n + 1) k) := by
    simp only [unmarkedLayerBound]
    rw [sum_range_ite_lt _ k _ _ (by omega), fullFlagConfiguration_card_recursion n k hk]
  rw [← hsum] at htot
  have hle : ∀ j ∈ Finset.range (n + 1 - k),
      Module.finrank ℂ (UnmarkedFlagRing (n + 1) (n + 1 - k) ⧸ rootPowerLayerIdeal (r u) j) ≤
        unmarkedLayerBound n k j :=
    fun j hj => unmarkedLayer_finrank_le_bound n k hk u j (Finset.mem_range.mp hj)
  exact ((Finset.sum_eq_sum_iff_of_le hle).mp htot.symm) i (Finset.mem_range.mpr hi)

theorem unmarkedLayerMap_injective_same (i : ℕ) (hik : i < k) (hi : i < n + 1 - k) :
    Function.Injective (deletedLayerMap
      (quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1 - k))) u i _
      (unmarkedLayer_same_le_ker n (n + 1 - k) u i)) := by
  apply deletedLayerMap_injective_of_finrank_le _ (quotientRoot_aeval_surjective _)
  rw [unmarkedLayer_finrank_eq_bound n k hk u i hi, unmarkedLayer_child_same_eq n k hk (by omega)]
  simp [unmarkedLayerBound, hik, show 0 < k by omega]

theorem unmarkedLayerMap_injective_lower (i : ℕ) (hik : k ≤ i) (hi : i < n + 1 - k) :
    Function.Injective (deletedLayerMap
      (quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1 - k))) u i _
      (unmarkedLayer_lower_le_ker n (n + 1 - k) u k (by omega) (by omega) i hik)) := by
  apply deletedLayerMap_injective_of_finrank_le _ (quotientRoot_aeval_surjective _)
  rw [unmarkedLayer_finrank_eq_bound n k hk u i hi, unmarkedLayer_child_lower_eq n k hk i hik hi]

end Exact

/-! ### Product strata -/

/-- The product of a group splits off one of its roots. -/
theorem prod_eq_mul_deletedGroup_of_mem {C : Type*} [CommRing C] {n : ℕ}
    (r : Fin (n + 1) → C) (Z : Finset (Fin (n + 1))) (y : Fin (n + 1)) (hy : y ∈ Z) :
    ∏ i ∈ Z, r i = r y * ∏ j ∈ deletedGroup y Z, r (y.succAbove j) := by
  rw [prod_eq_deletedGroup r Z y, if_pos hy]

/-- The product step for a stratum generated by a product: in the layers `i ≥ 1` of a root
`y ∈ Z`, the images of the ideal of the remaining product add up to at most `dim (∏ Z)`. -/
theorem productStratum_layers_le {C : Type*} [CommRing C] [Algebra ℂ C] [FiniteDimensional ℂ C]
    {n : ℕ} (r : Fin (n + 1) → C) (y : Fin (n + 1)) (Z : Finset (Fin (n + 1))) (hy : y ∈ Z)
    (N : ℕ) (hz : r y ^ N = 0) :
    ∑ i ∈ Finset.range (N - 1), Module.finrank ℂ ((((Ideal.span
        {∏ j ∈ deletedGroup y Z, r (y.succAbove j)} : Ideal C).restrictScalars ℂ).map
          (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r y) (i + 1))).toLinearMap)) ≤
      Module.finrank ℂ ((Ideal.span {∏ i ∈ Z, r i} : Ideal C).restrictScalars ℂ) := by
  set π' := ∏ j ∈ deletedGroup y Z, r (y.succAbove j)
  have hπ : ∏ i ∈ Z, r i = r y * π' := prod_eq_mul_deletedGroup_of_mem r Z y hy
  let W : ℕ → Submodule ℂ C := fun j => (Ideal.span {π' * r y ^ (1 - j)}).restrictScalars ℂ
  have hW : ∀ j < N, ∀ c ∈ W j, r y ^ j * c ∈
      (Ideal.span {∏ i ∈ Z, r i} : Ideal C).restrictScalars ℂ ⊔
        (Ideal.span {r y ^ (j + 1)}).restrictScalars ℂ := by
    intro j _ c hc
    apply Submodule.mem_sup_left
    rw [Submodule.restrictScalars_mem, Ideal.mem_span_singleton'] at hc
    obtain ⟨d, rfl⟩ := hc
    rw [Submodule.restrictScalars_mem, hπ]
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · simp only [Nat.sub_zero, pow_zero, pow_one, one_mul]
      rw [show d * (π' * r y) = d * (r y * π') by ring]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
    · rw [show 1 - j = 0 by omega, pow_zero, mul_one]
      obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
      rw [show r y ^ (j' + 1) * (d * π') = (r y ^ j' * d) * (r y * π') by ring]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  rcases Nat.eq_zero_or_pos N with hN | hN
  · subst hN
    simp
  have hsum := layer_finrank_sum_le (r y) N hz _
    (fun j => (Ideal.span {π' * r y ^ (1 - j)}).restrictScalars ℂ) hW
  obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
  rw [Finset.sum_range_succ'] at hsum
  have hconv : ∀ x ∈ Finset.range N', Module.finrank ℂ ((((Ideal.span
      {π' * r y ^ (1 - (x + 1))} : Ideal C).restrictScalars ℂ).map
        (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r y) (x + 1))).toLinearMap)) =
      Module.finrank ℂ ((((Ideal.span {π'} : Ideal C).restrictScalars ℂ).map
        (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r y) (x + 1))).toLinearMap)) := by
    intro x _
    rw [show 1 - (x + 1) = 0 by omega, pow_zero, mul_one]
  rw [Finset.sum_congr rfl hconv] at hsum
  rw [Nat.add_sub_cancel]
  exact (Nat.le_add_right _ _).trans hsum

/-- **Product stratum without doubles.** -/
theorem unmarkedFlag_noDouble_product_finrank_ge (n : ℕ) (Z : Finset (Fin n)) :
    (n - Z.card) * (n - 1).factorial ≤ Module.finrank ℂ ((Ideal.span
      {∏ i ∈ Z, quotientRoot (unmarkedFlagIdeal n n) i}).restrictScalars ℂ) := by
  classical
  induction n with
  | zero =>
      rw [Nat.zero_sub, zero_mul]
      exact Nat.zero_le _
  | succ n ih =>
      by_cases hZ : Z = ∅
      · subst hZ
        rw [Finset.prod_empty, Ideal.span_singleton_one, Submodule.restrictScalars_top,
          finrank_top]
        have h := unmarkedFlag_finrank_eq (n + 1) 0 (by omega)
        rw [Nat.sub_zero] at h
        have hc := fullFlagConfiguration_card_closed (n + 1) 0 (by omega)
        rw [pow_zero, one_mul] at hc
        rw [h, hc, Finset.card_empty, Nat.sub_zero, Nat.add_sub_cancel, Nat.factorial_succ]
      obtain ⟨y, hy⟩ := Finset.nonempty_iff_ne_empty.mpr hZ
      have hcardZ := deletedGroup_card_of_mem Z y hy
      set r := quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1))
      have hsum := productStratum_layers_le r y Z hy (n + 1) (unmarkedFlag_cutoff _ _ y)
      rw [Nat.add_sub_cancel] at hsum
      refine le_trans ?_ hsum
      have hterm : ∀ i ∈ Finset.range n, (n - (deletedGroup y Z).card) * (n - 1).factorial ≤
          Module.finrank ℂ ((((Ideal.span {∏ j ∈ deletedGroup y Z, r (y.succAbove j)} :
            Ideal (UnmarkedFlagRing (n + 1) (n + 1))).restrictScalars ℂ).map
              (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r y) (i + 1))).toLinearMap)) := by
        intro i hi
        have hi' := Finset.mem_range.mp hi
        have hinj := unmarkedLayerMap_injective_lower n 0 (by omega) y (i + 1) (by omega)
          (by omega)
        have hl := childProduct_finrank_le_layer r y (i + 1) _
          (unmarkedLayer_lower_le_ker n (n + 1 - 0) y 0 (by omega) (by omega) (i + 1)
            (by omega)) hinj (deletedGroup y Z)
        have hrec := ih (deletedGroup y Z)
        refine hrec.trans (le_trans (le_of_eq ?_) hl)
        rfl
      refine le_trans ?_ (Finset.sum_le_sum hterm)
      rw [Finset.sum_const, Finset.card_range, smul_eq_mul]
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        have : Z.card = 1 := by
          have := Finset.card_le_univ Z
          rw [Fintype.card_fin] at this
          omega
        simp [this]
      rw [show n + 1 - Z.card = n - (deletedGroup y Z).card by omega, Nat.add_sub_cancel,
        ← Nat.mul_factorial_pred (show n ≠ 0 by omega)]
      apply le_of_eq
      ring

/-- **Product stratum with one double.** -/
theorem unmarkedFlag_oneDouble_product_finrank_ge (n : ℕ) (hn : 2 ≤ n) (Z : Finset (Fin n)) :
    (n - Z.card).choose 2 * (n - 2).factorial ≤ Module.finrank ℂ ((Ideal.span
      {∏ i ∈ Z, quotientRoot (unmarkedFlagIdeal n (n - 1)) i}).restrictScalars ℂ) := by
  classical
  induction n, hn using Nat.le_induction with
  | base =>
      by_cases hZ : Z = ∅
      · subst hZ
        rw [Finset.prod_empty, Ideal.span_singleton_one, Submodule.restrictScalars_top,
          finrank_top, unmarkedFlag_finrank_eq 2 1 (by omega),
          fullFlagConfiguration_card_two_less 2 1 le_rfl le_rfl]
        norm_num only [Finset.card_empty, fullFlagConfiguration_empty_card]
        exact le_rfl
      · have : 1 ≤ Z.card := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hZ)
        rw [Nat.choose_eq_zero_of_lt (by omega)]
        simp
  | succ n hn ih =>
      by_cases hZ : Z = ∅
      · subst hZ
        rw [Finset.prod_empty, Ideal.span_singleton_one, Submodule.restrictScalars_top,
          finrank_top, unmarkedFlag_finrank_eq (n + 1) 1 (by omega),
          fullFlagConfiguration_card_two_less (n + 1) 1 le_rfl (by omega)]
        have hc := fullFlagConfiguration_card_closed (n + 1 - 2) (1 - 1) (by omega)
        rw [pow_zero, one_mul] at hc
        rw [hc, Finset.card_empty, Nat.sub_zero]
      obtain ⟨y, hy⟩ := Finset.nonempty_iff_ne_empty.mpr hZ
      have hcardZ := deletedGroup_card_of_mem Z y hy
      set r := quotientRoot (unmarkedFlagIdeal (n + 1) (n + 1 - 1))
      have hsum := productStratum_layers_le r y Z hy (n + 1 - 1) (unmarkedFlag_cutoff _ _ y)
      refine le_trans ?_ hsum
      have hterm : ∀ i ∈ Finset.range (n + 1 - 1 - 1),
          (n - (deletedGroup y Z).card).choose 2 * (n - 2).factorial ≤
          Module.finrank ℂ ((((Ideal.span {∏ j ∈ deletedGroup y Z, r (y.succAbove j)} :
            Ideal (UnmarkedFlagRing (n + 1) (n + 1 - 1))).restrictScalars ℂ).map
              (Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (r y) (i + 1))).toLinearMap)) := by
        intro i hi
        have hi' := Finset.mem_range.mp hi
        have hinj := unmarkedLayerMap_injective_lower n 1 (by omega) y (i + 1) (by omega)
          (by omega)
        have hl := childProduct_finrank_le_layer r y (i + 1) _
          (unmarkedLayer_lower_le_ker n (n + 1 - 1) y 1 (by omega) (by omega) (i + 1)
            (by omega)) hinj (deletedGroup y Z)
        have hrec := ih (deletedGroup y Z)
        rw [show n - 1 = n + 1 - 1 - 1 by omega] at hrec
        exact hrec.trans hl
      refine le_trans ?_ (Finset.sum_le_sum hterm)
      rw [Finset.sum_const, Finset.card_range, smul_eq_mul,
        show n + 1 - Z.card = n - (deletedGroup y Z).card by omega,
        show n + 1 - 1 - 1 = n - 1 by omega]
      obtain ⟨n', rfl⟩ : ∃ n', n = n' + 2 := ⟨n - 2, by omega⟩
      rw [show n' + 2 + 1 - 2 = n' + 1 by omega, show n' + 2 - 2 = n' by omega,
        show n' + 2 - 1 = n' + 1 by omega, Nat.factorial_succ]
      apply le_of_eq
      ring

end

end VOA.DeligneAudit.SL4T
