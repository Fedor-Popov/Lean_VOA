import VOA.DeligneAudit.D4LevelReductionCoreIdealFiltration

/-! The honest-pair ideal flag induces a finite cyclic filtration of every core module. -/

namespace VOA.DeligneAudit.D4LevelReduction

noncomputable section

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.UnivG

/-- The ordered honest-pair cells for a core coefficient ring. -/
def coreCellCatalog (a b c : ℕ) : List SL4T.SiteCell :=
  SL4T.cellCatalog (a + b + c) (a + b) a

/-- The union size attached to an ordered coefficient cell. -/
def coreCellCutoff (a b c i : ℕ) : ℕ :=
  ((coreCellCatalog a b c).map SL4T.cellCutoff).getD i 0

/-- An honest-pair ideal flag with its cell generators and characteristic relations. -/
structure CoreCellFlag (a b c : ℕ) where
  generator : ℕ → CoreBaseRing a b c
  ideal : ℕ → Ideal (CoreBaseRing a b c)
  first : ideal 0 = ⊥
  last : ideal (coreCellCatalog a b c).length = ⊤
  step : ∀ i < (coreCellCatalog a b c).length,
    (ideal (i + 1)).restrictScalars ℂ = (ideal i).restrictScalars ℂ ⊔ ℂ ∙ generator i
  characteristic : ∀ i < (coreCellCatalog a b c).length,
    Polynomial.C (generator i) * Polynomial.X ^ coreCellCutoff a b c i ∈
      (ideal i).map Polynomial.C ⊔ SL4T.S_relationIdeal (a + b + c) (a + b) a

/-- The two-Grassmannian spanning theorem supplies an honest-pair flag for every triple. -/
theorem coreCellFlag_exists (a b c : ℕ) : Nonempty (CoreCellFlag a b c) := by
  obtain ⟨σ, F, hp, ht, hr⟩ := SL4T.k1_spanning (a + b + c) (a + b) a
    (by omega) (by omega)
  refine ⟨⟨σ, F, ?_, ht, ?_, hr⟩⟩
  · apply Submodule.restrictScalars_injective ℂ
    rw [hp 0 (Nat.zero_le _), SL4T.generatorPrefix_zero, Submodule.restrictScalars_bot]
  · intro i hi
    change i < (SL4T.cellCatalog (a + b + c) (a + b) a).length at hi
    rw [hp (i + 1) (by exact Nat.succ_le_of_lt hi), hp i (by omega),
      SL4T.generatorPrefix_succ]

/-- A selected honest-pair flag; subsequent estimates can instead use any flag of this type. -/
def coreCellFlag (a b c : ℕ) : CoreCellFlag a b c :=
  Classical.choice (coreCellFlag_exists a b c)

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (a b c : ℕ) (Q : CurrentModule A3Sector.bracketTable V)
variable (π : CoreBaseRing a b c →ₗ[ℂ] V) (F : CoreCellFlag a b c)

/-- The module filtration generated by the successive honest-pair coefficient ideals. -/
def coreCellFiltration (i : ℕ) : Submodule ℂ V := coreIdealSpan a b c Q π (F.ideal i)

/-- The cell quotient, realized as the image in the quotient by the preceding term. -/
def coreCellPiece (i : ℕ) :
    Submodule ℂ (V ⧸ coreCellFiltration a b c Q π F i) :=
  (coreCellFiltration a b c Q π F (i + 1)).map
    (coreCellFiltration a b c Q π F i).mkQ

theorem coreCellFiltration_zero : coreCellFiltration a b c Q π F 0 = ⊥ := by
  rw [coreCellFiltration, F.first, coreIdealSpan_bot]

theorem coreCellFiltration_top (hcyclic : cycSubG Q (π 1) = ⊤) :
    coreCellFiltration a b c Q π F (coreCellCatalog a b c).length = ⊤ := by
  rw [coreCellFiltration, F.last, coreIdealSpan_top a b c Q π hcyclic]

/-- The ordered ideal flag gives an increasing module filtration on its full index interval. -/
theorem coreCellFiltration_mono (i j : ℕ) (hij : i ≤ j)
    (hj : j ≤ (coreCellCatalog a b c).length) :
    coreCellFiltration a b c Q π F i ≤ coreCellFiltration a b c Q π F j := by
  induction j, hij using Nat.le_induction with
  | base => exact le_rfl
  | succ j hij ih =>
      apply (ih (by omega)).trans
      apply coreIdealSpan_mono
      intro φ hφ
      change φ ∈ (F.ideal (j + 1)).restrictScalars ℂ
      rw [F.step j (by omega)]
      exact Submodule.mem_sup_left hφ

theorem coreCellFiltration_stable (i : ℕ) (e : Fin 15) (r : ℕ) :
    coreCellFiltration a b c Q π F i ≤
      (coreCellFiltration a b c Q π F i).comap (Q.op e r) :=
  coreIdealSpan_stable a b c Q π (F.ideal i) e r

/-- Each honest-pair cell module is cyclic on the image of its coefficient generator. -/
theorem coreCellPiece_cyclic (i : ℕ) (hi : i < (coreCellCatalog a b c).length) :
    coreCellPiece a b c Q π F i =
      cycSubG (coreIdealQuotientCurrent a b c Q π (F.ideal i))
        ((coreCellFiltration a b c Q π F i).mkQ (π (F.generator i))) :=
  coreIdealSpan_step_quotient a b c Q π _ _ _ (F.step i hi)

/-- Cell rank estimates sum to a bound on the entire core module. -/
theorem coreCellFiltration_finrank_le [FiniteDimensional ℂ V]
    (hcyclic : cycSubG Q (π 1) = ⊤) (d : ℕ → ℕ)
    (hcell : ∀ i < (coreCellCatalog a b c).length,
      Module.finrank ℂ (coreCellPiece a b c Q π F i) ≤ d i) :
    Module.finrank ℂ V ≤ ∑ i ∈ Finset.range (coreCellCatalog a b c).length, d i := by
  have hb : ∀ n ≤ (coreCellCatalog a b c).length,
      Module.finrank ℂ (coreCellFiltration a b c Q π F n) ≤
        ∑ i ∈ Finset.range n, d i := by
    intro n hn
    induction n with
    | zero => simp [coreCellFiltration_zero]
    | succ n ih =>
        have hp := ih (by omega)
        have hc := hcell n (by omega)
        have hd := finrank_le_map_add_infG (coreCellFiltration a b c Q π F n).mkQ
          (coreCellFiltration a b c Q π F (n + 1))
        have hk : Module.finrank ℂ
            (coreCellFiltration a b c Q π F (n + 1) ⊓
              LinearMap.ker (coreCellFiltration a b c Q π F n).mkQ : Submodule ℂ V) ≤
                Module.finrank ℂ (coreCellFiltration a b c Q π F n) := by
          apply Submodule.finrank_mono
          rw [Submodule.ker_mkQ]
          exact inf_le_right
        change Module.finrank ℂ
          ((coreCellFiltration a b c Q π F (n + 1)).map
            (coreCellFiltration a b c Q π F n).mkQ) ≤ d n at hc
        rw [Finset.sum_range_succ]
        omega
  have ht := hb (coreCellCatalog a b c).length le_rfl
  rwa [coreCellFiltration_top a b c Q π F hcyclic, finrank_top] at ht

/-- The remaining cell truncation statement, with the exact union cutoff of every cell. -/
def CoreCellTruncation : Prop :=
  ∀ i < (coreCellCatalog a b c).length, ∀ e r, coreCellCutoff a b c i ≤ r →
    Q.op e r (π (F.generator i)) ∈ coreCellFiltration a b c Q π F i

end

end VOA.DeligneAudit.D4LevelReduction

