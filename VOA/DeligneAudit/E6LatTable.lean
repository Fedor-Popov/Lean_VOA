def tgt : Fin 78 → Fin 78 → Fin 78 := ![tgtr0, tgtr1, tgtr2, tgtr3, tgtr4, tgtr5, tgtr6, tgtr7, tgtr8, tgtr9, tgtr10, tgtr11, tgtr12, tgtr13, tgtr14, tgtr15, tgtr16, tgtr17, tgtr18, tgtr19, tgtr20, tgtr21, tgtr22, tgtr23, tgtr24, tgtr25, tgtr26, tgtr27, tgtr28, tgtr29, tgtr30, tgtr31, tgtr32, tgtr33, tgtr34, tgtr35, tgtr36, tgtr37, tgtr38, tgtr39, tgtr40, tgtr41, tgtr42, tgtr43, tgtr44, tgtr45, tgtr46, tgtr47, tgtr48, tgtr49, tgtr50, tgtr51, tgtr52, tgtr53, tgtr54, tgtr55, tgtr56, tgtr57, tgtr58, tgtr59, tgtr60, tgtr61, tgtr62, tgtr63, tgtr64, tgtr65, tgtr66, tgtr67, tgtr68, tgtr69, tgtr70, tgtr71, tgtr72, tgtr73, tgtr74, tgtr75, tgtr76, tgtr77]

/-- The cert structure constants as a function. -/
def sZ (a b c : Fin 78) : ℤ := ((sL a b).map fun t => if t.1 = c then t.2 else 0).sum

/-- `∑ᵢ co·vᵢ x_i` as a sparse list over the Cartan indices. -/
def cartanList (co : ℤ) (v : Lat) : List (Fin 78 × ℤ) :=
  (List.finRange 6).filterMap fun i => if co * v i = 0 then none else some (⟨i.val, Nat.lt_of_lt_of_le i.isLt (by decide)⟩, co * v i)

/-- A single sparse entry, dropped when zero. -/
def single1 (c : Fin 78) (k : ℤ) : List (Fin 78 × ℤ) := if k = 0 then [] else [(c, k)]

/-- The lattice-model bracket table. -/
def modelL (a b : Fin 78) : List (Fin 78 × ℤ) :=
  if a.val < 6 then
    if b.val < 6 then [] else single1 b (formZ (hvec a) (wt b))
  else if b.val < 6 then single1 a (-formZ (hvec b) (wt a))
  else if formZ (wt a) (wt b) = -2 then cartanList (u a * u b * sgn (ep (wt a) (wt b))) (wt a)
  else if formZ (wt a) (wt b) = -1 then single1 (tgt a b) (u a * u b * sgn (ep (wt a) (wt b)) * u (tgt a b))
  else []

/-- `wt`, with the Cartan indices sent to a root. -/
def wtR (a : Fin 78) : Lat := if 6 ≤ a.val then wt a else wt 6

theorem wtR_root (a : Fin 78) (h : 6 ≤ a.val) : wtR a = wt a := by rw [wtR, if_pos h]

/-- Everything checked about the pair `(a, b)`: the model entry is the cert entry, and for two roots
the form is `≥ -2`, `-2` means opposite, `-1` means `tgt a b` is the root `wt a + wt b`. -/
def pairOK (a b : Fin 78) : Bool :=
  decide (sL a b = modelL a b) &&
  (if 6 ≤ a.val ∧ 6 ≤ b.val then
     decide (-2 ≤ formZ (wt a) (wt b)) &&
     (if formZ (wt a) (wt b) = -2 then decide (wt b = -wt a) else true) &&
     (if formZ (wt a) (wt b) = -1 then
        decide (6 ≤ (tgt a b).val ∧ wt (tgt a b) = wt a + wt b) else true)
   else true)

end VOA.DeligneAudit.E6Lat
