/-!
# Integer tables for the `E₆` cert basis in the lattice model (generated)

The basis of `casimir_cert/cert_E6.json` (= `singular_cert`; that it agrees with the table
`SCLie.e6T` is a generator-side claim, not checked in Lean): indices `0..5` the Cartan elements
`H_i = [E_i, F_i]`, then the 72 root vectors with weights `wt` (simple-root coordinates; `CartanMatrix.E₆`
ordering, which is the certificate's).  `sL` is the cert's structure-constant table.  `modelL` is the bracket table
of the rescaled lattice basis `x_i = α_i(-1)𝟙`, `x_a = u_a f(wt a) e^{wt a}` of `(V_{E₆})₁` computed with the
explicit cocycle `ε' = (-1)^{ep}`; the files `E6LatModel*` check, row by row, that it is the cert table.
Generated by a script not included in this release (the `E₇` pipeline at rank 6).
-/

namespace VOA.DeligneAudit.E6Lat

set_option linter.style.longLine false

/-- Coordinates of the `E₆` root lattice. -/
abbrev Lat := Fin 6 → ℤ

/-- The `E₆` form `⟨v,w⟩ = vᵀ A w`. -/
def formZ (v w : Lat) : ℤ :=
  v 0 * (2 * w 0 - 1 * w 2) + v 1 * (2 * w 1 - 1 * w 3) + v 2 * (-1 * w 0 + 2 * w 2 - 1 * w 3) + v 3 * (-1 * w 1 - 1 * w 2 + 2 * w 3 - 1 * w 4) + v 4 * (-1 * w 3 + 2 * w 4 - 1 * w 5) + v 5 * (-1 * w 4 + 2 * w 5)

/-- The explicit cocycle exponent `ep v w = ∑ vᵢ wⱼ T'ᵢⱼ` (`T'` upper triangular, `1` on the diagonal). -/
def ep (v w : Lat) : ℤ :=
  v 0 * (1 * w 0 - 1 * w 2) + v 1 * (1 * w 1 - 1 * w 3) + v 2 * (1 * w 2 - 1 * w 3) + v 3 * (1 * w 3 - 1 * w 4) + v 4 * (1 * w 4 - 1 * w 5) + v 5 * (1 * w 5)

/-- `(-1)^n` as an integer. -/
def sgn (n : ℤ) : ℤ := if n % 2 = 0 then 1 else -1

/-- The unit vector of a Cartan index. -/
def hvec (a : Fin 78) : Lat := fun j => if j.val = a.val then 1 else 0

