import VOA.AffineGeneral.F4Table
import VOA.DeligneAudit.F4SectorRawRelations
import VOA.DeligneAudit.F4SectorU3Data
import VOA.DeligneAudit.F4SectorRawGeneration
import VOA.DeligneAudit.F4SectorRawCyclic
import VOA.DeligneAudit.F4SectorRawStability
import VOA.DeligneAudit.E6Sparse
import VOA.DeligneAudit.E6SectorSparse
import VOA.DeligneAudit.DeligneSectorGenerate
import VOA.DeligneAudit.DeligneDivisorSort

/-!
# Light F4 carrier/sector data and check definitions (generated)

Generated by `Notes/deligne/campaign/generators/gen_sc_sector.py f4` from the `f4T`.
The root system is recomputed from the Cartan action; the `M` is not used. The data
contains the 324 relations of `I₂ⁿˢ`, the Casimir, U3 and basis-generation certificates,
stability certificates, weights and the coadjoint word tree. The Boolean checks are
defined here and evaluated in
`F4SectorChecks`.
-/

namespace VOA.DeligneAudit.DeligneSector.F4

open VOA.DeligneAudit.DeligneSector.Sparse VOA.DeligneAudit.DeligneDivisor
open VOA.DeligneAudit.E6Sparse (decZ quadOf certOf)

set_option linter.style.longLine false
set_option maxRecDepth 100000

/- f4: θ = 21, c₀ = -θ = 45, Cartan basis [0, 1, 2, 3] with θ-values [2, 1, 0, -1]; simple E = [50, 37, 22, 23], F = [26, 13, 46, 47];
   lowering exponents ⟨θ, α_i^∨⟩ = [0, 0, 0, 1]; ℓ_i = [[-1, 1, 2, 2], [1, -1, 2, 1], [3, 2, -1, 1], [2, 1, 1, -1]]; ht θ = 11; cyclicity depth 22. -/

/-- The brackets: the table `f4T`. -/
def br (a b : ℕ) : SV := VOA.AffineGeneral.SCLie.entry VOA.AffineGeneral.SCLie.f4T a b

/-- Relation `k` (`324` = Casimir). -/
def relZ (k : ℕ) : QV := if k < 324 then relQ k else qQ

/-- Index ranges of the relations. -/
def relRange : Bool :=
  (List.range 325).all fun k => (relZ k).all fun t => decide (t.1 < 52) && decide (t.2.1 < 52)

/-- Decode flat `s μ` pairs. -/
def zpairs : List ℕ → List (ℕ × ℤ)
  | s :: z :: rest => (s, decZ z) :: zpairs rest
  | _ => []

/-- The stability certificate of generator number `i`, relation `r`. -/
def stabCert (i r : ℕ) : Option (ℤ × List (ℕ × ℤ)) :=
  ((stabRaw.getD i []).find? fun l => l.headD 0 == r).map fun l => (((l.getD 1 1 : ℕ) : ℤ), zpairs (l.drop 2))

/-- The stability check of generator number `i`, relation `r`. -/
def stabCheck (i r : ℕ) : Bool :=
  match stabCert i r with
  | none => qzeroSortSym (adQ br (gensL.getD i 0) (relZ r))
  | some (N, ps) => decide (N ≠ 0) && ps.all (fun p => decide (p.1 < 325)) &&
      qzeroSortSym (smulQ N (adQ br (gensL.getD i 0) (relZ r)) ++
        ps.flatMap fun p => smulQ (-p.2) (relZ p.1))

/-- All stability checks. -/
def stabChecks : Bool := (List.range 12).all fun i => (List.range 325).all fun k => stabCheck i k

/-- The weight coordinate `i` of basis vector `c`. -/
def wtZ (c i : ℕ) : ℤ := decZ (wtRaw.getD (4 * c + i) 0)

/-- Weight homogeneity of the brackets. -/
def wtCheck : Bool :=
  (List.range 52).all fun a => (List.range 52).all fun b => (br a b).all fun p =>
    (List.range 4).all fun i => wtZ p.1 i == wtZ a i + wtZ b i

/-- Decode a flat `c z c z …` list. -/
def pairsOf : List ℕ → SV
  | c :: z :: rest => (c, decZ z) :: pairsOf rest
  | _ => []

/-- Word tree vector `i`. -/
def vecs (i : ℕ) : SV := pairsOf (vecR.getD i [])

/-- Word tree data of node `i`. -/
def cpar (i : ℕ) : ℕ × ℕ × ℕ :=
  let l := cparR.getD i []
  (l.getD 0 0, l.getD 1 0, l.getD 2 0)

/-- Bracket rows. -/
def rows (x : ℕ) : List SV := (List.range 52).map (br x)

/-- The cyclicity certificate of `c`. -/
def cyc (c : ℕ) : ℤ × List (ℕ × ℤ) := cycT.getD c (1, [])

/-- The word tree node checks. -/
def cycNodes : Bool :=
  (List.range' 1 (vecR.length - 1)).all fun i =>
    VOA.DeligneAudit.DeligneSector.Generate.cycNodeCheck rows vecs cpar 52 i

/-- The cyclicity check. -/
def cycCheck : Bool :=
  (List.range 52).all fun c =>
    (cyc c).1 != 0 &&
    (cyc c).2.all (fun p => decide (p.1 < vecR.length) && decide ((cpar p.1).2.2 ≤ 22)) &&
    zeroCheck (((cyc c).2.flatMap fun p => smulSV p.2 (vecs p.1)) ++
      smulSV (-1) (smulSV (cyc c).1 [(c, 1)]))

/-- Positive root vectors. -/
def posL : List ℕ := [4, 5, 7, 8, 14, 15, 16, 17, 19, 21, 22, 23, 24, 25, 27, 30, 33, 34, 35, 36, 37, 42, 44, 50]

/-- Negative root vectors. -/
def negL : List ℕ := [6, 9, 10, 11, 12, 13, 18, 20, 26, 28, 29, 31, 32, 38, 39, 40, 41, 43, 45, 46, 47, 48, 49, 51]

end VOA.DeligneAudit.DeligneSector.F4
