/-- The root index of `wt a + wt b`. -/
def tgt (a b : Fin 248) : Fin 248 := (tgtRows.getD a.val []).getD b.val 0

/-- The cert structure constants as a function. -/
def sZ (a b c : Fin 248) : ℤ := ((sL a b).map fun t => if t.1 = c then t.2 else 0).sum

/-- `∑ᵢ co·vᵢ x_i` as a sparse list over the Cartan indices. -/
def cartanList (co : ℤ) (v : Lat) : List (Fin 248 × ℤ) :=
  (List.finRange 8).filterMap fun i => if co * v i = 0 then none else some (⟨i.val, Nat.lt_of_lt_of_le i.isLt (by decide)⟩, co * v i)

/-- A single sparse entry, dropped when zero. -/
def single1 (c : Fin 248) (k : ℤ) : List (Fin 248 × ℤ) := if k = 0 then [] else [(c, k)]

/-- The lattice-model bracket table. -/
def modelL (a b : Fin 248) : List (Fin 248 × ℤ) :=
  if a.val < 8 then
    if b.val < 8 then [] else single1 b (formZ (hvec a) (wt b))
  else if b.val < 8 then single1 a (-formZ (hvec b) (wt a))
  else if formZ (wt a) (wt b) = -2 then cartanList (u a * u b * sgn (ep (wt a) (wt b))) (wt a)
  else if formZ (wt a) (wt b) = -1 then single1 (tgt a b) (u a * u b * sgn (ep (wt a) (wt b)) * u (tgt a b))
  else []

/-- `wt`, with the Cartan indices sent to a root. -/
def wtR (a : Fin 248) : Lat := if 8 ≤ a.val then wt a else wt 8

theorem wtR_root (a : Fin 248) (h : 8 ≤ a.val) : wtR a = wt a := by rw [wtR, if_pos h]

/-- Everything checked about the pair `(a, b)`: the model entry is the cert entry, and for two roots
the form is `≥ -2`, `-2` means opposite, `-1` means `tgt a b` is the root `wt a + wt b`. -/
def pairOK (a b : Fin 248) : Bool :=
  decide (sL a b = modelL a b) &&
  (if 8 ≤ a.val ∧ 8 ≤ b.val then
     decide (-2 ≤ formZ (wt a) (wt b)) &&
     (if formZ (wt a) (wt b) = -2 then decide (wt b = -wt a) else true) &&
     (if formZ (wt a) (wt b) = -1 then
        decide (8 ≤ (tgt a b).val ∧ wt (tgt a b) = wt a + wt b) else true)
   else true)

