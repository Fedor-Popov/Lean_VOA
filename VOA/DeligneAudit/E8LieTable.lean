import Mathlib.Data.Fin.VecNotation
import Mathlib.Data.List.FinRange
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.Order.Ring.Int

/-!
# Integer tables for the `E₈` cert basis (generated)

The basis of `Notes/deligne/audit_2026_10_25/casimir_cert/cert_E8.json` (= `singular_cert`): indices
`0..7` the Cartan elements `H_i = [E_i, F_i]`, then the 240 root vectors with weights `wt` (simple-root
coordinates, `CartanMatrix.E₈` ordering).  `sL` is the cert's structure-constant table (sparse rows, one
definition per row).  `modelL` is the bracket table of the rescaled lattice basis `x_i = α_i(-1)𝟙`,
`x_a = u_a f(wt a) e^{wt a}` of `(V_{E₈})₁` computed with the explicit cocycle `ε' = (-1)^{ep}`; the
files `E8LieModel*` check, row by row, that it is the cert table.  The pattern is the `E₇` route
(`E7Lie*`).
-/

namespace VOA.DeligneAudit.E8Lie

set_option linter.style.longLine false
set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-- Coordinates of the `E₈` root lattice. -/
abbrev Lat := Fin 8 → ℤ

/-- The `E₈` form `⟨v,w⟩ = vᵀ A w`. -/
def formZ (v w : Lat) : ℤ :=
  v 0 * (2 * w 0 - 1 * w 2) + v 1 * (2 * w 1 - 1 * w 3) + v 2 * (-1 * w 0 + 2 * w 2 - 1 * w 3) + v 3 * (-1 * w 1 - 1 * w 2 + 2 * w 3 - 1 * w 4) + v 4 * (-1 * w 3 + 2 * w 4 - 1 * w 5) + v 5 * (-1 * w 4 + 2 * w 5 - 1 * w 6) + v 6 * (-1 * w 5 + 2 * w 6 - 1 * w 7) + v 7 * (-1 * w 6 + 2 * w 7)

/-- The explicit cocycle exponent `ep v w = ∑ vᵢ wⱼ T'ᵢⱼ` (`T'` upper triangular, `1` on the diagonal). -/
def ep (v w : Lat) : ℤ :=
  v 0 * (1 * w 0 - 1 * w 2) + v 1 * (1 * w 1 - 1 * w 3) + v 2 * (1 * w 2 - 1 * w 3) + v 3 * (1 * w 3 - 1 * w 4) + v 4 * (1 * w 4 - 1 * w 5) + v 5 * (1 * w 5 - 1 * w 6) + v 6 * (1 * w 6 - 1 * w 7) + v 7 * (1 * w 7)

/-- `(-1)^n` as an integer. -/
def sgn (n : ℤ) : ℤ := if n % 2 = 0 then 1 else -1

/-- The unit vector of a Cartan index. -/
def hvec (a : Fin 248) : Lat := fun j => if j.val = a.val then 1 else 0

