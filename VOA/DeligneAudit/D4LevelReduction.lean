import VOA.DeligneAudit.D4LevelReductionHighestRoot

/-!
The high-current truncation of a cyclic level-one D4 module is generated by the
node-one reductive Levi currents. The parent module has the `ravFam` presentation;
its truncation at mode `m` is the module presented by `lwSpec`.
-/

namespace VOA.DeligneAudit.D4LevelReduction

open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4
open VOA.DeligneAudit.D4Levi

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule D4sector.f V) (w : V)

/-- The sum of the cyclic modules generated by high highest-root vectors. -/
noncomputable def highestRootTailClosure (N : ℕ) : Submodule ℂ V :=
  ⨆ r : {r : ℕ // N ≤ r}, cycSubG ρ (ρ.op (27 : Fin 28) r.val w)

theorem highestRootTailClosure_stable (N : ℕ) (a : Fin 28) (s : ℕ) :
    highestRootTailClosure ρ w N ≤
      (highestRootTailClosure ρ w N).comap (ρ.op a s) := by
  apply iSup_le
  intro r v hv
  exact Submodule.mem_iSup_of_mem r (cycSubG_inv ρ _ a s hv)

/-- A high current on any cyclic vector lies in the highest-root tail closure. -/
theorem fullCurrentTail_le_highestRootClosure (m N : ℕ)
    (hm : 1 ≤ m) (hN : m ≤ N)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    fullCurrentTail ρ w N ≤ highestRootTailClosure ρ w N := by
  have hword : ∀ l : List (Fin 28 × ℕ), ∀ c r, N ≤ r →
      ρ.op c r (wordOp ρ l w) ∈ highestRootTailClosure ρ w N := by
    intro l
    induction l with
    | nil =>
        intro c r hr
        by_cases hc : c = (27 : Fin 28)
        · subst c
          exact Submodule.mem_iSup_of_mem ⟨r, hr⟩ (wordOp_mem_cycSubG ρ _ [])
        · change ρ.op c r w ∈ _
          rw [source_high_current_zero ρ w m hm h c hc r (by omega)]
          exact Submodule.zero_mem _
    | cons a l ih =>
        intro c r hr
        change ρ.op c r (ρ.op a.1 a.2 (wordOp ρ l w)) ∈ _
        rw [sub_eq_iff_eq_add.mp (ρ.comm c a.1 r a.2 _)]
        apply Submodule.add_mem
        · apply Submodule.sum_mem
          intro b _
          exact (highestRootTailClosure ρ w N).smul_mem _ (ih b (r + a.2) (by omega))
        · exact highestRootTailClosure_stable ρ w N a.1 a.2 (ih c r hr)
  rw [fullCurrentTail, currentTail, Submodule.span_le]
  rintro z ⟨c, _, r, hr, v, hv, rfl⟩
  induction hv using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨l, rfl⟩ := hz
      exact hword l c r hr
  | zero => simpa using (highestRootTailClosure ρ w N).zero_mem
  | add x y _ _ hx hy => simpa using (highestRootTailClosure ρ w N).add_mem hx hy
  | smul a x _ hx => simpa using (highestRootTailClosure ρ w N).smul_mem a hx

/-- Every word in the radical colours lifts to the existing six-letter alphabet. -/
theorem radicalWord_lift (l : List (Fin 28 × ℕ))
    (hl : l.Forall (fun x => D4Levi.IsRadical x.1)) :
    ∃ t : List (Fin 6 × ℕ), l = t.map (fun p => (radicalColour p.1, p.2)) := by
  induction l with
  | nil => exact ⟨[], rfl⟩
  | cons a l ih =>
      simp only [List.forall_cons] at hl
      obtain ⟨i, hi⟩ := hl.1
      obtain ⟨t, ht⟩ := ih hl.2
      exact ⟨(i, a.2) :: t, by simp [hi, ht]⟩

/-- PBW extends the radical descent to every highest-root tail cyclic module. -/
theorem highestRootTailClosure_le_leviTail (m N : ℕ)
    (hm : 1 ≤ m) (hN : m ≤ N)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    highestRootTailClosure ρ w N ≤ leviCurrentTail ρ w N := by
  apply iSup_le
  intro r
  have hgen : cycSubG ρ (ρ.op (27 : Fin 28) r.val w) =
      leviSpan ρ (ρ.op (27 : Fin 28) r.val w) :=
    cycSubG_eq_leviSpan ρ (ρ.op (27 : Fin 28) r.val w)
      (positive_radical_highestRoot_zero ρ w m hm h r.val (by omega))
  rw [hgen]
  rw [leviSpan, Submodule.span_le]
  rintro z ⟨l, t, hl, ht, rfl⟩
  rw [wordOp_append]
  apply leviCurrentTail_word ρ w N l hl
  obtain ⟨u, rfl⟩ := radicalWord_lift t ht
  have heq : wordOp ρ (u.map fun p => (radicalColour p.1, p.2))
      (ρ.op (27 : Fin 28) r.val w) = radicalWord ρ w ((5, r.val) :: u) :=
    (radical_op_word_comm ρ 5 r.val u w).symm
  exact heq.symm ▸
    highestRoot_radical_mem_leviTail ρ w m N hm hN h r.val r.property u

/-- For every positive multiplicity and cutoff at least that multiplicity,
the full D4 truncation image equals the reductive Levi truncation image. -/
theorem fullCurrentTail_eq_leviCurrentTail (m N : ℕ)
    (hm : 1 ≤ m) (hN : m ≤ N)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    fullCurrentTail ρ w N = leviCurrentTail ρ w N := by
  apply le_antisymm
  · exact (fullCurrentTail_le_highestRootClosure ρ w m N hm hN h).trans
      (highestRootTailClosure_le_leviTail ρ w m N hm hN h)
  · exact leviCurrentTail_le_full ρ w N

end VOA.DeligneAudit.D4LevelReduction

#print axioms VOA.DeligneAudit.D4LevelReduction.highestRootTailClosure_stable
#print axioms VOA.DeligneAudit.D4LevelReduction.fullCurrentTail_le_highestRootClosure
#print axioms VOA.DeligneAudit.D4LevelReduction.radicalWord_lift
#print axioms VOA.DeligneAudit.D4LevelReduction.highestRootTailClosure_le_leviTail
#print axioms VOA.DeligneAudit.D4LevelReduction.fullCurrentTail_eq_leviCurrentTail
