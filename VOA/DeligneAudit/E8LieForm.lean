/-- A simple root not orthogonal to the root `wt a`. -/
def pickI (a : Fin 248) : Fin 8 := pickIList.getD a.val 0

/-- `E_i`, `F_i`. -/
def eI : Fin 8 → Fin 248 := ![15, 14, 13, 12, 11, 10, 9, 8]
def fI : Fin 8 → Fin 248 := ![135, 134, 133, 132, 131, 130, 129, 128]

/-- The Cartan index of `i : Fin 8`. -/
def ci8 (i : Fin 8) : Fin 248 := ⟨i.val, Nat.lt_of_lt_of_le i.isLt (by decide)⟩

/-- The Cartan matrix on `Fin 8`. -/
def Am (i j : Fin 8) : ℤ := formZ (hvec (ci8 i)) (hvec (ci8 j))

/-- First simple root not orthogonal to `v`. -/
def pickV (v : Lat) : Fin 8 :=
  ((List.finRange 8).find? fun i => formZ (hvec (ci8 i)) v != 0).getD 0

/-- The per-pair facts for the Killing form computation. -/
def formPairOK (a c : Fin 248) : Bool :=
  if wt a + wt c = 0 then
    (decide (a.val < 8) && decide (c.val < 8) && decide (Gz a c = Am ⟨a.val % 8, Nat.mod_lt _ (by decide)⟩ ⟨c.val % 8, Nat.mod_lt _ (by decide)⟩)) ||
    (decide (8 ≤ a.val) && decide (c = opp a))
  else decide (Gz a c = 0) && decide (formZ (hvec (ci8 (pickV (wt a + wt c)))) (wt a + wt c) ≠ 0)

/-- The per-root facts: `opp a` is the opposite root, `[x_a, x_{-a}]` is Cartan, and the cert form
value `Gz a (opp a)` is the one forced by invariance. -/
def rootOK (a : Fin 248) : Bool :=
  decide (8 ≤ (opp a).val) && decide (wt (opp a) = -wt a) &&
    (sL a (opp a)).all (fun t => decide (t.1.val < 8)) &&
    decide (formZ (hvec (ci8 (pickI a))) (wt a) ≠ 0) &&
    decide (formZ (hvec (ci8 (pickI a))) (wt a) * Gz a (opp a) =
      ((sL a (opp a)).map fun t => t.2 * Am (pickI a) ⟨t.1.val % 8, Nat.mod_lt _ (by decide)⟩).sum)

/-- The per-simple-root facts: `[E_i, F_i] = H_i` and the weight of `E_i`. -/
def simpleOK (i : Fin 8) : Bool :=
  decide (sL (eI i) (fI i) = [(ci8 i, 1)]) && decide (wt (eI i) = hvec (ci8 i)) && decide (8 ≤ (eI i).val) && decide (8 ≤ (fI i).val)

/-- The pairing of the form with twice its inverse. -/
def pairRowOK (a : Fin 248) : Bool :=
  (List.finRange 248).all fun b => decide (((Gi2L b).map fun t => t.2 * Gz a t.1).sum = if a = b then 2 else 0)

