import VOA.DeligneAudit.SL4TTruncatedMiddleModule

/-!
# The one-adjoint-site module of Law B

For a middle label `B` and a mode `h`, the module

    M(B, h) = W(θ + B ω₂, h + 1) / ⟨f₂(h) v⟩

is the universal `sl₄[t]`-module generated by a vector `v` subject to the local Weyl relations of
weight `(1, B, 1)`, the vanishing on `v` of every current of mode at least `h + 1`, and the single
extra relation `f₂(h) v = 0`. Here `f₂ = E₂₁` is the middle simple lowering colour `simpleF 1`.

Law B at one adjoint site, for `k ≥ 1` and `B ≥ 2k`, is the dimension bound

    dim M(B, B - k) ≤ 15 · 20^k · 6^(B - 2k);

its case `k = 1` is the statement called (III). This file records the
presentation, its universal property, finite-dimensionality, the current cutoff on the whole
module, and the precise target proposition `AdjointSiteLawB`.
-/

namespace VOA.DeligneAudit.SL4T

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.UnivG VOA.DeligneAudit.A3Sector

noncomputable section

/-- The local Weyl relations at weight `(1, B, 1)`, the current cutoff at mode `h + 1`, and the
extra middle lowering relation `f₂(h) v = 0`. -/
def adjointSiteSpec (B h : ℕ) : RelSpec 15 where
  tails := (truncatedWeylSpec (weightABC 1 B 1) (h + 1)).tails ∪ {[(simpleF 1, h)]}
  eig := (truncatedWeylSpec (weightABC 1 B 1) (h + 1)).eig

/-- The module `W(θ + B ω₂, h + 1) / ⟨f₂(h) v⟩`. -/
abbrev AdjointSiteModule (B h : ℕ) := UModG bracketTable (adjointSiteSpec B h)

/-- The universal current action on the one-adjoint-site module. -/
abbrev adjointSiteRep (B h : ℕ) : CurrentModule bracketTable (AdjointSiteModule B h) :=
  univRepG bracketTable (adjointSiteSpec B h)

/-- The cyclic generator of the one-adjoint-site module. -/
abbrev adjointSiteGenerator (B h : ℕ) : AdjointSiteModule B h :=
  wUG bracketTable (adjointSiteSpec B h)

/-- The presentation consists of exactly the truncated local Weyl relations and `f₂(h) v = 0`. -/
theorem adjointSiteSpec_sat_iff {V : Type} [AddCommGroup V] [Module ℂ V]
    (ρ : CurrentModule bracketTable V) (w : V) (B h : ℕ) :
    Sat bracketTable ρ w (adjointSiteSpec B h) ↔
      LocalWeylRel ρ w (weightABC 1 B 1) ∧ (∀ x s, h + 1 ≤ s → ρ.op x s w = 0) ∧
        ρ.op (simpleF 1) h w = 0 := by
  rw [← and_assoc, ← truncatedWeylSpec_sat_iff]
  constructor
  · intro hs
    refine ⟨⟨fun t ht => hs.tail t (Or.inl ht), hs.eig⟩, ?_⟩
    exact hs.tail [(simpleF 1, h)] (Or.inr rfl)
  · rintro ⟨hs, hg⟩
    refine ⟨fun t ht => ?_, hs.eig⟩
    rcases ht with ht | ht
    · exact hs.tail t ht
    · rw [Set.mem_singleton_iff.mp ht]
      exact hg

/-- The three families of relations hold at the universal generator. -/
theorem adjointSite_relations (B h : ℕ) :
    LocalWeylRel (adjointSiteRep B h) (adjointSiteGenerator B h) (weightABC 1 B 1) ∧
      (∀ x s, h + 1 ≤ s → (adjointSiteRep B h).op x s (adjointSiteGenerator B h) = 0) ∧
        (adjointSiteRep B h).op (simpleF 1) h (adjointSiteGenerator B h) = 0 :=
  (adjointSiteSpec_sat_iff _ _ B h).mp (univG_sat bracketTable (adjointSiteSpec B h))

/-- The local Weyl relations at the universal generator. -/
theorem adjointSite_localWeyl (B h : ℕ) :
    LocalWeylRel (adjointSiteRep B h) (adjointSiteGenerator B h) (weightABC 1 B 1) :=
  (adjointSite_relations B h).1

/-- Every current of mode at least `h + 1` vanishes on the whole one-adjoint-site module. -/
theorem adjointSiteModule_current_zero (B h : ℕ) (x : Fin 15) (s : ℕ) (hs : h + 1 ≤ s)
    (v : AdjointSiteModule B h) : (adjointSiteRep B h).op x s v = 0 := by
  apply current_truncation_on_cyclic (adjointSiteRep B h) (adjointSiteGenerator B h) (h + 1)
    (adjointSite_relations B h).2.1 v _ x s hs
  rw [presentedCurrent_cyclic]
  exact Submodule.mem_top

/-- The one-adjoint-site module is finite-dimensional, with the untruncated local Weyl bound. -/
theorem adjointSiteModule_finite_and_local_bound (B h : ℕ) :
    FiniteDimensional ℂ (AdjointSiteModule B h) ∧
      Module.finrank ℂ (AdjointSiteModule B h) ≤ 4 ^ 1 * 6 ^ B * 4 ^ 1 := by
  obtain ⟨hf, hr⟩ := a3_all_weight_rank (adjointSiteRep B h) (adjointSiteGenerator B h) 1 B 1
    (adjointSite_localWeyl B h)
  rw [presentedCurrent_cyclic] at hf hr
  haveI : FiniteDimensional ℂ (⊤ : Submodule ℂ (AdjointSiteModule B h)) := hf
  haveI : FiniteDimensional ℂ (AdjointSiteModule B h) :=
    Module.Finite.of_surjective Submodule.topEquiv.toLinearMap Submodule.topEquiv.surjective
  exact ⟨inferInstance, by simpa only [finrank_top] using hr⟩

/-- **Law B at one adjoint site**: `dim W(θ + B ω₂, B - k + 1) / ⟨f₂(B - k) v⟩` is at most
`15 · 20^k · 6^(B - 2k)`. It is asserted for `k ≥ 1` and `B ≥ 2k`; the case `k = 1` is the
statement (III). -/
def AdjointSiteLawB (B k : ℕ) : Prop :=
  FiniteDimensional ℂ (AdjointSiteModule B (B - k)) ∧
    Module.finrank ℂ (AdjointSiteModule B (B - k)) ≤ 15 * 20 ^ k * 6 ^ (B - 2 * k)

/-- A rank bound on the presented module is the same as the bound on every cyclic realization. -/
theorem adjointSiteModule_rank_iff_cyclic (B h D : ℕ) :
    Module.finrank ℂ (AdjointSiteModule B h) ≤ D ↔
      ∀ (V : Type) [AddCommGroup V] [Module ℂ V]
        (ρ : CurrentModule bracketTable V) (w : V),
        LocalWeylRel ρ w (weightABC 1 B 1) →
        (∀ x s, h + 1 ≤ s → ρ.op x s w = 0) →
        ρ.op (simpleF 1) h w = 0 →
        FiniteDimensional ℂ (cycSubG ρ w) ∧ Module.finrank ℂ (cycSubG ρ w) ≤ D := by
  constructor
  · intro hr V _ _ ρ w hw ht hg
    haveI := (adjointSiteModule_finite_and_local_bound B h).1
    have hs := (adjointSiteSpec_sat_iff ρ w B h).mpr ⟨hw, ht, hg⟩
    obtain ⟨hf, hb⟩ := presentedCurrent_cyclic_rank_le hs
    exact ⟨hf, hb.trans hr⟩
  · intro hc
    obtain ⟨hw, ht, hg⟩ := adjointSite_relations B h
    obtain ⟨_, hr⟩ := hc _ (adjointSiteRep B h) (adjointSiteGenerator B h) hw ht hg
    rw [presentedCurrent_cyclic, finrank_top] at hr
    exact hr

end

end VOA.DeligneAudit.SL4T
