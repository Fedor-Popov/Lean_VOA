import VOA.DeligneAudit.SL4TStratumPresentation

/-! # Smaller stratum presentations of the root-power layers -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

attribute [local instance 2000] Fin.fintype Fin.instOfNat

variable {A : Type*} [CommRing A] [Algebra ℂ A]

omit [Algebra ℂ A] [CommRing A] in
/-- A selected alphabet and its complement together enumerate all roots. -/
theorem selectedAlphabet_partition_perm {B : ℕ} (Y : Finset (Fin B)) (x : Fin B → A) :
    (Y.toList.map x ++ Yᶜ.toList.map x).Perm (List.ofFn x) := by
  classical
  have hp : (Y.toList ++ Yᶜ.toList).Perm (List.ofFn (fun i : Fin B => i)) := by
    apply (List.perm_ext_iff_of_nodup ?_ (List.nodup_ofFn.mpr Function.injective_id)).mpr
    · intro a
      simp only [List.mem_append, Finset.mem_toList, Finset.mem_compl,
        List.mem_ofFn, id_eq, exists_eq, iff_true]
      exact Classical.em _
    · rw [List.nodup_append]
      refine ⟨Finset.nodup_toList _, Finset.nodup_toList _, ?_⟩
      intro a ha b hb hab
      subst b
      exact (Finset.mem_compl.mp (Finset.mem_toList.mp hb)) (Finset.mem_toList.mp ha)
  simpa only [List.map_append, List.map_ofFn, Function.comp_def] using hp.map x

omit [Algebra ℂ A] in
/-- The elementary relations survive after the deleted root is killed in a power layer. -/
theorem coinvariantRootPowerLayer_elementary {B : ℕ} (x : Fin (B + 1) → A) (i : ℕ)
    (he : D4Levi.ksEPoly (List.ofFn x) = 1) :
    D4Levi.ksEPoly (List.ofFn fun a : Fin B =>
      Ideal.Quotient.mk (rootPowerLayerIdeal (x 0) i) (x a.succ)) = 1 := by
  let q := Ideal.Quotient.mk (rootPowerLayerIdeal (x 0) i)
  have hz : q (x 0) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (root_mem_powerLayerIdeal _ _)
  have h := congrArg (Polynomial.map q) he
  rw [alphabetElementary_map, List.map_ofFn, Polynomial.map_one, List.ofFn_succ] at h
  simpa only [D4Levi.ksEPoly, List.map_cons, List.prod_cons, Function.comp_apply,
    hz, map_zero, zero_mul, sub_zero, one_mul] using h

/-- The surviving roots generate every power layer of an algebra generated by its roots. -/
theorem coinvariantRootPowerLayer_aeval_surjective {B : ℕ} (x : Fin (B + 1) → A) (i : ℕ)
    (hg : Function.Surjective (MvPolynomial.aeval x : MvPolynomial (Fin (B + 1)) ℂ →ₐ[ℂ] A)) :
    Function.Surjective (MvPolynomial.aeval (fun a : Fin B =>
      Ideal.Quotient.mk (rootPowerLayerIdeal (x 0) i) (x a.succ)) :
        MvPolynomial (Fin B) ℂ →ₐ[ℂ] A ⧸ rootPowerLayerIdeal (x 0) i) := by
  let q := Ideal.Quotient.mkₐ ℂ (rootPowerLayerIdeal (x 0) i)
  let p : MvPolynomial (Fin (B + 1)) ℂ →ₐ[ℂ] A := MvPolynomial.aeval x
  let ev : MvPolynomial (Fin B) ℂ →ₐ[ℂ] A ⧸ rootPowerLayerIdeal (x 0) i :=
    MvPolynomial.aeval (fun a : Fin B => q (x a.succ))
  intro a
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective ℂ _ a
  obtain ⟨f, rfl⟩ := hg a
  change ∃ g, ev g = q (p f)
  induction f using MvPolynomial.induction_on with
  | C c =>
      refine ⟨MvPolynomial.C c, ?_⟩
      change ev (algebraMap ℂ _ c) = q (p (algebraMap ℂ _ c))
      rw [ev.commutes, p.commutes, q.commutes]
  | add f g hf hg =>
      obtain ⟨a, ha⟩ := hf
      obtain ⟨b, hb⟩ := hg
      exact ⟨a + b, by rw [map_add, ha, hb, map_add, map_add]⟩
  | mul_X f a hf =>
      obtain ⟨g, hg⟩ := hf
      refine Fin.cases ?_ (fun a => ?_) a
      · refine ⟨0, ?_⟩
        rw [map_zero, map_mul, map_mul]
        rw [show p (MvPolynomial.X 0) = x 0 from MvPolynomial.aeval_X x 0]
        rw [show q (x 0) = 0 from
          Ideal.Quotient.eq_zero_iff_mem.mpr (root_mem_powerLayerIdeal _ _), mul_zero]
      · refine ⟨g * MvPolynomial.X a, ?_⟩
        rw [map_mul, hg, map_mul, map_mul]
        dsimp only [ev, p]
        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]

omit [Algebra ℂ A] in
/-- The top-minor relations descend to every power layer at a root outside the subalphabet. -/
theorem stratumRootPowerLayer_minor_zero {B : ℕ} (x : Fin (B + 1) → A)
    (Y : Finset (Fin B)) (N j i : ℕ)
    (hm : ∀ cols : Fin j → ℕ,
      remainderTopMinor (Y.toList.map fun a => x a.succ) N j cols = 0)
    (cols : Fin j → ℕ) :
    remainderTopMinor (Y.toList.map fun a =>
      Ideal.Quotient.mk (rootPowerLayerIdeal (x 0) i) (x a.succ)) N j cols = 0 := by
  let q := Ideal.Quotient.mk (rootPowerLayerIdeal (x 0) i)
  have h := congrArg q (hm cols)
  rw [remainderTopMinor_map, map_zero] at h
  simpa only [List.map_map, Function.comp_def] using h

omit [Algebra ℂ A] in
/-- The smaller cutoff also vanishes on every later stratum power layer. -/
theorem stratumRootPowerLayer_lower_minor_zero {B : ℕ} (x : Fin (B + 1) → A)
    (Y : Finset (Fin B)) (N k j i : ℕ) (hN : 0 < N) (hlen : B + 1 = N + k)
    (he : D4Levi.ksEPoly (List.ofFn x) = 1) (hi : k ≤ i)
    (hm : ∀ cols : Fin j → ℕ,
      remainderTopMinor (Y.toList.map fun a => x a.succ) N j cols = 0)
    (cols : Fin j → ℕ) :
    remainderTopMinor (Y.toList.map fun a =>
      Ideal.Quotient.mk (rootPowerLayerIdeal (x 0) i) (x a.succ)) (N - 1) j cols = 0 := by
  let ys := Y.toList.map fun a => x a.succ
  let zs := Yᶜ.toList.map fun a => x a.succ
  have hp := selectedAlphabet_partition_perm Y (fun a => x a.succ)
  have hlen' : (ys ++ zs).length + 1 = N + k := by
    rw [show (ys ++ zs).length = B by simpa only [List.length_ofFn] using hp.length_eq]
    exact hlen
  have he' : D4Levi.ksEPoly ((ys ++ zs) ++ [x 0]) = 1 := by
    rw [alphabetElementary_perm (hp.append_right _)]
    rw [alphabetElementary_perm List.perm_append_comm]
    simpa only [List.singleton_append, ← List.ofFn_succ] using he
  have hbot : remainderTopIdeal ys N j = ⊥ := by
    apply le_antisymm (Ideal.span_le.mpr ?_) bot_le
    rintro a ⟨c, rfl⟩
    exact (Ideal.mem_bot).mpr (hm c)
  have h := remainderTopIdeal_later_layer ys zs (x 0) N k j i hN hlen' he' hi
    (remainderTopMinor ys (N - 1) j cols) (remainderTopMinor_mem _ _ _ _)
  rw [hbot, bot_sup_eq, mul_comm] at h
  have hz := Ideal.Quotient.eq_zero_iff_mem.mpr
    ((rootPowerLayerIdeal_mem (x 0) _ i).mpr h)
  rw [remainderTopMinor_map] at hz
  simpa only [ys, List.map_map, Function.comp_def] using hz

omit [Algebra ℂ A] in
/-- The root cutoff improvement is valid in any coinvariant algebra. -/
theorem coinvariantRootPowerLayer_lower_pow {B : ℕ} (x : Fin (B + 1) → A)
    (N k i : ℕ) (hN : 0 < N) (hlen : B + 1 = N + k)
    (he : D4Levi.ksEPoly (List.ofFn x) = 1) (hx : ∀ a, x a ^ N = 0)
    (hi : k ≤ i) (a : Fin B) :
    (Ideal.Quotient.mk (rootPowerLayerIdeal (x 0) i) (x a.succ)) ^ (N - 1) = 0 := by
  have he' : D4Levi.ksEPoly ((List.ofFn fun a : Fin B => x a.succ) ++ [x 0]) = 1 := by
    rw [alphabetElementary_perm List.perm_append_comm]
    simpa only [List.singleton_append, ← List.ofFn_succ] using he
  rw [← map_pow]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact alphabetRoot_powerLayer_mem _ _ _ N k i (List.mem_ofFn.mpr ⟨a, rfl⟩) hN
    (by simpa only [List.length_ofFn] using hlen) he' (hx a.succ) hi

/-- Every power layer is a quotient of the smaller stratum at the original cutoff. -/
theorem stratumRootPowerLayer_rank_le {B : ℕ} (x : Fin (B + 1) → A)
    (Y : Finset (Fin B)) (N j i : ℕ) (he : D4Levi.ksEPoly (List.ofFn x) = 1)
    (hx : ∀ a, x a ^ N = 0)
    (hm : ∀ cols : Fin j → ℕ,
      remainderTopMinor (Y.toList.map fun a => x a.succ) N j cols = 0)
    (hg : Function.Surjective (MvPolynomial.aeval x : MvPolynomial (Fin (B + 1)) ℂ →ₐ[ℂ] A)) :
    Module.finrank ℂ (A ⧸ rootPowerLayerIdeal (x 0) i) ≤
      Module.finrank ℂ (FullFlagStratumRing B N j Y) := by
  apply fullFlagStratum_rank_le_of_relations B N j Y
    (fun a => Ideal.Quotient.mk _ (x a.succ))
    (coinvariantRootPowerLayer_elementary x i he)
  · intro a
    rw [← map_pow, hx, map_zero]
  · exact stratumRootPowerLayer_minor_zero x Y N j i hm
  · exact coinvariantRootPowerLayer_aeval_surjective x i hg

/-- Every later power layer is a quotient of the smaller stratum with decreased cutoff. -/
theorem stratumRootPowerLayer_lower_rank_le {B : ℕ} (x : Fin (B + 1) → A)
    (Y : Finset (Fin B)) (N k j i : ℕ) (hN : 0 < N) (hlen : B + 1 = N + k)
    (he : D4Levi.ksEPoly (List.ofFn x) = 1) (hx : ∀ a, x a ^ N = 0) (hi : k ≤ i)
    (hm : ∀ cols : Fin j → ℕ,
      remainderTopMinor (Y.toList.map fun a => x a.succ) N j cols = 0)
    (hg : Function.Surjective (MvPolynomial.aeval x : MvPolynomial (Fin (B + 1)) ℂ →ₐ[ℂ] A)) :
    Module.finrank ℂ (A ⧸ rootPowerLayerIdeal (x 0) i) ≤
      Module.finrank ℂ (FullFlagStratumRing B (N - 1) j Y) := by
  exact fullFlagStratum_rank_le_of_relations B (N - 1) j Y
    (fun a => Ideal.Quotient.mk _ (x a.succ))
    (coinvariantRootPowerLayer_elementary x i he)
    (coinvariantRootPowerLayer_lower_pow x N k i hN hlen he hx hi)
    (stratumRootPowerLayer_lower_minor_zero x Y N k j i hN hlen he hi hm)
    (coinvariantRootPowerLayer_aeval_surjective x i hg)

end

end VOA.DeligneAudit.SL4T

