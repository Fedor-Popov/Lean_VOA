import VOA.DeligneAudit.SL4TStratumInvariantDescent
import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
The contraction of coordinate powers to colour-invariant polynomials is generated by
the power sums of each colour above the same cutoff. The proof removes a marked
exponent and inducts on the number of occupied variables, including arbitrary colours.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

/-- Averaging is unchanged by applying one of the group automorphisms first. -/
theorem finiteActionAverageToFixed_action {G A : Type*} [Group G] [Fintype G]
    [CommRing A] [Algebra ℂ A] (ρ : G →* (A ≃ₐ[ℂ] A)) (g : G) (x : A) :
    finiteActionAverageToFixed ρ (ρ g x) = finiteActionAverageToFixed ρ x := by
  apply Subtype.ext
  change finiteActionAverage ρ (ρ g x) = finiteActionAverage ρ x
  simp only [finiteActionAverage, LinearMap.smul_apply, LinearMap.sum_apply,
    AlgEquiv.toLinearMap_apply]
  congr 1
  have he (h : G) : ρ h (ρ g x) = ρ (h * g) x := by rw [map_mul]; rfl
  simp only [he]
  exact Function.Bijective.sum_comp (Group.mulRight_bijective g) (fun h => ρ h x)

variable {C : Type*} [DecidableEq C] {B : ℕ} (colour : Fin B → C)

/-- The finite type of permutations preserving the prescribed colour classes. -/
local instance colourPermutationFintype : Fintype (positionColourSubgroup colour) :=
  Fintype.ofFinite _

/-- Polynomials invariant under all permutations within each colour class. -/
abbrev ColourPolynomialRing := finiteActionFixedSubalgebra
  (polynomialPositionAlgebraAction (positionColourSubgroup colour).subtype)

/-- Reynolds averaging with values in the colour-invariant polynomial algebra. -/
def colourPolynomialAverage : MvPolynomial (Fin B) ℂ →ₗ[ℂ] ColourPolynomialRing colour :=
  finiteActionAverageToFixed
    (polynomialPositionAlgebraAction (positionColourSubgroup colour).subtype)

/-- The power sum of one colour, regarded as an invariant polynomial. -/
def colourPolynomialPowerSum (c : C) (s : ℕ) : ColourPolynomialRing colour := by
  classical
  refine ⟨∑ i ∈ Finset.univ.filter (fun i => colour i = c), X i ^ s, ?_⟩
  intro g
  change rename g.val (∑ i ∈ Finset.univ.filter (fun i => colour i = c),
    (X i : MvPolynomial (Fin B) ℂ) ^ s) = _
  simp only [map_sum, map_pow, rename_X]
  apply Finset.sum_equiv g.val
  · intro i
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rw [show colour (g.val i) = colour i from g.property i]
  · intro i _
    rfl

/-- All colour power sums whose exponents are at least the given cutoff. -/
def colourPowerSumTailIdeal (N : ℕ) : Ideal (ColourPolynomialRing colour) :=
  Ideal.span {p | ∃ c s, N ≤ s ∧ colourPolynomialPowerSum colour c s = p}

/-- Exchanging two positions of the same colour defines a Young-subgroup element. -/
def colourPositionSwap (i j : Fin B) (h : colour i = colour j) :
    positionColourSubgroup colour := by
  classical
  refine ⟨Equiv.swap i j, ?_⟩
  intro l
  by_cases hi : l = i
  · subst l
    simpa using h.symm
  by_cases hj : l = j
  · subst l
    simpa using h
  simp [Equiv.swap_apply_of_ne_of_ne hi hj]

/-- Exchanging unused variables fixes a monomial. -/
theorem monomial_rename_swap_of_zero (d : Fin B →₀ ℕ) (i j : Fin B)
    (hi : d i = 0) (hj : d j = 0) :
    rename (Equiv.swap i j) (monomial d (1 : ℂ)) = monomial d 1 := by
  classical
  rw [rename_monomial]
  apply congrArg (fun u : Fin B →₀ ℕ => monomial u (1 : ℂ))
  ext l
  rw [Finsupp.mapDomain_equiv_apply]
  by_cases hli : l = i
  · subst l
    simp [hi, hj]
  by_cases hlj : l = j
  · subst l
    simp [hi, hj]
  simp [Equiv.swap_apply_of_ne_of_ne hli hlj]

/-- The average of a marked power is independent of its unused position within a colour. -/
theorem colourPolynomialAverage_move_power (d : Fin B →₀ ℕ) (i j : Fin B)
    (hij : colour i = colour j) (hi : d i = 0) (hj : d j = 0) (s : ℕ) :
    colourPolynomialAverage colour (monomial d 1 * X j ^ s) =
      colourPolynomialAverage colour (monomial d 1 * X i ^ s) := by
  have h := finiteActionAverageToFixed_action
    (polynomialPositionAlgebraAction (positionColourSubgroup colour).subtype)
    (colourPositionSwap colour i j hij) (monomial d 1 * X i ^ s)
  change colourPolynomialAverage colour
    (rename (Equiv.swap i j) (monomial d 1 * X i ^ s)) = _ at h
  simpa only [map_mul, map_pow, rename_X, Equiv.swap_apply_left,
    monomial_rename_swap_of_zero d i j hi hj] using h

/-- Averaging a product with a colour power sum expands into its marked-variable terms. -/
theorem colourPolynomialAverage_powerSum_mul (d : Fin B →₀ ℕ) (c : C) (s : ℕ) :
    ∑ j ∈ Finset.univ.filter (fun j => colour j = c),
      colourPolynomialAverage colour (monomial d 1 * X j ^ s) =
        colourPolynomialAverage colour (monomial d 1) *
          colourPolynomialPowerSum colour c s := by
  classical
  rw [← map_sum]
  change colourPolynomialAverage colour
    (∑ j ∈ Finset.univ.filter (fun j => colour j = c), monomial d 1 * X j ^ s) = _
  rw [← Finset.mul_sum]
  exact finiteActionAverageToFixed_mul
    (polynomialPositionAlgebraAction (positionColourSubgroup colour).subtype)
    (colourPolynomialPowerSum colour c s) (monomial d 1)

/-- An averaged monomial with a part above the cutoff belongs to the colour power-sum ideal. -/
theorem colourPolynomialAverage_monomial_mem_tail (N : ℕ) (hN : 0 < N)
    (d : Fin B →₀ ℕ) (i : Fin B) (hi : N ≤ d i) :
    colourPolynomialAverage colour (monomial d 1) ∈ colourPowerSumTailIdeal colour N := by
  classical
  induction hn : d.support.card using Nat.strong_induction_on generalizing d i with
  | h n ih =>
    let a := d.erase i
    let S := Finset.univ.filter (fun j => colour j = colour i)
    let U := S.filter (fun j => a j = 0)
    let T := S.filter (fun j => a j ≠ 0)
    let av := colourPolynomialAverage colour
    let J := colourPowerSumTailIdeal colour N
    have ha : a + Finsupp.single i (d i) = d := by
      ext j
      by_cases hj : j = i <;> simp [a, hj]
    have hs (j : Fin B) (hj : j ∈ T) :
        av (monomial a 1 * X j ^ d i) ∈ J := by
      have haj : a j ≠ 0 := (Finset.mem_filter.mp hj).2
      let b := a + Finsupp.single j (d i)
      have hb : b.support ⊆ a.support := by
        intro l hl
        by_contra hla
        have hlj : l ≠ j := by
          intro he
          subst l
          exact hla (Finsupp.mem_support_iff.mpr haj)
        have hz : b l = 0 := by
          simp [b, Finsupp.notMem_support_iff.mp hla, hlj]
        exact (Finsupp.mem_support_iff.mp hl) hz
      have hlt : b.support.card < n := by
        apply lt_of_le_of_lt (Finset.card_le_card hb)
        rw [show a.support = d.support.erase i from Finsupp.support_erase, ← hn]
        exact Finset.card_erase_lt_of_mem (Finsupp.mem_support_iff.mpr (by omega))
      have hbN : N ≤ b j := by simp only [b, Finsupp.add_apply, Finsupp.single_eq_same]; omega
      simpa only [b, monomial_add_single] using ih b.support.card hlt b j hbN rfl
    have hu (j : Fin B) (hj : j ∈ U) :
        av (monomial a 1 * X j ^ d i) = av (monomial d 1) := by
      obtain ⟨hjS, hj0⟩ := Finset.mem_filter.mp hj
      have hc : colour i = colour j := ((Finset.mem_filter.mp hjS).2).symm
      change colourPolynomialAverage colour _ = colourPolynomialAverage colour _
      rw [colourPolynomialAverage_move_power colour a i j hc (by simp [a]) hj0,
        ← monomial_add_single, ha]
    have hprod : av (monomial a 1) * colourPolynomialPowerSum colour (colour i) (d i) ∈
        J := J.mul_mem_left _ (Ideal.subset_span ⟨colour i, d i, hi, rfl⟩)
    have hsplit :
        (U.card : ℂ) • av (monomial d 1) +
          ∑ j ∈ T, av (monomial a 1 * X j ^ d i) =
            av (monomial a 1) * colourPolynomialPowerSum colour (colour i) (d i) := by
      have hsum := Finset.sum_filter_add_sum_filter_not S (fun j => a j = 0)
        (fun j => av (monomial a 1 * X j ^ d i))
      change (∑ j ∈ U, _) + ∑ j ∈ T, _ = _ at hsum
      rw [Finset.sum_congr rfl hu, Finset.sum_const] at hsum
      rw [← Nat.cast_smul_eq_nsmul ℂ] at hsum
      exact hsum.trans (colourPolynomialAverage_powerSum_mul colour a (colour i) (d i))
    have hmem : (U.card : ℂ) • av (monomial d 1) ∈ J := by
      have hsum := J.sum_mem (fun j hj => hs j hj)
      exact (J.add_mem_iff_left hsum).mp (hsplit ▸ hprod)
    have hcard : (U.card : ℂ) ≠ 0 := by
      apply Nat.cast_ne_zero.mpr
      apply Finset.card_ne_zero.mpr
      exact ⟨i, by simp [U, S, a]⟩
    have hfinal := (J.restrictScalars ℂ).smul_mem (U.card : ℂ)⁻¹ hmem
    simpa only [smul_smul, inv_mul_cancel₀ hcard, one_smul] using hfinal

/-- Averaging the whole coordinate-power ideal gives elements of the colour tail ideal. -/
theorem colourPolynomialAverage_mem_tail (N : ℕ) (hN : 0 < N)
    (p : MvPolynomial (Fin B) ℂ)
    (hp : p ∈ Ideal.span (Set.range fun i : Fin B =>
      (X i : MvPolynomial (Fin B) ℂ) ^ N)) :
    colourPolynomialAverage colour p ∈ colourPowerSumTailIdeal colour N := by
  classical
  let av := colourPolynomialAverage colour
  let J := colourPowerSumTailIdeal colour N
  have hmul : ∀ q, av (q * p) ∈ J := by
    induction hp using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      intro q
      induction q using MvPolynomial.induction_on' with
      | monomial d z =>
        rw [← monomial_add_single]
        have he : (monomial (d + Finsupp.single i N) z : MvPolynomial (Fin B) ℂ) =
            z • monomial (d + Finsupp.single i N) 1 := by
          simp only [smul_monomial, smul_eq_mul, mul_one]
        rw [he, map_smul]
        exact (J.restrictScalars ℂ).smul_mem z
          (colourPolynomialAverage_monomial_mem_tail colour N hN _ i (by simp))
      | add p q hp hq =>
        rw [add_mul, map_add]
        exact J.add_mem hp hq
    | zero => intro q; simpa only [mul_zero, map_zero] using J.zero_mem
    | add x y hx hy ihx ihy =>
      intro q
      rw [mul_add, map_add]
      exact J.add_mem (ihx q) (ihy q)
    | smul a x hx ih =>
      intro q
      change av (q * (a * x)) ∈ J
      rw [← mul_assoc]
      exact ih (q * a)
  simpa only [one_mul] using hmul 1

/-- A block power sum above the cutoff is in the ideal of coordinate powers. -/
theorem colourPolynomialPowerSum_mem_coordinateIdeal (N : ℕ) (c : C) (s : ℕ)
    (hs : N ≤ s) :
    (colourPolynomialPowerSum colour c s).val ∈
      Ideal.span (Set.range fun i : Fin B => (X i : MvPolynomial (Fin B) ℂ) ^ N) := by
  classical
  change (∑ i ∈ Finset.univ.filter (fun i => colour i = c),
    (X i : MvPolynomial (Fin B) ℂ) ^ s) ∈ _
  apply Ideal.sum_mem
  intro i _
  rw [← Nat.sub_add_cancel hs, pow_add]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- Contracting the coordinate-power ideal gives exactly the colour power-sum tail ideal. -/
theorem colourCoordinateIdeal_contract_of_pos (N : ℕ) (hN : 0 < N) :
    (Ideal.span (Set.range fun i : Fin B => (X i : MvPolynomial (Fin B) ℂ) ^ N)).comap
      (ColourPolynomialRing colour).val.toRingHom = colourPowerSumTailIdeal colour N := by
  apply le_antisymm
  · intro p hp
    have h := colourPolynomialAverage_mem_tail colour N hN p.val hp
    have he : colourPolynomialAverage colour p.val = p := by
      apply Subtype.ext
      exact finiteActionAverage_id _ p.val p.property
    rwa [he] at h
  · apply Ideal.span_le.mpr
    rintro p ⟨c, s, hs, rfl⟩
    exact colourPolynomialPowerSum_mem_coordinateIdeal colour N c s hs

/-- At zero cutoff, a nonempty colour class has a nonzero scalar power-sum relation. -/
theorem colourPowerSumTailIdeal_zero (i : Fin B) : colourPowerSumTailIdeal colour 0 = ⊤ := by
  classical
  let S := Finset.univ.filter (fun j => colour j = colour i)
  have he : colourPolynomialPowerSum colour (colour i) 0 =
      (S.card : ℂ) • (1 : ColourPolynomialRing colour) := by
    apply Subtype.ext
    simp [colourPolynomialPowerSum, S, Nat.cast_smul_eq_nsmul]
  have hn : (S.card : ℂ) ≠ 0 := by
    apply Nat.cast_ne_zero.mpr
    exact Finset.card_ne_zero.mpr ⟨i, by simp [S]⟩
  apply (Ideal.eq_top_iff_one _).mpr
  have hm : colourPolynomialPowerSum colour (colour i) 0 ∈
      colourPowerSumTailIdeal colour 0 := Ideal.subset_span ⟨colour i, 0, le_rfl, rfl⟩
  rw [he] at hm
  have hh := ((colourPowerSumTailIdeal colour 0).restrictScalars ℂ).smul_mem
    (S.card : ℂ)⁻¹ hm
  simpa only [smul_smul, inv_mul_cancel₀ hn, one_smul] using hh

/-- The coordinate-power contraction formula includes empty alphabets and zero cutoff. -/
theorem colourCoordinateIdeal_contract (N : ℕ) :
    (Ideal.span (Set.range fun i : Fin B => (X i : MvPolynomial (Fin B) ℂ) ^ N)).comap
      (ColourPolynomialRing colour).val.toRingHom = colourPowerSumTailIdeal colour N := by
  classical
  by_cases hN : 0 < N
  · exact colourCoordinateIdeal_contract_of_pos colour N hN
  have hN0 : N = 0 := by omega
  subst N
  by_cases hB : 0 < B
  · let i : Fin B := ⟨0, hB⟩
    rw [colourPowerSumTailIdeal_zero colour i]
    have he : Ideal.span (Set.range fun i : Fin B =>
        (X i : MvPolynomial (Fin B) ℂ) ^ 0) = ⊤ := by
      apply (Ideal.eq_top_iff_one _).mpr
      exact Ideal.subset_span ⟨i, pow_zero _⟩
    rw [he, Ideal.comap_top]
  · have hB0 : B = 0 := by omega
    subst B
    have he : Ideal.span (Set.range fun i : Fin 0 =>
        (X i : MvPolynomial (Fin 0) ℂ) ^ 0) = ⊥ := by
      simp only [Set.range_eq_empty, Ideal.span_empty]
    have ht : colourPowerSumTailIdeal colour 0 = ⊥ := by
      apply bot_unique
      apply Ideal.span_le.mpr
      rintro _ ⟨c, s, _, rfl⟩
      change colourPolynomialPowerSum colour c s = 0
      apply Subtype.ext
      simp [colourPolynomialPowerSum]
    rw [he, ht]
    ext p
    change p.val = 0 ↔ p = 0
    constructor
    · intro hp
      exact Subtype.ext hp
    · rintro rfl
      rfl

/-- The coordinate-power ideal is preserved by every colour permutation. -/
theorem colourCoordinateIdeal_stable (N : ℕ) (g : positionColourSubgroup colour)
    (p : MvPolynomial (Fin B) ℂ)
    (hp : p ∈ Ideal.span (Set.range fun i : Fin B =>
      (X i : MvPolynomial (Fin B) ℂ) ^ N)) :
    polynomialPositionAlgebraAction (positionColourSubgroup colour).subtype g p ∈
      Ideal.span (Set.range fun i : Fin B => (X i : MvPolynomial (Fin B) ℂ) ^ N) := by
  have hle : Ideal.span (Set.range fun i : Fin B =>
      (X i : MvPolynomial (Fin B) ℂ) ^ N) ≤
      (Ideal.span (Set.range fun i : Fin B =>
        (X i : MvPolynomial (Fin B) ℂ) ^ N)).comap (rename g.val).toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change rename g.val ((X i : MvPolynomial (Fin B) ℂ) ^ N) ∈
      Ideal.span (Set.range fun i : Fin B => (X i : MvPolynomial (Fin B) ℂ) ^ N)
    rw [map_pow, rename_X]
    exact Ideal.subset_span ⟨g.val i, rfl⟩
  exact hle hp

/-- Adding arbitrary invariant relations commutes with the colour tail presentation. -/
theorem colourCoordinateIdeal_contract_sup (N : ℕ)
    (J : Ideal (ColourPolynomialRing colour)) :
    (Ideal.span (Set.range fun i : Fin B => (X i : MvPolynomial (Fin B) ℂ) ^ N) ⊔
      J.map (ColourPolynomialRing colour).val.toRingHom).comap
        (ColourPolynomialRing colour).val.toRingHom = colourPowerSumTailIdeal colour N ⊔ J := by
  rw [finiteActionIdeal_comap_sup_map
    (polynomialPositionAlgebraAction (positionColourSubgroup colour).subtype)
    _ (colourCoordinateIdeal_stable colour N) J, colourCoordinateIdeal_contract colour N]

end

