import VOA.DeligneAudit.LeviTypeA3StepOrbits
import VOA.DeligneAudit.LeviTypeA2CertStepQuotRank

/-! Rank of a filtration step generated by finitely many bounded orbits. -/

namespace VOA.DeligneAudit.A3Sector

noncomputable section

theorem a3_step_quot_rank_of_orbits
    {V : Type} [AddCommGroup V] [Module ℂ V]
    (F T : Submodule ℂ V) (m L : ℕ)
    (O : Fin m → Submodule ℂ V)
    (hT : T = F ⊔ ⨆ j, O j)
    (hfinite : ∀ j, FiniteDimensional ℂ ((O j).map F.mkQ))
    (hrank : ∀ j, Module.finrank ℂ ((O j).map F.mkQ) ≤ L) :
    FiniteDimensional ℂ (T ⧸ F.comap T.subtype) ∧
      Module.finrank ℂ (T ⧸ F.comap T.subtype) ≤ L * m :=
  a2_step_quot_rank_of_orbits F T m L O hT hfinite hrank

end
end VOA.DeligneAudit.A3Sector

#print axioms VOA.DeligneAudit.A3Sector.a3_step_quot_rank_of_orbits
