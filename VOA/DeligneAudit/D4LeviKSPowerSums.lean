import VOA.DeligneAudit.D4LeviKSPairAntipode
import Mathlib.RingTheory.MvPolynomial.Symmetric.NewtonIdentities
import Mathlib.RingTheory.MvPolynomial.Symmetric.FundamentalTheorem

/-! Power sums generate the elementary symmetric shift operators over `ℂ`. -/

namespace VOA.DeligneAudit.D4Levi

open MvPolynomial

/-- The algebra generated by the power sums in a fixed finite set of variables. -/
noncomputable def powerSumAlgebra (σ : Type*) [Fintype σ] :
    Subalgebra ℂ (MvPolynomial σ ℂ) :=
  Algebra.adjoin ℂ (Set.range (fun r : ℕ => psum σ ℂ r))

theorem psum_mem_powerSumAlgebra (σ : Type*) [Fintype σ] (r : ℕ) :
    psum σ ℂ r ∈ powerSumAlgebra σ :=
  Algebra.subset_adjoin ⟨r, rfl⟩

/-- Newton's recurrence expresses each elementary symmetric polynomial as
    a polynomial in the power sums, with rational denominators. -/
theorem esymm_mem_powerSumAlgebra (σ : Type*) [Fintype σ] (k : ℕ) :
    esymm σ ℂ k ∈ powerSumAlgebra σ := by
  let S := powerSumAlgebra σ
  induction k using Nat.strong_induction_on with
  | h k ih =>
      by_cases hk : k = 0
      · subst k
        simp [esymm_zero]
      · have hsum :
            (-1 : MvPolynomial σ ℂ) ^ (k + 1) *
              ∑ a ∈ Finset.antidiagonal k with a.1 < k,
                (-1 : MvPolynomial σ ℂ) ^ a.1 *
                  esymm σ ℂ a.1 * psum σ ℂ a.2 ∈ S := by
          apply S.mul_mem
          · exact S.pow_mem (S.neg_mem S.one_mem) _
          · apply Subalgebra.sum_mem
            intro a ha
            have ha' : a.1 < k := (Finset.mem_filter.mp ha).2
            exact S.mul_mem
              (S.mul_mem (S.pow_mem (S.neg_mem S.one_mem) _) (ih a.1 ha'))
              (psum_mem_powerSumAlgebra σ a.2)
        have hnewton := MvPolynomial.mul_esymm_eq_sum σ ℂ k
        have hscalar : (k : ℂ) • esymm σ ℂ k ∈ S := by
          rw [smul_eq_C_mul, C_eq_coe_nat]
          rw [hnewton]
          exact hsum
        have hinv : (k : ℂ)⁻¹ • ((k : ℂ) • esymm σ ℂ k) ∈ S :=
          S.smul_mem hscalar _
        have hkC : (k : ℂ) ≠ 0 := by exact_mod_cast hk
        simpa [smul_smul, hkC] using hinv

/-- Every symmetric polynomial in finitely many variables belongs to the
    algebra generated by power sums over the complex numbers. -/
theorem symmetric_mem_powerSumAlgebra (σ : Type*) [Fintype σ]
    (p : MvPolynomial σ ℂ)
    (hp : p ∈ symmetricSubalgebra σ ℂ) :
    p ∈ powerSumAlgebra σ := by
  let n := Fintype.card σ
  let S := powerSumAlgebra σ
  let e : Fin n → S := fun i =>
    ⟨esymm σ ℂ (i + 1), esymm_mem_powerSumAlgebra σ (i + 1)⟩
  let lift : MvPolynomial (Fin n) ℂ →ₐ[ℂ] S := aeval e
  obtain ⟨q, hq⟩ :=
    (MvPolynomial.esymmAlgHom_surjective (σ := σ) ℂ (n := n) le_rfl)
      (⟨p, hp⟩ : symmetricSubalgebra σ ℂ)
  have hval : (lift q).val = (esymmAlgHom σ ℂ n q).val := by
    simpa only [lift, e, esymmAlgHom_apply] using
      (Subalgebra.mvPolynomial_aeval_coe S e q).symm
  have hpeq : p = (lift q).val := by
    calc
      p = (esymmAlgHom σ ℂ n q).val := (congrArg Subtype.val hq).symm
      _ = (lift q).val := hval.symm
  change p ∈ S
  rw [hpeq]
  exact (lift q).property

/-- A symmetric shift polynomial preserves any subalgebra condition that is
    preserved by all power-sum shifts. -/
theorem symmetric_image_mem_of_power_sums
    (σ : Type*) [Fintype σ]
    (R : Type*) [CommRing R] [Algebra ℂ R]
    (φ : MvPolynomial σ ℂ →ₐ[ℂ] R) (T : Subalgebra ℂ R)
    (hpower : ∀ r : ℕ, φ (psum σ ℂ r) ∈ T)
    (p : MvPolynomial σ ℂ)
    (hp : p ∈ symmetricSubalgebra σ ℂ) : φ p ∈ T := by
  have hsub : powerSumAlgebra σ ≤ T.comap φ := by
    apply Algebra.adjoin_le
    rintro q ⟨r, rfl⟩
    exact hpower r
  exact hsub (symmetric_mem_powerSumAlgebra σ p hp)

/-- The elements of a commutative shift algebra whose actions preserve a
    specified submodule form a subalgebra. -/
def preservingShiftAlgebra
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (R : Type*) [CommRing R] [Algebra ℂ R]
    (ψ : R →ₐ[ℂ] Module.End ℂ V) (N : Submodule ℂ V) : Subalgebra ℂ R where
  carrier := {r | ∀ v, v ∈ N → ψ r v ∈ N}
  zero_mem' := by
    intro v hv
    simp
  one_mem' := by
    intro v hv
    simpa using hv
  add_mem' := by
    intro a b ha hb v hv
    simpa only [map_add, LinearMap.add_apply] using N.add_mem (ha v hv) (hb v hv)
  mul_mem' := by
    intro a b ha hb v hv
    simpa only [map_mul, Module.End.mul_apply] using ha (ψ b v) (hb v hv)
  algebraMap_mem' := by
    intro c v hv
    simpa only [ψ.commutes, Module.algebraMap_end_apply] using N.smul_mem c hv

/-- Closure under all power-sum shifts implies closure under every symmetric
    shift polynomial on any vector already in the submodule. -/
theorem symmetric_shift_preserves
    {V : Type*} [AddCommGroup V] [Module ℂ V]
    (σ : Type*) [Fintype σ]
    (R : Type*) [CommRing R] [Algebra ℂ R]
    (φ : MvPolynomial σ ℂ →ₐ[ℂ] R)
    (ψ : R →ₐ[ℂ] Module.End ℂ V) (N : Submodule ℂ V)
    (hpower : ∀ r : ℕ, ∀ v ∈ N, ψ (φ (psum σ ℂ r)) v ∈ N)
    (p : MvPolynomial σ ℂ) (hp : p ∈ symmetricSubalgebra σ ℂ)
    (v : V) (hv : v ∈ N) : ψ (φ p) v ∈ N := by
  have hmem : φ p ∈ preservingShiftAlgebra R ψ N :=
    symmetric_image_mem_of_power_sums σ R φ
      (preservingShiftAlgebra R ψ N) hpower p hp
  exact hmem v hv

end VOA.DeligneAudit.D4Levi

