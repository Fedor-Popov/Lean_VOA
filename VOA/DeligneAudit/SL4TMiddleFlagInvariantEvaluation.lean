import VOA.DeligneAudit.SL4TColourElementaryCoordinates
import VOA.DeligneAudit.SL4TMiddleFlagPowerSum
import VOA.DeligneAudit.SL4TMiddleFlagAllTails

/-! Specialization of Young-invariant elementary coordinates to the middle multiplicity ring. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial
open VOA.IteratedBlockSymmetricInvariant VOA.ColoredSymmetricHilbert

/-- Specialize every finite elementary coordinate to its actual middle-flag coefficient. -/
def middleFlagCoordinateEvaluation (q : MixedParams) :
    MvPolynomial (BlockSlots (profileBlocks (middleFlagLength q))) ℂ →ₐ[ℂ] MixedRing q :=
  aeval (fun i =>
    let v := profileBlockSlotEquiv (middleFlagLength q) i
    mixedEvaluation q (middleFlagElementary v.1 (v.2.val + 1)))

/-- All elementary coordinates, including the zero tails, have their prescribed images. -/
theorem middleFlagCoordinateEvaluation_elementary (q : MixedParams) (hq : MixedValid q)
    (c : Fin 4) (s : ℕ) :
    middleFlagCoordinateEvaluation q (colourElementaryCoordinate (middleFlagLength q) c s) =
      mixedEvaluation q (middleFlagElementary c s) := by
  by_cases hs : s = 0
  · subst s
    simp only [colourElementaryCoordinate, dif_pos rfl, map_one]
    fin_cases c <;> simp [middleFlagElementary, mixed_series_zero, mixedE]
  by_cases h : s ≤ middleFlagLength q c
  · rw [colourElementaryCoordinate, dif_neg hs, dif_pos h,
      middleFlagCoordinateEvaluation, aeval_X]
    let v : Σ c : Fin 4, Fin (middleFlagLength q c) := ⟨c, ⟨s - 1, by omega⟩⟩
    have hv := (profileBlockSlotEquiv (middleFlagLength q)).apply_symm_apply v
    refine (congrArg (fun u : Σ c : Fin 4, Fin (middleFlagLength q c) =>
      mixedEvaluation q (middleFlagElementary u.1 (u.2.val + 1))) hv).trans ?_
    congr 2
    change s - 1 + 1 = s
    omega
  · rw [colourElementaryCoordinate, dif_neg hs, dif_neg h, map_zero,
      middleFlagElementary_tail q hq c s (by omega)]

/-- Positive coordinate power sums specialize to the four Cartan tail symbols. -/
theorem middleFlagCoordinateEvaluation_powerSum (q : MixedParams) (hq : MixedValid q)
    (hA : q.A = 0) (c : Fin 4) (s : ℕ) (hs : 1 ≤ s) :
    middleFlagCoordinateEvaluation q (colourPowerSumCoordinate (middleFlagLength q) c s) =
      middleFlagTailSymbols q s c := by
  rw [colourPowerSumCoordinate, powerSumOfCoeff_map]
  simp only [map_mul, map_pow, map_neg, map_one,
    middleFlagCoordinateEvaluation_elementary q hq]
  simp only [← middleFlag_newtonCoeff q hq hA]
  exact powerSumOfCoeff_newtonCoeff _ _ s hs

variable (q : MixedParams) {B : ℕ} (colour : Fin B → Fin 4)
variable (fibres : ∀ c, Fin (middleFlagLength q c) ≃ {i // colour i = c})

/-- Evaluate actual invariant polynomials in the four middle-flag elementary alphabets. -/
def middleFlagInvariantEvaluation : ColourPolynomialRing colour →ₐ[ℂ] MixedRing q :=
  (middleFlagCoordinateEvaluation q).comp
    (colourElementaryPresentation colour (middleFlagLength q) fibres).symm.toAlgHom

/-- Every actual invariant block power sum becomes the corresponding middle-flag symbol. -/
theorem middleFlagInvariantEvaluation_powerSum (hq : MixedValid q) (hA : q.A = 0)
    (c : Fin 4) (s : ℕ) (hs : 1 ≤ s) :
    middleFlagInvariantEvaluation q colour fibres (colourPolynomialPowerSum colour c s) =
      middleFlagTailSymbols q s c := by
  rw [← colourElementaryPresentation_powerSum colour (middleFlagLength q) fibres c s hs]
  simp only [middleFlagInvariantEvaluation, AlgHom.comp_apply, AlgEquiv.coe_algHom,
    AlgEquiv.symm_apply_apply]
  exact middleFlagCoordinateEvaluation_powerSum q hq hA c s hs

/-- The existing all-tail ideal is the ideal generated by every block symbol above the cutoff. -/
theorem middleFlagAllTailIdeal_eq_span (N : ℕ) :
    middleFlagAllTailIdeal q N =
      Ideal.span {p | ∃ c s, N ≤ s ∧ middleFlagTailSymbols q s c = p} := by
  apply le_antisymm
  · apply iSup_le
    intro s
    apply Ideal.span_le.mpr
    rintro p ⟨c, rfl⟩
    exact Ideal.subset_span ⟨c, s.val, s.property, rfl⟩
  · apply Ideal.span_le.mpr
    rintro p ⟨c, s, hs, rfl⟩
    exact middleFlagTailIdeal_le_allTail q N s hs (Ideal.subset_span ⟨c, rfl⟩)

/-- The invariant coordinate-power tail specializes to the actual all-mode multiplicity ideal. -/
theorem middleFlagInvariantEvaluation_tailIdeal (hq : MixedValid q) (hA : q.A = 0)
    (N : ℕ) (hN : 0 < N) :
    (colourPowerSumTailIdeal colour N).map
      (middleFlagInvariantEvaluation q colour fibres).toRingHom = middleFlagAllTailIdeal q N := by
  rw [colourPowerSumTailIdeal, Ideal.map_span, middleFlagAllTailIdeal_eq_span]
  congr 1
  ext p
  constructor
  · rintro ⟨a, ⟨c, s, hs, rfl⟩, rfl⟩
    exact ⟨c, s, hs, (middleFlagInvariantEvaluation_powerSum q colour fibres hq hA c s
      (by omega)).symm⟩
  · rintro ⟨c, s, hs, rfl⟩
    exact ⟨colourPolynomialPowerSum colour c s, ⟨c, s, hs, rfl⟩,
      middleFlagInvariantEvaluation_powerSum q colour fibres hq hA c s (by omega)⟩

/-- Contracting coordinate powers and specializing gives precisely the existing all-tail ideal. -/
theorem middleFlagInvariantEvaluation_contractedCoordinateIdeal
    (hq : MixedValid q) (hA : q.A = 0) (N : ℕ) (hN : 0 < N) :
    ((Ideal.span (Set.range fun i : Fin B =>
      (X i : MvPolynomial (Fin B) ℂ) ^ N)).comap
        (ColourPolynomialRing colour).val.toRingHom).map
          (middleFlagInvariantEvaluation q colour fibres).toRingHom =
            middleFlagAllTailIdeal q N := by
  rw [colourCoordinateIdeal_contract]
  exact middleFlagInvariantEvaluation_tailIdeal q colour fibres hq hA N hN

end

end VOA.DeligneAudit.SL4T

