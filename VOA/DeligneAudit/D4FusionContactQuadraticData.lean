def isNormal (j : Fin 36) : Bool :=
  ([9, 10, 13, 16, 18, 22, 27, 28, 31] : List ℕ).contains j.val

def basis (j k : Fin 36) : ℤ := if j = k then 1 else 0

def normalCoeff (j : Fin 36) (n : Fin 9) : ℤ :=
  (if j = normalColumn n then 1 else 0) -
    if isNormal j then 0 else normalized (pivotRow j) (normalColumn n)

def eliminationRhs (j k : Fin 36) : ℤ :=
  (if isNormal j then 0 else normalized (pivotRow j) k) +
    ∑ n : Fin 9, normalCoeff j n * basis (normalColumn n) k

