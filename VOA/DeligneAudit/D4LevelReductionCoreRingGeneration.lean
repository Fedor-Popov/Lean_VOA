import VOA.DeligneAudit.D4LevelCoreConvertedAudit

/-! The two Grassmannian alphabets are generated by the positive Cartan currents. -/

namespace VOA.DeligneAudit.D4LevelReduction

noncomputable section

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.UnivG

variable {V : Type} [AddCommGroup V] [Module ℂ V]

/-- Newton operators preserve any subspace preserved by their positive Cartan operators. -/
theorem coreNewtonEnd_mem (H : ℕ → Module.End ℂ V) (T : Submodule ℂ V)
    (hT : ∀ s, 0 < s → ∀ v ∈ T, H s v ∈ T) (n : ℕ) {v : V} (hv : v ∈ T) :
    SL4T.newtonEnd H n v ∈ T := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
      cases n with
      | zero => simpa [SL4T.newtonEnd] using hv
      | succ n =>
          simp only [SL4T.newtonEnd, LinearMap.smul_apply, LinearMap.sum_apply,
            Module.End.mul_apply]
          apply T.smul_mem
          apply T.sum_mem
          intro i _
          exact hT _ (by have := i.isLt; omega) _ (ih i.val i.isLt)

/-- Newton reconstruction turns Cartan stability into elementary-coefficient stability. -/
theorem coreElementary_mul_mem {R : Type} [CommRing R] [Algebra ℂ R]
    (H : ℕ → Module.End ℂ V) (π : R →ₗ[ℂ] V) (d : ℕ) (e : ℕ → R)
    (he : e 0 = 1) (T : Submodule ℂ V)
    (hT : ∀ s, 0 < s → ∀ v ∈ T, H s v ∈ T)
    (hH : ∀ s, 0 < s → ∀ φ,
      H s (π φ) = π (SL4T.powerSumOfCoeff d (fun j => (-1) ^ j * e j) s * φ))
    (n : ℕ) {φ : R} (hφ : π φ ∈ T) : π (e n * φ) ∈ T := by
  have h := coreNewtonEnd_mem H T hT n hφ
  rw [SL4T.newtonEnd_pi H π _ hH, SL4T.newtonCoeff_powerSumOfCoeff d _
    (by simp [he])] at h
  have hh := T.smul_mem ((-1 : ℂ) ^ n) h
  have hs : ((-1 : ℂ) ^ n) • π (((-1 : R) ^ n * e n) * φ) = π (e n * φ) := by
    rw [← map_smul]
    congr 1
    simp only [Algebra.smul_def, map_pow, map_neg, map_one]
    rw [← mul_assoc, ← mul_assoc, ← pow_add, ← two_mul, pow_mul]
    simp
  rwa [hs] at hh

/-- Every coefficient vector is in every current-stable subspace containing the unit vector. -/
theorem coreEvaluation_mem_of_stable (Q : CurrentModule A3Sector.bracketTable V)
    (a b c : ℕ) (π : CoreBaseRing a b c →ₗ[ℂ] V)
    (h : CoreCartanAction Q a b c π) (T : Submodule ℂ V)
    (hT : ∀ e r, T ≤ T.comap (Q.op e r)) (hunit : π 1 ∈ T) :
    ∀ φ, π φ ∈ T := by
  have hx (n : ℕ) {φ : CoreBaseRing a b c} (hφ : π φ ∈ T) :
      π (SL4T.rightE (a + b + c) (a + b) a n * φ) ∈ T := by
    apply coreElementary_mul_mem (fun s => Q.op (A3Sector.simpleH 0) s) π a
      (SL4T.rightE (a + b + c) (a + b) a) (by simp [SL4T.rightE, SL4T.eClass]) T
      (fun s _ v hv => hT _ s hv) _ n hφ
    intro s hs φ
    simpa [coreCartanSymbol, coreAdjointPowerSum] using h 0 s hs φ
  have hg (n : ℕ) {φ : CoreBaseRing a b c} (hφ : π φ ∈ T) :
      π (SL4T.leftE (a + b + c) (a + b) a n * φ) ∈ T := by
    apply coreElementary_mul_mem
      (fun s => Q.op (A3Sector.simpleH 1) s + Q.op (A3Sector.simpleH 0) s) π (a + b)
      (SL4T.leftE (a + b + c) (a + b) a) (by simp [SL4T.leftE, SL4T.eClass]) T
      (fun s _ v hv => T.add_mem (hT _ s hv) (hT _ s hv)) _ n hφ
    intro s hs φ
    simp only [LinearMap.add_apply, h 1 s hs φ, h 0 s hs φ, ← map_add, ← add_mul]
    simp [coreCartanSymbol, coreComplementPowerSum]
  intro φ
  obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective φ
  induction P using MvPolynomial.induction_on with
  | C z =>
      change π (algebraMap ℂ (CoreBaseRing a b c) z) ∈ T
      simpa only [Algebra.algebraMap_eq_smul_one, map_smul] using T.smul_mem z hunit
  | add P R hP hR => simpa only [map_add] using T.add_mem hP hR
  | mul_X P t hP =>
      rw [map_mul, mul_comm]
      rcases t with ⟨side, n⟩
      cases side
      · simpa only [SL4T.leftE, SL4T.eClass, SL4T.biLeft_mk, SL4T.elementary_succ,
          SL4T.alphabetIn, MvPolynomial.rename_X] using hg (n + 1) hP
      · simpa only [SL4T.rightE, SL4T.eClass, SL4T.biRight_mk, SL4T.elementary_succ,
          SL4T.alphabetIn, MvPolynomial.rename_X] using hx (n + 1) hP

/-- A core coefficient orbit is contained in the cyclic current module of its unit. -/
theorem coreEvaluation_mem_cyclic (Q : CurrentModule A3Sector.bracketTable V)
    (a b c : ℕ) (π : CoreBaseRing a b c →ₗ[ℂ] V)
    (h : CoreCartanAction Q a b c π) (φ : CoreBaseRing a b c) :
    π φ ∈ cycSubG Q (π 1) :=
  coreEvaluation_mem_of_stable Q a b c π h _ (cycSubG_inv Q (π 1))
    (wordOp_mem_cycSubG Q (π 1) []) φ

end

end VOA.DeligneAudit.D4LevelReduction

#print axioms VOA.DeligneAudit.D4LevelReduction.coreNewtonEnd_mem
#print axioms VOA.DeligneAudit.D4LevelReduction.coreElementary_mul_mem
#print axioms VOA.DeligneAudit.D4LevelReduction.coreEvaluation_mem_of_stable
#print axioms VOA.DeligneAudit.D4LevelReduction.coreEvaluation_mem_cyclic
