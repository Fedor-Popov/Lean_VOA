import VOA.DeligneAudit.SL4TMixedBoundaryProjection
import VOA.DeligneAudit.SL4TMiddleFlagPowerSum

/-! Characteristic polynomial lifts for removing one or two flag-block roots. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open Polynomial

/-- Reflection respects a product when the reflection degrees are added. -/
theorem reflect_prod_sum_degrees {R ι : Type*} [CommRing R] (s : Finset ι)
    (f : ι → R[X]) (d : ι → ℕ) (h : ∀ i ∈ s, (f i).natDegree ≤ d i) :
    (∏ i ∈ s, f i).reflect (∑ i ∈ s, d i) = ∏ i ∈ s, (f i).reflect (d i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      rw [Finset.prod_insert hi, Finset.sum_insert hi, Finset.prod_insert hi,
        reflect_mul _ _ (h i (by simp))
          ((natDegree_prod_le _ _).trans (Finset.sum_le_sum
            (fun j hj => h j (Finset.mem_insert_of_mem hj)))),
        ih (fun j hj => h j (Finset.mem_insert_of_mem hj))]

/-- The four characteristic polynomials factor the pure power of the number of sites. -/
theorem middleFlagPolynomial_product (q : MixedParams) (hq : MixedValid q)
    (hA : q.A = 0) : ∏ i : Fin 4, middleFlagPolynomial q i = X ^ q.B.toNat := by
  unfold middleFlagPolynomial
  rw [← reflect_prod_sum_degrees Finset.univ (middleFlagCoefficientPolynomial q)
    (middleFlagLength q) (fun i _ => coefficientPoly_degree _ _),
    middleFlagCoefficientPolynomial_product q hq hA, middleFlagLength_sum q hq hA]
  simp

/-- The signed constant coefficient is a unit times the flag top. -/
theorem middleFlagPolynomial_constant (q : MixedParams) (i : Fin 4) :
    (middleFlagPolynomial q i).coeff 0 =
      (-1) ^ middleFlagLength q i * middleFlagTop q (mixedBOrder i) := by
  change (descendingPoly _ _).coeff 0 = _
  rw [descendingPoly_constant]
  fin_cases i <;> rfl

/-- A state boundary is generated by its characteristic constant coefficient. -/
theorem middleFlag_stateIdeal_constant (q : MixedParams) (hq : MixedValid q)
    (hA : q.A = 0) (i : Fin 4) :
    mixedBStateIdeal q (mixedBOrder i) =
      Ideal.span {(middleFlagPolynomial q i).coeff 0} := by
  rw [middleFlag_stateIdeal q hq hA, middleFlagPolynomial_constant,
    Ideal.span_singleton_mul_left_unit (isUnit_neg_one.pow _)]

/-- Removing a flag root decreases precisely its own block length. -/
theorem middleFlagLength_next (q : MixedParams) (hq : MixedValid q) (i k : Fin 4)
    (hs : MixedValid (mixedBNext q (mixedBOrder i))) :
    middleFlagLength q k = middleFlagLength (mixedBNext q (mixedBOrder i)) k +
      if k = i then 1 else 0 := by
  fin_cases i <;> fin_cases k <;>
    simp [middleFlagLength, mixedBOrder, mixedBNext, mixedP, mixedQ,
      MixedValid] at hq hs ⊢ <;> omega

/-- Each flag characteristic maps to the reduced characteristic with its removed zero root. -/
theorem middleFlagPolynomial_map_projection (q : MixedParams) (hq : MixedValid q)
    (i k : Fin 4) (hs : MixedValid (mixedBNext q (mixedBOrder i))) :
    (middleFlagPolynomial q k).map (mixedBProjection q hq (mixedBOrder i) hs).toRingHom =
      X ^ (if k = i then 1 else 0) *
        middleFlagPolynomial (mixedBNext q (mixedBOrder i)) k := by
  change (descendingPoly _ _).map _ = _ * descendingPoly _ _
  simp only [descendingPoly_map, map_mul, map_pow, map_neg, map_one,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, mixedBProjection_evaluation]
  have hl := middleFlagLength_next q hq i k hs
  by_cases hk : k = i
  · simp only [hk, if_true, pow_one] at hl ⊢
    apply descendingPoly_remove_zero_root _ _ _ hl
    rw [middleFlagElementary_tail _ hs i _ (by omega), mul_zero]
  · simp only [hk, if_false, add_zero, pow_zero, one_mul] at hl ⊢
    rw [hl]

/-- A coefficientwise homomorphism commutes with division by the polynomial variable. -/
theorem polynomial_map_divX {R S : Type*} [CommRing R] [CommRing S]
    (ρ : R →+* S) (p : R[X]) : p.divX.map ρ = (p.map ρ).divX := by
  ext n : 1
  simp only [coeff_map, coeff_divX]

/-- The polynomial lift after a single root has been removed. -/
def middleFlagRemovedPolynomial (q : MixedParams) (i k : Fin 4) : (MixedRing q)[X] :=
  if k = i then (middleFlagPolynomial q k).divX else middleFlagPolynomial q k

/-- The chosen polynomial lift maps exactly to the reduced block characteristic. -/
theorem middleFlagRemovedPolynomial_map (q : MixedParams) (hq : MixedValid q)
    (i k : Fin 4) (hs : MixedValid (mixedBNext q (mixedBOrder i))) :
    (middleFlagRemovedPolynomial q i k).map
        (mixedBProjection q hq (mixedBOrder i) hs).toRingHom =
      middleFlagPolynomial (mixedBNext q (mixedBOrder i)) k := by
  have hp := middleFlagPolynomial_map_projection q hq i k hs
  by_cases hk : k = i
  · simp only [hk, if_true, pow_one] at hp
    rw [middleFlagRemovedPolynomial, if_pos hk]
    simpa only [hk] using polynomial_map_divX_of_zero_root
      (mixedBProjection q hq (mixedBOrder i) hs) _ _ hp
  · simpa only [middleFlagRemovedPolynomial, hk, if_false, pow_zero, one_mul] using hp

/-- The polynomial lift after two roots, allowing both to belong to the same block. -/
def middleFlagTwiceRemovedPolynomial (q : MixedParams) (i j k : Fin 4) :
    (MixedRing q)[X] :=
  if k = j then (middleFlagRemovedPolynomial q i k).divX else
    middleFlagRemovedPolynomial q i k

/-- Composing the boundary projections realizes the explicit two-root characteristic lift. -/
theorem middleFlagTwiceRemovedPolynomial_map (q : MixedParams) (hq : MixedValid q)
    (i j k : Fin 4) (hi : MixedValid (mixedBNext q (mixedBOrder i)))
    (hj : MixedValid (mixedBNext (mixedBNext q (mixedBOrder i)) (mixedBOrder j))) :
    (middleFlagTwiceRemovedPolynomial q i j k).map
        ((mixedBProjection (mixedBNext q (mixedBOrder i)) hi (mixedBOrder j) hj).comp
          (mixedBProjection q hq (mixedBOrder i) hi)).toRingHom =
      middleFlagPolynomial
        (mixedBNext (mixedBNext q (mixedBOrder i)) (mixedBOrder j)) k := by
  change Polynomial.map
    ((mixedBProjection (mixedBNext q (mixedBOrder i)) hi (mixedBOrder j) hj).toRingHom.comp
      (mixedBProjection q hq (mixedBOrder i) hi).toRingHom) _ = _
  rw [← Polynomial.map_map]
  have he : (middleFlagTwiceRemovedPolynomial q i j k).map
      (mixedBProjection q hq (mixedBOrder i) hi).toRingHom =
      middleFlagRemovedPolynomial (mixedBNext q (mixedBOrder i)) j k := by
    by_cases hk : k = j
    · simp only [middleFlagTwiceRemovedPolynomial, middleFlagRemovedPolynomial, hk,
        if_true]
      rw [polynomial_map_divX]
      have h := middleFlagRemovedPolynomial_map q hq i j hi
      simpa only [middleFlagRemovedPolynomial, hk] using congrArg Polynomial.divX h
    · rw [middleFlagTwiceRemovedPolynomial, if_neg hk,
        middleFlagRemovedPolynomial_map q hq i k hi, middleFlagRemovedPolynomial, if_neg hk]
  rw [he]
  exact middleFlagRemovedPolynomial_map _ hi j k hj

end

end VOA.DeligneAudit.SL4T

