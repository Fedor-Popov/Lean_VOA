theorem e7_letters (i : ℕ) (hi : i < 7) :
    ∀ φ ∈ e7CorootOrbit, reflFunFin 7 cartanE7 i φ ∈ e7CorootOrbit := by
  interval_cases i <;> decide +kernel

theorem e7_theta : ∀ φ ∈ e7CorootOrbit, reflFunTheta 7 cartanE7 thetaE7 φ ∈ e7CorootOrbit := by
  decide +kernel

theorem e7OrbitData : OrbitData 7 cartanE7 thetaE7 wordE7 e7CorootOrbit :=
  OrbitData.of_letters rfl (by decide) e7_letters e7_theta (by decide +kernel) (by decide +kernel)

/-- **`E₇` Demazure energies are nonnegative.** -/
theorem e7DemazureEnergy (m : ℕ) :
    ∀ t ∈ demazureChar cartanE7 thetaE7 wordE7 m, 0 ≤ t.1.2 + (m : ℤ) * m :=
  energy_of_orbit e7OrbitData m

end VOA.DeligneAudit.DeligneCharacter.DemCount

section AxiomAudit
#print axioms VOA.DeligneAudit.DeligneCharacter.DemCount.e7DemazureEnergy
end AxiomAudit
