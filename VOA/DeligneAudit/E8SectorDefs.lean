import VOA.DeligneAudit.E8LieTable
import VOA.DeligneAudit.E8CarrierTables
import VOA.DeligneAudit.E7Quad
import VOA.DeligneAudit.E6SectorDefs

/-!
# Computable data for the `E₈` sector checks (light imports, generated)

* `e8T`: the `SCLie` table of the cert structure constants of `𝔢₈` (literal rows, fast kernel lookups);
  it agrees with `E8Lie.sL` (`rowLinkOK`, checked in `E8SectorLink*`);
* `wtL`: the cert weights as literal lists (agreeing with `E8Lie.wt`, `wtLinkOK`);
* `Pq s`: the quadratics of `I₂ = I₂ⁿˢ ⊕ ℂQ` (`s < 3875` a relation, `s = 3875` the Casimir);
* `stabRowOK g r c`: the certificate `L · ad_g P_r = Σ λ P_s` (the `adS`, checked by
  `E7Sparse.quadZero`).

Port of the `E7SectorDefs` (generator `Notes/deligne/campaign/generators/e8_gen_sector.py`).
-/

namespace VOA.DeligneAudit.DeligneCarrier.E8

open VOA.DeligneAudit.E7Sparse VOA.DeligneAudit.E6SectorSparse VOA.AffineGeneral.SCLie

set_option linter.style.longLine false
set_option linter.style.setOption false
set_option maxHeartbeats 4000000
set_option maxRecDepth 100000

