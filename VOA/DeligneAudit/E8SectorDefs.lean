def pairsOf : List ℕ → List (ℤ × ℕ)
  | z :: s :: rest => (E7Sparse.decZ z, s) :: pairsOf rest
  | _ => []

/-- One stability certificate. -/
def stabRowOK (g r : ℕ) (c : List ℕ) : Bool :=
  decide (certL c ≠ 0) && (pairsOf c.tail).all (fun p => p.2 ≤ 3875) &&
    quadZero (scaleQ (certL c) (adS e8T g (Pq r)) ++
      scaleQ (-1) ((pairsOf c.tail).flatMap fun p => scaleQ p.1 (Pq p.2)))

/-- Certificates `lo ≤ r < hi` of a generator; `rows` lists the certificates of this range only. -/
def stabPart (g : ℕ) (rows : List (List ℕ)) (lo hi : ℕ) : Bool :=
  (List.range' lo (hi - lo)).all fun r => stabRowOK g r (rows.getD (r - lo) [])

end VOA.DeligneAudit.DeligneCarrier.E8
