import VOA.DeligneAudit.D4LevelReductionSupport

/-! The top edge of each D4 vector-node layer, generated by pure adjoint letters. -/

namespace VOA.DeligneAudit.D4LevelReduction

open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4
open VOA.DeligneAudit.D4Levi

/-- A pure adjoint-letter key with prescribed length and current degree. -/
def adjointLetterKey (a d : ℕ) : RadicalKey := ⟨0, a, 0, 0, 0, 0, d⟩

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule D4sector.f V) (w : V)

/-- No key lies strictly above the edge with zero central count. -/
theorem levelFiltration_eq_bot_above_adjoint_edge (m : ℕ) (κ p : ℤ)
    (h : 2 * (m : ℤ) < p + κ) : levelFiltration ρ w m κ p = ⊥ := by
  apply eq_bot_iff.mpr
  apply iSup_le
  intro k
  apply iSup_le
  intro _
  apply iSup_le
  intro hκ
  apply iSup_le
  intro hp
  have := keyAlphaGrade_add_leviLevel_le m k
  omega

/-- On the edge, a key without a vanishing first-root letter is a pure adjoint key. -/
theorem key_eq_adjointLetterKey_on_edge (m a : ℕ) (k : RadicalKey)
    (hκ : keyAlphaGrade m k = (m : ℤ) - a)
    (hp : (m : ℤ) + a ≤ keyLeviLevel m k) (he : k.e = 0) :
    k = adjointLetterKey a k.degree := by
  have hsum := keyAlphaGrade_add_leviLevel_le m k
  simp only [keyAlphaGrade, keyLeviLevel, keyDepth, Nat.cast_add] at hκ hp hsum
  have hx : k.x = a := by omega
  have hu : k.u = 0 := by omega
  have hup : k.up = 0 := by omega
  have hy : k.y = 0 := by omega
  have hz : k.z = 0 := by omega
  cases k
  simp_all [adjointLetterKey]

/-- The edge filtration is exactly the sum of the pure adjoint-letter Levi orbits. -/
theorem adjointEdge_eq_iSup_keyOrbit (m a : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    levelFiltration ρ w m ((m : ℤ) - a) ((m : ℤ) + a) =
      ⨆ d : ℕ, keyOrbit ρ w (adjointLetterKey a d) := by
  apply le_antisymm
  · apply iSup_le
    intro k
    apply iSup_le
    intro _
    apply iSup_le
    intro hκ
    apply iSup_le
    intro hp
    by_cases he : k.e = 0
    · have hk := key_eq_adjointLetterKey_on_edge m a k hκ hp he
      exact le_iSup_of_le k.degree (by conv_lhs => rw [hk])
    · rw [keyOrbit_eq_bot_of_keyLayer_bot ρ w k
        (keyLayer_eq_bot_of_E ρ w m h k (Nat.pos_of_ne_zero he))]
      exact bot_le
  · apply iSup_le
    intro d
    apply keyOrbit_le_levelFiltration_of_sat ρ w m h
    · simp [keyAlphaGrade, keyDepth, adjointLetterKey]
    · simp [keyLeviLevel, adjointLetterKey]

/-- The next term above an adjoint edge is zero. -/
theorem adjointEdge_next_eq_bot (m a : ℕ) :
    levelFiltration ρ w m ((m : ℤ) - a) ((m : ℤ) + a + 1) = ⊥ := by
  exact levelFiltration_eq_bot_above_adjoint_edge ρ w m _ _ (by omega)

/-- The coinvariant relations on the adjoint edge are exactly the high Levi images. -/
theorem adjointEdge_relations_eq_currentTail (m a : ℕ) :
    levelFiltration ρ w m ((m : ℤ) - a) ((m : ℤ) + a + 1) ⊔
      currentTail ρ (levelFiltration ρ w m ((m : ℤ) - a) ((m : ℤ) + a))
        {c | IsLevi c} m =
      currentTail ρ (levelFiltration ρ w m ((m : ℤ) - a) ((m : ℤ) + a))
        {c | IsLevi c} m := by
  rw [adjointEdge_next_eq_bot, bot_sup_eq]

/-- More adjoint letters than the highest-root multiplicity annihilate the source. -/
theorem adjointKey_eq_bot_of_overfull (m a d : ℕ) (ha : m < a)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    keyLayer ρ w (adjointLetterKey a d) = ⊥ := by
  apply eq_bot_iff.mpr
  rw [keyLayer, Submodule.span_le]
  rintro v ⟨l, hl, rfl⟩
  have hx := congrArg RadicalKey.x hl
  have hx' : l.countP (fun p => p.1 = 1) = a := hx
  have hz := radicalWord_zero_of_count ρ w m h 1 l
    (by simpa [rootWeight, hx'] using ha)
  rw [hz]
  exact Submodule.zero_mem _

/-- Edge levels with negative exterior-square label vanish for every multiplicity. -/
theorem adjointEdge_eq_bot_of_overfull (m a : ℕ) (ha : m < a)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    levelFiltration ρ w m ((m : ℤ) - a) ((m : ℤ) + a) = ⊥ := by
  rw [adjointEdge_eq_iSup_keyOrbit ρ w m a h]
  apply eq_bot_iff.mpr
  apply iSup_le
  intro d
  rw [keyOrbit_eq_bot_of_keyLayer_bot ρ w (adjointLetterKey a d)
    (adjointKey_eq_bot_of_overfull ρ w m a d ha h)]

end VOA.DeligneAudit.D4LevelReduction

