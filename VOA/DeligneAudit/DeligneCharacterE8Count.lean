theorem e8_good : Good 8 E8L.e8P57 := by
  have h := (toR1_demazureChar (r := 8) cartanE8 thetaE8 rfl wordE8 1).2
  rwa [e8_char_one] at h

theorem e8_nodup : E8L.e8P57.Nodup := E8L.e8_nodupL

theorem e8_memθ : memCheck (reflZero cartanE8 thetaE8) E8L.e8P57 = true := by
  rw [← memCheckL_eq, ← reflZeroL_eq, ← cartanE8L_eq, ← thetaE8L_eq]; exact E8L.e8_memθL

theorem e8_memFin (i : ℕ) (hi : i ∈ wordE8) : memCheck (reflFin cartanE8 i) E8L.e8P57 = true := by
  have : i < 8 := by revert i; decide
  rw [← memCheckL_eq, ← reflFinL_eq, ← cartanE8L_eq]
  interval_cases i
  · exact E8L.e8_mem0L
  · exact E8L.e8_mem1L
  · exact E8L.e8_mem2L
  · exact E8L.e8_mem3L
  · exact E8L.e8_mem4L
  · exact E8L.e8_mem5L
  · exact E8L.e8_mem6L
  · exact E8L.e8_mem7L

theorem e8_total_one : (E8L.e8P57.map (·.2)).sum = 249 := by
  decide +kernel

/-- **`E₈`: the total multiplicity of `D(1, mθ)` is `249^m`.** -/
theorem e8_demazure_total (m : ℕ) :
    ((demazureChar cartanE8 thetaE8 wordE8 m).map (·.2)).sum = 249 ^ m := by
  have hinv := inv_of_memChecks cartanE8 thetaE8 rfl wordE8 _ e8_good e8_nodup
    (by decide) (by decide) e8_memθ e8_memFin
  rw [← e8_char_one] at hinv
  rw [demazureChar_total (r := 8) cartanE8 thetaE8 rfl wordE8
    (alpha_ne_zero_of cartanE8 thetaE8 wordE8 (by decide) ⟨⟨0, by omega⟩, by decide⟩) hinv m,
    e8_char_one, e8_total_one]

