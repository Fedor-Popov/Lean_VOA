import VOA.DeligneAudit.LeviTypeA3GradedInductionFinal

/-!
The universal truncated sl₄ current module at weight `(a, b, a)` and cutoff `a + b`.
The precise dimension target is recorded separately from the proved local Weyl bound.
-/

namespace VOA.DeligneAudit.SL4T

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.UnivG

noncomputable section

/-- Local Weyl relations and the vanishing of every current at or above the cutoff. -/
def truncatedWeylSpec (weight : Fin 3 → ℕ) (M : ℕ) : RelSpec 15 where
  tails := {t |
    (∃ e : Fin 15, ∃ s, e.val < 6 ∧ t = [(e, s)]) ∨
    (∃ i : Fin 3, ∃ s, 0 < s ∧ t = [(A3Sector.simpleH i, s)]) ∨
    (∃ i : Fin 3, t = List.replicate (weight i + 1) (A3Sector.simpleF i, 0)) ∨
    (∃ x : Fin 15, ∃ s, M ≤ s ∧ t = [(x, s)])}
  eig := {p | ∃ i : Fin 3, p = (A3Sector.simpleH i, (weight i : ℂ))}

/-- The presentation has exactly the usual local Weyl and current truncation relations. -/
theorem truncatedWeylSpec_sat_iff {V : Type} [AddCommGroup V] [Module ℂ V]
    (ρ : CurrentModule A3Sector.bracketTable V) (w : V)
    (weight : Fin 3 → ℕ) (M : ℕ) :
    Sat A3Sector.bracketTable ρ w (truncatedWeylSpec weight M) ↔
      A3Sector.LocalWeylRel ρ w weight ∧ ∀ x s, M ≤ s → ρ.op x s w = 0 := by
  constructor
  · intro h
    refine ⟨⟨?_, ?_, ?_, ?_⟩, ?_⟩
    · intro e he s
      exact h.tail [(e, s)] (Or.inl ⟨e, s, he, rfl⟩)
    · intro i s hs
      exact h.tail _ (Or.inr (Or.inl ⟨i, s, hs, rfl⟩))
    · intro i
      exact h.eig _ ⟨i, rfl⟩
    · intro i
      rw [iterate_eq_wordOpG]
      exact h.tail _ (Or.inr (Or.inr (Or.inl ⟨i, rfl⟩)))
    · intro x s hs
      exact h.tail _ (Or.inr (Or.inr (Or.inr ⟨x, s, hs, rfl⟩)))
  · rintro ⟨h, ht⟩
    constructor
    · intro t ht'
      rcases ht' with ⟨e, s, he, rfl⟩ | ⟨i, s, hs, rfl⟩ |
        ⟨i, rfl⟩ | ⟨x, s, hs, rfl⟩
      · exact h.raising e he s
      · exact h.cartan_pos i s hs
      · rw [← iterate_eq_wordOpG]
        exact h.lowering i
      · exact ht x s hs
    · rintro p ⟨i, rfl⟩
      exact h.cartan_zero i

/-- Truncation at a cyclic generator kills the same current ideal on its cyclic module. -/
theorem current_truncation_on_cyclic {n : ℕ}
    {f : Fin n → Fin n → Fin n → ℂ} {V : Type} [AddCommGroup V] [Module ℂ V]
    (ρ : CurrentModule f V) (w : V) (M : ℕ)
    (ht : ∀ x s, M ≤ s → ρ.op x s w = 0) :
    ∀ v ∈ cycSubG ρ w, ∀ x s, M ≤ s → ρ.op x s v = 0 := by
  have hw : ∀ l : List (Ltr n), ∀ x s, M ≤ s →
      ρ.op x s (wordOp ρ l w) = 0 := by
    intro l
    induction l with
    | nil => exact ht
    | cons y l ih =>
      intro x s hs
      have hc := ρ.comm x y.1 s y.2 (wordOp ρ l w)
      rw [ih x s hs, map_zero, sub_zero] at hc
      change ρ.op x s (ρ.op y.1 y.2 (wordOp ρ l w)) = 0
      rw [hc]
      apply Finset.sum_eq_zero
      intro z _
      rw [ih z (s + y.2) (by omega), smul_zero]
  intro v hv
  induction hv using Submodule.span_induction with
  | mem v hv => obtain ⟨l, rfl⟩ := hv; exact hw l
  | zero => simp
  | add u v _ _ hu hv => intro x s hs; simp [hu x s hs, hv x s hs]
  | smul c v _ hv => intro x s hs; simp [hv x s hs]

/-- Every universally presented current module is generated by its empty word. -/
theorem presentedCurrent_cyclic {n : ℕ} (f : Fin n → Fin n → Fin n → ℂ)
    (R : RelSpec n) : cycSubG (univRepG f R) (wUG f R) = ⊤ := by
  apply top_unique
  intro v hv
  clear hv
  induction v using Submodule.Quotient.induction_on with
  | H x =>
    induction x using Finsupp.induction_linear with
    | zero => exact Submodule.zero_mem _
    | add x y hx hy =>
      exact Submodule.add_mem _ hx hy
    | single l c =>
      have he : Finsupp.single l c = c • UnivG.sw l := by simp [UnivG.sw]
      rw [he, Submodule.Quotient.mk_smul, ← wordOp_univG]
      exact Submodule.smul_mem _ c (wordOp_mem_cycSubG _ _ l)

/-- The universal current module with symmetric outer labels. -/
abbrev MixedLabelModule (a b : ℕ) :=
  UModG A3Sector.bracketTable (truncatedWeylSpec (A3Sector.weightABC a b a) (a + b))

/-- The all-label truncated rank assertion, including zero labels. -/
def MixedLabelTruncatedRank : Prop :=
  ∀ a b : ℕ, FiniteDimensional ℂ (MixedLabelModule a b) ∧
    Module.finrank ℂ (MixedLabelModule a b) ≤ 15 ^ a * 6 ^ b

/-- The existing local Weyl theorem supplies finiteness and the untruncated upper bound. -/
theorem mixedLabelModule_finite_and_local_bound (a b : ℕ) :
    FiniteDimensional ℂ (MixedLabelModule a b) ∧
      Module.finrank ℂ (MixedLabelModule a b) ≤ 4 ^ a * 6 ^ b * 4 ^ a := by
  let R := truncatedWeylSpec (A3Sector.weightABC a b a) (a + b)
  have hw := ((truncatedWeylSpec_sat_iff _ _ _ _).mp
    (univG_sat A3Sector.bracketTable R)).1
  obtain ⟨hf, hr⟩ := A3Sector.a3_all_weight_rank
    (univRepG A3Sector.bracketTable R) (wUG A3Sector.bracketTable R) a b a hw
  rw [presentedCurrent_cyclic] at hf hr
  haveI : FiniteDimensional ℂ (⊤ : Submodule ℂ (MixedLabelModule a b)) := hf
  haveI : FiniteDimensional ℂ (MixedLabelModule a b) :=
    Module.Finite.of_surjective (Submodule.topEquiv.toLinearMap) (Submodule.topEquiv.surjective)
  exact ⟨inferInstance, by simpa only [finrank_top] using hr⟩

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.truncatedWeylSpec_sat_iff
#print axioms VOA.DeligneAudit.SL4T.current_truncation_on_cyclic
#print axioms VOA.DeligneAudit.SL4T.presentedCurrent_cyclic
#print axioms VOA.DeligneAudit.SL4T.mixedLabelModule_finite_and_local_bound
