import VOA.DeligneAudit.D4FusionToroidalPresentedTwoLayerLowering

/-! Cyclic subspaces generated by the two surviving u-degree-one letters. -/

namespace VOA.DeligneAudit.Toroidal

open VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneSector.D4

noncomputable section

def twoM (s : ℕ) : Submodule ℂ (PTE 2) :=
  Submodule.span ℂ {v | ∃ l, twoUDeg l = 0 ∧
    v = wordOpT (ρPTE 2) l ((ρPTE 2).op D4sector.c₀ 1 s (pTE 2))}

def twoPositiveSpan : Submodule ℂ (PTE 2) := twoM 0 ⊔ twoM 1

theorem twoM_word (s : ℕ) (l : List (TLtr 28)) (hl : twoUDeg l = 0) :
    wordOpT (ρPTE 2) l ((ρPTE 2).op D4sector.c₀ 1 s (pTE 2)) ∈ twoM s :=
  Submodule.subset_span ⟨l, hl, rfl⟩

theorem twoM_op_zero (s : ℕ) (c : Fin 28) (r : ℕ) :
    twoM s ≤ (twoM s).comap ((ρPTE 2).op c 0 r) := by
  rw [twoM, Submodule.span_le]
  rintro v ⟨l, hl, rfl⟩
  change wordOpT (ρPTE 2) ((c, 0, r) :: l)
    ((ρPTE 2).op D4sector.c₀ 1 s (pTE 2)) ∈ twoM s
  exact twoM_word s _ (by simp only [twoUDeg]; omega)

theorem twoPositiveSpan_op_zero (c : Fin 28) (r : ℕ) :
    twoPositiveSpan ≤ twoPositiveSpan.comap ((ρPTE 2).op c 0 r) := by
  rw [twoPositiveSpan, sup_le_iff]
  constructor
  · exact (twoM_op_zero 0 c r).trans (Submodule.comap_mono le_sup_left)
  · exact (twoM_op_zero 1 c r).trans (Submodule.comap_mono le_sup_right)

theorem twoM_zero_mem :
    (ρPTE 2).op D4sector.c₀ 1 0 (pTE 2) ∈ twoPositiveSpan := by
  exact (show twoM 0 ≤ twoPositiveSpan from le_sup_left)
    (twoM_word 0 [] rfl)

theorem twoM_one_mem :
    (ρPTE 2).op D4sector.c₀ 1 1 (pTE 2) ∈ twoPositiveSpan := by
  exact (show twoM 1 ≤ twoPositiveSpan from le_sup_right)
    (twoM_word 1 [] rfl)

end

end VOA.DeligneAudit.Toroidal

