import VOA.DeligneAudit.SL4TFullFlagInvariantCount

/-!
# Marked full-flag rings

The roots of a marked full flag are indexed by `Fin n`. A finset `V` of positions is the
second group of roots; its complement `Vᶜ` is the first group `U`. Every ring below contains the
positive elementary symmetric functions of all roots.

* The doubly marked ring: the products of `U` and of `V` vanish, every root has cutoff `h + 1`,
  and the power sums of `V` vanish from `max h 1` on.
* The singly marked ring: the product of `V` vanishes, the roots of `U` have cutoff `h` and the
  roots of `V` have cutoff `h + 1`.
* The weak ring: the product of `V` vanishes, every root has cutoff `h + 1`, and the power sums
  of `V` vanish from `max h 1` on.

All three are instances of one generic ideal (`markedFlagIdeal`). Its universal property
(`markedFlagIdeal_le_ker`) and the relations satisfied by its quotient roots are proved here,
together with finite-dimensionality and a dimension comparison for algebras generated by roots
that satisfy the relations of a presented quotient.
-/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open MvPolynomial

/-- The product of the roots in a group of positions. -/
def flagGroupProduct {n : ℕ} (S : Finset (Fin n)) : MvPolynomial (Fin n) ℂ :=
  ∏ i ∈ S, X i

/-- The power sum of the roots in a group of positions. -/
def flagGroupPowerSum {n : ℕ} (S : Finset (Fin n)) (s : ℕ) : MvPolynomial (Fin n) ℂ :=
  ∑ i ∈ S, X i ^ s

/-- The generic marked full-flag ideal: the positive elementary symmetric functions, the products
of the marked groups, an individual power cutoff for every root, and the power sums of one group
from a threshold on. -/
def markedFlagIdeal (n : ℕ) (marked : Set (Finset (Fin n))) (cut : Fin n → ℕ)
    (tail : Finset (Fin n)) (L : ℕ) : Ideal (MvPolynomial (Fin n) ℂ) :=
  fullFlagSymmetricIdeal n ⊔ Ideal.span (flagGroupProduct '' marked) ⊔
    Ideal.span (Set.range fun i => (X i : MvPolynomial (Fin n) ℂ) ^ cut i) ⊔
      Ideal.span {p | ∃ s, L ≤ s ∧ flagGroupPowerSum tail s = p}

/-- The doubly marked full-flag ideal: both groups marked, common cutoff `h + 1`, and the power
sums of `V` from `max h 1` on. -/
def doublyMarkedFlagIdeal (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :
    Ideal (MvPolynomial (Fin n) ℂ) :=
  markedFlagIdeal n {Vᶜ, V} (fun _ => h + 1) V (max h 1)

/-- The cutoffs of the singly marked ring: `h + 1` on the marked group `V`, `h` on `U`. -/
def singlyMarkedCutoff {n : ℕ} (V : Finset (Fin n)) (h : ℕ) (i : Fin n) : ℕ :=
  if i ∈ V then h + 1 else h

/-- The singly marked full-flag ideal: the group `V` marked, cutoff `h` on `U` and `h + 1` on
`V`. -/
def singlyMarkedFlagIdeal (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :
    Ideal (MvPolynomial (Fin n) ℂ) :=
  markedFlagIdeal n {V} (singlyMarkedCutoff V h) ∅ 0

/-- The weak full-flag ideal: the group `V` marked, the group `U` without a product relation,
common cutoff `h + 1`, and the power sums of `V` from `max h 1` on. -/
def weakMarkedFlagIdeal (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :
    Ideal (MvPolynomial (Fin n) ℂ) :=
  markedFlagIdeal n {V} (fun _ => h + 1) V (max h 1)

/-- The doubly marked full-flag ring. -/
abbrev DoublyMarkedFlagRing (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :=
  MvPolynomial (Fin n) ℂ ⧸ doublyMarkedFlagIdeal n V h

/-- The singly marked full-flag ring. -/
abbrev SinglyMarkedFlagRing (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :=
  MvPolynomial (Fin n) ℂ ⧸ singlyMarkedFlagIdeal n V h

/-- The weak full-flag ring. -/
abbrev WeakMarkedFlagRing (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :=
  MvPolynomial (Fin n) ℂ ⧸ weakMarkedFlagIdeal n V h

/-! ### Quotient roots -/

/-- The root at a position in a quotient of the polynomial ring. -/
def quotientRoot {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ)) (i : Fin n) :
    MvPolynomial (Fin n) ℂ ⧸ I :=
  Ideal.Quotient.mk I (X i)

/-- Evaluation at the quotient roots is the quotient map. -/
theorem quotientRoot_aeval {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ)) :
    aeval (quotientRoot I) = Ideal.Quotient.mkₐ ℂ I := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [aeval_X]
  rfl

theorem quotientRoot_aeval_surjective {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ)) :
    Function.Surjective
      (aeval (quotientRoot I) : MvPolynomial (Fin n) ℂ →ₐ[ℂ] MvPolynomial (Fin n) ℂ ⧸ I) := by
  rw [quotientRoot_aeval]
  exact Ideal.Quotient.mkₐ_surjective ℂ I

/-- A quotient in which every root is nilpotent is finite dimensional. -/
theorem quotientRoot_finite {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ)) (c : Fin n → ℕ)
    (hc : ∀ i, (X i : MvPolynomial (Fin n) ℂ) ^ c i ∈ I) :
    FiniteDimensional ℂ (MvPolynomial (Fin n) ℂ ⧸ I) := by
  have hi : ∀ x ∈ Set.range (quotientRoot I), IsIntegral ℂ x := by
    rintro x ⟨i, rfl⟩
    refine ⟨Polynomial.X ^ c i, Polynomial.monic_X_pow _, ?_⟩
    rw [Polynomial.eval₂_pow, Polynomial.eval₂_X, quotientRoot, ← map_pow]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hc i)
  have ha : Algebra.adjoin ℂ (Set.range (quotientRoot I)) = ⊤ := by
    rw [Algebra.adjoin_range_eq_range_aeval, quotientRoot_aeval, AlgHom.range_eq_top]
    exact Ideal.Quotient.mkₐ_surjective ℂ _
  have hf := fg_adjoin_of_finite (Set.finite_range (quotientRoot I)) hi
  rw [ha, Algebra.top_toSubmodule] at hf
  exact Module.Finite.of_fg_top hf

/-- The quotient roots of an ideal containing the elementary relations form a coinvariant
alphabet. -/
theorem quotientRoot_elementaryPolynomial {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ))
    (hI : fullFlagSymmetricIdeal n ≤ I) :
    D4Levi.ksEPoly (List.ofFn (quotientRoot I)) = 1 := by
  let q := Ideal.Quotient.mk I
  have he : List.ofFn (quotientRoot I) =
      (List.ofFn fun i : Fin n => (X i : MvPolynomial (Fin n) ℂ)).map q := by
    rw [List.map_ofFn]
    rfl
  rw [he, ← alphabetElementary_map]
  ext s
  rw [Polynomial.coeff_map, elementaryProduct_coeff]
  cases s with
  | zero => simp
  | succ s =>
      simp only [map_mul, map_pow, map_neg, map_one]
      rw [show q (esymm (Fin n) ℂ (s + 1)) = 0 from
        Ideal.Quotient.eq_zero_iff_mem.mpr (hI (Ideal.subset_span ⟨s + 1, by omega, rfl⟩))]
      simp only [mul_zero, Polynomial.coeff_one, Nat.add_one_ne_zero, if_false]

/-- Every positive power sum lies in the ideal of positive elementary symmetric functions. -/
theorem psum_mem_fullFlagSymmetricIdeal (n s : ℕ) (hs : 0 < s) :
    psum (Fin n) ℂ s ∈ fullFlagSymmetricIdeal n := by
  rw [psum_eq_mul_esymm_sub_sum (Fin n) ℂ s hs]
  apply Ideal.sub_mem
  · exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨s, hs, rfl⟩)
  · apply Ideal.sum_mem
    intro a ha
    have h1 : 0 < a.1 := ((Finset.mem_filter.mp ha).2).1
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a.1, h1, rfl⟩))

variable {A : Type*} [CommRing A] [Algebra ℂ A]

/-- In a coinvariant alphabet every positive power sum of all roots vanishes. -/
theorem coinvariant_powerSum_zero {n : ℕ} (x : Fin n → A)
    (he : D4Levi.ksEPoly (List.ofFn x) = 1) (s : ℕ) (hs : 0 < s) :
    ∑ i, x i ^ s = 0 := by
  have h := fullFlagSymmetricIdeal_le_ker n x he (psum_mem_fullFlagSymmetricIdeal n s hs)
  have h' : aeval x (psum (Fin n) ℂ s) = 0 := h
  simpa only [psum, map_sum, map_pow, aeval_X] using h'

/-- The universal property of the generic marked full-flag ideal. -/
theorem markedFlagIdeal_le_ker (n : ℕ) (marked : Set (Finset (Fin n))) (cut : Fin n → ℕ)
    (tail : Finset (Fin n)) (L : ℕ) (x : Fin n → A)
    (he : D4Levi.ksEPoly (List.ofFn x) = 1) (hm : ∀ S ∈ marked, ∏ i ∈ S, x i = 0)
    (hc : ∀ i, x i ^ cut i = 0) (ht : ∀ s, L ≤ s → ∑ i ∈ tail, x i ^ s = 0) :
    markedFlagIdeal n marked cut tail L ≤ RingHom.ker (aeval x).toRingHom := by
  refine sup_le (sup_le (sup_le (fullFlagSymmetricIdeal_le_ker n x he) ?_) ?_) ?_
  · apply Ideal.span_le.mpr
    rintro p ⟨S, hS, rfl⟩
    change aeval x (flagGroupProduct S) = 0
    simp only [flagGroupProduct, map_prod, aeval_X]
    exact hm S hS
  · apply Ideal.span_le.mpr
    rintro p ⟨i, rfl⟩
    change aeval x ((X i : MvPolynomial (Fin n) ℂ) ^ cut i) = 0
    simp only [map_pow, aeval_X]
    exact hc i
  · apply Ideal.span_le.mpr
    rintro p ⟨s, hs, rfl⟩
    change aeval x (flagGroupPowerSum tail s) = 0
    simp only [flagGroupPowerSum, map_sum, map_pow, aeval_X]
    exact ht s hs

/-- An algebra generated by roots that satisfy the relations of a finite-dimensional presented
quotient has at most its dimension. -/
theorem finrank_le_of_aeval_surjective {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℂ))
    [FiniteDimensional ℂ (MvPolynomial (Fin n) ℂ ⧸ I)] (x : Fin n → A)
    (hI : I ≤ RingHom.ker (aeval x).toRingHom)
    (hs : Function.Surjective (aeval x : MvPolynomial (Fin n) ℂ →ₐ[ℂ] A)) :
    Module.finrank ℂ A ≤ Module.finrank ℂ (MvPolynomial (Fin n) ℂ ⧸ I) := by
  let f := Ideal.Quotient.liftₐ I (aeval x) (fun p hp => RingHom.mem_ker.mp (hI hp))
  apply LinearMap.finrank_le_finrank_of_surjective (f := f.toLinearMap)
  intro a
  obtain ⟨p, rfl⟩ := hs a
  exact ⟨Ideal.Quotient.mk I p, rfl⟩

/-! ### Relations of the generic quotient roots -/

section Generic

variable (n : ℕ) (marked : Set (Finset (Fin n))) (cut : Fin n → ℕ) (tail : Finset (Fin n))
  (L : ℕ)

theorem markedFlag_elementary :
    D4Levi.ksEPoly (List.ofFn (quotientRoot (markedFlagIdeal n marked cut tail L))) = 1 :=
  quotientRoot_elementaryPolynomial _ (le_sup_left.trans (le_sup_left.trans le_sup_left))

theorem markedFlag_product_zero (S : Finset (Fin n)) (hS : S ∈ marked) :
    ∏ i ∈ S, quotientRoot (markedFlagIdeal n marked cut tail L) i = 0 := by
  rw [show (∏ i ∈ S, quotientRoot (markedFlagIdeal n marked cut tail L) i) =
    Ideal.Quotient.mk _ (flagGroupProduct S) by simp [flagGroupProduct, quotientRoot]]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact (le_sup_right.trans (le_sup_left.trans le_sup_left) :
    Ideal.span (flagGroupProduct '' marked) ≤ markedFlagIdeal n marked cut tail L)
      (Ideal.subset_span ⟨S, hS, rfl⟩)

theorem markedFlag_cutoff (i : Fin n) :
    quotientRoot (markedFlagIdeal n marked cut tail L) i ^ cut i = 0 := by
  rw [quotientRoot, ← map_pow]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact (le_sup_right.trans le_sup_left :
    Ideal.span (Set.range fun i => (X i : MvPolynomial (Fin n) ℂ) ^ cut i) ≤
      markedFlagIdeal n marked cut tail L) (Ideal.subset_span ⟨i, rfl⟩)

theorem markedFlag_tail_zero (s : ℕ) (hs : L ≤ s) :
    ∑ i ∈ tail, quotientRoot (markedFlagIdeal n marked cut tail L) i ^ s = 0 := by
  rw [show (∑ i ∈ tail, quotientRoot (markedFlagIdeal n marked cut tail L) i ^ s) =
    Ideal.Quotient.mk _ (flagGroupPowerSum tail s) by simp [flagGroupPowerSum, quotientRoot]]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact (le_sup_right :
    Ideal.span {p | ∃ s, L ≤ s ∧ flagGroupPowerSum tail s = p} ≤
      markedFlagIdeal n marked cut tail L) (Ideal.subset_span ⟨s, hs, rfl⟩)

theorem markedFlag_finite :
    FiniteDimensional ℂ (MvPolynomial (Fin n) ℂ ⧸ markedFlagIdeal n marked cut tail L) := by
  apply quotientRoot_finite _ cut
  intro i
  exact (le_sup_right.trans le_sup_left :
    Ideal.span (Set.range fun i => (X i : MvPolynomial (Fin n) ℂ) ^ cut i) ≤
      markedFlagIdeal n marked cut tail L) (Ideal.subset_span ⟨i, rfl⟩)

end Generic

instance doublyMarkedFlag_finite (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :
    FiniteDimensional ℂ (DoublyMarkedFlagRing n V h) :=
  markedFlag_finite _ _ _ _ _

instance singlyMarkedFlag_finite (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :
    FiniteDimensional ℂ (SinglyMarkedFlagRing n V h) :=
  markedFlag_finite _ _ _ _ _

instance weakMarkedFlag_finite (n : ℕ) (V : Finset (Fin n)) (h : ℕ) :
    FiniteDimensional ℂ (WeakMarkedFlagRing n V h) :=
  markedFlag_finite _ _ _ _ _

end

