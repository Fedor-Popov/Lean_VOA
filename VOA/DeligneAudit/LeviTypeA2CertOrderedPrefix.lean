import VOA.DeligneAudit.LeviTypeA2CertOrder

/-! The descending key list as a finite indexed filtration. -/

namespace VOA.DeligneAudit.A3Sector

noncomputable def a2KeyEnum (p q : ℕ) :
    Fin ((a2KeyBox p q).card) → A2RadicalKey := fun j =>
  (a2OrderedKeys p q).get
    (Fin.cast (length_a2OrderedKeys p q).symm j)

theorem a2KeyEnum_mem (p q : ℕ) (j : Fin ((a2KeyBox p q).card)) :
    a2KeyEnum p q j ∈ a2KeyBox p q := by
  apply (mem_a2OrderedKeys p q _).mp
  simpa only [a2KeyEnum] using
    (List.get_mem (a2OrderedKeys p q)
      (Fin.cast (length_a2OrderedKeys p q).symm j))

theorem a2KeyEnum_cover (p q : ℕ) (x : A2RadicalKey)
    (hx : x ∈ a2KeyBox p q) :
    ∃ j : Fin ((a2KeyBox p q).card), a2KeyEnum p q j = x := by
  have hx' : x ∈ a2OrderedKeys p q := (mem_a2OrderedKeys p q x).mpr hx
  obtain ⟨j, hj⟩ := List.mem_iff_get.mp hx'
  refine ⟨Fin.cast (length_a2OrderedKeys p q) j, ?_⟩
  simpa [a2KeyEnum] using hj

theorem a2KeyEnum_descending (p q : ℕ)
    (i j : Fin ((a2KeyBox p q).card)) (hij : i < j) :
    a2KeyLess q (a2KeyEnum p q j) (a2KeyEnum p q i) := by
  let i' := Fin.cast (length_a2OrderedKeys p q).symm i
  let j' := Fin.cast (length_a2OrderedKeys p q).symm j
  have hlt : i' < j' := by simpa [i', j'] using hij
  have hrel := (List.pairwise_iff_get.mp
    (pairwise_a2OrderedKeys p q)) i' j' hlt
  have hne : i' ≠ j' := ne_of_lt hlt
  have hnodup : (a2OrderedKeys p q).Nodup := by
    change ((a2KeyBox p q).sort (a2KeyDescLE q)).Nodup
    exact Finset.sort_nodup (a2KeyBox p q) (a2KeyDescLE q)
  have hval : (a2OrderedKeys p q).get i' ≠
      (a2OrderedKeys p q).get j' := by
    intro heq
    exact hne (List.nodup_iff_injective_get.mp hnodup heq)
  rcases hrel with heq | hless
  · exact False.elim (hval heq)
  · exact hless

open VOA.DeligneAudit.SectorWeyl

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule VOA.AffineSl3.bracketTable V) (w : V)

/-- The descending filtration reaches the entire cyclic module. -/
theorem a2OrderedPrefix_top (p q : ℕ)
    (h : A2LocalWeylRel ρ w p q) :
    a2KeyPrefix ρ w (a2KeyEnum p q) (a2KeyBox p q).card =
      VOA.DeligneAudit.UnivG.cycSubG ρ w :=
  a2KeyPrefix_top ρ w (a2KeyEnum p q) p q h
    (a2KeyEnum_mem p q) (a2KeyEnum_cover p q)

theorem a2OrderedPrefix_le_cyc (p q i : ℕ)
    (h : A2LocalWeylRel ρ w p q) :
    a2KeyPrefix ρ w (a2KeyEnum p q) i ≤
      VOA.DeligneAudit.UnivG.cycSubG ρ w := by
  have hspan : a2KeyPrefixSpan ρ w (a2KeyEnum p q) i ≤
      ⨆ x ∈ a2KeyBox p q, a2KeyLayer ρ w x := by
    rw [a2KeyPrefixSpan, iSup_le_iff]
    intro j
    rw [iSup_le_iff]
    intro _
    exact le_iSup_of_le (a2KeyEnum p q j)
      (le_iSup_of_le (a2KeyEnum_mem p q j) le_rfl)
  change a2LeviClosure ρ (a2KeyPrefixSpan ρ w (a2KeyEnum p q) i) ≤ _
  calc
    _ ≤ a2LeviClosure ρ
        (⨆ x ∈ a2KeyBox p q, a2KeyLayer ρ w x) :=
      a2LeviClosure_mono ρ hspan
    _ = _ := (a2_cycSubG_eq_leviClosure_keyBox ρ w p q h).symm

/-- Every ordered step is generated by the Levi orbits of basis lifts of its
key quotient. -/
theorem a2OrderedPrefix_step_orbits (p q : ℕ)
    (h : A2LocalWeylRel ρ w p q)
    (i : ℕ) (hi : i < (a2KeyBox p q).card) :
    let F := a2KeyPrefix ρ w (a2KeyEnum p q) i
    let S := a2KeyLayer ρ w (a2KeyEnum p q ⟨i, hi⟩)
    ∃ v : Fin (Module.finrank ℂ (S ⧸ F.comap S.subtype)) → S,
      a2KeyPrefix ρ w (a2KeyEnum p q) (i + 1) =
        F ⊔ ⨆ j, a2LeviClosure ρ (ℂ ∙ (v j : V)) :=
  a2KeyPrefix_step_orbits ρ w hi (a2KeyEnum p q) p q h

end VOA.DeligneAudit.A3Sector

