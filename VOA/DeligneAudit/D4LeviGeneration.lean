import VOA.DeligneAudit.D4LeviPBW
import VOA.DeligneAudit.D4FusionKernelGeneric

/-! All-m PBW generation by gl4 words on abelian negative-radical monomials. -/

namespace VOA.DeligneAudit.D4Levi

open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.UnivG
open VOA.DeligneAudit.DeligneSector.D4

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule fD4 V) (w : V)

private theorem positive_on_radical
    (hpos : ∀ a s, IsPositive a → ρ.op a s w = 0) :
    ∀ (r : List (Fin 28 × ℕ)),
      r.Forall (fun x => IsRadical x.1) →
      ∀ (a : Fin 28) (s : ℕ), IsPositive a →
        ρ.op a s (wordOp ρ r w) ∈ leviSpan ρ w := by
  intro r
  induction r with
  | nil =>
      intro _ a s ha
      change ρ.op a s w ∈ leviSpan ρ w
      rw [hpos a s ha]
      exact (leviSpan ρ w).zero_mem
  | cons x r ih =>
      intro hr a s ha
      rcases x with ⟨b, t⟩
      simp only [List.forall_cons] at hr
      apply swap_mem ρ w a b s t (wordOp ρ r w)
      · exact radical_inv ρ w b t hr.1 (ih hr.2 a s ha)
      · intro c hc
        have hlevi : IsLevi c := by
          by_contra hn
          exact hc (positive_radical_zero a b c ha hr.1 hn)
        exact levi_inv ρ w c (s + t) hlevi
          (normal_mem ρ w [] r (by simp) hr.2)

private theorem positive_on_normal
    (hpos : ∀ a s, IsPositive a → ρ.op a s w = 0) :
    ∀ (l r : List (Fin 28 × ℕ)),
      l.Forall (fun x => IsLevi x.1) →
      r.Forall (fun x => IsRadical x.1) →
      ∀ (a : Fin 28) (s : ℕ), IsPositive a →
        ρ.op a s (wordOp ρ (l ++ r) w) ∈ leviSpan ρ w := by
  intro l
  induction l with
  | nil =>
      intro r _ hr a s ha
      exact positive_on_radical ρ w hpos r hr a s ha
  | cons x l ih =>
      intro r hl hr a s ha
      rcases x with ⟨b, t⟩
      simp only [List.forall_cons] at hl
      apply swap_mem ρ w a b s t (wordOp ρ (l ++ r) w)
      · exact levi_inv ρ w b t hl.1 (ih r hl.2 hr a s ha)
      · intro c hc
        have hpositive : IsPositive c := by
          by_contra hn
          exact hc (positive_levi_zero a b c ha hl.1 hn)
        exact ih r hl.2 hr c (s + t) hpositive

theorem positive_inv
    (hpos : ∀ a s, IsPositive a → ρ.op a s w = 0)
    (a : Fin 28) (s : ℕ) (ha : IsPositive a)
    {v : V} (hv : v ∈ leviSpan ρ w) :
    ρ.op a s v ∈ leviSpan ρ w := by
  induction hv using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨l, r, hl, hr, rfl⟩ := hz
      exact positive_on_normal ρ w hpos l r hl hr a s ha
  | zero => simp
  | add x y _ _ hx hy => simpa using (leviSpan ρ w).add_mem hx hy
  | smul c x _ hx => simpa using (leviSpan ρ w).smul_mem c hx

theorem cycSubG_eq_leviSpan
    (hpos : ∀ a s, IsPositive a → ρ.op a s w = 0) :
    cycSubG ρ w = leviSpan ρ w := by
  apply le_antisymm
  · rw [cycSubG, Submodule.span_le]
    rintro z ⟨l, rfl⟩
    induction l with
    | nil => exact normal_mem ρ w [] [] (by simp) (by simp)
    | cons x l ih =>
        rcases x with ⟨a, s⟩
        rcases every_colour a with hp | hl | hr
        · exact positive_inv ρ w hpos a s hp ih
        · exact levi_inv ρ w a s hl ih
        · exact radical_inv ρ w a s hr ih
  · rw [leviSpan, Submodule.span_le]
    rintro z ⟨l, r, _, _, rfl⟩
    exact wordOp_mem_cycSubG ρ w (l ++ r)

/-- The presented all-m D4 source is generated by Levi words on radical monomials. -/
theorem source_generation (m : ℕ)
    (h : Sat D4sector.f ρ w (ravFam D4sector m 0)) :
    cycSubG ρ w = leviSpan ρ w := by
  have hs : Sat D4sector.f ρ w (ravSpec D4sector m (2 * m)) := by
    simpa [ravFam] using h
  apply cycSubG_eq_leviSpan ρ w
  intro a s ha
  obtain ⟨i, rfl⟩ := ha
  have hraise : D4sector.raising (positiveColour i) := by
    change 4 ≤ (positiveColour i).val ∧ (positiveColour i).val < 16
    fin_cases i <;> decide
  exact rs_raising hs hraise s

end VOA.DeligneAudit.D4Levi

