import VOA.DeligneAudit.SL4TMixedAChain
import VOA.DeligneAudit.SL4TMixedACharacteristic

/-! # Polynomial identities for the truncation levels of mixed-site Thom elements -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

open Polynomial

variable {R : Type*} [CommRing R]

/-- The constant-term identity obtained from a complementary characteristic factorization. -/
theorem characteristic_constant_power_decomposition (p q qb : R[X]) (t : R) (m : ℕ)
    (h : q * qb = X ^ (m + 1)) :
    Polynomial.C (t * p.coeff 0) * X ^ m =
      Polynomial.C t * qb.divX * (p * q) -
        Polynomial.C t * p.divX * X ^ (m + 1) +
          Polynomial.C (t * qb.coeff 0) * p * q.divX := by
  have hd := polynomial_complement_divX q qb m h
  have hp := X_mul_divX_add p
  simp only [map_mul]
  rw [pow_succ]
  linear_combination Polynomial.C t * p * hd + Polynomial.C t * X ^ m * hp

/-- A complementary constant term supported on an earlier ideal gives a truncation relation. -/
theorem characteristic_constant_power_mem (p q qb : R[X]) (t : R) (m : ℕ)
    (I : Ideal R) (h : q * qb = X ^ (m + 1)) (ht : t * qb.coeff 0 ∈ I) :
    Polynomial.C (t * p.coeff 0) * X ^ m ∈
      relationIdeal p q (m + 1) ⊔ I.map Polynomial.C := by
  let J := relationIdeal p q (m + 1) ⊔ I.map Polynomial.C
  have hA : relationIdeal p q (m + 1) ≤ J := le_sup_left
  have hI : I.map Polynomial.C ≤ J := le_sup_right
  rw [characteristic_constant_power_decomposition p q qb t m h]
  exact J.add_mem
    (J.sub_mem
      (J.mul_mem_left _ (hA (relationIdeal_product p q (m + 1))))
      (J.mul_mem_left _ (hA (relationIdeal_power p q (m + 1)))))
    (J.mul_mem_right _ (J.mul_mem_right _ (hI (Ideal.mem_map_of_mem Polynomial.C ht))))

/-- The characteristic polynomial of the first selected alphabet. -/
def mixedFirstPolynomial (q : MixedParams) : (MixedRing q)[X] :=
  descendingPoly (fun i => (-1) ^ i * mixedEvaluation q (mixedE 3 i)) q.e1.toNat

/-- The characteristic polynomial of the complementary second alphabet. -/
def mixedSecondPolynomial (q : MixedParams) : (MixedRing q)[X] :=
  descendingPoly (fun i => (-1) ^ i * mixedEvaluation q (mixedG2prime i))
    (mixedQ q - q.e2).toNat

theorem mixedCharacteristic_factors (q : MixedParams) :
    mixedCharacteristic q = mixedFirstPolynomial q * mixedSecondPolynomial q := rfl

theorem mixedFirstPolynomial_constant (q : MixedParams) :
    (mixedFirstPolynomial q).coeff 0 =
      (-1) ^ q.e1.toNat * mixedEvaluation q (mixedE 3 q.e1.toNat) :=
  descendingPoly_constant _ _

theorem mixedSecondPolynomial_constant (q : MixedParams) :
    (mixedSecondPolynomial q).coeff 0 = (-1) ^ (mixedQ q - q.e2).toNat *
      mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat) :=
  descendingPoly_constant _ _

/-- The ideal generated by the characteristic polynomial and the total-site truncation. -/
def mixedTruncationIdeal (q : MixedParams) : Ideal (MixedRing q)[X] :=
  Ideal.span {mixedCharacteristic q} ⊔ Ideal.span {X ^ (q.A + q.B).toNat}

/-- The product of the two top characteristic classes has one less site of truncation. -/
theorem mixedTopProduct_truncation (q : MixedParams) (hM : 1 ≤ q.A + q.B) :
    Polynomial.C (mixedEvaluation q (mixedE 3 q.e1.toNat) *
        mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat)) *
      X ^ (q.A + q.B - 1).toNat ∈ mixedTruncationIdeal q := by
  have hm : (q.A + q.B - 1).toNat + 1 = (q.A + q.B).toNat := by omega
  have h := polynomial_nn_mem (mixedFirstPolynomial q) (mixedSecondPolynomial q)
    (q.A + q.B - 1).toNat
  rw [hm, mixedFirstPolynomial_constant, mixedSecondPolynomial_constant] at h
  change _ ∈ mixedTruncationIdeal q at h
  apply ((mixedTruncationIdeal q).smul_mem_iff_of_isUnit
    (isUnit_neg_one.pow (q.e1.toNat + (mixedQ q - q.e2).toNat))).mp
  change (-1 : (MixedRing q)[X]) ^ (q.e1.toNat + (mixedQ q - q.e2).toNat) * _ ∈ _
  convert h using 1
  simp only [map_mul, map_pow, map_neg, map_one, pow_add]
  ring

/-- Each of the four no-root a-site Thom elements has the smaller truncation level. -/
theorem mixedAThom_noRoot_truncation (q : MixedParams) (hA : 1 ≤ q.A) (hB : q.B = 0)
    (i : Fin 4) :
    Polynomial.C (mixedAThom q (mixedAOrder ⟨i.val, by omega⟩)) *
      X ^ (q.A - 1).toNat ∈ mixedTruncationIdeal q := by
  let a := mixedEvaluation q (mixedE 3 q.e1.toNat)
  let b := mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat)
  let h := mixedEvaluation q (mixedH 0 (q.A - q.d1).toNat)
  let z := mixedEvaluation q (mixedE 2 q.d3.toNat)
  have hab : Polynomial.C (a * b) * X ^ (q.A - 1).toNat ∈ mixedTruncationIdeal q := by
    simpa only [hB, add_zero] using mixedTopProduct_truncation q (by omega)
  fin_cases i
  · change Polynomial.C (a * h * b * z) * X ^ (q.A - 1).toNat ∈ _
    have ht := (mixedTruncationIdeal q).mul_mem_left (Polynomial.C (h * z)) hab
    convert ht using 1 <;> simp only [map_mul] <;> ring
  · change Polynomial.C (a * h * b) * X ^ (q.A - 1).toNat ∈ _
    have ht := (mixedTruncationIdeal q).mul_mem_left (Polynomial.C h) hab
    convert ht using 1 <;> simp only [map_mul] <;> ring
  · change Polynomial.C (a * b * z) * X ^ (q.A - 1).toNat ∈ _
    have ht := (mixedTruncationIdeal q).mul_mem_left (Polynomial.C z) hab
    convert ht using 1 <;> simp only [map_mul] <;> ring
  · exact hab

end

end VOA.DeligneAudit.SL4T

