import VOA.DeligneAudit.DeligneFusionSl2
import VOA.DeligneAudit.DeligneFusionGarland

/-!
# The `sl₂` box spanning on modules

Given pairwise commuting operators `F i` and a vector `y` killed by every Garland element
`[uˢ] F(u)^r` with `r ≥ 1`, `r + s ≥ m + 1`, every polynomial in the `F i` applied to `y` lies in the
span of the box monomials applied to `y` (`span_box`).  With `Garland.garland` this gives the
spanning half of `dim W_{sl₂}(m) = 2^m` (`weyl_span_box`).
-/

namespace VOA.DeligneAudit.Sl2Weyl

set_option linter.deprecated false

noncomputable section

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (F : ℕ → Module.End ℂ V)
  (hFF : ∀ i j, F i * F j = F j * F i)

/-- The commutative algebra generated by the `F i`. -/
abbrev Alg := Algebra.adjoin ℂ (Set.range F)

include hFF in
theorem range_comm : ∀ a ∈ Set.range F, ∀ b ∈ Set.range F, a * b = b * a := by
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩; exact hFF i j

include hFF in
/-- Evaluation `R → End V`, `zᵢ ↦ F i` (through the commutative subalgebra). -/
def evAlg : R →ₐ[ℂ] Module.End ℂ V :=
  letI : CommRing (Alg F) := Algebra.adjoinCommRingOfComm ℂ (range_comm F hFF)
  (Alg F).val.comp (MvPolynomial.aeval fun i => ⟨F i, Algebra.subset_adjoin ⟨i, rfl⟩⟩)

theorem evAlg_z (i : ℕ) : evAlg F hFF (z i) = F i := by
  simp [evAlg, z]

theorem evAlg_xx (r s : ℕ) :
    evAlg F hFF (xx r s) = PowerSeries.coeff s (Garland.Fs F ^ r) := by
  rw [xx, show evAlg F hFF (PowerSeries.coeff s (Zs ^ r)) =
      PowerSeries.coeff s (PowerSeries.map (evAlg F hFF).toRingHom (Zs ^ r)) from
      (PowerSeries.coeff_map _ _ _).symm, map_pow]
  congr 2
  refine PowerSeries.ext fun n => ?_
  simp [Zs, Garland.Fs, PowerSeries.coeff_map, evAlg_z]

/-- **Box spanning on modules.** -/
theorem span_box (y : V) (m : ℕ)
    (hk : ∀ r s, 1 ≤ r → m + 1 ≤ r + s → (PowerSeries.coeff s (Garland.Fs F ^ r)) y = 0) (p : R) :
    evAlg F hFF p y ∈
      Submodule.span ℂ {v | ∃ f, BoxP m f ∧ v = evAlg F hFF (MvPolynomial.monomial f 1) y} := by
  obtain ⟨b, hb, j, hj, rfl⟩ := Submodule.mem_sup.mp (box_span m p)
  rw [map_add, LinearMap.add_apply]
  have hJ : ∀ x ∈ J m, ∀ a, evAlg F hFF (a * x) y = 0 := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨r, s, hr, hrs, rfl⟩ := hx
        intro a
        rw [map_mul, Module.End.mul_apply, evAlg_xx, hk r s hr hrs, map_zero]
    | zero => intro a; simp
    | add x y _ _ hx hy => intro a; rw [mul_add, map_add, LinearMap.add_apply, hx, hy, add_zero]
    | smul c x _ hx => intro a; rw [smul_eq_mul, ← mul_assoc]; exact hx (a * c)
  have hj0 := hJ j hj 1
  rw [one_mul] at hj0
  rw [hj0, add_zero]
  induction hb using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨f, hf, -, rfl⟩ := hx
      exact Submodule.subset_span ⟨f, hf, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, LinearMap.add_apply]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [map_smul, LinearMap.smul_apply]; exact Submodule.smul_mem _ _ hx

/-- **The `sl₂` Weyl module is spanned by box monomials** (Garland input). -/
theorem weyl_span_box {E1 : Module.End ℂ V} {H : ℕ → Module.End ℂ V}
    (hEF : ∀ k, E1 * F k - F k * E1 = H (k + 1))
    (hHF : ∀ m k, H (m + 1) * F k - F k * H (m + 1) = (-2 : ℂ) • F (m + 1 + k))
    {y : V} (hE : E1 y = 0) (hH : ∀ m, H (m + 1) y = 0) (m : ℕ) (hN : (F 0 ^ (m + 1)) y = 0)
    (p : R) :
    evAlg F hFF p y ∈
      Submodule.span ℂ {v | ∃ f, BoxP m f ∧ v = evAlg F hFF (MvPolynomial.monomial f 1) y} :=
  span_box F hFF y m (fun r s hr hrs => Garland.garland hEF hHF hFF hE hH r hr hN s hrs) p

/-- **Graded box spanning on modules.** -/
theorem span_box_graded (y : V) (m : ℕ)
    (hk : ∀ r s, 1 ≤ r → m + 1 ≤ r + s → (PowerSeries.coeff s (Garland.Fs F ^ r)) y = 0) {p : R}
    {n : ℕ × ℕ} (hp : MvPolynomial.IsWeightedHomogeneous om p n) :
    evAlg F hFF p y ∈
      Submodule.span ℂ {v | ∃ f, BoxP m f ∧ Finsupp.weight om f = n ∧
        v = evAlg F hFF (MvPolynomial.monomial f 1) y} := by
  obtain ⟨b, hb, j, hj, rfl⟩ := Submodule.mem_sup.mp (box_span_graded m hp)
  rw [map_add, LinearMap.add_apply]
  have hJ : ∀ x ∈ J m, ∀ a, evAlg F hFF (a * x) y = 0 := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨r, s, hr, hrs, rfl⟩ := hx
        intro a
        rw [map_mul, Module.End.mul_apply, evAlg_xx, hk r s hr hrs, map_zero]
    | zero => intro a; simp
    | add x y _ _ hx hy => intro a; rw [mul_add, map_add, LinearMap.add_apply, hx, hy, add_zero]
    | smul c x _ hx => intro a; rw [smul_eq_mul, ← mul_assoc]; exact hx (a * c)
  have hj0 := hJ j hj 1
  rw [one_mul] at hj0
  rw [hj0, add_zero]
  clear hp
  induction hb using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨f, hf, hw, rfl⟩ := hx
      exact Submodule.subset_span ⟨f, hf, hw, rfl⟩
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, LinearMap.add_apply]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [map_smul, LinearMap.smul_apply]; exact Submodule.smul_mem _ _ hx

/-- The graded `sl₂` Weyl spanning (Garland input). -/
theorem weyl_span_box_graded {E1 : Module.End ℂ V} {H : ℕ → Module.End ℂ V}
    (hEF : ∀ k, E1 * F k - F k * E1 = H (k + 1))
    (hHF : ∀ m k, H (m + 1) * F k - F k * H (m + 1) = (-2 : ℂ) • F (m + 1 + k))
    {y : V} (hE : E1 y = 0) (hH : ∀ m, H (m + 1) y = 0) (m : ℕ) (hN : (F 0 ^ (m + 1)) y = 0)
    {p : R} {n : ℕ × ℕ} (hp : MvPolynomial.IsWeightedHomogeneous om p n) :
    evAlg F hFF p y ∈
      Submodule.span ℂ {v | ∃ f, BoxP m f ∧ Finsupp.weight om f = n ∧
        v = evAlg F hFF (MvPolynomial.monomial f 1) y} :=
  span_box_graded F hFF y m (fun r s hr hrs => Garland.garland hEF hHF hFF hE hH r hr hN s hrs) hp

end

end VOA.DeligneAudit.Sl2Weyl

section AxiomAudit
#print axioms VOA.DeligneAudit.Sl2Weyl.weyl_span_box
end AxiomAudit
