#print axioms jetLiBidegreePiece_eq_polynomialPiece
#print axioms presentedJetLiBidegreeImage_eq_quotientPiece
#print axioms dualEquivCarrier
#print axioms toCarrier_injective
#print axioms finrank_carrier_eq
#print axioms span_homogeneousQuadratic_eq_quadraticIdeal
#print axioms geometricCarrierEmbedding_of_quadraticIdeal
#print axioms geometricCarrierEmbedding_of_span
end AxiomAudit
