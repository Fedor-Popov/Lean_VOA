import VOA.Examples.DeligneHigherRankConditionalCapstone
import VOA.Commutative.QuadraticJetRestrictedDual

/-!
# The geometric carrier embedding for quadratic current presentations

The capstone input `GeometricCarrierEmbedding case W P Carrier` asks for an injective linear map
from the dual of every presented-jet Li/conformal bidegree into `Carrier p N`.

For a presentation whose ideal is generated by homogeneous quadratic polynomials (the Deligne
ideals `(I₂ⁿˢ)`; for `A₂` the adjoint copy `V(θ) ⊂ Sym² sl₃`), the restored module
`QuadraticJetRestrictedDual` already identifies the dual of each fixed particle/derivative piece
of the presented finite jet algebra with a fixed-degree piece of the literal tensor-valued current
carrier (`restrictedDualEquivCurrentCarrier`).  This file supplies the two missing bridges:

1. the capstone's Li/conformal bidegree `(p, N)` with base weight one and jet order `p` is exactly
   the particle/derivative bidegree `(N - p, p)` (`jetLiBidegreePiece_eq_polynomialPiece`), so the
   two presented images coincide (`presentedJetLiBidegreeImage_eq_quotientPiece`);
2. every ideal spanned by homogeneous quadratic polynomials is a `quadraticIdeal Q` for an explicit
   coefficient family `Q` (`span_homogeneousQuadratic_eq_quadraticIdeal`).

The result is a **linear equivalence** (not only an injection) between the dual of every capstone
bidegree with `p ≤ N` and the carrier piece `degreePiece (currentCarrier Q (N - p) 0) p`.  No
representation-theoretic input (global Weyl modules, fusion bounds) enters: those inputs are needed
only to compute the *character* of this carrier, i.e. for `OrdinaryCarrierCharacter`.
-/

namespace VOA.DeligneAudit.CarrierEmbedding

open VOA.FiniteJet VOA.QuadraticJetCoefficientPairing VOA.QuadraticJetRestrictedDual
open VOA.QuadraticCurrentFunctionalCarrier
open VOA.DeligneHigherRankConditionalCapstone

noncomputable section

section Bidegree

variable {K σ : Type*} [Field K]

/-- With all base weights one, the Li/conformal bidegree of a jet monomial is
(derivative order, particle number + derivative order). -/
theorem weight_jetLiBidegree_one (M : ℕ) (e : JetVar σ M →₀ ℕ) :
    Finsupp.weight (jetLiBidegree (fun _ : σ => 1) M) e =
      ((Finsupp.weight (bidegreeWeight (σ := σ) M) e).2,
       (Finsupp.weight (bidegreeWeight (σ := σ) M) e).1 +
         (Finsupp.weight (bidegreeWeight (σ := σ) M) e).2) := by
  classical
  induction e using Finsupp.induction with
  | zero => simp only [map_zero]; rfl
  | single_add a n e ha hn ih =>
    simp only [map_add, Finsupp.weight_single, ih, jetLiBidegree, bidegreeWeight,
      Prod.smul_mk, Prod.mk_add_mk, smul_eq_mul, Prod.fst_add, Prod.snd_add]
    refine Prod.ext rfl ?_
    simp only
    ring

/-- The capstone bidegree piece `(p, N)` at jet order `p` is the particle/derivative piece
`(N - p, p)` of the restricted-dual module, as soon as `p ≤ N`. -/
theorem jetLiBidegreePiece_eq_polynomialPiece {p N : ℕ} (h : p ≤ N) :
    JetLiBidegreePiece K (fun _ : σ => 1) p p N =
      polynomialPiece (K := K) (σ := σ) p (N - p) p := by
  ext f
  simp only [polynomialPiece, MvPolynomial.mem_weightedHomogeneousSubmodule]
  constructor
  · intro hf d hd
    have h1 := hf hd
    rw [weight_jetLiBidegree_one] at h1
    have h2 := Prod.ext_iff.mp h1
    simp only at h2
    exact Prod.ext (by omega) (by omega)
  · intro hf d hd
    have h1 := hf hd
    rw [weight_jetLiBidegree_one, h1]
    exact Prod.ext rfl (by simp only; omega)

/-- Below the diagonal the capstone bidegree piece vanishes. -/
theorem jetLiBidegreePiece_eq_bot {p N : ℕ} (h : N < p) :
    JetLiBidegreePiece K (fun _ : σ => 1) p p N = ⊥ := by
  rw [eq_bot_iff]
  intro f hf
  rw [Submodule.mem_bot]
  rw [MvPolynomial.mem_weightedHomogeneousSubmodule] at hf
  ext d
  by_contra hd
  have h1 := hf hd
  rw [weight_jetLiBidegree_one] at h1
  have h2 := Prod.ext_iff.mp h1
  simp only at h2
  omega

variable [Fintype σ] {ρ : Type*}

/-- The capstone's presented bidegree image is the restricted-dual module's quotient piece. -/
theorem presentedJetLiBidegreeImage_eq_quotientPiece (Q : ρ → σ × σ → K) {p N : ℕ}
    (h : p ≤ N) :
    PresentedJetLiBidegreeImage (R := K) (fun _ : σ => 1) p p N (quadraticIdeal Q) =
      quotientPiece Q p (N - p) p := by
  simp only [PresentedJetLiBidegreeImage, quotientPiece, LinearMap.range_comp,
    Submodule.range_subtype]
  rw [jetLiBidegreePiece_eq_polynomialPiece h]

/-- The literal current carrier in capstone bidegree `(p, N)`: tensor-valued symmetric
polynomials in `N - p` current particles, of derivative degree `p`, satisfying all quadratic
collision equations. -/
abbrev carrierPiece (Q : ρ → σ × σ → K) (p N : ℕ) : Submodule K (currentCarrier Q (N - p) 0) :=
  degreePiece (currentCarrier Q (N - p) 0) p

/-- The literal carrier family, as a type family. -/
abbrev Carrier (Q : ρ → σ × σ → K) (p N : ℕ) : Type _ := carrierPiece Q p N

/-- **Restricted-dual equivalence in capstone coordinates.**  For `p ≤ N` the dual of the
capstone's presented-jet bidegree is linearly equivalent to the literal carrier piece. -/
def dualEquivCarrier (Q : ρ → σ × σ → K) {p N : ℕ} (h : p ≤ N) :
    Module.Dual K (PresentedJetLiBidegreeImage (R := K) (fun _ : σ => 1) p p N
      (quadraticIdeal Q)) ≃ₗ[K] Carrier Q p N :=
  (LinearEquiv.ofEq _ _ (presentedJetLiBidegreeImage_eq_quotientPiece Q h).symm).dualMap.trans
    (restrictedDualEquivCurrentCarrier Q p (N - p) p le_rfl)

/-- The carrier map used for the capstone: the restricted-dual equivalence on the diagonal
range `p ≤ N`, and zero below it (where the source is zero). -/
def toCarrier (Q : ρ → σ × σ → K) (p N : ℕ) :
    Module.Dual K (PresentedJetLiBidegreeImage (R := K) (fun _ : σ => 1) p p N
      (quadraticIdeal Q)) →ₗ[K] Carrier Q p N :=
  if h : p ≤ N then (dualEquivCarrier Q h).toLinearMap else 0

omit [Fintype σ] in
theorem presentedJetLiBidegreeImage_eq_bot (I : Ideal (MvPolynomial σ K)) {p N : ℕ}
    (h : N < p) :
    PresentedJetLiBidegreeImage (R := K) (fun _ : σ => 1) p p N I = ⊥ := by
  simp only [PresentedJetLiBidegreeImage, LinearMap.range_comp, Submodule.range_subtype]
  rw [jetLiBidegreePiece_eq_bot h, Submodule.map_bot]

theorem toCarrier_injective (Q : ρ → σ × σ → K) (p N : ℕ) :
    Function.Injective (toCarrier Q p N) := by
  unfold toCarrier
  split_ifs with h
  · exact (dualEquivCarrier Q h).injective
  · intro L M _
    apply LinearMap.ext
    intro x
    have hx : x = 0 := by
      obtain ⟨y, hy⟩ := x
      rw [presentedJetLiBidegreeImage_eq_bot _ (Nat.lt_of_not_le h)] at hy
      exact Subtype.ext ((Submodule.mem_bot K).mp hy)
    rw [hx, map_zero, map_zero]

/-- On the diagonal range the carrier has exactly the dimension of the presented bidegree. -/
theorem finrank_carrier_eq (Q : ρ → σ × σ → K) {p N : ℕ} (h : p ≤ N) :
    Module.finrank K (Carrier Q p N) =
      Module.finrank K (PresentedJetLiBidegreeImage (R := K) (fun _ : σ => 1) p p N
        (quadraticIdeal Q)) := by
  letI : FiniteDimensional K (PresentedJetLiBidegreeImage (R := K) (fun _ : σ => 1) p p N
      (quadraticIdeal Q)) :=
    finiteDimensional_presentedJetLiBidegreeImage (fun _ => 1) (fun _ => Nat.one_pos) p p N _
  rw [← (dualEquivCarrier Q h).finrank_eq, Subspace.dual_finrank_eq]

end Bidegree

section QuadraticGenerators

variable {K σ : Type*} [Field K] [Fintype σ]

omit [Fintype σ] in
/-- A degree-two exponent is a sum of two unit exponents. -/
theorem exists_pair_of_degree_eq_two (e : σ →₀ ℕ) (he : Finsupp.degree e = 2) :
    ∃ a b, e = Finsupp.single a 1 + Finsupp.single b 1 := by
  classical
  have hc : Multiset.card (Finsupp.toMultiset e) = 2 := by
    rw [Finsupp.card_toMultiset, ← he]
    rfl
  obtain ⟨a, b, hab⟩ := Multiset.card_eq_two.mp hc
  have hinj : Function.Injective (Finsupp.toMultiset (α := σ)) :=
    Function.LeftInverse.injective (g := Multiset.toFinsupp) Finsupp.toMultiset_toFinsupp
  refine ⟨a, b, hinj ?_⟩
  rw [hab, map_add, Finsupp.toMultiset_single, Finsupp.toMultiset_single, one_smul, one_smul]
  rfl

/-- The coefficient-matrix encoding of quadratic polynomials, as a linear map. -/
def quadraticRelationLinear : (σ × σ → K) →ₗ[K] MvPolynomial σ K :=
  Fintype.linearCombination K (fun xy : σ × σ => MvPolynomial.X xy.1 * MvPolynomial.X xy.2)

theorem quadraticRelationLinear_apply (q : σ × σ → K) :
    quadraticRelationLinear q = quadraticRelation q := by
  rw [quadraticRelationLinear, Fintype.linearCombination_apply, quadraticRelation]

/-- Every homogeneous quadratic polynomial is encoded by some coefficient matrix. -/
theorem exists_quadraticRelation_eq (f : MvPolynomial σ K) (hf : f.IsHomogeneous 2) :
    ∃ q : σ × σ → K, quadraticRelation q = f := by
  have hmem : f ∈ LinearMap.range (quadraticRelationLinear (K := K) (σ := σ)) := by
    rw [quadraticRelationLinear, Fintype.range_linearCombination]
    rw [MvPolynomial.as_sum f]
    refine Submodule.sum_mem _ (fun e he => ?_)
    have hdeg : Finsupp.degree e = 2 := by
      have := hf (MvPolynomial.mem_support_iff.mp he)
      rw [Finsupp.degree_eq_weight_one]
      exact this
    obtain ⟨a, b, rfl⟩ := exists_pair_of_degree_eq_two e hdeg
    have hmon : MvPolynomial.monomial (Finsupp.single a 1 + Finsupp.single b 1)
        (MvPolynomial.coeff (Finsupp.single a 1 + Finsupp.single b 1) f) =
        MvPolynomial.coeff (Finsupp.single a 1 + Finsupp.single b 1) f •
          (MvPolynomial.X a * MvPolynomial.X b) := by
      rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul,
        MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
    rw [hmon]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(a, b), rfl⟩)
  obtain ⟨q, hq⟩ := hmem
  exact ⟨q, (quadraticRelationLinear_apply q).symm.trans hq⟩

/-- The chosen coefficient matrices of a homogeneous quadratic family. -/
def quadraticCoefficients {ρ : Type*} (rel : ρ → MvPolynomial σ K)
    (hrel : ∀ r, (rel r).IsHomogeneous 2) : ρ → σ × σ → K :=
  fun r => Classical.choose (exists_quadraticRelation_eq (rel r) (hrel r))

theorem quadraticRelation_quadraticCoefficients {ρ : Type*} (rel : ρ → MvPolynomial σ K)
    (hrel : ∀ r, (rel r).IsHomogeneous 2) (r : ρ) :
    quadraticRelation (quadraticCoefficients rel hrel r) = rel r :=
  Classical.choose_spec (exists_quadraticRelation_eq (rel r) (hrel r))

/-- An ideal spanned by homogeneous quadratics is a `quadraticIdeal`. -/
theorem span_homogeneousQuadratic_eq_quadraticIdeal {ρ : Type*}
    (rel : ρ → MvPolynomial σ K) (hrel : ∀ r, (rel r).IsHomogeneous 2) :
    Ideal.span (Set.range rel) = quadraticIdeal (quadraticCoefficients rel hrel) := by
  rw [quadraticIdeal]
  congr 2
  funext r
  exact (quadraticRelation_quadraticCoefficients rel hrel r).symm

end QuadraticGenerators

section Capstone

variable {V : Type*} [AddCommGroup V] [Module ℂ V]
variable {case : HigherRankDeligneCase} {W : VertexOperatorAlgebra V}

/-- Transport of the carrier maps along an equality of ideals. -/
def carrierMaps {ρ : Type} {n : ℕ} (Q : ρ → Fin n × Fin n → ℂ)
    (I : Ideal (MvPolynomial (Fin n) ℂ)) (hI : I = quadraticIdeal Q) :
    {f : ∀ p N, Module.Dual ℂ (PresentedJetLiBidegreeImage (R := ℂ) (fun _ : Fin n => 1) p p N I)
        →ₗ[ℂ] Carrier Q p N // ∀ p N, Function.Injective (f p N)} := by
  subst hI
  exact ⟨toCarrier Q, toCarrier_injective Q⟩

/-- **Geometric carrier embedding for any quadratic current presentation.**  If the displayed
ideal is `quadraticIdeal Q`, the literal current carrier `Carrier Q` receives an injective (on
`p ≤ N`, bijective) restricted-dual map in every bidegree. -/
def geometricCarrierEmbedding_of_quadraticIdeal {ρ : Type}
    (P : CurrentC2Presentation case W)
    (Q : ρ → Fin case.currentDimension × Fin case.currentDimension → ℂ)
    (hQ : P.ideal = quadraticIdeal Q) :
    GeometricCarrierEmbedding case W P (Carrier Q) where
  toCarrier := (carrierMaps Q P.ideal hQ).1
  injective := (carrierMaps Q P.ideal hQ).2

/-- **Geometric carrier embedding for any presentation by homogeneous quadratics.**  This is the
form consumed by the `A₂` instance once the ideal `A2.I2ns := Ideal.span (range relationPoly)`
is available. -/
def geometricCarrierEmbedding_of_span {ρ : Type}
    (P : CurrentC2Presentation case W)
    (rel : ρ → MvPolynomial (Fin case.currentDimension) ℂ)
    (hrel : ∀ r, (rel r).IsHomogeneous 2)
    (hP : P.ideal = Ideal.span (Set.range rel)) :
    GeometricCarrierEmbedding case W P (Carrier (quadraticCoefficients rel hrel)) :=
  geometricCarrierEmbedding_of_quadraticIdeal P _
    (hP.trans (span_homogeneousQuadratic_eq_quadraticIdeal rel hrel))

end Capstone

end

end VOA.DeligneAudit.CarrierEmbedding

