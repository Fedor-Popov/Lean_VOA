import VOA.DeligneAudit.DeligneFusionCVBaseOne
import VOA.DeligneAudit.DeligneFusionCVUnivDimension

/-!
# The actual zero-epsilon one-adjoint quotient and dimension step

For `ν₁ > 0`, the one-generator quotient has the exact presentation proved
in `CVBaseOne`. Its actual kernel is the cyclic submodule generated by the
first-root top vector. Rank-nullity then gives the two-term base dimension
step from finite-dimensionality of the two zero-adjoint source modules.
No dimension bound or exactness assumption is introduced.
-/

namespace VOA.DeligneAudit.A2.CVBaseOne

open VOA.AffineSl3 VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.A2.CVFamily VOA.DeligneAudit.A2.CVUniv

noncomputable section

def quotientMap (ν ϱ : Weight) (hν : 0 < ν.1) :
    CVMod (0, 0) ν ϱ 1 →ₗ[ℂ] CVMod (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0 :=
  cvMap ((quotient_rel_iff hν).mp
    (cvUniv_rel (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0)).1

theorem quotientMap_wordOp (ν ϱ : Weight) (hν : 0 < ν.1) (l : List (UnivG.Ltr 8)) :
    quotientMap ν ϱ hν (wordOp (cvUnivRep (0, 0) ν ϱ 1) l (cv_wU (0, 0) ν ϱ 1)) =
      wordOp (cvUnivRep (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0) l
        (cv_wU (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0) :=
  cvMap_wordOp _ l

theorem quotientMap_cycDeg (ν ϱ : Weight) (hν : 0 < ν.1) (d : ℕ) :
    (cycDeg (cvUnivRep (0, 0) ν ϱ 1) (cv_wU (0, 0) ν ϱ 1) d).map (quotientMap ν ϱ hν) =
      cycDeg (cvUnivRep (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0)
        (cv_wU (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0) d :=
  map_cycDeg ((quotient_rel_iff hν).mp
    (cvUniv_rel (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0)).1 d

theorem quotientMap_surjective (ν ϱ : Weight) (hν : 0 < ν.1) :
    Function.Surjective (quotientMap ν ϱ hν) := by
  apply LinearMap.range_eq_top.mp
  apply top_unique
  rw [← cv_span_top (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0]
  apply Submodule.span_le.mpr
  rintro _ ⟨l, rfl⟩
  exact ⟨wordOp (cvUnivRep (0, 0) ν ϱ 1) l (cv_wU (0, 0) ν ϱ 1),
    quotientMap_wordOp ν ϱ hν l⟩

def kernelGenerator (ν ϱ : Weight) : CVMod (0, 0) ν ϱ 1 :=
  (cvUnivRep (0, 0) ν ϱ 1).op 3 (ν.1 + ϱ.1) (cv_wU (0, 0) ν ϱ 1)

def kernelSpan (ν ϱ : Weight) : Submodule ℂ (CVMod (0, 0) ν ϱ 1) :=
  cycSub (cvUnivRep (0, 0) ν ϱ 1) (kernelGenerator ν ϱ)

theorem kernelSpan_inv (ν ϱ : Weight) (c : Fin 8) (r : ℕ) :
    kernelSpan ν ϱ ≤ (kernelSpan ν ϱ).comap ((cvUnivRep (0, 0) ν ϱ 1).op c r) :=
  cycSub_inv _ _ c r

theorem kernelGenerator_mem (ν ϱ : Weight) : kernelGenerator ν ϱ ∈ kernelSpan ν ϱ :=
  wordOp_mem_cycSub _ _ []

theorem kernelSpan_le_ker (ν ϱ : Weight) (hν : 0 < ν.1) :
    kernelSpan ν ϱ ≤ LinearMap.ker (quotientMap ν ϱ hν) := by
  have ht := ((quotient_rel_iff hν).mp
    (cvUniv_rel (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0)).2
  rw [kernelSpan, cycSub, Submodule.span_le]
  rintro _ ⟨l, rfl⟩
  change quotientMap ν ϱ hν
    (wordOp (cvUnivRep (0, 0) ν ϱ 1) l (kernelGenerator ν ϱ)) = 0
  have hw : wordOp (cvUnivRep (0, 0) ν ϱ 1) l (kernelGenerator ν ϱ) =
      wordOp (cvUnivRep (0, 0) ν ϱ 1) (l ++ [(3, ν.1 + ϱ.1)])
        (cv_wU (0, 0) ν ϱ 1) := by
    rw [wordOp_append]
    rfl
  rw [hw, quotientMap_wordOp, wordOp_append]
  change wordOp (cvUnivRep (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0) l
    ((cvUnivRep (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0).op 3 (ν.1 + ϱ.1)
      (cv_wU (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0)) = 0
  rw [ht, wordOp_zero]

def kernelQuotientRep (ν ϱ : Weight) :
    CurrentModule bracketTable (CVMod (0, 0) ν ϱ 1 ⧸ kernelSpan ν ϱ) :=
  quotRep (cvUnivRep (0, 0) ν ϱ 1) (kernelSpan ν ϱ) (kernelSpan_inv ν ϱ)

theorem kernelQuotient_rel (ν ϱ : Weight) (hν : 0 < ν.1) :
    CV3Rel (kernelQuotientRep ν ϱ) ((kernelSpan ν ϱ).mkQ (cv_wU (0, 0) ν ϱ 1))
      (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0 := by
  have hs := cv3Rel_quotient (cvUniv_rel (0, 0) ν ϱ 1)
    (kernelSpan ν ϱ) (kernelSpan_inv ν ϱ)
  apply quotient_rel hs hν
  rw [quotRep_op]
  exact (Submodule.Quotient.mk_eq_zero _).mpr (kernelGenerator_mem ν ϱ)

def quotientInverse (ν ϱ : Weight) (hν : 0 < ν.1) :
    CVMod (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0 →ₗ[ℂ]
      (CVMod (0, 0) ν ϱ 1 ⧸ kernelSpan ν ϱ) :=
  cvMap (kernelQuotient_rel ν ϱ hν)

theorem quotientInverse_comp (ν ϱ : Weight) (hν : 0 < ν.1) :
    (quotientInverse ν ϱ hν).comp (quotientMap ν ϱ hν) = (kernelSpan ν ϱ).mkQ := by
  apply LinearMap.ext_on_range (cv_span_top (0, 0) ν ϱ 1)
  intro l
  rw [LinearMap.comp_apply, quotientMap_wordOp]
  change cvMap (kernelQuotient_rel ν ϱ hν)
    (wordOp (cvUnivRep (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0) l
      (cv_wU (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0)) = _
  rw [cvMap_wordOp]
  dsimp only [kernelQuotientRep]
  rw [quot_wordOp]

theorem quotientMap_ker (ν ϱ : Weight) (hν : 0 < ν.1) :
    LinearMap.ker (quotientMap ν ϱ hν) = kernelSpan ν ϱ := by
  apply le_antisymm _ (kernelSpan_le_ker ν ϱ hν)
  intro x hx
  have he := congrArg (fun f => f x) (quotientInverse_comp ν ϱ hν)
  change quotientInverse ν ϱ hν (quotientMap ν ϱ hν x) = (kernelSpan ν ϱ).mkQ x at he
  rw [LinearMap.mem_ker.mp hx, map_zero] at he
  exact (Submodule.Quotient.mk_eq_zero _).mp he.symm

def kernelMap (ν ϱ : Weight) (hν : 0 < ν.1) :
    CVMod (1, 0) (ν - (1, 0) + (0, 1)) ϱ 0 →ₗ[ℂ] CVMod (0, 0) ν ϱ 1 :=
  cvMap (kernel_rel (cvUniv_rel (0, 0) ν ϱ 1) hν)

theorem kernelMap_range (ν ϱ : Weight) (hν : 0 < ν.1) :
    LinearMap.range (kernelMap ν ϱ hν) = kernelSpan ν ϱ :=
  cvMap_range _

/-- The genuine zero-epsilon `j=1` dimension step for a positive first
rectangular multiplicity. Only finiteness of the two zero-adjoint modules is assumed. -/
theorem dimension_step (ν ϱ : Weight) (hν : 0 < ν.1)
    [FiniteDimensional ℂ (CVMod (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0)]
    [FiniteDimensional ℂ (CVMod (1, 0) (ν - (1, 0) + (0, 1)) ϱ 0)] :
    FiniteDimensional ℂ (CVMod (0, 0) ν ϱ 1) ∧
      Module.finrank ℂ (CVMod (0, 0) ν ϱ 1) ≤
        Module.finrank ℂ (CVMod (0, 1) (ν - (1, 0)) (ϱ + (1, 0)) 0) +
        Module.finrank ℂ (CVMod (1, 0) (ν - (1, 0) + (0, 1)) ϱ 0) := by
  haveI : FiniteDimensional ℂ (kernelSpan ν ϱ) := by
    rw [← kernelMap_range ν ϱ hν]
    infer_instance
  haveI : FiniteDimensional ℂ (CVMod (0, 0) ν ϱ 1) :=
    Module.Finite.of_exact (f := (kernelSpan ν ϱ).subtype) (g := quotientMap ν ϱ hν)
      (LinearMap.exact_iff.mpr (by rw [Submodule.range_subtype, quotientMap_ker]))
      (quotientMap_surjective ν ϱ hν)
  refine ⟨inferInstance, ?_⟩
  have hk := LinearMap.finrank_range_le (kernelMap ν ϱ hν)
  rw [kernelMap_range] at hk
  have he := (quotientMap ν ϱ hν).finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr (quotientMap_surjective ν ϱ hν), finrank_top,
    quotientMap_ker] at he
  omega

end

end VOA.DeligneAudit.A2.CVBaseOne

