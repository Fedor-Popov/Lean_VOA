/-- The cert structure constants as a function. -/
def sZ (a b c : Fin 28) : ℤ := ((sL a b).map fun t => if t.1 = c then t.2 else 0).sum

/-- The lattice-model bracket table. -/
def model (a b c : Fin 28) : ℤ :=
  if a.val < 4 then
    if b.val < 4 then 0 else if c = b then formZ (hvec a) (wt b) else 0
  else if b.val < 4 then (if c = a then -formZ (hvec b) (wt a) else 0)
  else if formZ (wt a) (wt b) = -2 then
    (if c.val < 4 then u a * u b * sgn (ep (wt a) (wt b)) * wt a ⟨c.val % 4, Nat.mod_lt _ (by norm_num)⟩ else 0)
  else if formZ (wt a) (wt b) = -1 then
    (if c = tgt a b then u a * u b * sgn (ep (wt a) (wt b)) * u c else 0)
  else 0

theorem sZ_eq_model : ∀ a b c, sZ a b c = model a b c := by decide +kernel

theorem u_mul_self : ∀ a, u a * u a = 1 := by decide +kernel

theorem wt_norm : ∀ a : Fin 28, 4 ≤ a.val → formZ (wt a) (wt a) = 2 := by decide +kernel

/-- `wt`, with the Cartan indices sent to a root. -/
def wtR (a : Fin 28) : Lat := if 4 ≤ a.val then wt a else wt 4

theorem wtR_norm : ∀ a : Fin 28, formZ (wtR a) (wtR a) = 2 := by decide +kernel

theorem wtR_root (a : Fin 28) (h : 4 ≤ a.val) : wtR a = wt a := by rw [wtR, if_pos h]

theorem form_ge : ∀ a b : Fin 28, 4 ≤ a.val → 4 ≤ b.val → -2 ≤ formZ (wt a) (wt b) := by decide +kernel

theorem opp_of_form : ∀ a b : Fin 28, 4 ≤ a.val → 4 ≤ b.val → formZ (wt a) (wt b) = -2 →
    wt b = -wt a := by decide +kernel

theorem tgt_spec : ∀ a b : Fin 28, 4 ≤ a.val → 4 ≤ b.val → formZ (wt a) (wt b) = -1 →
    4 ≤ (tgt a b).val ∧ wt (tgt a b) = wt a + wt b := by decide +kernel

