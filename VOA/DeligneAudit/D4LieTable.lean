import Mathlib

/-!
# Integer tables for the `D₄` cert basis (generated)

The basis of `Notes/deligne/audit_2026_10_25/casimir_cert/cert_D4.json` (= `singular_cert`): indices
`0..3` the Cartan elements `H_i = [E_i, F_i]`, then the 24 root vectors with weights `wt`.  `sL` is
the cert's structure-constant table.  `model` is the bracket table of the rescaled lattice basis
`x_i = α_i(-1)𝟙`, `x_a = u_a f(wt a) e^{wt a}` of `(V_{D₄})₁` computed with the explicit cocycle
`ε' = (-1)^{ep}` (`D4LieCocycle`); `sZ_eq_model` checks (kernel `decide`) that it is the cert table.
-/

namespace VOA.DeligneAudit.D4Lie

set_option linter.style.longLine false

/-- Coordinates of the `D₄` root lattice. -/
abbrev Lat := Fin 4 → ℤ

/-- The `D₄` form `⟨v,w⟩ = vᵀ G w` (Cartan matrix of `CartanMatrix.D 4`). -/
def formZ (v w : Lat) : ℤ :=
  v 0 * (2 * w 0 - w 1) + v 1 * (-w 0 + 2 * w 1 - w 2 - w 3) + v 2 * (-w 1 + 2 * w 2) +
    v 3 * (-w 1 + 2 * w 3)

/-- The explicit cocycle exponent `ep v w = ∑ vᵢ wⱼ T'ᵢⱼ`, `T'` upper triangular. -/
def ep (v w : Lat) : ℤ :=
  v 0 * (w 0 - w 1) + v 1 * (w 1 - w 2 - w 3) + v 2 * w 2 + v 3 * w 3

/-- `(-1)^n` as an integer. -/
def sgn (n : ℤ) : ℤ := if n % 2 = 0 then 1 else -1

/-- The unit vector of a Cartan index. -/
def hvec (a : Fin 28) : Lat := fun j => if j.val = a.val then 1 else 0

/-- Weights (simple-root coordinates) of the cert basis; Cartan entries are `0`. -/

