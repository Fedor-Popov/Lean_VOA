/-- The trace of `ad x_a ∘ ad x_c` in the cert basis, through the sparse table. -/
def killZ (a c : Fin 28) : ℤ := ∑ e, ((sL c e).map fun t => t.2 * sZ a t.1 e).sum

/-- **Killing form = 12 · cert form** (so `Killing/12` is the cert normalization). -/
theorem killZ_eq : ∀ a c, killZ a c = 12 * Gz a c := by decide +kernel

/-- `Gz · (Gi2/2) = 1`. -/
theorem pair_cert : ∀ a b, ∑ c, Gz a c * Gi2 b c = if a = b then 2 else 0 := by decide +kernel

