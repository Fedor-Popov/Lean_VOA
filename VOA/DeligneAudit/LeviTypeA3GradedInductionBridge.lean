import VOA.DeligneAudit.LeviTypeA3GradedWordResidual
import VOA.DeligneAudit.LeviTypeA3GradedThirdTotal

/-! The two lower-mode spans are generated by sorted words at the same key. -/

namespace VOA.DeligneAudit.A3Sector

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.LeviConversion

noncomputable section

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule bracketTable V) (w : V)

theorem a3_higher_le_effective (a b c : ℕ) (k : A3RadicalKey) :
    a3HigherLeviClosure ρ w b c k ≤ a3EffectiveTarget ρ w a b c k := by
  by_cases hs : k.d₁ ≤ a ∧ k.d₂ ≤ b ∧ k.d₃ ≤ c
  · simp only [a3EffectiveTarget, if_pos hs, a3ThreeBoxTarget]
    exact le_sup_right
  · simp only [a3EffectiveTarget, if_neg hs]
    exact le_rfl

theorem a3_first_lower_le_effective (a b c : ℕ)
    (zs : List ℕ) (d₁ d₂ degree σ : ℕ)
    (hword : ∀ xs ys : List ℕ,
      xs.length = d₁ → ys.length = d₂ →
      xs.sum + ys.sum = degree → xs.sum < σ →
      (aWord (fun i => ρ.op (F 0) i) xs *
        (ys.map fun i => ρ.op (F 1) i).prod *
        (zs.map fun i => ρ.op (F 2) i).prod) w ∈
        a3EffectiveTarget ρ w a b c
          ⟨d₁, d₂, zs.length, degree + zs.sum⟩) :
    a3PairModeLowerSpan ρ w 0 zs d₁ d₂ degree σ ≤
      a3EffectiveTarget ρ w a b c
        ⟨d₁, d₂, zs.length, degree + zs.sum⟩ := by
  rw [a3PairModeLowerSpan, Submodule.span_le]
  intro v hv
  obtain ⟨xs, ys, hx, hy, hd, hs, rfl⟩ := hv
  simpa only [a3ConvA, a3ConvB, a3ConvSpectator, mul_assoc,
    Module.End.mul_apply] using hword xs ys hx hy hd hs

theorem a3_second_lower_le_effective (a b c : ℕ)
    (fs : List ℕ) (d₂ d₃ degree σ : ℕ)
    (hword : ∀ ys zs : List ℕ,
      ys.length = d₂ → zs.length = d₃ →
      ys.sum + zs.sum = degree → ys.sum < σ →
      (aWord (fun i => ρ.op (F 0) i) fs *
        (ys.map fun i => ρ.op (F 1) i).prod *
        (zs.map fun i => ρ.op (F 2) i).prod) w ∈
        a3EffectiveTarget ρ w a b c
          ⟨fs.length, d₂, d₃, fs.sum + degree⟩) :
    a3PairModeLowerSpan ρ w 1 fs d₂ d₃ degree σ ≤
      a3EffectiveTarget ρ w a b c
        ⟨fs.length, d₂, d₃, fs.sum + degree⟩ := by
  rw [a3PairModeLowerSpan, Submodule.span_le]
  intro v hv
  obtain ⟨ys, zs, hy, hz, hd, hs, rfl⟩ := hv
  have hr := a3_rotate_radical_words ρ w fs ys zs
  have hh := hword ys zs hy hz hd hs
  rw [← hr] at hh
  simpa only [a3ConvA, a3ConvB, a3ConvSpectator, mul_assoc,
    Module.End.mul_apply] using hh

end
end VOA.DeligneAudit.A3Sector

#print axioms VOA.DeligneAudit.A3Sector.a3_higher_le_effective
#print axioms VOA.DeligneAudit.A3Sector.a3_first_lower_le_effective
#print axioms VOA.DeligneAudit.A3Sector.a3_second_lower_le_effective
