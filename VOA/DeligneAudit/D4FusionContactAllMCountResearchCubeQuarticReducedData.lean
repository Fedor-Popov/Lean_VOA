import VOA.DeligneAudit.D4FusionContactAllMCountResearchCubeQuarticReducedSyntax

/-! Exact cleared-denominator certificate data for fixed small color-jet identities. -/
namespace VOA.DeligneAudit.D4FusionContact.AllMCountResearch.Cube.QuarticReduced
open QuarticReducedRows

structure ProductSpec where
  coeff : ℤ
  a : ℕ
  b : ℕ
  x2 : ℕ
  y2 : ℕ
  z2 : ℕ
  x3 : ℕ
  y3 : ℕ
  z3 : ℕ

def productRow (p : ProductSpec) : Row ℕ :=
  QuarticReducedRows.mul (jetRow p.a 2 p.x2 p.y2 p.z2)
    (jetRow p.b 3 p.x3 p.y3 p.z3)

def bit (c : Fin 8) (d : ℕ) : ℕ := (c.val / 2^d) % 2

def channelWeight (h c : Fin 8) : ℤ :=
  (if bit c 0 = 0 then 1 else if bit h 0 = 0 then -3 else 2) *
  (if bit c 1 = 0 then 1 else if bit h 1 = 0 then -3 else 2) *
  (if bit c 2 = 0 then 1 else if bit h 2 = 0 then -3 else 2)

def targetRow (j : ℕ) (h : Fin 8) : Row ℕ :=
  collect ((List.finRange 8).flatMap fun c =>
    scale (channelWeight h c) (QuarticReducedRows.mul [([8*j+c.val],1)]
      (QuarticReducedRows.map Fin.val
        (orbitRow 4 (2-bit c 0) (2-bit c 1) (2-bit c 2)))))

