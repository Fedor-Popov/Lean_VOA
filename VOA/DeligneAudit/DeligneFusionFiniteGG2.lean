import VOA.DeligneAudit.DeligneFusionFiniteG
import VOA.DeligneAudit.G2Sector

/-!
# The finiteness clause for `G2`

Generated by `Notes/deligne/campaign/generators/gen_finite_cert.py g2`.

A 4-step nilpotency certificate (`g2Cert`, each step `(X, Y, path)` an `ad X`-string from a
known letter `Y` to its top) reaches every low letter of `G2sector` from the raising letters and
the simple lowering letters. Hence

`g2_finiteTable : FiniteTableG G2sector` and
`g2_fusionTotalBoundG_of_dim : FusionTotalDimG G2sector → FusionTotalBoundG G2sector`.
-/

set_option maxRecDepth 100000

namespace VOA.DeligneAudit.FiniteG.G2

open VOA.DeligneAudit.DeligneSector VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneSector.G2 VOA.DeligneAudit.DeligneSector.Sparse

/-- Raising letters and simple lowering letters. -/
def g2Kn (c : Fin 14) : Bool := decide (c.val ∈ posL) || decide (c.val ∈ ([4, 13] : List ℕ))

/-- The integer structure constants. -/
def g2Fz (a b c : Fin 14) : ℤ := fZ br a.val b.val c.val

/-- The certificate. -/
def g2Cert : List (Step 14) := [(4, 13, [11, 8, 3]),
  (13, 3, [12]),
  (13, 4, [11]),
  (3, 10, [8])]

theorem g2_certValid :
    certValid G2sector.wt (fun a b c => g2Fz a b c != 0) g2Kn g2Cert = true := by
  decide +kernel

theorem g2_cov : ∀ c : Fin 14, (certKnown g2Kn g2Cert c && !wEqB (G2sector.wt c) 0) = true ∨
    G2sector.raising c ∨ G2sector.cartan c ∨ G2sector.cartanN c := by
  change ∀ c : Fin 14, (certKnown g2Kn g2Cert c &&
      !wEqB (wtS c) 0) = true ∨
    (c.val ∈ posL) ∨ (c.val ∈ ([0] : List ℕ)) ∨ (c.val ∈ ([1] : List ℕ))
  decide +kernel

theorem g2_kn : ∀ c : Fin 14, g2Kn c = true → G2sector.raising c ∨ G2sector.lowering c := by
  change ∀ c : Fin 14, g2Kn c = true →
    (c.val ∈ posL) ∨ (c.val ∈ ([4, 13] : List ℕ))
  intro c h
  simpa [g2Kn] using h

/-- **The finiteness table facts for `G2`.** -/
theorem g2_finiteTable : FiniteTableG G2sector :=
  finiteTableG_of_cert (fnz_of_table (fz := g2Fz) (fun _ _ _ => rfl)) g2Kn g2Cert g2_kn
    g2_certValid g2_cov

/-- **`FusionTotalBoundG G2sector` reduces to the bare dimension bound.** -/
theorem g2_fusionTotalBoundG_of_dim (h : FusionTotalDimG G2sector) :
    FusionTotalBoundG G2sector :=
  fusionTotalBoundG_of_dim g2_finiteTable h

end VOA.DeligneAudit.FiniteG.G2

section AxiomAudit
#print axioms VOA.DeligneAudit.FiniteG.G2.g2_finiteTable
#print axioms VOA.DeligneAudit.FiniteG.G2.g2_fusionTotalBoundG_of_dim
end AxiomAudit
