import VOA.DeligneAudit.D4FusionToroidalPresentedTwoLayerCommute

/-! The first positive layer is generated by the two surviving letters. -/

namespace VOA.DeligneAudit.Toroidal

open VOA.DeligneAudit.UnivG VOA.DeligneAudit.DeligneSector.D4

noncomputable section

theorem two_degree_one_word : ∀ (l : List (TLtr 28)), twoUDeg l = 1 →
    wordOpT (ρPTE 2) l (pTE 2) ∈ twoPositiveSpan := by
  intro l
  induction l with
  | nil =>
      intro hl
      simp [twoUDeg] at hl
  | cons x l ih =>
      intro hl
      by_cases hi : x.2.1 = 0
      · have hl' : twoUDeg l = 1 := by
          simp only [twoUDeg] at hl
          omega
        change (ρPTE 2).op x.1 x.2.1 x.2.2
          (wordOpT (ρPTE 2) l (pTE 2)) ∈ twoPositiveSpan
        rw [hi]
        exact twoPositiveSpan_op_zero x.1 x.2.2 (ih hl')
      · have hxi : x.2.1 = 1 := by
          simp only [twoUDeg] at hl
          omega
        have hl0 : twoUDeg l = 0 := by
          simp only [twoUDeg] at hl
          omega
        change (ρPTE 2).op x.1 x.2.1 x.2.2
          (wordOpT (ρPTE 2) l (pTE 2)) ∈ twoPositiveSpan
        rw [hxi]
        exact two_one_on_pure l hl0 x.1 x.2.2

theorem twoN_one_le_two_generators :
    twoN 1 ≤ twoN 2 ⊔ (twoM 0 ⊔ twoM 1) := by
  change twoN 1 ≤ twoN 2 ⊔ twoPositiveSpan
  rw [twoN, Submodule.span_le]
  rintro v ⟨l, hl, rfl⟩
  by_cases h2 : 2 ≤ twoUDeg l
  · exact (show twoN 2 ≤ twoN 2 ⊔ twoPositiveSpan from le_sup_left)
      (twoN_word 2 l h2)
  · have h1 : twoUDeg l = 1 := by omega
    exact (show twoPositiveSpan ≤ twoN 2 ⊔ twoPositiveSpan from le_sup_right)
      (two_degree_one_word l h1)

end

end VOA.DeligneAudit.Toroidal

