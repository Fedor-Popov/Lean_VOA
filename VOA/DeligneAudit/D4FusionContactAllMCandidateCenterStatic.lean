import VOA.DeligneAudit.D4FusionContactAllMCandidateStatic
import VOA.DeligneAudit.D4FusionContactAllMCountResearchCenterContactCoverage

/-! Static generators of the C branch, for every m. A whole static C-polar is
coeff_t(C^p * A_e1 * ... * A_en) with 2m < p + n + t. Seed shifts preserve the
ideal of admissible whole C-power coefficients by the exact mode recurrence;
a contact turns a C-polar into a first-power tail, and the tail identity
z^k tail_k(A) = A - (A_0 + ... + A_(k-1) z^(k-1)) returns admissible C-polars.
Conversely every C-polar is a nonzero multiple of a static contact word on an
admissible seed. Together with the U branch, the original candidate ideal is
generated by whole static polar coefficients alone. No count is asserted. -/
namespace VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
open VOA.DeligneAudit.SectorWeyl
open VOA.DeligneAudit.D4FusionContact.Polynomial
open Cube (tailSeries tailSeries_coeff)
noncomputable section

/-- A whole static C-polar: C^p times the A currents of the colors in l. -/
def centerPolar (m p : ℕ) (l : List (Fin 8)) (t : ℕ) : Ring ℂ m :=
  PowerSeries.coeff t
    (colorCurrent ℂ m 8 ^ p * (l.map fun e => colorCurrent ℂ m e.castSucc).prod)

def centerPolarSeeds (m : ℕ) : Set (Ring ℂ m) :=
  {x | ∃ p l t, 2 * m < p + l.length + t ∧ x = centerPolar m p l t}

def centerPolarIdeal (m : ℕ) : Ideal (Ring ℂ m) := Ideal.span (centerPolarSeeds m)

/-- A derivation preserving the generators preserves the generated ideal. -/
theorem derivation_span_closed {A : Type*} [CommRing A] [Algebra ℂ A]
    (D : Derivation ℂ A A) (S : Set A) (hS : ∀ s ∈ S, D s ∈ Ideal.span S) :
    ∀ x ∈ Ideal.span S, D x ∈ Ideal.span S := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx => exact hS x hx
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul a x hx ih =>
      rw [smul_eq_mul,Derivation.leibniz,smul_eq_mul,smul_eq_mul]
      exact add_mem (Ideal.mul_mem_left _ _ ih) (Ideal.mul_mem_right _ _ hx)

theorem contactKilled_colorProd (m : ℕ) (l : List (Fin 8)) :
    ContactKilled m (l.map fun e => colorCurrent ℂ m e.castSucc).prod := by
  induction l with
  | nil => exact contactKilled_one m
  | cons e l ih =>
      simp only [List.map_cons,List.prod_cons]
      have h := contactKilled_tail m e.castSucc (castSucc_ne_center e) 0
      rw [tailSeries_zero] at h
      exact contactKilled_mul h ih

/-- One contact on a C-polar lands in the C-polar ideal. -/
theorem contact_centerPolar_mem (m : ℕ) (e : Fin 8) (k p : ℕ) (l : List (Fin 8)) (t : ℕ)
    (h : 2 * m < p + l.length + t) :
    deriv ℂ m (Fin.natAdd 10 e) k (centerPolar m p l t) ∈ centerPolarIdeal m := by
  set P := (l.map fun e => colorCurrent ℂ m e.castSucc).prod with hP
  have hpol := wordOp_contacts_center_pow m p t [(e,k)] P (contactKilled_colorProd m l)
  change deriv ℂ m (Fin.natAdd 10 e) k (PowerSeries.coeff t (colorCurrent ℂ m 8 ^ p * P)) =
    _ at hpol
  rw [centerPolar,← hP,hpol]
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp
  have hrw : colorCurrent ℂ m 8 ^ (p - [(e,k)].length) * (contactProduct m [(e,k)] * P) =
      tailSeries k (colorCurrent ℂ m e.castSucc) * (colorCurrent ℂ m 8 ^ (p - 1) * P) := by
    simp only [List.length_cons,List.length_nil,contactProduct,List.map_cons,List.map_nil,
      List.prod_cons,List.prod_nil,mul_one]
    ring
  rw [hrw,map_nsmul,Cube.coeff_tailSeries_mul]
  apply nsmul_mem
  apply Ideal.sub_mem
  · apply Ideal.subset_span
    refine ⟨p - 1,e :: l,t + k,by simp only [List.length_cons]; omega,?_⟩
    simp only [centerPolar,List.map_cons,List.prod_cons]
    congr 1
    ring
  · apply Submodule.sum_mem
    intro a ha
    apply Ideal.mul_mem_left
    apply Ideal.subset_span
    exact ⟨p - 1,l,t + k - a,by simp only [Finset.mem_range] at ha; omega,rfl⟩

/-- Static contact words preserve the C-polar ideal. -/
theorem wordOp_contacts_centerPolar_mem (m : ℕ) (l : List (Fin 8 × ℕ)) {x : Ring ℂ m}
    (hx : x ∈ centerPolarIdeal m) :
    wordOp (representation ℂ m) (l.map contactOp) x ∈ centerPolarIdeal m := by
  induction l with
  | nil => exact hx
  | cons y l ih =>
      rw [List.map_cons,wordOp_cons]
      apply derivation_span_closed (deriv ℂ m (Fin.natAdd 10 y.1) y.2) (centerPolarSeeds m) _ _ ih
      rintro s ⟨p,l',t,h,rfl⟩
      exact contact_centerPolar_mem m y.1 y.2 p l' t h

/-- Admissible whole C-power coefficients in the one-color ring. -/
def monoCenterSeeds (m : ℕ) : Set (MonoRing ℂ m) :=
  {x | ∃ r t, 2 * m < r + t ∧ x = PowerSeries.coeff t (monoCurrent ℂ m ^ r)}

def monoCenterIdeal (m : ℕ) : Ideal (MonoRing ℂ m) := Ideal.span (monoCenterSeeds m)

/-- Seed shifts preserve the admissible C-power coefficients, by the exact recurrence. -/
theorem monoShift_monoCenter_mem (m ell r t : ℕ) (h : 2 * m < r + t) :
    monoShift ℂ m ell (PowerSeries.coeff t (monoCurrent ℂ m ^ r)) ∈ monoCenterIdeal m := by
  rcases r with _ | r
  · rw [pow_zero,PowerSeries.coeff_one]
    split_ifs <;> simp
  have h0 : seriesDerivation (monoShift ℂ m 0) (monoCurrent ℂ m) = monoCurrent ℂ m := by
    rw [monoShift_series,tailSeries_zero]
  rw [Cube.coefficient_power_mode_recurrence (monoShift ℂ m ell) (monoShift ℂ m 0)
    (monoCurrent ℂ m) (monoCurrent ℂ m) r t ell (monoShift_series m ell) h0,
    Cube.derivation_power_coeff (monoShift ℂ m 0) (monoCurrent ℂ m) (monoCurrent ℂ m) r
      (t + ell) h0,← pow_succ']
  apply Ideal.sub_mem
  · apply nsmul_mem
    exact Ideal.subset_span ⟨r + 1,t + ell,by omega,rfl⟩
  · apply nsmul_mem
    apply Submodule.sum_mem
    intro a ha
    apply Ideal.mul_mem_left
    exact Ideal.subset_span ⟨r,t + ell - a,by simp only [Finset.mem_range] at ha; omega,rfl⟩

theorem shiftWord_monoCenter_mem (m : ℕ) (ks : List ℕ) {x : MonoRing ℂ m}
    (hx : x ∈ monoCenterIdeal m) : shiftWord m ks x ∈ monoCenterIdeal m := by
  induction ks with
  | nil => exact hx
  | cons k ks ih =>
      apply derivation_span_closed (monoShift ℂ m k) (monoCenterSeeds m) _ _ ih
      rintro s ⟨r,t,h,rfl⟩
      exact monoShift_monoCenter_mem m k r t h

theorem monoMap_monoCenter_mem (m : ℕ) {x : MonoRing ℂ m} (hx : x ∈ monoCenterIdeal m) :
    monoMap ℂ m 8 x ∈ centerPolarIdeal m := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨r,t,h,rfl⟩ := hx
      rw [monoMap_seed]
      exact Ideal.subset_span ⟨r,[],t,by simpa using h,by simp [centerPolar]⟩
  | zero => rw [map_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul a x _ ih => rw [smul_eq_mul,map_mul]; exact Ideal.mul_mem_left _ _ ih

/-- Every original C source lies in the C-polar ideal, for every m. -/
theorem center_source_mem_centerPolar (m : ℕ) (i : OrbitSourceIndex m)
    (hb : i.seed.val.1 = true) : orbitSourcePoly m i ∈ centerPolarIdeal m := by
  have hth : 2 * m < i.seed.val.2.1 + i.seed.val.2.2 := by
    simpa only [AllM.seedThreshold,hb,if_true] using i.seed.property.2
  have hseed : monoSeed m i.seed ∈ monoCenterIdeal m :=
    Ideal.subset_span ⟨i.seed.val.2.1,i.seed.val.2.2,hth,rfl⟩
  have hcat : ∀ x ∈ i.outer, category x.1 = 0 := by
    intro x hx
    simpa only [branchCategory,hb,if_true] using i.branch x hx
  rw [orbitSourcePoly,sourceWord,← outer_eq_contacts i.outer hcat]
  have hc : sourceColor i.seed.val.1 = 8 := by simp [sourceColor,hb]
  rw [hc]
  exact wordOp_contacts_centerPolar_mem m _
    (monoMap_monoCenter_mem m (shiftWord_monoCenter_mem m i.shifts hseed))

/-- Every C-polar is a nonzero multiple of a static contact word on a seed. -/
theorem centerPolar_mem_candidate (m p : ℕ) (l : List (Fin 8)) (t : ℕ)
    (h : 2 * m < p + l.length + t) : centerPolar m p l t ∈ AllM.candidateIdeal m := by
  rcases Nat.eq_zero_or_pos (p + l.length) with hr | hr
  · have hp : p = 0 := by omega
    have hl : l = [] := List.eq_nil_of_length_eq_zero (by omega)
    subst hp hl
    simp only [centerPolar,pow_zero,List.map_nil,List.prod_nil,mul_one,PowerSeries.coeff_one]
    rw [if_neg (by omega)]
    exact zero_mem _
  set n := l.length
  have h2 : 2 * m < p + n + t := by omega
  let j : AllM.SeedIndex m := ⟨(true,p + n,t),hr,h2⟩
  have hseed := AllM.seed_mem_candidate m j
  have hword := word_mem_candidate m ((l.map fun e => (e,0)).map contactOp) hseed
  have hpol := wordOp_contacts_center_pow m (p + n) t (l.map fun e => (e,0)) 1
    (contactKilled_one m)
  have hseq : AllM.seedPoly m j = PowerSeries.coeff t (colorCurrent ℂ m 8 ^ (p + n) * 1) := by
    rw [mul_one]
    rfl
  rw [hseq,hpol] at hword
  have hprod : contactProduct m (l.map fun e => (e,0)) =
      (l.map fun e => colorCurrent ℂ m e.castSucc).prod := by
    simp only [contactProduct,List.map_map,Function.comp_def,tailSeries_zero]
  rw [hprod,List.length_map,show p + n - n = p by omega,mul_one,map_nsmul] at hword
  have hc : (((p + n).descFactorial n : ℕ) : ℂ) • centerPolar m p l t ∈
      (AllM.candidateIdeal m).restrictScalars ℂ := by
    simpa only [Nat.cast_smul_eq_nsmul ℂ,centerPolar] using hword
  have hne : (((p + n).descFactorial n : ℕ) : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.descFactorial_pos.mpr (by omega)).ne'
  exact (Submodule.smul_mem_iff _ hne).mp hc

theorem centerPolarIdeal_le_candidate (m : ℕ) : centerPolarIdeal m ≤ AllM.candidateIdeal m := by
  apply Ideal.span_le.mpr
  rintro x ⟨p,l,t,h,rfl⟩
  exact centerPolar_mem_candidate m p l t h

/-- MAIN: the original candidate ideal is generated by whole static polar
coefficients alone (U polars and C-polars), for every m. -/
theorem candidateIdeal_eq_staticPolar_sup_centerPolar (m : ℕ) :
    AllM.candidateIdeal m = staticPolarIdeal m ⊔ centerPolarIdeal m := by
  apply le_antisymm
  · rw [candidateIdeal_eq_staticPolar_sup_center]
    apply sup_le_sup_left
    apply Ideal.span_le.mpr
    rintro x ⟨i,hb,rfl⟩
    exact center_source_mem_centerPolar m i hb
  · exact sup_le (staticPolarIdeal_le_candidate m) (centerPolarIdeal_le_candidate m)

end
#print axioms contact_centerPolar_mem
#print axioms center_source_mem_centerPolar
#print axioms centerPolar_mem_candidate
#print axioms candidateIdeal_eq_staticPolar_sup_centerPolar
end VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
