import VOA.DeligneAudit.D4FusionContactAllMCountResearchCenterQ5Slice

/-! Static generators of the original candidate ideal, for every m. Every U
source (shifted highest seed under an arbitrary negative-current word) is a
combination of admissible whole static polar coefficients: powers <= 3 lie in
J23, and a power n+1 >= 4 source is (n+1)^q times one static polar modulo the
lower polar range. Hence the candidate ideal is generated by all admissible
static polars together with the C sources; the commutative model adds only the
proved high-word cutoff. No count or completeness premise is used. -/
namespace VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
open VOA.DeligneAudit.D4FusionContact.Polynomial
open Cube (polarRangeIdeal quadraticCubicPolarIdeal)
noncomputable section

/-- All admissible whole static polar coefficients, of every power r >= 2. -/
def staticPolarSeeds (m : ℕ) : Set (MvPolynomial (Vars m) ℂ) :=
  {p | ∃ r a b c s, 2 ≤ r ∧ m < r + s ∧
    p = PowerSeries.coeff s (Cube.currentMap m (Cube.orbit ℂ r a b c))}

def staticPolarIdeal (m : ℕ) : Ideal (MvPolynomial (Vars m) ℂ) :=
  Ideal.span (staticPolarSeeds m)

/-- The ideal of the original C sources (shifted center seeds under contact words). -/
def centerSourceIdeal (m : ℕ) : Ideal (MvPolynomial (Vars m) ℂ) :=
  Ideal.span {p | ∃ i : OrbitSourceIndex m, i.seed.val.1 = true ∧ p = orbitSourcePoly m i}

theorem polarRangeIdeal_le_staticPolar (m R : ℕ) :
    polarRangeIdeal m R ≤ staticPolarIdeal m := by
  apply Ideal.span_le.mpr
  rintro p ⟨r,a,b,c,s,h2,-,hs,rfl⟩
  exact Ideal.subset_span ⟨r,a,b,c,s,h2,hs,rfl⟩

theorem staticPolarIdeal_le_candidate (m : ℕ) : staticPolarIdeal m ≤ AllM.candidateIdeal m := by
  apply Ideal.span_le.mpr
  rintro p ⟨r,a,b,c,s,h2,hs,rfl⟩
  exact Cube.current_orbit_coeff_mem m r a b c s (by omega) hs

/-- Every original U source lies in the static polar ideal, for every m. -/
theorem u_source_mem_staticPolar (m : ℕ) (i : OrbitSourceIndex m)
    (hb : i.seed.val.1 = false) : orbitSourcePoly m i ∈ staticPolarIdeal m := by
  by_cases hr : i.seed.val.2.1 ≤ 3
  · exact polarRangeIdeal_le_staticPolar m 3
      (Cube.quadraticCubicPolarIdeal_le_polarRange m 3 le_rfl
        (u_low_source_mem_polarIdeal m i hb hr))
  · obtain ⟨n,hn⟩ : ∃ n, i.seed.val.2.1 = n + 1 := ⟨i.seed.val.2.1 - 1,by omega⟩
    have hth := u_seed_threshold m i hb
    rw [hn] at hth
    have h := Cube.shift_negativeModeWord_static_mem_polarRange m n i.seed.val.2.2
      i.shifts (i.outer.map toAxis) (by omega) hth
    rw [u_orbitSourcePoly_eq m i hb,hn]
    have hy : ((n + 1) ^ i.shifts.length) • PowerSeries.coeff
        (i.seed.val.2.2 + i.shifts.sum + ((i.outer.map toAxis).map Prod.snd).sum)
        (Cube.currentMap m (Cube.orbit ℂ (n + 1)
          (Cube.negativeModeAxisCount 0 (i.outer.map toAxis))
          (Cube.negativeModeAxisCount 1 (i.outer.map toAxis))
          (Cube.negativeModeAxisCount 2 (i.outer.map toAxis)))) ∈ staticPolarIdeal m := by
      apply nsmul_mem
      exact Ideal.subset_span ⟨n + 1,_,_,_,_,by omega,by omega,rfl⟩
    simpa only [sub_add_cancel] using
      Ideal.add_mem _ (polarRangeIdeal_le_staticPolar m n h) hy

/-- MAIN: the candidate ideal is generated by all admissible static polars and
the original C sources, for every m. -/
theorem candidateIdeal_eq_staticPolar_sup_center (m : ℕ) :
    AllM.candidateIdeal m = staticPolarIdeal m ⊔ centerSourceIdeal m := by
  apply le_antisymm
  · rw [candidateIdeal_eq_orbitIdeal,orbitIdeal,← orbitSourcePoly_range]
    apply Ideal.span_le.mpr
    rintro p ⟨i,rfl⟩
    cases hb : i.seed.val.1 with
    | false => exact Ideal.mem_sup_left (u_source_mem_staticPolar m i hb)
    | true => exact Ideal.mem_sup_right (Ideal.subset_span ⟨i,hb,rfl⟩)
  · apply sup_le (staticPolarIdeal_le_candidate m)
    apply Ideal.span_le.mpr
    rintro p ⟨i,-,rfl⟩
    rw [candidateIdeal_eq_orbitIdeal]
    exact Ideal.subset_span ⟨i.seed,i.shifts,i.outer,i.branch,rfl⟩

/-- The commutative model's ideal in static form. -/
theorem modelIdeal_eq_staticPolar_sup (m : ℕ) :
    AllM.modelIdeal m = staticPolarIdeal m ⊔ centerSourceIdeal m ⊔ highWordIdeal m := by
  rw [AllM.modelIdeal,candidateIdeal_eq_staticPolar_sup_center]

end
#print axioms u_source_mem_staticPolar
#print axioms candidateIdeal_eq_staticPolar_sup_center
#print axioms modelIdeal_eq_staticPolar_sup
end VOA.DeligneAudit.D4FusionContact.AllMCountResearch.LeviRules
