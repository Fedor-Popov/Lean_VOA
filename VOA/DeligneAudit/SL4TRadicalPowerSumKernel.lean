import VOA.DeligneAudit.SL4TRadicalModePowerSums

/-! Propagation of multiplicity relations by arbitrary positive power-sum polynomials. -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

/-- Multipliers preserving the kernel of a linear evaluation form a subalgebra. -/
def linearEvaluation_relationAlgebra {R W : Type*}
    [CommRing R] [Algebra ℂ R] [AddCommGroup W] [Module ℂ W]
    (f : R →ₗ[ℂ] W) : Subalgebra ℂ R where
  carrier := {P | ∀ Q, f Q = 0 → f (P * Q) = 0}
  zero_mem' := by intro Q hQ; simp
  one_mem' := by intro Q hQ; simpa using hQ
  add_mem' := by
    intro P U hP hU Q hQ
    simp only [add_mul, map_add, hP Q hQ, hU Q hQ, add_zero]
  mul_mem' := by
    intro P U hP hU Q hQ
    rw [mul_assoc]
    exact hP (U * Q) (hU Q hQ)
  algebraMap_mem' := by
    intro z Q hQ
    rw [← Algebra.smul_def, map_smul, hQ, smul_zero]

/-- The mode-polynomial algebra generated by the positive power sums of all three colours. -/
def radicalPowerSumAlgebra (d : Fin 3 → ℕ) : Subalgebra ℂ (RadicalModePolynomial d) :=
  Algebra.adjoin ℂ (Set.range fun p : Fin 3 × ℕ => radicalModePowerSum d p.1 (p.2 + 1))

open VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.A3Sector

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule bracketTable V) (w : V)

/-- Any polynomial in positive alphabet power sums preserves every multiplicity relation. -/
theorem radicalPowerSumAlgebra_preserves_relations (a b c : ℕ)
    (h : LocalWeylRel ρ w (weightABC a b c))
    (d : Fin 3 → ℕ) (P : RadicalModePolynomial d) (hP : P ∈ radicalPowerSumAlgebra d)
    (Q : RadicalModePolynomial d) (hQ : radicalMultiplicityEvaluation ρ w d Q = 0) :
    radicalMultiplicityEvaluation ρ w d (P * Q) = 0 := by
  let f := radicalMultiplicityEvaluation ρ w d
  have hle : radicalPowerSumAlgebra d ≤ linearEvaluation_relationAlgebra f := by
    apply Algebra.adjoin_le
    rintro U ⟨⟨j, r⟩, rfl⟩
    intro S hS
    apply Subtype.ext
    have he := radicalMultiplicityEvaluation_powerSum ρ w a b c h d j (r + 1)
      (by omega) S
    change f S = 0 at hS
    change radicalAlphabetQuotCurrent ρ w a b c h d j (r + 1)
      (f S : V ⧸ higherRadicalCountClosure ρ w d) =
        (f (radicalModePowerSum d j (r + 1) * S) :
          V ⧸ higherRadicalCountClosure ρ w d) at he
    rw [hS, Submodule.coe_zero, map_zero] at he
    exact he.symm
  exact hle hP Q hQ

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.radicalPowerSumAlgebra_preserves_relations
