import VOA.DeligneAudit.SL4TRemainderHomogeneity

/-! # Homogeneous expansions in an ideal with homogeneous generators -/

namespace VOA.DeligneAudit.SL4T

noncomputable section

variable {σ A : Type*} [CommRing A]

/-- Projection of a product by a homogeneous polynomial shifts the requested degree. -/
theorem weightedComponent_mul_homogeneous (w : σ → ℤ) (d e : ℤ)
    (p q : MvPolynomial σ A) (hq : q.IsWeightedHomogeneous w e) :
    MvPolynomial.weightedHomogeneousComponent w d (p * q) =
      MvPolynomial.weightedHomogeneousComponent w (d - e) p * q := by
  classical
  induction p using MvPolynomial.induction_on' with
  | monomial a c =>
      have ha : (MvPolynomial.monomial a c).IsWeightedHomogeneous w
          (Finsupp.weight w a) := MvPolynomial.isWeightedHomogeneous_monomial w a c rfl
      rw [MvPolynomial.weightedHomogeneousComponent_of_mem (ha.mul hq),
        MvPolynomial.weightedHomogeneousComponent_of_mem ha]
      by_cases hd : d = Finsupp.weight w a + e
      · rw [if_pos hd, if_pos (by omega)]
      · rw [if_neg hd, if_neg (by omega), zero_mul]
  | add p q hp hq => simp only [add_mul, map_add, hp, hq]

/-- A homogeneous element of a homogeneously generated ideal admits homogeneous multipliers. -/
theorem homogeneous_ideal_span_expansion {ι : Type*} (w : σ → ℤ)
    (g : ι → MvPolynomial σ A) (degree : ι → ℤ)
    (hg : ∀ i, (g i).IsWeightedHomogeneous w (degree i))
    (p : MvPolynomial σ A) (d : ℤ) (hp : p.IsWeightedHomogeneous w d)
    (hmem : p ∈ Ideal.span (Set.range g)) :
    ∃ (s : Finset ι) (c : ι → MvPolynomial σ A),
      (∀ i, (c i).IsWeightedHomogeneous w (d - degree i)) ∧
      ∑ i ∈ s, c i * g i = p := by
  classical
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hmem
  refine ⟨c.support, fun i => MvPolynomial.weightedHomogeneousComponent w
    (d - degree i) (c i), fun i => ?_, ?_⟩
  · exact MvPolynomial.weightedHomogeneousComponent_isWeightedHomogeneous _ _
  · have he := congrArg (MvPolynomial.weightedHomogeneousComponent w d) hc
    simp only [Finsupp.sum, smul_eq_mul, map_sum,
      weightedComponent_mul_homogeneous w d _ _ _ (hg _),
      hp.weightedHomogeneousComponent_same] at he
    exact he

/-- Every homogeneous component stays in an ideal generated by homogeneous polynomials. -/
theorem homogeneous_span_component_mem {ι : Type*} (w : σ → ℤ)
    (g : ι → MvPolynomial σ A) (degree : ι → ℤ)
    (hg : ∀ i, (g i).IsWeightedHomogeneous w (degree i))
    (p : MvPolynomial σ A) (hmem : p ∈ Ideal.span (Set.range g)) (d : ℤ) :
    MvPolynomial.weightedHomogeneousComponent w d p ∈ Ideal.span (Set.range g) := by
  classical
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hmem
  rw [← hc]
  simp only [Finsupp.sum, smul_eq_mul, map_sum,
    weightedComponent_mul_homogeneous w d _ _ _ (hg _)]
  exact Ideal.sum_mem _ fun i hi => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

end

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.weightedComponent_mul_homogeneous
#print axioms VOA.DeligneAudit.SL4T.homogeneous_ideal_span_expansion
#print axioms VOA.DeligneAudit.SL4T.homogeneous_span_component_mem
