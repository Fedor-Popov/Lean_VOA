import VOA.DeligneAudit.LeviTypeA2CertOrbitSum

/-! Each filtration step is generated by the Levi orbits of key-quotient basis lifts. -/

namespace VOA.DeligneAudit.A3Sector

open VOA.DeligneAudit.SectorWeyl

noncomputable section

variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable (ρ : CurrentModule VOA.AffineSl3.bracketTable V)

theorem a2_step_orbits_of_closed (F S : Submodule ℂ V)
    [FiniteDimensional ℂ S] (hF : a2LeviClosure ρ F = F) :
    ∃ v : Fin (Module.finrank ℂ (S ⧸ F.comap S.subtype)) → S,
      F ⊔ a2LeviClosure ρ S =
        F ⊔ ⨆ j, a2LeviClosure ρ (ℂ ∙ (v j : V)) := by
  obtain ⟨v, hv⟩ := a2_keyQuot_basis_lifts F S
  refine ⟨v, ?_⟩
  apply le_antisymm
  · apply sup_le le_sup_left
    calc
      a2LeviClosure ρ S ≤
          a2LeviClosure ρ
            (F ⊔ Submodule.span ℂ (Set.range fun j => (v j : V))) :=
        a2LeviClosure_mono ρ hv
      _ = F ⊔ ⨆ j, a2LeviClosure ρ (ℂ ∙ (v j : V)) := by
        rw [a2LeviClosure_sup, hF, a2LeviClosure_span_range]
  · apply sup_le le_sup_left
    apply iSup_le
    intro j
    have hj : ℂ ∙ (v j : V) ≤ S := by
      rw [Submodule.span_le]
      intro x hx
      have heq : x = (v j : V) := Set.mem_singleton_iff.mp hx
      subst x
      exact (v j).property
    exact (a2LeviClosure_mono ρ hj).trans le_sup_right

variable (w : V)

/-- The exact orbit spanning equation for a step of the concrete key prefix. -/
theorem a2KeyPrefix_step_orbits {n i : ℕ} (hi : i < n)
    (k : Fin n → A2RadicalKey) (p q : ℕ)
    (h : A2LocalWeylRel ρ w p q) :
    let F := a2KeyPrefix ρ w k i
    let S := a2KeyLayer ρ w (k ⟨i, hi⟩)
    ∃ v : Fin (Module.finrank ℂ (S ⧸ F.comap S.subtype)) → S,
      a2KeyPrefix ρ w k (i + 1) =
        F ⊔ ⨆ j, a2LeviClosure ρ (ℂ ∙ (v j : V)) := by
  let F := a2KeyPrefix ρ w k i
  let S := a2KeyLayer ρ w (k ⟨i, hi⟩)
  letI : FiniteDimensional ℂ S := a2KeyLayer_finite ρ w p q _ h
  have hclosed : a2LeviClosure ρ F = F := by
    exact a2LeviClosure_idem ρ _
  obtain ⟨v, hv⟩ := a2_step_orbits_of_closed ρ F S hclosed
  refine ⟨v, ?_⟩
  rw [a2KeyPrefix_step ρ w hi k]
  exact hv

end
end VOA.DeligneAudit.A3Sector

#print axioms VOA.DeligneAudit.A3Sector.a2_step_orbits_of_closed
#print axioms VOA.DeligneAudit.A3Sector.a2KeyPrefix_step_orbits
