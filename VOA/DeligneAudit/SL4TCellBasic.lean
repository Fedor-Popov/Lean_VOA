import VOA.DeligneAudit.DeligneFusionCVTrunc

/-!
# Invariant spans and flags for the abstract cell lemma

All parameters are arbitrary. The invariant span is defined by its smallest-submodule property,
without requiring an enveloping-algebra implementation.
-/

namespace VOA.DeligneAudit.SL4T

open VOA.DeligneAudit.CVsl2

universe u

variable {V : Type u} [AddCommGroup V] [Module ℂ V]

/-- Stability under every current mode of the three operators. -/
def CurrentStable (E H F : ℕ → Module.End ℂ V) (P : Submodule ℂ V) : Prop :=
  (∀ s, P ≤ P.comap (E s)) ∧ (∀ s, P ≤ P.comap (H s)) ∧
    (∀ s, P ≤ P.comap (F s))

/-- The smallest submodule containing `S` and stable under all three current operators. -/
def currentSpan (E H F : ℕ → Module.End ℂ V) (S : Set V) : Submodule ℂ V where
  carrier := {x | ∀ P : Submodule ℂ V, S ⊆ P → CurrentStable E H F P → x ∈ P}
  zero_mem' := fun P _ _ => P.zero_mem
  add_mem' := fun hx hy P hP hst => P.add_mem (hx P hP hst) (hy P hP hst)
  smul_mem' := fun c _ hx P hP hst => P.smul_mem c (hx P hP hst)

variable {E H F : ℕ → Module.End ℂ V}

theorem subset_currentSpan (S : Set V) : S ⊆ currentSpan E H F S :=
  fun _ hx _ hP _ => hP hx

theorem currentSpan_stable (S : Set V) : CurrentStable E H F (currentSpan E H F S) := by
  refine ⟨?_, ?_, ?_⟩ <;> intro s x hx P hP hst
  · exact hst.1 s (hx P hP hst)
  · exact hst.2.1 s (hx P hP hst)
  · exact hst.2.2 s (hx P hP hst)

theorem currentSpan_le {S : Set V} {P : Submodule ℂ V}
    (hP : S ⊆ P) (hst : CurrentStable E H F P) : currentSpan E H F S ≤ P :=
  fun _ hx => hx P hP hst

theorem currentSpan_mono {S T : Set V} (h : S ⊆ T) :
    currentSpan E H F S ≤ currentSpan E H F T :=
  currentSpan_le (h.trans (subset_currentSpan T)) (currentSpan_stable T)

theorem currentSpan_empty : currentSpan E H F ∅ = ⊥ := by
  apply le_antisymm (currentSpan_le (Set.empty_subset _) ?_) bot_le
  exact ⟨fun _ => by simp, fun _ => by simp, fun _ => by simp⟩

/-- `cellFlag v i` is generated by `v 0, ..., v (i - 1)`. -/
def cellFlag (E H F : ℕ → Module.End ℂ V) (v : ℕ → V) (i : ℕ) : Submodule ℂ V :=
  currentSpan E H F {x | ∃ j < i, v j = x}

theorem cellFlag_stable (v : ℕ → V) (i : ℕ) :
    CurrentStable E H F (cellFlag E H F v i) := currentSpan_stable _

theorem cellFlag_zero (v : ℕ → V) : cellFlag E H F v 0 = ⊥ := by
  simpa only [cellFlag, Nat.not_lt_zero, false_and, exists_false, Set.setOf_false]
    using (currentSpan_empty (E := E) (H := H) (F := F))

theorem cellFlag_mono (v : ℕ → V) : Monotone (cellFlag E H F v) := by
  intro i j hij
  exact currentSpan_mono (fun _ ⟨k, hk, hx⟩ => ⟨k, hk.trans_le hij, hx⟩)

theorem cellFlag_mem (v : ℕ → V) {i j : ℕ} (hj : j < i) : v j ∈ cellFlag E H F v i :=
  subset_currentSpan _ ⟨j, hj, rfl⟩

/-- The flag has the required smallest invariant submodule property. -/
theorem cellFlag_le_iff (v : ℕ → V) (i : ℕ) {P : Submodule ℂ V}
    (hP : CurrentStable E H F P) :
    cellFlag E H F v i ≤ P ↔ ∀ j < i, v j ∈ P := by
  constructor
  · exact fun h j hj => h (cellFlag_mem v hj)
  · intro h
    exact currentSpan_le (fun _ ⟨j, hj, hx⟩ => hx ▸ h j hj) hP

theorem Fspan_le_of_stable {P : Submodule ℂ V} (hP : ∀ s, P ≤ P.comap (F s))
    {y : V} (hy : y ∈ P) : Fspan F y ≤ P := by
  rw [Fspan, Submodule.span_le]
  rintro _ ⟨l, rfl⟩
  induction l with
  | nil => exact hy
  | cons k l ih => exact hP k ih

/-- A cell's highest-weight and truncation relations modulo the preceding submodule. -/
structure CellRelations (E H F : ℕ → Module.End ℂ V) (P : Submodule ℂ V)
    (y : V) (r ν : ℕ) : Prop where
  raising : ∀ s, E s y ∈ P
  weight : H 0 y - (r : ℂ) • y ∈ P
  cartan : ∀ s, 1 ≤ s → H s y ∈ P
  integrable : (F 0 ^ (r + 1)) y ∈ P
  truncated : ∀ s, ν ≤ s → F s y ∈ P

end VOA.DeligneAudit.SL4T

#print axioms VOA.DeligneAudit.SL4T.currentSpan_stable
#print axioms VOA.DeligneAudit.SL4T.cellFlag_le_iff
