import VOA.DeligneAudit.SL4TAdjointSiteLevelTwoRelations
import VOA.DeligneAudit.SL4TMultiDoubledCompletion

/-!
# The two open residuals of Law B at one adjoint site

This file records, as explicit propositions, the two statements that remain open on paper for
Law B at one adjoint site, together with every object they refer to.

* The block ring is `R = MixedRing q` for `q = mixedLabelBlockParams 1 B d e₁ e₂`, with the five
  alphabets `x₁, x₂, x₃, g₁, g₂` (alphabet indices `0, …, 4`).
* `J_L(α)` is the span of the monomial symmetric functions of the alphabet `α` having a part at
  least `L`; for `L ≥ 1` and in characteristic zero it is the ideal generated by the power sums
  `p_s(α)`, `s ≥ L` (§3.1 of the note). It is defined here by these power sums
  (`mixedAlphabetModeTailIdeal`).
* `I_J(h) = J_(h+1)(x₂, g₁, g₂) + J_h(x₂) + [d₁ = 0] J_h(g₁) + [d₃ = 1] J_h(g₂)`
  (`adjointSiteKernelIdeal`); here `J_(h+1)(x₂, g₁, g₂) = J_(h+1)(x₂) + J_(h+1)(g₁) + J_(h+1)(g₂)`
  is the span of the separately symmetric monomials with a part at least `h + 1` in one of the
  three alphabets. The coefficient ring is `A = R / I_J(h)` (`AdjointSiteCoefficientRing`).
* `P_y` is the characteristic polynomial of `y = g₁ ⊔ g₂′`, i.e. `mixedCharacteristic q` mapped
  to `A`, of degree `r = mixedWeight q`.
* The joint symbol `s` (§3.3) is `1` on the type `(d₁, d₃) = (0, 1)`, `b₀ = e_(q - e₂)(g₂′)` on
  `(0, 0)`, `a₀ = e_(e₁)(g₁)` on `(1, 1)` and `0` on `(1, 0)` (`adjointSiteJointSymbol`).
* `U ⊆ A[t]` is generated by `t^(h+1)` and `s t^h`; `G_j` is its ideal of top-row `j`-minors
  modulo `P_y` (`adjointSiteJointTopIdeal`, built from `polynomialSubmoduleTopIdeal`), and
  `G_j(L)` is the top-row ideal of the remainder columns of `t^(L + c)`, `c ≥ 0`
  (`adjointSiteRemainderTopIdeal`).
* A site word (§5.2) consists of one adjoint site with nine states, `k` labelled doubled sites with
  ten colour multisets each and `B - 2k` labelled simple sites with four colours each. The four
  colours are `0 = g₁′`, `1 = g₁`, `2 = g₂`, `3 = g₂′`, and `Y = {1, 3}`. The adjoint-site state is
  the optional colour of its root in `U = g₁′ ⊔ g₁` and the optional colour of its root in
  `V = g₂ ⊔ g₂′`; its block has `d₁ = [U-root present]` and `d₃ = 1 - [V-root present]`.
  A T-state is a site with two roots in `Y`. `w_j(d, e)` counts the words with block `(d, e)` and
  at least `j` T-states (`adjointSiteWordCount`).

**`OneAdjointStratumCount B k`** (S_A(B, k) of §5.3): for every valid one-adjoint-site block,
`dim A ≤ w₀(d,e)`, and for every `j ≥ 1`, `dim A/G_j ≤ w₀(d,e) - w_j(d,e)` and
`G_j = G_j(h+1) + s G_j(h)`, where `h = B - k`.

**`ZeroAdjointFlatRelation B k`** (L₂(B - k) of §3.3): on every block over `d = (0, d₂, 0)` of the
module `M(B, B - k)`, `F(h) π̄(b₀ φ) = 0` for all `φ ∈ R`, where `π̄` is the actual second Levi
multiplicity evaluation and `F = f₃`.

The target `adjointSiteLawB_of_residuals` of the note's §6 is recorded as the proposition
`AdjointSiteLawBFromResiduals`; it is **not** proved here. The site-weight count of §6,
`Σ_words 3^T 2^D = 15 · 20^k · 6^(B - 2k)`, is proved (`adjointSiteWord_weight_sum`).
-/

namespace VOA.DeligneAudit.SL4T

open Polynomial VOA.DeligneAudit.SectorWeyl VOA.DeligneAudit.A3Sector

noncomputable section

/-! ### The ring kernel and the coefficient ring -/

/-- The ideal of all power sums `p_s`, `s ≥ L`, of one of the five alphabets of a block ring. -/
def mixedAlphabetModeTailIdeal (q : MixedParams) (i : Fin 5) (L : ℕ) : Ideal (MixedRing q) :=
  Ideal.span {a | ∃ s, L ≤ s ∧
    a = mixedAlphabetPowerSum (mixedEvaluation q) i (mixedLengths q i) s}

/-- The ring kernel `I_J(h) = J_(h+1)(x₂, g₁, g₂) + J_h(x₂) + [d₁ = 0] J_h(g₁) +
[d₃ = 1] J_h(g₂)` of a one-adjoint-site block. Alphabet indices: `1 = x₂`, `3 = g₁`, `4 = g₂`. -/
def adjointSiteKernelIdeal (q : MixedParams) (h : ℕ) : Ideal (MixedRing q) :=
  mixedAlphabetModeTailIdeal q 1 (h + 1) ⊔ mixedAlphabetModeTailIdeal q 3 (h + 1) ⊔
    mixedAlphabetModeTailIdeal q 4 (h + 1) ⊔ mixedAlphabetModeTailIdeal q 1 h ⊔
      (if q.d1 = 0 then mixedAlphabetModeTailIdeal q 3 h else ⊥) ⊔
        (if q.d3 = 1 then mixedAlphabetModeTailIdeal q 4 h else ⊥)

/-- The coefficient ring `A = R / I_J(h)`. -/
abbrev AdjointSiteCoefficientRing (q : MixedParams) (h : ℕ) :=
  MixedRing q ⧸ adjointSiteKernelIdeal q h

/-- The characteristic polynomial `P_y` of `y = g₁ ⊔ g₂′` over the coefficient ring. -/
def adjointSiteCharacteristic (q : MixedParams) (h : ℕ) :
    (AdjointSiteCoefficientRing q h)[X] :=
  (mixedCharacteristic q).map (Ideal.Quotient.mk (adjointSiteKernelIdeal q h))

/-- The flat symbol `b₀ = e_(q - e₂)(g₂′)`, the top elementary class of `g₂′`. -/
def adjointSiteFlatSymbol (q : MixedParams) : MixedRing q :=
  mixedEvaluation q (mixedG2prime (mixedQ q - q.e2).toNat)

/-- The marked symbol `a₀ = e_(e₁)(g₁)`, the top elementary class of `g₁`. -/
def adjointSiteMarkedSymbol (q : MixedParams) : MixedRing q :=
  mixedEvaluation q (mixedE 3 q.e1.toNat)

/-- The joint symbol `s`: `1` on `(d₁, d₃) = (0, 1)`, `b₀` on `(0, 0)`, `a₀` on `(1, 1)`, and `0`
on `(1, 0)`. -/
def adjointSiteJointSymbol (q : MixedParams) : MixedRing q :=
  if q.d1 = 0 ∧ q.d3 = 1 then 1
  else if q.d1 = 0 ∧ q.d3 = 0 then adjointSiteFlatSymbol q
  else if q.d1 = 1 ∧ q.d3 = 1 then adjointSiteMarkedSymbol q
  else 0

/-- The submodule `U ⊆ A[t]` generated by `t^(h+1)` and `s t^h`, with its `t`-stability. -/
def adjointSiteJointSubmodule (q : MixedParams) (h : ℕ) :
    Submodule (AdjointSiteCoefficientRing q h) (AdjointSiteCoefficientRing q h)[X] :=
  (Ideal.span {(X : (AdjointSiteCoefficientRing q h)[X]) ^ (h + 1),
    Polynomial.C (Ideal.Quotient.mk _ (adjointSiteJointSymbol q)) * X ^ h}).restrictScalars _

/-- The submodule of `A[t]` generated by `t^L`: the remainder columns of `t^(L + c)`, `c ≥ 0`. -/
def adjointSitePowerSubmodule (q : MixedParams) (h L : ℕ) :
    Submodule (AdjointSiteCoefficientRing q h) (AdjointSiteCoefficientRing q h)[X] :=
  (Ideal.span {(X : (AdjointSiteCoefficientRing q h)[X]) ^ L}).restrictScalars _

/-- The joint determinantal ideal `G_j`: top-row `j`-minors of `U` modulo `P_y`. -/
def adjointSiteJointTopIdeal (q : MixedParams) (h j : ℕ) :
    Ideal (AdjointSiteCoefficientRing q h) :=
  polynomialSubmoduleTopIdeal (adjointSiteCharacteristic q h) (mixedWeight q).toNat j
    (adjointSiteJointSubmodule q h)

/-- The pure determinantal ideal `G_j(L)`: top-row `j`-minors of the remainders of `t^(L + c)`. -/
def adjointSiteRemainderTopIdeal (q : MixedParams) (h L j : ℕ) :
    Ideal (AdjointSiteCoefficientRing q h) :=
  polynomialSubmoduleTopIdeal (adjointSiteCharacteristic q h) (mixedWeight q).toNat j
    (adjointSitePowerSubmodule q h L)

/-! ### Site words -/

/-- An adjoint-site state: the optional colour of the root in `U` (`0 ↦ g₁′`, `1 ↦ g₁`) and the
optional colour of the root in `V` (`0 ↦ g₂`, `1 ↦ g₂′`). There are nine states. -/
abbrev AdjointSiteState := Option (Fin 2) × Option (Fin 2)

/-- A doubled-site state: an unordered pair of colours, stored as an ordered pair `c ≤ c'`. -/
abbrev DoubledSiteState := {p : Fin 4 × Fin 4 // p.1 ≤ p.2}

/-- A word: one adjoint site, `k` labelled doubled sites and `B - 2k` labelled simple sites. -/
abbrev AdjointSiteWord (B k : ℕ) :=
  AdjointSiteState × (Fin k → DoubledSiteState) × (Fin (B - 2 * k) → Fin 4)

/-- The colour of the `U`-root of the adjoint site. -/
def adjointSiteUColour (i : Fin 2) : Fin 4 := ⟨i.val, by omega⟩

/-- The colour of the `V`-root of the adjoint site. -/
def adjointSiteVColour (i : Fin 2) : Fin 4 := ⟨i.val + 2, by omega⟩

/-- Number of roots of colour `l` at the adjoint site. -/
def adjointSiteStateColourCount (a : AdjointSiteState) (l : Fin 4) : ℕ :=
  (if a.1.map adjointSiteUColour = some l then 1 else 0) +
    (if a.2.map adjointSiteVColour = some l then 1 else 0)

/-- Number of roots of colour `l` at a doubled site. -/
def doubledSiteStateColourCount (s : DoubledSiteState) (l : Fin 4) : ℕ :=
  (if s.val.1 = l then 1 else 0) + (if s.val.2 = l then 1 else 0)

/-- Membership of a colour in `Y = g₁ ⊔ g₂′`. -/
def flagColourInY (l : Fin 4) : ℕ := if l = 1 ∨ l = 3 then 1 else 0

/-- Number of roots in `Y` at the adjoint site. -/
def adjointSiteStateYCount (a : AdjointSiteState) : ℕ :=
  (if a.1 = some 1 then 1 else 0) + (if a.2 = some 1 then 1 else 0)

/-- Number of roots in `Y` at a doubled site. -/
def doubledSiteStateYCount (s : DoubledSiteState) : ℕ :=
  flagColourInY s.val.1 + flagColourInY s.val.2

/-- The weight `3^T 2^D` of one site with a given number of roots in `Y`. -/
def siteYWeight (n : ℕ) : ℕ := if n = 2 then 3 else if n = 1 then 2 else 1

/-- Total number of roots of colour `l` in a word. -/
def adjointSiteWordColourCount {B k : ℕ} (u : AdjointSiteWord B k) (l : Fin 4) : ℕ :=
  adjointSiteStateColourCount u.1 l + ∑ i, doubledSiteStateColourCount (u.2.1 i) l +
    ∑ i, (if u.2.2 i = l then 1 else 0)

/-- The number of T-states of a word: sites with two roots in `Y`. -/
def adjointSiteWordTCount {B k : ℕ} (u : AdjointSiteWord B k) : ℕ :=
  (if adjointSiteStateYCount u.1 = 2 then 1 else 0) +
    ∑ i, (if doubledSiteStateYCount (u.2.1 i) = 2 then 1 else 0)

/-- The block of a word: `d₁ = [U-root present]`, `d₃ = 1 - [V-root present]`, colour content
`(p - e₁, e₁, e₂, q - e₂)` and hence `d₂ = d₁ + B - p`. -/
def adjointSiteWordBlock {B k : ℕ} (u : AdjointSiteWord B k) : MixedParams :=
  let d₁ : ℤ := if u.1.1.isSome then 1 else 0
  let d₃ : ℤ := if u.1.2.isSome then 0 else 1
  ⟨1, B, d₁, d₁ + B - (adjointSiteWordColourCount u 0 + adjointSiteWordColourCount u 1), d₃,
    adjointSiteWordColourCount u 1, adjointSiteWordColourCount u 2⟩

/-- `w_j(d, e)`: the number of words with block `q` and at least `j` T-states. -/
def adjointSiteWordCount (B k : ℕ) (q : MixedParams) (j : ℕ) : ℕ :=
  (Finset.univ.filter fun u : AdjointSiteWord B k =>
    adjointSiteWordBlock u = q ∧ j ≤ adjointSiteWordTCount u).card

/-- The weight `3^T 2^D` of a word, as the product of its site weights. -/
def adjointSiteWordWeight {B k : ℕ} (u : AdjointSiteWord B k) : ℕ :=
  siteYWeight (adjointSiteStateYCount u.1) *
    (∏ i, siteYWeight (doubledSiteStateYCount (u.2.1 i))) *
      ∏ i, siteYWeight (flagColourInY (u.2.2 i))

/-- The adjoint site has total weight `4 + 4·2 + 3 = 15`. -/
theorem adjointSiteState_weight_sum :
    ∑ a : AdjointSiteState, siteYWeight (adjointSiteStateYCount a) = 15 := by
  decide

/-- A doubled site has total weight `3 + 4·2 + 3·3 = 20`. -/
theorem doubledSiteState_weight_sum :
    ∑ s : DoubledSiteState, siteYWeight (doubledSiteStateYCount s) = 20 := by
  decide

/-- A simple site has total weight `2 + 2·2 = 6`. -/
theorem simpleSiteState_weight_sum :
    ∑ l : Fin 4, siteYWeight (flagColourInY l) = 6 := by
  decide

/-- **The site count of §6.** Summing `3^T 2^D` over all words gives `15 · 20^k · 6^(B-2k)`. -/
theorem adjointSiteWord_weight_sum (B k : ℕ) :
    ∑ u : AdjointSiteWord B k, adjointSiteWordWeight u = 15 * 20 ^ k * 6 ^ (B - 2 * k) := by
  have hd : ∑ g : Fin k → DoubledSiteState, ∏ i, siteYWeight (doubledSiteStateYCount (g i)) =
      20 ^ k := by
    rw [← doubledSiteState_weight_sum, Finset.sum_pow', Fintype.piFinset_univ]
  have hs : ∑ c : Fin (B - 2 * k) → Fin 4, ∏ i, siteYWeight (flagColourInY (c i)) =
      6 ^ (B - 2 * k) := by
    rw [← simpleSiteState_weight_sum, Finset.sum_pow', Fintype.piFinset_univ]
  have hprod {α β : Type} [Fintype α] [Fintype β] (f : α → ℕ) (g : β → ℕ) :
      ∑ x : α × β, f x.1 * g x.2 = (∑ a, f a) * ∑ b, g b := by
    simp only [Fintype.sum_prod_type, Finset.sum_mul_sum]
  have h₁ := hprod (fun a : AdjointSiteState => siteYWeight (adjointSiteStateYCount a))
    (fun x : (Fin k → DoubledSiteState) × (Fin (B - 2 * k) → Fin 4) =>
      (∏ i, siteYWeight (doubledSiteStateYCount (x.1 i))) *
        ∏ i, siteYWeight (flagColourInY (x.2 i)))
  have h₂ := hprod
    (fun g : Fin k → DoubledSiteState => ∏ i, siteYWeight (doubledSiteStateYCount (g i)))
    (fun c : Fin (B - 2 * k) → Fin 4 => ∏ i, siteYWeight (flagColourInY (c i)))
  calc ∑ u : AdjointSiteWord B k, adjointSiteWordWeight u
      = ∑ u : AdjointSiteWord B k, siteYWeight (adjointSiteStateYCount u.1) *
          ((∏ i, siteYWeight (doubledSiteStateYCount (u.2.1 i))) *
            ∏ i, siteYWeight (flagColourInY (u.2.2 i))) := by
        simp only [adjointSiteWordWeight, mul_assoc]
    _ = 15 * 20 ^ k * 6 ^ (B - 2 * k) := by
        rw [h₁, h₂, adjointSiteState_weight_sum, hd, hs, mul_assoc]

/-! ### The two residual propositions -/

set_option synthInstance.maxHeartbeats 100000 in
-- The coefficient quotients are nested ring quotients of a polynomial algebra.
/-- **S_A(B, k)**, the one-adjoint-site ring stratum upper count of §5.3. For every valid block
`q = (1, B; d; e)`, with `h = B - k` and `A = R / I_J(h)`: `dim A ≤ w₀(d, e)`, and for every
`j ≥ 1`, `dim A/G_j ≤ w₀(d, e) - w_j(d, e)` and `G_j = G_j(h + 1) + s G_j(h)`. -/
def OneAdjointStratumCount (B k : ℕ) : Prop :=
  ∀ (d : Fin 3 → ℕ) (e₁ e₂ : ℕ), MixedValid (mixedLabelBlockParams 1 B d e₁ e₂) →
    Module.finrank ℂ (AdjointSiteCoefficientRing (mixedLabelBlockParams 1 B d e₁ e₂) (B - k)) ≤
        adjointSiteWordCount B k (mixedLabelBlockParams 1 B d e₁ e₂) 0 ∧
      ∀ j, 1 ≤ j →
        Module.finrank ℂ
            (AdjointSiteCoefficientRing (mixedLabelBlockParams 1 B d e₁ e₂) (B - k) ⧸
              adjointSiteJointTopIdeal (mixedLabelBlockParams 1 B d e₁ e₂) (B - k) j) ≤
          adjointSiteWordCount B k (mixedLabelBlockParams 1 B d e₁ e₂) 0 -
            adjointSiteWordCount B k (mixedLabelBlockParams 1 B d e₁ e₂) j ∧
        adjointSiteJointTopIdeal (mixedLabelBlockParams 1 B d e₁ e₂) (B - k) j =
          adjointSiteRemainderTopIdeal (mixedLabelBlockParams 1 B d e₁ e₂) (B - k)
              (B - k + 1) j ⊔
            Ideal.span {Ideal.Quotient.mk _
              (adjointSiteJointSymbol (mixedLabelBlockParams 1 B d e₁ e₂))} *
              adjointSiteRemainderTopIdeal (mixedLabelBlockParams 1 B d e₁ e₂) (B - k)
                (B - k) j

set_option synthInstance.maxHeartbeats 100000 in
-- The second Levi multiplicity is built over nested tensor-product coefficient algebras.
/-- **L₂(B - k)**, the remaining flat level relation of §3.3. On every block over
`d = (0, d₂, 0)` of the module `M(B, B - k)`, `F(h) π̄(b₀ φ) = 0` for all `φ ∈ R`, where
`h = B - k`, `b₀ = e_(q - e₂)(g₂′)`, `π̄` is the actual second Levi multiplicity evaluation and
`F = f₃` acts on the second Levi quotient. -/
def ZeroAdjointFlatRelation (B k : ℕ) : Prop :=
  ∀ (d₂ e₁ e₂ : ℕ) (hv : MixedValid (mixedLabelBlockParams 1 B ![0, d₂, 0] e₁ e₂))
    (φ : MixedRing (mixedLabelBlockParams 1 B ![0, d₂, 0] e₁ e₂)),
    secondLeviQuotientLowering
        (radicalCountQuotCurrent (adjointSiteRep B (B - k)) (adjointSiteGenerator B (B - k))
          ![0, d₂, 0])
        (radicalGrassmannianAmbientEvaluation (adjointSiteRep B (B - k))
          (adjointSiteGenerator B (B - k)) 1 B 1 (adjointSite_localWeyl B (B - k)) ![0, d₂, 0])
        e₁ e₂ (B - k)
      (mixedSecondLeviEvaluation (adjointSiteRep B (B - k)) (adjointSiteGenerator B (B - k)) 1 B
        (adjointSite_localWeyl B (B - k)) ![0, d₂, 0] e₁ e₂ hv
        (adjointSiteFlatSymbol (mixedLabelBlockParams 1 B ![0, d₂, 0] e₁ e₂) *
          φ)).val = 0

/-- The conditional assembly of §6 (Theorem A1-k), as a proposition: the two residuals imply
Law B at one adjoint site. It is a target, not a theorem of this file. -/
def AdjointSiteLawBFromResiduals (B k : ℕ) : Prop :=
  OneAdjointStratumCount B k → ZeroAdjointFlatRelation B k → AdjointSiteLawB B k

end

end VOA.DeligneAudit.SL4T
