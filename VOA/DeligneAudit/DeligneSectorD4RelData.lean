/-- The relation `r` (`105` = Casimir). -/
def relZ (r : ℕ) : QV := relT.getD r []

/-- The certificate for `(x, r)`. -/
def cert (x r : ℕ) : ℤ × List (ℕ × ℤ) :=
  match (certT.getD x []).find? (fun e => e.1 == r) with
  | some e => (e.2.1, e.2.2)
  | none => (1, [])

/-- The defect `N · ad_x(rel r) - Σ μ_s rel s`. -/
def stabDefect (x r : ℕ) : QV :=
  smulQ (cert x r).1 (adQ br x (relZ r)) ++ (cert x r).2.flatMap fun p => smulQ (-p.2) (relZ p.1)

/-- The stability check for the current `x` (split per current to keep each kernel check small). -/
def stabCheckX (x : ℕ) : Bool :=
  (List.range 106).all fun r =>
    (cert x r).1 != 0 && (cert x r).2.all (fun p => decide (p.1 < 106)) && qzeroCheck (stabDefect x r)

/-- Index ranges of the relations. -/
def relRange : Bool :=
  (List.range 106).all fun r => (relZ r).all fun t => decide (t.1 < 28) && decide (t.2.1 < 28)


