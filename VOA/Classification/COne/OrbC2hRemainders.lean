import VOA.Classification.COne.OrbC2hCorrected
set_option maxSynthPendingDepth 3
set_option maxRecDepth 4096
set_option maxHeartbeats 0
noncomputable section
namespace VOA.Classification.COne.OrbC2h
open VOA VertexOperatorAlgebra OrbC2b OrbC2c OrbC2e OrbC2f OrbC2g PlusC2

section General
variable {V : Type*} [AddCommGroup V] [Module ℂ V] (W : VertexOperatorAlgebra V)

def wordSum (x : V) (ts : List (ℚ × List ℕ)) : V :=
  (ts.map fun t => (t.1:ℂ) • virWord W t.2 x).sum

theorem wordSum_mem_virError (x : V) (ts : List (ℚ × List ℕ))
    (h : ∀ t ∈ ts, ∃ k ∈ t.2, k ≠ 1) : wordSum W x ts ∈ virError W x := by
  induction ts with
  | nil => exact Submodule.zero_mem _
  | cons t ts ih =>
    rw [wordSum, List.map_cons, List.sum_cons]
    apply Submodule.add_mem
    · apply Submodule.smul_mem
      exact Submodule.subset_span ⟨⟨t.2,h t (by simp)⟩,rfl⟩
    · apply ih
      intro t ht
      exact h t (List.mem_cons_of_mem _ ht)
end General

