local notation "P" => V2mPlus 4 four_ge_one

/-- Explicit finite identities on the existing fixed seed. These remain certificate
obligations; defining this Prop does not assert either identity. -/
def CubicFiniteVirasoroCertificates : Prop :=
  modeRemainder P normalizedNine weightSixteen (-3) 10 2 candidateVacuum20 djB20 =
    wordSum P (P).vacuum vacErrors20 + wordSum P weightSixteen seedErrors20 ∧
  modeRemainder P normalizedNine weightSixteen (-5) 11 3 candidateVacuum22 djB22 =
    wordSum P (P).vacuum vacErrors22 + wordSum P weightSixteen seedErrors22

/-- The explicit finite certificates supply a witness for the corrected residual,
without changing its prescribed error spaces. -/
theorem corrected_of_finiteVirasoroCertificates (h : CubicFiniteVirasoroCertificates) :
    CubicSeedRemaindersCorrected := by
  refine ⟨weightSixteen, candidateSeedLeading, weightSixteen_fixed,
    weightSixteen_mem_grading, ?_, ?_⟩
  · have he : (candidateVacuum20:ℂ) =
        2^10 * ((djC20:ℂ)/13 - djB20/4*(candidateSeedLeading:ℂ)) := by
      norm_num [candidateVacuum20, candidateSeedLeading, djC20, djB20]
    rw [← he, h.1]
    exact Submodule.add_mem _
      (Submodule.mem_sup_left (wordSum_mem_virError P _ _ vacErrors20_bad))
      (Submodule.mem_sup_right (wordSum_mem_virError P _ _ seedErrors20_bad))
  · have he : (candidateVacuum22:ℂ) =
        2^11 * ((djC22:ℂ) - djB22/8*(candidateSeedLeading:ℂ)) := by
      norm_num [candidateVacuum22, candidateSeedLeading, djC22, djB22]
    rw [← he, h.2]
    exact Submodule.add_mem _
      (Submodule.mem_sup_left (wordSum_mem_virError P _ _ vacErrors22_bad))
      (Submodule.mem_sup_right (wordSum_mem_virError P _ _ seedErrors22_bad))

