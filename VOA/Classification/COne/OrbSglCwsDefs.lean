/-!
# OrbSgl (4): the structure constant `c(v_num)` of `u₍₁₅₎ v_num` in `V₈`, by small evaluations

`u = J₍₋₂₎E − E₍₋₂₎J` (`weightNine`), `v_num = J₍₋₉₎J + 27 E₍₋₉₎E` (`weightSixteen`).  For
`a ∈ {J, E}` (weight `4`):

* commutator: `u₍₁₅₎ a₍₋₉₎ a = Σ_{k<13} C(15,k) (u₍ₖ₎a)₍₆₋ₖ₎ a` (`u₍₁₅₎a = 0`);
* skew symmetry: `y₍ₙ₎ a = Σ_{j<10} (j!)⁻¹ sgn(-n-1-j) L(-1)ʲ a₍ₙ₊ⱼ₎ y`;
* `u₍ₖ₎a` by the finite iterate expansion `weightNine_smul_finite` (J/E left products).

Every intermediate state has weight `≤ 12`, so each `termK` is a small evaluator computation
(the direct `u₍₁₅₎` on the weight-16 state is far too expensive).  This file holds the
definitions, their soundness and the precomputed term data; the certificates are in
`OrbSglCwsCert*`.
-/

set_option maxSynthPendingDepth 3
set_option maxRecDepth 100000

noncomputable section

namespace VOA.Classification.COne.OrbSgl

open VOA VertexOperatorAlgebra VOA.LatGen VOA.LatGen.Triplet VOA.SparseRational
  OrbC2g OrbC2h OrbC2c OrbC2e OrbC2f PlusC2 PlusC2Eval PlusUnitary

local notation "A" => V2m 4 four_ge_one

/-- The iterate term of `weightNine` with the fast evaluators. -/
def iterFast (n : ℤ) (i : ℕ) (S : SectorVector) : SectorVector :=
  scaleVector (i+1)
    (neutralS JR (-2-i) (eS (n+i) S) ++
      scaleVector (-1) (eS (-2+n-i) (neutralS JR i S)) ++
      scaleVector (-1) (eS (-2-i) (neutralS JR (n+i) S)) ++
      neutralS JR (-2+n-i) (eS i S))

/-- `u₍ₖ₎ x` for `x` of weight `4`. -/
def uL (k : ℕ) (S : SectorVector) : SectorVector :=
  compact ((List.range 9).flatMap fun i => iterFast k i S)

/-- `L(-1)ʲ`. -/
def Tpow : ℕ → SectorVector → SectorVector
  | 0, S => S
  | j+1, S => compact (neutralBoundS omR 0 (Tpow j S))

def sgnQ (n : ℤ) : ℚ := if n % 2 = 0 then 1 else -1

/-- Left action of `J` (`true`) or `E` (`false`). -/
def aLeft (isJ : Bool) (n : ℤ) (S : SectorVector) : SectorVector :=
  if isJ then neutralS JR n S else eS n S

/-- `C(15,k) (u₍ₖ₎a)₍₆₋ₖ₎ a` via skew symmetry. -/
def termK (isJ : Bool) (aV : SectorVector) (k : ℕ) : SectorVector :=
  let y := uL k aV
  compact ((List.range 10).flatMap fun j =>
    scaleVector ((Nat.choose 15 k : ℚ) / (Nat.factorial j) * sgnQ (-(6 - (k:ℤ)) - 1 - j))
      (Tpow j (aLeft isJ (6 - (k:ℤ) + j) y)))

