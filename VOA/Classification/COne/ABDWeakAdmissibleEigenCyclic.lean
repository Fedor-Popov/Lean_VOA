import VOA.Classification.COne.ABDWeakAdmissibleNormal

/-! Ordinary modules generated by a single conformal eigenvector. -/
namespace VOA.Classification.COne.ABDWeakAdmissible
open VOA.Huang.BuhlSpanning VOA.Huang.LogRemovalAdmissible C2LevelFinite PlusRational

universe u
variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
  {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]

theorem homogeneousDegreeSpan_mode (A : WeakModule W M) (x : M) {w : ℤ} {a : 𝒱}
    (ha : a ∈ W.grading w) (p d : ℤ) {y : M}
    (hy : y ∈ homogeneousDegreeSpan A x d) :
    mode (A.YM a) p y ∈ homogeneousDegreeSpan A x (d + (w - p - 1)) := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, hl, rfl⟩ := hy
    change homogeneousDegree l = d at hl
    exact Submodule.subset_span ⟨⟨a,w,p,ha⟩ :: l, by simp [homogeneousDegree, hl]; omega, rfl⟩
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha

theorem homogeneousDegreeSpan_eigen (A : WeakModule W M) {x : M} {α : ℂ}
    (hx : L0 A x = α • x) (d : ℤ) :
    homogeneousDegreeSpan A x d ≤ (L0 A).eigenspace (α + (d : ℂ)) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨l, hl, rfl⟩
  change homogeneousDegree l = d at hl
  change homogeneousWord A l x ∈ (L0 A).eigenspace (α + (d : ℂ))
  rw [Module.End.mem_eigenspace_iff]
  subst d
  induction l with
  | nil => simpa [homogeneousDegree, homogeneousWord] using hx
  | cons a l ih =>
    change L0 A (mode (A.YM a.state) a.modeIndex (homogeneousWord A l x)) = _
    rw [L0_commutator_weak A a.homogeneous, ih, map_smul, ← add_smul]
    congr 1
    simp only [homogeneousDegree, Int.cast_add, Int.cast_sub, Int.cast_one]
    ring

theorem normalDegreeSpan_le_homogeneousDegreeSpan (D : GenData W)
    (A : WeakModule W M) (x : M) (Q Bm : ℕ) (d : ℤ) :
    normalDegreeSpan D A x Q Bm d ≤ homogeneousDegreeSpan A x d := by
  apply Submodule.span_le.mpr
  rintro _ ⟨l, hl, rfl⟩
  let letter : Ltr D → HomogeneousLetter W :=
    fun a => ⟨D.gen a.1, D.wt a.1, a.2, D.gen_mem a.1⟩
  have hd : homogeneousDegree (l.map letter) = degree D l := by
    clear hl
    induction l with
    | nil => rfl
    | cons a l ih => simp [homogeneousDegree, degree_cons, ih, letter]
  have hw : homogeneousWord A (l.map letter) = wordL D A l := by
    clear hl hd
    induction l with
    | nil => rfl
    | cons a l ih => simp [homogeneousWord, wordL, ih, letter]
  exact Submodule.subset_span ⟨l.map letter, hd.trans hl.2.2, by change homogeneousWord A (l.map letter) x = wordL D A l x; rw [hw]⟩

/-- Degree spans exhaust a cyclic weak module. -/
theorem iSup_homogeneousDegreeSpan_eq_top (hC2 : C2Cofinite W)
    (A : WeakModule W M) (x : M) (hcyc : cyclic A x = ⊤) :
    (⨆ d, homogeneousDegreeSpan A x d) = ⊤ := by
  obtain ⟨D, Q, Bm, b, hb, hs⟩ := weak_cyclic_spanning hC2 A x
  rw [hcyc] at hs
  apply top_unique
  exact hs.trans (iSup_le fun d => le_iSup_of_le d
    (normalDegreeSpan_le_homogeneousDegreeSpan D A x Q Bm d))

/-- A uniform integer lower bound on the degree spans of each weak seed. -/
theorem exists_homogeneousDegreeSpan_lower_bound (hC2 : C2Cofinite W)
    (A : WeakModule W M) (x : M) :
    ∃ b : ℤ, ∀ d < b, homogeneousDegreeSpan A x d = ⊥ := by
  obtain ⟨D, Q, Bm, hn⟩ := weakDegreeNormalForm hC2 A x
  obtain ⟨b, hb⟩ := exists_degree_lower_bound D Q Bm
  refine ⟨b, fun d hd => le_antisymm ((hn d).trans ?_) bot_le⟩
  apply Submodule.span_le.mpr
  rintro _ ⟨l, hl, rfl⟩
  have := hb l hl.1.2 hl.2.1
  rw [hl.2.2] at this
  omega

/-- An eigenvector cyclic weak module is ordinary, without irreducibility. -/
theorem eigen_cyclic_isOrdinary (hC2 : C2Cofinite W) (A : WeakModule W M)
    (x : M) (α : ℂ) (hx : L0 A x = α • x) (hcyc : cyclic A x = ⊤) :
    ∃ O : OrdVModule W M, O.toWeakModule = A ∧ x ∈ O.weight α ∧
      ∀ β, O.weight β ≠ ⊥ → ∃ d : ℤ, β = α + (d : ℂ) := by
  obtain ⟨b, hb⟩ := exists_homogeneousDegreeSpan_lower_bound hC2 A x
  let lev : ℤ → Submodule ℂ M := fun j => homogeneousDegreeSpan A x (j + b)
  have hi : iSupIndep lev := by
    have hinj : Function.Injective (fun j : ℤ => α + ((j + b : ℤ) : ℂ)) := by
      intro i j h
      exact add_right_cancel (Int.cast_injective (add_left_cancel h))
    exact ((L0 A).eigenspaces_iSupIndep.comp hinj).mono
      (fun j => homogeneousDegreeSpan_eigen A hx (j + b))
  have htop : (⨆ j, lev j) = ⊤ := by
    apply top_unique
    rw [← iSup_homogeneousDegreeSpan_eq_top hC2 A x hcyc]
    exact iSup_le fun d => le_iSup_of_le (d - b) (by dsimp [lev]; simp)
  let N : AdmissibleModule W M :=
    { toWeakModule := A
      lev := lev
      lev_eq_bot_of_neg := fun j hj => hb (j + b) (by omega)
      isInternal := (DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top lev).mpr
        ⟨hi, htop⟩
      act_lev := by
        intro w p j a ha y hy
        have h := homogeneousDegreeSpan_mode A x ha p (j + b) hy
        change mode (A.YM a) p y ∈ homogeneousDegreeSpan A x (j + (w - p - 1) + b)
        rw [show j + (w - p - 1) + b = j + b + (w - p - 1) by omega]
        exact h }
  have hf : ∀ j, FiniteDimensional ℂ (N.lev j) := fun j =>
    finiteDimensional_homogeneousDegreeSpan_of_normalForm weakDegreeNormalForm hC2 A x (j + b)
  have he : ∀ j y, y ∈ N.lev j → L0 N.toWeakModule y = (α + (b : ℂ) + (j : ℂ)) • y := by
    intro j y hy
    have h := homogeneousDegreeSpan_eigen A hx (j + b) hy
    rw [Module.End.mem_eigenspace_iff] at h
    simpa [Int.cast_add, add_assoc, add_comm, add_left_comm] using h
  refine ⟨AdmissibleOrdinary.ordinaryOfLevelScalar N (α + (b : ℂ)) hf he, rfl, ?_, ?_⟩
  · change x ∈ AdmissibleOrdinary.shiftedWeight N (α + (b : ℂ)) α
    have heq : α = α + (b : ℂ) + ((-b : ℤ) : ℂ) := by push_cast; ring
    have hm := AdmissibleOrdinary.shiftedWeight_at N (α + (b : ℂ)) (-b)
    rw [← heq] at hm
    rw [hm]
    change x ∈ homogeneousDegreeSpan A x (-b + b)
    rw [neg_add_cancel]
    exact seed_mem_homogeneousDegreeSpan A x
  intro β hβ
  by_contra h
  push Not at h
  apply hβ
  apply AdmissibleOrdinary.shiftedWeight_eq_bot
  intro j hj
  apply h (b + j)
  simpa [Int.cast_add, add_assoc] using hj.symm

end VOA.Classification.COne.ABDWeakAdmissible
