set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step38_check :
    equalRelCheck (scaleRel weight_sing38 sing38 ++ partial37)
      partial38 = true := by decide +kernel

theorem partial38_holds : evalRel W selfMode partial38 = 0 := by
  have h := equalRelCheck_sound W selfMode step38_check
  rw [evalRel_append, evalRel_scale, sing38_holds, map_zero, partial37_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
