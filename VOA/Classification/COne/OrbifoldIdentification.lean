import VOA.Classification.COne.V2Automorphisms

/-!
# Cyclic and dihedral orbifolds of `V_{2m}`

Gannon–Rayhaun, eqs. (C.13) and (C.16):

* `orbifold_cyclic_iso`: `V_{2m}^{ℤ_n} ≅ V_{2mn²}`, for `ℤ_n = (cycHom m hm n).range`, the group
  generated by the charge rotation `g_ζ : p ⊗ e^{kα} ↦ ζ_n^k p ⊗ e^{kα}`;
* `orbifold_dihedral_iso`: `V_{2m}^{D_n} ≅ V_{2mn²}⁺`, for `D_n = (dihHom m hm n).range`
  (order `2n`, generated by `g_ζ` and `θ`).

Both hold for every `m ≥ 1`, `n ≥ 1`, as `VOAIsomorphic` (linear equivalence preserving vacuum,
every product and the conformal vector).

## Route
`scaleIota : √(2mn²)ℤ → √(2m)ℤ`, `k ↦ nk`, is an isometry of rank-one lattices, so
`scaleMorph := latMorph …` (`Moonshine/LatticeMorph.lean`) is an injective VOA homomorphism
`V_{2mn²} → V_{2m}` that preserves `ω` (`latMorph_omega`, equal rank; the cocycle comparison is
built into `latMorph` through `latCob`). Its image is the set of states all of whose momenta lie
in `nℤ` (`mem_range_latMorph_iff`). On momentum coordinates `g_u` acts by `u^k`
(`coordEα_charU`), so a state is fixed by `ℤ_n` iff its momenta lie in `nℤ` (`fix_cyc_iff`,
using that `ζ_n` is primitive). Hence `range scaleMorph = V_{2m}^{ℤ_n}` (`range_scaleMorph`).
For the dihedral group, a state is fixed iff it is fixed by `ℤ_n` and by `θ` (`fix_dih_iff`), and
`Φ θ = θ Φ` (`latMorph_thetaLat`) with injectivity gives `Φ(V_{2mn²}⁺) = V_{2m}^{D_n}`
(`map_scaleMorph_plus`). The isomorphisms are the corestrictions.

## Status
`sorry`-free, no new axioms. Unconditional.
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

open VOA VOA.LatGen VOA.LatGen.Triplet VOA.IntegralLattice HeisenbergN

section Scale

variable (m : ℕ) (hm : 1 ≤ m) (n : ℕ)

/-- The isometric embedding `√(2mn²)ℤ → √(2m)ℤ`, `k ↦ n k`. -/
def scaleIota : (latP (m * n ^ 2)).carrier →ₗ[ℤ] (latP m).carrier :=
  LinearMap.mulLeft ℤ (n : ℤ)

theorem ci_scaleIota (k : (latP (m * n ^ 2)).carrier) :
    ci m (scaleIota m n k) = (n : ℤ) * ci (m * n ^ 2) k := rfl

theorem scaleIota_isometry (a b : (latP (m * n ^ 2)).carrier) :
    (latP m).form (scaleIota m n a) (scaleIota m n b) = (latP (m * n ^ 2)).form a b := by
  rw [latP_form, latP_form]
  change 2 * (m : ℤ) * ((n : ℤ) * ci _ a) * ((n : ℤ) * ci _ b) = 2 * ((m * n ^ 2 : ℕ) : ℤ) * ci _ a * ci _ b
  push_cast; ring

theorem rank_latP_eq (p q : ℕ) : rank (latP p) = rank (latP q) := rfl

include hm in
theorem one_le_mn2 [NeZero n] : 1 ≤ m * n ^ 2 := by
  have : 1 ≤ n ^ 2 := Nat.one_le_pow _ _ (Nat.pos_of_ne_zero (NeZero.ne n))
  nlinarith

end Scale

/-! ## Fixed points of a subgroup: the stabilizer -/

section Fix

variable {𝒱 : Type*} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}

/-- `VOAIsomorphic` is symmetric (a local copy of `VOAIsomorphic.symm`, `Conditional.lean`). -/
private theorem voaIso_symm {𝒲 : Type*} [AddCommGroup 𝒲] [Module ℂ 𝒲]
    {V : VertexOperatorAlgebra 𝒱} {T : VertexOperatorAlgebra 𝒲}
    (h : VOAIsomorphic V T) : VOAIsomorphic T V := by
  obtain ⟨e, he, hω⟩ := h
  refine ⟨e.symm, ⟨?_, ?_⟩, ?_⟩
  · apply e.injective
    simp only [LinearEquiv.coe_toLinearMap, LinearEquiv.apply_symm_apply]
    exact he.map_vacuum.symm
  · intro u n x
    apply e.injective
    simp only [LinearEquiv.coe_toLinearMap, LinearEquiv.apply_symm_apply]
    have := he.map_smul (e.symm u) n (e.symm x)
    simp only [LinearEquiv.coe_toLinearMap, LinearEquiv.apply_symm_apply] at this
    exact this.symm
  · apply e.injective
    simp [hω]

/-- The stabilizer of a state. -/
def fixSub (x : 𝒱) : Subgroup (Aut W) where
  carrier := {g | g x = x}
  mul_mem' {a b} ha hb := by
    change (a * b) x = x
    rw [Aut.mul_apply, show b x = x from hb, show a x = x from ha]
  one_mem' := rfl
  inv_mem' {g} hg := by
    change g⁻¹ x = x
    have hg' : g x = x := hg
    conv_lhs => rw [← hg']
    exact g.toLinearEquiv.symm_apply_apply x

theorem mem_orbifold_zpowers_iff (θ : Aut W) (x : 𝒱) :
    x ∈ (orbifold (Subgroup.zpowers θ)).carrier ↔ θ x = x := by
  constructor
  · intro h; exact h θ (Subgroup.mem_zpowers θ)
  · intro h g hg
    have hle : Subgroup.zpowers θ ≤ fixSub (W := W) x := (Subgroup.zpowers_le).mpr h
    exact hle hg

end Fix

/-! ## The charge automorphisms on momentum coordinates -/

section Charge

variable (m : ℕ) (hm : 1 ≤ m)

theorem coordEα_charU (u : ℂˣ) (k : (latP m).carrier) (x : LatModuleGen (latP m)) :
    coordEα (latP m) k (charU m hm u x) = ((u ^ ci m k : ℂˣ) : ℂ) • coordEα (latP m) k x := by
  have h := coordEα_latMorphC (latP m) (latP m) LinearMap.id (charVal (latP m) (unitChar m u))
    (latP_posDef m hm) (fun _ _ => rfl) k x
  rw [oscMatrix_id _ (latP_posDef m hm), charVal_unitChar, fockMap_id] at h
  exact h

variable (n : ℕ) [NeZero n]

theorem zmodToUnits_pow_n (z : Multiplicative (ZMod n)) : zmodToUnits n z ^ n = 1 := by
  rw [← map_pow]
  have : z ^ n = 1 := by
    rw [← toAdd_eq_zero, toAdd_pow, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  rw [this, map_one]

theorem zmodToUnits_one : zmodToUnits n (Multiplicative.ofAdd 1) = zetaU n := by
  have h := (zetaU_isPrimitiveRoot (n := n)).zmodEquivZPowers_apply_coe_nat 1
  rw [Nat.cast_one] at h
  change ((Additive.toMul ((zetaU_isPrimitiveRoot (n := n)).zmodEquivZPowers 1) :
    Subgroup.zpowers (zetaU n)) : ℂˣ) = zetaU n
  rw [h]
  exact pow_one _

/-- **The fixed points of the cyclic group** `⟨g_ζ⟩ ≅ ℤ_n` are exactly the states whose
momenta are all divisible by `n`. -/
theorem fix_cyc_iff (x : LatModuleGen (latP m)) :
    (∀ g ∈ (cycHom m hm n).range, g x = x) ↔
      ∀ k : (latP m).carrier, ¬ (n : ℤ) ∣ ci m k → coordEα (latP m) k x = 0 := by
  constructor
  · intro h k hk
    have hg := h _ ⟨Multiplicative.ofAdd 1, rfl⟩
    have hc := congrArg (coordEα (latP m) k) hg
    simp only [cycHom, MonoidHom.comp_apply, zmodToUnits_one] at hc
    rw [coordEα_charU] at hc
    have h2 : (((zetaU n ^ ci m k : ℂˣ) : ℂ) - 1) • coordEα (latP m) k x = 0 := by
      rw [sub_smul, hc, one_smul, sub_self]
    rcases smul_eq_zero.mp h2 with h3 | h3
    · exfalso; apply hk
      rw [sub_eq_zero, Units.val_eq_one] at h3
      exact ((zetaU_isPrimitiveRoot (n := n)).zpow_eq_one_iff_dvd _).mp h3
    · exact h3
  · rintro h g ⟨z, rfl⟩
    rw [← sub_eq_zero]
    refine eq_zero_of_coordEα (latP m) fun k => ?_
    simp only [cycHom, MonoidHom.comp_apply]
    rw [map_sub, coordEα_charU]
    by_cases hk : (n : ℤ) ∣ ci m k
    · obtain ⟨j, hj⟩ := hk
      rw [hj, zpow_mul, zpow_natCast, zmodToUnits_pow_n, one_zpow, Units.val_one, one_smul,
        sub_self]
    · rw [h k hk, smul_zero, sub_zero]

end Charge

/-! ## The embedding `V_{2mn²} ↪ V_{2m}` -/

section Embed

variable (m : ℕ) (hm : 1 ≤ m) (n : ℕ) [NeZero n]

/-- `Φ : V_{2mn²} → V_{2m}`, the lattice-VOA morphism of `k ↦ nk`. -/
noncomputable def scaleMorph : LatModuleGen (latP (m * n ^ 2)) →ₗ[ℂ] LatModuleGen (latP m) :=
  latMorph (latP (m * n ^ 2)) (latP m) (scaleIota m n)

theorem scaleMorph_isVOAHom :
    IsVOAHom (V2m (m * n ^ 2) (one_le_mn2 m hm n)) (V2m m hm) (scaleMorph m n) :=
  latMorph_isVOAHom _ _ _ (latP_posDef _ (one_le_mn2 m hm n)) (latP_posDef m hm)
    (scaleIota_isometry m n) (latP_even _) (latP_even m)

theorem scaleMorph_omega :
    scaleMorph m n (V2m (m * n ^ 2) (one_le_mn2 m hm n)).conformalVector
      = (V2m m hm).conformalVector :=
  latMorph_omega _ _ _ (latP_posDef _ (one_le_mn2 m hm n)) (latP_posDef m hm)
    (scaleIota_isometry m n) (rank_latP_eq _ _)

include hm in
theorem scaleMorph_injective : Function.Injective (scaleMorph m n) :=
  latMorph_injective _ _ _ (latP_posDef _ (one_le_mn2 m hm n)) (latP_posDef m hm)
    (scaleIota_isometry m n) (rank_latP_eq _ _)

omit [NeZero n] in
theorem mem_range_scaleIota (k : (latP m).carrier) :
    k ∈ Set.range (scaleIota m n) ↔ (n : ℤ) ∣ ci m k := by
  constructor
  · rintro ⟨j, rfl⟩; exact ⟨ci _ j, rfl⟩
  · rintro ⟨j, hj⟩; exact ⟨j, hj.symm⟩

/-- **The image of `Φ` is the cyclic orbifold.** -/
theorem range_scaleMorph :
    LinearMap.range (scaleMorph m n) = (orbifold (cycHom m hm n).range).carrier := by
  ext x
  rw [scaleMorph, mem_range_latMorph_iff _ _ _ (latP_posDef _ (one_le_mn2 m hm n)) (latP_posDef m hm)
    (scaleIota_isometry m n) (rank_latP_eq _ _)]
  change _ ↔ ∀ g ∈ (cycHom m hm n).range, g x = x
  rw [fix_cyc_iff]
  simp only [mem_range_scaleIota]

/-- **`V_{2m}^{ℤ_n} ≅ V_{2mn²}`** (Gannon–Rayhaun (C.13)): the fixed points of the cyclic group
generated by `e^{kα} ↦ ζ_n^k e^{kα}`. -/
theorem orbifold_cyclic_iso :
    VOAIsomorphic (orbifoldVOA (cycHom m hm n).range) (V2m (m * n ^ 2) (one_le_mn2 m hm n)) := by
  apply voaIso_symm
  have hΦ := scaleMorph_isVOAHom m hm n
  let f : LatModuleGen (latP (m * n ^ 2)) ≃ₗ[ℂ] (orbifold (cycHom m hm n).range).carrier :=
    (LinearEquiv.ofInjective _ (scaleMorph_injective m hm n)).trans
      (LinearEquiv.ofEq _ _ (range_scaleMorph m hm n))
  have hf : ∀ x, ((f x : (orbifold (cycHom m hm n).range).carrier) : LatModuleGen (latP m))
      = scaleMorph m n x := fun x => rfl
  refine ⟨f, ⟨?_, ?_⟩, ?_⟩
  · apply Subtype.ext
    rw [LinearEquiv.coe_toLinearMap, hf]
    exact hΦ.map_vacuum
  · intro u k x
    apply Subtype.ext
    rw [LinearEquiv.coe_toLinearMap, hf]
    exact hΦ.map_smul u k x
  · apply Subtype.ext
    rw [hf]
    exact scaleMorph_omega m hm n

/-! ### The dihedral orbifold -/

/-- Fixed by the dihedral group iff fixed by the cyclic group and by `θ`. -/
theorem fix_dih_iff (x : LatModuleGen (latP m)) :
    (∀ g ∈ (dihHom m hm n).range, g x = x) ↔
      (∀ g ∈ (cycHom m hm n).range, g x = x) ∧ thetaM m hm x = x := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · rintro _ ⟨z, rfl⟩
      exact h _ ⟨DihedralGroup.r (Multiplicative.toAdd z), rfl⟩
    · have := h _ ⟨DihedralGroup.sr 0, rfl⟩
      change (thetaM m hm * cycHom m hm n (Multiplicative.ofAdd 0)) x = x at this
      rwa [ofAdd_zero, map_one, mul_one] at this
  · rintro ⟨hc, hθ⟩ _ ⟨d, rfl⟩
    cases d with
    | r i => exact hc _ ⟨Multiplicative.ofAdd i, rfl⟩
    | sr i =>
        change (thetaM m hm * cycHom m hm n (Multiplicative.ofAdd i)) x = x
        rw [Aut.mul_apply, hc _ ⟨Multiplicative.ofAdd i, rfl⟩, hθ]

/-- **`Φ` maps `V_{2mn²}⁺` onto the dihedral orbifold.** -/
theorem map_scaleMorph_plus :
    (orbifold (Subgroup.zpowers (thetaV2m (m * n ^ 2) (one_le_mn2 m hm n)))).carrier.map
        (scaleMorph m n) = (orbifold (dihHom m hm n).range).carrier := by
  ext x
  change _ ↔ ∀ g ∈ (dihHom m hm n).range, g x = x
  rw [fix_dih_iff]
  constructor
  · rintro ⟨y, hy, rfl⟩
    replace hy := (mem_orbifold_zpowers_iff _ y).mp hy
    refine ⟨?_, ?_⟩
    · have : scaleMorph m n y ∈ (orbifold (cycHom m hm n).range).carrier := by
        rw [← range_scaleMorph]; exact ⟨y, rfl⟩
      exact this
    · change thetaLat (latP m) (scaleMorph m n y) = scaleMorph m n y
      rw [scaleMorph, ← latMorph_thetaLat]
      exact congrArg _ hy
  · rintro ⟨hc, hθ⟩
    have hx : x ∈ LinearMap.range (scaleMorph m n) := by
      rw [range_scaleMorph m hm n]; exact hc
    obtain ⟨y, rfl⟩ := hx
    refine ⟨y, (mem_orbifold_zpowers_iff _ y).mpr ?_, rfl⟩
    apply scaleMorph_injective m hm n
    change scaleMorph m n (thetaLat _ y) = scaleMorph m n y
    rw [scaleMorph, latMorph_thetaLat]
    exact hθ

/-- **`V_{2m}^{D_n} ≅ V_{2mn²}⁺`** (Gannon–Rayhaun (C.16)): the fixed points of the dihedral
group of order `2n` generated by `e^{kα} ↦ ζ_n^k e^{kα}` and `θ`. -/
theorem orbifold_dihedral_iso :
    VOAIsomorphic (orbifoldVOA (dihHom m hm n).range) (V2mPlus (m * n ^ 2) (one_le_mn2 m hm n)) := by
  apply voaIso_symm
  have hΦ := scaleMorph_isVOAHom m hm n
  set P := (orbifold (Subgroup.zpowers (thetaV2m (m * n ^ 2) (one_le_mn2 m hm n)))).carrier
  let f : P ≃ₗ[ℂ] (orbifold (dihHom m hm n).range).carrier :=
    (Submodule.equivMapOfInjective _ (scaleMorph_injective m hm n) P).trans
      (LinearEquiv.ofEq _ _ (map_scaleMorph_plus m hm n))
  have hf : ∀ x, ((f x : (orbifold (dihHom m hm n).range).carrier) : LatModuleGen (latP m))
      = scaleMorph m n (x : LatModuleGen (latP (m * n ^ 2))) := fun x => rfl
  refine ⟨f, ⟨?_, ?_⟩, ?_⟩
  · apply Subtype.ext
    rw [LinearEquiv.coe_toLinearMap, hf]
    exact hΦ.map_vacuum
  · intro u k x
    apply Subtype.ext
    rw [LinearEquiv.coe_toLinearMap, hf]
    exact hΦ.map_smul u k x
  · apply Subtype.ext
    rw [hf]
    exact scaleMorph_omega m hm n

/-! ### Packaged forms -/

/-- `V_{2m}^G ≅ V_{2mn²}` for a subgroup `G ≅ ℤ_n` of `Aut V_{2m}` (the charge rotations). -/
theorem exists_cyclic_orbifold_iso :
    ∃ G : Subgroup (Aut (V2m m hm)), Nonempty (G ≃* Multiplicative (ZMod n)) ∧
      VOAIsomorphic (orbifoldVOA G) (V2m (m * n ^ 2) (one_le_mn2 m hm n)) :=
  ⟨(cycHom m hm n).range, ⟨(MonoidHom.ofInjective (cycHom_injective m hm)).symm⟩,
    orbifold_cyclic_iso m hm n⟩

/-- `V_{2m}^G ≅ V_{2mn²}⁺` for a subgroup `G ≅ D_n` (order `2n`) of `Aut V_{2m}`. -/
theorem exists_dihedral_orbifold_iso :
    ∃ G : Subgroup (Aut (V2m m hm)), Nonempty (G ≃* DihedralGroup n) ∧
      VOAIsomorphic (orbifoldVOA G) (V2mPlus (m * n ^ 2) (one_le_mn2 m hm n)) :=
  ⟨(dihHom m hm n).range, ⟨(MonoidHom.ofInjective (dihHom_injective m hm)).symm⟩,
    orbifold_dihedral_iso m hm n⟩

/-- The cyclic orbifold `V_{2m}^{ℤ_n}` carries the label `lat (mn²)`. -/
theorem hasCOneLabel_cyclic :
    HasCOneLabel (orbifoldVOA (cycHom m hm n).range) (.lat (m * n ^ 2)) :=
  ⟨one_le_mn2 m hm n, orbifold_cyclic_iso m hm n⟩

/-- The dihedral orbifold `V_{2m}^{D_n}` carries the label `plus (mn²)` when `mn² ≥ 2`. -/
theorem hasCOneLabel_dihedral (h2 : 2 ≤ m * n ^ 2) :
    HasCOneLabel (orbifoldVOA (dihHom m hm n).range) (.plus (m * n ^ 2)) :=
  ⟨one_le_mn2 m hm n, h2, orbifold_dihedral_iso m hm n⟩

end Embed

end VOA.Classification.COne
