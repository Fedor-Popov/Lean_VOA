theorem vectorPartial6_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector prefixVector6) = evalSym W k a (symMap vectorPartial6) := by
  rw [prefixVector6, evalSym_vector_append, vectorPartial5_sound W k a,
    vectorChunk6_sound W k a]
