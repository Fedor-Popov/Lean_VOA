-- One row is added, and all equal mode indices are merged.
theorem step16_check :
    equalRelCheck (scaleRel weight_skew6 skew6 ++ partial15)
      partial16 = true := by decide +kernel

theorem partial16_holds : evalRel W selfMode partial16 = 0 := by
  have h := equalRelCheck_sound W selfMode step16_check
  rw [evalRel_append, evalRel_scale, skew6_holds, map_zero, partial15_holds,
    add_zero] at h
  exact h.symm

