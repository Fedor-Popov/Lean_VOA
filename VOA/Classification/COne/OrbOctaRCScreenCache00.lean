theorem sc22_check :
    reduceTwo (schurMemo 15) = sc22 := by
  decide +kernel

theorem sc22_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc22 = evRc a c (expWordR [] (15)) := by
  rw [← sc22_check]
  rw [evRc_reduceTwo_of_sq _ _ hc, schurMemo_sound]
  rfl

