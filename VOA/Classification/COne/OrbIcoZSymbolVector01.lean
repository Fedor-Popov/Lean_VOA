theorem vectorPartial1_check : equalRawCheck (rawChunk1 ++ vectorPartial0) vectorPartial1 = true := by
  decide +kernel

theorem vectorPartial1_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector prefixVector1) = evalSym W k a (symMap vectorPartial1) := by
  rw [prefixVector1, evalSym_vector_append, vectorPartial0_sound W k a,
    vectorChunk1_sound W k a]
  have hh := equalRawCheck_sound W k a vectorPartial1_check
  rw [symMap_append, evalSym_append] at hh
  simpa only [add_comm] using hh

