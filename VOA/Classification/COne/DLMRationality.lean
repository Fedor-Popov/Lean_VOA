import VOA.Classification.COne.AdmissibleOrdinaryLevels
import VOA.Classification.COne.LatticeRational2
import VOA.Modules.AdmissibleGradedComplement

/-!
# Dong–Li–Mason rationality implies `AdmissiblyRational` (C₂-cofinite VOAs)

DLM call a VOA **rational** when every admissible module is a direct sum of *irreducible admissible*
modules. In DLM, a submodule of an admissible module is a *graded* submodule, and irreducibility
means no non-trivial graded submodules. This is weaker than the library's
`AdmissibleModule.IsIrreducible`, which forbids all weak submodules. So the faithful statement is:

* `DLMRational W`: every admissible module is the internal direct sum of level-graded weak submodules,
  each minimal among non-zero level-graded weak submodules.

`admissiblyRational_of_dlmRational (hC2 : C2Cofinite W) : DLMRational W → AdmissiblyRational W`.

The key step is `isSimpleSub_of_gradedMinimal`: under C₂, a graded-minimal submodule has **no** proper
non-zero weak submodule.
1. A cyclic submodule of a homogeneous vector is level-graded (`cyclic_isLevelGraded`).
2. So a graded-minimal `P` is generated by any non-zero homogeneous element. Finite levels (C₂) give an
   `L(0)`-eigenvector, and the word-eigenvalue argument of `exists_level_scalar` then makes `L(0) = h + j`
   on `P ∩ M(j)`.
3. A weak submodule of `P` is `L(0)`-stable, so by distinct eigenvalues it is level-graded
   (`mem_of_eigen_sum`). Hence it is `⊥` or `P`.

Complete reducibility then comes from `exists_isCompl_of_sum_simple`, since `P` is semisimple over the
mode algebra.
-/

namespace VOA.Classification.COne.DLMRat

open PlusRational PlusFiniteLength C2LevelFinite AdmissibleOrdinary
open VOA.Huang.BuhlSpanning VOA.Huang.LogRemovalAdmissible

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
  {M : Type u} [AddCommGroup M] [Module ℂ M]

/-! ## Graded cyclic submodules -/

/-- **The cyclic submodule of a homogeneous vector is level-graded.** -/
theorem cyclic_isLevelGraded (N : AdmissibleModule W M) {k : ℤ} {x : M} (hx : x ∈ N.lev k) :
    N.IsLevelGraded (ofR N.toWeakModule (cyclic N.toWeakModule x)) := by
  classical
  set C := cyclic N.toWeakModule x
  -- vectors whose level projections all lie in `C`
  let T : Submodule ℂ M :=
    { carrier := {y | ∀ j, N.levProj j y ∈ C}
      add_mem' := fun {a b} ha hb j => by rw [map_add]; exact C.add_mem (ha j) (hb j)
      zero_mem' := fun j => by rw [map_zero]; exact C.zero_mem
      smul_mem' := fun c y hy j => by
        rw [map_smul]; exact C.smul_of_tower_mem c (hy j) }
  have hmode : ∀ (u : 𝒱) (n : ℤ), ∀ y ∈ T, mode (N.YM u) n y ∈ T := by
    intro u n
    have hu : u ∈ ⨆ w, W.grading w := by rw [W.isInternal.submodule_iSup_eq_top]; trivial
    induction hu using Submodule.iSup_induction' with
    | mem w u hu =>
        intro y hy j
        have h := N.levProj_act hu n (j - (w - n - 1)) y
        rw [show j - (w - n - 1) + (w - n - 1) = j by ring] at h
        change N.levProj j (N.toWeakModule.act u n y) ∈ C
        rw [h]
        exact C.smul_mem ⟨mode (N.YM u) n, Algebra.subset_adjoin ⟨u, n, rfl⟩⟩ (hy _)
    | zero => intro y _ j; simp [C]
    | add u u' _ _ h h' =>
        intro y hy
        rw [map_add, mode_add, LinearMap.add_apply]
        exact T.add_mem (h y hy) (h' y hy)
  have halg : ∀ f ∈ modeAlg N.toWeakModule, ∀ y ∈ T, f y ∈ T := by
    intro f hf
    induction hf using Algebra.adjoin_induction with
    | mem f hf => obtain ⟨u, n, rfl⟩ := hf; exact hmode u n
    | algebraMap c => intro y hy; rw [Module.algebraMap_end_apply]; exact T.smul_mem c hy
    | add f g _ _ hf hg => intro y hy; exact T.add_mem (hf y hy) (hg y hy)
    | mul f g _ _ hf hg => intro y hy; exact hf _ (hg y hy)
  let Tm : Submodule (modeAlg N.toWeakModule) M :=
    { T.toAddSubmonoid with smul_mem' := fun r y hy => halg r.1 r.2 y hy }
  have hxT : x ∈ Tm := by
    intro j
    by_cases hj : k = j
    · subst hj; rw [N.levProj_of_mem_same hx]; exact Submodule.mem_span_singleton_self x
    · rw [N.levProj_of_mem_ne hx hj]; exact C.zero_mem
  have hle : C ≤ Tm := (Submodule.span_le).mpr (Set.singleton_subset_iff.mpr hxT)
  intro j y hy
  exact hle hy j

/-! ## Distinct eigenvalues force homogeneity -/

/-- If an invariant subspace contains a sum of eigenvectors with distinct eigenvalues, it contains each. -/
theorem mem_of_eigen_sum (T : Module.End ℂ M) (Q : Submodule ℂ M) (hQ : ∀ y ∈ Q, T y ∈ Q)
    (lam : ℤ → ℂ) (hlam : Function.Injective lam) :
    ∀ (s : Finset ℤ) (y : ℤ → M), (∀ j ∈ s, T (y j) = lam j • y j) →
      (∑ j ∈ s, y j) ∈ Q → ∀ j ∈ s, y j ∈ Q := by
  classical
  intro s
  induction s using Finset.induction_on with
  | empty => intro y _ _ j hj; simp at hj
  | insert a s ha ih =>
      intro y hy hsum
      rw [Finset.sum_insert ha] at hsum
      -- `(T − λ_a)` kills `y a`
      have hz : (∑ j ∈ s, (lam j - lam a) • y j) ∈ Q := by
        have h1 := Q.sub_mem (hQ _ hsum) (Q.smul_mem (lam a) hsum)
        convert h1 using 1
        rw [map_add, map_sum, hy a (Finset.mem_insert_self a s), smul_add, Finset.smul_sum]
        rw [Finset.sum_congr rfl fun j hj => hy j (Finset.mem_insert_of_mem hj)]
        rw [← sub_add_sub_comm, sub_self, zero_add, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [sub_smul]
      have hs := ih (fun j => (lam j - lam a) • y j) (fun j hj => by
        rw [map_smul, hy j (Finset.mem_insert_of_mem hj), smul_comm]) hz
      have hsY : ∀ j ∈ s, y j ∈ Q := fun j hj => by
        have hne : lam j - lam a ≠ 0 := sub_ne_zero.mpr fun h => ha (hlam h ▸ hj)
        have := Q.smul_mem (lam j - lam a)⁻¹ (hs j hj)
        rwa [smul_smul, inv_mul_cancel₀ hne, one_smul] at this
      intro j hj
      rcases Finset.mem_insert.mp hj with rfl | hj
      · have := Q.sub_mem hsum (Q.sum_mem fun i hi => hsY i hi)
        rwa [add_sub_cancel_right] at this
      · exact hsY j hj

/-! ## Graded-minimal submodules are weakly simple (C₂) -/

/-- A level-graded weak submodule, minimal among the non-zero level-graded ones. -/
def GradedMinimal (N : AdmissibleModule W M) (P : WeakModule.Submodule' N.toWeakModule) : Prop :=
  N.IsLevelGraded P ∧ P.carrier ≠ ⊥ ∧
    ∀ Q : WeakModule.Submodule' N.toWeakModule, N.IsLevelGraded Q → Q.carrier ≤ P.carrier →
      Q.carrier = ⊥ ∨ Q.carrier = P.carrier

theorem GradedMinimal.cyclic_eq (N : AdmissibleModule W M) {P : WeakModule.Submodule' N.toWeakModule}
    (hP : GradedMinimal N P) {k : ℤ} {x : M} (hx : x ∈ N.lev k) (hxP : x ∈ P.carrier)
    (hx0 : x ≠ 0) : (cyclic N.toWeakModule x).restrictScalars ℂ = P.carrier := by
  have hle : (ofR N.toWeakModule (cyclic N.toWeakModule x)).carrier ≤ P.carrier := by
    intro y hy
    have : cyclic N.toWeakModule x ≤ toR N.toWeakModule P :=
      (Submodule.span_le).mpr (Set.singleton_subset_iff.mpr hxP)
    exact this hy
  rcases hP.2.2 _ (cyclic_isLevelGraded N hx) hle with h | h
  · exfalso
    have hm : x ∈ (ofR N.toWeakModule (cyclic N.toWeakModule x)).carrier :=
      Submodule.mem_span_singleton_self x
    rw [h] at hm
    exact hx0 ((Submodule.mem_bot ℂ).mp hm)
  · exact h

/-- **Under C₂, a graded-minimal submodule is weakly simple.** -/
theorem isSimpleSub_of_gradedMinimal (hC2 : C2Cofinite W) (N : AdmissibleModule W M)
    {P : WeakModule.Submodule' N.toWeakModule} (hP : GradedMinimal N P) :
    IsSimpleSub N.toWeakModule P := by
  classical
  obtain ⟨hPg, hP0, hmin⟩ := hP
  -- a non-zero homogeneous vector of `P`
  obtain ⟨y0, hy0P, hy00⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP0
  obtain ⟨k, hk⟩ : ∃ k, N.levProj k y0 ≠ 0 := by
    by_contra h; push Not at h; exact hy00 (N.eq_zero_of_levProj h)
  set x0 := N.levProj k y0
  have hx0P : x0 ∈ P.carrier := hPg k y0 hy0P
  have hx0k : x0 ∈ N.lev k := N.levProj_mem k y0
  -- an `L(0)`-eigenvector in `P ∩ M(k)`
  let S : Submodule ℂ M := P.carrier ⊓ N.lev k
  have hcyc0 := GradedMinimal.cyclic_eq N ⟨hPg, hP0, hmin⟩ hx0k hx0P hk
  haveI hfin : FiniteDimensional ℂ S := by
    letI := finiteDimensional_cyclicLevel W hC2 N k x0 hx0k k
    let f : cyclicLevel N x0 k →ₗ[ℂ] S :=
      { toFun := fun y => ⟨y.val.val, by
          refine ⟨?_, y.property⟩
          rw [← hcyc0]; exact y.val.property⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    apply FiniteDimensional.of_surjective f
    intro y
    have hyc : y.val ∈ cyclic N.toWeakModule x0 := by
      have := y.property.1; rw [← hcyc0] at this; exact this
    exact ⟨⟨⟨y.val, hyc⟩, y.property.2⟩, rfl⟩
  haveI : Nontrivial S := ⟨⟨⟨x0, hx0P, hx0k⟩, 0, fun h => hk (congrArg Subtype.val h)⟩⟩
  have hpres : ∀ y ∈ S, L0 N.toWeakModule y ∈ S := by
    intro y hy
    exact ⟨P.act_mem W.conformalVector 1 hy.1, by simpa using N.act_lev W.conformal_mem hy.2 (p := 1)⟩
  let f : Module.End ℂ S := (L0 N.toWeakModule).restrict hpres
  obtain ⟨c, hc⟩ := f.exists_eigenvalue
  obtain ⟨xs, hxs⟩ := hc.exists_hasEigenvector
  set x := xs.val
  have hxP : x ∈ P.carrier := xs.property.1
  have hxk : x ∈ N.lev k := xs.property.2
  have hx0 : x ≠ 0 := fun h => hxs.2 (Subtype.ext h)
  have heig : L0 N.toWeakModule x = c • x := congrArg Subtype.val hxs.apply_eq_smul
  have hcyc := GradedMinimal.cyclic_eq N ⟨hPg, hP0, hmin⟩ hxk hxP hx0
  -- `L(0) = c − k + j` on `P ∩ M(j)` (the argument of `exists_level_scalar`)
  obtain ⟨D⟩ := exists_genData hC2
  obtain ⟨N₀, hN₀⟩ := exists_grading_le_O₂ W hC2
  let Bm := k.toNat + Finset.univ.sup D.wt
  have hBm : ∀ i, k + (D.wt i : ℤ) ≤ Bm := by
    intro i
    have h := Finset.le_sup (f := D.wt) (Finset.mem_univ i)
    dsimp [Bm]
    omega
  have hscalar : ∀ (j : ℤ) (y : M), y ∈ P.carrier → y ∈ N.lev j →
      L0 N.toWeakModule y = (c - (k : ℂ) + (j : ℂ)) • y := by
    intro j y hyP hy
    have hcy : y ∈ cyclic N.toWeakModule x := by
      have : y ∈ (cyclic N.toWeakModule x).restrictScalars ℂ := by rw [hcyc]; exact hyP
      exact this
    have hs := cyclic_level_le_fixedDegreeSpan D N hN₀ hxk hBm j hcy hy
    have hle : Submodule.span ℂ ((fun l => wordL D N.toWeakModule l x) ''
        {l : List (Ltr D) | (∀ a, l.count a < N₀ + 1) ∧
          (∀ e ∈ l, e.2 < (Bm : ℤ)) ∧ degree D l = j - k}) ≤
        (L0 N.toWeakModule).eigenspace (c - (k : ℂ) + (j : ℂ)) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨l, ⟨_, _, hd⟩, rfl⟩
      apply Module.End.mem_eigenspace_iff.mpr
      rw [wordL_eigenvalue D N heig, hd]
      congr 1
      push_cast
      ring
    exact Module.End.mem_eigenspace_iff.mp (hle hs)
  -- every weak submodule of `P` is level-graded, hence `⊥` or `P`
  refine ⟨hP0, fun Q hQ => hmin Q ?_ hQ⟩
  intro j y hyQ
  have hyP : y ∈ P.carrier := hQ hyQ
  letI := N.levDecomp
  set s := (DirectSum.decompose N.lev y).support
  have hsum : (∑ i ∈ s, N.levProj i y) = y := by
    simp only [AdmissibleModule.levProj_apply]
    exact DirectSum.sum_support_decompose N.lev y
  have hcomp := mem_of_eigen_sum (L0 N.toWeakModule) Q.carrier
    (fun z hz => Q.act_mem W.conformalVector 1 hz)
    (fun i => c - (k : ℂ) + (i : ℂ)) (fun a b h => by simpa using h) s
    (fun i => N.levProj i y)
    (fun i _ => hscalar i _ (hPg i y hyP) (N.levProj_mem i y)) (by rw [hsum]; exact hyQ)
  by_cases hj : j ∈ s
  · exact hcomp j hj
  · have : N.levProj j y = 0 := by
      rw [AdmissibleModule.levProj_apply]
      have := DFinsupp.notMem_support_iff.mp hj
      rw [this]; rfl
    rw [this]; exact Q.carrier.zero_mem

/-! ## DLM rationality -/

/-- **Dong–Li–Mason rationality**: every admissible module is the internal direct sum of irreducible
admissible submodules, where submodules of admissible modules are graded (DLM's convention). -/
def DLMRational (W : VertexOperatorAlgebra 𝒱) : Prop :=
  ∀ {M : Type u} [AddCommGroup M] [Module ℂ M] (N : AdmissibleModule W M),
    ∃ (ι : Type u) (P : ι → WeakModule.Submodule' N.toWeakModule),
      iSupIndep (fun i => (P i).carrier) ∧ ⨆ i, (P i).carrier = ⊤ ∧ ∀ i, GradedMinimal N (P i)

/-- **DLM rationality implies `AdmissiblyRational`**, for `C₂`-cofinite VOAs. -/
theorem admissiblyRational_of_dlmRational (hC2 : C2Cofinite W) (h : DLMRational W) :
    AdmissiblyRational W := by
  intro M _ _ N P
  obtain ⟨ι, Pf, -, htop, hmin⟩ := h N
  refine exists_isCompl_of_sum_simple N.toWeakModule (fun x => ?_) P
  have hx : x ∈ ⨆ i, (Pf i).carrier := by rw [htop]; trivial
  have hle : ⨆ i, (Pf i).carrier ≤
      ⨆ (P : WeakModule.Submodule' N.toWeakModule) (_ : IsSimpleSub N.toWeakModule P), P.carrier :=
    iSup_le fun i => le_iSup₂_of_le (Pf i) (isSimpleSub_of_gradedMinimal hC2 N (hmin i)) le_rfl
  exact hle hx

end VOA.Classification.COne.DLMRat

