set_option linter.style.longLine false
noncomputable section
namespace VOA.Classification.COne.OrbIcoZ
open VOA OrbOdd OrbZhu Polynomial OrbIco

def detTermFirst1 : PL := [mkRat (0) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1]

set_option maxHeartbeats 8000000 in
-- One product only: avoid retaining the full determinant calculation in one reduction.
theorem detTermFirst1_check :
    ptrim (paddL (pmulL matrixEntry7_1 commonMinor1) (pscaleL (-1) detTermFirst1)) = [] := by
  decide +kernel

theorem detTermFirst1_sound : zp detTermFirst1 =
    (zp matrixEntry7_1 * zp commonMinor1) := by
  have hh := (zp_eq_of_trim detTermFirst1_check).symm
  simpa [zp_pscaleL, zp_pmulL] using hh

end VOA.Classification.COne.OrbIcoZ
