-- One row is added, and all equal mode indices are merged.
theorem step45_check :
    equalRelCheck (scaleRel weight_high37 high37 ++ partial44)
      partial45 = true := by decide +kernel

theorem partial45_holds : evalRel W selfMode partial45 = 0 := by
  have h := equalRelCheck_sound W selfMode step45_check
  rw [evalRel_append, evalRel_scale, high37_holds, map_zero, partial44_holds,
    add_zero] at h
  exact h.symm

