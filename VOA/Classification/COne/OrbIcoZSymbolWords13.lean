-- The kernel checks one recursion step against the already cached tail.
theorem wordCache111_check : equalRawCheck
    (rawScale (rawFactor 3 81) wordCache83 ++
      rawScale (rawSecond 3) (rawShift 3 wordCache83)) wordCache111 = true := by
  decide +kernel

theorem wordCache111_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symWord [3, 2, 2, 2, 1, 1, 1, 1]) = evalSym W k a (symMap wordCache111) := by
  rw [symWord, evalSym_normalize, evalSym_append, evalSym_scale, evalSym_scale,
    evalSym_shift, wordCache83_sound W k a, wordCache83_sound W (k - (3 : ℕ)) a]
  have hh := equalRawCheck_sound W k a wordCache111_check
  rw [symMap_append, symMap_scale, symMap_scale, symMap_shift, evalSym_append,
    evalSym_scale, evalSym_scale, evalSym_shift, bp_rawFactor, bp_rawSecond] at hh
  norm_num only [List.sum_cons, List.sum_nil, Nat.reduceAdd, Nat.cast_ofNat] at ⊢
  exact hh

