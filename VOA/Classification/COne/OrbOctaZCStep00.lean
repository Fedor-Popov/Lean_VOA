-- One row is added, and all equal mode indices are merged.
theorem step2_check :
    equalRelCheck (scaleRel weight_sing2 sing2 ++ partial1)
      partial2 = true := by decide +kernel

theorem partial2_holds : evalRel W selfMode partial2 = 0 := by
  have h := equalRelCheck_sound W selfMode step2_check
  rw [evalRel_append, evalRel_scale, sing2_holds, map_zero, partial1_holds,
    add_zero] at h
  exact h.symm

