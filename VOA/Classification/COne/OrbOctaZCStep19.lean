set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step40_check :
    equalRelCheck (scaleRel weight_high32 high32 ++ partial39)
      partial40 = true := by decide +kernel

theorem partial40_holds : evalRel W selfMode partial40 = 0 := by
  have h := equalRelCheck_sound W selfMode step40_check
  rw [evalRel_append, evalRel_scale, high32_holds, map_zero, partial39_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
