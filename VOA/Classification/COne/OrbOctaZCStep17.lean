-- One row is added, and all equal mode indices are merged.
theorem step36_check :
    equalRelCheck (scaleRel weight_low4 low4 ++ partial35)
      partial36 = true := by decide +kernel

theorem partial36_holds : evalRel W selfMode partial36 = 0 := by
  have h := equalRelCheck_sound W selfMode step36_check
  rw [evalRel_append, evalRel_scale, low4_holds, map_zero, partial35_holds,
    add_zero] at h
  exact h.symm

