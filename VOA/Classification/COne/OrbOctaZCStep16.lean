set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step34_check :
    equalRelCheck (scaleRel weight_sing34 sing34 ++ partial33)
      partial34 = true := by decide +kernel

theorem partial34_holds : evalRel W selfMode partial34 = 0 := by
  have h := equalRelCheck_sound W selfMode step34_check
  rw [evalRel_append, evalRel_scale, sing34_holds, map_zero, partial33_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
