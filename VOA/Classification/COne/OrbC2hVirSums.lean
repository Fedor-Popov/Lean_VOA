theorem evaluate_flatten_vectors (ss : List SectorVector) :
    evaluate ss.flatten = (ss.map evaluate).sum := by
  induction ss with
  | nil => rfl
  | cons s ss ih => simp only [List.flatten_cons, evaluate_append, ih, List.map_cons, List.sum_cons]

