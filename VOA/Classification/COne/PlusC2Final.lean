import VOA.Classification.COne.PlusC2M1Gen

/-!
# `V_{2m}⁺` is `C₂`-cofinite

`v2mPlusC2CofiniteFactGe2_holds : V2mPlusC2CofiniteFactGe2` — **the cited fact of
Yamskulna (Comm. Algebra 32 (2004), Thm 5.1) / Abe–Buhl–Dong (Trans. AMS 356 (2004), Thm 5.3) for
the rank-one lattices `√(2m)ℤ`, `m ≥ 2`, is a theorem**, with no hypotheses.

The proof chain (all in `VOA/Classification/COne/`):

* `PlusC2Sector`: `V⁺ = C₂(V⁺) + M(1)⁺ + V⁺(1)` (Yamskulna §4, new short proof, all `m ≥ 1`).
* `PlusC2OneProof`: `V⁺(1) ⊆ C₂(V⁺) + E₍₋₁₎M(1)⁺` for `m ≥ 2` (`sectorOneViaE_holds`).
* `PlusC2Zero` / `PlusC2M1Sub` / `PlusC2M1Ring`: the `M(1)⁺` sector is finite modulo `C₂(V⁺)` once
  `M(1)⁺` is strongly generated by `ω, W⁴` and `W̄² ∈ ℂω̄²W̄ + ℂω̄⁴`, `ω̄³W̄ ∈ ℂω̄⁵` hold in
  `A₂(M(1)⁺)`; the charged relations `P(S_d(sα)) ∈ C₂(V⁺)` kill the surviving line `ℂω̄^{w/2}`.
* `PlusC2M1Cert`: the two relations (`rel8M_holds`, `rel10M_holds`; kernel-checked certificates).
* `PlusC2M1Pair` / `PlusC2M1Ops` / `PlusC2M1Gen`: strong generation (`strongGenM1_holds`):
  finite generator OPE table, `L(−1)` and `W⁴₍₁₎` as Fock derivations, weight/degree induction.

Consequently `C₂`-cofiniteness of `V_{2m}⁺` holds for **every** `m ≥ 1` (`V2mPlus_c2Cofinite`),
and the `.plus` clause of GR Prop. 3.2 rests only on the rationality and pseudo-unitarity
facts (`nice_V2mPlus_of_rational_pseudoUnitary`).
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

open PlusC2

/-- **`V_{2m}⁺` is `C₂`-cofinite for every `m ≥ 2`** (Yamskulna 2004, Thm 5.1; Abe–Buhl–Dong
2004, Thm 5.3), unconditionally. -/
theorem v2mPlusC2CofiniteFactGe2_holds : V2mPlusC2CofiniteFactGe2 :=
  v2mPlusC2CofiniteFactGe2_of_M1PResiduals fun m hm _ =>
    ⟨strongGenM1_holds m hm, rel8M_holds m hm, rel10M_holds m hm⟩

/-- The cited fact of `PlusNice.lean`, for all `m ≥ 1`. -/
theorem v2mPlusC2CofiniteFact_holds : V2mPlusC2CofiniteFact :=
  v2mPlusC2CofiniteFact_iff.mpr v2mPlusC2CofiniteFactGe2_holds

/-- **`V_{2m}⁺` is `C₂`-cofinite for every `m ≥ 1`.** -/
theorem V2mPlus_c2Cofinite (m : ℕ) (hm : 1 ≤ m) : C2Cofinite (V2mPlus m hm) :=
  v2mPlusC2CofiniteFact_holds m hm

/-- **`V_{2m}⁺` is nice**, conditional only on the rationality and pseudo-unitarity facts. -/
theorem nice_V2mPlus_of_rational_pseudoUnitary (hRat : V2mPlusRationalFactGe2)
    (hPU : V2mPlusPseudoUnitaryFactGe2) (m : ℕ) (hm : 1 ≤ m) : Nice (V2mPlus m hm) :=
  nice_V2mPlus_of_factsGe2 v2mPlusC2CofiniteFactGe2_holds hRat hPU m hm

/-- **The `.plus` clause of Gannon–Rayhaun Prop. 3.2**, conditional only on rationality and
pseudo-unitarity. -/
theorem nice_of_hasCOneLabel_plus_of_rational_pseudoUnitary (hRat : V2mPlusRationalFactGe2)
    (hPU : V2mPlusPseudoUnitaryFactGe2)
    {𝒱 : Type} [AddCommGroup 𝒱] [Module ℂ 𝒱] (V : VertexOperatorAlgebra 𝒱) (m : ℕ)
    (h : HasCOneLabel V (.plus m)) : Nice V ∧ V.centralCharge = 1 :=
  nice_of_hasCOneLabel_plus_of_factsGe2 v2mPlusC2CofiniteFactGe2_holds hRat hPU V m h

end VOA.Classification.COne

section AxiomAudit
#print axioms VOA.Classification.COne.PlusC2.strongGenM1_holds
#print axioms VOA.Classification.COne.PlusC2.rel8M_holds
#print axioms VOA.Classification.COne.PlusC2.rel10M_holds
#print axioms VOA.Classification.COne.PlusC2.m1PLine_of_strongGen
#print axioms VOA.Classification.COne.PlusC2.m1PlusC2Line_of_M1PLine
#print axioms VOA.Classification.COne.v2mPlusC2CofiniteFactGe2_holds
#print axioms VOA.Classification.COne.v2mPlusC2CofiniteFact_holds
#print axioms VOA.Classification.COne.V2mPlus_c2Cofinite
#print axioms VOA.Classification.COne.nice_V2mPlus_of_rational_pseudoUnitary
#print axioms VOA.Classification.COne.nice_of_hasCOneLabel_plus_of_rational_pseudoUnitary
end AxiomAudit
