import VOA.Classification.COne.OrbC2eCertificates

/-! # Kernel certificates: the spin-3, charge-0 primary `f₀³ e^{3β}` of `V₂` as a raw polynomial

Raw variable `0` is the charge coordinate `c = chargeCoord (−β)` (with `c² = 2`, reduced by
`reduceR 2`), raw variable `i+1` is `h(−i−1)`.  The three steps `e^{3β} ↦ f₀ e^{3β} ↦ f₀² e^{3β}
↦ f₀³ e^{3β}` are the exponential actions `expPolyR 5`, `expPolyR 3`, `expPolyR 1`.
-/

set_option maxSynthPendingDepth 3
set_option Elab.async false
set_option maxHeartbeats 400000

namespace VOA.Classification.COne.OrbRat6

open VOA.SparseRational VOA.Classification.COne.OrbC2e VOA.Classification.COne.PlusC2Eval

