import VOA.Classification.COne.OrbPos9Induction
import VOA.Huang.HKLRationalSeparable

/-! # Free-module generation without rigidity

The free module is generated by its unit. Consequently a nonzero linear map
from it cannot kill that unit. For an irreducible ordinary source this gives
an injective ordinary-module map. These are general facts about algebra objects,
independent of the orbifold extension algebra and simple-target constructions.
-/
noncomputable section
namespace VOA.Classification.COne.OrbPos9
open CategoryTheory CategoryTheory.Limits MonoidalCategory VOA.Huang.HKLRational
universe v u
section Abstract
variable {C : Type u} [Category.{v} C] [MonoidalCategory C]
  {A : C} [MonObj A]

/-- The ordinary unit of the free left module. -/
def freeUnit (X : C) : X ⟶ A ⊗ X := (λ_ X).inv ≫ (MonObj.one ▷ X)

/-- The free left action. -/
def freeAction (X : C) : A ⊗ (A ⊗ X) ⟶ A ⊗ X :=
  (α_ A A X).inv ≫ (MonObj.mul ▷ X)

theorem freeAction_laws (X : C) : IsLeftAct (freeAction (A := A) X) :=
  isLeftAct_free X

/-- Acting on the free generators is the identity on the free module. -/
theorem freeUnit_generates (X : C) :
    (A ◁ freeUnit (A := A) X) ≫ freeAction X = 𝟙 (A ⊗ X) := by
  unfold freeUnit freeAction
  calc
    _ = (ρ_ A).inv ▷ X ≫ ((A ◁ MonObj.one) ▷ X) ≫ (MonObj.mul ▷ X) := by
      monoidal
    _ = 𝟙 (A ⊗ X) := by
      rw [← comp_whiskerRight, MonObj.mul_one, ← comp_whiskerRight]
      simp

/-- A linear map from a free module is determined by its restriction to the unit. -/
theorem free_map_eq {X Y : C} (aY : A ⊗ Y ⟶ Y) (q : A ⊗ X ⟶ Y)
    (hq : IsLinear (freeAction X) aY q) :
    q = (A ◁ (freeUnit X ≫ q)) ≫ aY := by
  rw [whiskerLeft_comp, Category.assoc, hq, ← Category.assoc, freeUnit_generates,
    Category.id_comp]

variable [Preadditive C] [MonoidalPreadditive C]

/-- Every nonzero linear map from a free module is nonzero on its generators. -/
theorem freeUnit_comp_ne_zero {X Y : C} (aY : A ⊗ Y ⟶ Y) (q : A ⊗ X ⟶ Y)
    (hq : IsLinear (freeAction X) aY q) (hne : q ≠ 0) : freeUnit X ≫ q ≠ 0 := by
  intro hz
  have he := free_map_eq aY q hq
  rw [hz, MonoidalPreadditive.whiskerLeft_zero, zero_comp] at he
  exact hne he
end Abstract

open VOA VOA.Huang.FusionUnit VOA.Huang.TensorCat
universe w
variable {V : Type w} [AddCommGroup V] [Module ℂ V] {W : VertexOperatorAlgebra V}

/-- Only irreducibility of the source is needed for injectivity of a nonzero map. -/
theorem injective_of_irreducible_source {X Y : Ordinary W} (hX : X.isMod.IsIrreducible)
    (f : X ⟶ Y) (hf : f ≠ 0) : Function.Injective f.val := by
  rw [← LinearMap.ker_eq_bot]
  rcases hX.2 (kerSub f.property) with h | h
  · exact h
  · exact (hf (Subtype.ext (LinearMap.ker_eq_top.mp h))).elim

/-- A nonzero algebra-module quotient (or merely a nonzero algebra-module map)
contains the original irreducible ordinary module. -/
theorem free_target_embedding (F : FusionChoice W) (hW : StronglyRational W)
    (A X Y : Ordinary W) (hX : X.isMod.IsIrreducible) :
    letI := monoidalCategoryOfStronglyRational_pbw F hW
    ∀ [MonObj A] (aY : A ⊗ Y ⟶ Y) (q : A ⊗ X ⟶ Y),
      IsLinear (freeAction X) aY q → q ≠ 0 →
      Function.Injective (freeUnit X ≫ q).val := by
  letI := monoidalCategoryOfStronglyRational_pbw F hW
  letI := VOA.Huang.TensorCat.BraidRibbon.monoidalPreadditive_pbw F hW
  intro _ aY q hq hne
  exact injective_of_irreducible_source hX _ (freeUnit_comp_ne_zero aY q hq hne)

end VOA.Classification.COne.OrbPos9
