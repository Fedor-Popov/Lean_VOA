abbrev JetRecurrence (self : Bool) (n : ℕ) : Prop :=
  let P := precisionBefore self n
  jetAdd P (jetMul P (coefficientJets self n 0) (valueJets self n))
    (jetSum P ((List.range (min 6 n)).map fun q =>
      jetMul P (coefficientJets self (n-(q+1)) (q+1)) (valueJets self (n-(q+1))))) = jetZero P

abbrev JetPivot (self : Bool) (n : ℕ) : Prop :=
  (∀ j : Fin (denominatorOrder self n), ((coefficientJets self n 0)[(j : ℕ)]?).getD 0=0) ∧
    ((coefficientJets self n 0)[denominatorOrder self n]?).getD 0 ≠ 0

