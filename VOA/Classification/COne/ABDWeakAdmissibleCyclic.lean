import VOA.Classification.COne.ABDWeakAdmissibleSpanning
import VOA.Classification.COne.ABDWeakAdmissibleSpectrum

/-!
# Admissibility of weak modules generated by a generalized conformal eigenvector

This is an unconditional C₂-cofinite result, with no preexisting admissible
structure. Normal words applied to a generalized eigenvector have distinct
predicted generalized weights; independence of generalized eigenspaces makes
the normal-word lower degree bound a spectral lower bound.
-/

namespace VOA.Classification.COne.ABDWeakAdmissible

open VOA.Huang.BuhlSpanning VOA.Huang.LogRemovalAdmissible C2LevelFinite PlusRational

universe u
variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
  {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]

/-- Words on a generalized conformal eigenvector shift its weight by their degree. -/
theorem wordL_mem_maxGenEigenspace (D : GenData W) (A : WeakModule W M)
    {α : ℂ} {x : M} (hx : x ∈ (L0 A).maxGenEigenspace α) (l : List (Ltr D)) :
    wordL D A l x ∈ (L0 A).maxGenEigenspace (α + (degree D l : ℂ)) := by
  induction l with
  | nil => simpa using hx
  | cons a l ih =>
    have hh := mode_mem_maxGenEigenspace A (D.gen_mem a.1) a.2 ih
    rw [wordL_cons, degree_cons]
    convert hh using 1
    congr 1
    push_cast
    ring

/-- A bounded-weight spanning family forces the same bound on the actual spectrum. -/
theorem spectral_bound_of_spanning (A : WeakModule W M) (b : ℝ)
    (hspan : (⊤ : Submodule ℂ M) ≤
      ⨆ (α : ℂ) (_ : b ≤ α.re), (L0 A).maxGenEigenspace α) :
    ∀ α : ℂ, (L0 A).maxGenEigenspace α ≠ ⊥ → b ≤ α.re := by
  intro α hα
  by_contra hlt
  have hd := (L0 A).independent_genEigenspace ⊤
    |>.disjoint_biSup (y := {β : ℂ | b ≤ β.re}) hlt
  have he : (⨆ (β : ℂ) (_ : b ≤ β.re), (L0 A).maxGenEigenspace β) = ⊤ :=
    top_unique hspan
  change Disjoint ((L0 A).maxGenEigenspace α)
    (⨆ (β : ℂ) (_ : b ≤ β.re), (L0 A).maxGenEigenspace β) at hd
  rw [he, disjoint_top] at hd
  exact hα hd

/-- A C₂-cofinite weak module generated by a generalized conformal eigenvector
is admissible, with exactly its given action. No irreducibility is assumed. -/
theorem generalized_cyclic_isAdmissible (hC2 : C2Cofinite W) (A : WeakModule W M)
    (x : M) (α : ℂ) (hx : x ∈ (L0 A).maxGenEigenspace α)
    (hcyc : cyclic A x = ⊤) :
    ∃ N : AdmissibleModule W M, N.toWeakModule = A := by
  obtain ⟨D⟩ := exists_genData hC2
  obtain ⟨N₀, hN₀⟩ := exists_grading_le_O₂ W hC2
  obtain ⟨Bm, hcut⟩ := exists_generator_cutoff D A x
  obtain ⟨b, hb⟩ := exists_degree_lower_bound D (N₀ + 1) Bm
  have hsp := cyclic_le_boundedNormalSpan D A hN₀ x hcut
  rw [hcyc] at hsp
  have hbounded : (⊤ : Submodule ℂ M) ≤
      ⨆ (β : ℂ) (_ : α.re + (b : ℝ) ≤ β.re), (L0 A).maxGenEigenspace β := by
    apply le_trans hsp
    apply Submodule.span_le.mpr
    rintro _ ⟨l, hn, hm, rfl⟩
    have hdeg : α.re + (b : ℝ) ≤ (α + (degree D l : ℂ)).re := by
      simp only [Complex.add_re, Complex.intCast_re]
      have hbd : (b : ℝ) ≤ (degree D l : ℝ) := by exact_mod_cast hb l hn.2 hm
      linarith
    exact Submodule.mem_iSup_of_mem (α + (degree D l : ℂ))
      (Submodule.mem_iSup_of_mem hdeg (wordL_mem_maxGenEigenspace D A hx l))
  have hspan : (⨆ β : ℂ, (L0 A).maxGenEigenspace β) = ⊤ := by
    apply top_unique
    apply le_trans hbounded
    exact iSup_le (fun β => iSup_le (fun _ => le_iSup _ β))
  exact exists_admissible_of_spectral_bound A hspan (α.re + (b : ℝ))
    (spectral_bound_of_spanning A _ hbounded)

/-- Local finiteness is unconditional on weak modules with a generalized-eigenvector
cyclic generator; the admissible local-finiteness theorem applies after construction. -/
theorem generalized_cyclic_L0_locally_finite (hC2 : C2Cofinite W) (A : WeakModule W M)
    (x : M) (α : ℂ) (hx : x ∈ (L0 A).maxGenEigenspace α)
    (hcyc : cyclic A x = ⊤) (y : M) :
    ∃ S : Submodule ℂ M, FiniteDimensional ℂ S ∧ y ∈ S ∧
      ∀ z ∈ S, L0 A z ∈ S := by
  obtain ⟨N, rfl⟩ := generalized_cyclic_isAdmissible hC2 A x α hx hcyc
  exact PlusSplitting.admissible_L0_locally_finite W hC2 N y

end VOA.Classification.COne.ABDWeakAdmissible
