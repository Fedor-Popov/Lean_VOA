import VOA.Classification.COne.PlusC2M1Ops

/-!
# `M(1)⁺` is strongly generated by `ω` and `W⁴`

Let `T = iterProdSpan M1P {ω, W⁴}`; it is closed under all products (`T_smul_closed`).  Let
`TF ⊆ Fock` be the Fock polynomials `q` with `q ⊗ e⁰ ∈ T`.

## The argument (a weight/degree induction)

Every even monomial `x^s` of weight `w` lies in `TF`, by induction on `w` and then on the degree:

* **degree `≥ 4`**: `x^s = x_i x_j · x^{s'}`; both factors have lower weight, so their
  `₍₋₁₎`-product is in `T`; its leading term is `x^s` and the rest has degree `< deg s`
  (`word_smul_neg_one_sub_mem_Fil`), weight `w` and is `σ`-even — inner induction.
* **degree `2`** (`quad_lemma`): `L(−1) = Dop` gives
  `x_p x_q ≡ (−1)^p·C(p+q,p)·x₀x_{p+q}` modulo `T` (`stepA`); for odd `w` this forces
  `x₀x_{w−2} ∈ T`, for even `w ≥ 4` the derivation `W⁴₍₁₎ = DWop` gives
  `DWop(x₀x_{w−4}) ≡ (40·C(w−2,2) + 10(w−3)(w−2)²)·x₀x_{w−2}` with a nonzero coefficient.

## Main results

* `monomial_mem_TF` — every even monomial is in `TF`.
* `strongGenM1_holds : StrongGenM1 m hm` — **Dong–Nagatomo's strong generation of `M(1)⁺`**
  (J. Algebra 216 (1999), Thm 2.7, in the form of Yamskulna 2004, Prop. 4.14), with the quadratic
  quasi-primary `W⁴` in place of `J`.
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

open VOA VOA.LatGen VOA.LatGen.Triplet VOA.IntegralLattice HeisenbergN VOA.Moonshine LatMod
  MvPolynomial VOA.TripletNilp VOA.SparseRational PlusC2Eval

namespace PlusC2

variable (m : ℕ) (hm : 1 ≤ m)

/-! ## §1  `TF` -/

/-- The Fock polynomials realised in `T`. -/
noncomputable def TF : Submodule ℂ (FockN (rank (latP m))) where
  carrier := {q | ∃ x ∈ TM m hm, (x : LatModuleGen (latP m)) = latStateGen (latP m) q 0}
  add_mem' := by
    rintro a b ⟨x, hx, hxa⟩ ⟨y, hy, hyb⟩
    exact ⟨x + y, Submodule.add_mem _ hx hy, by rw [Submodule.coe_add, hxa, hyb, latStateGen_add_boson]⟩
  zero_mem' := ⟨0, Submodule.zero_mem _, by simp [latStateGen]⟩
  smul_mem' := by
    rintro c a ⟨x, hx, hxa⟩
    exact ⟨c • x, Submodule.smul_mem _ c hx, by rw [Submodule.coe_smul, hxa, latStateGen_csmul]⟩

theorem one_mem_TF : (1 : FockN (rank (latP m))) ∈ TF m hm :=
  ⟨(M1P m hm).vacuum, vacuum_mem_iterProdSpan _ _, rfl⟩

theorem ωM_mem_TM : ωM m hm ∈ TM m hm := by
  have := iw_mem m hm [(true, 1)] (by decide +kernel)
  simpa [iwVal, gen] using this

theorem WM_mem_TM : WM m hm ∈ TM m hm := by
  have := iw_mem m hm [(false, 1)] (by decide +kernel)
  simpa [iwVal, gen] using this

theorem TF_Dop {q : FockN (rank (latP m))} (hq : q ∈ TF m hm) : Dop m q ∈ TF m hm := by
  obtain ⟨x, hx, hxq⟩ := hq
  refine ⟨(M1P m hm).toPreVertexAlgebra.T x, ?_, ?_⟩
  · rw [VertexOperatorAlgebra.T_eq_Lneg1]; exact L_neg_one_mem_iterProdSpan _ _ hx
  · rw [PreVertexAlgebra.T_apply, M1P_smul_coe]
    change (V2m m hm).smul (x : LatModuleGen (latP m)) (-2) (V2m m hm).vacuum = _
    rw [← PreVertexAlgebra.T_apply, hxq, T_latStateGen]

theorem TF_DWop {q : FockN (rank (latP m))} (hq : q ∈ TF m hm) : DWop m q ∈ TF m hm := by
  obtain ⟨x, hx, hxq⟩ := hq
  refine ⟨(M1P m hm).smul (WM m hm) 1 x, T_smul_closed m hm (WM_mem_TM m hm) 1 hx, ?_⟩
  rw [M1P_smul_coe, hxq]
  exact W1_latStateGen m hm q

theorem sigma_of_mem {r : FockN (rank (latP m))} (h : latStateGen (latP m) r 0 ∈ m1Carrier m hm) :
    sigmaN (rank (latP m)) r = r := by
  obtain ⟨q, hq, he⟩ := (mem_m1Carrier_iff m hm _).mp h
  have : r = q := by
    have := congrArg (coordEα (latP m) 0) he
    rwa [coordEα_latStateGen_zero, coordEα_latStateGen_zero] at this
  rw [this, hq]

theorem TF_mul {q₁ q₂ : FockN (rank (latP m))} (h₁ : q₁ ∈ TF m hm) (h₂ : q₂ ∈ TF m hm) :
    ∃ r ∈ TF m hm, (V2m m hm).smul (latStateGen (latP m) q₁ 0) (-1) (latStateGen (latP m) q₂ 0) =
      latStateGen (latP m) r 0 ∧ sigmaN (rank (latP m)) r = r := by
  obtain ⟨x₁, hx₁, he₁⟩ := h₁
  obtain ⟨x₂, hx₂, he₂⟩ := h₂
  obtain ⟨r, hr⟩ := smul_sector_zero m hm q₁ q₂ (-1)
  set y := (M1P m hm).smul x₁ (-1) x₂
  have hy : (y : LatModuleGen (latP m)) = latStateGen (latP m) r 0 := by
    rw [M1P_smul_coe, he₁, he₂, hr]
  refine ⟨r, ⟨y, T_smul_closed m hm hx₁ (-1) hx₂, hy⟩, hr, sigma_of_mem m hm ?_⟩
  rw [← hy]; exact y.2

/-! ## §2  Coefficient bookkeeping -/

theorem coordEα_mem_gradingZN {n : ℤ} {x : LatModuleGen (latP m)} (hx : x ∈ gradingLatGen (latP m) n) :
    coordEα (latP m) 0 x ∈ gradingZN (rank (latP m)) n := by
  induction hx using Submodule.iSup_induction' with
  | mem α y hy =>
    obtain ⟨q, hq, rfl⟩ := hy
    rw [mkEα_apply, coordEα_apply]
    split_ifs with h
    · subst h; rwa [halfNorm_zero, sub_zero] at hq
    · exact Submodule.zero_mem _
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy

theorem mem_gradingWN_of_lat {w : ℕ} {r : FockN (rank (latP m))}
    (h : latStateGen (latP m) r 0 ∈ (V2m m hm).grading w) : r ∈ gradingWN (rank (latP m)) w := by
  have := coordEα_mem_gradingZN m h
  rwa [coordEα_latStateGen_zero, gradingZN_of_nonneg (Int.natCast_nonneg w), Int.toNat_natCast] at this

theorem coeff_FilF {e : ℤ} {R : FockN (rank (latP m))} (hR : R ∈ FilF (latP m) e) :
    ∀ t, coeff t R ≠ 0 → (monoDeg (latP m) t : ℤ) ≤ e := by
  refine Submodule.span_induction (p := fun R _ => ∀ t, coeff t R ≠ 0 → (monoDeg (latP m) t : ℤ) ≤ e)
    ?_ ?_ ?_ ?_ hR
  · rintro _ ⟨s, hs, rfl⟩ t ht
    rw [coeff_monomial] at ht
    split_ifs at ht with h
    · subst h; exact hs
    · exact absurd rfl ht
  · intro t ht; simp at ht
  · intro x y _ _ hx hy t ht
    rw [coeff_add] at ht
    by_cases h : coeff t x = 0
    · rw [h, zero_add] at ht; exact hy t ht
    · exact hx t h
  · intro c x _ hx t ht
    rw [coeff_smul, smul_eq_mul] at ht
    exact hx t (right_ne_zero_of_mul ht)

theorem coeff_gradingWN {w : ℕ} {R : FockN (rank (latP m))} (hR : R ∈ gradingWN (rank (latP m)) w)
    (t : (ℕ × Fin (rank (latP m))) →₀ ℕ) (ht : coeff t R ≠ 0) : monoWt (latP m) t = w := by
  have := (mem_gradingWN.mp hR) ht
  rw [← this, Finsupp.weight_apply, monoWt]
  refine Finsupp.sum_congr fun v _ => ?_
  simp [weightFnN, mul_comm]

theorem coeff_even {R : FockN (rank (latP m))} (hR : sigmaN (rank (latP m)) R = R)
    (t : (ℕ × Fin (rank (latP m))) →₀ ℕ) (ht : coeff t R ≠ 0) : Even (monoDeg (latP m) t) := by
  by_contra hodd
  rw [Nat.not_even_iff_odd] at hodd
  have h := coeff_sigmaN m t R
  rw [hR] at h
  have h2 : (t.sum fun _ k => k) = monoDeg (latP m) t := rfl
  rw [h2, Odd.neg_one_pow hodd] at h
  apply ht
  have : (2 : ℂ) * coeff t R = 0 := by linear_combination h
  simpa using this

theorem mem_TF_of_support {R : FockN (rank (latP m))}
    (h : ∀ t ∈ R.support, monomial t (1 : ℂ) ∈ TF m hm) : R ∈ TF m hm := by
  rw [R.as_sum]
  refine Submodule.sum_mem _ fun t ht => ?_
  rw [show monomial t (coeff t R) = coeff t R • monomial t (1 : ℂ) by
    rw [smul_monomial, smul_eq_mul, mul_one]]
  exact Submodule.smul_mem _ _ (h t ht)

/-! ## §3  Monomials -/

/-- `x_k = X(k, a₀)`. -/
noncomputable abbrev xk (k : ℕ) : FockN (rank (latP m)) := X (k, a0 m)

theorem monomial_two (i j : ℕ) :
    monomial (Finsupp.single (i, a0 m) 1 + Finsupp.single (j, a0 m) 1) (1 : ℂ) = xk m i * xk m j := by
  rw [monomial_add_single, pow_one]; rfl

theorem monoWt_two (i j : ℕ) :
    monoWt (latP m) (Finsupp.single (i, a0 m) 1 + Finsupp.single (j, a0 m) 1) = i + j + 2 := by
  rw [monoWt_add, monoWt_single, monoWt_single]; ring

theorem monoDeg_two (i j : ℕ) :
    monoDeg (latP m) (Finsupp.single (i, a0 m) 1 + Finsupp.single (j, a0 m) 1) = 2 := by
  rw [monoDeg_add, monoDeg_single, monoDeg_single]

/-- A monomial of degree `≥ 2` splits off two variables. -/
theorem exists_split (s : (ℕ × Fin (rank (latP m))) →₀ ℕ) (h : 2 ≤ monoDeg (latP m) s) :
    ∃ (i j : ℕ) (s' : (ℕ × Fin (rank (latP m))) →₀ ℕ),
      s = s' + (Finsupp.single (i, a0 m) 1 + Finsupp.single (j, a0 m) 1) := by
  have hne : ∀ t : (ℕ × Fin (rank (latP m))) →₀ ℕ, 1 ≤ monoDeg (latP m) t → ∃ v, v ∈ t.support := by
    intro t ht
    by_contra hc
    push Not at hc
    have : t = 0 := by ext v; by_contra h'; exact hc v (Finsupp.mem_support_iff.mpr h')
    rw [this] at ht; simp [monoDeg] at ht
  have hsplit : ∀ (t : (ℕ × Fin (rank (latP m))) →₀ ℕ) (v : ℕ × Fin (rank (latP m))), v ∈ t.support →
      t = (t - Finsupp.single v 1) + Finsupp.single v 1 ∧
        monoDeg (latP m) (t - Finsupp.single v 1) + 1 = monoDeg (latP m) t := by
    intro t v hv
    have hle : Finsupp.single v 1 ≤ t := by
      intro u
      rw [Finsupp.single_apply]
      split_ifs with h
      · subst h; exact Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hv)
      · exact Nat.zero_le _
    have he := (tsub_add_cancel_of_le hle).symm
    refine ⟨he, ?_⟩
    conv_rhs => rw [he]
    rw [monoDeg_add, monoDeg_single]
  obtain ⟨v₁, hv₁⟩ := hne s (by omega)
  obtain ⟨hs1, hd1⟩ := hsplit s v₁ hv₁
  obtain ⟨v₂, hv₂⟩ := hne (s - Finsupp.single v₁ 1) (by omega)
  obtain ⟨hs2, -⟩ := hsplit _ v₂ hv₂
  refine ⟨v₂.1, v₁.1, (s - Finsupp.single v₁ 1) - Finsupp.single v₂ 1, ?_⟩
  have e1 : v₁ = (v₁.1, a0 m) := Prod.ext rfl (a0_unique m v₁.2)
  have e2 : v₂ = (v₂.1, a0 m) := Prod.ext rfl (a0_unique m v₂.2)
  rw [← e1, ← e2, ← add_assoc, ← hs2, ← hs1]

/-! ## §4  The quadratic step -/

theorem xk_mul_mem_TF {w : ℕ}
    (IH : ∀ s, monoWt (latP m) s < w → Even (monoDeg (latP m) s) → monomial s (1 : ℂ) ∈ TF m hm)
    (p q : ℕ) (h : p + q + 2 < w) : xk m p * xk m q ∈ TF m hm := by
  rw [← monomial_two]
  exact IH _ (by rw [monoWt_two]; exact h) (by rw [monoDeg_two]; decide)

/-- Step A: `x_p x_q ≡ (−1)^p C(p+q,p) x₀ x_{p+q}` modulo `TF`. -/
theorem stepA {w : ℕ}
    (IH : ∀ s, monoWt (latP m) s < w → Even (monoDeg (latP m) s) → monomial s (1 : ℂ) ∈ TF m hm) :
    ∀ p q : ℕ, p + q + 2 = w →
      xk m p * xk m q - (((-1 : ℂ) ^ p * ((p + q).choose p : ℂ))) • (xk m 0 * xk m (p + q)) ∈ TF m hm := by
  intro p
  induction p with
  | zero =>
    intro q _
    simp only [pow_zero, Nat.choose_zero_right, Nat.cast_one, mul_one, one_smul, zero_add, sub_self]
    exact Submodule.zero_mem _
  | succ p ih =>
    intro q hq
    have h1 := TF_Dop m hm (xk_mul_mem_TF m hm IH p q (by omega))
    have h2 := ih (q + 1) (by omega)
    rw [show p + (q + 1) = p + 1 + q by ring] at h2
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, Dop_X, Dop_X] at h1
    have hc : ((p + 1 + q).choose (p + 1) : ℂ) * ((p : ℂ) + 1) =
        ((p + 1 + q).choose p : ℂ) * ((q : ℂ) + 1) := by
      have := Nat.choose_succ_right_eq (p + 1 + q) p
      rw [show p + 1 + q - p = q + 1 by omega] at this
      exact_mod_cast this
    have hp : ((p : ℂ) + 1) ≠ 0 := Nat.cast_add_one_ne_zero p
    have key : ((p : ℂ) + 1) • (xk m (p + 1) * xk m q - (((-1 : ℂ) ^ (p + 1) *
        ((p + 1 + q).choose (p + 1) : ℂ))) • (xk m 0 * xk m (p + 1 + q))) =
        (xk m p * (((q : ℂ) + 1) • X (q + 1, a0 m)) + xk m q * (((p : ℂ) + 1) • X (p + 1, a0 m))) -
          ((q : ℂ) + 1) • (xk m p * xk m (q + 1) - (((-1 : ℂ) ^ p * ((p + 1 + q).choose p : ℂ))) •
            (xk m 0 * xk m (p + 1 + q))) := by
      simp only [xk, mul_smul_comm]
      rw [pow_succ, mul_comm (X (q, a0 m)) (X (p + 1, a0 m))]
      linear_combination (norm := module) ((-1 : ℂ) ^ p * hc) • (X ((0 : ℕ), a0 m) * X (p + 1 + q, a0 m))
    have hmem : ((p : ℂ) + 1) • (xk m (p + 1) * xk m q - (((-1 : ℂ) ^ (p + 1) *
        ((p + 1 + q).choose (p + 1) : ℂ))) • (xk m 0 * xk m (p + 1 + q))) ∈ TF m hm := by
      rw [key]; exact Submodule.sub_mem _ h1 (Submodule.smul_mem _ _ h2)
    have := Submodule.smul_mem _ (((p : ℂ) + 1)⁻¹) hmem
    rwa [smul_smul, inv_mul_cancel₀ hp, one_smul] at this

theorem omega_poly_eq : (V2m m hm).conformalVector = latStateGen (latP m) ((1 / 2 : ℂ) • (xk m 0 * xk m 0)) 0 := by
  have := omegaLatGen_eq m hm
  change omegaLatGen (latP m) = _ at this
  change omegaLatGen (latP m) = _
  rw [this, wordStateLatGen_eq, latStateGen_csmul]
  simp [wordStateN_cons, latStateGen, TensorProduct.smul_tmul']

theorem eq_zero_of_monoDeg {s : (ℕ × Fin (rank (latP m))) →₀ ℕ} (h : monoDeg (latP m) s = 0) :
    s = 0 := by
  ext v
  by_contra hv
  unfold monoDeg Finsupp.sum at h
  exact hv (Finset.sum_eq_zero_iff.mp h v (Finsupp.mem_support_iff.mpr hv))

theorem monomial_mem_gradingWN (t : (ℕ × Fin (rank (latP m))) →₀ ℕ) (c : ℂ) :
    monomial t c ∈ gradingWN (rank (latP m)) (monoWt (latP m) t) := by
  rw [mem_gradingWN]
  convert isWeightedHomogeneous_monomial weightFnN t c rfl using 1
  rw [Finsupp.weight_apply, monoWt]
  refine Finsupp.sum_congr fun v _ => ?_
  simp [weightFnN, mul_comm]

/-- Step B, even weight `q + 4`: `x₀x_{q+2} ∈ TF`. -/
theorem stepB_even (q : ℕ)
    (IH : ∀ s, monoWt (latP m) s < q + 4 → Even (monoDeg (latP m) s) → monomial s (1 : ℂ) ∈ TF m hm) :
    xk m 0 * xk m (q + 2) ∈ TF m hm := by
  have hD := TF_DWop m hm (xk_mul_mem_TF m hm IH 0 q (by omega))
  have hA := stepA m hm IH 2 q (by omega)
  rw [show 2 + q = q + 2 by ring] at hA
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, DWop_X, DWop_X] at hD
  set cN : ℕ := 10 * (q + 1) * (q + 2) ^ 2 + 40 * (q + 2).choose 2 with hcN
  have hc0 : (cN : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by positivity)
  have key : (cN : ℂ) • (xk m 0 * xk m (q + 2)) =
      (xk m 0 * ((10 * ((q : ℂ) + 1) * ((q : ℂ) + 2) ^ 2) • X (q + 2, a0 m)) +
        xk m q * ((10 * (((0 : ℕ) : ℂ) + 1) * (((0 : ℕ) : ℂ) + 2) ^ 2) • X (0 + 2, a0 m))) -
        (40 : ℂ) • (xk m 2 * xk m q - (((-1 : ℂ) ^ 2 * ((q + 2).choose 2 : ℂ))) •
          (xk m 0 * xk m (q + 2))) := by
    simp only [xk, mul_smul_comm, smul_sub, smul_smul]
    rw [mul_comm (X (q, a0 m)) (X (0 + 2, a0 m)), hcN]
    push_cast
    module
  have hmem : (cN : ℂ) • (xk m 0 * xk m (q + 2)) ∈ TF m hm := by
    rw [key]; exact Submodule.sub_mem _ hD (Submodule.smul_mem _ _ hA)
  have := Submodule.smul_mem _ ((cN : ℂ)⁻¹) hmem
  rwa [smul_smul, inv_mul_cancel₀ hc0, one_smul] at this

/-- **The quadratic step.** -/
theorem quad_lemma {w : ℕ}
    (IH : ∀ s, monoWt (latP m) s < w → Even (monoDeg (latP m) s) → monomial s (1 : ℂ) ∈ TF m hm) :
    ∀ p q : ℕ, p + q + 2 = w → xk m p * xk m q ∈ TF m hm := by
  have hB : 2 ≤ w → xk m 0 * xk m (w - 2) ∈ TF m hm := by
    intro hw
    rcases Nat.even_or_odd w with hev | hodd
    · rcases (show w = 2 ∨ 4 ≤ w by obtain ⟨k, hk⟩ := hev; omega) with h2 | h4
      · subst h2
        have hω : (2 : ℂ) • ((1 / 2 : ℂ) • (xk m 0 * xk m 0)) ∈ TF m hm :=
          Submodule.smul_mem _ _ ⟨ωM m hm, ωM_mem_TM m hm, omega_poly_eq m hm⟩
        rw [smul_smul, show (2 : ℂ) * (1 / 2) = 1 by norm_num, one_smul] at hω
        exact hω
      · obtain ⟨q, rfl⟩ : ∃ q, w = q + 4 := ⟨w - 4, by omega⟩
        rw [show q + 4 - 2 = q + 2 by omega]
        exact stepB_even m hm q IH
    · have hA := stepA m hm IH (w - 2) 0 (by omega)
      rw [Nat.add_zero, Nat.choose_self, Nat.cast_one, mul_one,
        Odd.neg_one_pow (by obtain ⟨k, hk⟩ := hodd; exact ⟨k - 1, by omega⟩),
        mul_comm (xk m (w - 2)), neg_smul, one_smul, sub_neg_eq_add, ← two_smul ℂ] at hA
      have := Submodule.smul_mem _ (1 / 2 : ℂ) hA
      rwa [smul_smul, show (1 / 2 : ℂ) * 2 = 1 by norm_num, one_smul] at this
  intro p q hpq
  have hA := stepA m hm IH p q hpq
  have h0 := hB (by omega)
  rw [show w - 2 = p + q by omega] at h0
  have := Submodule.add_mem _ hA (Submodule.smul_mem _ (((-1 : ℂ) ^ p * ((p + q).choose p : ℂ))) h0)
  rwa [sub_add_cancel] at this

/-! ## §5  The induction -/

/-- **Every even monomial lies in `TF`.** -/
theorem monomial_mem_TF : ∀ (w : ℕ) (s : (ℕ × Fin (rank (latP m))) →₀ ℕ), monoWt (latP m) s = w →
    Even (monoDeg (latP m) s) → monomial s (1 : ℂ) ∈ TF m hm := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w IHw =>
  have IH : ∀ s, monoWt (latP m) s < w → Even (monoDeg (latP m) s) → monomial s (1 : ℂ) ∈ TF m hm :=
    fun s hs he => IHw _ hs s rfl he
  intro s
  induction hd : monoDeg (latP m) s using Nat.strong_induction_on generalizing s with
  | _ d IHd =>
  intro hsw hev
  rcases (show d = 0 ∨ d = 2 ∨ 4 ≤ d by obtain ⟨k, hk⟩ := hev; omega) with h0 | h2 | h4
  · have hs0 : s = 0 := eq_zero_of_monoDeg m (by omega)
    subst hs0
    rw [monomial_zero', C_1]
    exact one_mem_TF m hm
  · obtain ⟨i, j, s', rfl⟩ := exists_split m s (by omega)
    have hd' := hd
    rw [monoDeg_add, monoDeg_two] at hd'
    have hs' : s' = 0 := eq_zero_of_monoDeg m (by omega)
    subst hs'
    rw [zero_add, monomial_two]
    rw [monoWt_add, monoWt_two] at hsw
    exact quad_lemma m hm IH i j (by simp [monoWt] at hsw; omega)
  · obtain ⟨i, j, s', rfl⟩ := exists_split m s (by omega)
    have hds := hd
    rw [monoDeg_add, monoDeg_two] at hds
    have hws := hsw
    rw [monoWt_add, monoWt_two] at hws
    have hdw := monoDeg_le_monoWt (latP m) s'
    have hu : xk m i * xk m j ∈ TF m hm := xk_mul_mem_TF m hm IH i j (by omega)
    have hv : monomial s' (1 : ℂ) ∈ TF m hm :=
      IH s' (by omega) (by obtain ⟨k, hk⟩ := hev; exact ⟨k - 1, by omega⟩)
    obtain ⟨r, hrTF, hr, hrσ⟩ := TF_mul m hm hu hv
    have hlead := word_smul_neg_one_sub_mem_Fil (latP m) (latP_even m) (latP_posDef m hm)
      [(i, a0 m), (j, a0 m)] (monoDeg (latP m) s') 0 (monomial s' 1)
      (monomial_mem_FilF (latP m) s' 1 le_rfl)
    rw [wordStateLatGen_eq] at hlead
    obtain ⟨R, hR, hRe⟩ := hlead
    have hw2 : wordStateN [(i, a0 m), (j, a0 m)] = xk m i * xk m j := by simp [wordStateN_cons]
    rw [hw2, stateMap_apply] at hRe
    have hRe' : latStateGen (latP m) R 0 = latStateGen (latP m) r 0 -
        latStateGen (latP m) (xk m i * xk m j * monomial s' 1) 0 := by
      rw [hRe, ← hr]; unfold V2m; rfl
    have hRr : R = r - xk m i * xk m j * monomial s' 1 := by
      have := congrArg (coordEα (latP m) 0) hRe'
      rwa [map_sub, coordEα_latStateGen_zero, coordEα_latStateGen_zero,
        coordEα_latStateGen_zero] at this
    have hmono : monomial (s' + (Finsupp.single (i, a0 m) 1 + Finsupp.single (j, a0 m) 1)) (1 : ℂ) =
        xk m i * xk m j * monomial s' 1 := by
      rw [← monomial_two, monomial_mul, one_mul, add_comm]
    rw [hmono, show xk m i * xk m j * monomial s' 1 = r - R by rw [hRr]; ring]
    refine Submodule.sub_mem _ hrTF (mem_TF_of_support m hm fun t ht => ?_)
    have htne : coeff t R ≠ 0 := Finsupp.mem_support_iff.mp ht
    -- `R` is homogeneous of weight `w`
    have hrw : r ∈ gradingWN (rank (latP m)) w := by
      refine mem_gradingWN_of_lat m hm ?_
      rw [← hr]
      have h1 := latStateGen_mem_grading m hm (monomial_mem_gradingWN m s' 1)
      have h2 : xk m i * xk m j ∈ gradingWN (rank (latP m)) (i + j + 2) := by
        rw [← monomial_two, ← monoWt_two m i j]; exact monomial_mem_gradingWN m _ 1
      have h3 := (V2m m hm).smul_mem_grading (latStateGen_mem_grading m hm h2) h1 (-1)
      convert h3 using 2
      push_cast; omega
    have hxw : xk m i * xk m j * monomial s' 1 ∈ gradingWN (rank (latP m)) w := by
      rw [← hmono, ← hsw]; exact monomial_mem_gradingWN m _ 1
    have hRw : R ∈ gradingWN (rank (latP m)) w := by
      rw [hRr]; exact Submodule.sub_mem _ hrw hxw
    -- `R` is `σ`-even
    have hRσ : sigmaN (rank (latP m)) R = R := by
      have hd' : ((s' + (Finsupp.single (i, a0 m) 1 + Finsupp.single (j, a0 m) 1)).sum
          fun _ k => k) = d := hd
      rw [hRr, map_sub, hrσ, ← hmono, sigmaN_monomial', hd', Even.neg_one_pow hev, one_smul]
    have htw := coeff_gradingWN m hRw t htne
    have htd := coeff_FilF m hR t htne
    have hte := coeff_even m hRσ t htne
    simp only [List.length_cons, List.length_nil] at htd
    exact IHd (monoDeg (latP m) t) (by obtain ⟨a, ha⟩ := hte; obtain ⟨b, hb⟩ := hev; omega) t rfl htw hte

/-- **Strong generation of `M(1)⁺` by `ω` and `W⁴`** (Dong–Nagatomo 1999, Thm 2.7). -/
theorem strongGenM1_holds : StrongGenM1 m hm := by
  refine eq_top_iff.mpr fun v _ => ?_
  obtain ⟨q, hq, hvq⟩ := exists_fock m hm v
  have hqTF : q ∈ TF m hm := mem_TF_of_support m hm fun t ht =>
    monomial_mem_TF m hm _ t rfl (coeff_even m hq t (Finsupp.mem_support_iff.mp ht))
  obtain ⟨x, hx, hxq⟩ := hqTF
  have : v = x := Subtype.ext (by rw [hvq, hxq])
  rw [this]; exact hx

end PlusC2

