import VOA.Modules.ZhuModule
import VOA.Modules.FiniteGenerationProof

/-!
# Zero modes on lowest-weight vectors are polynomials in the generators

Let `φ : U → V` be a homomorphism of VOAs that respects the gradings, and let `U` be generated
(in the sense of `iterProdSpan`) by a family `g : ι → U` of homogeneous vectors of weight `≥ 2`.
For an ordinary `V`-module `N` with lowest weight `h` and a vector `x ∈ N_h` on which every
`o(φ gᵢ)` acts by a scalar `valᵢ`, Zhu's two identities

* `o(a ∗ b) = o(a) o(b)` on `N_h` (`oMod_zhuMul_lowest_all`), and
* `O(U) ↦ 0` on `N_h` (`O_le_ker_rhoLW`, with the Frenkel–Zhu residues `Pres_mem_O`),

reduce `o(φ a) x` for **every** `a ∈ U_w` to a polynomial in the `valᵢ`, of total degree
`≤ w/2`, **independent of the module**.  This is the engine behind the top-level analysis of
`V_{2m}⁺`-modules (`PlusUnitary*.lean`):

* with `U = M(1)⁺`, `g = (ω, W⁴)`: the eigenvalue of `o(E∗E)` on a top vector is a fixed polynomial
  `Φ(h, w)` of degree `≤ m`, which can then be found by interpolation on lattice modules;
* with `U = V_{2m}⁺`, `g = (ω, W⁴, E)`: a top vector with the vacuum's eigenvalues `(0,0,0)` sees
  every zero mode as on the vacuum.

## Main results
* `oMod_eq_zero_of_mem_O` — `O(V)` acts by zero on a lowest-weight space.
* `Good` / `goodSub` — "`o(φ a)` is a module-independent polynomial of the generator values".
* `good_of_iterProdSpan_eq_top` — every homogeneous `a` is `Good` when `U` is generated by
  `g` (and, more generally, by a homogeneous set `S` whose members are `Good` granted the
  lower weights: `good_of_iterProdSpan_eq_top'`, used with `S = IsIterProd g`).
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne.PlusUnitary

open VOA

universe u

variable {𝒰 𝒱 : Type u} [AddCommGroup 𝒰] [Module ℂ 𝒰] [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## `O(V)` acts by zero on a lowest-weight space -/

/-- **`O(V)` acts by zero on lowest-weight vectors.** -/
theorem oMod_eq_zero_of_mem_O {V : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M]
    [Module ℂ M] (N : OrdVModule V M) {h : ℂ} (hcw : IsLowestWeight N h) {y : 𝒱} (hy : y ∈ O V)
    {x : M} (hx : x ∈ N.weight h) : oMod N y x = 0 := by
  have hk := O_le_ker_rhoLW N hcw hy
  rw [LinearMap.mem_ker] at hk
  have h2 := congrArg (fun f : Module.End ℂ (N.weight h) => ((f ⟨x, hx⟩ : N.weight h) : M)) hk
  simpa [rhoLW_apply_coe] using h2

/-! ## Homogeneity of iterated products -/

theorem isIterProd_homog {U : VertexOperatorAlgebra 𝒰} {S : Set 𝒰}
    (hS : ∀ s ∈ S, ∃ k : ℤ, s ∈ U.grading k) {x : 𝒰} (hx : IsIterProd U S x) :
    ∃ k : ℤ, x ∈ U.grading k := by
  induction hx with
  | vacuum => exact ⟨0, U.vacuum_mem⟩
  | step s hs m _ x _ ih =>
    obtain ⟨k, hk⟩ := hS s hs
    obtain ⟨l, hl⟩ := ih
    exact ⟨_, U.smul_mem_grading hk hl (-m)⟩

/-- A vector in two different grading pieces is zero. -/
theorem eq_zero_of_mem_grading_ne {U : VertexOperatorAlgebra 𝒰} {k l : ℤ} (hkl : k ≠ l) {x : 𝒰}
    (hk : x ∈ U.grading k) (hl : x ∈ U.grading l) : x = 0 := by
  have := U.isInternal.submodule_iSupIndep.pairwiseDisjoint hkl
  exact (Submodule.disjoint_def.mp this) x hk hl

/-! ## The `Good` predicate -/

section Good

variable {U : VertexOperatorAlgebra 𝒰} {V : VertexOperatorAlgebra 𝒱} (φ : 𝒰 →ₗ[ℂ] 𝒱)
variable {ι : Type} (g : ι → 𝒰)

/-- `Good w a`: there is a polynomial `Φ` in the generator values, of total degree `≤ w/2`, such
that on every lowest-weight vector `x` on which each `o(φ gᵢ)` acts by `valᵢ`,
`o(φ a) x = Φ(val) x`. -/
def Good (w : ℤ) (a : 𝒰) : Prop :=
  ∃ Φ : MvPolynomial ι ℂ, 2 * Φ.totalDegree ≤ w.toNat ∧
    ∀ (M : Type u) [AddCommGroup M] [Module ℂ M] (N : OrdVModule V M) (h : ℂ),
      IsLowestWeight N h → ∀ x ∈ N.weight h, ∀ val : ι → ℂ,
        (∀ i, oMod N (φ (g i)) x = val i • x) → oMod N (φ a) x = MvPolynomial.eval val Φ • x

/-- `Good w` is a submodule. -/
def goodSub (w : ℤ) : Submodule ℂ 𝒰 where
  carrier := {a | Good (V := V) φ g w a}
  zero_mem' := ⟨0, by simp, fun M _ _ N h _ x _ val _ => by simp⟩
  add_mem' := by
    rintro a b ⟨Φ, hΦ, hΦa⟩ ⟨Ψ, hΨ, hΨb⟩
    refine ⟨Φ + Ψ, ?_, fun M _ _ N h hcw x hx val hval => ?_⟩
    · have := MvPolynomial.totalDegree_add Φ Ψ
      have : 2 * (Φ + Ψ).totalDegree ≤ 2 * max Φ.totalDegree Ψ.totalDegree := by omega
      rcases le_total Φ.totalDegree Ψ.totalDegree with h1 | h1
      · rw [max_eq_right h1] at this; omega
      · rw [max_eq_left h1] at this; omega
    · rw [map_add, map_add, LinearMap.add_apply, hΦa M N h hcw x hx val hval,
        hΨb M N h hcw x hx val hval, map_add, add_smul]
  smul_mem' := by
    rintro c a ⟨Φ, hΦ, hΦa⟩
    refine ⟨c • Φ, le_trans (by have := MvPolynomial.totalDegree_smul_le c Φ; omega) hΦ,
      fun M _ _ N h hcw x hx val hval => ?_⟩
    rw [map_smul, map_smul, LinearMap.smul_apply, hΦa M N h hcw x hx val hval, smul_smul,
      MvPolynomial.smul_eval]

theorem mem_goodSub {w : ℤ} {a : 𝒰} : a ∈ goodSub (V := V) φ g w ↔ Good (V := V) φ g w a :=
  Iff.rfl

theorem Good.mono {w w' : ℤ} (hw : w ≤ w') {a : 𝒰} (ha : Good (V := V) φ g w a) :
    Good (V := V) φ g w' a := by
  obtain ⟨Φ, hΦ, h⟩ := ha
  exact ⟨Φ, le_trans hΦ (by omega), h⟩

theorem good_zero (w : ℤ) : Good (V := V) φ g w 0 := (goodSub (V := V) φ g w).zero_mem

end Good

/-! ## The Zhu reduction step -/

section Step

variable {U : VertexOperatorAlgebra 𝒰} {V : VertexOperatorAlgebra 𝒱} {φ : 𝒰 →ₗ[ℂ] 𝒱}
variable {ι : Type} {g : ι → 𝒰}

/-- The structural hypotheses on `φ`: a VOA homomorphism respecting the gradings. -/
structure GradedHom (U : VertexOperatorAlgebra 𝒰) (V : VertexOperatorAlgebra 𝒱)
    (φ : 𝒰 →ₗ[ℂ] 𝒱) : Prop where
  map_vacuum : φ U.vacuum = V.vacuum
  map_smul : ∀ (a : 𝒰) (n : ℤ) (b : 𝒰), φ (U.smul a n b) = V.smul (φ a) n (φ b)
  map_grading : ∀ {n : ℤ} {a : 𝒰}, a ∈ U.grading n → φ a ∈ V.grading n

theorem GradedHom.map_zhuMul (hφ : GradedHom U V φ) {k : ℕ} {s : 𝒰}
    (hs : s ∈ U.grading (k : ℤ)) (y : 𝒰) : φ (zhuMul U s y) = zhuMul V (φ s) (φ y) := by
  rw [zhuMul_homogeneous U hs, zhuMul_homogeneous V (hφ.map_grading hs), map_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [LinearMap.map_smul]; exact congrArg _ (hφ.map_smul _ _ _)

theorem GradedHom.map_Pres (hφ : GradedHom U V φ) (k : ℕ) (s y : 𝒰) (n : ℕ) :
    φ (Pres U k s y n) = Pres V k (φ s) (φ y) n := by
  rw [Pres, Pres, map_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [LinearMap.map_smul]; exact congrArg _ (hφ.map_smul _ _ _)

/-- The weight-`0` piece is `Good` at weight `0`. -/
theorem good_of_mem_grading_zero (hφ : GradedHom U V φ) {a : 𝒰} (ha : a ∈ U.grading 0) :
    Good (V := V) φ g 0 a := by
  rw [U.vacuum_grade, Submodule.mem_span_singleton] at ha
  obtain ⟨c, rfl⟩ := ha
  refine ⟨MvPolynomial.C c, by rw [MvPolynomial.totalDegree_C]; omega,
    fun M _ _ N h _ x _ val _ => ?_⟩
  rw [map_smul, hφ.map_vacuum, map_smul, oMod_vacuum, MvPolynomial.eval_C]
  rfl

/-- **The Zhu reduction step.**  If `s ∈ U_k` and `y ∈ U_l` are `Good` at their weights, and every
vector of weight `< w = k + l + p − 1` is `Good`, then `s₍₋ₚ₎y` is `Good` at weight `w`. -/
theorem good_smul_neg (hφ : GradedHom U V φ) {k : ℕ} {l : ℤ} {s y : 𝒰}
    (hs : s ∈ U.grading (k : ℤ)) (hy : y ∈ U.grading l) (hl : 0 ≤ l)
    (hsG : Good (V := V) φ g k s) (hyG : Good (V := V) φ g l y) {p : ℤ} (hp : 1 ≤ p)
    (IH : ∀ w' : ℤ, w' < k + l + p - 1 → ∀ b ∈ U.grading w', Good (V := V) φ g w' b) :
    Good (V := V) φ g (k + l + p - 1) (U.smul s (-p) y) := by
  -- every `s₍ⱼ₎y` with `j > -p` is `Good` at weight `w`
  have hlow : ∀ j : ℤ, -p < j → U.smul s j y ∈ goodSub (V := V) φ g (k + l + p - 1) := by
    intro j hj
    have hmem := U.smul_mem_grading hs hy j
    exact (IH _ (by omega) _ hmem).mono _ _ (by omega)
  rcases eq_or_lt_of_le hp with rfl | hp2
  · -- `p = 1`: `s₍₋₁₎y = s ∗ y − Σ_{m ≥ 1} C(k,m) s₍ₘ₋₁₎y`
    have hz := zhuMul_homogeneous U hs y
    rw [show ((k : ℤ)).toNat = k by simp, Finset.sum_range_succ',
      show ((0 : ℕ) : ℤ) - 1 = -1 by norm_num] at hz
    have hc0 : cbz (k : ℤ) ((0 : ℕ) : ℤ) = 1 := by
      simp [cbz_apply_nonneg, gBinom]
    rw [hc0, one_smul] at hz
    have hsplit : U.smul s (-1) y = zhuMul U s y -
        ∑ i ∈ Finset.range k, cbz (k : ℤ) ((i + 1 : ℕ) : ℤ) • U.smul s (((i + 1 : ℕ) : ℤ) - 1) y := by
      rw [hz]; exact (add_sub_cancel_left _ _).symm
    rw [show (k : ℤ) + l + 1 - 1 = k + l by ring, show -(1 : ℤ) = -1 from rfl, hsplit]
    refine (goodSub (V := V) φ g (k + l)).sub_mem ?_ (Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ ?_)
    · -- the Zhu product
      obtain ⟨Φ, hΦ, hΦs⟩ := hsG
      obtain ⟨Ψ, hΨ, hΨy⟩ := hyG
      refine ⟨Φ * Ψ, ?_, fun M _ _ N h hcw x hx val hval => ?_⟩
      · have := MvPolynomial.totalDegree_mul Φ Ψ
        have h1 : ((k : ℤ)).toNat = k := by simp
        rw [h1] at hΦ
        have h2 : (l.toNat : ℤ) = l := Int.toNat_of_nonneg hl
        have h3 : ((k : ℤ) + l).toNat = k + l.toNat := by omega
        rw [h3]; omega
      · rw [hφ.map_zhuMul hs, oMod_zhuMul_lowest_all N hcw _ _ hx, hΨy M N h hcw x hx val hval,
          map_smul, hΦs M N h hcw x hx val hval, smul_smul, MvPolynomial.eval_mul, mul_comm]
    · have := hlow (((i + 1 : ℕ) : ℤ) - 1) (by push_cast; omega)
      rwa [show (k : ℤ) + l + 1 - 1 = k + l by ring] at this
  · -- `p = n + 2`: `s₍₋₂₋ₙ₎y = Pres − Σ_{i ≥ 1} C(k+n,i) s₍ᵢ₋₂₋ₙ₎y`
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, p = (n : ℤ) + 2 := ⟨(p - 2).toNat, by omega⟩
    have hP : Pres U k s y n = U.smul s (-((n : ℤ) + 2)) y +
        ∑ i ∈ Finset.range (k + n), cbz ((k : ℤ) + n) ((i + 1 : ℕ) : ℤ) •
          U.smul s (((i + 1 : ℕ) : ℤ) - 2 - n) y := by
      rw [Pres, Finset.sum_range_succ']
      have hc0 : cbz ((k : ℤ) + n) ((0 : ℕ) : ℤ) = 1 := by simp [cbz_apply_nonneg, gBinom]
      rw [hc0, one_smul, show ((0 : ℕ) : ℤ) - 2 - n = -((n : ℤ) + 2) by push_cast; ring,
        add_comm]
    have hsplit : U.smul s (-((n : ℤ) + 2)) y = Pres U k s y n -
        ∑ i ∈ Finset.range (k + n), cbz ((k : ℤ) + n) ((i + 1 : ℕ) : ℤ) •
          U.smul s (((i + 1 : ℕ) : ℤ) - 2 - n) y := by
      rw [hP]; exact (add_sub_cancel_right _ _).symm
    rw [hsplit]
    refine (goodSub (V := V) φ g _).sub_mem ?_ (Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ (hlow _ (by push_cast; omega)))
    refine ⟨0, by simp, fun M _ _ N h hcw x hx val _ => ?_⟩
    rw [hφ.map_Pres, oMod_eq_zero_of_mem_O N hcw (Pres_mem_O V (hφ.map_grading hs) _ n) hx]
    simp

end Step

/-! ## Propagation through iterated products -/

section Propagation

variable {U : VertexOperatorAlgebra 𝒰} {V : VertexOperatorAlgebra 𝒱} {φ : 𝒰 →ₗ[ℂ] 𝒱}
variable {ι : Type} {g : ι → 𝒰}

/-- Strong induction on `ℤ`, with every negative value granted. -/
theorem int_strong_ind (P : ℤ → Prop) (hneg : ∀ w : ℤ, w < 0 → P w)
    (h : ∀ w : ℤ, 0 ≤ w → (∀ w' : ℤ, w' < w → P w') → P w) : ∀ w, P w := by
  have key : ∀ n : ℕ, ∀ w : ℤ, w < n → P w := by
    intro n
    induction n with
    | zero => intro w hw; exact hneg w (by exact_mod_cast hw)
    | succ n ih =>
      intro w hw
      rcases lt_or_ge w 0 with hw0 | hw0
      · exact hneg w hw0
      · exact h w hw0 fun w' hw' => ih w' (by push_cast at hw; omega)
  exact fun w => key (w.toNat + 1) w (by omega)

/-- **The inner (structural) induction.**  Let `S` be a set of vectors each of which is `Good` at
its weight once all lower weights are.  Then the same holds for every iterated product of `S`. -/
theorem good_of_isIterProd (hφ : GradedHom U V φ) {S : Set 𝒰}
    (hShom : ∀ s ∈ S, ∃ k : ℕ, s ∈ U.grading (k : ℤ))
    (hS : ∀ s ∈ S, ∀ k : ℕ, s ∈ U.grading (k : ℤ) →
      (∀ w' : ℤ, w' < k → ∀ b ∈ U.grading w', Good (V := V) φ g w' b) → Good (V := V) φ g k s)
    {x : 𝒰} (hx : IsIterProd U S x) :
    ∀ w : ℤ, x ∈ U.grading w →
      (∀ w' : ℤ, w' < w → ∀ b ∈ U.grading w', Good (V := V) φ g w' b) → Good (V := V) φ g w x := by
  induction hx with
  | vacuum =>
    intro w hw _
    by_cases h0 : w = 0
    · subst h0; exact good_of_mem_grading_zero hφ U.vacuum_mem
    · rw [eq_zero_of_mem_grading_ne (Ne.symm h0) U.vacuum_mem hw]; exact good_zero φ g w
  | step s hs p hp y hy ih =>
    intro w hw IH
    obtain ⟨k, hk⟩ := hShom s hs
    obtain ⟨l, hl⟩ := isIterProd_homog (fun s hs => let ⟨k, hk⟩ := hShom s hs; ⟨(k : ℤ), hk⟩) hy
    have hmem := U.smul_mem_grading hk hl (-p)
    by_cases hw' : w = (k : ℤ) + l + p - 1
    swap
    · rw [eq_zero_of_mem_grading_ne (by omega) hmem hw]; exact good_zero φ g w
    subst hw'
    -- `l ≥ 0` unless `y = 0`
    by_cases hl0 : 0 ≤ l
    swap
    · rw [show y = 0 by rw [U.positivity l (by omega), Submodule.mem_bot] at hl; exact hl,
        U.smul_zero_right]
      exact good_zero φ g _
    have hyG : Good (V := V) φ g l y := ih l hl fun w' hw' b hb => IH w' (by omega) b hb
    have hsG : Good (V := V) φ g k s := by
      rcases lt_or_eq_of_le (show (k : ℤ) ≤ k + l + p - 1 by omega) with hlt | heq
      · exact IH k hlt s hk
      · exact hS s hs k hk fun w' hw' b hb => IH w' (by omega) b hb
    exact good_smul_neg hφ hk hl hl0 hsG hyG hp IH

/-- **Propagation, general form.**  If `U = iterProdSpan U S` with `S` as in
`good_of_isIterProd`, then every vector of `U_w` is `Good` at weight `w`. -/
theorem good_of_iterProdSpan_eq_top' (hφ : GradedHom U V φ) {S : Set 𝒰}
    (hShom : ∀ s ∈ S, ∃ k : ℕ, s ∈ U.grading (k : ℤ))
    (hS : ∀ s ∈ S, ∀ k : ℕ, s ∈ U.grading (k : ℤ) →
      (∀ w' : ℤ, w' < k → ∀ b ∈ U.grading w', Good (V := V) φ g w' b) → Good (V := V) φ g k s)
    (htop : iterProdSpan U S = ⊤) :
    ∀ w : ℤ, ∀ a ∈ U.grading w, Good (V := V) φ g w a := by
  refine int_strong_ind _ (fun w hw a ha => ?_) (fun w _ IH => ?_)
  · rw [show a = 0 by rw [U.positivity w hw, Submodule.mem_bot] at ha; exact ha]
    exact good_zero φ g w
  intro a ha
  -- `a = π_w a`, and `π_w` maps the iterated products into `goodSub w`
  have hspan : a ∈ Submodule.span ℂ {x | IsIterProd U S x} := by
    change a ∈ iterProdSpan U S; rw [htop]; trivial
  have hpi : piHom U w a ∈ goodSub (V := V) φ g w := by
    refine Submodule.span_induction (p := fun a _ => piHom U w a ∈ goodSub (V := V) φ g w)
      ?_ ?_ ?_ ?_ hspan
    · intro x hx
      obtain ⟨k, hk⟩ := isIterProd_homog (fun s hs => let ⟨k, hk⟩ := hShom s hs; ⟨(k : ℤ), hk⟩) hx
      by_cases hkw : k = w
      · subst hkw
        rw [piHom_of_mem U hk]
        exact good_of_isIterProd hφ hShom hS hx k hk fun w' hw' b hb => IH w' hw' b hb
      · rw [piHom_of_mem_ne U (Ne.symm hkw |>.symm) hk]; exact good_zero φ g w
    · simp only [map_zero]; exact good_zero φ g w
    · intro x y _ _ hx hy; simp only [map_add]; exact Submodule.add_mem _ hx hy
    · intro c x _ hx; simp only [map_smul]; exact Submodule.smul_mem _ c hx
  rwa [piHom_of_mem U ha] at hpi

/-- **Propagation from generators.**  If `U` is generated by the homogeneous family `g`
(weights `≥ 2`), every vector of `U_w` is `Good` at weight `w`. -/
theorem good_of_iterProdSpan_eq_top (hφ : GradedHom U V φ) (wt : ι → ℕ)
    (hg : ∀ i, g i ∈ U.grading (wt i : ℤ)) (hwt : ∀ i, 2 ≤ wt i)
    (htop : iterProdSpan U (Set.range g) = ⊤) :
    ∀ w : ℤ, ∀ a ∈ U.grading w, Good (V := V) φ g w a := by
  refine good_of_iterProdSpan_eq_top' hφ ?_ ?_ htop
  · rintro _ ⟨i, rfl⟩; exact ⟨wt i, hg i⟩
  · rintro _ ⟨i, rfl⟩ k hk _
    by_cases hki : k = wt i
    · subst hki
      refine ⟨MvPolynomial.X i, ?_, fun M _ _ N h _ x _ val hval => ?_⟩
      · rw [MvPolynomial.totalDegree_X]; have := hwt i; simp; omega
      · rw [hval i, MvPolynomial.eval_X]
    · rw [eq_zero_of_mem_grading_ne (by exact_mod_cast hki) hk (hg i)]; exact good_zero φ g k

/-- **Propagation from generators modulo `C₂`.**  If the iterated products of the homogeneous
family `g` (weights `≥ 2`) span `U` modulo `O₂(U) = C₂(U)`, every vector of `U_w` is `Good` at
weight `w`.  (Via the finite-generation theorem `iterProdSpan_eq_top`.) -/
theorem good_of_top_eq (hφ : GradedHom U V φ) (wt : ι → ℕ)
    (hg : ∀ i, g i ∈ U.grading (wt i : ℤ)) (hwt : ∀ i, 2 ≤ wt i)
    (htop : (⊤ : Submodule ℂ 𝒰) = Submodule.span ℂ {x | IsIterProd U (Set.range g) x} ⊔ O₂ U) :
    ∀ w : ℤ, ∀ a ∈ U.grading w, Good (V := V) φ g w a := by
  have hGhom : ∀ s ∈ Set.range g, ∃ k : ℕ, s ∈ U.grading (k : ℤ) := by
    rintro _ ⟨i, rfl⟩; exact ⟨wt i, hg i⟩
  have hGgood : ∀ s ∈ Set.range g, ∀ k : ℕ, s ∈ U.grading (k : ℤ) →
      (∀ w' : ℤ, w' < k → ∀ b ∈ U.grading w', Good (V := V) φ g w' b) → Good (V := V) φ g k s := by
    rintro _ ⟨i, rfl⟩ k hk _
    by_cases hki : k = wt i
    · subst hki
      refine ⟨MvPolynomial.X i, ?_, fun M _ _ N h _ x _ val hval => ?_⟩
      · rw [MvPolynomial.totalDegree_X]; have := hwt i; simp; omega
      · rw [hval i, MvPolynomial.eval_X]
    · rw [eq_zero_of_mem_grading_ne (by exact_mod_cast hki) hk (hg i)]; exact good_zero φ g k
  set S := {x | IsIterProd U (Set.range g) x}
  have hShom : ∀ s ∈ S, ∃ k : ℕ, s ∈ U.grading (k : ℤ) := by
    intro s hs
    obtain ⟨k, hk⟩ := isIterProd_homog (fun s hs => let ⟨k, hk⟩ := hGhom s hs; ⟨(k : ℤ), hk⟩) hs
    rcases lt_or_ge k 0 with hk0 | hk0
    · have hs0 : s = 0 := by rw [U.positivity k hk0, Submodule.mem_bot] at hk; exact hk
      exact ⟨0, hs0 ▸ Submodule.zero_mem _⟩
    · exact ⟨k.toNat, by rwa [Int.toNat_of_nonneg hk0]⟩
  have htopS : iterProdSpan U S = ⊤ :=
    iterProdSpan_eq_top U S (fun s hs => let ⟨k, hk⟩ := hShom s hs; ⟨(k : ℤ), hk⟩) htop
  exact good_of_iterProdSpan_eq_top' hφ hShom
    (fun s hs k hk IH => good_of_isIterProd hφ hGhom hGgood hs k hk IH) htopS

end Propagation

end VOA.Classification.COne.PlusUnitary
