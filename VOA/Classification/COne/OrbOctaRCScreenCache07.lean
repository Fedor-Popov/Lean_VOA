theorem sc1141_check :
    reduceTwo (prependC 3 sc435 ++ scaleR (-1) (prependC 0 sc438)) = sc1141 := by
  decide +kernel

theorem sc1141_sound {r : ℕ} (a : Fin r) (c : ℂ)
