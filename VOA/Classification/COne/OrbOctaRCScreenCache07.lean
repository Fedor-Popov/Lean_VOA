    evRc a c sc1141 = evRc a c (expWordR [3, 3, 5] (4)) := by
  rw [← sc1141_check]
  exact expTwo_step _ _ hc 2 [3, 5] (4)
    sc435 sc438 (sc435_sound a c hc) (sc438_sound a c hc)

