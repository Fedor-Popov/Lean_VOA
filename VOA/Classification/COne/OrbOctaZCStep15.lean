set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step32_check :
    equalRelCheck (scaleRel weight_sing32 sing32 ++ partial31)
      partial32 = true := by decide +kernel

theorem partial32_holds : evalRel W selfMode partial32 = 0 := by
  have h := equalRelCheck_sound W selfMode step32_check
  rw [evalRel_append, evalRel_scale, sing32_holds, map_zero, partial31_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
