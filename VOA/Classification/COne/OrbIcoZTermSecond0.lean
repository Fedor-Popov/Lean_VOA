import VOA.Classification.COne.OrbIcoZDetFirst

/-! One bounded determinant cofactor product. -/
set_option Elab.async false
set_option maxSynthPendingDepth 3
set_option maxRecDepth 100000
set_option linter.style.longLine false
noncomputable section
namespace VOA.Classification.COne.OrbIcoZ
open VOA OrbOdd OrbZhu Polynomial OrbIco

def detTermSecond0 : PL := [mkRat (0) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1]

set_option maxHeartbeats 8000000 in
-- One product only: avoid retaining the full determinant calculation in one reduction.
theorem detTermSecond0_check :
    ptrim (paddL (pscaleL (-1) (pmulL matrixEntry9_0 commonMinor0)) (pscaleL (-1) detTermSecond0)) = [] := by
  decide +kernel

theorem detTermSecond0_sound : zp detTermSecond0 =
    -(zp matrixEntry9_0 * zp commonMinor0) := by
  have hh := (zp_eq_of_trim detTermSecond0_check).symm
  simpa [zp_pscaleL, zp_pmulL] using hh

end VOA.Classification.COne.OrbIcoZ
