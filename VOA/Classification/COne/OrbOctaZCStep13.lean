set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step28_check :
    equalRelCheck (scaleRel weight_sing28 sing28 ++ partial27)
      partial28 = true := by decide +kernel

theorem partial28_holds : evalRel W selfMode partial28 = 0 := by
  have h := equalRelCheck_sound W selfMode step28_check
  rw [evalRel_append, evalRel_scale, sing28_holds, map_zero, partial27_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
