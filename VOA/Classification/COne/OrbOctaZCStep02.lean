-- One row is added, and all equal mode indices are merged.
theorem step6_check :
    equalRelCheck (scaleRel weight_circle1 circle1 ++ partial5)
      partial6 = true := by decide +kernel

theorem partial6_holds : evalRel W selfMode partial6 = 0 := by
  have h := equalRelCheck_sound W selfMode step6_check
  rw [evalRel_append, evalRel_scale, circle1_holds, map_zero, partial5_holds,
    add_zero] at h
  exact h.symm

