import VOA.Classification.COne.PlusSplitZhuGeneration

/-! # A finite, explicit reduction target for the sharp plus Zhu bound

Dong--Nagatomo, arXiv:math/9807168, Propositions 5.9--5.11, give three
normal-form lists. We use W in place of J (J = 4 omega² + 4/5 omega - 9/10 W).
`V2mPlusZhuNormalFormReductions` is OPEN: it asks for each of the three
generators times each listed monomial to reduce to the same list. The proof
below derives spanning and the m+7 bound from precisely those finitely many
reductions and the independently proved generator theorem.
-/
set_option maxSynthPendingDepth 3
noncomputable section
namespace VOA.Classification.COne.PlusZhuNormalForms

section Algebra
variable {K R I G : Type*} [Field K] [Ring R] [Algebra K R]

/-- A linear span containing 1 and stable under left generator multiplication
contains the algebra generated by those generators. -/
theorem span_eq_top_of_reductions (g : G → R) (b : I → R)
    (hgen : Algebra.adjoin K (Set.range g) = ⊤)
    (h1 : 1 ∈ Submodule.span K (Set.range b))
    (hred : ∀ i j, g i * b j ∈ Submodule.span K (Set.range b)) :
    Submodule.span K (Set.range b) = ⊤ := by
  let S := Submodule.span K (Set.range b)
  have hmul : ∀ i, ∀ y ∈ S, g i * y ∈ S := by
    intro i y hy
    induction hy using Submodule.span_induction with
    | mem y hy => obtain ⟨j, rfl⟩ := hy; exact hred i j
    | zero => simp only [mul_zero]; exact S.zero_mem
    | add y z _ _ hy hz => simpa [mul_add] using S.add_mem hy hz
    | smul c y _ hy => simpa [mul_smul_comm] using S.smul_mem c hy
  have hall : ∀ x ∈ Algebra.adjoin K (Set.range g), ∀ y ∈ S, x*y ∈ S := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => obtain ⟨i, rfl⟩ := hx; exact hmul i
    | algebraMap c =>
      intro y hy
      simpa only [Algebra.smul_def] using S.smul_mem c hy
    | add x z _ _ hx hz =>
      intro y hy
      simpa [add_mul] using S.add_mem (hx y hy) (hz y hy)
    | mul x z _ _ hx hz =>
      intro y hy
      simpa [mul_assoc] using hx (z*y) (hz y hy)
  apply top_unique
  intro x _
  have hx : x ∈ Algebra.adjoin K (Set.range g) := by rw [hgen]; trivial
  simpa using hall x hx 1 h1

theorem finrank_le_of_reductions [Fintype I] (g : G → R) (b : I → R)
    (hgen : Algebra.adjoin K (Set.range g) = ⊤)
    (h1 : 1 ∈ Submodule.span K (Set.range b))
    (hred : ∀ i j, g i * b j ∈ Submodule.span K (Set.range b)) :
    Module.finrank K R ≤ Fintype.card I := by
  have h := finrank_range_le_card (R := K) b
  change Module.finrank K (Submodule.span K (Set.range b)) ≤ _ at h
  rwa [span_eq_top_of_reductions g b hgen h1 hred, finrank_top] at h
end Algebra

/-- Number of extra W monomials: 0 for nonsquares, 3 for even squares,
1 for odd squares. -/
def wCount (m : ℕ) : ℕ :=
  if IsSquare m then if Even (Nat.sqrt m) then 3 else 1 else 0

def omegaCount (m : ℕ) : ℕ := m + 4 - wCount m
abbrev Index (m : ℕ) := Fin (omegaCount m) ⊕ (Fin (wCount m) ⊕ Fin 3)

theorem wCount_le (m : ℕ) : wCount m ≤ 3 := by
  unfold wCount
  split
  · split <;> omega
  · omega

theorem omegaCount_pos (m : ℕ) : 0 < omegaCount m := by
  have := wCount_le m; unfold omegaCount; omega

theorem card_index (m : ℕ) : Fintype.card (Index m) = m + 7 := by
  have := wCount_le m
  unfold Index
  rw [Fintype.card_sum, Fintype.card_sum]
  rw [Fintype.card_fin, Fintype.card_fin, Fintype.card_fin]
  unfold omegaCount
  omega

variable (m : ℕ) (hm : 1 ≤ m)
@[reducible] local instance zhuRing : Ring (VOA.A (V2mPlus m hm)) := instRingA _
@[reducible] local instance zhuAlgebra : Algebra ℂ (VOA.A (V2mPlus m hm)) := instAlgebraA _

/-- The same generators as the quotient-generation theorem. -/
def generator (i : Fin 3) : VOA.A (V2mPlus m hm) :=
  VOA.mk (V2mPlus m hm) (PlusUnitary.gP m hm i)

/-- Pure omega powers, then omega powers times W, then E, omega E, omega² E. -/
def monomial : Index m → VOA.A (V2mPlus m hm)
  | .inl i => generator m hm 0 ^ i.val
  | .inr (.inl i) => generator m hm 0 ^ i.val * generator m hm 1
  | .inr (.inr i) => generator m hm 0 ^ i.val * generator m hm 2

theorem one_mem_span : 1 ∈ Submodule.span ℂ (Set.range (monomial m hm)) := by
  apply Submodule.subset_span
  exact ⟨.inl ⟨0, omegaCount_pos m⟩, pow_zero _⟩

end VOA.Classification.COne.PlusZhuNormalForms

namespace VOA.Classification.COne
open PlusZhuNormalForms

/-- OPEN: the exact finite reduction obligations on the genuine Zhu quotient.
There are 3*(m+7) membership identities at each m, with the monomials fixed
above. No dimension or semisimplicity conclusion is part of this input. -/
def V2mPlusZhuNormalFormReductions : Prop :=
  ∀ (m : ℕ) (hm : 1 ≤ m), 2 ≤ m →
    letI := instRingA (V2mPlus m hm)
    letI := instAlgebraA (V2mPlus m hm)
    ∀ (i : Fin 3) (j : Index m),
      generator m hm i * monomial m hm j ∈ Submodule.span ℂ (Set.range (monomial m hm))

theorem zhuDimensionBound_of_normalFormReductions
    (hred : V2mPlusZhuNormalFormReductions) : V2mPlusZhuDimensionBound := by
  intro m hm hm2
  letI := instRingA (V2mPlus m hm)
  letI := instAlgebraA (V2mPlus m hm)
  have h := finrank_le_of_reductions (generator m hm) (monomial m hm)
    (V2mPlus_zhu_adjoin_generators m hm hm2) (one_mem_span m hm) (hred m hm hm2)
  simpa only [card_index] using h

end VOA.Classification.COne
