import VOA.Classification.COne.VirasoroCOne
import VOA.Examples.VirasoroVermaSingularEmbedding
import VOA.Examples.VirasoroSingularUniqueness

/-!
# I1b: the Feigin–Fuchs `c = 1` degenerate characters, as a sharp reduction

`VirC1DegenerateCharacters` (`VirasoroCOne.lean`) says `η · ch L(1, μ²) = q^{μ²} - q^{(μ+1)²}`,
i.e. `dim L(1, μ²)_n = p(n) - p(n - 2μ - 1)`. Since `dim L(c,h)_n + dim (rad M(c,h))_n = p(n)`
(`vermaSimpleLevel_finrank_add_radicalLevel`), this is a statement about the level-`n` part of the
contravariant radical of the Verma module `M(1, μ²)`: it has dimension exactly `p(n - 2μ - 1)`.

## What is proved here (no hypotheses)

* `vermaGramMatrix_one_sq_det_eq_zero`: at `c = 1`, `h = μ²` the level-`(2μ+1)` Gram
  determinant vanishes (Kac factor `(r,s) = (2μ+1, 1)`, via the unconditional
  `kac_determinant_eval` at `t = 1`).
* `exists_c1_singular`: hence an actual nonzero **singular vector** at level `2μ + 1` at the real
  parameter `t = 1` (no screening/limiting argument: a radical vector at the first degenerate level
  is killed by `L₁, L₂` because all lower levels are non-degenerate).
* `card_le_finrank_vermaRadicalLevel_one_sq`: **upper bound on the character.** The singular vector
  generates an embedded copy of `M(1, (μ+1)²)` inside the radical, so
  `p(m) ≤ dim rad_{2μ+1+m}`, i.e. `dim L(1, μ²)_n ≤ p(n) - p(n - 2μ - 1)` for every `n`.
* `finrank_vermaRadicalLevel_one_sq_first`: at the first singular level the radical is exactly
  one-dimensional (singular-vector uniqueness), so the formula holds at `n = 2μ + 1` as well.
* `virC1DegenerateCharacters_iff`: **the reduction.** `VirC1DegenerateCharacters` is *equivalent*
  to the radical bound `VirC1RadicalLevelBound` (`dim rad_{2μ+1+m} ≤ p(m)`), the lower-bound half.
* `virC1RadicalLevelBound_of_maximalSubmodule`: the textbook Feigin–Fuchs statement
  `VirC1MaximalSubmoduleSingular` (the maximal proper submodule of `M(1, μ²)` is generated by the
  level-`(2μ+1)` singular vector) implies the radical bound.

## What remains (named, open)

* `VirC1RadicalLevelBound` — the character *lower* bound. It does not follow from determinant
  orders alone: the level-`n` Kac determinant vanishes at `h = μ²` to order
  `2 Σ_{k ≥ 1} p(n - k(2μ + k))` (for `μ ≥ 1`), strictly more than `p(n - 2μ - 1)`, because the two
  Kac curves `h_{2μ+1,1}` and `h_{1,2μ+1}` cross at `(c, h) = (1, μ²)`. A proof needs either the
  Feigin–Fuchs determinant of the quotient `M(μ²)/M((μ+1)²)` along the curve `h = h_{2μ+1,1}(t)`,
  a Jantzen filtration argument, or the `sl₂ × Vir` decomposition of `V_{A₁}`.
-/

open PowerSeries Finset

noncomputable section

namespace VOA.Classification.COne

open VOA.InverseDS.VirasoroVerma VOA.VirasoroScreening VOA.VirModule
open scoped Classical

/-! ## The level-`n` radical and the dimension balance -/

/-- The level-`n` part of the contravariant radical of the Verma module `M(c, h)`. -/
def vermaRadicalLevel (c h : ℂ) (n : ℕ) : Submodule ℂ (Verma c h) :=
  sortedSpan c h n ⊓ vermaRadical c h

instance (c h : ℂ) (n : ℕ) : FiniteDimensional ℂ (sortedSpan c h n) :=
  Module.Finite.of_basis (vermaLevelBasis c h n)

/-- `dim L(c,h)_n + dim rad_n = p(n)`. -/
theorem vermaSimpleLevel_finrank_add_radicalLevel (c h : ℂ) (n : ℕ) :
    Module.finrank ℂ (vermaSimpleLevel c h n) + Module.finrank ℂ (vermaRadicalLevel c h n) =
      Fintype.card (VermaPartitions n) := by
  have hf := LinearMap.finrank_range_add_finrank_ker
    ((vermaRadical c h).mkQ.domRestrict (sortedSpan c h n))
  rw [LinearMap.range_domRestrict, LinearMap.ker_domRestrict, Submodule.ker_mkQ,
    vermaLevel_finrank] at hf
  rw [vermaRadicalLevel, ← Submodule.map_comap_subtype, Submodule.finrank_map_subtype_eq]
  exact hf

instance (c h : ℂ) (n : ℕ) : FiniteDimensional ℂ (vermaRadicalLevel c h n) :=
  Submodule.finiteDimensional_inf_left _ _

/-! ## The singular vector at level `2μ + 1` at the real parameter `t = 1` -/

/-- At `c = 1`, `h = μ²`, the level-`(2μ+1)` Gram determinant vanishes: the Kac factor of the
label `(2μ+1, 1)` is `(h - μ²)^{p(0)}`. -/
theorem vermaGramMatrix_one_sq_det_eq_zero (μ : ℕ) :
    (vermaGramMatrix 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1)).det = 0 := by
  rw [← vermaBSACharge_one, kac_determinant_eval 1 one_ne_zero]
  apply mul_eq_zero_of_right
  rw [kacWeightProduct, Polynomial.eval_prod]
  refine Finset.prod_eq_zero
    (i := ((⟨2 * μ, by omega⟩ : Fin (2 * μ + 1)), (⟨0, by omega⟩ : Fin (2 * μ + 1)))) ?_ ?_
  · simp [kacLabels]
  · rw [Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    refine (pow_eq_zero_iff ?_).mpr (sub_eq_zero.mpr ?_)
    · refine (Fintype.card_pos_iff.mpr ⟨⟨[], sortedWord_nil, ?_⟩⟩).ne'
      simp [energyHW]
    · rw [fusionKacWeight]
      push_cast
      ring

/-- **An actual singular vector at `t = 1`.** `M(1, μ²)` has a nonzero vector at level `2μ + 1`
killed by `L₁` and `L₂`. -/
theorem exists_c1_singular (μ : ℕ) :
    ∃ w : Verma 1 ((μ ^ 2 : ℕ) : ℂ), w ∈ sortedSpan 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1) ∧ w ≠ 0 ∧
      vermaMode 1 ((μ ^ 2 : ℕ) : ℂ) 1 w = 0 ∧ vermaMode 1 ((μ ^ 2 : ℕ) : ℂ) 2 w = 0 := by
  obtain ⟨a, ha, hker⟩ :=
    Matrix.exists_mulVec_eq_zero_iff.mpr (vermaGramMatrix_one_sq_det_eq_zero μ)
  set w := vermaLevelState 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1) a with hwdef
  have hw : w ∈ sortedSpan 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1) := vermaLevelState_mem 1 _ _ a
  have hrad : vermaContravariant 1 _ w = 0 :=
    (vermaGramMatrix_kernel_iff_radical 1 _ _ a).mp hker
  refine ⟨w, hw, fun h => ha ((vermaLevelState_eq_zero_iff _ _ _ a).mp h), ?_, ?_⟩
  · exact verma_radical_zero_of_det_ne_zero 1 _ (2 * μ)
      (vermaGramMatrix_one_sq_det_ne_zero μ le_rfl) _
      (verma_mode_mem_level 1 _ (2 * μ + 1) (2 * μ) w hw 1 (by push_cast; ring))
      (vermaContravariant_radical_mode 1 _ 1 w hrad)
  · rcases Nat.eq_zero_or_pos μ with h0 | hμ
    · subst h0
      exact verma_mode_above_level 1 _ _ w hw 2 (by norm_num)
    · exact verma_radical_zero_of_det_ne_zero 1 _ (2 * μ - 1)
        (vermaGramMatrix_one_sq_det_ne_zero μ (by omega)) _
        (verma_mode_mem_level 1 _ (2 * μ + 1) (2 * μ - 1) w hw 2 (by omega))
        (vermaContravariant_radical_mode 1 _ 2 w hrad)

/-- The embedded singular Verma module lies in the radical. -/
theorem vermaSingularMap_mem_radical (c h : ℂ) (n : ℕ) (hn : 0 < n) (v : Verma c h)
    (hv : v ∈ sortedSpan c h n)
    (h1 : vermaMode c h 1 v = 0) (h2 : vermaMode c h 2 v = 0) (u : Verma c (h + (n : ℂ))) :
    vermaSingularMap c h n v hv h1 h2 u ∈ vermaRadical c h := by
  have hrad := vermaContravariant_singular_radical c h n hn v hv h1 h2
  have hzero : (vermaRadical c h).mkQ ∘ₗ vermaSingularMap c h n v hv h1 h2 = 0 := by
    refine (vermaSortedBasis c (h + (n : ℂ))).ext fun w => ?_
    have hw : vermaSingularMap c h n v hv h1 h2 (vermaSortedBasis c (h + (n : ℂ)) w) =
        vermaDescendant c h w.val v := by
      rw [vermaSortedBasis_apply]
      exact verma_universalMap_word c h _ v _ w.val
    rw [LinearMap.comp_apply, hw, LinearMap.zero_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    exact vermaDescendant_radical c h w.val v hrad
  have := LinearMap.congr_fun hzero u
  rwa [LinearMap.comp_apply, LinearMap.zero_apply, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero] at this

/-! ## The upper bound on `dim L(1, μ²)_n` -/

/-- **Character upper bound.** `p(m) ≤ dim rad_{2μ+1+m}` in `M(1, μ²)`; equivalently
`dim L(1, μ²)_n ≤ p(n) - p(n - 2μ - 1)`. -/
theorem card_le_finrank_vermaRadicalLevel_one_sq (μ m : ℕ) :
    Fintype.card (VermaPartitions m) ≤
      Module.finrank ℂ (vermaRadicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + m)) := by
  obtain ⟨w, hw, hne, h1, h2⟩ := exists_c1_singular μ
  rw [← vermaSingularMap_level_finrank 1 _ (2 * μ + 1) m w hw hne h1 h2]
  apply Submodule.finrank_mono
  rintro _ ⟨u, hu, rfl⟩
  exact ⟨(vermaSingularMap_mem_level_iff 1 _ (2 * μ + 1) m w hw hne h1 h2 u).mpr hu,
    vermaSingularMap_mem_radical 1 _ (2 * μ + 1) (by omega) w hw h1 h2 u⟩

/-- The same bound, read on the irreducible quotient. -/
theorem finrank_vermaSimpleLevel_one_sq_add_le (μ m : ℕ) :
    Module.finrank ℂ (vermaSimpleLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + m)) +
      Fintype.card (VermaPartitions m) ≤ Fintype.card (VermaPartitions (2 * μ + 1 + m)) := by
  have := vermaSimpleLevel_finrank_add_radicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + m)
  have := card_le_finrank_vermaRadicalLevel_one_sq μ m
  omega

/-- **The first singular level is exact.** The radical of `M(1, μ²)` at level `2μ + 1` is the line
of the singular vector (uniqueness of singular vectors). -/
theorem finrank_vermaRadicalLevel_one_sq_first (μ : ℕ) :
    Module.finrank ℂ (vermaRadicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1)) = 1 := by
  obtain ⟨w, hw, hne, h1, h2⟩ := exists_c1_singular μ
  apply le_antisymm
  · have hle : vermaRadicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1) ≤ ℂ ∙ w := by
      rintro v ⟨hv, hvr⟩
      have hv1 : vermaMode 1 _ 1 v = 0 :=
        verma_radical_zero_of_det_ne_zero 1 _ (2 * μ)
          (vermaGramMatrix_one_sq_det_ne_zero μ le_rfl) _
          (verma_mode_mem_level 1 _ (2 * μ + 1) (2 * μ) v hv 1 (by push_cast; ring))
          (vermaContravariant_radical_mode 1 _ 1 v hvr)
      have hv2 : vermaMode 1 _ 2 v = 0 := by
        rcases Nat.eq_zero_or_pos μ with h0 | hμ
        · subst h0
          exact verma_mode_above_level 1 _ _ v hv 2 (by norm_num)
        · exact verma_radical_zero_of_det_ne_zero 1 _ (2 * μ - 1)
            (vermaGramMatrix_one_sq_det_ne_zero μ (by omega)) _
            (verma_mode_mem_level 1 _ (2 * μ + 1) (2 * μ - 1) v hv 2 (by omega))
            (vermaContravariant_radical_mode 1 _ 2 v hvr)
      rw [verma_singular_eq_smul 1 _ (2 * μ + 1) v w hv hw hne hv1 hv2 h1 h2]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self w)
    calc Module.finrank ℂ (vermaRadicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1))
        ≤ Module.finrank ℂ (ℂ ∙ w) := Submodule.finrank_mono hle
      _ ≤ 1 := (finrank_span_singleton hne).le
  · have := card_le_finrank_vermaRadicalLevel_one_sq μ 0
    have h0 : Fintype.card (VermaPartitions 0) = 1 :=
      Fintype.card_eq_one_iff.mpr ⟨⟨[], sortedWord_nil, rfl⟩, fun w =>
        Subtype.ext ((verma_energy_zero_iff w.val).mp w.property.2)⟩
    simpa [h0] using this

/-! ## The named lower bound and the reduction -/

/-- **The `c = 1` radical bound (open; the lower-bound half of Feigin–Fuchs).** In the Verma module
`M(1, μ²)`, the contravariant radical at level `2μ + 1 + m` has dimension at most `p(m)`.
Together with `card_le_finrank_vermaRadicalLevel_one_sq` this says the radical is exactly the
embedded Verma module `M(1, (μ+1)²)` generated by the level-`(2μ+1)` singular vector.

*Proved here:* the case `m = 0` (`finrank_vermaRadicalLevel_one_sq_first`).

*Source.* Feigin–Fuchs, *Verma modules over the Virasoro algebra* (LNM 1060, 1984); Iohara–Koga,
*Representation theory of the Virasoro algebra*, Thm 5.16 (the `c = 1` chain
`M(μ²) ⊃ M((μ+1)²) ⊃ ⋯`); Kac–Raina, *Bombay lectures*, Lecture 3. -/
def VirC1RadicalLevelBound : Prop :=
  ∀ μ m : ℕ, Module.finrank ℂ (vermaRadicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + m)) ≤
    Fintype.card (VermaPartitions m)

/-- **Feigin–Fuchs, textbook form (open).** The maximal proper submodule (= the radical) of
`M(1, μ²)` is generated by its level-`(2μ+1)` singular vector: it is the image of the embedding
`M(1, (μ+1)²) → M(1, μ²)` of any nonzero singular vector at that level. -/
def VirC1MaximalSubmoduleSingular : Prop :=
  ∀ (μ : ℕ) (w : Verma 1 ((μ ^ 2 : ℕ) : ℂ)) (hw : w ∈ sortedSpan 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1))
    (_ : w ≠ 0) (h1 : vermaMode 1 ((μ ^ 2 : ℕ) : ℂ) 1 w = 0)
    (h2 : vermaMode 1 ((μ ^ 2 : ℕ) : ℂ) 2 w = 0),
    vermaRadical 1 ((μ ^ 2 : ℕ) : ℂ) ≤ LinearMap.range (vermaSingularMap 1 _ _ w hw h1 h2)

/-- The textbook form implies the radical bound. -/
theorem virC1RadicalLevelBound_of_maximalSubmodule (hFF : VirC1MaximalSubmoduleSingular) :
    VirC1RadicalLevelBound := by
  intro μ m
  obtain ⟨w, hw, hne, h1, h2⟩ := exists_c1_singular μ
  rw [← vermaSingularMap_level_finrank 1 _ (2 * μ + 1) m w hw hne h1 h2]
  apply Submodule.finrank_mono
  rintro x ⟨hx, hxr⟩
  obtain ⟨u, rfl⟩ := hFF μ w hw hne h1 h2 hxr
  exact ⟨u, (vermaSingularMap_mem_level_iff 1 _ (2 * μ + 1) m w hw hne h1 h2 u).mp hx, rfl⟩

/-- Under the radical bound, `ch L(1, μ²) = (q^{μ²} - q^{(μ+1)²}) Σ p(n) qⁿ`. -/
theorem simpleCharSeries_one_sq_of_bound (hb : VirC1RadicalLevelBound) (μ : ℕ) :
    simpleCharSeries 1 (μ ^ 2) = (X ^ (μ ^ 2) - X ^ ((μ + 1) ^ 2)) * partitionSeries := by
  ext K
  rw [sub_mul, map_sub, coeff_X_pow_mul', coeff_X_pow_mul', simpleCharSeries, coeff_mk]
  have hsq : (μ + 1) ^ 2 = μ ^ 2 + (2 * μ + 1) := by ring
  by_cases hK : μ ^ 2 ≤ K
  · rw [if_pos hK, if_pos hK]
    by_cases hK2 : (μ + 1) ^ 2 ≤ K
    · rw [if_pos hK2]
      obtain ⟨m, hm⟩ : ∃ m, K - μ ^ 2 = 2 * μ + 1 + m := ⟨K - (μ + 1) ^ 2, by omega⟩
      have hm2 : K - (μ + 1) ^ 2 = m := by omega
      have e1 := vermaSimpleLevel_finrank_add_radicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (K - μ ^ 2)
      have e2 := hb μ m
      have e3 := card_le_finrank_vermaRadicalLevel_one_sq μ m
      rw [hm] at e1 ⊢
      rw [hm2, partitionSeries, coeff_mk, coeff_mk]
      have : Module.finrank ℂ (vermaSimpleLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + m)) +
          Fintype.card (VermaPartitions m) = Fintype.card (VermaPartitions (2 * μ + 1 + m)) := by
        omega
      rw [← this]
      push_cast
      ring
    · rw [if_neg hK2, sub_zero, partitionSeries, coeff_mk]
      have hlev : K - μ ^ 2 ≤ 2 * μ := by omega
      rw [vermaSimpleLevel_finrank_of_det_ne_zero 1 _ (K - μ ^ 2)
        (vermaGramMatrix_one_sq_det_ne_zero μ hlev)]
  · rw [if_neg hK, if_neg hK, if_neg (show ¬ (μ + 1) ^ 2 ≤ K by omega), sub_zero]

/-- **I1b, reduced.** The radical bound implies the Feigin–Fuchs `c = 1` degenerate characters. -/
theorem virC1DegenerateCharacters_of_radicalLevelBound (hb : VirC1RadicalLevelBound) :
    VirC1DegenerateCharacters := by
  intro μ
  rw [simpleCharSeries_one_sq_of_bound hb, mul_left_comm, eulerSeries_mul_partitionSeries,
    mul_one, etaVirasoroChar_sq]

/-- Conversely the characters give the radical bound: the reduction loses nothing. -/
theorem virC1RadicalLevelBound_of_degenerateCharacters (hdeg : VirC1DegenerateCharacters) :
    VirC1RadicalLevelBound := by
  intro μ m
  have hS : simpleCharSeries 1 (μ ^ 2) = (X ^ (μ ^ 2) - X ^ ((μ + 1) ^ 2)) * partitionSeries := by
    have h := congrArg (fun f => partitionSeries * f) (hdeg μ)
    simp only [← mul_assoc, mul_comm partitionSeries eulerSeries,
      eulerSeries_mul_partitionSeries, one_mul, etaVirasoroChar_sq] at h
    rw [h, mul_comm]
  have hc := congrArg (coeff (μ ^ 2 + (2 * μ + 1 + m))) hS
  have hsq : (μ + 1) ^ 2 = μ ^ 2 + (2 * μ + 1) := by ring
  rw [sub_mul, map_sub, coeff_X_pow_mul', coeff_X_pow_mul', simpleCharSeries, coeff_mk,
    if_pos (by omega), if_pos (by omega), if_pos (by omega), partitionSeries, coeff_mk,
    coeff_mk, show μ ^ 2 + (2 * μ + 1 + m) - μ ^ 2 = 2 * μ + 1 + m by omega,
    show μ ^ 2 + (2 * μ + 1 + m) - (μ + 1) ^ 2 = m by omega] at hc
  have e1 := vermaSimpleLevel_finrank_add_radicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + m)
  have hc' : (Module.finrank ℂ (vermaSimpleLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + m)) : ℤ) +
      Fintype.card (VermaPartitions m) = Fintype.card (VermaPartitions (2 * μ + 1 + m)) := by
    rw [hc]; ring
  omega

/-- **`VirC1DegenerateCharacters` is exactly the radical bound.** -/
theorem virC1DegenerateCharacters_iff :
    VirC1DegenerateCharacters ↔ VirC1RadicalLevelBound :=
  ⟨virC1RadicalLevelBound_of_degenerateCharacters, virC1DegenerateCharacters_of_radicalLevelBound⟩

/-- `η · ch L(1, μ²)` agrees with `q^{μ²} - q^{(μ+1)²}` through the coefficient `q^{(μ+1)²}`
(the first singular level included), unconditionally. -/
theorem coeff_eulerSeries_mul_simpleCharSeries_sq_of_le (μ : ℕ) {N : ℕ}
    (hN : N ≤ (μ + 1) ^ 2) :
    coeff N (eulerSeries * simpleCharSeries 1 (μ ^ 2)) = coeff N (etaVirasoroChar (μ ^ 2)) := by
  have hsq : (μ + 1) ^ 2 = μ ^ 2 + (2 * μ + 1) := by ring
  have hcongr : coeff N (eulerSeries * simpleCharSeries 1 (μ ^ 2)) =
      coeff N (eulerSeries * ((X ^ (μ ^ 2) - X ^ ((μ + 1) ^ 2)) * partitionSeries)) := by
    refine coeff_mul_congr_right _ fun b hb => ?_
    rw [sub_mul, map_sub, coeff_X_pow_mul', coeff_X_pow_mul', simpleCharSeries, coeff_mk]
    by_cases hK : μ ^ 2 ≤ b
    · rw [if_pos hK, if_pos hK]
      by_cases hK2 : (μ + 1) ^ 2 ≤ b
      · have hb' : b = μ ^ 2 + (2 * μ + 1 + 0) := by omega
        subst hb'
        rw [if_pos hK2, show μ ^ 2 + (2 * μ + 1 + 0) - μ ^ 2 = 2 * μ + 1 + 0 by omega,
          show μ ^ 2 + (2 * μ + 1 + 0) - (μ + 1) ^ 2 = 0 by omega, partitionSeries, coeff_mk,
          coeff_mk]
        have e1 := vermaSimpleLevel_finrank_add_radicalLevel 1 ((μ ^ 2 : ℕ) : ℂ) (2 * μ + 1 + 0)
        rw [Nat.add_zero, finrank_vermaRadicalLevel_one_sq_first] at e1
        have h0 : Fintype.card (VermaPartitions 0) = 1 :=
          Fintype.card_eq_one_iff.mpr ⟨⟨[], sortedWord_nil, rfl⟩, fun w =>
            Subtype.ext ((verma_energy_zero_iff w.val).mp w.property.2)⟩
        rw [Nat.add_zero, h0, ← e1]
        push_cast
        ring
      · rw [if_neg hK2, sub_zero, partitionSeries, coeff_mk]
        rw [vermaSimpleLevel_finrank_of_det_ne_zero 1 _ (b - μ ^ 2)
          (vermaGramMatrix_one_sq_det_ne_zero μ (by omega))]
    · rw [if_neg hK, if_neg hK, if_neg (show ¬ (μ + 1) ^ 2 ≤ b by omega), sub_zero]
  rw [hcongr, mul_left_comm, eulerSeries_mul_partitionSeries, mul_one, etaVirasoroChar_sq]

end VOA.Classification.COne
