set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step4_check :
    equalRelCheck (scaleRel weight_circle3 circle3 ++ partial3)
      partial4 = true := by decide +kernel

theorem partial4_holds : evalRel W selfMode partial4 = 0 := by
  have h := equalRelCheck_sound W selfMode step4_check
  rw [evalRel_append, evalRel_scale, circle3_holds, map_zero, partial3_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
