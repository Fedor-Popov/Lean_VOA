theorem vectorPartial10_check : equalRawCheck (rawChunk10 ++ vectorPartial9) vectorPartial10 = true := by
  decide +kernel

theorem vectorPartial10_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector prefixVector10) = evalSym W k a (symMap vectorPartial10) := by
  rw [prefixVector10, evalSym_vector_append, vectorPartial9_sound W k a,
    vectorChunk10_sound W k a]
  have hh := equalRawCheck_sound W k a vectorPartial10_check
  rw [symMap_append, evalSym_append] at hh
  simpa only [add_comm] using hh

end VOA.Classification.COne.OrbIcoZ
