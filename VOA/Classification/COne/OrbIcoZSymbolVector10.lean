theorem vectorChunk10_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector vectorChunk10) = evalSym W k a (symMap rawChunk10) := by
  simp only [vectorChunk10, rawChunk10, ofRaw, List.map_cons, List.map_nil,
    symVector, evalSym_normalize, evalSym_append, evalSym_scale, evalSym_nil,
    symMap_append, symMap_scale]
  rw [wordCache101_sound W k a]
  simp [bp, qp, add_assoc]

