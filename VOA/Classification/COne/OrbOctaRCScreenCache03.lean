theorem sc450_check :
    reduceTwo (prependC 3 sc141 ++ scaleR (-1) (prependC 0 sc144)) = sc450 := by
  decide +kernel

theorem sc450_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc450 = evRc a c (expWordR [3, 6] (5)) := by
  rw [← sc450_check]
  exact expTwo_step _ _ hc 2 [6] (5)
    sc141 sc144 (sc141_sound a c hc) (sc144_sound a c hc)

