import VOA.Classification.COne.OrbSpanMain
import VOA.Classification.COne.OrbC2Reynolds
import VOA.Classification.COne.OrbPrimInvariant
import VOA.Modules.PoissonDescent

/-! # OrbPrim: `TetraPrimaryReduction` from a polynomial model of the primaries of `V₂`

The B2 residual `OrbSpan.TetraPrimaryReduction` asks that every Virasoro primary of
`W = V₂^{A₄}` lie in `C₂(W) + span{𝟙, u, v, u₍ₙ₎u} + (lower Virasoro descendants)`.

The mathematics (Dong--Jiang Lemma 4.2, made explicit):
`V₂ = ⊕ₙ L(1, n²) ⊗ Vₙ` as `Vir × SU(2)`-module, and the primaries of weight `n²` are the image
of the degree-`n` polynomials on `(V₂)₁ ≅ ℂ³` under the iterated top channel `T₂`. Products of
primaries map to products of polynomials (top channel); the `A₄`-invariant polynomials are
generated by `r², I₃, I₄, I₆` (`OrbPrimInvariant`, proved); `r²` dies, `I₃ ↦ u`, `I₄ ↦ v`, and
`I₆` is reached by the second channel `v₍₋₁₂₎u`.

## This file (glue only; every hypothesis is named and explicit)

* `PrimModel W T` (any VOA `W`, `T : ℂ[x,y,z] →ₗ W`): the five `W`-level properties.
  `primaryC2Reduction_of_primModel`: `PrimModel W T → PrimaryC2Reduction W (djSeedSet W (T I₃) (T I₄))`.
* `V2Model G T₂ φ` (any VOA `W₀`, finite `G ≤ Aut W₀`, `T₂ : ℂ[x,y,z] →ₗ W₀`, and a hom
  `φ : G →* Aut ℂ[x,y,z]` realizing `A₄`): the `V₂`-level properties — no orbifold appears
  in the spanning, top-channel and second-channel statements.
  `primModel_of_v2Model`: averaging over `G` turns a `V2Model` into a `PrimModel` of `W₀^G`.
* `tetraPrimaryReduction_of_v2Model`, `tetra_c2Cofinite_of_v2Model`.
-/

set_option maxSynthPendingDepth 3
set_option maxRecDepth 4096
noncomputable section
namespace VOA.Classification.COne.OrbPrim
open VOA VertexOperatorAlgebra MvPolynomial OrbSpan

universe u

section Generic
variable {V : Type u} [AddCommGroup V] [Module ℂ V] (W : VertexOperatorAlgebra V)

/-- Homogeneous `A₄`-invariants of degree `n` with `n² = N`. -/
def invDeg (N : ℤ) : Set P3 := {F | IsA4Inv F ∧ ∃ n : ℕ, F.IsHomogeneous n ∧ (n : ℤ) ^ 2 = N}

/-- The `W`-level model of the primaries of `W = V₂^{A₄}`. -/
structure PrimModel (T : P3 →ₗ[ℂ] V) : Prop where
  /-- `T 1 = 𝟙`. -/
  vac : T 1 = W.vacuum
  /-- (H1 + invariants) every primary of weight `N` is `T` of invariants of degree `√N`,
  modulo lower descendants. -/
  span : ∀ N : ℤ, prim W N ≤ Submodule.span ℂ (T '' invDeg N) ⊔ lowerDesc W N
  /-- (H2) the top channel: `T (G H) ∈ C₂ + lower descendants`. -/
  top : ∀ (G H : P3) (s m : ℕ), IsA4Inv G → IsA4Inv H → G.IsHomogeneous s →
    H.IsHomogeneous m → 1 ≤ s → 1 ≤ m →
    T (G * H) ∈ O₂ W ⊔ lowerDesc W (((s + m : ℕ) : ℤ) ^ 2)
  /-- `r²` gives no primary. -/
  r2 : T r2 ∈ O₂ W ⊔ lowerDesc W 4
  /-- (N) the weight-36 invariant `I₆`. -/
  six : T I6 ∈ O₂ W ⊔ Submodule.span ℂ (djSeedSet W (T I3) (T I4)) ⊔ lowerDesc W 36

/-- **Glue.** A `PrimModel` gives the primary reduction with seeds `u = T I₃`, `v = T I₄`. -/
theorem primaryC2Reduction_of_primModel {T : P3 →ₗ[ℂ] V} (h : PrimModel W T) :
    PrimaryC2Reduction W (djSeedSet W (T I3) (T I4)) := by
  intro N
  refine le_trans (h.span N) (sup_le ?_ le_sup_right)
  rw [Submodule.span_le]
  rintro _ ⟨F, ⟨hF, n, hn, rfl⟩, rfl⟩
  have hFs := mem_span_genMon_of_isHomogeneous hF hn
  have hmap : T F ∈ (Submodule.span ℂ (genMon '' {t | gdeg t = n})).map T :=
    Submodule.mem_map_of_mem hFs
  rw [Submodule.map_span] at hmap
  refine (Submodule.span_le.mpr ?_) hmap
  rintro _ ⟨_, ⟨t, ht, rfl⟩, rfl⟩
  simp only [Set.mem_setOf_eq] at ht
  have hseed : ∀ x ∈ djSeedSet W (T I3) (T I4),
      x ∈ O₂ W ⊔ Submodule.span ℂ (djSeedSet W (T I3) (T I4)) ⊔ lowerDesc W ((n : ℤ) ^ 2) :=
    fun x hx => Submodule.mem_sup_left (Submodule.mem_sup_right (Submodule.subset_span hx))
  have hO : ∀ k : ℤ, k = (n : ℤ) ^ 2 → ∀ x ∈ O₂ W ⊔ lowerDesc W k,
      x ∈ O₂ W ⊔ Submodule.span ℂ (djSeedSet W (T I3) (T I4)) ⊔ lowerDesc W ((n : ℤ) ^ 2) := by
    rintro k rfl x hx
    exact (sup_le_sup_right (le_sup_left : O₂ W ≤ O₂ W ⊔
      Submodule.span ℂ (djSeedSet W (T I3) (T I4))) (lowerDesc W ((n : ℤ) ^ 2))) hx
  rw [SetLike.mem_coe]
  rcases genMon_cases t with rfl | rfl | rfl | rfl | rfl | ⟨a, b, ha, hb, hab, he⟩
  · have : genMon (0, 0, 0, 0) = 1 := by simp [genMon]
    rw [this, h.vac]; exact hseed _ (by simp [djSeedSet])
  · have : genMon (1, 0, 0, 0) = r2 := by simp [genMon]
    have hn2 : n = 2 := by simp [gdeg] at ht; omega
    subst hn2
    rw [this]; exact hO 4 (by norm_num) _ h.r2
  · have : genMon (0, 1, 0, 0) = I3 := by simp [genMon]
    rw [this]; exact hseed _ (by simp [djSeedSet])
  · have : genMon (0, 0, 1, 0) = I4 := by simp [genMon]
    rw [this]; exact hseed _ (by simp [djSeedSet])
  · have : genMon (0, 0, 0, 1) = I6 := by simp [genMon]
    have hn6 : n = 6 := by simp [gdeg] at ht; omega
    subst hn6
    rw [this]
    have h36 : ((6 : ℕ) : ℤ) ^ 2 = 36 := by norm_num
    rw [h36]; exact h.six
  · rw [he]
    exact hO _ (by rw [hab, ht]) _ (h.top _ _ _ _ (isA4Inv_genMon a) (isA4Inv_genMon b)
      (genMon_hom a) (genMon_hom b) ha hb)

/-- The second channel `v₍₋₁₂₎u` gives the `six` field from the top channel. -/
theorem six_of_secondChannel {T : P3 →ₗ[ℂ] V}
    (htop : ∀ (G H : P3) (s m : ℕ), IsA4Inv G → IsA4Inv H → G.IsHomogeneous s →
      H.IsHomogeneous m → 1 ≤ s → 1 ≤ m →
      T (G * H) ∈ O₂ W ⊔ lowerDesc W (((s + m : ℕ) : ℤ) ^ 2))
    (hS : ∃ c d : ℂ, c ≠ 0 ∧
      W.smul (T I4) (-12) (T I3) - c • T I6 - d • T (I3 * I3) ∈ lowerDesc W 36) :
    T I6 ∈ O₂ W ⊔ lowerDesc W 36 := by
  obtain ⟨c, d, hc, hδ⟩ := hS
  have h33 : T (I3 * I3) ∈ O₂ W ⊔ lowerDesc W 36 := by
    have := htop I3 I3 3 3 isA4Inv_I3 isA4Inv_I3 I3_hom I3_hom (by norm_num) (by norm_num)
    norm_num at this; exact this
  have hsm : W.smul (T I4) (-12) (T I3) ∈ O₂ W ⊔ lowerDesc W 36 :=
    Submodule.mem_sup_left (smul_le_neg_two_mem_O₂ W _ _ (by norm_num))
  have hδ' : W.smul (T I4) (-12) (T I3) - c • T I6 - d • T (I3 * I3) ∈ O₂ W ⊔ lowerDesc W 36 :=
    Submodule.mem_sup_right hδ
  have key : T I6 = c⁻¹ • (W.smul (T I4) (-12) (T I3) - d • T (I3 * I3) -
      (W.smul (T I4) (-12) (T I3) - c • T I6 - d • T (I3 * I3))) := by
    rw [show W.smul (T I4) (-12) (T I3) - d • T (I3 * I3) -
        (W.smul (T I4) (-12) (T I3) - c • T I6 - d • T (I3 * I3)) = c • T I6 by abel,
      smul_smul, inv_mul_cancel₀ hc, one_smul]
  rw [key]
  exact Submodule.smul_mem _ _ (Submodule.sub_mem _ (Submodule.sub_mem _ hsm
    (Submodule.smul_mem _ _ h33)) hδ')

end Generic

/-! ## From `V₂` to the orbifold by averaging -/

section Lift
variable {V : Type u} [AddCommGroup V] [Module ℂ V] {W₀ : VertexOperatorAlgebra V}

/-- The `V₂`-level model: a linear map `T₂ : ℂ[x,y,z] → W₀` and a homomorphism
`φ : G →* Aut ℂ[x,y,z]` through which `G` acts on polynomials, realizing `A₄`. -/
structure V2Model (G : Subgroup (Aut W₀)) (T₂ : P3 →ₗ[ℂ] V) (φ : G →* (P3 ≃ₐ[ℂ] P3)) :
    Prop where
  /-- Equivariance `g ∘ T₂ = T₂ ∘ φ(g)`. -/
  eqv : ∀ (g : G) (F : P3), (g : Aut W₀) (T₂ F) = T₂ (φ g F)
  /-- The image of `φ` fixes the `A₄`-invariants. -/
  fix : ∀ (g : G) (F : P3), IsA4Inv F → φ g F = F
  /-- The generators of `A₄` are in the image of `φ`. -/
  gen1 : ∃ g : G, ∀ F, φ g F = s1 F
  gen2 : ∃ g : G, ∀ F, φ g F = s2 F
  gen3 : ∃ g : G, ∀ F, φ g F = rename cyc F
  /-- `φ` preserves degrees. -/
  hom : ∀ (g : G) (F : P3) (n : ℕ), F.IsHomogeneous n → (φ g F).IsHomogeneous n
  /-- `T₂ 1 = 𝟙`. -/
  vac : T₂ 1 = W₀.vacuum
  /-- Degree `n` lands in weight `n²`. -/
  grad : ∀ (F : P3) (n : ℕ), F.IsHomogeneous n → T₂ F ∈ W₀.grading ((n : ℤ) ^ 2)
  /-- (H1) `T₂` of degree-`n` polynomials spans the primaries of weight `n²`, and there are no
  others, modulo lower descendants. -/
  span : ∀ N : ℤ, prim W₀ N ≤
    Submodule.span ℂ (T₂ '' {F | ∃ n : ℕ, F.IsHomogeneous n ∧ (n : ℤ) ^ 2 = N}) ⊔ lowerDesc W₀ N
  /-- (H2) the top channel: `T₂ (G H) ≡ c · (T₂ G)₍₋₂ₛₘ₋₁₎(T₂ H)` modulo lower descendants. -/
  top : ∀ (G H : P3) (s m : ℕ), G.IsHomogeneous s → H.IsHomogeneous m → 1 ≤ s → 1 ≤ m →
    ∃ c : ℂ, T₂ (G * H) - c • W₀.smul (T₂ G) (-((2 * s * m : ℕ) : ℤ) - 1) (T₂ H) ∈
      lowerDesc W₀ (((s + m : ℕ) : ℤ) ^ 2)
  /-- `r²` gives no primary. -/
  r2 : T₂ r2 ∈ lowerDesc W₀ 4
  /-- (N) the second channel at weight `36`. -/
  six : ∃ c d : ℂ, c ≠ 0 ∧
    W₀.smul (T₂ I4) (-12) (T₂ I3) - c • T₂ I6 - d • T₂ (I3 * I3) ∈ lowerDesc W₀ 36

variable (G : Subgroup (Aut W₀))

theorem orb_L_coe (n : ℤ) (x : (orbifold G).carrier) :
    (((orbifoldVOA G).L n x : (orbifold G).carrier) : V) = W₀.L n x := rfl

theorem orb_smul_coe (a : (orbifold G).carrier) (n : ℤ) (b : (orbifold G).carrier) :
    (((orbifoldVOA G).smul a n b : (orbifold G).carrier) : V) = W₀.smul a n b := rfl

theorem orb_mem_grading {n : ℤ} {x : (orbifold G).carrier} :
    x ∈ (orbifoldVOA G).grading n ↔ (x : V) ∈ W₀.grading n := Iff.rfl

theorem orb_prim_coe {N : ℤ} {x : (orbifold G).carrier} (hx : x ∈ prim (orbifoldVOA G) N) :
    (x : V) ∈ prim W₀ N := by
  rw [mem_prim] at hx ⊢
  refine ⟨hx.1, fun m => ?_⟩
  have := congrArg Subtype.val (hx.2 m)
  rwa [orb_L_coe] at this

variable [Fintype G]

theorem average_L (n : ℤ) (y : V) :
    OrbC2.average G (W₀.L n y) = (orbifoldVOA G).L n (OrbC2.average G y) := by
  apply Subtype.ext
  rw [orb_L_coe, OrbC2.average_val, OrbC2.average_val, map_smul, map_sum]
  congr 1
  exact Finset.sum_congr rfl fun g _ => aut_comm_L g.1 n y

theorem average_grading {n : ℤ} {y : V} (hy : y ∈ W₀.grading n) :
    OrbC2.average G y ∈ (orbifoldVOA G).grading n := by
  rw [orb_mem_grading, OrbC2.average_val]
  exact Submodule.smul_mem _ _ (Submodule.sum_mem _ fun g _ => Aut.map_grading g.1 hy)

theorem average_lowerDesc {N : ℤ} {y : V} (hy : y ∈ lowerDesc W₀ N) :
    OrbC2.average G y ∈ lowerDesc (orbifoldVOA G) N := by
  induction hy using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨m, y', hy', rfl⟩ := hx
    rw [average_L]
    exact Submodule.subset_span ⟨m, _, average_grading G hy', rfl⟩
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul a x _ hx => rw [map_smul]; exact Submodule.smul_mem _ _ hx

variable {G} {T₂ : P3 →ₗ[ℂ] V} {φ : G →* (P3 ≃ₐ[ℂ] P3)}

/-- The averaged map `T = avg ∘ T₂ : ℂ[x,y,z] → W₀^G`. -/
def avgT (G : Subgroup (Aut W₀)) [Fintype G] (T₂ : P3 →ₗ[ℂ] V) :
    P3 →ₗ[ℂ] (orbifold G).carrier :=
  (OrbC2.average G).comp T₂

omit [Fintype G] in
theorem T₂_mem_orbifold (h : V2Model G T₂ φ) {F : P3} (hF : IsA4Inv F) :
    T₂ F ∈ (orbifold G).carrier := fun g hg => by
  have := h.eqv ⟨g, hg⟩ F
  rw [h.fix ⟨g, hg⟩ F hF] at this
  exact this

theorem avgT_coe (h : V2Model G T₂ φ) {F : P3} (hF : IsA4Inv F) :
    ((avgT G T₂ F : (orbifold G).carrier) : V) = T₂ F := by
  have := OrbC2.average_fixed G ⟨T₂ F, T₂_mem_orbifold h hF⟩
  simp only [avgT, LinearMap.comp_apply]
  exact congrArg Subtype.val this

/-- The polynomial Reynolds operator through `φ`. -/
def reyP (φ : G →* (P3 ≃ₐ[ℂ] P3)) (F : P3) : P3 :=
  ((Fintype.card G : ℂ)⁻¹) • ∑ g : G, φ g F

theorem reyP_apply_gen (g₁ : G) (F : P3) : φ g₁ (reyP φ F) = reyP φ F := by
  simp only [reyP, map_smul, map_sum]
  congr 1
  exact Fintype.sum_equiv (Equiv.mulLeft g₁) _ _ (fun g => by
    simp [map_mul, AlgEquiv.mul_apply])

theorem isA4Inv_reyP (h : V2Model G T₂ φ) (F : P3) : IsA4Inv (reyP φ F) := by
  obtain ⟨g1, h1⟩ := h.gen1
  obtain ⟨g2, h2⟩ := h.gen2
  obtain ⟨g3, h3⟩ := h.gen3
  refine ⟨?_, ?_, ?_⟩
  · rw [← h1]; exact reyP_apply_gen g1 F
  · rw [← h2]; exact reyP_apply_gen g2 F
  · rw [← h3]; exact reyP_apply_gen g3 F

theorem reyP_hom (h : V2Model G T₂ φ) {F : P3} {n : ℕ} (hF : F.IsHomogeneous n) :
    (reyP φ F).IsHomogeneous n := by
  rw [← mem_homogeneousSubmodule]
  exact Submodule.smul_mem _ _ (Submodule.sum_mem _ fun g _ =>
    (mem_homogeneousSubmodule _ _).mpr (h.hom g F n hF))

theorem average_T₂ (h : V2Model G T₂ φ) (F : P3) :
    OrbC2.average G (T₂ F) = avgT G T₂ (reyP φ F) := by
  apply Subtype.ext
  rw [avgT_coe h (isA4Inv_reyP h F), OrbC2.average_val, reyP, map_smul, map_sum]
  congr 1
  exact Finset.sum_congr rfl fun g _ => h.eqv g F

theorem average_smul_T₂ (h : V2Model G T₂ φ) {A B : P3} (hA : IsA4Inv A) (hB : IsA4Inv B)
    (k : ℤ) : OrbC2.average G (W₀.smul (T₂ A) k (T₂ B)) =
      (orbifoldVOA G).smul (avgT G T₂ A) k (avgT G T₂ B) := by
  have hmem : W₀.smul (T₂ A) k (T₂ B) ∈ (orbifold G).carrier :=
    (orbifold G).smul_mem _ (T₂_mem_orbifold h hA) _ _ (T₂_mem_orbifold h hB)
  rw [show W₀.smul (T₂ A) k (T₂ B) = ((⟨_, hmem⟩ : (orbifold G).carrier) : V) from rfl,
    OrbC2.average_fixed]
  apply Subtype.ext
  rw [orb_smul_coe, avgT_coe h hA, avgT_coe h hB]

theorem average_T₂_inv (F : P3) : OrbC2.average G (T₂ F) = avgT G T₂ F := rfl

/-- **Lift.** A `V₂`-level model gives a `PrimModel` of the orbifold `W₀^G`. -/
theorem primModel_of_v2Model (h : V2Model G T₂ φ) :
    PrimModel (orbifoldVOA G) (avgT G T₂) where
  vac := by
    apply Subtype.ext
    rw [avgT_coe h ⟨by simp, by simp, by simp⟩, h.vac]
    rfl
  span := by
    intro N p hp
    have hp' := h.span N (orb_prim_coe G hp)
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hp'
    have hpa : p = OrbC2.average G a + OrbC2.average G b := by
      rw [← map_add, hab, OrbC2.average_fixed]
    rw [hpa]
    refine Submodule.add_mem_sup ?_ (average_lowerDesc G hb)
    have hmap : OrbC2.average G a ∈ (Submodule.span ℂ
        (T₂ '' {F | ∃ n : ℕ, F.IsHomogeneous n ∧ (n : ℤ) ^ 2 = N})).map (OrbC2.average G) :=
      Submodule.mem_map_of_mem ha
    rw [Submodule.map_span] at hmap
    refine (Submodule.span_le.mpr ?_) hmap
    rintro _ ⟨_, ⟨F, ⟨n, hn, hN⟩, rfl⟩, rfl⟩
    rw [SetLike.mem_coe, average_T₂ h]
    exact Submodule.subset_span ⟨_, ⟨isA4Inv_reyP h F, n, reyP_hom h hn, hN⟩, rfl⟩
  top := by
    intro A B s m hA hB hAs hBm hs hm
    obtain ⟨c, hc⟩ := h.top A B s m hAs hBm hs hm
    have hav := average_lowerDesc G hc
    rw [map_sub, map_smul, average_T₂_inv (A * B), average_smul_T₂ h hA hB]
      at hav
    have hO : (orbifoldVOA G).smul (avgT G T₂ A) (-((2 * s * m : ℕ) : ℤ) - 1) (avgT G T₂ B) ∈
        O₂ (orbifoldVOA G) := by
      apply smul_le_neg_two_mem_O₂
      have : 1 ≤ 2 * s * m := by nlinarith
      omega
    have key : avgT G T₂ (A * B) =
        c • (orbifoldVOA G).smul (avgT G T₂ A) (-((2 * s * m : ℕ) : ℤ) - 1) (avgT G T₂ B) +
        (avgT G T₂ (A * B) - c • (orbifoldVOA G).smul (avgT G T₂ A)
          (-((2 * s * m : ℕ) : ℤ) - 1) (avgT G T₂ B)) := by abel
    rw [key]
    exact Submodule.add_mem_sup (Submodule.smul_mem _ _ hO) hav
  r2 := Submodule.mem_sup_right (average_lowerDesc G h.r2)
  six := by
    have htop : ∀ (A B : P3) (s m : ℕ), IsA4Inv A → IsA4Inv B → A.IsHomogeneous s →
        B.IsHomogeneous m → 1 ≤ s → 1 ≤ m →
        avgT G T₂ (A * B) ∈ O₂ (orbifoldVOA G) ⊔ lowerDesc (orbifoldVOA G)
          (((s + m : ℕ) : ℤ) ^ 2) := by
      intro A B s m hA hB hAs hBm hs hm
      obtain ⟨c, hc⟩ := h.top A B s m hAs hBm hs hm
      have hav := average_lowerDesc G hc
      rw [map_sub, map_smul, average_T₂_inv (A * B), average_smul_T₂ h hA hB]
        at hav
      have hO : (orbifoldVOA G).smul (avgT G T₂ A) (-((2 * s * m : ℕ) : ℤ) - 1)
          (avgT G T₂ B) ∈ O₂ (orbifoldVOA G) := by
        apply smul_le_neg_two_mem_O₂
        have : 1 ≤ 2 * s * m := by nlinarith
        omega
      have key : avgT G T₂ (A * B) =
          c • (orbifoldVOA G).smul (avgT G T₂ A) (-((2 * s * m : ℕ) : ℤ) - 1) (avgT G T₂ B) +
          (avgT G T₂ (A * B) - c • (orbifoldVOA G).smul (avgT G T₂ A)
            (-((2 * s * m : ℕ) : ℤ) - 1) (avgT G T₂ B)) := by abel
      rw [key]
      exact Submodule.add_mem_sup (Submodule.smul_mem _ _ hO) hav
    have hS : ∃ c d : ℂ, c ≠ 0 ∧ (orbifoldVOA G).smul (avgT G T₂ I4) (-12) (avgT G T₂ I3) -
        c • avgT G T₂ I6 - d • avgT G T₂ (I3 * I3) ∈ lowerDesc (orbifoldVOA G) 36 := by
      obtain ⟨c, d, hc, hδ⟩ := h.six
      refine ⟨c, d, hc, ?_⟩
      have hav := average_lowerDesc G hδ
      rwa [map_sub, map_sub, map_smul, map_smul, average_smul_T₂ h isA4Inv_I4 isA4Inv_I3,
        average_T₂_inv I6, average_T₂_inv (I3 * I3)] at hav
    exact (sup_le_sup_right (le_sup_left : O₂ (orbifoldVOA G) ≤ O₂ (orbifoldVOA G) ⊔
      Submodule.span ℂ (djSeedSet (orbifoldVOA G) (avgT G T₂ I3) (avgT G T₂ I4)))
      (lowerDesc (orbifoldVOA G) 36)) (six_of_secondChannel _ htop hS)

theorem avgT_grading (h : V2Model G T₂ φ) {F : P3} {n : ℕ} (hF : IsA4Inv F)
    (hn : F.IsHomogeneous n) : avgT G T₂ F ∈ (orbifoldVOA G).grading ((n : ℤ) ^ 2) := by
  rw [orb_mem_grading, avgT_coe h hF]; exact h.grad F n hn

end Lift

/-! ## Splitting (H1): the primary spectrum of `V₂` versus the map `T₂` -/

section DimSplit
variable {V : Type u} [AddCommGroup V] [Module ℂ V] (W₀ : VertexOperatorAlgebra V)

/-- (H1a) The primary spectrum bound for `V₂ = ⊕ₙ L(1,n²) ⊗ V_n`: no Virasoro primaries
off the squares, and at most `2n + 1` independent ones in weight `n²`. -/
def PrimSpectrumBound : Prop :=
  (∀ N : ℤ, (∀ n : ℕ, (n : ℤ) ^ 2 ≠ N) → prim W₀ N = ⊥) ∧
    ∀ n : ℕ, Module.finrank ℂ (prim W₀ ((n : ℤ) ^ 2)) ≤ 2 * n + 1

/-- (H1) from the spectrum bound, primary-valued `T₂` (H1b) and its rank (H1c). -/
theorem span_of_spectrum {T₂ : P3 →ₗ[ℂ] V} (hD : PrimSpectrumBound W₀)
    (hP : ∀ (F : P3) (n : ℕ), F.IsHomogeneous n → T₂ F ∈ prim W₀ ((n : ℤ) ^ 2))
    (hR : ∀ n : ℕ, 2 * n + 1 ≤
      Module.finrank ℂ (Submodule.span ℂ (T₂ '' {F | F.IsHomogeneous n}))) :
    ∀ N : ℤ, prim W₀ N ≤
      Submodule.span ℂ (T₂ '' {F | ∃ n : ℕ, F.IsHomogeneous n ∧ (n : ℤ) ^ 2 = N}) ⊔
        lowerDesc W₀ N := by
  intro N
  by_cases hsq : ∃ n : ℕ, (n : ℤ) ^ 2 = N
  · obtain ⟨n, rfl⟩ := hsq
    have hSle : Submodule.span ℂ (T₂ '' {F | F.IsHomogeneous n}) ≤ prim W₀ ((n : ℤ) ^ 2) :=
      Submodule.span_le.mpr (by rintro _ ⟨F, hF, rfl⟩; exact hP F n hF)
    haveI : FiniteDimensional ℂ (W₀.grading ((n : ℤ) ^ 2)) := W₀.finrank _
    haveI : FiniteDimensional ℂ (prim W₀ ((n : ℤ) ^ 2)) :=
      Submodule.finiteDimensional_of_le (inf_le_left : prim W₀ _ ≤ W₀.grading _)
    have heq := Submodule.eq_of_le_of_finrank_le hSle (le_trans (hD.2 n) (hR n))
    refine le_sup_of_le_left ?_
    rw [← heq]
    exact Submodule.span_mono (by rintro _ ⟨F, hF, rfl⟩; exact ⟨F, ⟨n, hF, rfl⟩, rfl⟩)
  · push Not at hsq
    rw [hD.1 N hsq]; exact bot_le

end DimSplit

/-- The `V₂`-level model with (H1) split into the spectrum bound (H1a), primary values (H1b)
and rank (H1c). -/
structure V2ModelSplit {V : Type u} [AddCommGroup V] [Module ℂ V] {W₀ : VertexOperatorAlgebra V}
    (G : Subgroup (Aut W₀)) (T₂ : P3 →ₗ[ℂ] V) (φ : G →* (P3 ≃ₐ[ℂ] P3)) : Prop where
  eqv : ∀ (g : G) (F : P3), (g : Aut W₀) (T₂ F) = T₂ (φ g F)
  fix : ∀ (g : G) (F : P3), IsA4Inv F → φ g F = F
  gen1 : ∃ g : G, ∀ F, φ g F = s1 F
  gen2 : ∃ g : G, ∀ F, φ g F = s2 F
  gen3 : ∃ g : G, ∀ F, φ g F = rename cyc F
  hom : ∀ (g : G) (F : P3) (n : ℕ), F.IsHomogeneous n → (φ g F).IsHomogeneous n
  vac : T₂ 1 = W₀.vacuum
  grad : ∀ (F : P3) (n : ℕ), F.IsHomogeneous n → T₂ F ∈ W₀.grading ((n : ℤ) ^ 2)
  /-- (H1a) -/
  spectrum : PrimSpectrumBound W₀
  /-- (H1b) `T₂` of a degree-`n` polynomial is a primary of weight `n²`. -/
  primVal : ∀ (F : P3) (n : ℕ), 1 ≤ n → F.IsHomogeneous n → T₂ F ∈ prim W₀ ((n : ℤ) ^ 2)
  /-- (H1c) `T₂` has rank at least `2n + 1` in degree `n`. -/
  rank : ∀ n : ℕ, 2 * n + 1 ≤
    Module.finrank ℂ (Submodule.span ℂ (T₂ '' {F | F.IsHomogeneous n}))
  top : ∀ (G H : P3) (s m : ℕ), G.IsHomogeneous s → H.IsHomogeneous m → 1 ≤ s → 1 ≤ m →
    ∃ c : ℂ, T₂ (G * H) - c • W₀.smul (T₂ G) (-((2 * s * m : ℕ) : ℤ) - 1) (T₂ H) ∈
      lowerDesc W₀ (((s + m : ℕ) : ℤ) ^ 2)
  r2 : T₂ r2 ∈ lowerDesc W₀ 4
  six : ∃ c d : ℂ, c ≠ 0 ∧
    W₀.smul (T₂ I4) (-12) (T₂ I3) - c • T₂ I6 - d • T₂ (I3 * I3) ∈ lowerDesc W₀ 36

/-- The vacuum is primary. -/
theorem vacuum_mem_prim {V : Type u} [AddCommGroup V] [Module ℂ V]
    (W₀ : VertexOperatorAlgebra V) : W₀.vacuum ∈ prim W₀ 0 := by
  rw [mem_prim]
  refine ⟨W₀.vacuum_mem, fun m => ?_⟩
  have h := L_mem_grading_aux W₀ W₀.vacuum_mem ((m : ℤ) + 1)
  rw [W₀.positivity _ (by omega), Submodule.mem_bot] at h
  exact h

theorem V2ModelSplit.toV2Model {V : Type u} [AddCommGroup V] [Module ℂ V]
    {W₀ : VertexOperatorAlgebra V} {G : Subgroup (Aut W₀)} {T₂ : P3 →ₗ[ℂ] V}
    {φ : G →* (P3 ≃ₐ[ℂ] P3)} (h : V2ModelSplit G T₂ φ) : V2Model G T₂ φ where
  eqv := h.eqv
  fix := h.fix
  gen1 := h.gen1
  gen2 := h.gen2
  gen3 := h.gen3
  hom := h.hom
  vac := h.vac
  grad := h.grad
  span := by
    refine span_of_spectrum W₀ h.spectrum (fun F n hF => ?_) h.rank
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · -- degree 0: `F` is a constant
      obtain ⟨c, rfl⟩ : ∃ c : ℂ, F = MvPolynomial.C c := by
        refine ⟨F.coeff 0, ?_⟩
        rw [← totalDegree_eq_zero_iff_eq_C]
        exact le_antisymm (by simpa using hF.totalDegree_le) (Nat.zero_le _)
      rw [← mul_one (MvPolynomial.C c), ← smul_eq_C_mul, map_smul, h.vac]
      simpa using (prim W₀ 0).smul_mem c (vacuum_mem_prim W₀)
    · exact h.primVal F n hn hF
  top := h.top
  r2 := h.r2
  six := h.six

/-! ## The tetrahedral orbifold -/

open OrbC2b OrbC2c OrbC2Fix VOA.LatGen VOA.LatGen.Triplet

/-- `tetra ≅ A₄` is finite. -/
noncomputable local instance tetraFintype : Fintype tetra :=
  @Fintype.ofFinite _ (Finite.of_equiv (alternatingGroup (Fin 4)) tetra_group.some.symm.toEquiv)

theorem tetraPrimaryReduction_of_primModel {T : P3 →ₗ[ℂ] (orbifold tetra).carrier}
    (h : PrimModel (orbifoldVOA tetra) T) (h9 : T I3 ∈ (orbifoldVOA tetra).grading 9)
    (h16 : T I4 ∈ (orbifoldVOA tetra).grading 16) : TetraPrimaryReduction :=
  ⟨T I3, T I4, h9, h16, primaryC2Reduction_of_primModel _ h⟩

/-- **B2: `TetraPrimaryReduction` from the `V₂`-level model.** -/
theorem tetraPrimaryReduction_of_v2Model {T₂ : P3 →ₗ[ℂ] LatModuleGen (latP 1)}
    {φ : tetra →* (P3 ≃ₐ[ℂ] P3)} (h : V2Model tetra T₂ φ) : TetraPrimaryReduction := by
  have h9 := avgT_grading h isA4Inv_I3 I3_hom
  have h16 := avgT_grading h isA4Inv_I4 I4_hom
  norm_num at h9 h16
  exact tetraPrimaryReduction_of_primModel (primModel_of_v2Model h) h9 h16

theorem tetraPrimaryReduction_of_v2ModelSplit {T₂ : P3 →ₗ[ℂ] LatModuleGen (latP 1)}
    {φ : tetra →* (P3 ≃ₐ[ℂ] P3)} (h : V2ModelSplit tetra T₂ φ) : TetraPrimaryReduction :=
  tetraPrimaryReduction_of_v2Model h.toV2Model

theorem tetrahedralVirasoroSpan_of_v2Model {T₂ : P3 →ₗ[ℂ] LatModuleGen (latP 1)}
    {φ : tetra →* (P3 ≃ₐ[ℂ] P3)} (h : V2Model tetra T₂ φ) : TetrahedralVirasoroSpan :=
  tetrahedralVirasoroSpan_of_primaryReduction (tetraPrimaryReduction_of_v2Model h)

/-- `C₂` for `V₂^{A₄}` from the `V₂`-level model and the corrected Dong--Jiang relations. -/
theorem tetra_c2Cofinite_of_v2Model {T₂ : P3 →ₗ[ℂ] LatModuleGen (latP 1)}
    {φ : tetra →* (P3 ≃ₐ[ℂ] P3)} (h : V2Model tetra T₂ φ)
    (hr : TetrahedralDongJiangRelationsCorrected) : C2Cofinite (orbifoldVOA tetra) :=
  tetra_c2Cofinite_of_primaryReduction (tetraPrimaryReduction_of_v2Model h) hr

end VOA.Classification.COne.OrbPrim
