/-- This gives actual divisibility by the conformal class, before any rationality theorem. -/
theorem self35_conformal_divisible : ∃ z : A Wi, omegaL Wi z = selfMode 35 := by
  let P := LinearMap.range (omegaL Wi)
  have h := self35_zeroFiber P.mkQ (fun z =>
    (Submodule.Quotient.mk_eq_zero P).mpr (LinearMap.mem_range_self (omegaL Wi) z))
  exact (Submodule.Quotient.mk_eq_zero P).mp h

