import VOA.Classification.COne.Statement
import VOA.Moonshine.NondegLattice
import VOA.Moonshine.GenerationFock
import VOA.Moonshine.InvFormTP
import VOA.Moonshine.InvFormClosure
import VOA.Core.InvariantFormRadical
import VOA.Core.InvariantFormFHL2

/-!
# Lattice VOAs are simple and self-dual (C1)

For an even positive-definite lattice `L`, the lattice VOA `V_L = latticeVOAGen L hEven hPos`
is simple and self-dual.  Specialised to `L = √(2m) ℤ` this gives
`(V2m m hm).IsSimple` and `(V2m m hm).SelfDual`.

## Route

1. `latVOA_generated` — `V_L` is generated by the charge vectors `e^β` (`latChargeGen L β`):
   every subspace closed under all `n`-th products and containing every `e^β` is everything.
   This is the argument of `Moonshine/Generation.lean` (written there for `V_Λ^+`), which is
   simpler on `V_L` itself: no projection `½(1+θ)` is needed, so every mode of `e^a` is "safe".
   Leading-term extraction (`EEVec_expand`), Schur-polynomial interpolation
   (`mem_of_forall_sum_pow_smul_mem`, `schurPoly_coeff_one`) and `X_mem_span_vVar` give every
   oscillator, and creation words exhaust each Fock weight.
2. `latForm_fhlInv_latChargeGen` — FHL invariance of `Nondeg.latForm L` at `e^β`
   (`Nondeg.latForm_Yeαvec`, `L₁ e^β = 0`); `latForm_fhlInv` — for every homogeneous `u`, by
   the generator reduction `InvForm.fhlInv_of_generates`.
3. `latInvForm : InvariantForm (latticeVOAGen L hEven hPos)`, fully invariant and normalised
   (`(𝟙|𝟙) = 1`); its Virasoro adjointness is the `u = ω` slice, with `L₁ω = 0`
   (`L1_conformal_zero`, valid in every VOA).
4. `latInvForm_leftRadical` — the radical is `0` (`Nondeg.latForm_nondeg`).
5. `latticeVOAGen_isSimple` (Li: simple ⟺ zero radical, `isSimple_iff_leftRadical_eq_bot`),
   `latticeVOAGen_selfDual`, and the specialisations `V2m_isSimple`, `V2m_selfDual`.

The sign convention of `latForm` is `(p⊗e^α, q⊗e^β) = δ_{α+β,0} (−1)^{⟨α,α⟩/2} ε(α,α) F(p,q)`;
it is exactly the one making `e^β` contragredient-primary of weight `⟨β,β⟩/2`
(`Nondeg.latForm_Yeαvec`), so no rescaling is needed.

## Status
No `sorry`, no new axioms.  Unconditional: the only hypotheses are `L.Even`, `L.PosDef`
(resp. `1 ≤ m`).
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

open VOA VOA.IntegralLattice VOA.LatGen HeisenbergN VOA.Moonshine VOA.Moonshine.InvForm
open VOA.VertexOperatorAlgebra (InvariantForm)

section General

variable (L : IntegralLattice) (hEven : L.Even) (hPos : L.PosDef)

/-! ## §1  The vertex operator of `e^α` -/

theorem latVOA_Y_latChargeGen (α : L.carrier) :
    (latticeVOAGen L hEven hPos).Y (latChargeGen L α) = Yeαvec L α := by
  have hw := YfullGen_word L hEven hPos [] α
  rw [wordStateLatGen_nil, YwordLatGen_nil] at hw
  exact hw

theorem latVOA_smul_latChargeGen_state (a c : L.carrier) (n : ℤ) (q : FockN (rank L)) :
    (latticeVOAGen L hEven hPos).smul (latChargeGen L a) n (latStateGen L q c)
      = latticeCocycle L a c • latStateGen L (EEVec L a (-n - 1 - L.form a c) q) (a + c) := by
  rw [PreVertexAlgebra.smul_def, latVOA_Y_latChargeGen, mode_apply, Yeαvec_tmul]

theorem latStateGen_finsum {ι : Type*} (s : Finset ι) (f : ι → FockN (rank L))
    (γ : L.carrier) :
    latStateGen L (∑ i ∈ s, f i) γ = ∑ i ∈ s, latStateGen L (f i) γ := by
  simp only [latStateGen, TensorProduct.sum_tmul]

theorem latStateGen_csmul (c : ℂ) (p : FockN (rank L)) (γ : L.carrier) :
    latStateGen L (c • p) γ = c • latStateGen L p γ := by
  simp only [latStateGen, TensorProduct.smul_tmul']

/-! ## §2  Generation of `V_L` by the charge vectors `e^β` -/

section Induction

variable (S : Submodule ℂ (LatModuleGen L))
  (hS : ∀ u ∈ S, ∀ v ∈ S, ∀ n : ℤ, (latticeVOAGen L hEven hPos).smul u n v ∈ S)
  (hX : ∀ β : L.carrier, latChargeGen L β ∈ S)

include hS hX in
/-- Leading term: `S_d(a)·q ⊗ e^γ ∈ S` (`q` of weight `k`, `d + k = w`, `d ≥ 1`), given all lower
Fock weights. -/
theorem lat_mem_vSchur_mul (w : ℕ)
    (IH : ∀ w' < w, ∀ (c : L.carrier) (q : FockN (rank L)),
      q ∈ gradingWN (rank L) w' → latStateGen L q c ∈ S) :
    ∀ k : ℕ, ∀ d : ℕ, d + k = w → 1 ≤ d → ∀ γ a : L.carrier,
      ∀ q ∈ gradingWN (rank L) k, latStateGen L (vSchur L a d * q) γ ∈ S := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ihk =>
  intro d hdk hd γ a q hq
  set c := γ - a with hc
  set n : ℤ := -(d : ℤ) - 1 - L.form a c with hn
  have h1 := hS _ (hX a) _ (IH k (by omega) c q hq) n
  rw [latVOA_smul_latChargeGen_state, show -n - 1 - L.form a c = (d : ℤ) by omega,
    show a + c = γ by rw [hc]; abel, EEVec_expand L a hq d, latStateGen_finsum,
    Finset.sum_range_succ', aExpVec_zero, LinearMap.id_apply, add_zero, smul_add] at h1
  have hrest : latticeCocycle L a c • ∑ r ∈ Finset.range k,
      latStateGen L (vSchur L a (d + (r + 1)) * aExpVec L a (r + 1) q) γ ∈ S := by
    refine Submodule.smul_mem _ _ (Submodule.sum_mem _ fun r hr => ?_)
    simp only [Finset.mem_range] at hr
    have hq' : aExpVec L a (r + 1) q ∈ gradingWN (rank L) (k - (r + 1)) := by
      have := aExpVec_mem_gradingZN L a (r + 1) hq
      rwa [gradingZN_of_nonneg (by omega), show ((k : ℤ) - ((r + 1 : ℕ) : ℤ)).toNat = k - (r + 1)
        by omega] at this
    exact ihk (k - (r + 1)) (by omega) (d + (r + 1)) (by omega) (by omega) γ a _ hq'
  have h2 := Submodule.sub_mem _ h1 hrest
  rw [add_sub_cancel_left] at h2
  have hε : latticeCocycle L a c * latticeCocycle L a c = 1 := latticeCocycle_sq L a c
  have h3 := Submodule.smul_mem _ (latticeCocycle L a c) h2
  rwa [smul_smul, hε, one_smul] at h3

include hS hX in
/-- Every Fock weight is in `S`, in every charge sector. -/
theorem lat_mem_of_weight :
    ∀ w : ℕ, ∀ (c : L.carrier) (q : FockN (rank L)),
      q ∈ gradingWN (rank L) w → latStateGen L q c ∈ S := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w IH =>
  intro c q hq
  have hB := lat_mem_vSchur_mul L hEven hPos S hS hX w IH
  have hlin : ∀ p : FockN (rank L), p ∈ Submodule.span ℂ
      {p | ∃ l : List (ℕ × Fin (rank L)), wordWt l = w ∧ p = wordStateN l} →
      latStateGen L p c ∈ S := by
    intro p hp
    induction hp using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨l, hl, rfl⟩ := hx
      cases l with
      | nil => exact hX c
      | cons ia rest =>
        obtain ⟨m, b⟩ := ia
        rw [wordWt_cons] at hl
        have hrest := wordStateN_mem_gradingWN rest
        rw [wordStateN_cons]
        set φ : FockN (rank L) →ₗ[ℂ] LatModuleGen L :=
          ((TensorProduct.mk ℂ (FockN (rank L)) (L.carrier →₀ ℂ)).flip (eGen L c)).comp
            (LinearMap.mulRight ℂ (wordStateN rest)) with hφ
        have hφapp : ∀ p, φ p = latStateGen L (p * wordStateN rest) c := fun p => rfl
        have hspan := X_mem_span_vVar L hPos m b
        suffices hsub : Submodule.span ℂ (Set.range fun i : Fin (latRank L) =>
            vVar L (latticeBasis L i) m) ≤ S.comap φ by
          have := hsub hspan
          rwa [Submodule.mem_comap, hφapp] at this
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, Submodule.mem_comap, hφapp]
        set a₀ := latticeBasis L i
        set D := (schurPoly L a₀ (m + 1)).natDegree
        have hpoly := mem_of_forall_sum_pow_smul_mem (S.comap φ)
          (fun j => (schurPoly L a₀ (m + 1)).coeff j) D 0 (fun k _ => by
            rw [Submodule.mem_comap, ← vSchur_nsmul_eq_sum, hφapp]
            exact hB (wordWt rest) (m + 1) (by omega) (by omega) c (k • a₀) _ hrest)
        by_cases h1 : 1 ∈ Finset.range (D + 1)
        · have := hpoly 1 h1
          simp only [schurPoly_coeff_one] at this
          rw [Submodule.mem_comap, map_smul] at this
          have h2 := Submodule.smul_mem _ ((m : ℂ) + 1) this
          rw [smul_smul, mul_inv_cancel₀ (by exact_mod_cast Nat.succ_ne_zero m), one_smul,
            hφapp] at h2
          exact h2
        · have hD : D < 1 := by simpa using h1
          have hc1 := Polynomial.coeff_eq_zero_of_natDegree_lt (p := schurPoly L a₀ (m + 1))
            (n := 1) (by omega)
          rw [schurPoly_coeff_one] at hc1
          rcases smul_eq_zero.mp hc1 with h | h
          · exact absurd h (inv_ne_zero (by exact_mod_cast Nat.succ_ne_zero m))
          · dsimp only
            rw [h, zero_mul, latStateGen, TensorProduct.zero_tmul]; exact Submodule.zero_mem _
    | zero => rw [latStateGen, TensorProduct.zero_tmul]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [latStateGen_add_boson]; exact Submodule.add_mem _ hx hy
    | smul a x _ hx => rw [latStateGen_csmul]; exact Submodule.smul_mem _ _ hx
  exact hlin q (gradingWN_le_span_words _ w hq)

end Induction

/-- **`V_L` is generated by the charge vectors `e^β`**: a subspace closed under all `n`-th
products and containing every `e^β` (`β ∈ L`) is everything. -/
theorem latVOA_generated (S : Submodule ℂ (LatModuleGen L))
    (hS : ∀ u ∈ S, ∀ v ∈ S, ∀ n : ℤ, (latticeVOAGen L hEven hPos).smul u n v ∈ S)
    (hX : ∀ β : L.carrier, latChargeGen L β ∈ S) : S = ⊤ := by
  rw [eq_top_iff, ← wordStateLatGen_span L, Submodule.span_le]
  rintro _ ⟨⟨l, α⟩, rfl⟩
  rw [SetLike.mem_coe, Function.uncurry_apply_pair, wordStateLatGen_eq]
  exact lat_mem_of_weight L hEven hPos S hS hX (wordWt l) α (wordStateN l)
    (wordStateN_mem_gradingWN l)

/-! ## §3  Full invariance of `latForm` -/

/-- Distinct weight spaces of the adjoint module `V_L` are `latForm`-orthogonal. -/
theorem latForm_weightOrth :
    WeightOrth (adjointModule (latticeVOAGen L hEven hPos)) (Nondeg.latForm L) := by
  intro α β hαβ x hx y hy
  change x ∈ adjWeight (latticeVOAGen L hEven hPos) α at hx
  change y ∈ adjWeight (latticeVOAGen L hEven hPos) β at hy
  by_cases hα : ∃ m : ℤ, (m : ℂ) = α
  · by_cases hβ : ∃ m : ℤ, (m : ℂ) = β
    · obtain ⟨m, rfl⟩ := hα
      obtain ⟨k, rfl⟩ := hβ
      rw [adjWeight_cast] at hx hy
      have hmk : m ≠ k := fun h => hαβ (by rw [h])
      exact Nondeg.latForm_orth_grading L hmk hx hy
    · rw [adjWeight_eq_bot _ (not_exists.mp hβ), Submodule.mem_bot] at hy
      rw [hy, map_zero]
  · rw [adjWeight_eq_bot _ (not_exists.mp hα), Submodule.mem_bot] at hx
    rw [hx, map_zero, LinearMap.zero_apply]

theorem adj_mode_latChargeGen (β : L.carrier) (n : ℤ) (a : LatModuleGen L) :
    mode ((adjointModule (latticeVOAGen L hEven hPos)).YM (latChargeGen L β)) n a
      = mode (Yeαvec L β) n a := by
  change (latticeVOAGen L hEven hPos).smul (latChargeGen L β) n a = _
  rw [PreVertexAlgebra.smul_def, latVOA_Y_latChargeGen]

/-- FHL invariance of `latForm` at the generators `e^β`. -/
theorem latForm_fhlInv_latChargeGen (β : L.carrier) :
    FHLInv (adjointModule (latticeVOAGen L hEven hPos)) (Nondeg.latForm L)
      (LatGen.halfNorm L β) (latChargeGen L β) := by
  intro n a b
  rw [Finset.sum_eq_single 0]
  · rw [pow_zero, Module.End.one_apply, Nat.factorial_zero, Nat.cast_one, inv_one, one_smul,
      Nat.cast_zero, sub_zero, smul_eq_mul, adj_mode_latChargeGen, adj_mode_latChargeGen,
      Nondeg.latForm_Yeαvec L hEven]
  · intro j _ hj
    obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj
    rw [pow_succ, Module.End.mul_apply, InvForm.L_one_latChargeGen L hEven hPos, map_zero,
      map_zero, mode_zero, LinearMap.zero_apply, map_zero, smul_zero]
  · intro h; exact absurd (Finset.mem_range.mpr (by omega)) h

/-- **Full FHL invariance of `latForm`** for every homogeneous `u ∈ V_L`. -/
theorem latForm_fhlInv {wt : ℤ} {u : LatModuleGen L}
    (hu : u ∈ (latticeVOAGen L hEven hPos).grading wt) :
    FHLInv (adjointModule (latticeVOAGen L hEven hPos)) (Nondeg.latForm L) wt u :=
  fhlInv_of_generates (latForm_weightOrth L hEven hPos) (Set.range (latChargeGen L))
    (fun S _ h1 hG => latVOA_generated L hEven hPos S h1 (fun β => hG ⟨β, rfl⟩))
    (by
      rintro _ ⟨β, rfl⟩
      exact ⟨_, latChargeGen_mem_grading L β, latForm_fhlInv_latChargeGen L hEven hPos β⟩) hu

/-! ## §4  The invariant form -/

/-- `latForm` as an `InvariantForm` of `V_L`. -/
noncomputable def latInvForm : InvariantForm (latticeVOAGen L hEven hPos) where
  form := Nondeg.latForm L
  virasoro_adj := by
    intro n a b
    have h := latForm_fhlInv L hEven hPos (latticeVOAGen L hEven hPos).conformal_mem (n + 1) a b
    rw [Finset.sum_eq_single 0] at h
    · rw [VertexOperatorAlgebra.L_def, VertexOperatorAlgebra.L_def]
      refine h.trans ?_
      rw [pow_zero, Module.End.one_apply, Nat.factorial_zero, Nat.cast_one, inv_one,
        one_smul, Nat.cast_zero, sub_zero, show (2 : ℤ) * 2 - (n + 1) - 2 = -n + 1 by ring]
      norm_num
      rfl
    · intro j _ hj
      obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj
      rw [pow_succ, Module.End.mul_apply, L1_conformal_zero, map_zero, map_zero, mode_zero,
        LinearMap.zero_apply, map_zero, smul_zero]
    · intro h; exact absurd (Finset.mem_range.mpr (by norm_num)) h

theorem latInvForm_form : (latInvForm L hEven hPos).form = Nondeg.latForm L := rfl

theorem latInvForm_isFullyInvariant : (latInvForm L hEven hPos).IsFullyInvariant :=
  fun _ _ hu n a b => latForm_fhlInv L hEven hPos hu n a b

theorem latInvForm_normalized : (latInvForm L hEven hPos).Normalized := by
  change Nondeg.latForm L (latVacuumGen L) (latVacuumGen L) = 1
  rw [latVacuumGen, Nondeg.latForm_state, add_zero, if_pos rfl, Nondeg.chSign_zero, one_mul,
    HeisenbergN.vacuumN, Nondeg.uForm_one, MvPolynomial.coeff_zero_one]

/-- The radical of `latInvForm` is `0` (`latForm_nondeg`). -/
theorem latInvForm_leftRadical : InvariantForm.leftRadical (latInvForm L hEven hPos) = ⊥ := by
  rw [eq_bot_iff]
  intro x hx
  rw [InvariantForm.mem_leftRadical] at hx
  rw [Submodule.mem_bot]
  by_contra h0
  obtain ⟨y, hy⟩ := Nondeg.latForm_nondeg L x h0
  apply hy
  have h := DFunLike.congr_fun hx y
  rw [LinearMap.zero_apply] at h
  exact h

/-! ## §5  Simplicity and self-duality -/

/-- **Every even positive-definite lattice VOA is simple.** -/
theorem latticeVOAGen_isSimple : (latticeVOAGen L hEven hPos).IsSimple :=
  (LiRadical.isSimple_iff_leftRadical_eq_bot (latInvForm_isFullyInvariant L hEven hPos)
    (latInvForm_normalized L hEven hPos)).mpr (latInvForm_leftRadical L hEven hPos)

/-- **Every even positive-definite lattice VOA is self-dual.** -/
theorem latticeVOAGen_selfDual : (latticeVOAGen L hEven hPos).SelfDual :=
  ⟨latInvForm L hEven hPos, latInvForm_isFullyInvariant L hEven hPos,
    latInvForm_leftRadical L hEven hPos⟩

end General

/-! ## §6  The rank-one case `V_{2m}` -/

/-- **C1 (simplicity)**: `V_{2m}` is simple. -/
theorem V2m_isSimple (m : ℕ) (hm : 1 ≤ m) : (V2m m hm).IsSimple :=
  latticeVOAGen_isSimple _ _ _

/-- **C1 (self-duality)**: `V_{2m}` is self-dual. -/
theorem V2m_selfDual (m : ℕ) (hm : 1 ≤ m) : (V2m m hm).SelfDual :=
  latticeVOAGen_selfDual _ _ _

end VOA.Classification.COne
