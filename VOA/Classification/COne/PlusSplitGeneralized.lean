import VOA.Classification.COne.PlusFiniteLengthCyclic

/-!
# The remaining splitting problem on generalized conformal generators

Finite length is unconditional. To prove complete reducibility, it is enough
to split the two-step subquotients of cyclic modules generated by a generalized
conformal eigenvector. Local finiteness of L(0) removes all other generators.

The residual below is true by Abe's rationality theorem, but is NOT proved here.
It still quantifies over arbitrary mode submodules, including ungraded ones.
Equal-weight and integrally resonant extensions are retained; neither the
numerical lowest-weight list nor ordinary simple factors force them to split.
-/

set_option maxSynthPendingDepth 3

namespace VOA.Classification.COne.PlusSplitting

open PlusRational PlusFiniteLength ABDWeakAdmissible
open VOA.Huang.LogRemovalAdmissible

universe u
variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
  {W : VertexOperatorAlgebra 𝒱} {M : Type u} [AddCommGroup M] [Module ℂ M]

/-- It suffices to split two-step subquotients on generalized conformal
cyclic generators. All weak submodules remain in the conclusion. -/
theorem semisimple_of_generalized_cyclic_splitting (hC2 : C2Cofinite W)
    (A : WeakModule W M)
    (hs : ∀ (α : ℂ) (x : M), x ∈ (L0 A).maxGenEigenspace α →
      TwoStepSplitting (Submodule (modeAlg A) (cyclic A x))) :
    IsSemisimpleModule (modeAlg A) M := by
  let I := {p : ℂ × M // p.2 ∈ (L0 A).maxGenEigenspace p.1}
  let p : I → Submodule (modeAlg A) M := fun i => cyclic A i.val.2
  have hp : ∀ i, IsSemisimpleModule (modeAlg A) (p i) := fun i =>
    isSemisimpleModule_of_finiteLength_twoStepSplitting
      (cyclicFiniteLength_of_c2Cofinite hC2 A i.val.2) (hs i.val.1 i.val.2 i.property)
  apply isSemisimpleModule_of_isSemisimpleModule_submodule' hp
  apply top_unique
  have hle : (⊤ : Submodule ℂ M) ≤ (⨆ i, p i).restrictScalars ℂ := by
    rw [← weak_spectral_decomposition A (weakL0LocallyFinite hC2 A)]
    apply iSup_le
    intro α x hx
    exact Submodule.mem_iSup_of_mem (⟨(α, x), hx⟩ : I)
      (Submodule.mem_span_singleton_self x)
  exact hle

end VOA.Classification.COne.PlusSplitting

namespace VOA.Classification.COne

open PlusRational PlusFiniteLength PlusSplitting
open VOA.Huang.LogRemovalAdmissible

/-- OPEN: two-step splitting restricted to generalized conformal cyclic
seeds. This is a true, narrower instance of F2, not an assumed theorem. -/
def V2mPlusGeneralizedGeneratorSplittingFactGe2 : Prop :=
  ∀ (m : ℕ) (hm : 1 ≤ m), 2 ≤ m →
    ∀ {M : Type} [AddCommGroup M] [Module ℂ M]
      (N : AdmissibleModule (V2mPlus m hm) M) (α : ℂ) (x : M),
      x ∈ (L0 N.toWeakModule).maxGenEigenspace α →
      TwoStepSplitting (Submodule (modeAlg N.toWeakModule) (cyclic N.toWeakModule x))

/-- Exact equivalence: restricting the generators loses none of F2. -/
theorem v2mPlusTwoStepSplittingFactGe2_iff_generalizedGeneratorSplitting :
    V2mPlusTwoStepSplittingFactGe2 ↔ V2mPlusGeneralizedGeneratorSplittingFactGe2 := by
  constructor
  · intro h m hm hm2 M _ _ N _ x _
    exact h m hm hm2 N x
  · intro h m hm hm2 M _ _ N x
    letI := semisimple_of_generalized_cyclic_splitting (V2mPlus_c2Cofinite m hm)
      N.toWeakModule (h m hm hm2 N)
    exact twoStepSplitting_of_complementedLattice

/-- The unproved splitting input is precisely the remaining rationality input. -/
theorem v2mPlusRationalFactGe2_iff_generalizedGeneratorSplitting :
    V2mPlusRationalFactGe2 ↔ V2mPlusGeneralizedGeneratorSplittingFactGe2 := by
  rw [v2mPlusRationalFactGe2_iff_twoStepSplitting,
    v2mPlusTwoStepSplittingFactGe2_iff_generalizedGeneratorSplitting]

/-- The plus converse from the narrower, explicitly open splitting problem. -/
theorem nice_of_hasCOneLabel_plus_of_generalizedGeneratorSplitting
    (hs : V2mPlusGeneralizedGeneratorSplittingFactGe2)
    {𝒱 : Type} [AddCommGroup 𝒱] [Module ℂ 𝒱]
    (V : VertexOperatorAlgebra 𝒱) (m : ℕ) (h : HasCOneLabel V (.plus m)) :
    Nice V ∧ V.centralCharge = 1 :=
  nice_of_hasCOneLabel_plus_of_twoStepSplitting
    (v2mPlusTwoStepSplittingFactGe2_iff_generalizedGeneratorSplitting.mpr hs) V m h

end VOA.Classification.COne
