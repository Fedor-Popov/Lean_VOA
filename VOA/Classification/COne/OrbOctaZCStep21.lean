-- One row is added, and all equal mode indices are merged.
theorem step44_check :
    equalRelCheck (scaleRel weight_high36 high36 ++ partial43)
      partial44 = true := by decide +kernel

theorem partial44_holds : evalRel W selfMode partial44 = 0 := by
  have h := equalRelCheck_sound W selfMode step44_check
  rw [evalRel_append, evalRel_scale, high36_holds, map_zero, partial43_holds,
    add_zero] at h
  exact h.symm

