import VOA.Classification.COne.PlusFiniteLengthTransfer

/-!
# Finite length for cyclic weak modules over C₂-cofinite VOAs

Induct on the Jordan order of a generalized conformal generator. Its next
Jordan vector generates a submodule of smaller order; the quotient is generated
by an eigenvector and hence is ordinary. Conformal local finiteness then
removes the generalized-eigenvector restriction.
-/

set_option maxSynthPendingDepth 3

namespace VOA.Classification.COne.PlusFiniteLength

open PlusRational FiniteLengthAlgebra ABDWeakAdmissible
open VOA.Huang.LogRemovalAdmissible

universe u
variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
  {W : VertexOperatorAlgebra 𝒱}

set_option maxHeartbeats 800000 in
-- Comparing the restricted and quotient mode actions makes this induction expensive to elaborate.
/-- A weak module generated by a generalized conformal eigenvector has finite length. -/
theorem finiteLength_of_generalized_cyclic (hC2 : C2Cofinite W) (k : ℕ)
    {M : Type u} [AddCommGroup M] [Module ℂ M]
    (A : WeakModule W M) (x : M) (α : ℂ)
    (hx : ((L0 A - α • 1) ^ k) x = 0) (hcyc : cyclic A x = ⊤) :
    IsFiniteLength (modeAlg A) M := by
  induction k generalizing M with
  | zero =>
    have hx0 : x = 0 := hx
    have ht : (⊤ : Submodule (modeAlg A) M) = ⊥ := by
      rw [← hcyc, hx0]
      exact Submodule.span_zero_singleton _
    haveI : Subsingleton M := by
      refine ⟨fun y z => ?_⟩
      have hy : y = 0 := by
        have hm : y ∈ (⊥ : Submodule (modeAlg A) M) := ht ▸ Submodule.mem_top
        exact hm
      have hz : z = 0 := by
        have hm : z ∈ (⊥ : Submodule (modeAlg A) M) := ht ▸ Submodule.mem_top
        exact hm
      exact hy.trans hz.symm
    exact IsFiniteLength.of_subsingleton
  | succ k ih =>
    let y := (L0 A - α • 1) x
    let P := cyclic A y
    let B : WeakModule W P := WeakModule.submodule A (ofR A P)
    let z : P := ⟨y, Submodule.mem_span_singleton_self y⟩
    have hz : ((L0 B - α • 1) ^ k) z = 0 := by
      apply Subtype.ext
      have hp : ∀ j : ℕ, ∀ v : P,
          (((L0 B - α • 1) ^ j) v : M) = ((L0 A - α • 1) ^ j) (v : M) := by
        intro j
        induction j with
        | zero => intro v; rfl
        | succ j hj =>
          intro v
          rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply]
          change L0 A _ - α • _ = _
          simp only [Module.End.one_apply, hj]
          rfl
      rw [hp]
      simpa only [pow_succ, Module.End.mul_apply] using hx
    have hP : IsFiniteLength (modeAlg A) P :=
      finiteLength_submodule_of_restricted A P
        (ih B z hz (cyclic_restriction_eq_top A y))
    let C : WeakModule W (M ⧸ P) := WeakModule.quotient A (ofR A P)
    let qx : M ⧸ P := Submodule.Quotient.mk x
    have hq : L0 C qx = α • qx := by
      change Submodule.Quotient.mk (L0 A x) = α • (Submodule.Quotient.mk x : M ⧸ P)
      apply sub_eq_zero.mp
      change Submodule.Quotient.mk (L0 A x - α • x) = (0 : M ⧸ P)
      apply (Submodule.Quotient.mk_eq_zero P).mpr
      exact Submodule.mem_span_singleton_self y
    have hqcyc : cyclic C qx = ⊤ :=
      cyclic_eq_top_of_surjective_hom A C (WeakModule.quotientMk A (ofR A P))
        P.mkQ_surjective x hcyc
    obtain ⟨O, hO, _, _⟩ := eigen_cyclic_isOrdinary hC2 C qx α hq hqcyc
    have hC : IsFiniteLength (modeAlg A) (M ⧸ P) := by
      apply finiteLength_quotient_of_descended A P
      change IsFiniteLength (modeAlg C) (M ⧸ P)
      rw [← hO]
      exact ordinaryFiniteLength_of_c2Cofinite hC2 O
    obtain ⟨hPN, hPA⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp hP
    obtain ⟨hCN, hCA⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp hC
    exact isFiniteLength_iff_isNoetherian_isArtinian.mpr
      ⟨(isNoetherian_iff_submodule_quotient P).mpr ⟨hPN, hCN⟩,
        (isArtinian_iff_submodule_quotient P).mpr ⟨hPA, hCA⟩⟩

/-- The cyclic submodule of a generalized conformal vector has finite length,
measured over the ambient mode algebra. -/
theorem cyclicFiniteLength_of_mem_maxGenEigenspace (hC2 : C2Cofinite W)
    {M : Type u} [AddCommGroup M] [Module ℂ M]
    (A : WeakModule W M) (x : M) (α : ℂ)
    (hx : x ∈ (L0 A).maxGenEigenspace α) :
    IsFiniteLength (modeAlg A) (cyclic A x) := by
  obtain ⟨k, hk⟩ := Module.End.mem_genEigenspace_top.mp hx
  let P := cyclic A x
  let B : WeakModule W P := WeakModule.submodule A (ofR A P)
  let z : P := ⟨x, Submodule.mem_span_singleton_self x⟩
  apply finiteLength_submodule_of_restricted A P
  apply finiteLength_of_generalized_cyclic hC2 k B z α _ (cyclic_restriction_eq_top A x)
  apply Subtype.ext
  have hp : ∀ j : ℕ, ∀ v : P,
      (((L0 B - α • 1) ^ j) v : M) = ((L0 A - α • 1) ^ j) (v : M) := by
    intro j
    induction j with
    | zero => intro v; rfl
    | succ j hj =>
      intro v
      rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply]
      change L0 A _ - α • _ = _
      simp only [Module.End.one_apply, hj]
      rfl
  rw [hp]
  exact hk

/-- Every cyclic weak module over a C₂-cofinite VOA has finite composition
length. The generator is arbitrary and no admissible grading is required. -/
theorem cyclicFiniteLength_of_c2Cofinite (hC2 : C2Cofinite W)
    {M : Type u} [AddCommGroup M] [Module ℂ M]
    (A : WeakModule W M) (x : M) :
    IsFiniteLength (modeAlg A) (cyclic A x) := by
  let F := finiteLengthVectors (modeAlg A) M
  have htop : (⊤ : Submodule ℂ M) ≤ F.restrictScalars ℂ := by
    rw [← weak_spectral_decomposition A (weakL0LocallyFinite hC2 A)]
    exact iSup_le fun α y hy => cyclicFiniteLength_of_mem_maxGenEigenspace hC2 A y α hy
  exact htop (Submodule.mem_top : x ∈ (⊤ : Submodule ℂ M))

/-- The same conclusion for every finitely generated weak submodule. -/
theorem finiteLength_fg_of_c2Cofinite (hC2 : C2Cofinite W)
    {M : Type u} [AddCommGroup M] [Module ℂ M]
    (A : WeakModule W M) (P : Submodule (modeAlg A) M) (hP : P.FG) :
    IsFiniteLength (modeAlg A) P :=
  finiteLength_of_fg_of_le_finiteLengthVectors P hP
    (fun x _ => cyclicFiniteLength_of_c2Cofinite hC2 A x)

end VOA.Classification.COne.PlusFiniteLength

namespace VOA.Classification.COne

open PlusFiniteLength PlusRational

/-- F1, unconditionally: cyclic admissible `V_{2m}⁺` modules have finite length. -/
theorem V2mPlus_cyclicFiniteLengthFactGe2 : V2mPlusCyclicFiniteLengthFactGe2 := by
  intro m hm _ M _ _ N x
  exact cyclicFiniteLength_of_c2Cofinite (V2mPlus_c2Cofinite m hm) N.toWeakModule x

/-- After F1, precisely two-step splitting remains in the rationality reduction. -/
theorem v2mPlusRationalFactGe2_iff_twoStepSplitting :
    V2mPlusRationalFactGe2 ↔ V2mPlusTwoStepSplittingFactGe2 := by
  rw [v2mPlusRationalFactGe2_iff_finiteLength_twoStepSplitting]
  exact ⟨And.right, fun h => ⟨V2mPlus_cyclicFiniteLengthFactGe2, h⟩⟩

/-- The plus converse requires only the two-step splitting input. -/
theorem nice_of_hasCOneLabel_plus_of_twoStepSplitting
    (hs : V2mPlusTwoStepSplittingFactGe2)
    {𝒱 : Type} [AddCommGroup 𝒱] [Module ℂ 𝒱]
    (V : VertexOperatorAlgebra 𝒱) (m : ℕ) (h : HasCOneLabel V (.plus m)) :
    Nice V ∧ V.centralCharge = 1 :=
  nice_of_hasCOneLabel_plus_of_finiteLength_twoStepSplitting
    V2mPlus_cyclicFiniteLengthFactGe2 hs V m h

end VOA.Classification.COne

