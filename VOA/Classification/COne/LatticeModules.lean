import VOA.Classification.COne.LatticeSimple
import VOA.Moonshine.LatticeMorph
import VOA.Modules.WeakModule

/-!
# The modules `V_{L+λ}` of a rank-one lattice VOA

For `L = √(2m)ℤ = latP m` and every `j ∈ ℤ` we construct the `V_{2m}`-module `V_{L+λ_j}`,
`λ_j = j/(2m)·α`, as an ordinary `ℂ`-graded module

  `latticeModule m hm j : OrdVModule (V2m m hm) (LatModuleGen (latP m))`,

with `L₀ (p ⊗ e^{nα}) = (w + (2mn+j)²/(4m)) (p ⊗ e^{nα})` for `p` of boson weight `w`
(`latticeModule_L0`), lowest weight `h_j = j²/(4m)` for `|j| ≤ m` (`latticeModule_vacuum_mem`,
`latticeModule_lowestWeight`), and `Y(e^{kα},z)` acting by the boson dressing shifted by
`z^{2mkn + jk}` (`latticeModule_latChargeGen`).

## Route: realise `V_{L+λ}` inside a bigger lattice VOA

Rather than re-running the whole reconstruction/locality machinery for a coset-valued charge (the
route of the `θ`-twisted module, ~6000 lines), we **embed** the module into an honest lattice VOA:

* the **gluing lattice** `N = N_{m,j} = ℤα ⊕ ℤδ` with Gram matrix `[[2m, j], [j, 2(j²+1)]]`
  (`glueLat`): even, positive definite, containing `L = ℤα` isometrically (`glueIota`), and with
  `⟨α,δ⟩ = j`, so the orthogonal projection of `δ` to `ℝα` is exactly `λ_j`;
* the VOA homomorphism `Φ = latMorph : V_L → V_N` (`Moonshine/LatticeMorph`, valid for isometries
  of *any* ranks);
* the **shifted embedding** `Ψ_δ : V_L → V_N`, `p ⊗ e^γ ↦ φ(p) ⊗ e^{ιγ+δ}` (`shiftEmb`), with an
  explicit left inverse (`shiftEmbInv`).

The image of `Ψ_δ` is invariant under every `Y_N(Φu,z)` (`invSub_eq_top`): the set of such `u` is
a subspace closed under all `n`-th products (the Borcherds identity in `V_N` with `m = 0`) and
containing every `e^β` (explicit: `fockMap_EEVec`), so it is all of `V_L` by the generation
theorem `latVOA_generated` (C1).  Then `Y_M(u,z) := Ψ_δ⁻¹ Y_N(Φu,z) Ψ_δ` is a weak module, the
Jacobi identity being *transported* from `V_N` (`transportWeakModule`, a general lemma: a VOA hom
plus an injective map with invariant image gives a weak module).

The grading is computed explicitly: `Y_M(ω_L,z)` is intertwined by `Ψ_δ` with the shifted Sugawara
field `½∑_a :α'_a α'_a:`, `α'_a(z) = α_a(z) + λ_a z⁻¹` (`shiftEmb_sugShift`), whose `L₀` on
`p ⊗ e^γ` is `w + ½|γ+λ|²` (`shiftWeakModule_L0_latStateGen`).  The weight spaces are sums of the
bigraded pieces `Fock_w ⊗ e^γ` (`shiftWeightSpace`), finite-dimensional because the weight
fibers are finite (`shiftFiber_rankOne_finite`).

Sections §1–§7 are for general even positive-definite `K ↪ N` and `δ ∈ N` (the general
`V_{K+λ}`, `λ = proj δ`, for every `λ` arising as such a projection); only the
finiteness/boundedness inputs of `shiftOrdModule` and the weight formula are specialised to rank
one in §9.

## Main declarations
* `transportWeakModule` — weak module by transport along a VOA hom and an injective map.
* `invSub_eq_top` — invariance of `im Ψ_δ`.
* `shiftWeakModule`, `shiftWeakModule_latChargeGen`, `shiftWeakModule_L0_latStateGen`.
* `shiftOrdModule` — the `OrdVModule`, given finite weight fibers and a lower bound.
* `glueLat`, `glueLat_even`, `glueLat_posDef`, `glueIota_isometry`, `glueIota_delta`.
* `latticeModule`, `latticeModule_L0`, `latticeModule_latChargeGen`,
  `latticeModule_vacuum_mem`, `latticeModule_weight_ne_bot`, `latticeModule_lowestWeight`.

## Not done here (remaining plan for C4)
1. **Irreducibility** of `latticeModule m hm j`: the module is generated by `e^{λ}`-states and the
   Heisenberg part is irreducible on each `Fock ⊗ e^{γ+λ}`; the cleanest route reuses the
   leading-term/Schur interpolation of `LatticeSimple.lat_mem_of_weight` (every submodule
   containing a nonzero vector contains some `𝟙 ⊗ e^{γ}` — via the Heisenberg vacuum argument —
   and then all of `M` since `e^β_{(k)}` moves between charge sectors invertibly).
2. **Dependence only on `j mod 2m`**: `latticeModule m hm (j + 2m) ≅ latticeModule m hm j` via the
   relabelling `e^{nα} ↦ e^{(n+1)α}` (needs comparing the two gluing lattices, or a single gluing
   lattice for all `j`).
3. **Pairwise non-isomorphism** for `j = 0,…,2m-1`: distinct lowest weights `j²/(4m)` separate
   `j ≤ m`; `j` and `2m-j` need the `L`-charge (`α(0)` eigenvalues `(n + j/2m)·2m`).
4. **Completeness** (every irreducible `V_{2m}`-module is one of these) is the rationality
   statement **C3** (Dong; Dong–Li–Mason) and is not attempted.

## Status
No `sorry`, no new axioms.  Unconditional: the only hypothesis is `1 ≤ m`.
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne.LatMod

open VOA VOA.IntegralLattice VOA.LatGen HeisenbergN
open Module (End)
open scoped TensorProduct BigOperators Matrix

/-! ## §1  Transport of a module structure along an injective map -/

section Transport

variable {𝒱 𝒱' M : Type*} [AddCommGroup 𝒱] [Module ℂ 𝒱] [AddCommGroup 𝒱'] [Module ℂ 𝒱']
  [AddCommGroup M] [Module ℂ M]

theorem map_finsum_of_injective (Ψ : M →ₗ[ℂ] 𝒱') (hΨ : Function.Injective Ψ) (f : ℤ → M) :
    Ψ (∑ᶠ i, f i) = ∑ᶠ i, Ψ (f i) := by
  by_cases hf : (Function.support f).Finite
  · exact map_finsum Ψ hf
  · have hsupp : Function.support (fun i => Ψ (f i)) = Function.support f := by
      ext i
      simp only [Function.mem_support, ne_eq]
      exact not_congr ((map_eq_zero_iff Ψ hΨ))
    have hf' : ¬ (Function.support (fun i => Ψ (f i))).Finite := by rwa [hsupp]
    rw [finsum_of_infinite_support hf, finsum_of_infinite_support hf', map_zero]

variable (W : VertexOperatorAlgebra 𝒱) (W' : VertexOperatorAlgebra 𝒱')

/-- The transported vertex operator `Y_M(u,z) = Ψ' ∘ Y'(Φu,z) ∘ Ψ`. -/
noncomputable def transportY (Φ : 𝒱 →ₗ[ℂ] 𝒱') (Ψ : M →ₗ[ℂ] 𝒱') (Ψ' : 𝒱' →ₗ[ℂ] M) :
    𝒱 →ₗ[ℂ] (End ℂ M)⟦z^±⟧ where
  toFun u := fun t => Ψ' ∘ₗ (W'.Y (Φ u) t) ∘ₗ Ψ
  map_add' u v := by
    funext t
    refine LinearMap.ext fun x => ?_
    simp only [map_add, LinearMap.comp_apply]
    change Ψ' ((W'.Y (Φ u) t + W'.Y (Φ v) t) (Ψ x)) = Ψ' (W'.Y (Φ u) t (Ψ x)) + Ψ' (W'.Y (Φ v) t (Ψ x))
    rw [LinearMap.add_apply, map_add]
  map_smul' c u := by
    funext t
    refine LinearMap.ext fun x => ?_
    simp only [map_smul, LinearMap.comp_apply, RingHom.id_apply]
    change Ψ' ((c • W'.Y (Φ u) t) (Ψ x)) = c • Ψ' (W'.Y (Φ u) t (Ψ x))
    rw [LinearMap.smul_apply, map_smul]

theorem transportY_apply (Φ : 𝒱 →ₗ[ℂ] 𝒱') (Ψ : M →ₗ[ℂ] 𝒱') (Ψ' : 𝒱' →ₗ[ℂ] M) (u : 𝒱) (t : ℤ)
    (x : M) : transportY W' Φ Ψ Ψ' u t x = Ψ' (W'.Y (Φ u) t (Ψ x)) := rfl

variable {W W'} {Φ : 𝒱 →ₗ[ℂ] 𝒱'} (hΦ : IsVOAHom W W' Φ) {Ψ : M →ₗ[ℂ] 𝒱'} {Ψ' : 𝒱' →ₗ[ℂ] M}
  (hΨ : ∀ x, Ψ' (Ψ x) = x)
  (hInv : ∀ (u : 𝒱) (t : ℤ) (x : M), ∃ y : M, Ψ y = W'.Y (Φ u) t (Ψ x))

include hΨ in
theorem injective_of_leftInverse : Function.Injective Ψ :=
  Function.LeftInverse.injective hΨ

include hΨ hInv in
/-- The transported operator intertwines: `Ψ ∘ Y_M(u,z) = Y'(Φu,z) ∘ Ψ`. -/
theorem transportY_intertw (u : 𝒱) (t : ℤ) (x : M) :
    Ψ (transportY W' Φ Ψ Ψ' u t x) = W'.Y (Φ u) t (Ψ x) := by
  obtain ⟨y, hy⟩ := hInv u t x
  rw [transportY_apply, ← hy, hΨ]

include hΨ hInv in
theorem transportY_mode_intertw (u : 𝒱) (n : ℤ) (x : M) :
    Ψ (mode (transportY W' Φ Ψ Ψ' u) n x) = W'.smul (Φ u) n (Ψ x) := by
  rw [mode_apply, transportY_intertw hΨ hInv, PreVertexAlgebra.smul_def, mode_apply]

include hΦ hΨ hInv in
/-- **The transported weak module.** -/
noncomputable def transportWeakModule : WeakModule W M where
  YM := transportY W' Φ Ψ Ψ'
  vacuum_YM := by
    funext t
    refine LinearMap.ext fun x => ?_
    apply injective_of_leftInverse hΨ
    rw [transportY_intertw hΨ hInv, hΦ.map_vacuum, W'.vacuum_Y]
    change (if t = 0 then (1 : End ℂ 𝒱') else 0) (Ψ x) = Ψ ((if t = 0 then (1 : End ℂ M) else 0) x)
    split_ifs <;> simp
  truncation := by
    intro u x
    obtain ⟨N, hN⟩ := W'.regularity (Φ u) (Ψ x)
    refine ⟨N, fun n hn => ?_⟩
    apply injective_of_leftInverse hΨ
    rw [transportY_mode_intertw hΨ hInv, map_zero, PreVertexAlgebra.smul_def]
    exact hN n hn
  jacobi := by
    intro u v x ℓ m n
    apply injective_of_leftInverse hΨ
    rw [map_finsum_of_injective Ψ (injective_of_leftInverse hΨ),
      map_finsum_of_injective Ψ (injective_of_leftInverse hΨ)]
    have h := W'.jacobi (Φ u) (Φ v) (Ψ x) ℓ m n
    convert h using 3 with i i
    · rw [map_smul, map_sub, map_smul, transportY_mode_intertw hΨ hInv,
        transportY_mode_intertw hΨ hInv, transportY_mode_intertw hΨ hInv,
        transportY_mode_intertw hΨ hInv]
    · rw [map_smul, transportY_mode_intertw hΨ hInv, hΦ.map_smul]

end Transport

/-! ## §2  The shifted embedding `Ψ_δ : V_K → V_N`, `p ⊗ e^γ ↦ φ(p) ⊗ e^{ιγ+δ}` -/

section Shift

variable (K N : IntegralLattice.{0}) (ι : K.carrier →ₗ[ℤ] N.carrier) (δ : N.carrier)

/-- The momentum part of `Ψ_δ`: `e^γ ↦ e^{ιγ+δ}`. -/
noncomputable def momShift : (K.carrier →₀ ℂ) →ₗ[ℂ] (N.carrier →₀ ℂ) :=
  Finsupp.linearCombination ℂ (fun γ => eGen N (ι γ + δ))

/-- **The shifted embedding** `Ψ_δ(p ⊗ e^γ) = φ(p) ⊗ e^{ιγ+δ}`. -/
noncomputable def shiftEmb : LatModuleGen K →ₗ[ℂ] LatModuleGen N :=
  TensorProduct.map (fockMap (oscMatrix K N ι)).toLinearMap (momShift K N ι δ)

theorem shiftEmb_latStateGen (p : FockN (rank K)) (γ : K.carrier) :
    shiftEmb K N ι δ (latStateGen K p γ)
      = latStateGen N (fockMap (oscMatrix K N ι) p) (ι γ + δ) := by
  rw [shiftEmb, latStateGen, TensorProduct.map_tmul, momShift, eGen,
    Finsupp.linearCombination_single, one_smul]
  rfl

open Classical in
/-- The momentum part of the left inverse: `e^η ↦ e^γ` if `η = ιγ+δ`, else `0`. -/
noncomputable def momShiftInv : (N.carrier →₀ ℂ) →ₗ[ℂ] (K.carrier →₀ ℂ) :=
  Finsupp.linearCombination ℂ
    (fun η => if h : ∃ γ, ι γ + δ = η then eGen K h.choose else 0)

/-- The left inverse of `Ψ_δ`. -/
noncomputable def shiftEmbInv : LatModuleGen N →ₗ[ℂ] LatModuleGen K :=
  TensorProduct.map (fockMap (oscMatrix K N ι)ᵀ).toLinearMap (momShiftInv K N ι δ)

variable (hK : K.PosDef) (hN : N.PosDef) (hι : ∀ α β, N.form (ι α) (ι β) = K.form α β)

include hK hN hι in
theorem shiftEmbInv_shiftEmb (x : LatModuleGen K) :
    shiftEmbInv K N ι δ (shiftEmb K N ι δ x) = x := by
  have h : (shiftEmbInv K N ι δ) ∘ₗ (shiftEmb K N ι δ) = LinearMap.id := by
    refine LinearMap.ext_on_range (latStateGen_span K) fun q => ?_
    obtain ⟨p, γ⟩ := q
    simp only [LinearMap.comp_apply, LinearMap.id_apply]
    rw [shiftEmb_latStateGen, shiftEmbInv, latStateGen, TensorProduct.map_tmul, momShiftInv, eGen,
      Finsupp.linearCombination_single, one_smul]
    have hex : ∃ γ', ι γ' + δ = ι γ + δ := ⟨γ, rfl⟩
    rw [dif_pos hex]
    have hch : hex.choose = γ := by
      have := hex.choose_spec
      exact isometry_injective K N ι hK hι (add_right_cancel this)
    rw [hch]
    simp only [AlgHom.toLinearMap_apply]
    rw [fockMap_comp, oscMatrix_transpose_mul K N hK hN ι hι, fockMap_id]
    rfl
  exact LinearMap.congr_fun h x

end Shift

/-! ## §3  Invariance of the image of `Ψ_δ` under `Y_N(Φ u)` -/

section Invariance

variable (K N : IntegralLattice.{0}) (ι : K.carrier →ₗ[ℤ] N.carrier) (δ : N.carrier)
  (hKe : K.Even) (hK : K.PosDef) (hNe : N.Even) (hN : N.PosDef)
  (hι : ∀ α β, N.form (ι α) (ι β) = K.form α β)

theorem finsum_mem_submodule {M : Type*} [AddCommGroup M] [Module ℂ M] (S : Submodule ℂ M)
    (f : ℤ → M) (hf : ∀ i, f i ∈ S) : ∑ᶠ i, f i ∈ S := by
  by_cases h : (Function.support f).Finite
  · rw [finsum_eq_sum f h]
    exact Submodule.sum_mem S fun i _ => hf i
  · rw [finsum_of_infinite_support h]; exact S.zero_mem

include hK hN hι in
/-- The charge vertex operators `Y(e^{ιβ},z)` preserve the image of `Ψ_δ`. -/
theorem Yeαvec_shiftEmb_mem (β : K.carrier) (t : ℤ) (x : LatModuleGen K) :
    Yeαvec N (ι β) t (shiftEmb K N ι δ x) ∈ LinearMap.range (shiftEmb K N ι δ) := by
  have hx : x ∈ Submodule.span ℂ (Set.range (fun q : FockN (rank K) × K.carrier =>
      latStateGen K q.1 q.2)) := by rw [latStateGen_span]; trivial
  induction hx using Submodule.span_induction with
  | mem w hw =>
      obtain ⟨⟨p, γ⟩, rfl⟩ := hw
      simp only
      rw [shiftEmb_latStateGen, Yeαvec_tmul]
      have hE := fockMap_EEVec K N ι hK hN hι β (t - N.form (ι β) (ι γ + δ)) p
      rw [one_smul] at hE
      simp only [AlgHom.toLinearMap_apply] at hE
      rw [← hE, show ι β + (ι γ + δ) = ι (β + γ) + δ by rw [map_add, add_assoc],
        ← shiftEmb_latStateGen]
      exact Submodule.smul_mem _ _ (LinearMap.mem_range_self _ _)
  | zero => rw [map_zero, map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add, map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul, map_smul]; exact Submodule.smul_mem _ c ha

/-- The subspace of `u ∈ V_K` whose image field `Y_N(Φu,z)` preserves the image of `Ψ_δ`. -/
noncomputable def invSub : Submodule ℂ (LatModuleGen K) where
  carrier := {u | ∀ (t : ℤ) (y : LatModuleGen N), y ∈ LinearMap.range (shiftEmb K N ι δ) →
    (latticeVOAGen N hNe hN).Y (latMorph K N ι u) t y ∈ LinearMap.range (shiftEmb K N ι δ)}
  add_mem' {u v} hu hv t y hy := by
    rw [map_add, map_add]
    exact Submodule.add_mem _ (hu t y hy) (hv t y hy)
  zero_mem' t y _ := by
    rw [map_zero, map_zero]; exact Submodule.zero_mem _
  smul_mem' c u hu t y hy := by
    rw [map_smul, map_smul]
    exact Submodule.smul_mem _ c (hu t y hy)

include hKe hK hNe hN hι in
/-- **Invariance**: for every `u ∈ V_K`, `Y_N(Φu,z)` preserves the image of `Ψ_δ`. -/
theorem invSub_eq_top : invSub K N ι δ hNe hN = ⊤ := by
  set VN := latticeVOAGen N hNe hN
  set S := LinearMap.range (shiftEmb K N ι δ)
  have hmode : ∀ u ∈ invSub K N ι δ hNe hN, ∀ (n : ℤ) (y : LatModuleGen N), y ∈ S →
      VN.smul (latMorph K N ι u) n y ∈ S := by
    intro u hu n y hy
    rw [PreVertexAlgebra.smul_def, mode_apply]
    exact hu _ y hy
  refine latVOA_generated K hKe hK _ ?_ ?_
  · intro u hu v hv n t y hy
    change VN.Y (latMorph K N ι ((latticeVOAGen K hKe hK).smul u n v)) t y ∈ S
    rw [(latMorph_isVOAHom K N ι hK hN hι hKe hNe).map_smul]
    have hJ := VN.jacobi (latMorph K N ι u) (latMorph K N ι v) y n 0 (-t - 1)
    have hR : (∑ᶠ i : ℤ, cbz 0 i • VN.smul (VN.smul (latMorph K N ι u) (n + i) (latMorph K N ι v))
        (0 + (-t - 1) - i) y) = VN.smul (VN.smul (latMorph K N ι u) n (latMorph K N ι v)) (-t - 1) y := by
      rw [finsum_eq_single _ (0 : ℤ) (fun i hi => by rw [cbz_zero_left, if_neg hi, zero_smul]),
        cbz_zero_left, if_pos rfl, one_smul, add_zero, zero_add, sub_zero]
    rw [hR] at hJ
    have hY : VN.Y (VN.smul (latMorph K N ι u) n (latMorph K N ι v)) t y
        = VN.smul (VN.smul (latMorph K N ι u) n (latMorph K N ι v)) (-t - 1) y := by
      change _ = mode (VN.Y (VN.smul (latMorph K N ι u) n (latMorph K N ι v))) (-t - 1) y
      rw [mode_apply, show -(-t - 1) - 1 = t by ring]
    rw [hY, ← hJ]
    refine finsum_mem_submodule S _ fun i => ?_
    refine Submodule.smul_mem _ _ (Submodule.sub_mem _ ?_ (Submodule.smul_mem _ _ ?_))
    · exact hmode u hu _ _ (hmode v hv _ y hy)
    · exact hmode v hv _ _ (hmode u hu _ y hy)
  · intro β t y hy
    obtain ⟨x, rfl⟩ := hy
    change VN.Y (latMorph K N ι (latChargeGen K β)) t (shiftEmb K N ι δ x) ∈ S
    rw [latMorph, latMorphC_latChargeGen, map_smul, latVOA_Y_latChargeGen N hNe hN]
    exact Submodule.smul_mem _ _ (Yeαvec_shiftEmb_mem K N ι δ hK hN hι β t x)

end Invariance

/-! ## §4  The weak module `V_{K+λ}` -/

section WeakMod

variable (K N : IntegralLattice.{0}) (ι : K.carrier →ₗ[ℤ] N.carrier) (δ : N.carrier)
  (hKe : K.Even) (hK : K.PosDef) (hNe : N.Even) (hN : N.PosDef)
  (hι : ∀ α β, N.form (ι α) (ι β) = K.form α β)

include hKe hK hNe hN hι in
theorem shiftEmb_exists (u : LatModuleGen K) (t : ℤ) (x : LatModuleGen K) :
    ∃ y, shiftEmb K N ι δ y
      = (latticeVOAGen N hNe hN).Y (latMorph K N ι u) t (shiftEmb K N ι δ x) := by
  have hu : u ∈ invSub K N ι δ hNe hN := by
    rw [invSub_eq_top K N ι δ hKe hK hNe hN hι]; trivial
  obtain ⟨y, hy⟩ := hu t _ (LinearMap.mem_range_self _ x)
  exact ⟨y, hy⟩

/-- **The weak `V_K`-module structure on `V_K`-shaped space, shifted by `δ`.**  Its fields are
`Y_M(u,z) = Ψ_δ⁻¹ ∘ Y_N(Φ_ι u, z) ∘ Ψ_δ`; the Jacobi identity is transported from `V_N`. -/
noncomputable def shiftWeakModule : WeakModule (latticeVOAGen K hKe hK) (LatModuleGen K) :=
  transportWeakModule (latMorph_isVOAHom K N ι hK hN hι hKe hNe)
    (shiftEmbInv_shiftEmb K N ι δ hK hN hι) (shiftEmb_exists K N ι δ hKe hK hNe hN hι)

theorem shiftWeakModule_YM_apply (u : LatModuleGen K) (t : ℤ) (x : LatModuleGen K) :
    (shiftWeakModule K N ι δ hKe hK hNe hN hι).YM u t x
      = shiftEmbInv K N ι δ ((latticeVOAGen N hNe hN).Y (latMorph K N ι u) t (shiftEmb K N ι δ x)) :=
  rfl

/-- The defining intertwining `Ψ_δ ∘ Y_M(u,z) = Y_N(Φu,z) ∘ Ψ_δ`. -/
theorem shiftWeakModule_intertw (u : LatModuleGen K) (t : ℤ) (x : LatModuleGen K) :
    shiftEmb K N ι δ ((shiftWeakModule K N ι δ hKe hK hNe hN hι).YM u t x)
      = (latticeVOAGen N hNe hN).Y (latMorph K N ι u) t (shiftEmb K N ι δ x) :=
  transportY_intertw (shiftEmbInv_shiftEmb K N ι δ hK hN hι)
    (shiftEmb_exists K N ι δ hKe hK hNe hN hι) u t x

include hK hN hι in
theorem shiftEmb_injective : Function.Injective (shiftEmb K N ι δ) :=
  injective_of_leftInverse (shiftEmbInv_shiftEmb K N ι δ hK hN hι)

include hKe hK hNe hN hι in
/-- **The charged vertex operators on the shifted module**: on `p ⊗ e^γ` (standing for
`p ⊗ e^{γ+λ}`), `Y_M(e^β,z)` is the boson dressing `EE(β)` shifted by `z^{⟨β,γ⟩ + ⟨ιβ,δ⟩}`
(`⟨β,λ⟩ = ⟨ιβ,δ⟩ ∈ ℤ`, so all modes are integral), with the cocycle `c(β) ε_N(ιβ, ιγ+δ)`. -/
theorem shiftWeakModule_latChargeGen (β γ : K.carrier) (t : ℤ) (p : FockN (rank K)) :
    (shiftWeakModule K N ι δ hKe hK hNe hN hι).YM (latChargeGen K β) t (latStateGen K p γ)
      = (latCob K N ι β * latticeCocycle N (ι β) (ι γ + δ)) •
          latStateGen K (EEVec K β (t - K.form β γ - N.form (ι β) δ) p) (β + γ) := by
  apply shiftEmb_injective K N ι δ hK hN hι
  rw [shiftWeakModule_intertw, latMorph, latMorphC_latChargeGen, map_smul,
    latVOA_Y_latChargeGen N hNe hN, shiftEmb_latStateGen]
  change latCob K N ι β • Yeαvec N (ι β) t _ = _
  rw [Yeαvec_tmul, map_smul, shiftEmb_latStateGen, smul_smul]
  have hE := fockMap_EEVec K N ι hK hN hι β (t - K.form β γ - N.form (ι β) δ) p
  rw [one_smul] at hE
  simp only [AlgHom.toLinearMap_apply] at hE
  rw [hE, show ι β + (ι γ + δ) = ι (β + γ) + δ by rw [map_add, add_assoc],
    show t - N.form (ι β) (ι γ + δ) = t - K.form β γ - N.form (ι β) δ by
      rw [map_add, hι]; ring]

end WeakMod

/-! ## §5  The shifted currents and the module `L₀` -/

section Currents

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The scalar field `c z⁻¹` (only coefficient: `c · id` at index `-1`). -/
noncomputable def zField (c : ℂ) : FormalDist (End ℂ V) :=
  fun t => if t = -1 then c • LinearMap.id else 0

theorem zField_apply (c : ℂ) (t : ℤ) :
    (zField c : FormalDist (End ℂ V)) t = if t = -1 then c • LinearMap.id else 0 := rfl

theorem zField_isField (c : ℂ) : IsField (zField c : FormalDist (End ℂ V)) := by
  intro x
  refine ⟨-1, fun n hn => ?_⟩
  rw [zField_apply, if_neg (by omega)]; rfl

theorem fd_add_apply (f g : FormalDist (End ℂ V)) (s : ℤ) (x : V) :
    (f + g) s x = f s x + g s x := rfl

theorem fd_smul_apply (c : ℂ) (f : FormalDist (End ℂ V)) (s : ℤ) (x : V) :
    (c • f) s x = c • f s x := rfl

theorem nprod_zField_right {A : FormalDist (End ℂ V)} (hA : IsField A) (c : ℂ) (s : ℤ) (x : V) :
    VOA.nprod hA (zField_isField c) s x = c • A (s + 1) x := by
  rw [nprod_apply, finsum_eq_single _ (s + 1)]
  · have hZ : (zField c : FormalDist (End ℂ V)) (s - (s + 1)) = c • LinearMap.id := by
      rw [zField_apply, if_pos (by ring)]
    rw [normalOrdered_apply, hZ]
    split_ifs
    · rw [Module.End.mul_apply, LinearMap.smul_apply, LinearMap.id_apply, map_smul]
    · rw [Module.End.mul_apply, LinearMap.smul_apply, LinearMap.id_apply]
  · intro m hm
    have hZ : (zField c : FormalDist (End ℂ V)) (s - m) = 0 := by
      rw [zField_apply, if_neg (by omega)]
    rw [normalOrdered_apply, hZ]
    split_ifs
    · rw [mul_zero]; rfl
    · rw [zero_mul]; rfl

theorem nprod_zField_left {A : FormalDist (End ℂ V)} (hA : IsField A) (c : ℂ) (s : ℤ) (x : V) :
    VOA.nprod (zField_isField c) hA s x = c • A (s + 1) x := by
  rw [nprod_apply, finsum_eq_single _ (-1)]
  · rw [normalOrdered_apply, zField_apply, if_pos rfl, if_neg (by norm_num),
      Module.End.mul_apply, LinearMap.smul_apply, LinearMap.id_apply, map_smul,
      show s - -1 = s + 1 by ring]
  · intro m hm
    rw [normalOrdered_apply, zField_apply, if_neg hm]
    split_ifs
    · rw [zero_mul]; rfl
    · rw [mul_zero]; rfl

theorem nprod_zField_zField (c d : ℂ) (s : ℤ) (x : V) :
    VOA.nprod (zField_isField c) (zField_isField d) s x = if s = -2 then (c * d) • x else 0 := by
  rw [nprod_zField_left, zField_apply]
  by_cases hs : s = -2
  · rw [if_pos (by omega), if_pos hs, LinearMap.smul_apply, LinearMap.id_apply, smul_smul]
  · rw [if_neg (by omega), if_neg hs, LinearMap.zero_apply, smul_zero]

/-- `:a(z)·id:` = `a(z)`. -/
theorem nprod_idField_right {A : FormalDist (End ℂ V)} (hA : IsField A) :
    VOA.nprod hA (idField_isField (V := V)) = A := by
  funext s
  apply LinearMap.ext
  intro x
  rw [nprod_apply, finsum_eq_single _ s]
  · have hI : (idField : FormalDist (End ℂ V)) (s - s) = LinearMap.id := by
      rw [idField_apply, if_pos (by ring)]
    rw [normalOrdered_apply, hI]
    split_ifs <;> rfl
  · intro m hm
    have hI : (idField : FormalDist (End ℂ V)) (s - m) = 0 := by
      rw [idField_apply, if_neg (by omega)]
    rw [normalOrdered_apply, hI]
    split_ifs
    · rw [mul_zero]; rfl
    · rw [zero_mul]; rfl

theorem IntertwH_sum {W : Type*} [AddCommGroup W] [Module ℂ W] {g : V →ₗ[ℂ] W} {ι' : Type*}
    (s : Finset ι') {A : ι' → FormalDist (End ℂ V)} {B : ι' → FormalDist (End ℂ W)}
    (h : ∀ i, IntertwH g 1 (A i) (B i)) : IntertwH g 1 (∑ i ∈ s, A i) (∑ i ∈ s, B i) := by
  intro t x
  rw [one_smul, formalDist_sum_apply, formalDist_sum_apply, LinearMap.sum_apply, LinearMap.sum_apply,
    map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [h i t x, one_smul]

variable (K N : IntegralLattice.{0}) (ι : K.carrier →ₗ[ℤ] N.carrier) (δ : N.carrier)

/-- The **momentum shift** `λ_a = ∑_b Q_{ba} ⟨δ⟩_b` — the frame coordinates of the orthogonal
projection of `δ` onto `ι(K) ⊗ ℝ`. -/
noncomputable def lamShift (a : Fin (rank K)) : ℂ :=
  ∑ b : Fin (rank N), oscMatrix K N ι b a * chargeCoord N δ b

/-- The **shifted current** `α'_a(z) = α_a(z) + λ_a z⁻¹` acting on the module. -/
noncomputable def alphaShift (a : Fin (rank K)) : FormalDist (End ℂ (LatModuleGen K)) :=
  alphaLatGen K a + zField (lamShift K N ι δ a)

theorem alphaShift_isField (a : Fin (rank K)) : IsField (alphaShift K N ι δ a) :=
  Fld.isField_add (alphaLatGen_isField K a) (zField_isField _)

theorem alphaShift_latStateGen (a : Fin (rank K)) (t : ℤ) (p : FockN (rank K)) (γ : K.carrier) :
    alphaShift K N ι δ a t (latStateGen K p γ)
      = latStateGen K (oscN (rank K) 1 a (-t - 1) p
          + (if t = -1 then (chargeCoord K γ a + lamShift K N ι δ a) • p else 0)) γ := by
  rw [alphaShift, fd_add_apply, alphaLatGen_latStateGen, zField_apply]
  split_ifs
  · rw [LinearMap.smul_apply, LinearMap.id_apply, ← latStateGen_csmul, ← latStateGen_add_boson,
      add_assoc, add_smul]
  · rw [LinearMap.zero_apply, add_zero]

theorem shiftEmb_intertw_of_latState {A : FormalDist (End ℂ (LatModuleGen K))}
    {B : FormalDist (End ℂ (LatModuleGen N))}
    (h : ∀ (t : ℤ) (p : FockN (rank K)) (β : K.carrier),
      shiftEmb K N ι δ (A t (latStateGen K p β)) = B t (shiftEmb K N ι δ (latStateGen K p β))) :
    IntertwH (shiftEmb K N ι δ) 1 A B := by
  intro t x
  rw [one_smul]
  have hext : (shiftEmb K N ι δ) ∘ₗ A t = B t ∘ₗ (shiftEmb K N ι δ) :=
    LinearMap.ext_on_range (latStateGen_span K) fun q => h t q.1 q.2
  exact congrArg (fun f : LatModuleGen K →ₗ[ℂ] LatModuleGen N => f x) hext

variable (hK : K.PosDef) (hN : N.PosDef) (hι : ∀ α β, N.form (ι α) (ι β) = K.form α β)

include hK hN hι in
/-- `Ψ_δ α'_a(z) = (∑_b Q_{ba} α_b(z)) Ψ_δ` — the zero mode picks up the shift `λ_a`. -/
theorem shiftEmb_alphaShift (a : Fin (rank K)) :
    IntertwH (shiftEmb K N ι δ) 1 (alphaShift K N ι δ a)
      (∑ b : Fin (rank N), oscMatrix K N ι b a • genFieldLatGen N b 0) := by
  simp only [genFieldLatGen_zero]
  refine shiftEmb_intertw_of_latState K N ι δ fun t p γ => ?_
  rw [alphaShift_latStateGen, shiftEmb_latStateGen, shiftEmb_latStateGen,
    formalDist_sum_apply, LinearMap.sum_apply]
  simp only [formalDist_smul_apply, LinearMap.smul_apply, alphaLatGen_latStateGen]
  rw [latStateGen_sum_smul]
  congr 1
  rw [map_add, fockMap_oscN _ (oscMatrix_transpose_mul K N hK hN ι hι)]
  simp only [smul_add, Finset.sum_add_distrib]
  congr 1
  split_ifs
  · rw [map_smul]
    simp only [smul_smul, ← Finset.sum_smul, chargeCoord_add, mul_add, Finset.sum_add_distrib,
      oscMatrix_transpose_chargeCoord K N ι hK hN hι]
    rfl
  · simp

end Currents

/-! ## §6  The module `L₀` -/

section L0

variable (K N : IntegralLattice.{0}) (ι : K.carrier →ₗ[ℤ] N.carrier) (δ : N.carrier)
  (hKe : K.Even) (hK : K.PosDef) (hNe : N.Even) (hN : N.PosDef)
  (hι : ∀ α β, N.form (ι α) (ι β) = K.form α β)

/-- `ω = ∑_a ½ h_a(-1)² 𝟙`. -/
theorem omegaLatGen_eq_sum :
    omegaLatGen K = ∑ a : Fin (rank K), (1 / 2 : ℂ) •
      LinearMap.rTensor (K.carrier →₀ ℂ) (currentN (rank K) 1 a ((0 : ℕ) : ℤ))
        (LinearMap.rTensor (K.carrier →₀ ℂ) (currentN (rank K) 1 a ((0 : ℕ) : ℤ)) (latVacuumGen K)) := by
  rw [omegaLatGen, HeisenbergN.ωN, map_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [HeisenbergN.ωNa, map_smul, latVacuumGen, latStateGen, LinearMap.rTensor_tmul,
    LinearMap.rTensor_tmul, Nat.cast_zero, currentN_apply, show (-(0 : ℤ) - 1) = -1 by ring,
    show (1 / (2 * 1) : ℂ) = 1 / 2 by norm_num]
  rfl

include hK hN hι in
theorem YN_latMorph_current (a : Fin (rank K)) (w : LatModuleGen K) :
    YfullGen N hNe hN (latMorph K N ι
        (LinearMap.rTensor (K.carrier →₀ ℂ) (currentN (rank K) 1 a ((0 : ℕ) : ℤ)) w))
      = VOA.nprod (isField_sum_genField K N ι a 0)
          (YfullGen_isField N hNe hN (latMorph K N ι w)) := by
  change YfullGen N hNe hN (latMorphC K N ι (latCob K N ι) _) = _
  rw [latMorphC_rTensor_current K N ι (latCob K N ι) hK hN hι a 0 w, map_sum]
  simp only [map_smul, YfullGen_rTensor_current N hNe hN]
  rw [← nprod_finsetSum_left Finset.univ (fun b => oscMatrix K N ι b a)
    (fun b => genFieldLatGen N b 0) (fun b => genFieldLatGen_isField N b 0)
    (YfullGen_isField N hNe hN _) (isField_sum_genField K N ι a 0)]
  rfl

include hKe hK hN hι in
theorem shiftEmb_vacuumField :
    IntertwH (shiftEmb K N ι δ) 1 (idField : FormalDist (End ℂ (LatModuleGen K)))
      (YfullGen N hNe hN (latMorph K N ι (latVacuumGen K))) := by
  have h1 : YfullGen N hNe hN (latMorph K N ι (latVacuumGen K)) = 1 := by
    have hv := (latMorph_isVOAHom K N ι hK hN hι hKe hNe).map_vacuum
    change latMorph K N ι (latVacuumGen K) = latVacuumGen N at hv
    rw [hv]
    exact (latticeVOAGen N hNe hN).vacuum_Y
  rw [h1]
  intro t x
  rw [one_smul, idField_apply, FormalDist.one_apply]
  split_ifs
  · rfl
  · rw [LinearMap.zero_apply, LinearMap.zero_apply, map_zero]

/-- The module Sugawara field `T'(z) = ½ ∑_a :α'_a(z) α'_a(z):`. -/
noncomputable def sugShift : FormalDist (End ℂ (LatModuleGen K)) :=
  ∑ a : Fin (rank K), (1 / 2 : ℂ) •
    VOA.nprod (alphaShift_isField K N ι δ a) (alphaShift_isField K N ι δ a)

include hKe hK hNe hN hι in
/-- `Ψ_δ T'(z) = Y_N(Φ ω_K, z) Ψ_δ`. -/
theorem shiftEmb_sugShift :
    IntertwH (shiftEmb K N ι δ) 1 (sugShift K N ι δ)
      (YfullGen N hNe hN (latMorph K N ι (omegaLatGen K))) := by
  rw [omegaLatGen_eq_sum, map_sum, map_sum]
  refine IntertwH_sum _ fun a => ?_
  rw [map_smul, map_smul, YN_latMorph_current K N ι hK hNe hN hι,
    nprod_congr_right _ (YfullGen_isField N hNe hN _)
      (IsField.nprod (isField_sum_genField K N ι a 0) (YfullGen_isField N hNe hN _))
      (YN_latMorph_current K N ι hK hNe hN hι a _)]
  refine IntertwH.const_smul ?_ _
  have hin := IntertwH.nprod (alphaShift_isField K N ι δ a) idField_isField
    (isField_sum_genField K N ι a 0) (YfullGen_isField N hNe hN _)
    (shiftEmb_alphaShift K N ι δ hK hN hι a) (shiftEmb_vacuumField K N ι δ hKe hK hNe hN hι)
  rw [mul_one, nprod_idField_right] at hin
  have hout := IntertwH.nprod (alphaShift_isField K N ι δ a) (alphaShift_isField K N ι δ a)
    (isField_sum_genField K N ι a 0)
    (IsField.nprod (isField_sum_genField K N ι a 0) (YfullGen_isField N hNe hN _))
    (shiftEmb_alphaShift K N ι δ hK hN hι a) hin
  rwa [mul_one] at hout

include hKe hK hNe hN hι in
/-- The module `L₀` is the `z⁻²`-coefficient of the shifted Sugawara field. -/
theorem shiftWeakModule_L0 (x : LatModuleGen K) :
    mode ((shiftWeakModule K N ι δ hKe hK hNe hN hι).YM (omegaLatGen K)) 1 x
      = sugShift K N ι δ (-2) x := by
  apply shiftEmb_injective K N ι δ hK hN hι
  rw [mode_apply, show -(1 : ℤ) - 1 = -2 by ring, shiftWeakModule_intertw]
  have h := shiftEmb_sugShift K N ι δ hKe hK hNe hN hι (-2) x
  rw [one_smul] at h
  exact h.symm

theorem nprod_alphaShift_tmul (a : Fin (rank K)) (q : FockN (rank K)) (γ : K.carrier) :
    VOA.nprod (alphaShift_isField K N ι δ a) (alphaShift_isField K N ι δ a) (-2) (latStateGen K q γ)
      = latStateGen K (VOA.nprod (currentN_isField (rank K) 1 a) (currentN_isField (rank K) 1 a) (-2) q) γ
        + ((chargeCoord K γ a + lamShift K N ι δ a) * (chargeCoord K γ a + lamShift K N ι δ a)) •
            latStateGen K q γ := by
  have hα := alphaLatGen_isField K a
  have hz := zField_isField (V := LatModuleGen K) (lamShift K N ι δ a)
  have e : VOA.nprod (alphaShift_isField K N ι δ a) (alphaShift_isField K N ι δ a)
      = VOA.nprod (Fld.isField_add hα hz) (Fld.isField_add hα hz) := rfl
  rw [e, Fld.nprod_add_left hα hz (Fld.isField_add hα hz), Fld.nprod_add_right hα hα hz,
    Fld.nprod_add_right hz hα hz, fd_add_apply, fd_add_apply, fd_add_apply,
    nprod_zField_right, nprod_zField_left, nprod_zField_zField, if_pos rfl]
  have h1 := nprod_alphaLatGen_tmul K a (-2) q γ
  rw [show mkEα K γ q = latStateGen K q γ from rfl] at h1
  have hA : alphaLatGen K a ((-2 : ℤ) + 1) (latStateGen K q γ)
      = chargeCoord K γ a • latStateGen K q γ := by
    rw [show (-2 : ℤ) + 1 = -1 by ring, alphaLatGen_latStateGen, if_pos rfl,
      show (-(-1 : ℤ) - 1) = 0 by ring, oscN_zero, LinearMap.zero_apply, zero_add, latStateGen_csmul]
  have hC : mkEα K γ (currentN (rank K) 1 a ((-2 : ℤ) + 1) q) = 0 := by
    rw [currentN_apply, show -((-2 : ℤ) + 1) - 1 = 0 by ring, oscN_zero, LinearMap.zero_apply,
      map_zero]
  rw [h1, hC, if_pos rfl, hA, smul_zero, add_zero,
    show mkEα K γ (VOA.nprod (currentN_isField (rank K) 1 a) (currentN_isField (rank K) 1 a) (-2) q)
      = latStateGen K (VOA.nprod (currentN_isField (rank K) 1 a) (currentN_isField (rank K) 1 a) (-2) q) γ
      from rfl]
  module

/-- The **conformal weight** of `p ⊗ e^γ` (boson weight `w`) in the shifted module:
`w + ½ ∑_a (γ_a + λ_a)²`. -/
noncomputable def shiftWeight (w : ℕ) (γ : K.carrier) : ℂ :=
  (w : ℂ) + (1 / 2 : ℂ) * ∑ a : Fin (rank K),
    (chargeCoord K γ a + lamShift K N ι δ a) * (chargeCoord K γ a + lamShift K N ι δ a)

theorem sugShift_latStateGen {w : ℕ} {q : FockN (rank K)} (hq : q ∈ HeisenbergN.gradingWN (rank K) w)
    (γ : K.carrier) :
    sugShift K N ι δ (-2) (latStateGen K q γ) = shiftWeight K N ι δ w γ • latStateGen K q γ := by
  rw [sugShift, formalDist_sum_apply, LinearMap.sum_apply]
  simp only [fd_smul_apply, nprod_alphaShift_tmul, smul_add, Finset.sum_add_distrib]
  rw [shiftWeight, add_smul]
  congr 1
  · rw [Finset.sum_congr rfl fun a _ => (latStateGen_csmul K _ _ γ).symm, ← latStateGen_finsum]
    congr 1
    rw [← LvirN_zero_gradingWN (rank K) 1 one_ne_zero hq, LvirN_apply]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [← LinearMap.smul_apply, half_nprod_currentN K a (-2), show -(-2 : ℤ) - 2 = 0 by ring]
  · rw [Finset.mul_sum, Finset.sum_smul]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [smul_smul]

include hKe hK hNe hN hι in
/-- **`L₀` on the shifted module**: `L₀ (p ⊗ e^γ) = (w + ½|γ+λ|²)(p ⊗ e^γ)` for `p` of boson
weight `w`. -/
theorem shiftWeakModule_L0_latStateGen {w : ℕ} {q : FockN (rank K)}
    (hq : q ∈ HeisenbergN.gradingWN (rank K) w) (γ : K.carrier) :
    mode ((shiftWeakModule K N ι δ hKe hK hNe hN hι).YM (omegaLatGen K)) 1 (latStateGen K q γ)
      = shiftWeight K N ι δ w γ • latStateGen K q γ := by
  rw [shiftWeakModule_L0, sugShift_latStateGen K N ι δ hq]

end L0

/-! ## §7  The grading: an `OrdVModule` -/

section Graded

variable (K N : IntegralLattice.{0}) (ι : K.carrier →ₗ[ℤ] N.carrier) (δ : N.carrier)
  (hKe : K.Even) (hK : K.PosDef) (hNe : N.Even) (hN : N.PosDef)
  (hι : ∀ α β, N.form (ι α) (ι β) = K.form α β)

/-- The set of bigrades `(w, γ)` (`w ≥ 0`) of conformal weight `h`. -/
def shiftFiber (h : ℂ) : Set (ℤ × K.carrier) :=
  {p | 0 ≤ p.1 ∧ shiftWeight K N ι δ p.1.toNat p.2 = h}

/-- The weight-`h` subspace `⨆_{(w,γ) : w + ½|γ+λ|² = h} (Fock_w ⊗ e^γ)`. -/
noncomputable def shiftWeightSpace (h : ℂ) : Submodule ℂ (LatModuleGen K) :=
  ⨆ p ∈ shiftFiber K N ι δ h, bigradα K p

theorem bigradα_le_shiftWeightSpace {p : ℤ × K.carrier} (hp : 0 ≤ p.1) :
    bigradα K p ≤ shiftWeightSpace K N ι δ (shiftWeight K N ι δ p.1.toNat p.2) :=
  le_biSup (bigradα K) (show p ∈ shiftFiber K N ι δ _ from ⟨hp, rfl⟩)

theorem shiftWeightSpace_iSup_eq_top : iSup (shiftWeightSpace K N ι δ) = ⊤ := by
  rw [eq_top_iff, ← bigradα_iSup_eq_top K]
  refine iSup_le fun p => ?_
  by_cases hp : 0 ≤ p.1
  · exact le_trans (bigradα_le_shiftWeightSpace K N ι δ hp) (le_iSup _ _)
  · rw [show p = (p.1, p.2) from rfl, bigradα_eq_bot_of_neg K p.2 (by omega)]; exact bot_le

theorem iSup_ne_shiftWeightSpace_le (h : ℂ) :
    (⨆ (h' : ℂ) (_ : h' ≠ h), shiftWeightSpace K N ι δ h')
      ≤ ⨆ p ∈ {p : ℤ × K.carrier | p ∉ shiftFiber K N ι δ h}, bigradα K p := by
  refine iSup_le fun h' => iSup_le fun hh' => iSup_le fun p => iSup_le fun hp => ?_
  refine le_biSup (bigradα K) (show p ∈ {p : ℤ × K.carrier | p ∉ shiftFiber K N ι δ h} from ?_)
  intro hp'
  exact hh' (hp.2.symm.trans hp'.2)

variable (hfin : ∀ h : ℂ, (shiftFiber K N ι δ h).Finite)

include hfin in
theorem shiftWeightSpace_iSupIndep : iSupIndep (shiftWeightSpace K N ι δ) := by
  rw [iSupIndep_def]
  intro h
  refine Disjoint.mono_right (iSup_ne_shiftWeightSpace_le K N ι δ h) ?_
  apply iSupIndep.disjoint_biSup_biSup' (bigradα_iSupIndep K)
  · rw [Set.disjoint_left]
    intro p hp hp'
    exact hp' hp
  · exact hfin h

include hfin in
theorem shiftWeightSpace_isInternal : DirectSum.IsInternal (shiftWeightSpace K N ι δ) :=
  DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    (shiftWeightSpace_iSupIndep K N ι δ hfin) (shiftWeightSpace_iSup_eq_top K N ι δ)

include hfin in
theorem shiftWeightSpace_finiteDimensional (h : ℂ) :
    FiniteDimensional ℂ (shiftWeightSpace K N ι δ h) := by
  rw [shiftWeightSpace, ← iSup_subtype'']
  have : Finite (shiftFiber K N ι δ h) := hfin h
  infer_instance

include hKe hK hNe hN hι in
theorem shiftWeightSpace_L0 (h : ℂ) (x : LatModuleGen K) (hx : x ∈ shiftWeightSpace K N ι δ h) :
    mode ((shiftWeakModule K N ι δ hKe hK hNe hN hι).YM (omegaLatGen K)) 1 x = h • x := by
  set L0 := mode ((shiftWeakModule K N ι δ hKe hK hNe hN hι).YM (omegaLatGen K)) 1
  have hker : shiftWeightSpace K N ι δ h ≤ LinearMap.ker (L0 - h • LinearMap.id) := by
    refine iSup_le fun p => iSup_le fun hp => ?_
    rintro _ ⟨q, hq, rfl⟩
    obtain ⟨hp0, hpw⟩ := hp
    rw [HeisenbergN.gradingZN_of_nonneg hp0] at hq
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
      show mkEα K p.2 q = latStateGen K q p.2 from rfl,
      shiftWeakModule_L0_latStateGen K N ι δ hKe hK hNe hN hι hq, hpw, sub_self]
  have := hker hx
  rwa [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
    sub_eq_zero] at this

theorem shiftWeightSpace_ne_bot {h : ℂ} (hh : shiftWeightSpace K N ι δ h ≠ ⊥) :
    (shiftFiber K N ι δ h).Nonempty := by
  by_contra hc
  rw [Set.not_nonempty_iff_eq_empty] at hc
  apply hh
  rw [shiftWeightSpace, hc]
  simp

variable (B : ℝ) (hbdd : ∀ (w : ℕ) (γ : K.carrier), B ≤ (shiftWeight K N ι δ w γ).re)

include hKe hK hNe hN hι hfin hbdd in
/-- **The shifted lattice module `V_{K+λ}` as an ordinary (`ℂ`-graded) `V_K`-module**, given
finiteness of the weight fibers and a lower bound on the weights. -/
noncomputable def shiftOrdModule : OrdVModule (latticeVOAGen K hKe hK) (LatModuleGen K) where
  toWeakModule := shiftWeakModule K N ι δ hKe hK hNe hN hι
  weight := shiftWeightSpace K N ι δ
  isInternal := shiftWeightSpace_isInternal K N ι δ hfin
  L0_weight := fun h x hx => shiftWeightSpace_L0 K N ι δ hKe hK hNe hN hι h x hx
  finrank := shiftWeightSpace_finiteDimensional K N ι δ hfin
  boundedBelow := by
    refine ⟨B, fun h hh => ?_⟩
    obtain ⟨p, _, hpw⟩ := shiftWeightSpace_ne_bot K N ι δ hh
    rw [← hpw]
    exact hbdd _ _

end Graded

/-! ## §8  The weight identities -/

section WeightIdentities

variable (K N : IntegralLattice.{0}) (ι : K.carrier →ₗ[ℤ] N.carrier) (δ : N.carrier)
  (hK : K.PosDef) (hN : N.PosDef) (hι : ∀ α β, N.form (ι α) (ι β) = K.form α β)

include hK hN in
/-- `⟨γ, λ⟩ = ⟨ιγ, δ⟩`: the shift `λ` is the projection of `δ` onto `ι(K) ⊗ ℝ`. -/
theorem sum_chargeCoord_lamShift (γ : K.carrier) :
    ∑ a, chargeCoord K γ a * lamShift K N ι δ a = ((N.form (ι γ) δ : ℤ) : ℂ) := by
  rw [← sum_chargeCoord N hN (ι γ) δ, ← oscMatrix_chargeCoord K N hK ι γ]
  simp only [lamShift, Finset.mul_sum, Matrix.mulVec, dotProduct, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun a _ => ?_
  ring

include hK hN in
/-- The general conformal-weight formula `w + ½(⟨γ,γ⟩ + 2⟨ιγ,δ⟩ + |λ|²)`. -/
theorem shiftWeight_eq (w : ℕ) (γ : K.carrier) :
    shiftWeight K N ι δ w γ = (w : ℂ) + (1 / 2 : ℂ) * (((K.form γ γ : ℤ) : ℂ)
      + 2 * ((N.form (ι γ) δ : ℤ) : ℂ) + ∑ a, lamShift K N ι δ a * lamShift K N ι δ a) := by
  rw [shiftWeight, ← sum_chargeCoord K hK γ γ, ← sum_chargeCoord_lamShift K N ι δ hK hN γ]
  congr 2
  rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun a _ => ?_
  ring

end WeightIdentities

/-! ## §9  The rank-one case: `L = √(2m)ℤ`, the gluing lattice, and `V_{L + jα/(2m)}` -/

section RankOne

open VOA.LatGen.Triplet

/-- The Gram form of the auxiliary rank-two lattice `N_{m,j}` with Gram matrix
`[[2m, j], [j, 2(j²+1)]]`. -/
def glueForm (m : ℕ) (j : ℤ) (x y : Fin 2 → ℤ) : ℤ :=
  2 * (m : ℤ) * x 0 * y 0 + j * (x 0 * y 1 + x 1 * y 0) + 2 * (j ^ 2 + 1) * x 1 * y 1

/-- The **gluing lattice** `N_{m,j} = ℤα ⊕ ℤδ`, `⟨α,α⟩ = 2m`, `⟨α,δ⟩ = j`, `⟨δ,δ⟩ = 2(j²+1)`:
even and positive definite, containing `√(2m)ℤ = ℤα` isometrically, with `⟨α,δ⟩ = j`. -/
noncomputable def glueLat (m : ℕ) (j : ℤ) : IntegralLattice.{0} where
  carrier := Fin 2 → ℤ
  form := LinearMap.mk₂ ℤ (glueForm m j)
    (fun x x' y => by simp only [glueForm, Pi.add_apply]; ring)
    (fun c x y => by simp only [glueForm, Pi.smul_apply, smul_eq_mul]; ring)
    (fun x y y' => by simp only [glueForm, Pi.add_apply]; ring)
    (fun c x y => by simp only [glueForm, Pi.smul_apply, smul_eq_mul]; ring)
  isSymm := by
    rw [LinearMap.BilinForm.isSymm_def]
    intro x y
    simp only [LinearMap.mk₂_apply, glueForm]
    ring

theorem glueLat_form (m : ℕ) (j : ℤ) (x y : (glueLat m j).carrier) :
    (glueLat m j).form x y = glueForm m j x y := rfl

theorem glueLat_even (m : ℕ) (j : ℤ) : (glueLat m j).Even := by
  intro x
  refine ⟨(m : ℤ) * x 0 * x 0 + j * x 0 * x 1 + (j ^ 2 + 1) * x 1 * x 1, ?_⟩
  rw [glueLat_form, glueForm]
  ring

theorem glueLat_posDef (m : ℕ) (hm : 1 ≤ m) (j : ℤ) : (glueLat m j).PosDef := by
  intro x hx
  rw [glueLat_form, glueForm]
  have hm' : (1 : ℤ) ≤ (m : ℤ) := by exact_mod_cast hm
  have hx' : x 0 ≠ 0 ∨ x 1 ≠ 0 := by
    by_contra hc
    push Not at hc
    apply hx
    funext i
    fin_cases i
    · exact hc.1
    · exact hc.2
  have hsq : 0 ≤ (x 0 + j * x 1) ^ 2 := sq_nonneg _
  have h0 : 0 ≤ x 0 ^ 2 := sq_nonneg _
  have h1 : 0 ≤ j ^ 2 * x 1 ^ 2 := by positivity
  have hmx : x 0 ^ 2 ≤ (m : ℤ) * x 0 ^ 2 := by nlinarith
  rcases hx' with h | h
  · have : 0 < x 0 ^ 2 := by positivity
    nlinarith
  · have : 0 < x 1 ^ 2 := by positivity
    nlinarith

/-- The isometric embedding `√(2m)ℤ ↪ N_{m,j}`, `n ↦ nα`. -/
noncomputable def glueIota (m : ℕ) (j : ℤ) : (latP m).carrier →ₗ[ℤ] (glueLat m j).carrier :=
  LinearMap.single ℤ (fun _ : Fin 2 => ℤ) 0

theorem glueIota_apply (m : ℕ) (j : ℤ) (n : ℤ) :
    glueIota m j n = Pi.single (0 : Fin 2) n := rfl

/-- The glue vector `δ ∈ N_{m,j}`. -/
def glueDelta (m : ℕ) (j : ℤ) : (glueLat m j).carrier := Pi.single (1 : Fin 2) (1 : ℤ)

theorem glueIota_isometry (m : ℕ) (j : ℤ) (a b : ℤ) :
    (glueLat m j).form (glueIota m j a) (glueIota m j b) = (latP m).form a b := by
  rw [glueLat_form, glueForm, latP_form, glueIota_apply, glueIota_apply]
  simp

theorem glueIota_delta (m : ℕ) (j : ℤ) (n : ℤ) :
    (glueLat m j).form (glueIota m j n) (glueDelta m j) = j * n := by
  rw [glueLat_form, glueForm, glueIota_apply, glueDelta]
  simp

variable (m : ℕ) (hm : 1 ≤ m) (j : ℤ)

/-- The unique frame index of the rank-one lattice. -/
def a0 : Fin (rank (latP m)) := ⟨0, by rw [rank_latP]; norm_num⟩

theorem sum_rankOne (f : Fin (rank (latP m)) → ℂ) : ∑ a, f a = f (a0 m) := by
  refine Finset.sum_eq_single (a0 m) (fun b _ hb => ?_) (fun h => absurd (Finset.mem_univ _) h)
  exfalso
  apply hb
  have hb1 : b.val < 1 := lt_of_lt_of_eq b.isLt (rank_latP m)
  exact Fin.ext (by simp only [a0]; omega)

include hm in
/-- In rank one, `|λ|² = j²/(2m)`. -/
theorem lamShift_sq_rankOne :
    ∑ a, lamShift (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) a
        * lamShift (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) a
      = (j : ℂ) ^ 2 / (2 * m) := by
  have hK := latP_posDef m hm
  have hN := glueLat_posDef m hm j
  have hcc := sum_chargeCoord (latP m) hK (1 : ℤ) (1 : ℤ)
  have hcl := sum_chargeCoord_lamShift (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) hK hN
    (1 : ℤ)
  rw [sum_rankOne] at hcc hcl ⊢
  rw [latP_form] at hcc
  rw [glueIota_delta] at hcl
  set c := chargeCoord (latP m) (1 : ℤ) (a0 m)
  set l := lamShift (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) (a0 m)
  have hm0 : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hcc' : c * c = 2 * (m : ℂ) := by rw [hcc]; push_cast; ring
  have hcl' : c * l = (j : ℂ) := by rw [hcl]; push_cast; ring
  have key : (2 * (m : ℂ)) * (l * l) = (j : ℂ) ^ 2 := by
    rw [← hcc', ← hcl']; ring
  field_simp
  linear_combination key

include hm in
/-- **The conformal weights of `V_{L+λ_j}`**: `p ⊗ e^{nα}` (boson weight `w`) has weight
`w + (2mn + j)²/(4m)`. -/
theorem shiftWeight_rankOne (w : ℕ) (n : ℤ) :
    shiftWeight (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) w n
      = (((w : ℝ) + ((2 * m * n + j : ℤ) : ℝ) ^ 2 / (4 * m) : ℝ) : ℂ) := by
  have hK := latP_posDef m hm
  have hN := glueLat_posDef m hm j
  rw [shiftWeight_eq _ _ _ _ hK hN, lamShift_sq_rankOne m hm j, latP_form, glueIota_delta]
  have hm0 : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  push_cast
  field_simp
  ring

include hm in
theorem shiftFiber_rankOne_finite (h : ℂ) :
    (shiftFiber (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) h).Finite := by
  set C : ℤ := ⌈4 * (m : ℝ) * h.re⌉
  set B : ℤ := C + |j|
  refine Set.Finite.subset ((Set.finite_Icc (0 : ℤ) B).prod (Set.finite_Icc (-B) B)) ?_
  rintro ⟨w, n⟩ ⟨hw, hwt⟩
  simp only at hw hwt
  rw [shiftWeight_rankOne m hm j] at hwt
  have hre := congrArg Complex.re hwt
  rw [Complex.ofReal_re] at hre
  have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast hm
  have hZ : ((4 * m * w + (2 * m * n + j) ^ 2 : ℤ) : ℝ) = 4 * (m : ℝ) * h.re := by
    rw [← hre]
    have hwn : ((w.toNat : ℕ) : ℝ) = (w : ℝ) := by exact_mod_cast Int.toNat_of_nonneg hw
    rw [hwn]
    push_cast
    field_simp
  have hZC : 4 * m * w + (2 * m * n + j) ^ 2 ≤ C := by
    have h2 : ((4 * m * w + (2 * m * n + j) ^ 2 : ℤ) : ℝ) ≤ (C : ℝ) := by
      rw [hZ]; exact Int.le_ceil _
    exact_mod_cast h2
  have hmZ : (1 : ℤ) ≤ m := by exact_mod_cast hm
  set y := 2 * (m : ℤ) * n + j with hy
  have hyy : y ≤ y ^ 2 ∧ -y ≤ y ^ 2 := by
    rcases le_or_gt y 0 with h0 | h0
    · constructor <;> nlinarith
    · constructor <;> nlinarith
  have hsq : 0 ≤ y ^ 2 := sq_nonneg y
  have hj1 : j ≤ |j| := le_abs_self j
  have hj2 : -j ≤ |j| := neg_le_abs j
  refine ⟨⟨hw, by nlinarith⟩, ?_, ?_⟩
  · rcases le_or_gt 0 n with hn | hn
    · nlinarith
    · nlinarith
  · rcases le_or_gt 0 n with hn | hn
    · nlinarith
    · nlinarith

include hm in
theorem shiftWeight_rankOne_re_nonneg (w : ℕ) (n : ℤ) :
    0 ≤ (shiftWeight (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) w n).re := by
  rw [shiftWeight_rankOne m hm j, Complex.ofReal_re]
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  positivity

/-- **The `V_{2m}`-module `V_{L+jα/(2m)}`** (`L = √(2m)ℤ`), as an ordinary `ℂ`-graded module
`OrdVModule (V2m m hm) _`, for every `j ∈ ℤ`.  The underlying space is `Fock ⊗ ℂ{L}`, the state
`p ⊗ e^{nα}` standing for `p ⊗ e^{(n + j/(2m))α}`. -/
noncomputable def latticeModule : OrdVModule (V2m m hm) (LatModuleGen (latP m)) :=
  shiftOrdModule (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) (latP_even m)
    (latP_posDef m hm) (glueLat_even m j) (glueLat_posDef m hm j) (glueIota_isometry m j)
    (shiftFiber_rankOne_finite m hm j) 0 (shiftWeight_rankOne_re_nonneg m hm j)

/-- `L₀` on `V_{L+λ_j}`: `L₀ (p ⊗ e^{nα}) = (w + (2mn+j)²/(4m)) (p ⊗ e^{nα})`. -/
theorem latticeModule_L0 {w : ℕ} {q : FockN (rank (latP m))}
    (hq : q ∈ HeisenbergN.gradingWN (rank (latP m)) w) (n : ℤ) :
    mode ((latticeModule m hm j).YM (V2m m hm).conformalVector) 1 (latStateGen (latP m) q n)
      = ((((w : ℝ) + ((2 * m * n + j : ℤ) : ℝ) ^ 2 / (4 * m) : ℝ) : ℂ)) • latStateGen (latP m) q n := by
  rw [← shiftWeight_rankOne m hm j]
  exact shiftWeakModule_L0_latStateGen (latP m) (glueLat m j) (glueIota m j) (glueDelta m j)
    (latP_even m) (latP_posDef m hm) (glueLat_even m j) (glueLat_posDef m hm j)
    (glueIota_isometry m j) hq n

/-- The vertex operator of `e^{kα}` on `V_{L+λ_j}`: on `p ⊗ e^{nα}` it is the boson dressing
shifted by `z^{2mkn + jk}` — integral powers, as `⟨kα, λ_j⟩ = jk ∈ ℤ`. -/
theorem latticeModule_latChargeGen (k n : ℤ) (t : ℤ) (p : FockN (rank (latP m))) :
    (latticeModule m hm j).YM (latChargeGen (latP m) k) t (latStateGen (latP m) p n)
      = (latCob (latP m) (glueLat m j) (glueIota m j) k
          * latticeCocycle (glueLat m j) (glueIota m j k) (glueIota m j n + glueDelta m j)) •
          latStateGen (latP m) (EEVec (latP m) k (t - 2 * m * k * n - j * k) p) (k + n) := by
  have h := shiftWeakModule_latChargeGen (latP m) (glueLat m j) (glueIota m j) (glueDelta m j)
    (latP_even m) (latP_posDef m hm) (glueLat_even m j) (glueLat_posDef m hm j)
    (glueIota_isometry m j) k n t p
  rw [latP_form, glueIota_delta] at h
  exact h

/-- The state `𝟙 ⊗ e^{0}` (standing for `e^{λ_j}`) has conformal weight `j²/(4m)`. -/
theorem latticeModule_vacuum_mem :
    latVacuumGen (latP m) ∈ (latticeModule m hm j).weight ((((j : ℝ) ^ 2 / (4 * m) : ℝ) : ℂ)) := by
  have h := bigradα_le_shiftWeightSpace (latP m) (glueLat m j) (glueIota m j) (glueDelta m j)
    (p := ((0 : ℤ), (0 : (latP m).carrier))) le_rfl
  have hw : shiftWeight (latP m) (glueLat m j) (glueIota m j) (glueDelta m j) (Int.toNat 0)
      (0 : (latP m).carrier) = ((((j : ℝ) ^ 2 / (4 * m) : ℝ) : ℂ)) := by
    have := shiftWeight_rankOne m hm j 0 0
    refine this.trans ?_
    push_cast
    ring
  rw [hw] at h
  have hv : latVacuumGen (latP m) ∈ bigradα (latP m) ((0 : ℤ), (0 : (latP m).carrier)) := by
    rw [bigradα_zero_zero]; exact Submodule.mem_span_singleton_self _
  exact h hv

/-- Every nonzero weight space of `V_{L+λ_j}` has a weight `w + (2mn+j)²/(4m)`. -/
theorem latticeModule_weight_ne_bot {h : ℂ} (hh : (latticeModule m hm j).weight h ≠ ⊥) :
    ∃ (w : ℕ) (n : ℤ), h = (((w : ℝ) + ((2 * m * n + j : ℤ) : ℝ) ^ 2 / (4 * m) : ℝ) : ℂ) := by
  obtain ⟨⟨w, n⟩, _, hpw⟩ := shiftWeightSpace_ne_bot _ _ _ _ hh
  exact ⟨w.toNat, n, by rw [← hpw, shiftWeight_rankOne m hm j]⟩

/-- **Lowest weight** `h_j = j²/(4m)` (for the representative `|j| ≤ m`): every nonzero weight
space of `V_{L+λ_j}` has real weight `≥ j²/(4m)`, and the weight `j²/(4m)` occurs. -/
theorem latticeModule_lowestWeight (hj : |j| ≤ m) {h : ℂ} (hh : (latticeModule m hm j).weight h ≠ ⊥) :
    ∃ r : ℝ, h = r ∧ (j : ℝ) ^ 2 / (4 * m) ≤ r := by
  obtain ⟨w, n, rfl⟩ := latticeModule_weight_ne_bot m hm j hh
  refine ⟨_, rfl, ?_⟩
  have hm0 : (0 : ℝ) < m := by exact_mod_cast hm
  have hjm : |(j : ℝ)| ≤ m := by exact_mod_cast hj
  have hkey : (j : ℝ) ^ 2 ≤ ((2 * m * n + j : ℤ) : ℝ) ^ 2 := by
    push_cast
    have hj1 := le_abs_self (j : ℝ)
    have hj2 := neg_abs_le (j : ℝ)
    rcases lt_trichotomy n 0 with hn | hn | hn
    · have hn' : (n : ℝ) ≤ -1 := by exact_mod_cast (show n ≤ -1 by omega)
      have h1 : (m : ℝ) * n + j ≤ 0 := by nlinarith
      have h2 : 0 ≤ (n : ℝ) * ((m : ℝ) * n + j) := mul_nonneg_of_nonpos_of_nonpos (by linarith) h1
      nlinarith
    · subst hn; simp
    · have hn' : (1 : ℝ) ≤ n := by exact_mod_cast (show 1 ≤ n by omega)
      have h1 : 0 ≤ (m : ℝ) * n + j := by nlinarith
      have h2 : 0 ≤ (n : ℝ) * ((m : ℝ) * n + j) := mul_nonneg (by linarith) h1
      nlinarith
  have hw0 : (0 : ℝ) ≤ w := Nat.cast_nonneg w
  have : (j : ℝ) ^ 2 / (4 * m) ≤ ((2 * m * n + j : ℤ) : ℝ) ^ 2 / (4 * m) :=
    div_le_div_of_nonneg_right hkey (by positivity)
  linarith

end RankOne

end VOA.Classification.COne.LatMod
