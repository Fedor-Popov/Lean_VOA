theorem sc243_check :
    reduceTwo (prependC 1 sc107 ++ scaleR (-1) (prependC 0 sc108)) = sc243 := by
  decide +kernel

theorem sc243_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc243 = evRc a c (expWordR [1, 4] (10)) := by
  rw [← sc243_check]
  exact expTwo_step _ _ hc 0 [4] (10)
    sc107 sc108 (sc107_sound a c hc) (sc108_sound a c hc)

