set_option maxHeartbeats 2000000 in
-- Exact normalization of at most 231 oscillator monomials.
set_option maxRecDepth 4096 in
theorem sc297_check :
    reduceTwo (prependC 2 sc51 ++ scaleR (-1) (prependC 0 sc53)) = sc297 := by
  decide +kernel

theorem sc297_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc297 = evRc a c (expWordR [2, 2] (-3)) := by
  rw [← sc297_check]
  exact expTwo_step _ _ hc 1 [2] (-3)
    sc51 sc53 (sc51_sound a c hc) (sc53_sound a c hc)

