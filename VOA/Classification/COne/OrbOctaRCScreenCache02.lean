theorem sc449_check :
    reduceTwo (prependC 3 sc140 ++ scaleR (-1) (prependC 0 sc143)) = sc449 := by
  decide +kernel

theorem sc449_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc449 = evRc a c (expWordR [3, 6] (4)) := by
  rw [← sc449_check]
  exact expTwo_step _ _ hc 2 [6] (4)
    sc140 sc143 (sc140_sound a c hc) (sc143_sound a c hc)

