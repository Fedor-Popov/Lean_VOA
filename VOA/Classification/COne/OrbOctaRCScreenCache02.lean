    evRc a c sc311 = evRc a c (expWordR [2, 2] (11)) := by
  rw [← sc311_check]
  exact expTwo_step _ _ hc 1 [2] (11)
    sc65 sc67 (sc65_sound a c hc) (sc67_sound a c hc)

