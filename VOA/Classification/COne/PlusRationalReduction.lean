import VOA.Classification.COne.PlusUnitaryFinal
import Mathlib.RingTheory.FiniteLength

/-!
# A finite-length / simple-extension reduction for rationality of `V_{2m}⁺`

This file does **not** prove Abe's rationality theorem. It proves the algebraic implication
needed for a route through cyclic modules, with two explicit, separate residual facts.

* `V2mPlusCyclicFiniteLengthFactGe2`: every cyclic submodule of an admissible module has
  finite composition length, over the actual algebra generated by its modes.
* `V2mPlusTwoStepSplittingFactGe2`: every length-two subquotient of each such cyclic module
  splits. The two factors are required to be simple, via strict covering relations.

The first residual is the local finiteness consequence of C₂-cofiniteness used in Abe,
arXiv:math/0311210, Theorem 2.7 and the proof of Theorem 2.8: finitely many generalized
weight generators give finite-dimensional generalized weight spaces, and finitely many
possible simple lowest weights bound composition length. This consequence is NOT proved
here merely by importing `V2mPlus_c2Cofinite`.

The second residual is the subquotient formulation of the Ext¹ vanishing in Abe,
Theorem 7.6 (proved in Propositions 7.2–7.4). A chain `a ⋖ b ⋖ c` represents an extension
of `c/b` by `b/a`; a relative complement is precisely a splitting inside `c/a`.
In particular it does not assume that all submodules of arbitrary admissible modules split.

The proof below replaces the passage through Ext of finite sums by an elementary
finite-length lattice argument. The final sum of cyclic semisimple modules is allowed
to be infinite. No finite-dimensionality of the whole admissible module is assumed.

Source: T. Abe, Math. Z. 249 (2005), 455–484,
https://arxiv.org/pdf/math/0311210, especially §§2 and 7.
-/

namespace VOA.Classification.COne.PlusRational

/-- Splitting of every extension with two simple factors, expressed in its submodule lattice.
`a ⋖ b` is strict: `b/a` is simple and nonzero. -/
def TwoStepSplitting (L : Type*) [Lattice L] : Prop :=
  ∀ a b c : L, a ⋖ b → b ⋖ c →
    ∃ d : L, a ≤ d ∧ d ≤ c ∧ b ⊓ d = a ∧ b ⊔ d = c

/-- Semisimplicity supplies all the relative complements required by `TwoStepSplitting`. -/
theorem twoStepSplitting_of_complementedLattice
    {L : Type*} [Lattice L] [BoundedOrder L] [IsModularLattice L]
    [ComplementedLattice L] : TwoStepSplitting L := by
  intro a b c hab hbc
  obtain ⟨d, hd, hd'⟩ := IsModularLattice.exists_inf_eq_and_sup_eq hab.le hbc.le
  exact ⟨d, hd ▸ inf_le_right, hd' ▸ le_sup_right, hd, hd'⟩

/-- The finite-length algebra behind Abe's simple-extension criterion:
if every two-step interval splits, the atoms span the entire lattice.
No modularity is needed for this particular implication. -/
theorem sSup_atoms_eq_top_of_twoStepSplitting
    {L : Type*} [CompleteLattice L] [WellFoundedLT L] [WellFoundedGT L]
    (hs : TwoStepSplitting L) : sSup {a : L | IsAtom a} = ⊤ := by
  suffices hall : ∀ b : L, b ≤ sSup {a : L | IsAtom a} by
    exact top_unique (hall ⊤)
  intro b
  induction b using WellFoundedLT.induction with
  | ind b ih =>
    by_cases hb : b = ⊥
    · rw [hb]; exact bot_le
    obtain ⟨a, -, hab⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.mpr hb)
    by_cases ha : a = ⊥
    · subst a
      exact le_sSup (bot_covBy_iff.mp hab)
    obtain ⟨c, -, hca⟩ := exists_le_covBy_of_lt (bot_lt_iff_ne_bot.mpr ha)
    obtain ⟨d, -, hdb, had, hadb⟩ := hs c a b hca hab
    have hdt : d < b := lt_of_le_of_ne hdb fun h => by
      rw [h, inf_eq_left.mpr hab.le] at had
      exact hca.ne had.symm
    rw [← hadb]
    exact sup_le (ih a hab.lt) (ih d hdt)

/-- A module of finite length with split length-two subquotients is semisimple. -/
theorem isSemisimpleModule_of_finiteLength_twoStepSplitting
    {R M : Type*} [Ring R] [AddCommGroup M] [Module R M]
    (hfin : IsFiniteLength R M) (hs : TwoStepSplitting (Submodule R M)) :
    IsSemisimpleModule R M := by
  obtain ⟨hN, hA⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp hfin
  letI := hN
  letI := hA
  apply IsSemisimpleModule.of_sSup_simples_eq_top
  simpa only [isSimpleModule_iff_isAtom] using sSup_atoms_eq_top_of_twoStepSplitting hs

/-- It suffices to check finite length and length-two splitting on cyclic submodules.
This is valid for arbitrary modules over arbitrary rings. -/
theorem isSemisimpleModule_of_cyclic_finiteLength_twoStepSplitting
    {R M : Type*} [Ring R] [AddCommGroup M] [Module R M]
    (hfin : ∀ x : M, IsFiniteLength R (Submodule.span R {x}))
    (hs : ∀ x : M, TwoStepSplitting (Submodule R (Submodule.span R {x}))) :
    IsSemisimpleModule R M := by
  apply isSemisimpleModule_of_isSemisimpleModule_submodule'
    (p := fun x : M => Submodule.span R {x})
    (fun x => isSemisimpleModule_of_finiteLength_twoStepSplitting (hfin x) (hs x))
  apply top_unique
  intro x _
  exact Submodule.mem_iSup_of_mem x (Submodule.mem_span_singleton_self x)

universe u v

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
  {W : VertexOperatorAlgebra 𝒱} {M : Type v} [AddCommGroup M] [Module ℂ M]

/-- A cyclic weak submodule, using the existing mode algebra so that composition length
and strict covers refer to invariance under all VOA modes, not just scalar multiplication. -/
abbrev cyclic (A : WeakModule W M) (x : M) := Submodule.span (modeAlg A) {x}

/-- Weak complete reducibility is exactly semisimplicity over the actual mode algebra.
This records both directions, so the reduction does not change the notion of submodule. -/
theorem isSemisimpleModule_modeAlg_iff (N : AdmissibleModule W M) :
    IsSemisimpleModule (modeAlg N.toWeakModule) M ↔ N.IsCompletelyReducible := by
  constructor
  · intro h
    letI := h
    intro P
    obtain ⟨Q, hQ⟩ := exists_isCompl (toR N.toWeakModule P)
    exact ⟨ofR N.toWeakModule Q,
      hQ.map (Submodule.restrictScalarsLatticeHom ℂ (modeAlg N.toWeakModule) M)⟩
  · intro h
    refine (isSemisimpleModule_iff _ _).mpr ⟨fun P => ?_⟩
    obtain ⟨Q, hQ⟩ := h (ofR N.toWeakModule P)
    exact ⟨toR N.toWeakModule Q,
      IsCompl.of_orderEmbedding
        (Submodule.restrictScalarsEmbedding ℂ (modeAlg N.toWeakModule) M) hQ⟩

/-- The algebraic reduction for one admissible module. -/
theorem completelyReducible_of_cyclic_finiteLength_twoStepSplitting
    (N : AdmissibleModule W M)
    (hfin : ∀ x : M, IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x))
    (hs : ∀ x : M,
      TwoStepSplitting (Submodule (modeAlg N.toWeakModule) (cyclic N.toWeakModule x))) :
    N.IsCompletelyReducible := by
  exact (isSemisimpleModule_modeAlg_iff N).mp
    (isSemisimpleModule_of_cyclic_finiteLength_twoStepSplitting hfin hs)

/-- Conversely, complete reducibility gives both residual properties on cyclic modules.
A cyclic semisimple module is finitely generated, hence has finite composition length. -/
theorem cyclic_finiteLength_twoStepSplitting_of_completelyReducible
    (N : AdmissibleModule W M) (h : N.IsCompletelyReducible) (x : M) :
    IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x) ∧
      TwoStepSplitting (Submodule (modeAlg N.toWeakModule) (cyclic N.toWeakModule x)) := by
  letI := (isSemisimpleModule_modeAlg_iff N).mpr h
  haveI : Module.Finite (modeAlg N.toWeakModule) (cyclic N.toWeakModule x) :=
    Module.Finite.span_of_finite _ (Set.finite_singleton x)
  exact ⟨isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩,
    twoStepSplitting_of_complementedLattice⟩

end VOA.Classification.COne.PlusRational

namespace VOA.Classification.COne

open PlusRational

/-- OPEN, C₂ local-finiteness step (Abe, Theorem 2.7 and proof of Theorem 2.8).
Each cyclic weak submodule of an admissible `V_{2m}⁺`-module has finite composition length.
This is finite length over the mode algebra, not finite dimension over `ℂ`. -/
def V2mPlusCyclicFiniteLengthFactGe2 : Prop :=
  ∀ (m : ℕ) (hm : 1 ≤ m), 2 ≤ m →
    ∀ {M : Type} [AddCommGroup M] [Module ℂ M] (N : AdmissibleModule (V2mPlus m hm) M)
      (x : M), IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x)

/-- OPEN, Abe's Theorem 7.6 in subquotient form, restricted to cyclic modules.
Only extensions with two simple factors are required to split. -/
def V2mPlusTwoStepSplittingFactGe2 : Prop :=
  ∀ (m : ℕ) (hm : 1 ≤ m), 2 ≤ m →
    ∀ {M : Type} [AddCommGroup M] [Module ℂ M] (N : AdmissibleModule (V2mPlus m hm) M)
      (x : M),
      TwoStepSplitting (Submodule (modeAlg N.toWeakModule) (cyclic N.toWeakModule x))

/-- Abe's rationality conclusion follows from the two precise residual facts above. -/
theorem v2mPlusRationalFactGe2_of_finiteLength_twoStepSplitting
    (hfin : V2mPlusCyclicFiniteLengthFactGe2) (hs : V2mPlusTwoStepSplittingFactGe2) :
    V2mPlusRationalFactGe2 := by
  intro m hm hm2 M _ _ N
  exact completelyReducible_of_cyclic_finiteLength_twoStepSplitting N
    (hfin m hm hm2 N) (hs m hm hm2 N)

/-- The reduction is an equivalence: no strengthening or weakening of the rationality
target is concealed in the conjunction of residual facts. -/
theorem v2mPlusRationalFactGe2_iff_finiteLength_twoStepSplitting :
    V2mPlusRationalFactGe2 ↔
      V2mPlusCyclicFiniteLengthFactGe2 ∧ V2mPlusTwoStepSplittingFactGe2 := by
  refine ⟨fun h => ⟨?_, ?_⟩, fun h =>
    v2mPlusRationalFactGe2_of_finiteLength_twoStepSplitting h.1 h.2⟩
  · intro m hm hm2 M _ _ N x
    exact (cyclic_finiteLength_twoStepSplitting_of_completelyReducible N (h m hm hm2 N) x).1
  · intro m hm hm2 M _ _ N x
    exact (cyclic_finiteLength_twoStepSplitting_of_completelyReducible N (h m hm hm2 N) x).2

/-- The `.plus` converse clause with the rationality gap decomposed into cyclic finite
length and simple-extension splitting; neither residual is discharged here. -/
theorem nice_of_hasCOneLabel_plus_of_finiteLength_twoStepSplitting
    (hfin : V2mPlusCyclicFiniteLengthFactGe2) (hs : V2mPlusTwoStepSplittingFactGe2)
    {𝒱 : Type} [AddCommGroup 𝒱] [Module ℂ 𝒱] (V : VertexOperatorAlgebra 𝒱) (m : ℕ)
    (h : HasCOneLabel V (.plus m)) : Nice V ∧ V.centralCharge = 1 :=
  nice_of_hasCOneLabel_plus_of_rational
    (v2mPlusRationalFactGe2_of_finiteLength_twoStepSplitting hfin hs) V m h

end VOA.Classification.COne
