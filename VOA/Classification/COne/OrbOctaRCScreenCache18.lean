-- Exact normalization of at most 231 oscillator monomials.
set_option maxRecDepth 4096 in
theorem sc2821_check :
    reduceTwo (prependC 1 sc2134 ++ scaleR (-1) (prependC 0 sc2135)) = sc2821 := by
  decide +kernel

theorem sc2821_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc2821 = evRc a c (expWordR [1, 1, 1, 1, 2, 2] (7)) := by
  rw [← sc2821_check]
  exact expTwo_step _ _ hc 0 [1, 1, 1, 2, 2] (7)
    sc2134 sc2135 (sc2134_sound a c hc) (sc2135_sound a c hc)

