theorem sc2700_check :
    reduceTwo (prependC 2 sc1957 ++ scaleR (-1) (prependC 0 sc1959)) = sc2700 := by
  decide +kernel

theorem sc2700_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc2700 = evRc a c (expWordR [2, 2, 3, 4, 4] (-1)) := by
  rw [← sc2700_check]
  exact expTwo_step _ _ hc 1 [2, 3, 4, 4] (-1)
    sc1957 sc1959 (sc1957_sound a c hc) (sc1959_sound a c hc)

