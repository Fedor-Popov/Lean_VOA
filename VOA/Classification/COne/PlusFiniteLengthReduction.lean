import VOA.Classification.COne.C2FiniteLengthAlgebra
import VOA.Classification.COne.PlusRationalReduction
import VOA.Classification.COne.PlusC2Final

/-!
# Homogeneous generators and finite windows: a reduction, not the C₂ theorem

The unconditional reduction `cyclic_finiteLength_of_homogeneous` handles an
arbitrary, possibly nonhomogeneous generator. No grading on its cyclic submodule
is presumed. It also gives finite length for every finitely generated submodule.

Two separate inputs would complete the C₂ argument:

* finite-dimensional intersections of a homogeneous cyclic module with each level;
* a finite level window detecting every strict **weak** subquotient of that cyclic
  module. Equivalently, every mode submodule is generated by its intersection with
  this one window (`detectsSubquotients_iff_span_inter_eq`).

`C2HomogeneousCyclicLevelFinite` and `C2HomogeneousCyclicWindowDetects` below are
explicit OPEN facts. This file proves their implication to the exact existing
`V2mPlusCyclicFiniteLengthFactGe2`, using `V2mPlus_c2Cofinite`. Neither input is
claimed to follow from the currently imported spanning-set theorems.

Sources and precise missing bridges:

* Abe, https://arxiv.org/pdf/math/0311210, Theorem 2.7 and §2: local generalized
  `L(0)` decomposition and grading restriction for cyclic generalized weight vectors.
* Abe--Buhl--Dong, https://arxiv.org/pdf/math/0204021, Theorem 3.3 and Lemma 5.5
  (preprint numbering): arbitrary cyclic spanning sets and the generalized weight bridge.
* Huang, https://arxiv.org/pdf/0712.4109, Propositions 3.15 and 4.3: the bounded
  lowest-weight/dimension argument for generalized modules.

The repository's `AdmissibleModule.lev` is not an `L(0)` eigenspace decomposition.
An arbitrary weak submodule need not be graded for `lev`. The detector explicitly
quantifies over all mode submodules, so the reduction does not lose this issue.
`BuhlSpanning.exists_finite_lwGenerated_of_admissible` currently assumes finite
bottom dimension and generation by the bottom. `ZhuFiniteIrr.finite_Φ_of_C2Cofinite`
also assumes a PBW datum and Zhu semisimplicity. They do not discharge these inputs.
-/

namespace VOA.Classification.COne.PlusFiniteLength

open PlusRational FiniteLengthAlgebra

universe u v

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
  {W : VertexOperatorAlgebra 𝒱} {M : Type v} [AddCommGroup M] [Module ℂ M]

/-- It is enough to establish finite length for homogeneous generators. The proof
uses finite sums of finite-length submodules, not gradedness of an arbitrary cyclic. -/
theorem cyclic_finiteLength_of_homogeneous (N : AdmissibleModule W M)
    (h : ∀ (k : ℤ) (x : M), x ∈ N.lev k →
      IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x)) (x : M) :
    IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x) := by
  let F := finiteLengthVectors (modeAlg N.toWeakModule) M
  have htop : (⊤ : Submodule ℂ M) ≤ F.restrictScalars ℂ := by
    rw [← N.lev_iSup_eq_top]
    exact iSup_le (fun k y hy => h k y hy)
  exact htop (Submodule.mem_top : x ∈ (⊤ : Submodule ℂ M))

/-- The same homogeneous input gives finite length for every finitely generated
mode submodule, including those that are not graded. -/
theorem finiteLength_fg_of_homogeneous (N : AdmissibleModule W M)
    (h : ∀ (k : ℤ) (x : M), x ∈ N.lev k →
      IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x))
    (P : Submodule (modeAlg N.toWeakModule) M) (hP : P.FG) :
    IsFiniteLength (modeAlg N.toWeakModule) P :=
  finiteLength_of_fg_of_le_finiteLengthVectors P hP
    (fun x _ => cyclic_finiteLength_of_homogeneous N h x)

/-- A level intersection, as a subspace of the cyclic module. This definition is
meaningful even if the cyclic module is not graded. -/
def cyclicLevel (N : AdmissibleModule W M) (x : M) (j : ℤ) :
    Submodule ℂ (cyclic N.toWeakModule x) :=
  (N.lev j).comap ((cyclic N.toWeakModule x).subtype.restrictScalars ℂ)

/-- Levels `0` through `b`, inside the cyclic module. -/
def cyclicWindow (N : AdmissibleModule W M) (x : M) (b : ℕ) :
    Submodule ℂ (cyclic N.toWeakModule x) :=
  ⨆ j : Fin (b + 1), cyclicLevel N x (j.val : ℤ)

/-- Finite level intersections give finite windows; ambient levels need not be finite. -/
theorem finiteDimensional_cyclicWindow (N : AdmissibleModule W M) (x : M) (b : ℕ)
    (hfd : ∀ j : ℤ, FiniteDimensional ℂ (cyclicLevel N x j)) :
    FiniteDimensional ℂ (cyclicWindow N x b) := by
  letI := hfd
  unfold cyclicWindow
  infer_instance

/-- A finite detecting window gives a bounded composition series for one cyclic. -/
theorem cyclic_compositionSeries_of_window (N : AdmissibleModule W M) (x : M) (b : ℕ)
    (hfd : ∀ j : ℤ, FiniteDimensional ℂ (cyclicLevel N x j))
    (hdet : DetectsSubquotients (R := modeAlg N.toWeakModule) (cyclicWindow N x b)) :
    ∃ c : CompositionSeries (Submodule (modeAlg N.toWeakModule) (cyclic N.toWeakModule x)),
      c.head = ⊥ ∧ c.last = ⊤ ∧ c.length ≤ Module.finrank ℂ (cyclicWindow N x b) := by
  letI := finiteDimensional_cyclicWindow N x b hfd
  exact exists_compositionSeries_length_le _ hdet

/-- Both explicit window inputs are needed only on homogeneous cyclic generators. -/
theorem cyclic_finiteLength_of_homogeneous_windows (N : AdmissibleModule W M)
    (hfd : ∀ (k : ℤ) (x : M), x ∈ N.lev k →
      ∀ j : ℤ, FiniteDimensional ℂ (cyclicLevel N x j))
    (hdet : ∀ (k : ℤ) (x : M), x ∈ N.lev k → ∃ b : ℕ,
      DetectsSubquotients (R := modeAlg N.toWeakModule) (cyclicWindow N x b)) (x : M) :
    IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x) := by
  apply cyclic_finiteLength_of_homogeneous N _ x
  intro k y hy
  obtain ⟨b, hb⟩ := hdet k y hy
  letI := finiteDimensional_cyclicWindow N y b (hfd k y hy)
  exact finiteLength_of_detectsSubquotients _ hb

end VOA.Classification.COne.PlusFiniteLength

namespace VOA.Classification.COne

open PlusFiniteLength FiniteLengthAlgebra PlusRational

/-- OPEN: the level-finiteness part of the cyclic C₂ spanning theorem, restricted
to homogeneous generators. CFT type is built into `VertexOperatorAlgebra`. -/
def C2HomogeneousCyclicLevelFinite : Prop :=
  ∀ {𝒱 : Type} [AddCommGroup 𝒱] [Module ℂ 𝒱] (W : VertexOperatorAlgebra 𝒱),
    C2Cofinite W → ∀ {M : Type} [AddCommGroup M] [Module ℂ M]
      (N : AdmissibleModule W M) (k : ℤ) (x : M), x ∈ N.lev k →
        ∀ j : ℤ, FiniteDimensional ℂ (cyclicLevel N x j)

/-- OPEN: a uniform window for every strict weak subquotient of each homogeneous
cyclic module. This is separate from level finiteness and does not assert it. -/
def C2HomogeneousCyclicWindowDetects : Prop :=
  ∀ {𝒱 : Type} [AddCommGroup 𝒱] [Module ℂ 𝒱] (W : VertexOperatorAlgebra 𝒱),
    C2Cofinite W → ∀ {M : Type} [AddCommGroup M] [Module ℂ M]
      (N : AdmissibleModule W M) (k : ℤ) (x : M), x ∈ N.lev k → ∃ b : ℕ,
        DetectsSubquotients (R := modeAlg N.toWeakModule) (cyclicWindow N x b)

/-- General C₂ finite length, conditional on the two precisely separated missing
VOA inputs. No simplicity, self-duality, or rationality hypothesis is used. -/
theorem c2_cyclic_finiteLength_of_levelFinite_windowDetects
    (hfd : C2HomogeneousCyclicLevelFinite) (hdet : C2HomogeneousCyclicWindowDetects)
    {𝒱 : Type} [AddCommGroup 𝒱] [Module ℂ 𝒱] (W : VertexOperatorAlgebra 𝒱)
    (hC2 : C2Cofinite W) {M : Type} [AddCommGroup M] [Module ℂ M]
    (N : AdmissibleModule W M) (x : M) :
    IsFiniteLength (modeAlg N.toWeakModule) (cyclic N.toWeakModule x) :=
  cyclic_finiteLength_of_homogeneous_windows N (hfd W hC2 N) (hdet W hC2 N) x

/-- The exact existing target follows from these two open C₂ facts. -/
theorem v2mPlusCyclicFiniteLengthFactGe2_of_levelFinite_windowDetects
    (hfd : C2HomogeneousCyclicLevelFinite) (hdet : C2HomogeneousCyclicWindowDetects) :
    V2mPlusCyclicFiniteLengthFactGe2 := by
  intro m hm _ M _ _ N x
  exact c2_cyclic_finiteLength_of_levelFinite_windowDetects hfd hdet
    (V2mPlus m hm) (V2mPlus_c2Cofinite m hm) N x

end VOA.Classification.COne
