    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc4199 = evRc a c (expWordR [1, 1, 1, 1, 1, 1, 1, 2, 2, 2] (1)) := by
  rw [← sc4199_check]
  exact expTwo_step _ _ hc 0 [1, 1, 1, 1, 1, 1, 2, 2, 2] (1)
    sc4053 sc4054 (sc4053_sound a c hc) (sc4054_sound a c hc)

end VOA.Classification.COne.OrbOctaRC
