import VOA.Classification.COne.AutV2m

/-!
# `V₂⁺ ≅ V₈`, and the reflection orbifolds of `V₂`

In `Aut V₂ ≅ PSL₂(ℂ) ≅ SO(3,ℂ)`, both `θ` (the lift of `−1`) and the charge rotation `g_{−1}` are
rotations by `π`, so they are conjugate. Conjugation preserves orbifolds (`orbifold_conj_iso`),
and `V₂^{⟨g_{−1}⟩} ≅ V₈` (`orbifold_cyclic_iso`, `n = 2`). Hence `V₂⁺ ≅ V₈`.

## Coordinates
On `(V₂)₁ ≅ sl₂`, with `xyz a b c = aX + bY + cZ` (`X = e + εf`, `Y = i(e − εf)`, `Z = h`,
`V2Automorphisms.lean`):
* `thetaM1_xyz`: `θ (a,b,c) = (εa, −εb, −c)` (rotation by `π` about `X` if `ε = 1`, about `Y` if
  `ε = −1`);
* `charU_neg_one_xyz`: `g_{−1} (a,b,c) = (−a, −b, c)` (rotation by `π` about `Z`);
* `rot4 (a,b,c) = (−b,a,c)`, `rot2 (a,b,c) = (−a,c,b)`.
The conjugator is `rot2 · rot4` (`ε = 1`: `X ↦ Y ↦ Z`) or `rot2` (`ε = −1`: `Y ↦ Z`).

## Main results
* `exists_conj_theta_eq_charU_neg_one`: `∃ g, g θ g⁻¹ = g_{−1}`.
* `V2Plus_iso_V8 : VOAIsomorphic (V2mPlus 1 le_rfl) (V2m 4 _)`.
* `orbifold_V2_reflection_iso_V8`, `inCOneList_orbifold_V2_reflection`: for every `v ∈ ℂˣ`,
  `V₂^{⟨θ g_v⟩} ≅ V₈`.
* `inCOneList_orbifold_V2_normalizer_all`: every finite subgroup of the torus normalizer of
  `Aut V₂` has its orbifold in the list (completing `inCOneList_orbifold_V2_normalizer`).

## Status
`sorry`-free, no new axioms. Unconditional.
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

open VOA VOA.LatGen VOA.LatGen.Triplet VOA.IntegralLattice HeisenbergN Complex

local notation "V1" => latticeVOAGen (latP 1) (latP_even 1) (latP_posDef 1 le_rfl)

/-! ## The actions of `θ` and `g_{−1}` on `(V₂)₁` -/

theorem thetaM1_vec3 (x₁ x₂ x₃ : ℂ) :
    thetaM 1 le_rfl (vec3 (latP 1) (a1 1) x₁ x₂ x₃) = vec3 (latP 1) (a1 1) x₃ (-x₂) x₁ := by
  simp only [thetaAut_apply, vec3, map_add, map_smul, thetaLat_latChargeGen, thetaLat_hSt',
    neg_neg]
  rw [smul_neg, neg_smul]
  abel

theorem thetaM1_xyz (a b c : ℂ) :
    thetaM 1 le_rfl (xyz a b c) = xyz (eps1 * a) (-eps1 * b) (-c) := by
  rw [xyz, thetaM1_vec3, xyz]
  rcases eps1_cases with h | h <;> rw [h] <;> apply vec3_congr <;> ring

theorem charU_neg_one_xyz (a b c : ℂ) :
    charU 1 le_rfl (-1) (xyz a b c) = xyz (-a) (-b) c := by
  rw [xyz, charU_vec3, xyz]
  simp only [Units.val_neg, Units.val_one, inv_neg, inv_one]
  apply vec3_congr <;> ring

/-- Automorphisms of `V₂` agreeing on the weight-one space `(V₂)₁` are equal. -/
theorem aut_ext_xyz (φ ψ : Aut V1) (h : ∀ a b c, φ (xyz a b c) = ψ (xyz a b c)) : φ = ψ :=
  aut_ext_of_agree 1 le_rfl φ ψ (by rw [hSt_eq_xyz]; exact h _ _ _)
    (by rw [latChargeGen_eq_xyz]; exact h _ _ _)

/-! ## `θ` is conjugate to `g_{−1}` -/

/-- **`θ` and `g_{−1}` are conjugate in `Aut V₂`** (both are rotations by `π`). -/
theorem exists_conj_theta_eq_charU_neg_one :
    ∃ g : Aut V1, MulAut.conj g (thetaM 1 le_rfl) = charU 1 le_rfl (-1) := by
  rcases eps1_cases with hε | hε
  · refine ⟨rot2 * rot4, ?_⟩
    rw [MulAut.conj_apply, mul_inv_eq_iff_eq_mul]
    apply aut_ext_xyz
    intro a b c
    simp only [Aut.mul_apply, thetaM1_xyz, rot4_xyz, rot2_xyz, charU_neg_one_xyz, hε]
    apply xyz_congr <;> ring
  · refine ⟨rot2, ?_⟩
    rw [MulAut.conj_apply, mul_inv_eq_iff_eq_mul]
    apply aut_ext_xyz
    intro a b c
    simp only [Aut.mul_apply, thetaM1_xyz, rot2_xyz, charU_neg_one_xyz, hε]
    apply xyz_congr <;> ring

/-- The cyclic group `ℤ₂ = (cycHom 1 _ 2).range` is generated by `g_{−1}`. -/
theorem zpowers_charU_neg_one :
    Subgroup.zpowers (charU 1 le_rfl (-1)) = (cycHom 1 le_rfl 2).range := by
  ext x
  constructor
  · rintro ⟨k, rfl⟩
    change charU 1 le_rfl (-1) ^ k ∈ _
    rw [← map_zpow, charU_mem_range_cycHom_iff, _root_.mem_rootsOfUnity, ← zpow_natCast, ← zpow_mul,
      mul_comm, zpow_mul, zpow_natCast, neg_one_sq, one_zpow]
  · rintro ⟨z, rfl⟩
    have hz : zmodToUnits 2 z ∈ rootsOfUnity 2 ℂ := (mem_range_zmodToUnits_iff 2 _).mp ⟨z, rfl⟩
    rw [_root_.mem_rootsOfUnity] at hz
    have hz' : ((zmodToUnits 2 z : ℂˣ) : ℂ) ^ 2 = 1 := by
      rw [← Units.val_pow_eq_pow_val, hz, Units.val_one]
    change charU 1 le_rfl (zmodToUnits 2 z) ∈ _
    rcases mul_self_eq_one_iff.mp ((sq _).symm.trans hz') with h | h
    · rw [show zmodToUnits 2 z = 1 from Units.ext h, map_one]
      exact Subgroup.one_mem _
    · rw [show zmodToUnits 2 z = -1 from Units.ext (by simpa using h)]
      exact Subgroup.mem_zpowers _

/-- Equal subgroups have isomorphic orbifolds. -/
theorem orbifold_iso_of_eq {𝒱 : Type*} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
    {G H : Subgroup (Aut W)} (h : G = H) : VOAIsomorphic (orbifoldVOA G) (orbifoldVOA H) := by
  subst h
  exact voaIsomorphic_refl' _

/-- `VOAIsomorphic` between `V2m a` and `V2m b` for `a = b`. -/
theorem voaIso_V2m_of_eq {a b : ℕ} (hab : a = b) (ha : 1 ≤ a) (hb : 1 ≤ b) :
    VOAIsomorphic (V2m a ha) (V2m b hb) := by
  subst hab
  exact voaIsomorphic_refl' _

/-- **`V₂⁺ ≅ V₈`.** -/
theorem V2Plus_iso_V8 : VOAIsomorphic (V2mPlus 1 le_rfl) (V2m 4 (by norm_num)) := by
  obtain ⟨g, hg⟩ := exists_conj_theta_eq_charU_neg_one
  have h := orbifold_conj_iso (W := V2m 1 le_rfl) g (Subgroup.zpowers (thetaV2m 1 le_rfl))
  have hG : (Subgroup.zpowers (thetaV2m 1 le_rfl)).map (MulAut.conj g).toMonoidHom
      = (cycHom 1 le_rfl 2).range := by
    refine (MonoidHom.map_zpowers _ _).trans ?_
    rw [← zpowers_charU_neg_one]
    exact congrArg Subgroup.zpowers hg
  exact voaIso_trans' h (voaIso_trans' (orbifold_iso_of_eq hG)
    (voaIso_trans' (orbifold_cyclic_iso 1 le_rfl 2) (voaIso_V2m_of_eq (by norm_num) _ _)))

/-! ## Reflections `θ g_v` -/

/-- **`V₂^{⟨θ g_v⟩} ≅ V₈`** for every `v ∈ ℂˣ`: `θ g_v` is conjugate to `θ` by `g_w`, `w² = v`. -/
theorem orbifold_V2_reflection_iso_V8 (v : ℂˣ) :
    VOAIsomorphic (orbifoldVOA (Subgroup.zpowers (thetaM 1 le_rfl * charU 1 le_rfl v)))
      (V2m 4 (by norm_num)) := by
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (v : ℂ) two_pos
  have hz0 : z ≠ 0 := by
    rintro rfl
    exact v.ne_zero (by rw [← hz]; ring)
  set w := Units.mk0 z hz0
  have hwv : w⁻¹ * w⁻¹ * v = 1 := by
    rw [← mul_inv, inv_mul_eq_one]
    exact Units.ext (by simp [w, ← hz, sq])
  have h := orbifold_conj_iso (W := V2m 1 le_rfl) (charU 1 le_rfl w)
    (Subgroup.zpowers (thetaM 1 le_rfl * charU 1 le_rfl v))
  have hG : (Subgroup.zpowers (thetaM 1 le_rfl * charU 1 le_rfl v)).map
      (MulAut.conj (charU 1 le_rfl w)).toMonoidHom = Subgroup.zpowers (thetaV2m 1 le_rfl) := by
    rw [MonoidHom.map_zpowers]
    refine congrArg Subgroup.zpowers ?_
    change MulAut.conj (charU 1 le_rfl w) (thetaM 1 le_rfl * charU 1 le_rfl v) = _
    rw [conj_thetaM_charU, hwv, map_one, mul_one]
    rfl
  exact voaIso_trans' h (voaIso_trans' (orbifold_iso_of_eq hG) V2Plus_iso_V8)

/-- The reflection orbifold `V₂^{⟨θ g_v⟩}` is in the list, with label `lat 4`. -/
theorem inCOneList_orbifold_V2_reflection (v : ℂˣ) :
    InCOneList (orbifoldVOA (Subgroup.zpowers (thetaM 1 le_rfl * charU 1 le_rfl v))) :=
  (inCOneList_iff_exists_label _).mpr ⟨.lat 4, by norm_num, orbifold_V2_reflection_iso_V8 v⟩

/-- `V₂⁺` is in the list, with label `lat 4` (the label `plus 1` is invalid). -/
theorem hasCOneLabel_V2Plus : HasCOneLabel (V2mPlus 1 le_rfl) (.lat 4) :=
  ⟨by norm_num, V2Plus_iso_V8⟩

/-! ## All finite subgroups of the torus normalizer of `Aut V₂` -/

/-- **Every finite subgroup of the torus normalizer `{g_u} ⊔ {θ g_u}` of `Aut V₂` has its
orbifold in the list.** This completes `inCOneList_orbifold_V2_normalizer` (which needs a
nontrivial torus element) by the remaining case `G = ⟨θ g_v⟩ ≅ ℤ₂`. -/
theorem inCOneList_orbifold_V2_normalizer_all (G : Subgroup (Aut (V2m 1 le_rfl))) [Finite G]
    (hN : InNormalizer 1 le_rfl G) : InCOneList (orbifoldVOA G) := by
  by_cases hnt : ∃ u : ℂˣ, u ≠ 1 ∧ charU 1 le_rfl u ∈ G
  · exact inCOneList_orbifold_V2_normalizer G hN hnt
  by_cases hθ : ∃ v : ℂˣ, thetaM 1 le_rfl * charU 1 le_rfl v ∈ G
  · obtain ⟨v, hv⟩ := hθ
    push Not at hnt
    have hG : G = Subgroup.zpowers (thetaM 1 le_rfl * charU 1 le_rfl v) := by
      refine le_antisymm (fun g hg => ?_) ((Subgroup.zpowers_le).mpr hv)
      rcases hN g hg with ⟨u, rfl⟩ | ⟨u, rfl⟩
      · by_cases hu : u = 1
        · rw [hu, map_one]; exact Subgroup.one_mem _
        · exact absurd hg (hnt u hu)
      · have hmem : charU 1 le_rfl (v⁻¹ * u) ∈ G := by
          have := G.mul_mem (G.inv_mem hv) hg
          convert this using 1
          change _ = (thetaM 1 le_rfl * charU 1 le_rfl v)⁻¹ * (thetaM 1 le_rfl * charU 1 le_rfl u)
          rw [mul_inv_rev, ← map_inv, mul_assoc, ← mul_assoc (thetaM 1 le_rfl)⁻¹, inv_mul_cancel,
            one_mul, ← map_mul]
        have huv : v⁻¹ * u = 1 := by
          by_contra hne
          exact hnt _ hne hmem
        rw [show u = v from (inv_mul_eq_one.mp huv).symm]
        exact Subgroup.mem_zpowers _
    subst hG
    exact inCOneList_orbifold_V2_reflection v
  · push Not at hθ
    refine inCOneList_orbifold_V2_torus G fun g hg => ?_
    rcases hN g hg with h | ⟨u, rfl⟩
    · exact h
    · exact absurd hg (hθ u)

end VOA.Classification.COne
