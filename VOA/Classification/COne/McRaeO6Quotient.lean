import VOA.Classification.COne.McRaeO5Main

/-! # O6 glue: quotient objects in `LogModuleCat` and epimorphisms are surjective

For a `C₂`-cofinite VOA `W` and an object `N` of `C = LogModuleCat W`:

* `quotObj hC2 N P`: the quotient `N ⧸ P` by a weak submodule `P`, as an object of `C`
  (finitely generated by the image of the generators of `N`, hence of finite length, hence a
  logarithmic module via `logOfFiniteLength`);
* `quotMap hC2 N P : N ⟶ quotObj hC2 N P`, the projection, surjective with kernel `P`;
* `surjective_of_epi`: every epimorphism of `C` is surjective (`g ≫ π_{range g} = 0`).
-/

set_option maxSynthPendingDepth 3
noncomputable section
namespace VOA.Classification.COne.McRaeO6
open CategoryTheory VOA.LogTensor VOA.LogTensor.LogModuleCat

universe u
variable {V : Type u} [AddCommGroup V] [Module ℂ V] {W : VertexOperatorAlgebra V}
variable (hC2 : C2Cofinite W)

/-- The quotient weak module `N ⧸ P`. -/
abbrev quotWeak (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule) :
    WeakModule W (N ⧸ P.carrier) :=
  WeakModule.quotient N.act.toWeakModule P

theorem quotWeak_mode_mk (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule)
    (u : V) (p : ℤ) (x : N) :
    mode ((quotWeak N P).YM u) p (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (mode (N.act.YM u) p x) :=
  WeakModule.quotient_act_mk N.act.toWeakModule P u p x

/-- The quotient of a finitely generated weak module is finitely generated. -/
theorem finGen_quotWeak (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule) :
    FinGen (quotWeak N P) := by
  obtain ⟨S, hS, hgen⟩ := N.finiteGeneration
  refine ⟨P.carrier.mkQ '' S, hS.image _, fun Q hSQ hQ => ?_⟩
  have hc : Q.comap P.carrier.mkQ = ⊤ := by
    apply hgen
    · intro x hx
      exact hSQ ⟨x, hx, rfl⟩
    · intro u m x hx
      change P.carrier.mkQ (mode (N.act.YM u) m x) ∈ Q
      rw [Submodule.mkQ_apply, ← quotWeak_mode_mk]
      exact hQ u m _ hx
  rw [eq_top_iff]
  intro y _
  induction y using Submodule.Quotient.induction_on with
  | H x =>
    have hx : x ∈ Q.comap P.carrier.mkQ := by rw [hc]; exact Submodule.mem_top
    exact hx

include hC2 in
/-- The quotient has finite length over its mode algebra. -/
theorem finiteLength_quotWeak (N : LogModuleCat W)
    (P : WeakModule.Submodule' N.act.toWeakModule) :
    IsFiniteLength (modeAlg (quotWeak N P)) (N ⧸ P.carrier) :=
  VOA.LogTensor.Pz.finiteLength_of_finGen hC2 _ (finGen_quotWeak N P)

/-- **The quotient object** `N ⧸ P` of `C`. -/
def quotObj (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule) :
    LogModuleCat W :=
  LogModuleCat.of (VOA.LogTensor.LogFin.logOfFiniteLength hC2 (quotWeak N P)
    (finiteLength_quotWeak hC2 N P)) (finGen_quotWeak N P)

/-- **The projection** `N ⟶ N ⧸ P` in `C`. -/
def quotMap (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule) :
    N ⟶ quotObj hC2 N P :=
  ⟨P.carrier.mkQ, fun u p r => by
    change Submodule.Quotient.mk (mode (N.act.YM u) p r) =
      mode ((quotWeak N P).YM u) p (Submodule.Quotient.mk r)
    rw [quotWeak_mode_mk]⟩

theorem quotMap_apply (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule)
    (x : N) : (quotMap hC2 N P).1 x = Submodule.Quotient.mk x := rfl

theorem quotMap_surjective (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule) :
    Function.Surjective (quotMap hC2 N P).1 :=
  P.carrier.mkQ_surjective

theorem quotMap_eq_zero_iff (N : LogModuleCat W) (P : WeakModule.Submodule' N.act.toWeakModule)
    (x : N) : (quotMap hC2 N P).1 x = 0 ↔ x ∈ P.carrier :=
  Submodule.Quotient.mk_eq_zero P.carrier

/-- The image of a morphism of `C`, as a weak submodule of the target. -/
def rangeSub {N P : LogModuleCat W} (g : N ⟶ P) : WeakModule.Submodule' P.act.toWeakModule where
  carrier := LinearMap.range g.1
  act_mem u n x hx := by
    obtain ⟨y, rfl⟩ := hx
    exact ⟨mode (N.act.YM u) n y, g.2 u n y⟩

include hC2 in
/-- **Epimorphisms of `C` are surjective.** -/
theorem surjective_of_epi {N P : LogModuleCat W} (g : N ⟶ P) [Epi g] : Function.Surjective g.1 := by
  have h : g ≫ quotMap hC2 P (rangeSub g) = g ≫ 0 := by
    apply hom_ext
    intro x
    change (quotMap hC2 P (rangeSub g)).1 (g.1 x) = 0
    rw [quotMap_eq_zero_iff]
    exact ⟨x, rfl⟩
  have h0 := cancel_epi g |>.mp h
  intro y
  have hy := congrArg (fun k : P ⟶ quotObj hC2 P (rangeSub g) => k.1 y) h0
  change (quotMap hC2 P (rangeSub g)).1 y = 0 at hy
  exact (quotMap_eq_zero_iff hC2 P (rangeSub g) y).mp hy

end VOA.Classification.COne.McRaeO6
