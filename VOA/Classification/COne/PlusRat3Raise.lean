import VOA.Classification.COne.PlusRatTelescope
import VOA.Modules.FiniteGenerationProof
import VOA.Moonshine.CyclicVacuumTrick

/-! # The raising lemma: degree-one vectors of a cyclic top module

General VOA `W`, weak module `A`.  Let `x ∈ Ω(A)` be a top vector on which every zero mode acts by
a scalar (`ScalarTop`).  Let `G` be a set of homogeneous states of positive weight such that
`V = span(iterated products of G) + C₂(V)`.  Then for every homogeneous `a` of weight `k`

  `a₍ₖ₋₂₎ x ∈ span { g₍wt g - 2₎ x : g ∈ G }`          (`raise_mem`).

That is, the degree-one part of the cyclic module generated by `x` is spanned by the degree-one
modes of the generators.  Proof: strong induction on `k`; every state is a combination of
iterated products `g₍₋ₚ₎b` and of `C₂` generators `a₍₋₂₎b`; the Borcherds iterate formula, the
commutator formula and `x ∈ Ω` reduce a product to lower weights (`raise_step`).
-/
set_option maxSynthPendingDepth 3
noncomputable section
namespace VOA.Classification.COne.PlusRat3
open VOA VertexOperatorAlgebra
universe u
variable {V M : Type u} [AddCommGroup V] [Module ℂ V]
  [AddCommGroup M] [Module ℂ M] {W : VertexOperatorAlgebra V}

section Raise
variable (A : WeakModule W M)

/-- A top vector on which every zero mode acts by a scalar. -/
structure ScalarTop (x : M) : Prop where
  omega : x ∈ Omega A
  zero : ∀ (j : ℤ) (c : V), c ∈ W.grading j → ∃ s : ℂ, mode (A.YM c) (j - 1) x = s • x

/-- The span of the degree-one modes of the generators on `x`. -/
def raiseSpan (G : Set V) (x : M) : Submodule ℂ M :=
  Submodule.span ℂ {y | ∃ (j : ℤ) (g : V), g ∈ G ∧ g ∈ W.grading j ∧ y = mode (A.YM g) (j - 2) x}

variable {A}

theorem mem_raiseSpan_of_gen {G : Set V} {x : M} {j : ℤ} {g : V} (hg : g ∈ G)
    (hj : g ∈ W.grading j) : mode (A.YM g) (j - 2) x ∈ raiseSpan A G x :=
  Submodule.subset_span ⟨j, g, hg, hj, rfl⟩

/-- **The product step.**  Let `a ∈ V_α`, `b ∈ V_β`, `p ≥ 1`, `k = α + β + p - 1`, with
`1 ≤ α ∨ 2 ≤ p`.  If every homogeneous state of weight `< k` raises `x` into `S`, and so does `a`,
then so does `a₍₋ₚ₎b`. -/
theorem raise_step {G : Set V} {x : M} (hx : ScalarTop A x) {α β : ℤ} {a b : V}
    (ha : a ∈ W.grading α) (hb : b ∈ W.grading β) (p : ℤ) (hp : 1 ≤ p) (hα0 : 0 ≤ α)
    (_hβ0 : 0 ≤ β) (hap : 1 ≤ α ∨ 2 ≤ p)
    (IH : ∀ (j : ℤ) (c : V), c ∈ W.grading j → j < α + β + p - 1 →
      mode (A.YM c) (j - 2) x ∈ raiseSpan A G x)
    (haS : mode (A.YM a) (α - 2) x ∈ raiseSpan A G x) :
    mode (A.YM (W.smul a (-p) b)) (α + β + p - 1 - 2) x ∈ raiseSpan A G x := by
  set S := raiseSpan A G x
  -- commutator terms `(b_j a)` of degree one lie in `S`
  have hcomm : ∀ q r : ℤ, q + r = α + β - 3 →
      (∑ᶠ j : ℤ, cbz q j • mode (A.YM (W.smul b j a)) (q + r - j) x) ∈ S := by
    intro q r hqr
    apply finsum_mem_submodule_of_forall
    intro j
    by_cases hj : j < 0
    · rw [cbz_apply_neg q hj, zero_smul]; exact S.zero_mem
    · apply S.smul_mem
      have hg := W.toPreVertexAlgebra.smul_mem_grading hb ha j
      have := IH (β + α - j - 1) _ hg (by omega)
      rwa [show β + α - j - 1 - 2 = q + r - j by omega] at this
  rw [module_iterate0 A a b x (-p) _]
  apply finsum_mem_submodule_of_forall
  intro i
  by_cases hi : i < 0
  · rw [cbz_apply_neg _ hi, mul_zero, zero_smul]; exact S.zero_mem
  apply S.smul_mem
  apply S.sub_mem
  · -- first family: `a_{-p-i} b_{k-2+i} x`
    by_cases hd : β ≤ α + β + p - 1 - 2 + i
    · rw [Omega_mode_vanish hx.omega hb hd, map_zero]; exact S.zero_mem
    · have he : α + β + p - 1 - 2 + i = β - 1 := by
        rcases hap with h | h <;> omega
      obtain ⟨s, hs⟩ := hx.zero β b hb
      rw [he, hs, map_smul, show -p - i = α - 2 by omega]
      exact S.smul_mem _ haS
  · apply S.smul_mem
    -- second family: `b_q a_i x`
    by_cases hd : α ≤ i
    · rw [Omega_mode_vanish hx.omega ha hd, map_zero]; exact S.zero_mem
    by_cases h0 : i = α - 1
    · subst h0
      obtain ⟨s, hs⟩ := hx.zero α a ha
      rw [hs, map_smul]
      apply S.smul_mem
      have := IH β b hb (by rcases hap with h | h <;> omega)
      rwa [show -p + (α + β + p - 1 - 2) - (α - 1) = β - 2 by ring]
    by_cases h1 : i = α - 2
    · subst h1
      have hc := mode_commutator A b a x (β - 1) (α - 2)
      rw [sub_eq_iff_eq_add] at hc
      rw [show -p + (α + β + p - 1 - 2) - (α - 2) = β - 1 by ring, hc]
      apply S.add_mem (hcomm _ _ (by ring))
      obtain ⟨s, hs⟩ := hx.zero β b hb
      rw [hs, map_smul]
      exact S.smul_mem _ haS
    · -- `i ≤ α - 3`: `b_q` lowers, commute
      have hq : β ≤ -p + (α + β + p - 1 - 2) - i := by omega
      have hc := mode_commutator A b a x (-p + (α + β + p - 1 - 2) - i) i
      rw [Omega_mode_vanish hx.omega hb hq, map_zero, sub_zero] at hc
      rw [hc]
      exact hcomm _ _ (by ring)


/-- Distinct gradings meet in `0`. -/
theorem eq_zero_of_mem_two_gradings {i j : ℤ} (hij : i ≠ j) {y : V} (hi : y ∈ W.grading i)
    (hj : y ∈ W.grading j) : y = 0 := by
  have h1 := piHom_of_mem W hi
  have h2 := piHom_of_mem_ne W hij.symm hj
  rw [h2] at h1
  exact h1.symm

/-- Iterated products of homogeneous generators of positive weight are homogeneous, and those of
weight `0` are the vacuum or `0`. -/
theorem iterProd_homog {G : Set V} (hG : ∀ g ∈ G, ∃ j : ℤ, 1 ≤ j ∧ g ∈ W.grading j) {y : V}
    (hy : IsIterProd W G y) : ∃ j : ℤ, 0 ≤ j ∧ y ∈ W.grading j ∧ (j = 0 → y = W.vacuum ∨ y = 0) := by
  induction hy with
  | vacuum => exact ⟨0, le_rfl, W.vacuum_mem, fun _ => Or.inl rfl⟩
  | step s hs p hp b _ ih =>
    obtain ⟨α, hα, hsα⟩ := hG s hs
    obtain ⟨β, hβ, hbβ, _⟩ := ih
    refine ⟨α + β + p - 1, by omega, step_mem_grading W hsα hbβ, fun h => by omega⟩

/-- **The raising lemma.** -/
theorem raise_mem {G : Set V} (hG : ∀ g ∈ G, ∃ j : ℤ, 1 ≤ j ∧ g ∈ W.grading j)
    (htop : (⊤ : Submodule ℂ V) = Submodule.span ℂ {y | IsIterProd W G y} ⊔ O₂ W)
    {x : M} (hx : ScalarTop A x) :
    ∀ (k : ℤ) (a : V), a ∈ W.grading k → mode (A.YM a) (k - 2) x ∈ raiseSpan A G x := by
  set S := raiseSpan A G x
  suffices H : ∀ N : ℕ, ∀ (k : ℤ) (a : V), a ∈ W.grading k → k < N →
      mode (A.YM a) (k - 2) x ∈ S by
    intro k a ha
    exact H (k.toNat + 1) k a ha (by omega)
  intro N
  induction N with
  | zero =>
    intro k a ha hk
    rw [W.positivity k (by omega), Submodule.mem_bot] at ha
    subst ha
    rw [map_zero, mode_zero, LinearMap.zero_apply]
    exact S.zero_mem
  | succ N ih =>
    intro k a ha hk
    by_cases hkN : k < N
    · exact ih k a ha hkN
    have IH : ∀ (j : ℤ) (c : V), c ∈ W.grading j → j < k →
        mode (A.YM c) (j - 2) x ∈ S := fun j c hc hj => ih j c hc (by omega)
    -- the generator case
    have hgen : ∀ y : V, (IsIterProd W G y ∨ y ∈ O₂homGen W) → y ∈ W.grading k →
        mode (A.YM y) (k - 2) x ∈ S := by
      intro y hy hyk
      rcases hy with hy | ⟨p, q, a', b', ha', hb', rfl⟩
      · cases hy with
        | vacuum =>
          by_cases hk1 : k = 1
          · subst hk1
            have h0 := eq_zero_of_mem_two_gradings (W := W) (show (1 : ℤ) ≠ 0 by norm_num) hyk
              W.vacuum_mem
            rw [h0, map_zero, mode_zero, LinearMap.zero_apply]; exact S.zero_mem
          · have := A.act_vacuum (k - 2) x
            rw [WeakModule.act_def] at this
            rw [this, if_neg (by omega)]; exact S.zero_mem
        | step s hs p hp b hb =>
          obtain ⟨α, hα, hsα⟩ := hG s hs
          obtain ⟨β, hβ, hbβ, hb0⟩ := iterProd_homog hG hb
          have hyg := step_mem_grading W (m := p) hsα hbβ
          by_cases hkk : k = α + β + p - 1
          · subst hkk
            by_cases hspec : p = 1 ∧ β = 0
            · obtain ⟨rfl, rfl⟩ := hspec
              rcases hb0 rfl with rfl | rfl
              · rw [show W.smul s (-1) W.vacuum = s from (W.creation s).1]
                rw [show α + 0 + 1 - 1 - 2 = α - 2 by ring]
                exact mem_raiseSpan_of_gen hs hsα
              · rw [W.smul_zero_right, map_zero, mode_zero, LinearMap.zero_apply]; exact S.zero_mem
            · exact raise_step hx hsα hbβ p hp (by omega) hβ (Or.inl hα) IH
                (mem_raiseSpan_of_gen hs hsα)
          · have h0 := eq_zero_of_mem_two_gradings (W := W) hkk hyk hyg
            rw [h0, map_zero, mode_zero, LinearMap.zero_apply]; exact S.zero_mem
      · by_cases hz : W.smul a' (-2) b' = 0
        · rw [hz, map_zero, mode_zero, LinearMap.zero_apply]; exact S.zero_mem
        have hyg := gen_mem_grading W ha' hb'
        have hpq := factor_deg_lt W ha' hb' rfl hz
        have hp0 : 0 ≤ p := by
          by_contra hneg
          apply hz
          rw [W.positivity p (by omega), Submodule.mem_bot] at ha'
          rw [ha', W.smul_zero_left]
        have hq0 : 0 ≤ q := by
          by_contra hneg
          apply hz
          rw [W.positivity q (by omega), Submodule.mem_bot] at hb'
          rw [hb', W.smul_zero_right]
        by_cases hkk : k = p + q + 1
        · subst hkk
          have := raise_step hx ha' hb' 2 (by norm_num) hp0 hq0 (Or.inr le_rfl)
            (fun j c hc hj => IH j c hc (by omega)) (IH p a' ha' (by omega))
          rwa [show p + q + 2 - 1 - 2 = p + q + 1 - 2 by ring] at this
        · exact absurd (eq_zero_of_mem_two_gradings (W := W) hkk hyk hyg) hz
    -- span induction on the projection to weight `k`
    have hspan : a ∈ Submodule.span ℂ ({y | IsIterProd W G y} ∪ O₂homGen W) := by
      have hmem : a ∈ (⊤ : Submodule ℂ V) := Submodule.mem_top
      rw [htop, O₂_eq_span_homGen, ← Submodule.span_union] at hmem
      exact hmem
    have hproj : ∀ y ∈ Submodule.span ℂ ({y | IsIterProd W G y} ∪ O₂homGen W),
        mode (A.YM (piHom W k y)) (k - 2) x ∈ S := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy =>
        have hyh : ∃ d : ℤ, y ∈ W.grading d := by
          rcases hy with hy | hy
          · obtain ⟨d, _, hd, _⟩ := iterProd_homog hG hy; exact ⟨d, hd⟩
          · exact O₂homGen_homog W hy
        obtain ⟨d, hd⟩ := hyh
        by_cases hdk : d = k
        · subst hdk
          rw [piHom_of_mem W hd]
          exact hgen y hy hd
        · rw [piHom_of_mem_ne W hdk hd, map_zero, mode_zero, LinearMap.zero_apply]
          exact S.zero_mem
      | zero => rw [map_zero, map_zero, mode_zero, LinearMap.zero_apply]; exact S.zero_mem
      | add y z _ _ hy hz => rw [map_add, map_add, mode_add, LinearMap.add_apply]; exact S.add_mem hy hz
      | smul c y _ hy => rw [map_smul, map_smul, mode_smul, LinearMap.smul_apply]; exact S.smul_mem c hy
    have := hproj a hspan
    rwa [piHom_of_mem W ha] at this

end Raise

end VOA.Classification.COne.PlusRat3
