theorem vectorPartial4_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector prefixVector4) = evalSym W k a (symMap vectorPartial4) := by
  rw [prefixVector4, evalSym_vector_append, vectorPartial3_sound W k a,
    vectorChunk4_sound W k a]
  have hh := equalRawCheck_sound W k a vectorPartial4_check
  rw [symMap_append, evalSym_append] at hh
  simpa only [add_comm] using hh

