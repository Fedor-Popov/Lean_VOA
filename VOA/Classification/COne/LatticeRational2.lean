import VOA.Classification.COne.LatticeRational
import VOA.Classification.COne.LatticeModulesIrred
import VOA.Modules.Translation

/-!
# Rationality of `V_{2m}`: `V2m_admissiblyRational`

Continues `LatticeRational.lean` (stage S1: `M ≅ M(1) ⊗ Ω` for every admissible module, with
`Ω = {x : h(n) x = 0, n > 0}`).  This file completes C3:

  `V2m_admissiblyRational : AdmissiblyRational (V2m m hm)`   (`1 ≤ m`, no other hypothesis).

No formal exponentials `E^±` and no `Z`-operators are used: everything is extracted from the module
Jacobi identity at a few well-chosen `(ℓ, m, n)`, plus the S1 Fock decomposition.

## The route (with `h = h(-1)𝟙` unit-normalised, `c_β = chargeCoord β`, `c_α² = 2m`)

**§1–§2 (abstract Heisenberg).**  `HeisRep.proj : M → Ω`, the Fock-degree-zero component; it kills
the image of every creation mode (`proj_cr`) and commutes with `a(0)` (`proj_a_zero`).
`proj_charge_mem`: if `[a(p), e(q)] = c e(p+q)` and `π e(k) a(0) = -((k+1)/c) π e(k)` on `Ω`, then
every `π(e(k) y)` is a sum of `a(0)`-eigenvectors in `Ω` with eigenvalues `c - (k'+1)/c`.

**§3 (S2).**  `proj_charge_der` — the derivative relation, from `act_T_covariance`,
`L(-1)e^β = c_β h_(-1) e^β` (`V2m_smul_charge_neg_two`) and the module iterate formula at
`ℓ = -1`.  `vac_le_eigSpan` — **`h(0)` is semisimple on `Ω` with spectrum in `(1/c_α)ℤ`**: the
Jacobi identity for `(e^{-α}, e^{α})` at `ℓ = 2m-1` writes `ε x` (`ε = ε(-α,α) ≠ 0`) as a sum of
`e^{-α}`-modes, and `π` of those lands in the eigen-span.  `iSup_eigenspace_eq_top` — hence
`h(0)` is semisimple on all of `M`.

**§4 (any weak module, vacuum eigenvector `ω`, `h(0)ω = λω`, `c_β λ = -N₁ ∈ ℤ`).**
`charge_top`, `charge_recursion` (`(-n - c_β λ) e^β_(n-1) ω = c_β ∑_{i≥0} h(-1-i) e^β_(n+i) ω`),
`charge_vanish` (`e^β_(k) ω = 0` for `k ≥ N₁`), `charge_top_vac` (`e^β_(N₁-1) ω ∈ Ω`, eigenvalue
`λ + c_β`), `charge_rel` (`e^{-β}_(⟨β,β⟩-1-N₁) e^β_(N₁-1) ω = ε(-β,β) ω`: the Jacobi identity at
`ℓ = ⟨β,β⟩-1, m = -N₁, n = N₁-1`, where vanishing kills all but one term on each side).

**§5 (S3).**  `vac_raise`, `vac_lower`: `c(±α)` maps `Ω_{j/c_α} → Ω_{(j±2m)/c_α}`, and the
composite back is the nonzero scalar `ε`.  (So `λ ∈ L°` automatically: the spectrum is `(1/c_α)ℤ`.)

**§7–§9 (S4).**  For a vacuum eigenvector `w`: the charge orbit `wseq` (`w_k = c(α)^k w`,
`c(-α)^{-k} w`), with `raise_wseq`/`lower_wseq` and `wseq_mem_iff` (a weak submodule containing one
`w_k` contains all).  The orbit span `T = span{p(h)·w_k}` is stable under the `h`-modes and, by
`charge_modes_mem` (downward recursion from the top vector), under the `e^{±α}`-modes; the states
preserving `T` (`presSub`) are closed under all products, contain every `e^{kα}`
(`V2m_smul_charge_charge_top`), hence are everything (`latVOA_generated`): `orbitSub` is a weak
submodule, the one generated by `w` (`orbitSub_le`).  `orbitSub_isSimple`: a nonzero weak
`Q ≤ T` meets `Ω` (`HeisRep.eq_zero_of_inf_vac`), `Ω ∩ T ⊆ span{w_k}` (`proj_evalOp`), the `w_k`
have distinct `h(0)`-eigenvalues (`LatMod.sum_filter_eigen_mem`), so some `w_k ∈ Q`, so `w ∈ Q`.
`mem_iSup_simple`: these orbit submodules span `M` (S2 + `eq_top_of_vac_le`).

**§2b (generic).**  `exists_isCompl_of_sum_simple`: a weak module spanned by irreducible weak
submodules is completely reducible — Mathlib's `IsSemisimpleModule` over the mode algebra
`modeAlg` (`toR`/`ofR` identify its submodules with the weak submodules).
`admissiblyRational_V2m_of_sum_simple` + `mem_iSup_simple` give the headline.

## Not done here
* The identification of each `orbitSub` with some `LatMod.latticeModule m hm j` (the
  classification of irreducibles: `V_{L+λ_j}`, `j mod 2m`) is **not** needed for
  `AdmissiblyRational` and is not proved.  Route: `moduleEquivOfCharge`, with the uniqueness of
  `e^β_(k) ω` given its top vector (`charge_recursion`) on both sides.
* Not imported by the umbrella `VOA/Classification.lean`.

## Status
No `sorry`, no new axioms.  `#print axioms V2m_admissiblyRational`:
`[propext, Classical.choice, Quot.sound]`.  Unconditional: the only hypothesis is `1 ≤ m`.
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

namespace HeisSvN

namespace HeisRep

open Module (End)
open MvPolynomial

variable {M : Type*} [AddCommGroup M] [Module ℂ M] (H : HeisRep M)

/-! ## §1  The projection `π : M → Ω` onto the Fock-degree-zero component -/

/-- The projection `π : M → Ω` onto the `M(1)`-degree-zero component of `M ≅ M(1) ⊗ Ω`. -/
noncomputable def proj : M →ₗ[ℂ] H.vac :=
  (Finsupp.lapply 0).comp H.fockEquiv.symm.toLinearMap

theorem fockEquiv_symm_vac (ω : H.vac) : H.fockEquiv.symm ω = Finsupp.single 0 ω := by
  rw [LinearEquiv.symm_apply_eq, fockEquiv_apply, fockMap_single_zero]

theorem proj_vac (ω : H.vac) : H.proj ω = ω := by
  simp [proj, fockEquiv_symm_vac]

theorem proj_of_mem_vac {x : M} (hx : x ∈ H.vac) : (H.proj x : M) = x := by
  have := H.proj_vac ⟨x, hx⟩
  rw [this]

theorem cr_fockMap (i : ℕ) (f : (ℕ →₀ ℕ) →₀ H.vac) :
    H.cr i (H.fockMap f) = H.fockMap (Finsupp.mapDomain (fun s => Finsupp.single i 1 + s) f) := by
  induction f using Finsupp.induction_linear with
  | zero => simp
  | add f g hf hg => rw [map_add, map_add, hf, hg, Finsupp.mapDomain_add, map_add]
  | single s ω =>
    rw [Finsupp.mapDomain_single, fockMap_single, fockMap_single, ← evalOp_X,
      ← Module.End.mul_apply, ← map_mul, X, monomial_mul, one_mul]

/-- `π` kills the image of every creation operator. -/
theorem proj_cr (i : ℕ) (y : M) : H.proj (H.cr i y) = 0 := by
  obtain ⟨f, rfl⟩ := H.fockMap_surjective y
  rw [cr_fockMap]
  simp only [proj, LinearMap.comp_apply, LinearEquiv.coe_coe, ← fockEquiv_apply,
    LinearEquiv.symm_apply_apply, Finsupp.lapply_apply]
  apply Finsupp.mapDomain_notin_range
  rintro ⟨s, hs⟩
  have := congrArg (fun t : ℕ →₀ ℕ => t i) hs
  simp at this

theorem proj_a_neg {n : ℤ} (hn : n < 0) (y : M) : H.proj (H.a n y) = 0 := by
  obtain ⟨i, rfl⟩ : ∃ i : ℕ, n = -((i : ℤ) + 1) := ⟨(-n - 1).toNat, by omega⟩
  exact H.proj_cr i y

/-- `π` commutes with the zero mode. -/
theorem proj_a_zero (y : M) : (H.proj (H.a 0 y) : M) = H.a 0 (H.proj y) := by
  obtain ⟨f, rfl⟩ := H.fockMap_surjective y
  rw [← H.fockMap_vacZero]
  simp only [proj, LinearMap.comp_apply, LinearEquiv.coe_coe, ← fockEquiv_apply,
    LinearEquiv.symm_apply_apply, Finsupp.lapply_apply, Finsupp.mapRange.linearMap_apply,
    Finsupp.mapRange_apply]
  rfl

/-! ## §2  Charge operators and the spectral span -/

/-- The span of the `a(0)`-eigenvectors **in `Ω`** with eigenvalue in `S`. -/
def eigSpan (S : Set ℂ) : Submodule ℂ M :=
  Submodule.span ℂ {v | v ∈ H.vac ∧ ∃ μ ∈ S, H.a 0 v = μ • v}

theorem eigSpan_le_vac (S : Set ℂ) : H.eigSpan S ≤ H.vac := by
  rw [eigSpan, Submodule.span_le]
  rintro v ⟨hv, -⟩
  exact hv

/-- **The spectral lemma.**  Let `e(q)` be operators with `[a(p), e(q)] = c e(p+q)` (`c ≠ 0`), and
suppose that on `Ω` the derivative relation `π e(k) a(0) = -((k+1)/c) π e(k)` holds.  Then for
every `y ∈ M` and `k`, `π(e(k) y)` is a sum of `a(0)`-eigenvectors with eigenvalues
`c - (k'+1)/c`, `k' ∈ ℤ`.  (Induction over `M = M(1)·Ω`: a creation operator commutes past `e`
up to a shifted `e`, and is then killed by `π`.) -/
theorem proj_charge_mem (e : ℤ → End ℂ M) (c : ℂ) (S : Set ℂ)
    (hS : ∀ k : ℤ, c - ((k : ℂ) + 1) / c ∈ S)
    (hcomm : ∀ (p q : ℤ) (x : M), H.a p (e q x) - e q (H.a p x) = c • e (p + q) x)
    (hder : ∀ (k : ℤ) (ω : M), ω ∈ H.vac →
      (H.proj (e k (H.a 0 ω)) : M) = (-((k : ℂ) + 1) / c) • (H.proj (e k ω) : M))
    (y : M) (k : ℤ) : (H.proj (e k y) : M) ∈ H.eigSpan S := by
  let T : Submodule ℂ M :=
    { carrier := {y | ∀ k : ℤ, (H.proj (e k y) : M) ∈ H.eigSpan S}
      add_mem' := by
        intro x y hx hy k
        simp only [Set.mem_setOf_eq, map_add, Submodule.coe_add] at hx hy ⊢
        exact Submodule.add_mem _ (hx k) (hy k)
      zero_mem' := by intro k; simp
      smul_mem' := by
        intro r x hx k
        simp only [Set.mem_setOf_eq, map_smul, Submodule.coe_smul] at hx ⊢
        exact Submodule.smul_mem _ r (hx k) }
  have hT : T = ⊤ := by
    refine H.eq_top_of_vac_le T ?_ ?_
    · intro ω hω k
      refine Submodule.subset_span ⟨(H.proj (e k ω)).2, c - ((k : ℂ) + 1) / c, hS k, ?_⟩
      have h1 := hcomm 0 k ω
      rw [zero_add, sub_eq_iff_eq_add] at h1
      rw [← proj_a_zero, h1, map_add, map_smul, Submodule.coe_add, Submodule.coe_smul,
        hder k ω hω, ← add_smul]
      congr 1
      ring
    · intro n hn y hy k
      have h1 := hcomm n k y
      rw [sub_eq_iff_eq_add] at h1
      have h2 : e k (H.a n y) = H.a n (e k y) - c • e (n + k) y := by
        rw [h1]; abel
      rw [h2, map_sub, H.proj_a_neg hn, zero_sub, map_smul, Submodule.coe_neg,
        Submodule.coe_smul]
      exact Submodule.neg_mem _ (Submodule.smul_mem _ c (hy (n + k)))
  have hy : y ∈ T := by rw [hT]; trivial
  exact hy k

end HeisRep

end HeisSvN

theorem finsum_mem_submodule' {M : Type*} [AddCommGroup M] [Module ℂ M] (S : Submodule ℂ M)
    (f : ℤ → M) (hf : ∀ i, f i ∈ S) : ∑ᶠ i, f i ∈ S := by
  by_cases h : (Function.support f).Finite
  · rw [finsum_eq_sum f h]
    exact Submodule.sum_mem S fun i _ => hf i
  · rw [finsum_of_infinite_support h]; exact S.zero_mem

/-! ## §2b  S4, last step: a sum of irreducible weak submodules is completely reducible -/

section CompleteReducibility

universe u v

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
  {M : Type v} [AddCommGroup M] [Module ℂ M] (A : WeakModule W M)

open Module (End)

/-- The **mode algebra**: the subalgebra of `End M` generated by all modes `u_(n)`. -/
def modeAlg : Subalgebra ℂ (End ℂ M) :=
  Algebra.adjoin ℂ {f | ∃ (u : 𝒱) (n : ℤ), f = mode (A.YM u) n}

theorem modeAlg_preserves (P : WeakModule.Submodule' A) {f : End ℂ M} (hf : f ∈ modeAlg A) :
    ∀ x ∈ P.carrier, f x ∈ P.carrier := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    obtain ⟨u, n, rfl⟩ := hf
    intro x hx
    exact P.act_mem u n hx
  | algebraMap c =>
    intro x hx
    rw [Module.algebraMap_end_apply]
    exact P.carrier.smul_mem c hx
  | add f g _ _ hf hg => intro x hx; exact P.carrier.add_mem (hf x hx) (hg x hx)
  | mul f g _ _ hf hg => intro x hx; exact hf _ (hg x hx)

/-- A weak submodule as a module-algebra submodule. -/
def toR (P : WeakModule.Submodule' A) : Submodule (modeAlg A) M where
  carrier := P.carrier
  add_mem' := P.carrier.add_mem
  zero_mem' := P.carrier.zero_mem
  smul_mem' r x hx := modeAlg_preserves A P r.2 x hx

/-- A module-algebra submodule as a weak submodule. -/
def ofR (Q : Submodule (modeAlg A) M) : WeakModule.Submodule' A where
  carrier := Q.restrictScalars ℂ
  act_mem u n _ hx := Q.smul_mem ⟨mode (A.YM u) n, Algebra.subset_adjoin ⟨u, n, rfl⟩⟩ hx

/-- An **irreducible weak submodule**: nonzero, with no weak submodules strictly in between. -/
def IsSimpleSub (P : WeakModule.Submodule' A) : Prop :=
  P.carrier ≠ ⊥ ∧ ∀ Q : WeakModule.Submodule' A, Q.carrier ≤ P.carrier →
    Q.carrier = ⊥ ∨ Q.carrier = P.carrier

theorem isAtom_toR {P : WeakModule.Submodule' A} (hP : IsSimpleSub A P) : IsAtom (toR A P) := by
  refine ⟨fun h => hP.1 ?_, fun b hb => ?_⟩
  · ext x
    have := congrArg (fun Q : Submodule (modeAlg A) M => x ∈ Q) h
    simpa [toR] using this
  · have hle : (ofR A b).carrier ≤ P.carrier := fun x hx => hb.le hx
    rcases hP.2 (ofR A b) hle with h | h
    · ext x
      have := congrArg (fun Q : Submodule ℂ M => x ∈ Q) h
      simpa [ofR] using this
    · exfalso
      apply hb.ne
      ext x
      have := congrArg (fun Q : Submodule ℂ M => x ∈ Q) h
      simpa [ofR, toR] using this

/-- **Complete reducibility from a sum of irreducibles.**  If every vector of a weak module lies
in the span of its irreducible weak submodules, then every weak submodule has a weak complement.
(Mathlib's `IsSemisimpleModule` over the mode algebra.) -/
theorem exists_isCompl_of_sum_simple
    (h : ∀ x : M, x ∈ ⨆ (P : WeakModule.Submodule' A) (_ : IsSimpleSub A P), P.carrier)
    (P : WeakModule.Submodule' A) :
    ∃ Q : WeakModule.Submodule' A, IsCompl P.carrier Q.carrier := by
  haveI : IsSemisimpleModule (modeAlg A) M := by
    refine IsSemisimpleModule.of_sSup_simples_eq_top ?_
    rw [eq_top_iff]
    intro x _
    have hx := h x
    have hle : (⨆ (P : WeakModule.Submodule' A) (_ : IsSimpleSub A P), P.carrier)
        ≤ (sSup {m : Submodule (modeAlg A) M | IsSimpleModule (modeAlg A) m}).restrictScalars ℂ := by
      refine iSup_le fun P => iSup_le fun hP => fun y hy => ?_
      have hmem : toR A P ∈ {m : Submodule (modeAlg A) M | IsSimpleModule (modeAlg A) m} :=
        isSimpleModule_iff_isAtom.mpr (isAtom_toR A hP)
      exact (le_sSup hmem : toR A P ≤ _) hy
    exact hle hx
  obtain ⟨Q, hQ⟩ := exists_isCompl (toR A P)
  refine ⟨ofR A Q, ?_⟩
  have := hQ.map (Submodule.restrictScalarsLatticeHom ℂ (modeAlg A) M)
  exact this

end CompleteReducibility

/-! ## §3  The `V_{2m}` inputs: the derivative relation and the `e^{-α}·e^{α}` relation -/

section V2mS2

open VOA VOA.IntegralLattice VOA.LatGen VOA.LatGen.Triplet HeisenbergN MvPolynomial LatMod
open VertexOperatorAlgebra

variable {m : ℕ} {hm : 1 ≤ m} {M : Type*} [AddCommGroup M] [Module ℂ M]

theorem V2m_vacuum : (V2m m hm).vacuum = latVacuumGen (latP m) := rfl

theorem vSchur_one_rankOne (β : ℤ) :
    vSchur (latP m) β 1 = chargeCoord (latP m) β (a0 m) • (X ((0 : ℕ), a0 m) : FockN (rank (latP m))) := by
  rw [vSchur_succ]
  simp only [Nat.cast_zero, zero_add, inv_one, one_smul, Finset.range_one, Finset.sum_singleton,
    Nat.sub_self, vSchur_zero, mul_one, vVar]
  refine Finset.sum_eq_single (a0 m) (fun b _ hb => ?_) (fun h => absurd (Finset.mem_univ _) h)
  exfalso
  apply hb
  have hb1 : b.val < 1 := lt_of_lt_of_eq b.isLt (rank_latP m)
  exact Fin.ext (by simp only [a0]; omega)

/-- `L(-1) e^β = β(-1) e^β` in the form `e^β_(-2) 𝟙 = c_β · h_(-1) e^β`. -/
theorem V2m_smul_charge_neg_two (β : ℤ) :
    (V2m m hm).smul (latChargeGen (latP m) β) (-2) (V2m m hm).vacuum
      = chargeCoord (latP m) β (a0 m) • (V2m m hm).smul (hb m) (-1) (latChargeGen (latP m) β) := by
  rw [V2m_vacuum, latVacuumGen, V2m, latVOA_smul_latChargeGen_state, latticeCocycle_zero_right,
    one_smul, latP_form]
  have e1 : ((- -2 - 1 - 2 * (m : ℤ) * β * 0 : ℤ)) = ((1 : ℕ) : ℤ) := by ring
  have e2 : ((show (latP m).carrier from β) + (0 : (latP m).carrier)) = β := add_zero _
  erw [e1, e2]
  rw [EEVec_vacuum, if_pos (by norm_num),
    show ((1 : ℕ) : ℤ).toNat = 1 from rfl, vSchur_one_rankOne, hb,
    show (-1 : ℤ) = -((0 : ℕ) : ℤ) - 1 by norm_num, latChargeGen,
    latVOA_smul_bosonState, vacuumN, mul_one, latStateGen_csmul]

/-- `e^{-β}_(n) e^{β}` in `V_{2m}`. -/
theorem V2m_smul_neg_charge (β n : ℤ) :
    (V2m m hm).smul (latChargeGen (latP m) (-β)) n (latChargeGen (latP m) β)
      = latticeCocycle (latP m) (-β) β • latStateGen (latP m)
          (EEVec (latP m) (-β) (-n - 1 + 2 * m * β * β) (vacuumN _)) 0 := by
  rw [V2m, show latChargeGen (latP m) β = latStateGen (latP m) (vacuumN _) β from rfl,
    latVOA_smul_latChargeGen_state, latP_form]
  have e2 : (-β + β : (latP m).carrier) = 0 := neg_add_cancel β
  have e1 : (-n - 1 - 2 * (m : ℤ) * -β * β : ℤ) = -n - 1 + 2 * m * β * β := by ring
  erw [e1, e2]
  rfl

/-- The `L(-1)`-derivative relation on the vacuum space: for `x ∈ Ω` and every `k`,
`π(e^β_(k) h(0) x) = -((k+1)/c_β) π(e^β_(k) x)`.  From module translation covariance
(`act_T_covariance`), `L(-1) e^β = c_β h_(-1) e^β`, and the module iterate formula at `ℓ = -1`
(all terms but one carry a creation operator `h(-1-i)` on the left, killed by `π`). -/
theorem proj_charge_der (N : AdmissibleModule (V2m m hm) M) (β : ℤ)
    (hβ : chargeCoord (latP m) β (a0 m) ≠ 0) (k : ℤ) (x : M)
    (hx : x ∈ (admissibleHeisRep N).vac) :
    ((admissibleHeisRep N).proj (mode (N.YM (latChargeGen (latP m) β)) k
        ((admissibleHeisRep N).a 0 x)) : M)
      = (-((k : ℂ) + 1) / chargeCoord (latP m) β (a0 m)) •
          ((admissibleHeisRep N).proj (mode (N.YM (latChargeGen (latP m) β)) k x) : M) := by
  have ha : ∀ n y, (admissibleHeisRep N).a n y = mode (N.YM (hb m)) n y := fun _ _ => rfl
  set H := admissibleHeisRep N with hH
  set e := latChargeGen (latP m) β
  set c := chargeCoord (latP m) β (a0 m)
  -- translation covariance
  have hT := act_T_covariance N.toWeakModule e (k + 1) x
  have hL : (V2m m hm).L (-1) e = (V2m m hm).smul e (-2) (V2m m hm).vacuum := by
    have hc := creation_pow (V2m m hm) e 1
    simp only [pow_one, Nat.factorial_one, Nat.cast_one, inv_one, one_smul] at hc
    rw [T_eq_Lneg1, show (-(1 : ℤ) - 1) = -2 from by norm_num] at hc
    exact hc.symm
  rw [hL, V2m_smul_charge_neg_two, WeakModule.act_def, WeakModule.act_def, map_smul, mode_smul,
    LinearMap.smul_apply, show k + 1 - 1 = k by ring] at hT
  -- the iterate formula
  have hI := module_iterate0 N.toWeakModule (hb m) e x (-1) (k + 1)
  obtain ⟨Ne, hNe⟩ := N.truncation e x
  set f : ℤ → M := fun i => (negOnePow i * cbz (-1) i) •
    (mode (N.YM (hb m)) (-1 - i) (mode (N.YM e) (k + 1 + i) x)
      - negOnePow (-1) • mode (N.YM e) (-1 + (k + 1) - i) (mode (N.YM (hb m)) i x)) with hf
  have hsupp : Function.support f ⊆ (Finset.Icc 0 (max (Ne - (k + 1)) 1) : Set ℤ) := by
    intro i hi
    rw [Function.mem_support] at hi
    simp only [Finset.coe_Icc, Set.mem_Icc]
    by_contra hni
    apply hi
    rcases lt_or_ge i 0 with hneg | hnn
    · rw [hf]; simp only; rw [cbz_apply_neg _ hneg, mul_zero, zero_smul]
    · have hgt : max (Ne - (k + 1)) 1 < i := by
        by_contra h; exact hni ⟨hnn, by omega⟩
      rw [hf]; simp only
      rw [hNe (k + 1 + i) (by omega), ← ha i x, (H.mem_vac.mp hx) i (by omega), map_zero, map_zero,
        smul_zero, sub_zero, smul_zero]
  rw [finsum_eq_sum_of_support_subset f hsupp] at hI
  have hproj := congrArg (fun y => (H.proj y : M)) hI
  simp only [map_sum, Submodule.coe_sum] at hproj
  rw [Finset.sum_eq_single 0] at hproj
  · -- the `i = 0` term
    have h0 : (H.proj (f 0) : M) = (H.proj (mode (N.YM e) k (H.a 0 x)) : M) := by
      rw [hf]
      simp only
      rw [map_smul, map_sub, map_smul, ← ha (-1 - 0) _, ← ha 0 x, H.proj_a_neg (by norm_num)]
      simp [negOnePow, cbz_apply_nonneg, gBinom]
    rw [h0] at hproj
    rw [← hproj]
    have hT' := congrArg (fun y => (H.proj y : M)) hT
    simp only [map_smul, Submodule.coe_smul] at hT'
    rw [show mode (N.YM e) k x = mode (N.YM e) k x from rfl] at hT'
    have : (H.proj (mode (N.YM ((V2m m hm).smul (hb m) (-1) e)) (k + 1) x) : M)
        = c⁻¹ • ((-((k + 1 : ℤ) : ℂ)) • (H.proj (mode (N.YM e) k x) : M)) := by
      rw [← hT', smul_smul, inv_mul_cancel₀ hβ, one_smul]
    rw [this, smul_smul]
    congr 1
    push_cast
    field_simp
  · intro i hi hi0
    have hipos : 0 < i := by
      rw [Finset.mem_Icc] at hi; omega
    rw [hf]
    simp only
    rw [map_smul, map_sub, map_smul, ← ha (-1 - i) _, ← ha i x, H.proj_a_neg (by omega),
      (H.mem_vac.mp hx) i hipos, map_zero, map_zero, smul_zero, sub_zero, smul_zero,
      Submodule.coe_zero]
  · intro h
    exact absurd (Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩) h

theorem chargeCoord_sq_rankOne (hm : 1 ≤ m) :
    chargeCoord (latP m) (1 : ℤ) (a0 m) * chargeCoord (latP m) (1 : ℤ) (a0 m) = 2 * (m : ℂ) := by
  have hcc := sum_chargeCoord (latP m) (latP_posDef m hm) (1 : ℤ) (1 : ℤ)
  rw [sum_rankOne, latP_form] at hcc
  rw [hcc]; push_cast; ring

/-- **Stage S2 for `V_{2m}`: `h(0)` is semisimple on the vacuum space, with spectrum in
`(1/√(2m))·ℤ`.**  For every admissible `V_{2m}`-module, every vector of
`Ω = {x : h(n) x = 0, n > 0}` is a finite sum of `h(0)`-eigenvectors in `Ω` with eigenvalues
`j / c_α`, `j ∈ ℤ` (`c_α = chargeCoord α`, `c_α² = 2m`). -/
theorem vac_le_eigSpan (N : AdmissibleModule (V2m m hm) M) :
    (admissibleHeisRep N).vac ≤ (admissibleHeisRep N).eigSpan
      {μ | ∃ j : ℤ, μ = (j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m)} := by
  intro x hx
  set H := admissibleHeisRep N with hH
  set c1 := chargeCoord (latP m) (1 : ℤ) (a0 m)
  set u := latChargeGen (latP m) (-1 : ℤ)
  set v := latChargeGen (latP m) (1 : ℤ)
  set S := {μ : ℂ | ∃ j : ℤ, μ = (j : ℂ) / c1}
  have hc1 : c1 ≠ 0 := chargeCoord_one_ne_zero m hm
  have hcn : chargeCoord (latP m) (-1 : ℤ) (a0 m) = -c1 := by
    exact chargeCoord_neg (latP m) (1 : ℤ) (a0 m)
  have hsq : c1 * c1 = 2 * (m : ℂ) := chargeCoord_sq_rankOne (m := m) hm
  set ε := latticeCocycle (latP m) (-1 : ℤ) (1 : ℤ)
  have hε : ε ≠ 0 := LatMod.latticeCocycle_ne_zero _ _ _
  set ℓ : ℤ := 2 * m - 1
  obtain ⟨Nu, hNu⟩ := N.truncation u x
  set p : ℤ := max Nu 0
  have hJ := N.jacobi u v x ℓ p (-1 - p)
  -- right-hand side: `ε x`
  have hR : (∑ᶠ i : ℤ, cbz p i • mode (N.YM ((V2m m hm).smul u (ℓ + i) v)) (p + (-1 - p) - i) x) = ε • x := by
    rw [finsum_eq_single _ (0 : ℤ)]
    · rw [cbz_apply_nonneg _ le_rfl, add_zero, sub_zero,
        show p + (-1 - p) = -1 by ring, V2m_smul_neg_charge (m := m) (hm := hm) 1 ℓ]
      have h0 : -ℓ - 1 + 2 * (m : ℤ) * 1 * 1 = ((0 : ℕ) : ℤ) := by simp only [ℓ]; push_cast; ring
      rw [h0, EEVec_vacuum, if_pos (by norm_num : (0 : ℤ) ≤ ((0 : ℕ) : ℤ)), Int.toNat_natCast,
        vSchur_zero]
      rw [show latStateGen (latP m) (1 : FockN (rank (latP m))) 0 = (V2m m hm).vacuum from rfl,
        map_smul, N.vacuum_YM, mode_smul, mode_one]
      simp [gBinom]
      rfl
    · intro i hi
      rcases lt_or_gt_of_ne hi with hneg | hpos
      · rw [cbz_apply_neg _ hneg, zero_smul]
      · rw [V2m_smul_neg_charge (m := m) (hm := hm) 1 (ℓ + i),
          EEVec_vacuum, if_neg (by simp [ℓ]; omega)]
        simp [latStateGen]
  rw [hR] at hJ
  -- every left-hand term lies in `π⁻¹(eigSpan)`
  set E := H.eigSpan S
  set T : Submodule ℂ M := E.comap (H.vac.subtype.comp H.proj)
  have hspec : ∀ (k : ℤ) (y : M), (H.proj (mode (N.YM u) k y) : M) ∈ E := by
    intro k y
    refine H.proj_charge_mem (fun q => mode (N.YM u) q) (chargeCoord (latP m) (-1 : ℤ) (a0 m)) S
      ?_ ?_ ?_ y k
    · intro k'
      refine ⟨k' + 1 - 2 * m, ?_⟩
      rw [hcn]
      field_simp
      push_cast
      linear_combination (-1 : ℂ) * hsq
    · intro p' q' y'
      have h := heis_charge_comm N.toWeakModule (-1 : ℤ) p' q' y'
      simp only [WeakModule.act_def] at h
      exact h
    · intro k' ω hω
      exact proj_charge_der N (-1 : ℤ) (by rw [hcn]; exact neg_ne_zero.mpr hc1) k' ω hω
  have hmem : ε • x ∈ T := by
    rw [← hJ]
    refine finsum_mem_submodule' T _ fun i => ?_
    rcases lt_or_ge i 0 with hneg | hnn
    · rw [cbz_apply_neg _ hneg, mul_zero, zero_smul]; exact T.zero_mem
    · rw [hNu (p + i) (by omega), map_zero, smul_zero, sub_zero]
      refine T.smul_mem _ ?_
      exact hspec _ _
  have hx' : ε • x ∈ E := by
    have h := hmem
    simp only [T, Submodule.mem_comap, LinearMap.comp_apply, Submodule.subtype_apply, map_smul,
      H.proj_of_mem_vac hx] at h
    exact h
  have := E.smul_mem ε⁻¹ hx'
  rwa [smul_smul, inv_mul_cancel₀ hε, one_smul] at this

/-- **`h(0)` is semisimple on every admissible `V_{2m}`-module**, with spectrum in
`(1/c_α)·ℤ`: `M = ⨆_{j ∈ ℤ} ker(h(0) − j/c_α)`. -/
theorem iSup_eigenspace_eq_top (N : AdmissibleModule (V2m m hm) M) :
    (⨆ j : ℤ, Module.End.eigenspace ((admissibleHeisRep N).a 0)
      ((j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m))) = ⊤ := by
  set H := admissibleHeisRep N with hH
  set E := ⨆ j : ℤ, Module.End.eigenspace (H.a 0) ((j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m))
  refine H.eq_top_of_vac_le E ?_ ?_
  · refine le_trans (vac_le_eigSpan N) ?_
    rw [HeisSvN.HeisRep.eigSpan, Submodule.span_le]
    rintro v ⟨-, μ, ⟨j, rfl⟩, hv⟩
    exact Submodule.mem_iSup_of_mem j (Module.End.mem_eigenspace_iff.mpr hv)
  · intro n _ x hx
    induction hx using Submodule.iSup_induction' with
    | mem j y hy =>
      refine Submodule.mem_iSup_of_mem j (Module.End.mem_eigenspace_iff.mpr ?_)
      rw [Module.End.mem_eigenspace_iff] at hy
      rw [H.a_zero_comm, hy, map_smul]
    | zero => rw [map_zero]; exact E.zero_mem
    | add y z _ _ hy hz => rw [map_add]; exact E.add_mem hy hz

/-! ## §4  Charge operators on vacuum vectors (any weak module) -/

section ChargeVac

variable (A : WeakModule (V2m m hm) M)

/-- The top-mode relation: if `ω` is a Heisenberg vacuum vector and `e^β_(k') ω = 0` for all
`k' > k`, then `-(k+1) e^β_(k) ω = c_β e^β_(k) h(0) ω`. -/
theorem charge_top (β : ℤ) (ω : M) (hω : ∀ i : ℤ, 0 < i → mode (A.YM (hb m)) i ω = 0) (k : ℤ)
    (hk : ∀ k' : ℤ, k < k' → mode (A.YM (latChargeGen (latP m) β)) k' ω = 0) :
    (-((k : ℂ) + 1)) • mode (A.YM (latChargeGen (latP m) β)) k ω
      = chargeCoord (latP m) β (a0 m) •
          mode (A.YM (latChargeGen (latP m) β)) k (mode (A.YM (hb m)) 0 ω) := by
  set e := latChargeGen (latP m) β
  have hT := act_T_covariance A e (k + 1) ω
  have hL : (V2m m hm).L (-1) e = (V2m m hm).smul e (-2) (V2m m hm).vacuum := by
    have hc := creation_pow (V2m m hm) e 1
    simp only [pow_one, Nat.factorial_one, Nat.cast_one, inv_one, one_smul] at hc
    rw [T_eq_Lneg1, show (-(1 : ℤ) - 1) = -2 from by norm_num] at hc
    exact hc.symm
  rw [hL, V2m_smul_charge_neg_two, WeakModule.act_def, WeakModule.act_def, map_smul, mode_smul,
    LinearMap.smul_apply, show k + 1 - 1 = k by ring] at hT
  have hI := module_iterate0 A (hb m) e ω (-1) (k + 1)
  rw [finsum_eq_single _ (0 : ℤ)] at hI
  · rw [hI, sub_zero, cbz_apply_nonneg _ le_rfl, hk (k + 1 + 0) (by omega), map_zero, zero_sub,
      show (-1 + (k + 1) - 0) = k by ring] at hT
    have h1 : negOnePow (-1) = -1 := by simp [negOnePow]
    have h0 : negOnePow 0 * gBinom (-1) (Int.toNat 0) = 1 := by simp [negOnePow, gBinom]
    rw [h1, h0, one_smul, neg_one_smul, neg_neg] at hT
    rw [show (-((k : ℂ) + 1)) = -((k + 1 : ℤ) : ℂ) by push_cast; ring, ← hT]
  · intro i hi
    rcases lt_or_gt_of_ne hi with hneg | hpos
    · rw [cbz_apply_neg _ hneg, mul_zero, zero_smul]
    · rw [hk (k + 1 + i) (by omega), hω i hpos, map_zero, map_zero, smul_zero, sub_zero, smul_zero]

theorem chargeCoord_rankOne (hm : 1 ≤ m) (β : ℤ) :
    chargeCoord (latP m) β (a0 m) * chargeCoord (latP m) (1 : ℤ) (a0 m) = 2 * (m : ℂ) * β := by
  have hcc := sum_chargeCoord (latP m) (latP_posDef m hm) β (1 : ℤ)
  rw [sum_rankOne, latP_form] at hcc
  rw [hcc]; push_cast; ring

theorem chargeCoord_ne_zero (hm : 1 ≤ m) {β : ℤ} (hβ : β ≠ 0) : chargeCoord (latP m) β (a0 m) ≠ 0 := by
  intro h
  have := chargeCoord_rankOne (m := m) hm β
  rw [h, zero_mul] at this
  have hm0 : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hβ0 : (β : ℂ) ≠ 0 := Int.cast_ne_zero.mpr hβ
  exact mul_ne_zero (mul_ne_zero two_ne_zero hm0) hβ0 this.symm

/-- **Vanishing of the high charge modes on a vacuum eigenvector.**  If `h(n) ω = 0` (`n > 0`),
`h(0) ω = λ ω` and `c_β λ = -N₁ ∈ ℤ`, then `e^β_(k) ω = 0` for all `k ≥ N₁`. -/
theorem charge_vanish (β : ℤ) (ω : M) (hω : ∀ i : ℤ, 0 < i → mode (A.YM (hb m)) i ω = 0)
    (lam : ℂ) (hlam : mode (A.YM (hb m)) 0 ω = lam • ω) (N₁ : ℤ)
    (hN : chargeCoord (latP m) β (a0 m) * lam = -N₁) :
    ∀ k : ℤ, N₁ ≤ k → mode (A.YM (latChargeGen (latP m) β)) k ω = 0 := by
  obtain ⟨T, hT⟩ := A.truncation (latChargeGen (latP m) β) ω
  have key : ∀ d : ℕ, ∀ k : ℤ, N₁ ≤ k → T - d ≤ k →
      mode (A.YM (latChargeGen (latP m) β)) k ω = 0 := by
    intro d
    induction d with
    | zero => intro k _ hk; exact hT k (by simpa using hk)
    | succ d ih =>
      intro k hk1 hk2
      by_cases hkd : T - d ≤ k
      · exact ih k hk1 hkd
      · have htop := charge_top A β ω hω k (fun k' hk' => ih k' (by omega) (by push_cast at hk2 ⊢; omega))
        rw [hlam, map_smul, smul_smul, hN] at htop
        have hne : (-((k : ℂ) + 1)) - (-(N₁ : ℂ)) ≠ 0 := by
          intro h
          have h' : ((N₁ - k - 1 : ℤ) : ℂ) = 0 := by push_cast; linear_combination h
          have := Int.cast_eq_zero.mp h'
          omega
        have h2 : ((-((k : ℂ) + 1)) - (-(N₁ : ℂ))) • mode (A.YM (latChargeGen (latP m) β)) k ω = 0 := by
          rw [sub_smul, htop, sub_self]
        exact (smul_eq_zero.mp h2).resolve_left hne
  intro k hk
  exact key (T - k).toNat k hk (by omega)

/-- **The top charge vector is a vacuum eigenvector**: `e^β_(N₁-1) ω ∈ Ω` with `h(0)`-eigenvalue
`λ + c_β`. -/
theorem charge_top_vac (β : ℤ) (ω : M) (hω : ∀ i : ℤ, 0 < i → mode (A.YM (hb m)) i ω = 0)
    (lam : ℂ) (hlam : mode (A.YM (hb m)) 0 ω = lam • ω) (N₁ : ℤ)
    (hN : chargeCoord (latP m) β (a0 m) * lam = -N₁) :
    (∀ i : ℤ, 0 < i → mode (A.YM (hb m)) i (mode (A.YM (latChargeGen (latP m) β)) (N₁ - 1) ω) = 0)
      ∧ mode (A.YM (hb m)) 0 (mode (A.YM (latChargeGen (latP m) β)) (N₁ - 1) ω)
          = (lam + chargeCoord (latP m) β (a0 m)) • mode (A.YM (latChargeGen (latP m) β)) (N₁ - 1) ω := by
  have hv := charge_vanish A β ω hω lam hlam N₁ hN
  constructor
  · intro i hi
    have h := heis_charge_comm A β i (N₁ - 1) ω
    simp only [WeakModule.act_def] at h
    rw [hω i hi, map_zero, sub_zero, hv (i + (N₁ - 1)) (by omega), smul_zero] at h
    exact h
  · have h := heis_charge_comm A β 0 (N₁ - 1) ω
    simp only [WeakModule.act_def, zero_add] at h
    rw [hlam, map_smul, sub_eq_iff_eq_add] at h
    rw [h, add_smul, add_comm]

/-- **The `e^{-β} e^{β}` relation on vacuum eigenvectors**: with `ω`, `λ`, `N₁` as above
(`β ≠ 0`), `e^{-β}_(⟨β,β⟩-1-N₁) e^{β}_(N₁-1) ω = ε(-β,β) ω`.  From the module Jacobi identity at
`ℓ = ⟨β,β⟩ - 1`, `m = -N₁`, `n = N₁ - 1`, where `charge_vanish` kills every term but one on each
side. -/
theorem charge_rel (β : ℤ) (hβ : β ≠ 0) (ω : M) (hω : ∀ i : ℤ, 0 < i → mode (A.YM (hb m)) i ω = 0)
    (lam : ℂ) (hlam : mode (A.YM (hb m)) 0 ω = lam • ω) (N₁ : ℤ)
    (hN : chargeCoord (latP m) β (a0 m) * lam = -N₁) :
    mode (A.YM (latChargeGen (latP m) (-β))) (2 * m * β * β - 1 - N₁)
        (mode (A.YM (latChargeGen (latP m) β)) (N₁ - 1) ω)
      = latticeCocycle (latP m) (-β) β • ω := by
  set u := latChargeGen (latP m) (-β)
  set v := latChargeGen (latP m) β
  have hvv := charge_vanish A β ω hω lam hlam N₁ hN
  have hcn : chargeCoord (latP m) (-β) (a0 m) = -chargeCoord (latP m) β (a0 m) :=
    chargeCoord_neg (latP m) β (a0 m)
  have huv := charge_vanish A (-β) ω hω lam hlam (-N₁) (by rw [hcn, neg_mul, hN]; push_cast; ring)
  have hββ : 1 ≤ β * β := by nlinarith [mul_self_pos.mpr hβ]
  have hℓ : 0 ≤ 2 * (m : ℤ) * β * β - 1 := by nlinarith
  have hJ := A.jacobi u v ω (2 * m * β * β - 1) (-N₁) (N₁ - 1)
  rw [finsum_eq_single _ (0 : ℤ), finsum_eq_single _ (0 : ℤ)] at hJ
  · rw [huv (-N₁ + 0) (by omega), map_zero, smul_zero, sub_zero, cbz_apply_nonneg _ le_rfl,
      cbz_apply_nonneg _ le_rfl, add_zero, sub_zero, sub_zero, add_zero,
      show -N₁ + (N₁ - 1) = -1 by ring, V2m_smul_neg_charge,
      show -(2 * (m : ℤ) * β * β - 1) - 1 + 2 * m * β * β = ((0 : ℕ) : ℤ) by push_cast; ring,
      EEVec_vacuum, if_pos (by norm_num : (0 : ℤ) ≤ ((0 : ℕ) : ℤ)), Int.toNat_natCast,
      vSchur_zero, show latStateGen (latP m) (1 : FockN (rank (latP m))) 0 = (V2m m hm).vacuum from rfl,
      map_smul, A.vacuum_YM, mode_smul, mode_one] at hJ
    simp only [negOnePow, gBinom, Finset.range_zero, Finset.prod_empty, Nat.factorial_zero,
      Nat.cast_one, div_one, Int.toNat_zero, mul_one, one_smul, LinearMap.smul_apply] at hJ
    rw [if_pos (Even.zero : Even (0 : ℤ)), one_smul] at hJ
    rw [show 2 * (m : ℤ) * β * β - 1 + -N₁ = 2 * m * β * β - 1 - N₁ by ring] at hJ
    exact hJ
  · intro i hi
    rcases lt_or_gt_of_ne hi with hneg | hpos
    · rw [cbz_apply_neg _ hneg, zero_smul]
    · rw [V2m_smul_neg_charge, EEVec_vacuum, if_neg (by omega)]
      simp [latStateGen]
  · intro i hi
    rcases lt_or_gt_of_ne hi with hneg | hpos
    · rw [cbz_apply_neg _ hneg, mul_zero, zero_smul]
    · rw [hvv (N₁ - 1 + i) (by omega), huv (-N₁ + i) (by omega), map_zero, map_zero, smul_zero,
        sub_zero, smul_zero]

/-- **The charge recursion on a vacuum eigenvector** (the `L(-1)`-derivative property, unprojected):
for `ω ∈ Ω` with `h(0) ω = λ ω` and every `n`,
`(-n - c_β λ) e^β_(n-1) ω = c_β ∑_{i ≥ 0} h(-1-i) e^β_(n+i) ω`.
Since `e^β_(k) ω = 0` for `k ≫ 0`, this determines every `e^β_(k) ω` from the top vector
`e^β_(N₁-1) ω` (input for the uniqueness step of S4). -/
theorem charge_recursion (β : ℤ) (ω : M) (hω : ∀ i : ℤ, 0 < i → mode (A.YM (hb m)) i ω = 0)
    (lam : ℂ) (hlam : mode (A.YM (hb m)) 0 ω = lam • ω) (n : ℤ) :
    (-(n : ℂ) - chargeCoord (latP m) β (a0 m) * lam) • mode (A.YM (latChargeGen (latP m) β)) (n - 1) ω
      = chargeCoord (latP m) β (a0 m) • ∑ᶠ i : ℤ, (if 0 ≤ i then
          mode (A.YM (hb m)) (-1 - i) (mode (A.YM (latChargeGen (latP m) β)) (n + i) ω) else 0) := by
  set e := latChargeGen (latP m) β
  set c := chargeCoord (latP m) β (a0 m)
  have hT := act_T_covariance A e n ω
  have hL : (V2m m hm).L (-1) e = (V2m m hm).smul e (-2) (V2m m hm).vacuum := by
    have hc := creation_pow (V2m m hm) e 1
    simp only [pow_one, Nat.factorial_one, Nat.cast_one, inv_one, one_smul] at hc
    rw [T_eq_Lneg1, show (-(1 : ℤ) - 1) = -2 from by norm_num] at hc
    exact hc.symm
  rw [hL, V2m_smul_charge_neg_two, WeakModule.act_def, WeakModule.act_def, map_smul, mode_smul,
    LinearMap.smul_apply] at hT
  have hI := module_iterate0 A (hb m) e ω (-1) n
  obtain ⟨Te, hTe⟩ := A.truncation e ω
  set g : ℤ → M := fun i => if 0 ≤ i then mode (A.YM (hb m)) (-1 - i) (mode (A.YM e) (n + i) ω) else 0
  set b : ℤ → M := fun i => if i = 0 then lam • mode (A.YM e) (n - 1) ω else 0
  have hfg : ∀ i : ℤ, (negOnePow i * cbz (-1) i) •
      (mode (A.YM (hb m)) (-1 - i) (mode (A.YM e) (n + i) ω)
        - negOnePow (-1) • mode (A.YM e) (-1 + n - i) (mode (A.YM (hb m)) i ω)) = g i + b i := by
    intro i
    rcases lt_or_ge i 0 with hneg | hnn
    · rw [cbz_apply_neg _ hneg, mul_zero, zero_smul]
      simp [g, b, show ¬ 0 ≤ i by omega, show i ≠ 0 by omega]
    · obtain ⟨k, rfl⟩ : ∃ k : ℕ, i = k := ⟨i.toNat, by omega⟩
      have hcoef : negOnePow (k : ℤ) * cbz (-1) (k : ℤ) = 1 := by
        rw [negOnePow_natCast, cbz_apply_nonneg _ (by omega), Int.toNat_natCast, gBinom_neg_one,
          ← mul_pow]
        norm_num
      have h1 : negOnePow (-1) = -1 := by simp [negOnePow]
      rw [hcoef, one_smul, h1, neg_one_smul, sub_neg_eq_add]
      simp only [g, b, if_pos hnn]
      congr 1
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        simp only [Nat.cast_zero, if_true, hlam, map_smul, sub_zero]
        rw [show -1 + n = n - 1 by ring]
      · rw [hω k (by exact_mod_cast hk), map_zero, if_neg (by omega)]
  have hgfin : (Function.support g).Finite := by
    refine (Set.finite_Icc (0 : ℤ) (Te - n)).subset fun i hi => ?_
    rw [Function.mem_support] at hi
    simp only [g] at hi
    split_ifs at hi with h0
    · refine ⟨h0, ?_⟩
      by_contra hlt
      exact hi (by rw [hTe (n + i) (by omega), map_zero])
    · exact absurd rfl hi
  have hbfin : (Function.support b).Finite :=
    (Set.finite_singleton (0 : ℤ)).subset fun i hi => by
      rw [Function.mem_support] at hi
      simp only [b] at hi
      split_ifs at hi with h0
      · exact h0
      · exact absurd rfl hi
  rw [show (fun i : ℤ => (negOnePow i * cbz (-1) i) •
      (mode (A.YM (hb m)) (-1 - i) (mode (A.YM e) (n + i) ω)
        - negOnePow (-1) • mode (A.YM e) (-1 + n - i) (mode (A.YM (hb m)) i ω))) = fun i => g i + b i
      from funext hfg, finsum_add_distrib hgfin hbfin,
      finsum_eq_single b 0 (fun i hi => by simp only [b]; exact if_neg hi)] at hI
  simp only [b, if_pos rfl] at hI
  rw [hI, smul_add, smul_smul] at hT
  rw [sub_smul, ← hT, add_sub_cancel_right]

end ChargeVac

/-! ## §5  Stage S3 for admissible modules: the charge shifts `Ω_{j} ⇄ Ω_{j ± 2m}` -/

section S3

variable (N : AdmissibleModule (V2m m hm) M)

theorem admissible_vac_modes {ω : M} (hω : ω ∈ (admissibleHeisRep N).vac) :
    ∀ i : ℤ, 0 < i → mode (N.YM (hb m)) i ω = 0 :=
  (admissibleHeisRep N).mem_vac.mp hω

/-- **S3, raising.**  If `ω ∈ Ω` has `h(0)`-eigenvalue `j/c_α`, then `c(α) ω := e^α_(-j-1) ω`
lies in `Ω` with eigenvalue `(j+2m)/c_α`, `e^α_(k) ω = 0` for `k ≥ -j`, and
`e^{-α}_(2m-1+j) c(α) ω = ε(-α,α) ω` (so `c(α)` is injective on `Ω_j`). -/
theorem vac_raise (j : ℤ) (ω : M) (hω : ω ∈ (admissibleHeisRep N).vac)
    (hj : (admissibleHeisRep N).a 0 ω = ((j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m)) • ω) :
    mode (N.YM (latChargeGen (latP m) (1 : ℤ))) (-j - 1) ω ∈ (admissibleHeisRep N).vac
      ∧ (admissibleHeisRep N).a 0 (mode (N.YM (latChargeGen (latP m) (1 : ℤ))) (-j - 1) ω)
          = (((j + 2 * m : ℤ) : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m)) •
              mode (N.YM (latChargeGen (latP m) (1 : ℤ))) (-j - 1) ω
      ∧ (∀ k : ℤ, -j ≤ k → mode (N.YM (latChargeGen (latP m) (1 : ℤ))) k ω = 0)
      ∧ mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) (2 * m - 1 + j)
          (mode (N.YM (latChargeGen (latP m) (1 : ℤ))) (-j - 1) ω)
          = latticeCocycle (latP m) (-1 : ℤ) (1 : ℤ) • ω := by
  have hc1 : chargeCoord (latP m) (1 : ℤ) (a0 m) ≠ 0 := chargeCoord_one_ne_zero m hm
  have hsq : chargeCoord (latP m) (1 : ℤ) (a0 m) * chargeCoord (latP m) (1 : ℤ) (a0 m) = 2 * (m : ℂ) :=
    chargeCoord_sq_rankOne hm
  have hN : chargeCoord (latP m) (1 : ℤ) (a0 m) * ((j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m))
      = -((-j : ℤ) : ℂ) := by
    field_simp; push_cast; ring
  have hv := admissible_vac_modes N hω
  obtain ⟨hvac, heig⟩ := charge_top_vac N.toWeakModule (1 : ℤ) ω hv _ hj (-j) hN
  refine ⟨(admissibleHeisRep N).mem_vac.mpr ?_, ?_, ?_, ?_⟩
  · intro i hi
    have := hvac i hi
    rwa [show -j - 1 = -j - 1 from rfl] at this
  · have h := heig
    rw [show (-j - 1 : ℤ) = -j - 1 from rfl] at h
    refine h.trans ?_
    congr 1
    field_simp
    push_cast
    linear_combination hsq
  · exact charge_vanish N.toWeakModule (1 : ℤ) ω hv _ hj (-j) hN
  · have h := charge_rel N.toWeakModule (1 : ℤ) one_ne_zero ω hv _ hj (-j) hN
    rw [show 2 * (m : ℤ) * 1 * 1 - 1 - -j = 2 * m - 1 + j by ring] at h
    exact h

/-- **S3, lowering.**  If `ω ∈ Ω` has `h(0)`-eigenvalue `j/c_α`, then `c(-α) ω := e^{-α}_(j-1) ω`
lies in `Ω` with eigenvalue `(j-2m)/c_α`, `e^{-α}_(k) ω = 0` for `k ≥ j`, and
`e^{α}_(2m-1-j) c(-α) ω = ε(α,-α) ω`. -/
theorem vac_lower (j : ℤ) (ω : M) (hω : ω ∈ (admissibleHeisRep N).vac)
    (hj : (admissibleHeisRep N).a 0 ω = ((j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m)) • ω) :
    mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) (j - 1) ω ∈ (admissibleHeisRep N).vac
      ∧ (admissibleHeisRep N).a 0 (mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) (j - 1) ω)
          = (((j - 2 * m : ℤ) : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m)) •
              mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) (j - 1) ω
      ∧ (∀ k : ℤ, j ≤ k → mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) k ω = 0)
      ∧ mode (N.YM (latChargeGen (latP m) (1 : ℤ))) (2 * m - 1 - j)
          (mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) (j - 1) ω)
          = latticeCocycle (latP m) (1 : ℤ) (-1 : ℤ) • ω := by
  have hc1 : chargeCoord (latP m) (1 : ℤ) (a0 m) ≠ 0 := chargeCoord_one_ne_zero m hm
  have hsq : chargeCoord (latP m) (1 : ℤ) (a0 m) * chargeCoord (latP m) (1 : ℤ) (a0 m) = 2 * (m : ℂ) :=
    chargeCoord_sq_rankOne hm
  have hcn : chargeCoord (latP m) (-1 : ℤ) (a0 m) = -chargeCoord (latP m) (1 : ℤ) (a0 m) :=
    chargeCoord_neg (latP m) (1 : ℤ) (a0 m)
  have hN : chargeCoord (latP m) (-1 : ℤ) (a0 m) * ((j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m))
      = -((j : ℤ) : ℂ) := by
    rw [hcn]; field_simp
  have hv := admissible_vac_modes N hω
  obtain ⟨hvac, heig⟩ := charge_top_vac N.toWeakModule (-1 : ℤ) ω hv _ hj j hN
  refine ⟨(admissibleHeisRep N).mem_vac.mpr hvac, ?_, ?_, ?_⟩
  · refine heig.trans ?_
    congr 1
    rw [hcn]
    field_simp
    push_cast
    linear_combination -hsq
  · exact charge_vanish N.toWeakModule (-1 : ℤ) ω hv _ hj j hN
  · have h := charge_rel N.toWeakModule (-1 : ℤ) (by norm_num) ω hv _ hj j hN
    rw [show 2 * (m : ℤ) * -1 * -1 - 1 - j = 2 * m - 1 - j by ring] at h
    exact h

end S3

/-! ## §7  S4: the charge orbit `w_k` of a vacuum eigenvector -/

section Orbit

variable (N : AdmissibleModule (V2m m hm) M)

open Module (End)

/-- The raising top-mode `c(α) = e^α_(-j-1)` on the `h(0)`-eigenvalue `j/c_α`. -/
noncomputable def raiseOp (j : ℤ) : End ℂ M := mode (N.YM (latChargeGen (latP m) (1 : ℤ))) (-j - 1)

/-- The lowering top-mode `c(-α) = e^{-α}_(j-1)` on the `h(0)`-eigenvalue `j/c_α`. -/
noncomputable def lowerOp (j : ℤ) : End ℂ M := mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) (j - 1)

/-- `w, c(α)w, c(α)²w, …` -/
noncomputable def upSeq (j : ℤ) (w : M) : ℕ → M
  | 0 => w
  | k + 1 => raiseOp N (j + 2 * m * k) (upSeq j w k)

/-- `w, c(-α)w, c(-α)²w, …` -/
noncomputable def downSeq (j : ℤ) (w : M) : ℕ → M
  | 0 => w
  | k + 1 => lowerOp N (j - 2 * m * k) (downSeq j w k)

/-- The **charge orbit** `w_k`, `k ∈ ℤ` (`w_0 = w`). -/
noncomputable def wseq (j : ℤ) (w : M) : ℤ → M
  | Int.ofNat k => upSeq N j w k
  | Int.negSucc k => downSeq N j w (k + 1)

theorem wseq_natCast (j : ℤ) (w : M) (k : ℕ) : wseq N j w (k : ℤ) = upSeq N j w k := rfl

theorem wseq_neg_natCast (j : ℤ) (w : M) (k : ℕ) : wseq N j w (-(k : ℤ)) = downSeq N j w k := by
  rcases k with _ | k
  · rfl
  · change wseq N j w (Int.negSucc k) = _
    rfl

variable {N}

/-- Eigen-data of a vacuum vector. -/
def VacEig (N : AdmissibleModule (V2m m hm) M) (j : ℤ) (v : M) : Prop :=
  v ∈ (admissibleHeisRep N).vac ∧
    (admissibleHeisRep N).a 0 v = ((j : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m)) • v

theorem upSeq_spec {j : ℤ} {w : M} (hw : VacEig N j w) :
    ∀ k : ℕ, VacEig N (j + 2 * m * k) (upSeq N j w k) := by
  intro k
  induction k with
  | zero => simpa using hw
  | succ k ih =>
    obtain ⟨h1, h2, -, -⟩ := vac_raise N (j + 2 * m * k) _ ih.1 ih.2
    refine ⟨h1, h2.trans ?_⟩
    congr 2
    push_cast; ring

theorem downSeq_spec {j : ℤ} {w : M} (hw : VacEig N j w) :
    ∀ k : ℕ, VacEig N (j - 2 * m * k) (downSeq N j w k) := by
  intro k
  induction k with
  | zero => simpa using hw
  | succ k ih =>
    obtain ⟨h1, h2, -, -⟩ := vac_lower N (j - 2 * m * k) _ ih.1 ih.2
    refine ⟨h1, h2.trans ?_⟩
    congr 2
    push_cast; ring

theorem wseq_spec {j : ℤ} {w : M} (hw : VacEig N j w) (k : ℤ) :
    VacEig N (j + 2 * m * k) (wseq N j w k) := by
  rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
  · rw [wseq_natCast]; exact upSeq_spec hw n
  · rw [wseq_neg_natCast]
    have := downSeq_spec hw n
    rwa [show j + 2 * (m : ℤ) * -(n : ℤ) = j - 2 * m * n by ring]

/-- Raising moves along the orbit, with a nonzero constant. -/
theorem raise_wseq {j : ℤ} {w : M} (hw : VacEig N j w) (k : ℤ) :
    ∃ a : ℂ, a ≠ 0 ∧ raiseOp N (j + 2 * m * k) (wseq N j w k) = a • wseq N j w (k + 1) := by
  rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
  · refine ⟨1, one_ne_zero, ?_⟩
    rw [one_smul, wseq_natCast, show (n : ℤ) + 1 = ((n + 1 : ℕ) : ℤ) by push_cast; ring,
      wseq_natCast]
    rfl
  · rcases n with _ | n
    · refine ⟨1, one_ne_zero, ?_⟩
      rw [one_smul]
      simp only [Nat.cast_zero, neg_zero, zero_add]
      rw [show (1 : ℤ) = ((1 : ℕ) : ℤ) from rfl, wseq_natCast]
      rfl
    · rw [wseq_neg_natCast, show -((n + 1 : ℕ) : ℤ) + 1 = -(n : ℤ) by push_cast; ring,
        wseq_neg_natCast]
      have hd := downSeq_spec hw n
      obtain ⟨-, -, -, h4⟩ := vac_lower N (j - 2 * m * n) _ hd.1 hd.2
      refine ⟨latticeCocycle (latP m) (1 : ℤ) (-1 : ℤ), LatMod.latticeCocycle_ne_zero _ _ _, ?_⟩
      rw [← h4]
      change raiseOp N _ (lowerOp N (j - 2 * m * n) (downSeq N j w n)) = _
      rw [raiseOp, lowerOp]
      congr 2
      push_cast; ring

/-- Lowering moves along the orbit, with a nonzero constant. -/
theorem lower_wseq {j : ℤ} {w : M} (hw : VacEig N j w) (k : ℤ) :
    ∃ a : ℂ, a ≠ 0 ∧ lowerOp N (j + 2 * m * k) (wseq N j w k) = a • wseq N j w (k - 1) := by
  rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
  · rcases n with _ | n
    · refine ⟨1, one_ne_zero, ?_⟩
      rw [one_smul]
      simp only [Nat.cast_zero, zero_sub]
      rw [show (-1 : ℤ) = -((1 : ℕ) : ℤ) from rfl, wseq_neg_natCast]
      change lowerOp N (j + 2 * m * 0) w = lowerOp N (j - 2 * m * 0) w
      simp
    · rw [wseq_natCast, show ((n + 1 : ℕ) : ℤ) - 1 = (n : ℤ) by push_cast; ring, wseq_natCast]
      have hu := upSeq_spec hw n
      obtain ⟨-, -, -, h4⟩ := vac_raise N (j + 2 * m * n) _ hu.1 hu.2
      refine ⟨latticeCocycle (latP m) (-1 : ℤ) (1 : ℤ), LatMod.latticeCocycle_ne_zero _ _ _, ?_⟩
      rw [← h4]
      change lowerOp N _ (raiseOp N (j + 2 * m * n) (upSeq N j w n)) = _
      rw [lowerOp, raiseOp]
      congr 2
      push_cast; ring
  · refine ⟨1, one_ne_zero, ?_⟩
    rw [one_smul, wseq_neg_natCast, show -(n : ℤ) - 1 = -((n + 1 : ℕ) : ℤ) by push_cast; ring,
      wseq_neg_natCast]
    change lowerOp N _ _ = lowerOp N (j - 2 * m * n) (downSeq N j w n)
    congr 2
    ring

/-- Every weak submodule containing one orbit vector contains them all. -/
theorem wseq_mem_iff {j : ℤ} {w : M} (hw : VacEig N j w) (P : WeakModule.Submodule' N.toWeakModule)
    (k : ℤ) : wseq N j w k ∈ P.carrier ↔ w ∈ P.carrier := by
  have step : ∀ k : ℤ, wseq N j w k ∈ P.carrier ↔ wseq N j w (k + 1) ∈ P.carrier := by
    intro k
    constructor
    · intro h
      obtain ⟨a, ha, hr⟩ := raise_wseq hw k
      have := P.act_mem (latChargeGen (latP m) (1 : ℤ)) (-(j + 2 * m * k) - 1) h
      rw [WeakModule.act_def] at this
      change raiseOp N (j + 2 * m * k) (wseq N j w k) ∈ P.carrier at this
      rw [hr] at this
      have h2 := P.carrier.smul_mem a⁻¹ this
      rwa [smul_smul, inv_mul_cancel₀ ha, one_smul] at h2
    · intro h
      obtain ⟨a, ha, hr⟩ := lower_wseq hw (k + 1)
      have := P.act_mem (latChargeGen (latP m) (-1 : ℤ)) ((j + 2 * m * (k + 1)) - 1) h
      rw [WeakModule.act_def] at this
      change lowerOp N (j + 2 * m * (k + 1)) (wseq N j w (k + 1)) ∈ P.carrier at this
      rw [hr, add_sub_cancel_right] at this
      have h2 := P.carrier.smul_mem a⁻¹ this
      rwa [smul_smul, inv_mul_cancel₀ ha, one_smul] at h2
  have h0 : wseq N j w 0 = w := rfl
  induction k using Int.induction_on with
  | zero => rw [h0]
  | succ k ih => rw [← step k]; exact ih
  | pred k ih => rw [step (-(k : ℤ) - 1), sub_add_cancel]; exact ih

end Orbit

/-! ## §8  S4: the orbit span `T = span{p(h)·w_k}` is a weak submodule -/

section OrbitSpan

open MvPolynomial
open Module (End)

/-- **All charge modes from the top one.**  If `ω` is a vacuum eigenvector (`c_β λ = -N₁`), `T` is
stable under the creation modes and contains the top vector `e^β_(N₁-1) ω`, then `T` contains
every `e^β_(n) ω` (downward induction with `charge_recursion`). -/
theorem charge_modes_mem (A : WeakModule (V2m m hm) M) (β : ℤ) (ω : M)
    (hω : ∀ i : ℤ, 0 < i → mode (A.YM (hb m)) i ω = 0)
    (lam : ℂ) (hlam : mode (A.YM (hb m)) 0 ω = lam • ω) (N₁ : ℤ)
    (hN : chargeCoord (latP m) β (a0 m) * lam = -N₁) (T : Submodule ℂ M)
    (hT : ∀ i : ℤ, 0 ≤ i → ∀ y ∈ T, mode (A.YM (hb m)) (-1 - i) y ∈ T)
    (htop : mode (A.YM (latChargeGen (latP m) β)) (N₁ - 1) ω ∈ T) :
    ∀ n : ℤ, mode (A.YM (latChargeGen (latP m) β)) n ω ∈ T := by
  have hv := charge_vanish A β ω hω lam hlam N₁ hN
  have key : ∀ d : ℕ, mode (A.YM (latChargeGen (latP m) β)) (N₁ - 1 - d) ω ∈ T := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d IH =>
    rcases d with _ | d
    · simpa using htop
    · have hrec := charge_recursion A β ω hω lam hlam (N₁ - 1 - d)
      rw [hN, show N₁ - 1 - (d : ℤ) - 1 = N₁ - 1 - ((d + 1 : ℕ) : ℤ) by push_cast; ring] at hrec
      have hcoef : (-((N₁ - 1 - d : ℤ) : ℂ) - -(N₁ : ℂ)) = ((d + 1 : ℕ) : ℂ) := by push_cast; ring
      rw [hcoef] at hrec
      have hsum : (∑ᶠ i : ℤ, (if 0 ≤ i then mode (A.YM (hb m)) (-1 - i)
          (mode (A.YM (latChargeGen (latP m) β)) (N₁ - 1 - d + i) ω) else 0)) ∈ T := by
        refine finsum_mem_submodule' T _ fun i => ?_
        split_ifs with hi
        · refine hT i hi _ ?_
          by_cases hid : i ≤ d
          · have := IH (d - i.toNat) (by omega)
            rwa [show N₁ - 1 - ((d - i.toNat : ℕ) : ℤ) = N₁ - 1 - d + i by omega] at this
          · rw [hv _ (by omega)]; exact T.zero_mem
        · exact T.zero_mem
      have h2 := T.smul_mem (((d + 1 : ℕ) : ℂ))⁻¹ (T.smul_mem (chargeCoord (latP m) β (a0 m)) hsum)
      rw [← hrec, smul_smul, inv_mul_cancel₀ (by exact_mod_cast Nat.succ_ne_zero d), one_smul] at h2
      exact h2
  intro n
  by_cases hn : N₁ ≤ n
  · rw [hv n hn]; exact T.zero_mem
  · have := key (N₁ - 1 - n).toNat
    rwa [show N₁ - 1 - ((N₁ - 1 - n).toNat : ℤ) = n by omega] at this

variable (N : AdmissibleModule (V2m m hm) M)

/-- The **orbit span** `T = span{p(h(-1), h(-2), …) w_k : p, k}`. -/
noncomputable def orbitSpan (j : ℤ) (w : M) : Submodule ℂ M :=
  Submodule.span ℂ {y | ∃ (p : MvPolynomial ℕ ℂ) (k : ℤ),
    y = (admissibleHeisRep N).evalOp p (wseq N j w k)}

variable {N}

theorem evalOp_mem_orbitSpan (j : ℤ) (w : M) (p : MvPolynomial ℕ ℂ) (k : ℤ) :
    (admissibleHeisRep N).evalOp p (wseq N j w k) ∈ orbitSpan N j w :=
  Submodule.subset_span ⟨p, k, rfl⟩

theorem wseq_mem_orbitSpan (j : ℤ) (w : M) (k : ℤ) : wseq N j w k ∈ orbitSpan N j w := by
  have := evalOp_mem_orbitSpan (N := N) j w (MvPolynomial.C 1) k
  rwa [(admissibleHeisRep N).evalOp_C, one_smul] at this

theorem cr_mem_orbitSpan (j : ℤ) (w : M) (i : ℕ) {y : M} (hy : y ∈ orbitSpan N j w) :
    (admissibleHeisRep N).cr i y ∈ orbitSpan N j w := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨p, k, rfl⟩ := hy
    rw [← HeisSvN.HeisRep.evalOp_X, ← Module.End.mul_apply, ← map_mul]
    exact evalOp_mem_orbitSpan j w _ k
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul a x _ hx => rw [map_smul]; exact Submodule.smul_mem _ a hx

theorem hb_mode_mem_orbitSpan {j : ℤ} {w : M} (hw : VacEig N j w) (n : ℤ) {y : M}
    (hy : y ∈ orbitSpan N j w) : mode (N.YM (hb m)) n y ∈ orbitSpan N j w := by
  set H := admissibleHeisRep N
  have ha : ∀ n y, H.a n y = mode (N.YM (hb m)) n y := fun _ _ => rfl
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨p, k, rfl⟩ := hy
    obtain ⟨hk1, hk2⟩ := wseq_spec hw k
    rcases lt_trichotomy n 0 with hn | hn | hn
    · obtain ⟨i, rfl⟩ : ∃ i : ℕ, n = -((i : ℤ) + 1) := ⟨(-n - 1).toNat, by omega⟩
      rw [← ha]
      exact cr_mem_orbitSpan j w i (evalOp_mem_orbitSpan j w p k)
    · subst hn
      rw [← ha, H.a_zero_evalOp, hk2, map_smul]
      exact Submodule.smul_mem _ _ (evalOp_mem_orbitSpan j w p k)
    · obtain ⟨i, rfl⟩ : ∃ i : ℕ, n = (i : ℤ) + 1 := ⟨(n - 1).toNat, by omega⟩
      rw [← ha, H.a_evalOp i p hk1]
      exact Submodule.smul_mem _ _ (evalOp_mem_orbitSpan j w _ k)
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul a x _ hx => rw [map_smul]; exact Submodule.smul_mem _ a hx

/-- The orbit span is stable under the modes of `e^{±α}`. -/
theorem charge_mode_mem_orbitSpan {j : ℤ} {w : M} (hw : VacEig N j w) (σ : ℤ)
    (hσ : σ = 1 ∨ σ = -1) (n : ℤ) {y : M} (hy : y ∈ orbitSpan N j w) :
    mode (N.YM (latChargeGen (latP m) σ)) n y ∈ orbitSpan N j w := by
  set H := admissibleHeisRep N
  set T := orbitSpan N j w
  have ha : ∀ n y, H.a n y = mode (N.YM (hb m)) n y := fun _ _ => rfl
  have hc1 : chargeCoord (latP m) (1 : ℤ) (a0 m) ≠ 0 := chargeCoord_one_ne_zero m hm
  have hcn : chargeCoord (latP m) (-1 : ℤ) (a0 m) = -chargeCoord (latP m) (1 : ℤ) (a0 m) :=
    chargeCoord_neg (latP m) (1 : ℤ) (a0 m)
  have hTcr : ∀ i : ℤ, 0 ≤ i → ∀ y ∈ T, mode (N.YM (hb m)) (-1 - i) y ∈ T :=
    fun i _ y hy => hb_mode_mem_orbitSpan hw _ hy
  -- on the orbit vectors
  have hvec : ∀ (k n : ℤ), mode (N.YM (latChargeGen (latP m) σ)) n (wseq N j w k) ∈ T := by
    intro k
    obtain ⟨hk1, hk2⟩ := wseq_spec hw k
    have hω := admissible_vac_modes N hk1
    rcases hσ with rfl | rfl
    · refine charge_modes_mem N.toWeakModule 1 _ hω _ hk2 (-(j + 2 * m * k)) ?_ T hTcr ?_
      · field_simp; push_cast; ring
      · obtain ⟨a, -, hr⟩ := raise_wseq hw k
        have : mode (N.YM (latChargeGen (latP m) (1 : ℤ))) (-(j + 2 * m * k) - 1) (wseq N j w k)
            = raiseOp N (j + 2 * m * k) (wseq N j w k) := rfl
        rw [this, hr]
        exact T.smul_mem _ (wseq_mem_orbitSpan j w _)
    · refine charge_modes_mem N.toWeakModule (-1) _ hω _ hk2 (j + 2 * m * k) ?_ T hTcr ?_
      · rw [hcn]; field_simp
      · obtain ⟨a, -, hr⟩ := lower_wseq hw k
        have : mode (N.YM (latChargeGen (latP m) (-1 : ℤ))) ((j + 2 * m * k) - 1) (wseq N j w k)
            = lowerOp N (j + 2 * m * k) (wseq N j w k) := rfl
        rw [this, hr]
        exact T.smul_mem _ (wseq_mem_orbitSpan j w _)
  induction hy using Submodule.span_induction generalizing n with
  | mem y hy =>
    obtain ⟨p, k, rfl⟩ := hy
    induction p using MvPolynomial.induction_on generalizing n with
    | C a => rw [H.evalOp_C, map_smul]; exact T.smul_mem _ (hvec k n)
    | add p q hp hq => rw [map_add, LinearMap.add_apply, map_add]; exact T.add_mem (hp n) (hq n)
    | mul_X p i ih =>
      rw [mul_comm, map_mul, Module.End.mul_apply, HeisSvN.HeisRep.evalOp_X, HeisSvN.HeisRep.cr,
        ha]
      have h := heis_charge_comm N.toWeakModule σ (-((i : ℤ) + 1)) n (H.evalOp p (wseq N j w k))
      simp only [WeakModule.act_def] at h
      rw [show mode (N.YM (latChargeGen (latP m) σ)) n (mode (N.YM (hb m)) (-((i : ℤ) + 1))
          (H.evalOp p (wseq N j w k)))
          = mode (N.YM (hb m)) (-((i : ℤ) + 1)) (mode (N.YM (latChargeGen (latP m) σ)) n
              (H.evalOp p (wseq N j w k)))
            - chargeCoord (latP m) σ (a0 m) • mode (N.YM (latChargeGen (latP m) σ))
              (-((i : ℤ) + 1) + n) (H.evalOp p (wseq N j w k)) by rw [← h]; abel]
      refine T.sub_mem ?_ (T.smul_mem _ (ih _))
      exact hb_mode_mem_orbitSpan hw _ (ih n)
  | zero => rw [map_zero]; exact T.zero_mem
  | add x y _ _ hx hy => rw [map_add]; exact T.add_mem (hx n) (hy n)
  | smul a x _ hx => rw [map_smul]; exact T.smul_mem a (hx n)

end OrbitSpan

/-- `e^a_(n) e^c` in `V_{2m}`. -/
theorem V2m_smul_charge_charge (a c n : ℤ) :
    (V2m m hm).smul (latChargeGen (latP m) a) n (latChargeGen (latP m) c)
      = latticeCocycle (latP m) a c • latStateGen (latP m)
          (EEVec (latP m) a (-n - 1 - 2 * m * a * c) (vacuumN _)) (a + c) := by
  rw [V2m, show latChargeGen (latP m) c = latStateGen (latP m) (vacuumN _) c from rfl,
    latVOA_smul_latChargeGen_state, latP_form]
  rfl

/-- `e^a_(-1-⟨a,c⟩) e^c = ε(a,c) e^{a+c}`. -/
theorem V2m_smul_charge_charge_top (a c : ℤ) :
    (V2m m hm).smul (latChargeGen (latP m) a) (-1 - 2 * m * a * c) (latChargeGen (latP m) c)
      = latticeCocycle (latP m) a c • latChargeGen (latP m) (a + c) := by
  rw [V2m_smul_charge_charge,
    show -(-1 - 2 * (m : ℤ) * a * c) - 1 - 2 * m * a * c = ((0 : ℕ) : ℤ) by push_cast; ring,
    EEVec_vacuum, if_pos (by norm_num : (0 : ℤ) ≤ ((0 : ℕ) : ℤ)), Int.toNat_natCast, vSchur_zero]
  rfl

section Preserve

universe u v

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
  {M' : Type v} [AddCommGroup M'] [Module ℂ M']

/-- The states whose modes all preserve a subspace `T`. -/
def presSub (A : WeakModule W M') (T : Submodule ℂ M') : Submodule ℂ 𝒱 where
  carrier := {u | ∀ (n : ℤ), ∀ y ∈ T, mode (A.YM u) n y ∈ T}
  add_mem' {u v} hu hv n y hy := by
    simp only [map_add, mode_add, LinearMap.add_apply]
    exact T.add_mem (hu n y hy) (hv n y hy)
  zero_mem' n y _ := by simp
  smul_mem' c u hu n y hy := by
    simp only [map_smul, mode_smul, LinearMap.smul_apply]
    exact T.smul_mem c (hu n y hy)

/-- `presSub` is closed under all `n`-th products (module iterate formula). -/
theorem presSub_smul (A : WeakModule W M') (T : Submodule ℂ M') {u v : 𝒱}
    (hu : u ∈ presSub A T) (hv : v ∈ presSub A T) (ℓ : ℤ) : W.smul u ℓ v ∈ presSub A T := by
  intro n y hy
  rw [module_iterate0 A u v y ℓ n]
  refine finsum_mem_submodule' T _ fun i => T.smul_mem _ (T.sub_mem ?_ (T.smul_mem _ ?_))
  · exact hu _ _ (hv _ _ hy)
  · exact hv _ _ (hu _ _ hy)

end Preserve

variable (N : AdmissibleModule (V2m m hm) M)

/-- The orbit span is stable under **every** mode of `V_{2m}`: the preserving states contain
`e^{±α}`, hence every `e^{kα}` (products), hence everything (`latVOA_generated`). -/
theorem presSub_orbitSpan_eq_top {j : ℤ} {w : M} (hw : VacEig N j w) :
    presSub N.toWeakModule (orbitSpan N j w) = ⊤ := by
  set S := presSub N.toWeakModule (orbitSpan N j w)
  have h1 : latChargeGen (latP m) (1 : ℤ) ∈ S := fun n y hy =>
    charge_mode_mem_orbitSpan hw 1 (Or.inl rfl) n hy
  have hm1 : latChargeGen (latP m) (-1 : ℤ) ∈ S := fun n y hy =>
    charge_mode_mem_orbitSpan hw (-1) (Or.inr rfl) n hy
  have hall : ∀ k : ℤ, latChargeGen (latP m) k ∈ S := by
    intro k
    induction k using Int.induction_on with
    | zero =>
      intro n y hy
      rw [show latChargeGen (latP m) ((0 : ℤ)) = (V2m m hm).vacuum from rfl, N.vacuum_YM, mode_one]
      split_ifs
      · simpa using hy
      · simp
    | succ k ih =>
      have h := presSub_smul N.toWeakModule _ h1 ih (-1 - 2 * m * 1 * k)
      rw [V2m_smul_charge_charge_top] at h
      have h2 := S.smul_mem (latticeCocycle (latP m) (1 : ℤ) (k : ℤ))⁻¹ h
      rw [smul_smul, inv_mul_cancel₀ (LatMod.latticeCocycle_ne_zero _ _ _), one_smul] at h2
      rw [show ((k : ℤ) + 1) = 1 + k by ring]
      exact h2
    | pred k ih =>
      have h := presSub_smul N.toWeakModule _ hm1 ih (-1 - 2 * m * (-1) * (-(k : ℤ)))
      rw [V2m_smul_charge_charge_top] at h
      have h2 := S.smul_mem (latticeCocycle (latP m) (-1 : ℤ) (-(k : ℤ)))⁻¹ h
      rw [smul_smul, inv_mul_cancel₀ (LatMod.latticeCocycle_ne_zero _ _ _), one_smul] at h2
      rw [show (-(k : ℤ) - 1) = -1 + -(k : ℤ) by ring]
      exact h2
  exact latVOA_generated (latP m) (latP_even m) (latP_posDef m hm) S
    (fun u hu v hv n => presSub_smul N.toWeakModule _ hu hv n) (fun β => hall β)

/-- The orbit span as a **weak submodule**. -/
noncomputable def orbitSub {j : ℤ} {w : M} (hw : VacEig N j w) :
    WeakModule.Submodule' N.toWeakModule where
  carrier := orbitSpan N j w
  act_mem u n x hx := by
    have hu : u ∈ presSub N.toWeakModule (orbitSpan N j w) := by
      rw [presSub_orbitSpan_eq_top N hw]; trivial
    exact hu n x hx

variable {N}

theorem mem_orbitSub {j : ℤ} {w : M} (hw : VacEig N j w) : w ∈ (orbitSub N hw).carrier :=
  wseq_mem_orbitSpan (N := N) j w 0

/-- The orbit span is the weak submodule **generated** by `w`. -/
theorem orbitSub_le {j : ℤ} {w : M} (hw : VacEig N j w) (P : WeakModule.Submodule' N.toWeakModule)
    (hP : w ∈ P.carrier) : (orbitSub N hw).carrier ≤ P.carrier := by
  set H := admissibleHeisRep N
  change orbitSpan N j w ≤ P.carrier
  rw [orbitSpan, Submodule.span_le]
  rintro _ ⟨p, k, rfl⟩
  have hk : wseq N j w k ∈ P.carrier := (wseq_mem_iff hw P k).mpr hP
  clear hP
  induction p using MvPolynomial.induction_on with
  | C a => rw [H.evalOp_C]; exact P.carrier.smul_mem a hk
  | add p q hp hq => rw [map_add, LinearMap.add_apply]; exact P.carrier.add_mem hp hq
  | mul_X p i ih =>
    rw [mul_comm, map_mul, Module.End.mul_apply, HeisSvN.HeisRep.evalOp_X, HeisSvN.HeisRep.cr]
    exact P.act_mem (hb m) _ ih

/-! ## §9  S4: irreducibility of the orbit submodule -/

section Irred

open MvPolynomial

/-- `π(p(h)·ω) = p(0)·ω` for `ω ∈ Ω`. -/
theorem HeisSvN.HeisRep.proj_evalOp {M' : Type*} [AddCommGroup M'] [Module ℂ M']
    (H : HeisSvN.HeisRep M') (p : MvPolynomial ℕ ℂ) {ω : M'} (hω : ω ∈ H.vac) :
    (H.proj (H.evalOp p ω) : M') = MvPolynomial.constantCoeff p • ω := by
  induction p using MvPolynomial.induction_on with
  | C a => rw [H.evalOp_C, map_smul, Submodule.coe_smul, H.proj_of_mem_vac hω, constantCoeff_C]
  | add p q hp hq => rw [map_add, LinearMap.add_apply, map_add, Submodule.coe_add, hp, hq,
      map_add, add_smul]
  | mul_X p i _ =>
    rw [mul_comm, map_mul, Module.End.mul_apply, HeisSvN.HeisRep.evalOp_X, H.proj_cr, map_mul,
      constantCoeff_X, zero_mul, zero_smul, Submodule.coe_zero]

/-- **A Heisenberg-stable subspace meeting `Ω` trivially is zero.** -/
theorem HeisSvN.HeisRep.eq_zero_of_inf_vac {M' : Type*} [AddCommGroup M'] [Module ℂ M']
    (H : HeisSvN.HeisRep M') (Q : Submodule ℂ M') (hQ : ∀ (n : ℤ), ∀ x ∈ Q, H.a n x ∈ Q)
    (h : ∀ x ∈ Q, x ∈ H.vac → x = 0) : ∀ x ∈ Q, x = 0 := by
  have key : ∀ K : ℕ, ∀ x ∈ Q, x ∈ H.killAbove K → x = 0 := by
    intro K
    induction K with
    | zero =>
      intro x hx hk
      refine h x hx (H.mem_vac.mpr fun n hn => (H.mem_killAbove.mp hk) n (by exact_mod_cast hn))
    | succ K ih =>
      set B := H.a ((K : ℤ) + 1)
      have inner : ∀ J : ℕ, ∀ y ∈ Q, y ∈ H.killAbove (K + 1) → (B ^ J) y = 0 → y = 0 := by
        intro J
        induction J with
        | zero => intro y _ _ hJ; simpa using hJ
        | succ J ihJ =>
          intro y hy hk hJ
          have hBy : B y = 0 := by
            refine ihJ (B y) (hQ _ _ hy) ?_ ?_
            · rw [H.mem_killAbove] at hk ⊢
              intro n hn
              rw [H.comm_of_ne (by push_cast at hn; omega), hk n hn, map_zero]
            · rw [← Module.End.mul_apply, ← pow_succ]; exact hJ
          refine ih y hy (H.mem_killAbove.mpr fun n hn => ?_)
          rcases eq_or_lt_of_le (show (K : ℤ) + 1 ≤ n by omega) with he | hlt
          · rw [← he]; exact hBy
          · exact (H.mem_killAbove.mp hk) n (by push_cast; omega)
      intro x hx hk
      obtain ⟨J, hJ⟩ := H.nilp x ((K : ℤ) + 1) (by omega)
      exact inner J x hx hk hJ
  intro x hx
  obtain ⟨K, hK⟩ := H.bdd x
  exact key K x hx (H.mem_killAbove.mpr hK)

variable {N : AdmissibleModule (V2m m hm) M}

theorem vac_mem_span_wseq {j : ℤ} {w : M} (hw : VacEig N j w) {v : M}
    (hv : v ∈ (admissibleHeisRep N).vac) (hT : v ∈ orbitSpan N j w) :
    v ∈ Submodule.span ℂ (Set.range (wseq N j w)) := by
  set H := admissibleHeisRep N
  rw [← H.proj_of_mem_vac hv]
  clear hv
  induction hT using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨p, k, rfl⟩ := hy
    rw [H.proj_evalOp p (wseq_spec hw k).1]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, Submodule.coe_add]; exact Submodule.add_mem _ hx hy
  | smul a x _ hx => rw [map_smul, Submodule.coe_smul]; exact Submodule.smul_mem _ a hx

/-- **S4, irreducibility.**  For a nonzero vacuum `h(0)`-eigenvector `w`, the weak submodule
generated by `w` (the orbit span) is irreducible. -/
theorem orbitSub_isSimple {j : ℤ} {w : M} (hw : VacEig N j w) (hw0 : w ≠ 0) :
    IsSimpleSub N.toWeakModule (orbitSub N hw) := by
  set H := admissibleHeisRep N
  have hc1 : chargeCoord (latP m) (1 : ℤ) (a0 m) ≠ 0 := chargeCoord_one_ne_zero m hm
  refine ⟨fun h => hw0 ?_, fun Q hQ => ?_⟩
  · have := mem_orbitSub hw
    rw [h] at this
    exact (Submodule.mem_bot ℂ).mp this
  by_cases hQ0 : Q.carrier = ⊥
  · exact Or.inl hQ0
  right
  refine le_antisymm hQ (orbitSub_le hw Q ?_)
  -- a nonzero vacuum vector in `Q`
  obtain ⟨v, hvQ, hvvac, hv0⟩ : ∃ v ∈ Q.carrier, v ∈ H.vac ∧ v ≠ 0 := by
    by_contra hcon
    push Not at hcon
    apply hQ0
    rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_bot]
    exact H.eq_zero_of_inf_vac Q.carrier (fun n x hx => Q.act_mem (hb m) n hx)
      (fun x hx hxv => hcon x hx hxv) x hx
  have hspan := vac_mem_span_wseq hw hvvac (hQ hvQ)
  obtain ⟨c, hc⟩ := (Finsupp.mem_span_range_iff_exists_finsupp).mp hspan
  -- eigen-separation
  set μ : ℤ → ℂ := fun k => ((j + 2 * m * k : ℤ) : ℂ) / chargeCoord (latP m) (1 : ℤ) (a0 m)
  have hμ : Function.Injective μ := by
    intro a b hab
    simp only [μ] at hab
    rw [div_left_inj' hc1] at hab
    have := Int.cast_injective hab
    have hm' : (0 : ℤ) < m := by exact_mod_cast hm
    nlinarith
  obtain ⟨k0, hk0s, hk0⟩ : ∃ k0 ∈ c.support, c k0 • wseq N j w k0 ≠ 0 := by
    by_contra hcon
    push Not at hcon
    apply hv0
    rw [← hc, Finsupp.sum]
    exact Finset.sum_eq_zero hcon
  have hsep := LatMod.sum_filter_eigen_mem (H.a 0) Q.carrier
    (fun x hx => Q.act_mem (hb m) 0 hx) c.support (fun k => c k • wseq N j w k) μ
    (fun k _ => by rw [map_smul, (wseq_spec hw k).2, smul_comm]) (by
      have hc' : (∑ k ∈ c.support, c k • wseq N j w k) = v := hc
      rw [hc']; exact hvQ)
    (μ k0) {k0} (fun k => by
      simp only [Finset.mem_singleton]
      exact ⟨fun h => by subst h; exact ⟨hk0s, rfl⟩, fun h => hμ h.2⟩)
  rw [Finset.sum_singleton] at hsep
  have hck : c k0 ≠ 0 := Finsupp.mem_support_iff.mp hk0s
  have h2 := Q.carrier.smul_mem (c k0)⁻¹ hsep
  rw [smul_smul, inv_mul_cancel₀ hck, one_smul] at h2
  exact (wseq_mem_iff hw Q k0).mp h2

/-- **S4, sum.**  Every admissible `V_{2m}`-module is spanned by irreducible weak submodules
(the orbit submodules of the vacuum eigenvectors). -/
theorem mem_iSup_simple (N : AdmissibleModule (V2m m hm) M) (x : M) :
    x ∈ ⨆ (P : WeakModule.Submodule' N.toWeakModule) (_ : IsSimpleSub N.toWeakModule P), P.carrier := by
  set H := admissibleHeisRep N
  set S := ⨆ (P : WeakModule.Submodule' N.toWeakModule) (_ : IsSimpleSub N.toWeakModule P), P.carrier
  have hS : ∀ (u : LatModuleGen (latP m)) (n : ℤ), ∀ y ∈ S, mode (N.YM u) n y ∈ S := by
    intro u n y hy
    induction hy using Submodule.iSup_induction' with
    | mem P y hy =>
      induction hy using Submodule.iSup_induction' with
      | mem hP y hy => exact Submodule.mem_iSup_of_mem P (Submodule.mem_iSup_of_mem hP (P.act_mem u n hy))
      | zero => rw [map_zero]; exact S.zero_mem
      | add y z _ _ hy hz => rw [map_add]; exact S.add_mem hy hz
    | zero => rw [map_zero]; exact S.zero_mem
    | add y z _ _ hy hz => rw [map_add]; exact S.add_mem hy hz
  have htop : S = ⊤ := by
    refine H.eq_top_of_vac_le S ?_ (fun n _ y hy => hS (hb m) n y hy)
    refine le_trans (vac_le_eigSpan N) ?_
    rw [HeisSvN.HeisRep.eigSpan, Submodule.span_le]
    rintro v ⟨hv, μ, ⟨j, rfl⟩, hvμ⟩
    by_cases hv0 : v = 0
    · rw [hv0]; exact S.zero_mem
    · have hw : VacEig N j v := ⟨hv, hvμ⟩
      exact Submodule.mem_iSup_of_mem (orbitSub N hw)
        (Submodule.mem_iSup_of_mem (orbitSub_isSimple hw hv0) (mem_orbitSub hw))
  rw [htop]; trivial

end Irred

end V2mS2


/-- **The remaining content of C3, isolated.**  `V_{2m}` is admissibly rational as soon as every
admissible `V_{2m}`-module is spanned by its irreducible weak submodules. -/
theorem admissiblyRational_V2m_of_sum_simple {m : ℕ} (hm : 1 ≤ m)
    (h : ∀ {M : Type} [AddCommGroup M] [Module ℂ M] (N : AdmissibleModule (V2m m hm) M),
      ∀ x : M, x ∈ ⨆ (P : WeakModule.Submodule' N.toWeakModule)
        (_ : IsSimpleSub N.toWeakModule P), P.carrier) :
    AdmissiblyRational (V2m m hm) := by
  intro M _ _ N P
  exact exists_isCompl_of_sum_simple N.toWeakModule (h N) P

/-- **C3: `V_{2m}` is admissibly rational** (Dong 1993; Dong–Li–Mason 1997): every admissible
(`ℕ`-gradable weak) `V_{2m}`-module is completely reducible. -/
theorem V2m_admissiblyRational {m : ℕ} (hm : 1 ≤ m) : AdmissiblyRational (V2m m hm) :=
  admissiblyRational_V2m_of_sum_simple hm fun N x => mem_iSup_simple N x

end VOA.Classification.COne
