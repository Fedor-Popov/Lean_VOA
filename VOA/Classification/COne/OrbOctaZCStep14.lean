set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step30_check :
    equalRelCheck (scaleRel weight_sing30 sing30 ++ partial29)
      partial30 = true := by decide +kernel

theorem partial30_holds : evalRel W selfMode partial30 = 0 := by
  have h := equalRelCheck_sound W selfMode step30_check
  rw [evalRel_append, evalRel_scale, sing30_holds, map_zero, partial29_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
