import Mathlib.RingTheory.MvPolynomial.Symmetric.FundamentalTheorem
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Analysis.Complex.Basic
import Mathlib.GroupTheory.Perm.Fin

/-! # OrbPrim (I): invariants of the tetrahedral group `A₄ ⊂ SO(3)` on `ℂ[x, y, z]`

`A₄` acts on `ℂ³` by the even sign changes `(x,y,z) ↦ (x,-y,-z)`, `(-x,y,-z)` and the cyclic
permutation `(x,y,z) ↦ (y,z,x)`. (This is exactly how `OrbC2b.tetra` acts on `(V₂)₁` in the
`xyz` coordinates of `V2Automorphisms.lean`.)

`mem_adjoin_of_isA4Inv`: every invariant lies in the subalgebra generated by
`r² = x²+y²+z²`, `I₃ = xyz`, `I₄ = x⁴+y⁴+z⁴`, `I₆ = (x²-y²)(y²-z²)(z²-x²)`.

`mem_span_genMon_of_isHomogeneous`: a homogeneous invariant of degree `n` is a linear
combination of the generator monomials `r^{2a} I₃^b I₄^c I₆^d` of degree `n`.

Proof: Reynolds averaging over `A₄` reduces to the cyclic sums of the monomials
`x^i y^j z^k` with `i ≡ j ≡ k (mod 2)`; these are `Ψ(g)` or `xyz·Ψ(g)`, `Ψ : a ↦ x²` etc., with `g`
cyclically invariant in `ℂ[a,b,c]`. A cyclically invariant `g` is `(g + τg)/2 + (g - τg)/2`; the
first summand is symmetric (fundamental theorem, Mathlib `esymmAlgHom_surjective`), the second is
alternating, hence divisible by `Δ = (a-b)(b-c)(c-a)` with symmetric quotient. Divisibility by
`X i - X j` is obtained from vanishing under `X i ↦ X j` through the quotient by `(X i - X j)`.
-/

noncomputable section
namespace VOA.Classification.COne.OrbPrim
open MvPolynomial

/-- `ℂ[X₀, X₁, X₂]`. -/
abbrev P3 := MvPolynomial (Fin 3) ℂ

/-! ## Divisibility by `X i - X j` -/

/-- The substitution `X i ↦ X j`. -/
def substIJ (i j : Fin 3) : P3 →ₐ[ℂ] P3 := aeval (Function.update (X : Fin 3 → P3) i (X j))

theorem dvd_of_substIJ_eq_zero {i j : Fin 3} {p : P3} (h : substIJ i j p = 0) :
    (X i - X j : P3) ∣ p := by
  set I : Ideal P3 := Ideal.span {(X i - X j : P3)}
  have key : (Ideal.Quotient.mkₐ ℂ I).comp (substIJ i j) = Ideal.Quotient.mkₐ ℂ I := by
    apply MvPolynomial.algHom_ext
    intro k
    simp only [AlgHom.comp_apply, substIJ, aeval_X]
    by_cases hk : k = i
    · subst hk
      rw [Function.update_self]
      simp only [Ideal.Quotient.mkₐ_eq_mk]
      rw [Ideal.Quotient.eq, Ideal.mem_span_singleton]
      exact ⟨-1, by ring⟩
    · rw [Function.update_of_ne hk]
  have h2 : Ideal.Quotient.mkₐ ℂ I p = 0 := by
    rw [← key, AlgHom.comp_apply, h, map_zero]
  rwa [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h2

theorem X_sub_X_ne_zero {i j : Fin 3} (h : i ≠ j) : (X i - X j : P3) ≠ 0 :=
  sub_ne_zero.mpr fun he => h (X_injective he)

/-! ## Permutations -/

/-- The cyclic permutation `0 ↦ 1 ↦ 2 ↦ 0`. -/
abbrev cyc : Equiv.Perm (Fin 3) := finRotate 3
/-- The transposition `(0 1)`. -/
abbrev tau : Equiv.Perm (Fin 3) := Equiv.swap 0 1

theorem perm_cases (e : Equiv.Perm (Fin 3)) :
    e = 1 ∨ e = cyc ∨ e = cyc * cyc ∨ e = tau ∨ e = tau * cyc ∨ e = tau * (cyc * cyc) := by
  revert e; decide

theorem rename_perm_mul (e f : Equiv.Perm (Fin 3)) (p : P3) :
    rename (⇑(e * f)) p = rename e (rename f p) := by
  rw [rename_rename]; rfl

theorem isSymmetric_of_cyc_tau {p : P3} (h1 : rename cyc p = p) (h2 : rename tau p = p) :
    p.IsSymmetric := by
  intro e
  rcases perm_cases e with rfl | rfl | rfl | rfl | rfl | rfl
  · simp
  · exact h1
  · rw [rename_perm_mul, h1, h1]
  · exact h2
  · rw [rename_perm_mul, h1, h2]
  · rw [rename_perm_mul, rename_perm_mul, h1, h1, h2]


/-! ## Symmetric polynomials -/

/-- The Vandermonde-type alternant `Δ = (X₀ - X₁)(X₁ - X₂)(X₂ - X₀)`. -/
def Delta : P3 := (X 0 - X 1) * (X 1 - X 2) * (X 2 - X 0)

/-- Generators of the cyclic invariants: `e₁, e₂, e₃, Δ`. -/
def cycGens : Set P3 := {esymm (Fin 3) ℂ 1, esymm (Fin 3) ℂ 2, esymm (Fin 3) ℂ 3, Delta}

theorem mem_adjoin_of_isSymmetric {p : P3} (hp : p.IsSymmetric) :
    p ∈ Algebra.adjoin ℂ cycGens := by
  obtain ⟨q, hq⟩ := esymmAlgHom_surjective (σ := Fin 3) ℂ (n := 3) (by simp) ⟨p, hp⟩
  have hpq : p = aeval (fun i : Fin 3 => esymm (Fin 3) ℂ (i + 1)) q := by
    rw [← esymmAlgHom_apply, hq]
  have hmem : p ∈ Algebra.adjoin ℂ (Set.range fun i : Fin 3 => esymm (Fin 3) ℂ (i + 1)) := by
    rw [Algebra.adjoin_range_eq_range_aeval, hpq]; exact ⟨q, rfl⟩
  refine Algebra.adjoin_mono ?_ hmem
  rintro _ ⟨i, rfl⟩
  fin_cases i <;> simp [cycGens]

theorem Delta_mem : Delta ∈ Algebra.adjoin ℂ cycGens :=
  Algebra.subset_adjoin (by simp [cycGens])

/-! ## Alternating polynomials -/

theorem substIJ_vanish {i j : Fin 3} {e : Equiv.Perm (Fin 3)}
    (he : (substIJ i j).comp (rename e) = substIJ i j) {h : P3} (hh : rename e h = -h) :
    substIJ i j h = 0 := by
  have h1 : substIJ i j h = substIJ i j (rename e h) := by
    rw [← AlgHom.comp_apply, he]
  rw [hh, map_neg] at h1
  have h2 : (2 : ℂ) • substIJ i j h = 0 := by
    rw [two_smul]; nth_rewrite 2 [h1]; exact add_neg_cancel _
  exact (smul_eq_zero.mp h2).resolve_left two_ne_zero

theorem rename_cyc_Delta : rename cyc Delta = Delta := by
  simp only [Delta, map_mul, map_sub, rename_X]
  simp [finRotate_apply]
  ring

theorem rename_tau_Delta : rename tau Delta = -Delta := by
  simp only [Delta, map_mul, map_sub, rename_X]
  simp [Equiv.swap_apply_def]
  ring

theorem Delta_ne_zero : Delta ≠ 0 :=
  mul_ne_zero (mul_ne_zero (X_sub_X_ne_zero (by decide)) (X_sub_X_ne_zero (by decide)))
    (X_sub_X_ne_zero (by decide))

theorem subst01_tau : (substIJ 0 1).comp (rename tau) = substIJ 0 1 :=
  MvPolynomial.algHom_ext fun k => by
    fin_cases k <;> simp [substIJ, Equiv.swap_apply_def]

theorem subst12_s12 : (substIJ 1 2).comp (rename (Equiv.swap (1 : Fin 3) 2)) = substIJ 1 2 :=
  MvPolynomial.algHom_ext fun k => by
    fin_cases k <;> simp [substIJ, Equiv.swap_apply_def]

theorem subst20_s02 : (substIJ 2 0).comp (rename (Equiv.swap (0 : Fin 3) 2)) = substIJ 2 0 :=
  MvPolynomial.algHom_ext fun k => by
    fin_cases k <;> simp [substIJ, Equiv.swap_apply_def]

/-- An alternating polynomial is `Δ` times a symmetric one. -/
theorem alternating_eq {h : P3} (hcyc : rename cyc h = h) (htau : rename tau h = -h) :
    ∃ q : P3, q.IsSymmetric ∧ h = Delta * q := by
  have hs12 : rename (Equiv.swap (1 : Fin 3) 2) h = -h := by
    have e : (⇑(Equiv.swap (1 : Fin 3) 2)) = ⇑tau ∘ ⇑cyc := by decide
    rw [e, ← rename_rename, hcyc, htau]
  have hs02 : rename (Equiv.swap (0 : Fin 3) 2) h = -h := by
    have e : (⇑(Equiv.swap (0 : Fin 3) 2)) = ⇑cyc ∘ ⇑tau := by decide
    rw [e, ← rename_rename, htau, map_neg, hcyc]
  have v01 := substIJ_vanish subst01_tau htau
  have v12 := substIJ_vanish subst12_s12 hs12
  have v20 := substIJ_vanish subst20_s02 hs02
  obtain ⟨q1, rfl⟩ := dvd_of_substIJ_eq_zero v01
  have hq1 : substIJ 1 2 q1 = 0 := by
    rw [map_mul] at v12
    have hx : substIJ 1 2 (X 0 - X 1) = X 0 - X 2 := by
      simp [substIJ]
    rw [hx] at v12
    exact (mul_eq_zero.mp v12).resolve_left (X_sub_X_ne_zero (by decide))
  obtain ⟨q2, rfl⟩ := dvd_of_substIJ_eq_zero hq1
  have hq2 : substIJ 2 0 q2 = 0 := by
    rw [map_mul, map_mul] at v20
    have hx : substIJ 2 0 (X 0 - X 1) = X 0 - X 1 := by
      simp [substIJ]
    have hy : substIJ 2 0 (X 1 - X 2) = X 1 - X 0 := by
      simp [substIJ]
    rw [hx, hy] at v20
    exact (mul_eq_zero.mp ((mul_eq_zero.mp v20).resolve_left
      (X_sub_X_ne_zero (by decide)))).resolve_left (X_sub_X_ne_zero (by decide))
  obtain ⟨q3, rfl⟩ := dvd_of_substIJ_eq_zero hq2
  have hD : (X 0 - X 1) * ((X 1 - X 2) * ((X 2 - X 0) * q3)) = Delta * q3 := by
    simp only [Delta]; ring
  rw [hD] at hcyc htau ⊢
  refine ⟨q3, isSymmetric_of_cyc_tau ?_ ?_, rfl⟩
  · rw [map_mul, rename_cyc_Delta] at hcyc
    exact mul_left_cancel₀ Delta_ne_zero hcyc
  · rw [map_mul, rename_tau_Delta, neg_mul] at htau
    exact mul_left_cancel₀ Delta_ne_zero (neg_inj.mp htau)

/-- Cyclically invariant polynomials lie in `ℂ[e₁, e₂, e₃, Δ]`. -/
theorem mem_adjoin_of_cyc_invariant {g : P3} (hg : rename cyc g = g) :
    g ∈ Algebra.adjoin ℂ cycGens := by
  have hct : rename cyc (rename tau g) = rename tau g := by
    have e : (⇑cyc ∘ ⇑tau : Fin 3 → Fin 3) = ⇑tau ∘ (⇑cyc ∘ ⇑cyc) := by decide
    rw [rename_rename, e, ← rename_rename, ← rename_rename, hg, hg]
  have htt : rename tau (rename tau g) = g := by
    have e : (⇑tau ∘ ⇑tau : Fin 3 → Fin 3) = id := by decide
    rw [rename_rename, e, rename_id]; rfl
  set s := g + rename tau g with hs_def
  set h := g - rename tau g with hh_def
  have hs : s.IsSymmetric := by
    apply isSymmetric_of_cyc_tau
    · rw [hs_def, map_add, hg, hct]
    · rw [hs_def, map_add, htt, add_comm]
  have hh1 : rename cyc h = h := by rw [hh_def, map_sub, hg, hct]
  have hh2 : rename tau h = -h := by rw [hh_def, map_sub, htt, neg_sub]
  obtain ⟨q, hq, hhq⟩ := alternating_eq hh1 hh2
  have hsh : g = (1 / 2 : ℂ) • (s + h) := by
    have : s + h = (2 : ℂ) • g := by rw [hs_def, hh_def, two_smul]; abel
    rw [this, smul_smul]; norm_num
  rw [hsh]
  refine Subalgebra.smul_mem _ (Subalgebra.add_mem _ (mem_adjoin_of_isSymmetric hs) ?_) _
  rw [hhq]
  exact Subalgebra.mul_mem _ Delta_mem (mem_adjoin_of_isSymmetric hq)


/-! ## Elementary symmetric polynomials in three variables -/

theorem e1_eq : esymm (Fin 3) ℂ 1 = X 0 + X 1 + X 2 := by
  rw [esymm]
  have : Finset.powersetCard 1 (Finset.univ : Finset (Fin 3)) = {{0}, {1}, {2}} := by decide
  rw [this]; simp; ring

theorem e2_eq : esymm (Fin 3) ℂ 2 = X 0 * X 1 + X 0 * X 2 + X 1 * X 2 := by
  rw [esymm]
  have : Finset.powersetCard 2 (Finset.univ : Finset (Fin 3)) = {{0, 1}, {0, 2}, {1, 2}} := by
    decide
  rw [this, Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_singleton]
  simp; ring

theorem e3_eq : esymm (Fin 3) ℂ 3 = X 0 * X 1 * X 2 := by
  rw [esymm]
  have : Finset.powersetCard 3 (Finset.univ : Finset (Fin 3)) = {{0, 1, 2}} := by decide
  rw [this]; simp; ring

/-! ## The tetrahedral group and its invariants -/

/-- `(x, y, z) ↦ (x, -y, -z)`. -/
def s1 : P3 →ₐ[ℂ] P3 := aeval ![X 0, C (-1) * X 1, C (-1) * X 2]
/-- `(x, y, z) ↦ (-x, y, -z)`. -/
def s2 : P3 →ₐ[ℂ] P3 := aeval ![C (-1) * X 0, X 1, C (-1) * X 2]

/-- Invariance under the generators of `A₄ ⊂ SO(3)` (even sign changes, cyclic permutation). -/
def IsA4Inv (f : P3) : Prop := s1 f = f ∧ s2 f = f ∧ rename cyc f = f

/-- `r² = x² + y² + z²`. -/
def r2 : P3 := X 0 ^ 2 + X 1 ^ 2 + X 2 ^ 2
/-- `I₃ = xyz`. -/
def I3 : P3 := X 0 * X 1 * X 2
/-- `I₄ = x⁴ + y⁴ + z⁴`. -/
def I4 : P3 := X 0 ^ 4 + X 1 ^ 4 + X 2 ^ 4
/-- `I₆ = (x² - y²)(y² - z²)(z² - x²)`. -/
def I6 : P3 := (X 0 ^ 2 - X 1 ^ 2) * (X 1 ^ 2 - X 2 ^ 2) * (X 2 ^ 2 - X 0 ^ 2)

/-- The four generators. -/
def a4Gens : Set P3 := {r2, I3, I4, I6}

/-- `Ψ : X i ↦ X i ²`. -/
def Psi : P3 →ₐ[ℂ] P3 := aeval fun i => X i ^ 2

theorem Psi_adjoin {p : P3} (hp : p ∈ Algebra.adjoin ℂ cycGens) :
    Psi p ∈ Algebra.adjoin ℂ a4Gens := by
  have hle : (Algebra.adjoin ℂ cycGens).map Psi ≤ Algebra.adjoin ℂ a4Gens := by
    rw [AlgHom.map_adjoin]
    apply Algebra.adjoin_le
    rintro _ ⟨q, hq, rfl⟩
    have hr2 : r2 ∈ Algebra.adjoin ℂ a4Gens := Algebra.subset_adjoin (by simp [a4Gens])
    have hI3 : I3 ∈ Algebra.adjoin ℂ a4Gens := Algebra.subset_adjoin (by simp [a4Gens])
    have hI4 : I4 ∈ Algebra.adjoin ℂ a4Gens := Algebra.subset_adjoin (by simp [a4Gens])
    have hI6 : I6 ∈ Algebra.adjoin ℂ a4Gens := Algebra.subset_adjoin (by simp [a4Gens])
    simp only [cycGens, Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl | rfl | rfl
    · have : Psi (esymm (Fin 3) ℂ 1) = r2 := by
        rw [e1_eq]; simp [Psi, r2]
      rw [this]; exact hr2
    · have h2 : Psi (esymm (Fin 3) ℂ 2) * C 2 = r2 ^ 2 - I4 := by
        rw [e2_eq, show (C 2 : P3) = 2 from map_ofNat C 2]; simp [Psi, r2, I4]; ring
      have : Psi (esymm (Fin 3) ℂ 2) = (1 / 2 : ℂ) • (r2 ^ 2 - I4) := by
        rw [← h2, smul_eq_C_mul, mul_comm, mul_assoc, ← C_mul]; norm_num
      rw [this]
      exact Subalgebra.smul_mem _ (Subalgebra.sub_mem _ (Subalgebra.pow_mem _ hr2 _) hI4) _
    · have : Psi (esymm (Fin 3) ℂ 3) = I3 ^ 2 := by
        rw [e3_eq]; simp [Psi, I3]; ring
      rw [this]; exact Subalgebra.pow_mem _ hI3 _
    · have : Psi Delta = I6 := by simp [Psi, Delta, I6]
      rw [this]; exact hI6
  exact hle ⟨p, hp, rfl⟩

/-- Monomials in coordinates. -/
def mono (i j k : ℕ) : P3 := X 0 ^ i * X 1 ^ j * X 2 ^ k

theorem monomial_eq_mono (m : Fin 3 →₀ ℕ) (a : ℂ) :
    monomial m a = C a * mono (m 0) (m 1) (m 2) := by
  rw [monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_three, mono]

theorem cyc_mono (i j k : ℕ) : rename cyc (mono i j k) = mono k i j := by
  simp [mono, finRotate_apply]; ring

theorem s1_mono (i j k : ℕ) : s1 (mono i j k) = ((-1 : ℂ) ^ (j + k)) • mono i j k := by
  simp only [s1, mono, map_mul, map_pow, aeval_X, smul_eq_C_mul, pow_add]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons, mul_pow]
  ring

theorem s2_mono (i j k : ℕ) : s2 (mono i j k) = ((-1 : ℂ) ^ (i + k)) • mono i j k := by
  simp only [s2, mono, map_mul, map_pow, aeval_X, smul_eq_C_mul, pow_add]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons, mul_pow]
  ring

theorem Psi_mono (i j k : ℕ) : Psi (mono i j k) = mono (2 * i) (2 * j) (2 * k) := by
  simp [Psi, mono, pow_mul]

theorem Psi_cyc (p : P3) : Psi (rename cyc p) = rename cyc (Psi p) := by
  have : Psi.comp (rename cyc) = (rename cyc).comp Psi :=
    MvPolynomial.algHom_ext fun k => by simp [Psi]
  exact congrArg (fun φ : P3 →ₐ[ℂ] P3 => φ p) this

theorem cyc_I3 : rename cyc I3 = I3 := by
  simp [I3, finRotate_apply]; ring

/-- Cyclic sum. -/
def cycSum (p : P3) : P3 := p + rename cyc p + rename cyc (rename cyc p)

theorem cyc_cube (p : P3) : rename cyc (rename cyc (rename cyc p)) = p := by
  rw [rename_rename, rename_rename]
  have e : ((⇑cyc ∘ ⇑cyc) ∘ ⇑cyc : Fin 3 → Fin 3) = id := by decide
  rw [e, rename_id]; rfl

theorem cycSum_cyc_inv (p : P3) : rename cyc (cycSum p) = cycSum p := by
  simp only [cycSum, map_add, cyc_cube]; abel

theorem cycSum_mono_mem (i j k : ℕ) (hpar : (Even i ∧ Even j ∧ Even k) ∨ (Odd i ∧ Odd j ∧ Odd k)) :
    cycSum (mono i j k) ∈ Algebra.adjoin ℂ a4Gens := by
  have hI3 : I3 ∈ Algebra.adjoin ℂ a4Gens := Algebra.subset_adjoin (by simp [a4Gens])
  rcases hpar with ⟨⟨a, rfl⟩, ⟨b, rfl⟩, ⟨c, rfl⟩⟩ | ⟨⟨a, rfl⟩, ⟨b, rfl⟩, ⟨c, rfl⟩⟩
  · have h : mono (a + a) (b + b) (c + c) = Psi (mono a b c) := by
      rw [Psi_mono]; congr 1 <;> ring
    have hc : cycSum (Psi (mono a b c)) = Psi (cycSum (mono a b c)) := by
      simp only [cycSum, map_add, Psi_cyc]
    rw [h, hc]
    exact Psi_adjoin (mem_adjoin_of_cyc_invariant (cycSum_cyc_inv _))
  · have h : mono (2 * a + 1) (2 * b + 1) (2 * c + 1) = I3 * Psi (mono a b c) := by
      rw [Psi_mono]; simp only [mono, I3]; ring
    have hc : cycSum (I3 * Psi (mono a b c)) = I3 * Psi (cycSum (mono a b c)) := by
      simp only [cycSum, map_add, map_mul, Psi_cyc, cyc_I3]; ring
    rw [h, hc]
    exact Subalgebra.mul_mem _ hI3 (Psi_adjoin (mem_adjoin_of_cyc_invariant (cycSum_cyc_inv _)))

/-- The Klein-four average (times 4). -/
def kleinSum (p : P3) : P3 := p + s1 p + s2 p + s1 (s2 p)

theorem kleinSum_mono (i j k : ℕ) :
    kleinSum (mono i j k) =
      (1 + (-1 : ℂ) ^ (j + k) + (-1 : ℂ) ^ (i + k) + (-1 : ℂ) ^ (i + j)) • mono i j k := by
  simp only [kleinSum, s1_mono, s2_mono, map_smul, smul_smul, add_smul, one_smul]
  congr 2
  rw [← pow_add]
  have : i + k + (j + k) = i + j + 2 * k := by ring
  rw [this, pow_add, pow_mul]; norm_num

theorem cycSum_kleinSum_mono_mem (i j k : ℕ) :
    cycSum (kleinSum (mono i j k)) ∈ Algebra.adjoin ℂ a4Gens := by
  rw [kleinSum_mono]
  have hlin : ∀ (t : ℂ) (p : P3), cycSum (t • p) = t • cycSum p := by
    intro t p; simp only [cycSum, map_smul, smul_add]
  rw [hlin]
  rcases Nat.even_or_odd i with hi | hi <;> rcases Nat.even_or_odd j with hj | hj <;>
    rcases Nat.even_or_odd k with hk | hk
  · exact Subalgebra.smul_mem _ (cycSum_mono_mem i j k (Or.inl ⟨hi, hj, hk⟩)) _
  all_goals first
    | exact Subalgebra.smul_mem _ (cycSum_mono_mem i j k (Or.inr ⟨hi, hj, hk⟩)) _
    | (have h0 : (1 + (-1 : ℂ) ^ (j + k) + (-1 : ℂ) ^ (i + k) + (-1 : ℂ) ^ (i + j)) = 0 := by
          simp [Odd.neg_one_pow, Nat.even_add, Nat.odd_add, hi, hj, hk,
            Nat.not_even_iff_odd.mpr, Nat.not_odd_iff_even.mpr]
       rw [h0, zero_smul]; exact Subalgebra.zero_mem _)

theorem cycSum_kleinSum_mem (p : P3) : cycSum (kleinSum p) ∈ Algebra.adjoin ℂ a4Gens := by
  induction p using MvPolynomial.induction_on' with
  | monomial m a =>
    rw [monomial_eq_mono, ← smul_eq_C_mul]
    have hlin : cycSum (kleinSum (a • mono (m 0) (m 1) (m 2))) =
        a • cycSum (kleinSum (mono (m 0) (m 1) (m 2))) := by
      simp only [cycSum, kleinSum, map_smul, map_add, smul_add]
    rw [hlin]
    exact Subalgebra.smul_mem _ (cycSum_kleinSum_mono_mem _ _ _) _
  | add p q hp hq =>
    have : cycSum (kleinSum (p + q)) = cycSum (kleinSum p) + cycSum (kleinSum q) := by
      simp only [cycSum, kleinSum, map_add]; abel
    rw [this]; exact Subalgebra.add_mem _ hp hq

/-- **(I), generation.** Every `A₄`-invariant polynomial lies in `ℂ[r², I₃, I₄, I₆]`. -/
theorem mem_adjoin_of_isA4Inv {f : P3} (hf : IsA4Inv f) : f ∈ Algebra.adjoin ℂ a4Gens := by
  obtain ⟨h1, h2, h3⟩ := hf
  have hk : kleinSum f = (4 : ℂ) • f := by
    simp only [kleinSum, h1, h2]
    rw [show (4 : ℂ) = 1 + 1 + 1 + 1 by norm_num, add_smul, add_smul, add_smul, one_smul]
  have hc : cycSum ((4 : ℂ) • f) = (12 : ℂ) • f := by
    simp only [cycSum, map_smul, h3]
    rw [← add_smul, ← add_smul]; norm_num
  have h := cycSum_kleinSum_mem f
  rw [hk, hc] at h
  have : f = (1 / 12 : ℂ) • ((12 : ℂ) • f) := by rw [smul_smul]; norm_num
  rw [this]; exact Subalgebra.smul_mem _ h _


/-! ## Homogeneous form and the decomposition of generator monomials -/

/-- Generator monomials `r^{2a} I₃^b I₄^c I₆^d`. -/
def genMon (t : ℕ × ℕ × ℕ × ℕ) : P3 := r2 ^ t.1 * I3 ^ t.2.1 * I4 ^ t.2.2.1 * I6 ^ t.2.2.2

/-- Its degree `2a + 3b + 4c + 6d`. -/
def gdeg (t : ℕ × ℕ × ℕ × ℕ) : ℕ := 2 * t.1 + 3 * t.2.1 + 4 * t.2.2.1 + 6 * t.2.2.2

theorem r2_hom : r2.IsHomogeneous 2 := by
  unfold r2
  refine ((isHomogeneous_X_pow _ _).add (isHomogeneous_X_pow _ _)).add (isHomogeneous_X_pow _ _)

theorem I3_hom : I3.IsHomogeneous 3 :=
  ((isHomogeneous_X ℂ 0).mul (isHomogeneous_X ℂ 1)).mul (isHomogeneous_X ℂ 2)

theorem I4_hom : I4.IsHomogeneous 4 := by
  unfold I4
  exact ((isHomogeneous_X_pow _ _).add (isHomogeneous_X_pow _ _)).add (isHomogeneous_X_pow _ _)

theorem I6_hom : I6.IsHomogeneous 6 := by
  unfold I6
  have h : ∀ i j : Fin 3, ((X i : P3) ^ 2 - X j ^ 2).IsHomogeneous 2 := fun i j =>
    (isHomogeneous_X_pow _ _).sub (isHomogeneous_X_pow _ _)
  exact ((h 0 1).mul (h 1 2)).mul (h 2 0)

theorem genMon_hom (t : ℕ × ℕ × ℕ × ℕ) : (genMon t).IsHomogeneous (gdeg t) := by
  unfold genMon gdeg
  exact (((r2_hom.pow _).mul (I3_hom.pow _)).mul (I4_hom.pow _)).mul (I6_hom.pow _)

theorem genMon_mul (t u : ℕ × ℕ × ℕ × ℕ) :
    genMon t * genMon u =
      genMon (t.1 + u.1, t.2.1 + u.2.1, t.2.2.1 + u.2.2.1, t.2.2.2 + u.2.2.2) := by
  simp only [genMon, pow_add]; ring

theorem adjoin_le_span_genMon :
    Subalgebra.toSubmodule (Algebra.adjoin ℂ a4Gens) ≤ Submodule.span ℂ (Set.range genMon) := by
  rw [Algebra.adjoin_eq_span]
  apply Submodule.span_mono
  intro x hx
  induction hx using Submonoid.closure_induction with
  | mem x hx =>
    simp only [a4Gens, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact ⟨(1, 0, 0, 0), by simp [genMon]⟩
    · exact ⟨(0, 1, 0, 0), by simp [genMon]⟩
    · exact ⟨(0, 0, 1, 0), by simp [genMon]⟩
    · exact ⟨(0, 0, 0, 1), by simp [genMon]⟩
  | one => exact ⟨(0, 0, 0, 0), by simp [genMon]⟩
  | mul x y _ _ hx hy =>
    obtain ⟨t, rfl⟩ := hx
    obtain ⟨u, rfl⟩ := hy
    exact ⟨_, (genMon_mul t u).symm⟩

/-- **(I), homogeneous form.** A homogeneous `A₄`-invariant of degree `n` is a linear
combination of the generator monomials of degree `n`. -/
theorem mem_span_genMon_of_isHomogeneous {f : P3} {n : ℕ} (hf : IsA4Inv f)
    (hh : f.IsHomogeneous n) :
    f ∈ Submodule.span ℂ (genMon '' {t | gdeg t = n}) := by
  have h1 : f ∈ Submodule.span ℂ (Set.range genMon) :=
    adjoin_le_span_genMon (mem_adjoin_of_isA4Inv hf)
  have h2 : homogeneousComponent n f = f := by
    rw [homogeneousComponent_of_mem (m := n) ((mem_homogeneousSubmodule n f).mpr hh)]; simp
  rw [← h2]
  have hmap := Submodule.mem_map_of_mem (f := homogeneousComponent n) h1
  rw [Submodule.map_span] at hmap
  refine Submodule.span_le.mpr ?_ hmap
  rintro _ ⟨_, ⟨t, rfl⟩, rfl⟩
  rw [homogeneousComponent_of_mem ((mem_homogeneousSubmodule _ _).mpr (genMon_hom t))]
  split_ifs with ht
  · exact Submodule.subset_span ⟨t, ht.symm, rfl⟩
  · exact Submodule.zero_mem _

/-- Classification of generator monomials: `1`, a single generator, or a product of two
generator monomials of positive degree. -/
theorem genMon_cases (t : ℕ × ℕ × ℕ × ℕ) :
    t = (0, 0, 0, 0) ∨ t = (1, 0, 0, 0) ∨ t = (0, 1, 0, 0) ∨ t = (0, 0, 1, 0) ∨
      t = (0, 0, 0, 1) ∨
      ∃ u v : ℕ × ℕ × ℕ × ℕ, 1 ≤ gdeg u ∧ 1 ≤ gdeg v ∧ gdeg u + gdeg v = gdeg t ∧
        genMon t = genMon u * genMon v := by
  obtain ⟨a, b, c, d⟩ := t
  by_cases hs : a + b + c + d ≤ 1
  · have : (a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0) ∨ (a = 1 ∧ b = 0 ∧ c = 0 ∧ d = 0) ∨
        (a = 0 ∧ b = 1 ∧ c = 0 ∧ d = 0) ∨ (a = 0 ∧ b = 0 ∧ c = 1 ∧ d = 0) ∨
        (a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 1) := by omega
    rcases this with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩ |
      ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩ <;> simp
  · right; right; right; right; right
    have key : ∀ u v : ℕ × ℕ × ℕ × ℕ, (a, b, c, d) =
        (u.1 + v.1, u.2.1 + v.2.1, u.2.2.1 + v.2.2.1, u.2.2.2 + v.2.2.2) →
        genMon (a, b, c, d) = genMon u * genMon v ∧ gdeg u + gdeg v = gdeg (a, b, c, d) := by
      intro u v h
      rw [genMon_mul, h]
      refine ⟨rfl, ?_⟩
      simp only [gdeg, Prod.mk.injEq] at h ⊢
      omega
    by_cases ha : 1 ≤ a
    · obtain ⟨h1, h2⟩ := key (1, 0, 0, 0) (a - 1, b, c, d) (by simp; omega)
      exact ⟨_, _, by simp [gdeg], by simp only [gdeg]; omega, h2, h1⟩
    by_cases hb : 1 ≤ b
    · obtain ⟨h1, h2⟩ := key (0, 1, 0, 0) (a, b - 1, c, d) (by simp; omega)
      exact ⟨_, _, by simp [gdeg], by simp only [gdeg]; omega, h2, h1⟩
    by_cases hc : 1 ≤ c
    · obtain ⟨h1, h2⟩ := key (0, 0, 1, 0) (a, b, c - 1, d) (by simp; omega)
      exact ⟨_, _, by simp [gdeg], by simp only [gdeg]; omega, h2, h1⟩
    · obtain ⟨h1, h2⟩ := key (0, 0, 0, 1) (a, b, c, d - 1) (by simp; omega)
      exact ⟨_, _, by simp [gdeg], by simp only [gdeg]; omega, h2, h1⟩

theorem isA4Inv_mul {f g : P3} (hf : IsA4Inv f) (hg : IsA4Inv g) : IsA4Inv (f * g) := by
  obtain ⟨f1, f2, f3⟩ := hf
  obtain ⟨g1, g2, g3⟩ := hg
  exact ⟨by rw [map_mul, f1, g1], by rw [map_mul, f2, g2], by rw [map_mul, f3, g3]⟩

theorem isA4Inv_pow {f : P3} (hf : IsA4Inv f) (n : ℕ) : IsA4Inv (f ^ n) := by
  obtain ⟨f1, f2, f3⟩ := hf
  exact ⟨by rw [map_pow, f1], by rw [map_pow, f2], by rw [map_pow, f3]⟩

theorem isA4Inv_r2 : IsA4Inv r2 := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [r2, s1, s2, finRotate_apply] <;> ring

theorem isA4Inv_I3 : IsA4Inv I3 := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [I3, s1, s2, finRotate_apply] <;> ring

theorem isA4Inv_I4 : IsA4Inv I4 := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [I4, s1, s2, finRotate_apply] <;> ring

theorem isA4Inv_I6 : IsA4Inv I6 := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [I6, s1, s2, finRotate_apply] <;> ring

theorem isA4Inv_genMon (t : ℕ × ℕ × ℕ × ℕ) : IsA4Inv (genMon t) :=
  isA4Inv_mul (isA4Inv_mul (isA4Inv_mul (isA4Inv_pow isA4Inv_r2 _) (isA4Inv_pow isA4Inv_I3 _))
    (isA4Inv_pow isA4Inv_I4 _)) (isA4Inv_pow isA4Inv_I6 _)

