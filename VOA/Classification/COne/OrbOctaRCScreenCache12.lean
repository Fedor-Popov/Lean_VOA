    evRc a c sc1877 = evRc a c (expWordR [2, 2, 3, 5] (3)) := by
  rw [← sc1877_check]
  exact expTwo_step _ _ hc 1 [2, 3, 5] (3)
    sc1023 sc1025 (sc1023_sound a c hc) (sc1025_sound a c hc)

