theorem sc1859_check :
    reduceTwo (prependC 2 sc1000 ++ scaleR (-1) (prependC 0 sc1002)) = sc1859 := by
  decide +kernel

theorem sc1859_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc1859 = evRc a c (expWordR [2, 2, 3, 3] (5)) := by
  rw [← sc1859_check]
  exact expTwo_step _ _ hc 1 [2, 3, 3] (5)
    sc1000 sc1002 (sc1000_sound a c hc) (sc1002_sound a c hc)

