theorem sc1821_check :
    reduceTwo (prependC 2 sc951 ++ scaleR (-1) (prependC 0 sc953)) = sc1821 := by
  decide +kernel

theorem sc1821_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc1821 = evRc a c (expWordR [2, 2, 2, 4] (5)) := by
  rw [← sc1821_check]
  exact expTwo_step _ _ hc 1 [2, 2, 4] (5)
    sc951 sc953 (sc951_sound a c hc) (sc953_sound a c hc)

