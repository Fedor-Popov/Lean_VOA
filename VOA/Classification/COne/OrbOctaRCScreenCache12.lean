theorem sc1877_check :
    reduceTwo (prependC 2 sc1023 ++ scaleR (-1) (prependC 0 sc1025)) = sc1877 := by
  decide +kernel

theorem sc1877_sound {r : ℕ} (a : Fin r) (c : ℂ)
