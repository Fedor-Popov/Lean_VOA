-- One row is added, and all equal mode indices are merged.
theorem step24_check :
    equalRelCheck (scaleRel weight_sing23 sing23 ++ partial23)
      partial24 = true := by decide +kernel

theorem partial24_holds : evalRel W selfMode partial24 = 0 := by
  have h := equalRelCheck_sound W selfMode step24_check
  rw [evalRel_append, evalRel_scale, sing23_holds, map_zero, partial23_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
