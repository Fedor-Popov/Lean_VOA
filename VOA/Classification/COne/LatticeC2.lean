import VOA.Classification.COne.LatticeSimple
import VOA.Modules.PoissonDescent
import VOA.Modules.StronglyRational

/-!
# Lattice VOAs are `C₂`-cofinite (C2)

For an even positive-definite lattice `L`, `A₂(V_L) = V_L / C₂(V_L)` is finite-dimensional:
`latticeVOAGen_c2Cofinite`.  Specialised to `L = √(2m) ℤ` this is
`V2m_c2Cofinite`; with `LatticeSimple.lean` it gives `latticeVOAGen_stronglyFinite`
and `V2m_stronglyFinite`.

## Route (no singular vector, no PBW basis)

For each charge `γ` let `J_γ = {q ∈ Fock | q ⊗ e^γ ∈ C₂}` (`c2Ideal`).

1. `latVOA_smul_bosonState`: `h_a(-k-1)` acts on `q ⊗ e^γ` as multiplication by `X(k,a)`.
   Hence `J_γ` is an **ideal** of the Fock polynomial ring (`k = 0`: `C₂` is a `₍₋₁₎`-ideal,
   `poissonMul_mem_O₂_right`; `k ≥ 1`: mode `≤ -2`) containing every higher oscillator
   (`X_mem_c2Ideal`).
2. `vSchur_mem_c2Ideal`: `(e^α)₍ₙ₎e^{γ-α} = ±S_d(α) ⊗ e^γ` with `n ≤ -2` as soon as
   `d ≥ 1 + ⟨α,α⟩ − ⟨α,γ⟩`; and `S_d(α) ≡ α(-1)^d / d!` modulo the higher oscillators
   (`vVar_pow_sub_mem_c2Ideal`, Newton recursion).  So `α(-1)^d ∈ J_γ` (`vVar_pow_mem_c2Ideal`).
3. `Fock ⧸ J_γ` is generated by the images of `X(0,a)`, each nilpotent (it is a combination of
   lattice oscillators `b_i(-1)`, `X_mem_span_vVar`), hence finite-dimensional
   (`finite_quot_c2Ideal`).
4. If `|⟨b_i,γ⟩| > ⟨b_i,b_i⟩` for some basis vector, step 2 with `d = 0`, `α = ±b_i` gives
   `1 ∈ J_γ` (`c2Ideal_eq_top_of_not_short`); the remaining charges form a finite set
   (`shortCharges_finite`).  `A₂(V_L)` is the finite sum of the sector images.

## Status
No `sorry`, no new axioms.  Unconditional: hypotheses are only `L.Even`, `L.PosDef`
(resp. `1 ≤ m`).
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

open VOA VOA.IntegralLattice VOA.LatGen HeisenbergN VOA.Moonshine MvPolynomial

section General

variable (L : IntegralLattice) (hEven : L.Even) (hPos : L.PosDef)

/-- The boson state `h_a(-1)𝟙 = X(0,a) ⊗ e^0`. -/
noncomputable def bosonState (a : Fin (rank L)) : LatModuleGen L :=
  latStateGen L (X (0, a)) 0

theorem bosonState_eq_word (a : Fin (rank L)) :
    bosonState L a = wordStateLatGen L [(0, a)] 0 := by
  rw [wordStateLatGen_eq]
  simp [bosonState, latStateGen, wordStateN]

theorem YwordLatGen_single_gen (i : ℕ) (a : Fin (rank L)) :
    YwordLatGen L [(i, a)] 0 = genFieldLatGen L a i := by
  have h0 : YwordLatGen L ([] : List (ℕ × Fin (rank L))) (0 : L.carrier)
      = (idField : FormalDist (Module.End ℂ (LatModuleGen L))) := by
    rw [YwordLatGen_nil]
    funext t
    refine LinearMap.ext fun y => ?_
    rw [Yeαvec_zero_apply, idField_apply]
    split_ifs with ht
    · rw [LinearMap.id_apply]
    · rw [LinearMap.zero_apply]
  rw [YwordLatGen_cons]
  have := nprod_idField (genFieldLatGen_isField L a i)
  convert this using 2

theorem latVOA_Y_bosonState (a : Fin (rank L)) :
    (latticeVOAGen L hEven hPos).Y (bosonState L a) = alphaLatGen L a := by
  have hw := YfullGen_word L hEven hPos [(0, a)] 0
  rw [← bosonState_eq_word, YwordLatGen_single_gen, genFieldLatGen_zero] at hw
  exact hw

/-- `h_a(-k-1)` acts on `q ⊗ e^γ` as multiplication by `X(k,a)`. -/
theorem latVOA_smul_bosonState (a : Fin (rank L)) (k : ℕ) (q : FockN (rank L)) (γ : L.carrier) :
    (latticeVOAGen L hEven hPos).smul (bosonState L a) (-(k : ℤ) - 1) (latStateGen L q γ)
      = latStateGen L (X (k, a) * q) γ := by
  rw [PreVertexAlgebra.smul_def, latVOA_Y_bosonState, mode_apply,
    show -(-(k : ℤ) - 1) - 1 = (k : ℤ) by ring, alphaLatGen_apply, if_neg (by omega),
    add_zero]
  simp only [latStateGen, LinearMap.rTensor_tmul, currentN_apply]
  rw [oscN_neg _ _ _ (by omega), show (-(-(k : ℤ) - 1) - 1).toNat = k by omega, mulXN_apply]

/-! ## The ideal `J_γ = {q | q ⊗ e^γ ∈ C₂(V_L)}` -/

/-- The Fock-space ideal of boson states `q` with `q ⊗ e^γ ∈ C₂(V_L)`. -/
noncomputable def c2Ideal (γ : L.carrier) : Ideal (FockN (rank L)) where
  carrier := {q | latStateGen L q γ ∈ O₂ (latticeVOAGen L hEven hPos)}
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at *
    rw [latStateGen_add_boson]; exact Submodule.add_mem _ hx hy
  zero_mem' := by
    simp only [Set.mem_setOf_eq, latStateGen, TensorProduct.zero_tmul]; exact Submodule.zero_mem _
  smul_mem' := by
    intro c x hx
    simp only [Set.mem_setOf_eq, smul_eq_mul] at *
    induction c using MvPolynomial.induction_on generalizing x with
    | C a =>
      rw [← smul_eq_C_mul, latStateGen_csmul]; exact Submodule.smul_mem _ _ hx
    | add p q hp hq =>
      rw [add_mul, latStateGen_add_boson]; exact Submodule.add_mem _ (hp hx) (hq hx)
    | mul_X p i hp =>
      obtain ⟨k, a⟩ := i
      rw [mul_assoc]
      apply hp
      rw [← latVOA_smul_bosonState L hEven hPos]
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        have := poissonMul_mem_O₂_right (latticeVOAGen L hEven hPos) (bosonState L a) hx
        simpa using this
      · exact smul_le_neg_two_mem_O₂ _ _ _ (by omega)

theorem mem_c2Ideal (γ : L.carrier) (q : FockN (rank L)) :
    q ∈ c2Ideal L hEven hPos γ ↔ latStateGen L q γ ∈ O₂ (latticeVOAGen L hEven hPos) := Iff.rfl

theorem X_mem_c2Ideal (γ : L.carrier) {k : ℕ} (hk : 1 ≤ k) (a : Fin (rank L)) :
    (X (k, a) : FockN (rank L)) ∈ c2Ideal L hEven hPos γ := by
  rw [mem_c2Ideal, ← mul_one (X (k, a) : FockN (rank L)), ← latVOA_smul_bosonState]
  exact smul_le_neg_two_mem_O₂ _ _ _ (by omega)

theorem vVar_mem_c2Ideal (γ α : L.carrier) {k : ℕ} (hk : 1 ≤ k) :
    vVar L α k ∈ c2Ideal L hEven hPos γ := by
  rw [vVar]
  refine Ideal.sum_mem _ fun a _ => ?_
  exact Submodule.smul_of_tower_mem _ _ (X_mem_c2Ideal L hEven hPos γ hk a)

/-- `S_d(α) ⊗ e^γ ∈ C₂` once `d ≥ 1 + ⟨α,α⟩ − ⟨α,γ⟩`: it is `±(e^α)₍ₙ₎e^{γ−α}` with `n ≤ −2`. -/
theorem vSchur_mem_c2Ideal (γ α : L.carrier) (d : ℕ)
    (hd : 1 + L.form α α - L.form α γ ≤ (d : ℤ)) :
    vSchur L α d ∈ c2Ideal L hEven hPos γ := by
  set c := γ - α with hc
  have hform : L.form α c = L.form α γ - L.form α α := by rw [hc, map_sub]
  set n : ℤ := -(d : ℤ) - 1 - L.form α c with hn
  have h1 := smul_le_neg_two_mem_O₂ (latticeVOAGen L hEven hPos) (latChargeGen L α)
    (latStateGen L (vacuumN (rank L)) c) (n := n) (by omega)
  rw [latVOA_smul_latChargeGen_state, show -n - 1 - L.form α c = (d : ℤ) by omega,
    show α + c = γ by rw [hc]; abel, EEVec_expand L α (vacuumN_mem_gradingWN _) d,
    Finset.sum_range_one, aExpVec_zero, LinearMap.id_apply, add_zero] at h1
  have h3 := Submodule.smul_mem _ (latticeCocycle L α c) h1
  rw [smul_smul, latticeCocycle_sq, one_smul] at h3
  rw [mem_c2Ideal]
  simpa [vacuumN] using h3

/-- `α(-1)^d − d!·S_d(α)` lies in the ideal generated by the higher oscillators. -/
theorem vVar_pow_sub_mem_c2Ideal (γ α : L.carrier) (d : ℕ) :
    vVar L α 0 ^ d - (d.factorial : ℂ) • vSchur L α d ∈ c2Ideal L hEven hPos γ := by
  induction d with
  | zero => simp [vSchur_zero]
  | succ d ih =>
    have hrec := vSchur_recursion_sum L α (d + 1)
    rw [Finset.sum_range_succ', Nat.add_sub_cancel] at hrec
    set S := ∑ m ∈ Finset.range d, vVar L α (m + 1) * vSchur L α (d - (m + 1)) with hS
    have hSmem : S ∈ c2Ideal L hEven hPos γ :=
      Ideal.sum_mem _ fun m _ => Ideal.mul_mem_right _ _
        (vVar_mem_c2Ideal L hEven hPos γ α (by omega))
    have key : vVar L α 0 ^ (d + 1) - ((d + 1).factorial : ℂ) • vSchur L α (d + 1)
        = vVar L α 0 * (vVar L α 0 ^ d - (d.factorial : ℂ) • vSchur L α d)
          - (d.factorial : ℂ) • S := by
      have : ((d + 1).factorial : ℂ) • vSchur L α (d + 1)
          = (d.factorial : ℂ) • (((d + 1 : ℕ) : ℂ) • vSchur L α (d + 1)) := by
        rw [smul_smul, Nat.factorial_succ]; push_cast; ring_nf
      rw [this, ← hrec, Nat.sub_zero]
      simp only [smul_eq_C_mul]
      ring
    rw [key]
    exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ ih) (Submodule.smul_of_tower_mem _ _ hSmem)

/-- `α(-1)^d ⊗ e^γ ∈ C₂(V_L)` for `d ≥ 1 + ⟨α,α⟩ − ⟨α,γ⟩`. -/
theorem vVar_pow_mem_c2Ideal (γ α : L.carrier) (d : ℕ)
    (hd : 1 + L.form α α - L.form α γ ≤ (d : ℤ)) :
    vVar L α 0 ^ d ∈ c2Ideal L hEven hPos γ := by
  have h := Ideal.add_mem _ (vVar_pow_sub_mem_c2Ideal L hEven hPos γ α d)
    (Submodule.smul_of_tower_mem _ (d.factorial : ℂ) (vSchur_mem_c2Ideal L hEven hPos γ α d hd))
  rwa [sub_add_cancel] at h

/-! ## Finiteness of each charge sector of `A₂(V_L)` -/

theorem isIntegral_of_pow_eq_zero {A : Type*} [CommRing A] [Algebra ℂ A] {x : A} {n : ℕ}
    (hx : x ^ n = 0) : IsIntegral ℂ x :=
  ⟨Polynomial.X ^ n, Polynomial.monic_X_pow n, by simp [hx]⟩

/-- In `Fock ⧸ J_γ`, every weight-one oscillator `X(0,a)` is nilpotent. -/
theorem isNilpotent_mk_X_zero (γ : L.carrier) (a : Fin (rank L)) :
    IsNilpotent (Ideal.Quotient.mk (c2Ideal L hEven hPos γ) (X (0, a))) := by
  set J := c2Ideal L hEven hPos γ
  rw [← mem_nilradical]
  have hspan := X_mem_span_vVar L hPos 0 a
  have hle : Submodule.span ℂ (Set.range fun i : Fin (latRank L) => vVar L (latticeBasis L i) 0)
      ≤ ((nilradical (FockN (rank L) ⧸ J)).restrictScalars ℂ).comap
        (Ideal.Quotient.mkₐ ℂ J).toLinearMap := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    simp only [SetLike.mem_coe, Submodule.mem_comap, Submodule.restrictScalars_mem,
      AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk, mem_nilradical]
    set b := latticeBasis L i
    refine ⟨(1 + L.form b b - L.form b γ).toNat, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact vVar_pow_mem_c2Ideal L hEven hPos γ b _ (by omega)
  have := hle hspan
  simpa using this

theorem adjoin_mk_X_zero_eq_top (γ : L.carrier) :
    Algebra.adjoin ℂ (Set.range fun a : Fin (rank L) =>
      Ideal.Quotient.mkₐ ℂ (c2Ideal L hEven hPos γ) (X (0, a))) = ⊤ := by
  set J := c2Ideal L hEven hPos γ
  set f := Ideal.Quotient.mkₐ ℂ J
  have hsurj : Function.Surjective f := Ideal.Quotient.mkₐ_surjective ℂ J
  rw [eq_top_iff]
  have htop : (⊤ : Subalgebra ℂ (FockN (rank L) ⧸ J))
      = (Algebra.adjoin ℂ (Set.range (X : ℕ × Fin (rank L) → FockN (rank L)))).map f := by
    rw [MvPolynomial.adjoin_range_X, Algebra.map_top, (AlgHom.range_eq_top f).2 hsurj]
  rw [htop, AlgHom.map_adjoin, Algebra.adjoin_le_iff]
  rintro _ ⟨_, ⟨⟨k, a⟩, rfl⟩, rfl⟩
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; exact Algebra.subset_adjoin ⟨a, rfl⟩
  · have : f (X (k, a)) = 0 := by
      rw [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      exact X_mem_c2Ideal L hEven hPos γ hk a
    rw [SetLike.mem_coe, this]; exact Subalgebra.zero_mem _

instance finite_quot_c2Ideal (γ : L.carrier) :
    Module.Finite ℂ (FockN (rank L) ⧸ c2Ideal L hEven hPos γ) := by
  refine ⟨?_⟩
  have h := fg_adjoin_of_finite (R := ℂ) (Set.finite_range fun a : Fin (rank L) =>
      Ideal.Quotient.mkₐ ℂ (c2Ideal L hEven hPos γ) (X (0, a))) (by
    rintro _ ⟨a, rfl⟩
    obtain ⟨n, hn⟩ := isNilpotent_mk_X_zero L hEven hPos γ a
    exact isIntegral_of_pow_eq_zero (n := n) (by simpa using hn))
  rwa [adjoin_mk_X_zero_eq_top, Algebra.top_toSubmodule] at h

/-- The charge-`γ` sector map `q ↦ [q ⊗ e^γ] ∈ A₂(V_L)`. -/
noncomputable def sectorMap (γ : L.carrier) :
    FockN (rank L) →ₗ[ℂ] A₂ (latticeVOAGen L hEven hPos) :=
  (mk₂ (latticeVOAGen L hEven hPos)).comp
    ((TensorProduct.mk ℂ (FockN (rank L)) (L.carrier →₀ ℂ)).flip (eGen L γ))

theorem sectorMap_apply (γ : L.carrier) (q : FockN (rank L)) :
    sectorMap L hEven hPos γ q = mk₂ (latticeVOAGen L hEven hPos) (latStateGen L q γ) := rfl

theorem range_sectorMap_fg (γ : L.carrier) : (LinearMap.range (sectorMap L hEven hPos γ)).FG := by
  set J := c2Ideal L hEven hPos γ
  have hle : J.restrictScalars ℂ ≤ LinearMap.ker (sectorMap L hEven hPos γ) := by
    intro q hq
    rw [LinearMap.mem_ker, sectorMap_apply, mk₂_eq_zero_iff]
    exact hq
  set ψ := (J.restrictScalars ℂ).liftQ (sectorMap L hEven hPos γ) hle
  haveI : Module.Finite ℂ (FockN (rank L) ⧸ J.restrictScalars ℂ) :=
    Module.Finite.equiv (Submodule.Quotient.restrictScalarsEquiv ℂ J).symm
  have hr : LinearMap.range (sectorMap L hEven hPos γ) = LinearMap.range ψ := by
    rw [← (J.restrictScalars ℂ).liftQ_mkQ (sectorMap L hEven hPos γ) hle,
      LinearMap.range_comp_of_range_eq_top _ (Submodule.range_mkQ _)]
  rw [hr, LinearMap.range_eq_map]
  exact (Module.Finite.fg_top).map ψ

/-! ## Only finitely many charge sectors survive -/

/-- The charges `γ` with `|⟨b_i,γ⟩| ≤ ⟨b_i,b_i⟩` for every basis vector `b_i`. -/
def shortCharges : Set L.carrier :=
  {γ | ∀ i, |L.form (latticeBasis L i) γ| ≤ L.form (latticeBasis L i) (latticeBasis L i)}

include hPos in
theorem shortCharges_finite : (shortCharges L).Finite := by
  set b := latticeBasis L
  set f : L.carrier → (Fin (latRank L) → ℤ) := fun γ i => L.form (b i) γ with hf
  have hinj : Function.Injective f := by
    intro γ γ' h
    by_contra hne
    have hδ : γ - γ' ≠ 0 := sub_ne_zero.mpr hne
    have hzero : L.form.flip (γ - γ') = 0 := by
      refine b.ext fun i => ?_
      have := congrFun h i
      simp only [hf] at this
      simp [map_sub, this]
    have h0 : L.form (γ - γ') (γ - γ') = 0 := by
      have := LinearMap.congr_fun hzero (γ - γ')
      simpa only [LinearMap.flip_apply, LinearMap.zero_apply] using this
    exact absurd h0 (ne_of_gt (hPos _ hδ))
  have hbox : (Set.univ.pi fun i => Set.Icc (-L.form (b i) (b i)) (L.form (b i) (b i))).Finite :=
    Set.Finite.pi fun i => Set.finite_Icc _ _
  refine (hbox.preimage hinj.injOn).subset ?_
  intro γ hγ i _
  exact Set.mem_Icc.mpr (abs_le.mp (hγ i))

/-- Outside `shortCharges`, the whole charge sector lies in `C₂(V_L)`. -/
theorem c2Ideal_eq_top_of_not_short {γ : L.carrier} (hγ : γ ∉ shortCharges L) :
    c2Ideal L hEven hPos γ = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  simp only [shortCharges, Set.mem_setOf_eq, not_forall, not_le] at hγ
  obtain ⟨i, hi⟩ := hγ
  set b := latticeBasis L i
  rcases lt_abs.mp hi with h | h
  · have := vVar_pow_mem_c2Ideal L hEven hPos γ b 0 (by push_cast; omega)
    simpa using this
  · have := vVar_pow_mem_c2Ideal L hEven hPos γ (-b) 0 (by
      simp only [map_neg, LinearMap.neg_apply, neg_neg]; push_cast; omega)
    simpa using this

/-! ## `C₂`-cofiniteness -/

/-- **Every even positive-definite lattice VOA is `C₂`-cofinite.** -/
theorem latticeVOAGen_c2Cofinite : C2Cofinite (latticeVOAGen L hEven hPos) := by
  set W := latticeVOAGen L hEven hPos
  haveI : Finite (shortCharges L) := (shortCharges_finite L hPos).to_subtype
  set M : Submodule ℂ (A₂ W) :=
    ⨆ γ : shortCharges L, LinearMap.range (sectorMap L hEven hPos γ) with hM
  have hMfg : M.FG := Submodule.fg_iSup _ fun γ => range_sectorMap_fg L hEven hPos γ
  have hMtop : M = ⊤ := by
    rw [eq_top_iff]
    rintro x -
    obtain ⟨v, rfl⟩ := mk₂_surjective W x
    have hv : v ∈ Submodule.span ℂ (Set.range (fun q : FockN (rank L) × L.carrier =>
        latStateGen L q.1 q.2)) := by rw [latStateGen_span]; trivial
    refine Submodule.span_induction (p := fun v _ => mk₂ W v ∈ M) ?_ ?_ ?_ ?_ hv
    · rintro _ ⟨⟨q, γ⟩, rfl⟩
      by_cases hγ : γ ∈ shortCharges L
      · exact Submodule.mem_iSup_of_mem (⟨γ, hγ⟩ : shortCharges L) ⟨q, rfl⟩
      · have hq : q ∈ c2Ideal L hEven hPos γ := by
          rw [c2Ideal_eq_top_of_not_short L hEven hPos hγ]; trivial
        rw [(mk₂_eq_zero_iff W).mpr hq]; exact M.zero_mem
    · simp only [map_zero]; exact M.zero_mem
    · intro x y _ _ hx hy; simp only [map_add]; exact M.add_mem hx hy
    · intro c x _ hx; simp only [map_smul]; exact M.smul_mem c hx
  exact ⟨hMtop ▸ hMfg⟩

end General

/-! ## The rank-one case `V_{2m}` -/

/-- **C2**: `V_{2m}` is `C₂`-cofinite. -/
theorem V2m_c2Cofinite (m : ℕ) (hm : 1 ≤ m) : C2Cofinite (V2m m hm) :=
  latticeVOAGen_c2Cofinite _ _ _

/-- **Every even positive-definite lattice VOA is strongly finite.** -/
theorem latticeVOAGen_stronglyFinite (L : IntegralLattice) (hEven : L.Even) (hPos : L.PosDef) :
    StronglyFinite (latticeVOAGen L hEven hPos) :=
  ⟨latticeVOAGen_isSimple L hEven hPos, latticeVOAGen_selfDual L hEven hPos,
    latticeVOAGen_c2Cofinite L hEven hPos⟩

/-- **`V_{2m}` is strongly finite** (simple, self-dual, `C₂`-cofinite). -/
theorem V2m_stronglyFinite (m : ℕ) (hm : 1 ≤ m) : StronglyFinite (V2m m hm) :=
  ⟨V2m_isSimple m hm, V2m_selfDual m hm, V2m_c2Cofinite m hm⟩

end VOA.Classification.COne

