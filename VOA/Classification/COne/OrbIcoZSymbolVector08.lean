set_option maxHeartbeats 4000000 in
-- Add ten already cached words; no singular-word recursion is recomputed.
theorem vectorPartial8_check : equalRawCheck (rawChunk8 ++ vectorPartial7) vectorPartial8 = true := by
  decide +kernel

theorem vectorPartial8_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector prefixVector8) = evalSym W k a (symMap vectorPartial8) := by
  rw [prefixVector8, evalSym_vector_append, vectorPartial7_sound W k a,
    vectorChunk8_sound W k a]
  have hh := equalRawCheck_sound W k a vectorPartial8_check
  rw [symMap_append, evalSym_append] at hh
  simpa only [add_comm] using hh

