-- One row is added, and all equal mode indices are merged.
theorem step26_check :
    equalRelCheck (scaleRel weight_sing26 sing26 ++ partial25)
      partial26 = true := by decide +kernel

theorem partial26_holds : evalRel W selfMode partial26 = 0 := by
  have h := equalRelCheck_sound W selfMode step26_check
  rw [evalRel_append, evalRel_scale, sing26_holds, map_zero, partial25_holds,
    add_zero] at h
  exact h.symm

