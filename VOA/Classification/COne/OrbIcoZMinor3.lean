import VOA.Classification.COne.OrbIcoZMinor2

/-! One independently checked shared three-by-three cofactor. -/
set_option Elab.async false
set_option maxSynthPendingDepth 3
set_option maxRecDepth 100000
set_option linter.style.longLine false
noncomputable section
namespace VOA.Classification.COne.OrbIcoZ
open VOA OrbOdd OrbZhu Polynomial OrbIco

def commonMinor3 : PL := [mkRat (0) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1]

set_option maxHeartbeats 12000000 in
-- Six products of three integer coefficient polynomials, bounded separately.
theorem commonMinor3_check :
    ptrim (paddL (det3PL commonMinorMatrix3) (pscaleL (-1) commonMinor3)) = [] := by
  decide +kernel

theorem commonMinor3_sound : zp commonMinor3 =
    Matrix.det (fun i k => zp (commonMinorMatrix3 i k)) := by
  rw [← zp_det3PL]
  exact (zp_eq_of_trim commonMinor3_check).symm

end VOA.Classification.COne.OrbIcoZ
