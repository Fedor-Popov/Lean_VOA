import VOA.Classification.COne.PlusC2M1Sub
import VOA.Modules.PairClosure

/-!
# `M(1)⁺`: the line property from strong generation and two relations

Let `M1P = M(1)⁺` (`PlusC2M1Sub.lean`), `ω` its conformal vector and
`W = W⁴ = (4 h(−1)h(−3) − 3 h(−2)²)𝟙` its weight-`4` quadratic quasi-primary (the quadratic part of
the Dong–Nagatomo vector `J`; `J − W⁴ ∈ ℂ·L(−2)²𝟙`).  Write `oB, wB ∈ A₂(M1P)` for their classes.

## The three residual inputs (all TRUE)

* `StrongGenM1` — `M(1)⁺` is strongly generated by `ω` and `W`: the iterated products
  `g₁₍₋ₙ₁₎⋯g_k₍₋ₙ_k₎𝟙` (`gᵢ ∈ {ω, W}`) span `M(1)⁺`.  Dong–Nagatomo, J. Algebra 216 (1999),
  Thm 2.7 / Yamskulna 2004 Prop. 4.14 (stated there with `J`, equivalent since `J ∈ ℂW + ℂL(−2)²𝟙`
  and `W ∈ ℂJ + ℂL(−2)²𝟙`).
* `Rel8M` — `wB² ∈ ℂoB²wB + ℂoB⁴` (weight 8; Yamskulna 2004, Cor. 5.10).
* `Rel10M` — `oB³wB ∈ ℂoB⁵` (weight 10; Yamskulna 2004, Cor. 5.14(3)).

## Main results

* `ring_reduction` — in any commutative `ℂ`-algebra with these two relations, `oB^a wB^b ∈ ℂ·oB^{a+2b}`
  as soon as `a + 2b ≥ 6`.
* `mk₂_word_mem_mon` — the class of a weight-`k` iterated product lies in the span of the monomials
  `oB^a wB^b` with `2a + 4b = k`.
* `m1PLine_of_strongGen` — `StrongGenM1 → Rel8M → Rel10M → M1PLine`.
* `v2mPlusC2CofiniteFactGe2_of_M1PResiduals` — **`V2mPlusC2CofiniteFactGe2` from the three
  intrinsic `M(1)⁺` residuals.**
-/

set_option linter.style.longLine false

namespace VOA.Classification.COne

open VOA VOA.LatGen VOA.LatGen.Triplet VOA.IntegralLattice HeisenbergN VOA.Moonshine LatMod
  MvPolynomial VOA.TripletNilp

namespace PlusC2

variable (m : ℕ) (hm : 1 ≤ m)

/-! ## §1  The generator `W⁴` -/

/-- `W⁴ = 4·h(−1)h(−3) − 3·h(−2)²` (orthonormal boson `h`), the weight-`4` quadratic quasi-primary. -/
noncomputable def W4poly : FockN (rank (latP m)) :=
  (4 : ℂ) • (X ((0 : ℕ), a0 m) * X ((2 : ℕ), a0 m)) - (3 : ℂ) • (X ((1 : ℕ), a0 m) * X ((1 : ℕ), a0 m))

theorem sigma_W4poly : sigmaN (rank (latP m)) (W4poly m) = W4poly m := by
  simp [W4poly, map_sub, map_smul, sigmaN_mul, sigmaN_X]

theorem W4poly_mem_gradingWN : W4poly m ∈ gradingWN (rank (latP m)) 4 := by
  have h1 := wordStateN_mem_gradingWN [((0 : ℕ), a0 m), ((2 : ℕ), a0 m)]
  have h2 := wordStateN_mem_gradingWN [((1 : ℕ), a0 m), ((1 : ℕ), a0 m)]
  simp only [wordStateN_cons, wordStateN_nil, mul_one, wordWt_cons, wordWt_nil] at h1 h2
  exact Submodule.sub_mem _ (Submodule.smul_mem _ _ h1) (Submodule.smul_mem _ _ h2)

/-- The generator `W⁴ ∈ M(1)⁺`. -/
noncomputable def WM : (m1Sub m hm).carrier :=
  ⟨latStateGen (latP m) (W4poly m) 0, (mem_m1Carrier_iff m hm _).mpr ⟨_, sigma_W4poly m, rfl⟩⟩

theorem WM_mem_grading : WM m hm ∈ (M1P m hm).grading 4 :=
  latStateGen_mem_grading m hm (W4poly_mem_gradingWN m)

theorem ωM_mem_grading : ωM m hm ∈ (M1P m hm).grading 2 := (M1P m hm).conformal_mem

/-- The generating set `{ω, W⁴}`. -/
noncomputable def gensM : Set (m1Sub m hm).carrier := {ωM m hm, WM m hm}

theorem gensM_homog : ∀ s ∈ gensM m hm, ∃ d : ℤ, 1 ≤ d ∧ s ∈ (M1P m hm).grading d := by
  rintro s (rfl | rfl)
  · exact ⟨2, by norm_num, ωM_mem_grading m hm⟩
  · exact ⟨4, by norm_num, WM_mem_grading m hm⟩

/-! ## §2  The residual inputs -/

/-- **Strong generation of `M(1)⁺` by `ω` and `W⁴`** (TRUE; Dong–Nagatomo 1999, Thm 2.7, in the form
of Yamskulna 2004, Prop. 4.14). -/
def StrongGenM1 : Prop := iterProdSpan (M1P m hm) (gensM m hm) = ⊤

/-- **The weight-8 relation** `wB² ∈ ℂoB²wB + ℂoB⁴` in `A₂(M(1)⁺)` (TRUE; Yamskulna 2004,
Cor. 5.10: `M(1,8)⁺ = L(−1)M(1,7)⁺ + L(−3)M(1,5)⁺ + ℂL(−2)²J + ℂL(−2)⁴𝟙`). -/
def Rel8M : Prop :=
  ∃ ρ σ : ℂ, (mk₂ (M1P m hm) (WM m hm)) ^ 2 =
    ρ • ((mk₂ (M1P m hm) (ωM m hm)) ^ 2 * mk₂ (M1P m hm) (WM m hm)) + σ • (mk₂ (M1P m hm) (ωM m hm)) ^ 4

/-- **The weight-10 relation** `oB³wB ∈ ℂoB⁵` in `A₂(M(1)⁺)` (TRUE; Yamskulna 2004, Cor. 5.14(3)). -/
def Rel10M : Prop :=
  ∃ τ : ℂ, (mk₂ (M1P m hm) (ωM m hm)) ^ 3 * mk₂ (M1P m hm) (WM m hm) = τ • (mk₂ (M1P m hm) (ωM m hm)) ^ 5

/-! ## §3  Pure ring algebra -/

/-- In a commutative `ℂ`-algebra with `W² ∈ ℂω²W + ℂω⁴` and `ω³W ∈ ℂω⁵`, every monomial
`ω^a W^b` with `a + 2b ≥ 6` is a multiple of `ω^{a+2b}`. -/
theorem ring_reduction {R : Type*} [CommRing R] [Algebra ℂ R] (ω W : R) (ρ σ τ : ℂ)
    (h8 : W ^ 2 = ρ • (ω ^ 2 * W) + σ • ω ^ 4) (h10 : ω ^ 3 * W = τ • ω ^ 5) :
    ∀ b a : ℕ, 6 ≤ a + 2 * b → ω ^ a * W ^ b ∈ Submodule.span ℂ {ω ^ (a + 2 * b)} := by
  intro b
  induction b using Nat.strong_induction_on with
  | _ b ih =>
    intro a hab
    rcases b with _ | _ | b
    · simp
    · obtain ⟨c, rfl⟩ : ∃ c, a = c + 3 := ⟨a - 3, by omega⟩
      have : ω ^ (c + 3) * W ^ (0 + 1) = τ • ω ^ (c + 3 + 2 * (0 + 1)) := by
        rw [zero_add, pow_one, pow_add, mul_assoc, h10, mul_smul_comm, ← pow_add]
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)
    · have heq : ω ^ a * W ^ (b + 2) =
          ρ • (ω ^ (a + 2) * W ^ (b + 1)) + σ • (ω ^ (a + 4) * W ^ b) := by
        rw [pow_add W b 2, h8]
        simp only [mul_add, mul_smul_comm]
        ring_nf
      have h1 := ih (b + 1) (by omega) (a + 2) (by omega)
      have h2 := ih b (by omega) (a + 4) (by omega)
      rw [show a + 2 + 2 * (b + 1) = a + 2 * (b + 2) by ring] at h1
      rw [show a + 4 + 2 * b = a + 2 * (b + 2) by ring] at h2
      rw [heq]
      exact Submodule.add_mem _ (Submodule.smul_mem _ _ h1) (Submodule.smul_mem _ _ h2)

/-! ## §4  Words -/

/-- The span of the monomials `oB^a wB^b` of weight `2a + 4b = k`. -/
noncomputable def monSpan (k : ℤ) : Submodule ℂ (A₂ (M1P m hm)) :=
  Submodule.span ℂ {x | ∃ a b : ℕ, (2 * a + 4 * b : ℤ) = k ∧
    x = (mk₂ (M1P m hm) (ωM m hm)) ^ a * (mk₂ (M1P m hm) (WM m hm)) ^ b}

theorem mul_monSpan {d k : ℤ} {s : (m1Sub m hm).carrier} (hs : s ∈ gensM m hm)
    (hsd : s ∈ (M1P m hm).grading d) (hs0 : s ≠ 0) {y : A₂ (M1P m hm)} (hy : y ∈ monSpan m hm k) :
    mk₂ (M1P m hm) s * y ∈ monSpan m hm (d + k) := by
  refine Submodule.span_induction (p := fun y _ => mk₂ (M1P m hm) s * y ∈ monSpan m hm (d + k))
    ?_ ?_ ?_ ?_ hy
  · rintro _ ⟨a, b, hab, rfl⟩
    rcases hs with rfl | rfl
    · have hd : d = 2 := by
        by_contra h
        exact hs0 (eq_zero_of_mem_grading_ne _ h hsd (ωM_mem_grading m hm))
      refine Submodule.subset_span ⟨a + 1, b, by rw [hd, ← hab]; push_cast; ring, by ring⟩
    · have hd : d = 4 := by
        by_contra h
        exact hs0 (eq_zero_of_mem_grading_ne _ h hsd (WM_mem_grading m hm))
      refine Submodule.subset_span ⟨a, b + 1, by rw [hd, ← hab]; push_cast; ring, by ring⟩
  · simp only [mul_zero, Submodule.zero_mem]
  · intro x y _ _ hx hy; rw [mul_add]; exact Submodule.add_mem _ hx hy
  · intro c x _ hx; rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hx

/-- The class of a weight-`k` iterated product of `ω, W⁴` lies in `monSpan k`. -/
theorem mk₂_word_mem_mon {x : (m1Sub m hm).carrier} (hx : IsIterProd (M1P m hm) (gensM m hm) x) :
    ∀ k : ℤ, x ∈ (M1P m hm).grading k → mk₂ (M1P m hm) x ∈ monSpan m hm k := by
  induction hx with
  | vacuum =>
    intro k hk
    by_cases hk0 : k = 0
    · subst hk0
      rw [← A₂_one_eq]
      exact Submodule.subset_span ⟨0, 0, by norm_num, by simp⟩
    · rw [eq_zero_of_mem_grading_ne _ hk0 hk (M1P m hm).vacuum_mem, map_zero]
      exact Submodule.zero_mem _
  | step s hs n hn y hy ih =>
    intro k hk
    obtain ⟨d, -, hsd⟩ := gensM_homog m hm s hs
    obtain ⟨ky, hky⟩ := isIterProd_exists_grading (M1P m hm) (gensM_homog m hm) hy
    rcases eq_or_lt_of_le hn with h1 | h2
    · subst h1
      have hx := (M1P m hm).smul_mem_grading hsd hky (-1)
      by_cases hk' : k = d + ky - (-1) - 1
      · subst hk'
        rw [mk₂_smul_neg_one]
        by_cases hs0 : s = 0
        · rw [hs0, map_zero, zero_mul]; exact Submodule.zero_mem _
        have := mul_monSpan m hm hs hsd hs0 (ih ky hky)
        rwa [show d + ky - -1 - 1 = d + ky by ring]
      · rw [eq_zero_of_mem_grading_ne _ hk' hk hx, map_zero]
        exact Submodule.zero_mem _
    · rw [mk₂_smul_eq_zero _ _ _ (by omega)]
      exact Submodule.zero_mem _

/-! ## §5  The reduction -/

/-- **`M1PLine` from strong generation and the two relations.** -/
theorem m1PLine_of_strongGen (hS : StrongGenM1 m hm) (h8 : Rel8M m hm) (h10 : Rel10M m hm) :
    M1PLine m hm := by
  obtain ⟨ρ, σ, h8⟩ := h8
  obtain ⟨τ, h10⟩ := h10
  set oB := mk₂ (M1P m hm) (ωM m hm)
  set wB := mk₂ (M1P m hm) (WM m hm)
  refine ⟨12, fun w hw v hvw hphi => ?_⟩
  -- the class of `v` lies in `monSpan w`
  have hv : mk₂ (M1P m hm) v ∈ monSpan m hm w := by
    have hT : v ∈ iterProdSpan (M1P m hm) (gensM m hm) := by rw [hS]; trivial
    have := mem_span_gradedWords (M1P m hm) (gensM_homog m hm) hT hvw
    refine Submodule.span_induction (p := fun v _ => mk₂ (M1P m hm) v ∈ monSpan m hm w)
      ?_ ?_ ?_ ?_ this
    · rintro x ⟨hx, hxw⟩
      exact mk₂_word_mem_mon m hm hx w hxw
    · simp only [map_zero, Submodule.zero_mem]
    · intro x y _ _ hx hy; rw [map_add]; exact Submodule.add_mem _ hx hy
    · intro c x _ hx; rw [map_smul]; exact Submodule.smul_mem _ _ hx
  -- `monSpan w` is a line through `oB^{w/2}` (or zero)
  have hline : monSpan m hm w ≤ Submodule.span ℂ {oB ^ (w / 2)} := by
    rw [monSpan, Submodule.span_le]
    rintro _ ⟨a, b, hab, rfl⟩
    have hab' : 2 * a + 4 * b = w := by exact_mod_cast hab
    have := ring_reduction oB wB ρ σ τ h8 h10 b a (by omega)
    rwa [show a + 2 * b = w / 2 by omega] at this
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hline hv)
  -- `v − c·ω^{w/2} ∈ O₂`
  have hO : v - c • pMulPow (M1P m hm) (ωM m hm) (w / 2) ∈ O₂ (M1P m hm) := by
    rw [← mk₂_eq_zero_iff, map_sub, map_smul, mk₂_pMulPow, ← hc, sub_self]
  have hphi0 := phi_O₂ m hm w hO
  rw [Submodule.coe_sub, Submodule.coe_smul, phi_sub, phi_smul, hphi] at hphi0
  rcases Nat.even_or_odd w with ⟨j, hj⟩ | ⟨j, hj⟩
  · -- even weight: `c = 0`
    have hw2 : w / 2 = j := by omega
    rw [hw2, show w = 2 * j by omega, phi_omegaPow] at hphi0
    have hc0 : c = 0 := by
      have : c * (1 / 2 : ℂ) ^ j = 0 := by linear_combination -hphi0
      rcases mul_eq_zero.mp this with h | h
      · exact h
      · exact absurd h (pow_ne_zero _ (by norm_num))
    rw [hc0, zero_smul, sub_zero] at hO
    exact hO
  · -- odd weight: `monSpan w = 0`
    have hzero : monSpan m hm w = ⊥ := by
      rw [monSpan, Submodule.span_eq_bot]
      rintro _ ⟨a, b, hab, -⟩
      exfalso
      have hab' : 2 * a + 4 * b = w := by exact_mod_cast hab
      omega
    rw [hzero, Submodule.mem_bot, mk₂_eq_zero_iff] at hv
    exact hv

/-- **The three intrinsic `M(1)⁺` residuals** (all TRUE and cited; see `StrongGenM1`, `Rel8M`,
`Rel10M`), for every `m ≥ 2`. -/
def M1PResiduals : Prop :=
  ∀ (m : ℕ) (hm : 1 ≤ m), 2 ≤ m → StrongGenM1 m hm ∧ Rel8M m hm ∧ Rel10M m hm

end PlusC2

open PlusC2

/-- **`V2mPlusC2CofiniteFactGe2` from the three intrinsic `M(1)⁺` residuals**: strong
generation of `M(1)⁺` by `ω, W⁴` (Dong–Nagatomo) and the weight-8 and weight-10 relations in
`A₂(M(1)⁺)` (Yamskulna). -/
theorem v2mPlusC2CofiniteFactGe2_of_M1PResiduals (h : M1PResiduals) : V2mPlusC2CofiniteFactGe2 :=
  v2mPlusC2CofiniteFactGe2_of_m1PlusC2Line fun m hm h2 =>
    m1PlusC2Line_of_M1PLine m hm
      (m1PLine_of_strongGen m hm (h m hm h2).1 (h m hm h2).2.1 (h m hm h2).2.2)

end VOA.Classification.COne
