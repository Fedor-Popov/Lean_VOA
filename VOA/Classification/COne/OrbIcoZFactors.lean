import VOA.Classification.COne.OrbIcoZNormal

/-! Exact factor and Bezout certificates for the two finite determinant identities.
The candidate roots are all nonnegative rational numbers. -/
set_option Elab.async false
set_option maxSynthPendingDepth 3
set_option maxRecDepth 100000
set_option linter.style.longLine false
noncomputable section
namespace VOA.Classification.COne.OrbIcoZ
open VOA OrbOdd OrbZhu Polynomial

def plProd : List PL → PL
  | [] => [1]
  | p :: r => pmulL p (plProd r)

theorem zp_plProd (r : List PL) : zp (plProd r) = (r.map zp).prod := by
  induction r with
  | nil => simp [plProd, zp]
  | cons p r ih => simp only [plProd, zp_pmulL, List.map_cons, List.prod_cons, ih]

theorem zp_eq_of_trim {p q : PL} (h : ptrim (paddL p (pscaleL (-1) q)) = []) :
    zp p = zp q := by
  have hz : zp (paddL p (pscaleL (-1) q)) = 0 := by
    rw [← zp_ptrim, h]
    rfl
  simpa [zp_paddL, zp_pscaleL, add_neg_eq_zero] using hz

