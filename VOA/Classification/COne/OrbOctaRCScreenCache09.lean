theorem sc1448_check :
    reduceTwo (prependC 1 sc778 ++ scaleR (-1) (prependC 0 sc779)) = sc1448 := by
  decide +kernel

theorem sc1448_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc1448 = evRc a c (expWordR [1, 1, 3, 3] (7)) := by
  rw [← sc1448_check]
  exact expTwo_step _ _ hc 0 [1, 3, 3] (7)
    sc778 sc779 (sc778_sound a c hc) (sc779_sound a c hc)

