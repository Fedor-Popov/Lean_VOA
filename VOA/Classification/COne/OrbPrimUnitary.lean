import VOA.Classification.COne.OrbSpanUnitary
import VOA.Classification.COne.VirComposition

/-! # OrbPrim (H1a, general part): primaries of a unitary VOA versus composition multiplicities

`finrank_prim_le_of_unitary`: let `W` carry a positive-definite Hermitian form with
`L(n)† = L(-n)` (`OrbSpan.VirUnitaryForm`). If the graded dimension of `W` is
`dim W_n = Σ_{k ≤ n} e_k · dim L(c,k)_{n-k}` for `n ≤ N`, then `dim Prim_N(W) ≤ e_N`.

Proof. For a primary `p` of weight `N` let `M_p` be the Virasoro submodule it generates
(`VirComposition.layerU` with `S = ⊥`); it lies in weights `≥ N`. The vectors orthogonal to every
`M_p` form a Virasoro-stable subspace `S` (adjointness) that contains all weights `< N` (weight
spaces are orthogonal) and meets the primaries trivially (positivity). The local composition
multiplicities of `W ⊇ S ⊇ 0` (`VirComposition.local_multiplicities`) then add up to `e`
(`multiplicities_unique`), and those of `W / S` vanish below `N` and equal
`dim W_N - dim S_N ≥ dim Prim_N` at `N`.
-/

set_option maxSynthPendingDepth 3
set_option maxRecDepth 4096
noncomputable section
namespace VOA.Classification.COne.OrbPrim
open VOA VertexOperatorAlgebra OrbSpan VirComposition Finset
open VOA.InverseDS.VirasoroVerma

universe u
variable {V : Type u} [AddCommGroup V] [Module ℂ V] {W : VertexOperatorAlgebra V}

/-- Weight spaces are orthogonal for a Virasoro-unitary form. -/
theorem form_eq_zero_of_weight_ne (U : VirUnitaryForm W) {n n' : ℤ} {x y : V}
    (hx : x ∈ W.grading n) (hy : y ∈ W.grading n') (hne : n ≠ n') : U.form x y = 0 := by
  have h := U.adjoint 0 x y
  rw [neg_zero, W.L_zero_grading x hx, W.L_zero_grading y hy, map_smul, LinearMap.smul_apply,
    LinearMap.map_smulₛₗ, map_intCast, smul_eq_mul, smul_eq_mul] at h
  have h2 : ((n : ℂ) - n') * U.form x y = 0 := by rw [sub_mul, h, sub_self]
  rcases mul_eq_zero.mp h2 with h3 | h3
  · exact absurd (by exact_mod_cast sub_eq_zero.mp h3) hne
  · exact h3

/-- The composition-series hypotheses for a VOA. -/
theorem vHyp (W : VertexOperatorAlgebra V) : Hyp W.centralCharge W.grading W.L :=
  ⟨W.isInternal, W.finrank, W.positivity, fun _ v hv => W.L_zero_grading v hv,
    VertexOperatorAlgebra.L_mem_grading W, W.L_virasoro⟩

section Layer
variable (W)

theorem prim_low {N : ℕ} {p : V} (hp : p ∈ prim W N) :
    ∀ m : ℤ, 0 < m → W.L m p ∈ (⊥ : Submodule ℂ V) := by
  intro m hm
  rw [mem_prim] at hp
  have := hp.2 (m - 1).toNat
  rw [show (((m - 1).toNat : ℕ) : ℤ) + 1 = m by omega] at this
  rw [this]; exact Submodule.zero_mem _

theorem prim_grading {N : ℕ} {p : V} (hp : p ∈ prim W N) : p ∈ W.grading (N : ℤ) :=
  ((mem_prim W).mp hp).1

/-- The Virasoro submodule generated by a primary. -/
def primLayer {N : ℕ} {p : V} (hp : p ∈ prim W N) : Submodule ℂ V :=
  layerU (vHyp W) stable_bot (prim_low W hp) (prim_grading W hp)

theorem primLayer_stable {N : ℕ} {p : V} (hp : p ∈ prim W N) : Stable W.L (primLayer W hp) :=
  layerU_stable _ _ _ _

theorem self_mem_primLayer {N : ℕ} {p : V} (hp : p ∈ prim W N) : p ∈ primLayer W hp :=
  ⟨negWord W.centralCharge (N : ℂ) [], phi_negWord (vHyp W) stable_bot (prim_low W hp)
    (prim_grading W hp) []⟩

theorem primLayer_le_wordSpan {N : ℕ} {p : V} (hp : p ∈ prim W N) :
    primLayer W hp ≤ wordSpan W.L p := by
  intro y hy
  obtain ⟨z, hz, hzy⟩ := range_phi_le (vHyp W) stable_bot (prim_low W hp) (prim_grading W hp) hy
  rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq, Submodule.mem_bot,
    sub_eq_zero] at hzy
  rw [← hzy]; exact hz

theorem form_wordSpan_eq_zero (U : VirUnitaryForm W) {N : ℕ} {p : V} (hp : p ∈ prim W N)
    {n : ℕ} (hn : n < N) {x : V} (hx : x ∈ W.grading (n : ℤ)) {y : V}
    (hy : y ∈ wordSpan W.L p) : U.form x y = 0 := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨w, rfl⟩ := hz
    exact form_eq_zero_of_weight_ne U hx
      (wordAct_mem_grading (vHyp W) (prim_grading W hp) w.val) (by push_cast; omega)
  | zero => simp
  | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
  | smul c a _ ha => rw [LinearMap.map_smulₛₗ, ha, smul_zero]

/-- The vectors orthogonal to the Virasoro submodules generated by the weight-`N` primaries. -/
def orthPrim (U : VirUnitaryForm W) (N : ℕ) : Submodule ℂ V where
  carrier := {x | ∀ p (hp : p ∈ prim W N), ∀ y ∈ primLayer W hp, U.form x y = 0}
  add_mem' := by
    intro a b ha hb p hp y hy
    rw [map_add, LinearMap.add_apply, ha p hp y hy, hb p hp y hy, add_zero]
  zero_mem' := by intro _ _ _ _; simp
  smul_mem' := by
    intro c a ha p hp y hy
    rw [map_smul, LinearMap.smul_apply, ha p hp y hy, smul_zero]

theorem orthPrim_stable (U : VirUnitaryForm W) (N : ℕ) : Stable W.L (orthPrim W U N) := by
  intro m x hx p hp y hy
  rw [U.adjoint]
  exact hx p hp _ (primLayer_stable W hp _ _ hy)

theorem grading_le_orthPrim (U : VirUnitaryForm W) {N n : ℕ} (hn : n < N) :
    W.grading (n : ℤ) ≤ orthPrim W U N := fun _ hx _ hp _ hy =>
  form_wordSpan_eq_zero W U hp hn hx (primLayer_le_wordSpan W hp hy)

theorem prim_inf_orthPrim (U : VirUnitaryForm W) (N : ℕ) : prim W N ⊓ orthPrim W U N = ⊥ := by
  rw [eq_bot_iff]
  rintro p ⟨hp, hS⟩
  exact U.self_eq_zero (hS p hp p (self_mem_primLayer W hp))

end Layer

/-- **Primaries of a unitary VOA are bounded by the composition multiplicities.** -/
theorem finrank_prim_le_of_unitary (U : VirUnitaryForm W) (N : ℕ) (e : ℕ → ℕ)
    (he : ∀ n ≤ N, Module.finrank ℂ (W.grading (n : ℤ)) =
      ∑ k ∈ range (n + 1), e k *
        Module.finrank ℂ (vermaSimpleLevel W.centralCharge (k : ℂ) (n - k))) :
    Module.finrank ℂ (prim W N) ≤ e N := by
  have H := vHyp W
  set S := orthPrim W U N with hSdef
  have hS : Stable W.L S := orthPrim_stable W U N
  obtain ⟨A2, hA2⟩ := local_multiplicities H N _ S ⊤ hS stable_top le_top rfl
  obtain ⟨A1, hA1⟩ := local_multiplicities H N _ ⊥ S stable_bot hS bot_le rfl
  have htop : ∀ n : ℕ, dimG W.grading ⊤ n = Module.finrank ℂ (W.grading (n : ℤ)) := by
    intro n; rw [dimG, top_inf_eq]
  have hbot : ∀ n : ℕ, dimG W.grading ⊥ n = 0 := by
    intro n; rw [dimG, bot_inf_eq, finrank_bot]
  -- total multiplicities
  have hsum : ∀ k ≤ N, A1 k + A2 k = e k := by
    refine multiplicities_unique (c := W.centralCharge) (fun k => A1 k + A2 k) e N
      (fun n hn => ?_)
    have h1 := hA1 n hn
    have h2 := hA2 n hn
    rw [htop, he n hn] at h2
    rw [hbot, zero_add] at h1
    simp only [add_mul, sum_add_distrib]
    omega
  -- `A2` vanishes below `N`
  have hlow : ∀ k < N, A2 k = 0 := by
    intro k hk
    have hz := multiplicities_unique (c := W.centralCharge) A2 (fun _ => 0) (N - 1)
      (fun n hn => by
        have h2 := hA2 n (by omega)
        have heq : dimG W.grading ⊤ n = dimG W.grading S n := by
          rw [dimG, dimG, top_inf_eq, inf_eq_right.mpr (grading_le_orthPrim W U (by omega))]
        simp only [zero_mul, sum_const_zero]
        omega) k (by omega)
    exact hz
  have hN := hA2 N le_rfl
  rw [sum_range_succ, Nat.sub_self, vermaSimpleLevel_zero_finrank, mul_one,
    sum_eq_zero (fun k hk => by rw [hlow k (mem_range.mp hk), zero_mul]), zero_add] at hN
  -- dimension count in weight `N`
  haveI : FiniteDimensional ℂ (W.grading (N : ℤ)) := W.finrank _
  have hPle : prim W N ≤ W.grading (N : ℤ) := inf_le_left
  haveI : FiniteDimensional ℂ (prim W N) := Submodule.finiteDimensional_of_le hPle
  haveI : FiniteDimensional ℂ ↥(S ⊓ W.grading (N : ℤ)) :=
    Submodule.finiteDimensional_of_le inf_le_right
  have hdisj : prim W N ⊓ (S ⊓ W.grading (N : ℤ)) = ⊥ := by
    rw [← inf_assoc, prim_inf_orthPrim W U N, bot_inf_eq]
  have hfr := Submodule.finrank_sup_add_finrank_inf_eq (prim W N) (S ⊓ W.grading (N : ℤ))
  rw [hdisj, finrank_bot, add_zero] at hfr
  have hle : Module.finrank ℂ ↥(prim W N ⊔ (S ⊓ W.grading (N : ℤ))) ≤
      Module.finrank ℂ (W.grading (N : ℤ)) :=
    Submodule.finrank_mono (sup_le hPle inf_le_right)
  have h2N := hsum N le_rfl
  rw [htop] at hN
  have hSN : dimG W.grading S N = Module.finrank ℂ ↥(S ⊓ W.grading (N : ℤ)) := rfl
  omega

end VOA.Classification.COne.OrbPrim
