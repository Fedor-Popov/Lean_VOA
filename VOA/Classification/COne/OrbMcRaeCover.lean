import VOA.Classification.COne.OrbRatSplitting
import VOA.Classification.COne.PlusFiniteLengthCyclic
import VOA.Classification.COne.PlusSplitZhuBottom

/-!
# McRae's rationality argument (arXiv:2108.01898v3, §5.3, the case `A = V`), reduced to covers

McRae's Main Theorem 3 (Corollary 5.19) has two halves.

* The **categorical half**: for a strongly finite VOA `V` with semisimple Zhu algebra, the category
  `C` of grading-restricted generalized modules has projective covers (Huang, arXiv:0712.4109), is
  rigid (McRae Thm 5.8, via two-point genus-one functions) and factorizable (McRae Thm 5.3), hence
  unimodular (ENO Prop 4.5), so the projective cover `P_S` of a simple `S` is also its injective
  hull and has essential simple socle `S` (McRae Prop 5.14 plus projective = injective).
* The **Zhu half** (McRae Thm 5.18 for `A = V`, `g = id`): from those covers and semisimplicity of
  `A(V)`, every simple module is projective, by induction on the lowest conformal weight.

This file proves the Zhu half for every `C₂`-cofinite VOA `W`, and isolates the categorical half
as ONE named `Prop`, `McRaeCoverFact W` (NOT proved, NOT an axiom):

  every simple weak `W`-module `S` has a cover `p : P ↠ S` with
  * `P` of finite length and projective relative to finite-length weak modules (`IsProjFL`),
  * superfluous kernel (a submodule of `P` mapping onto `S` is all of `P`),
  * an injection `i : S ↪ P` whose image lies in every nonzero submodule of `P`.

Main results (all `#print axioms`-clean, conditional on the displayed hypotheses):

* `projW_of_mcRaeCover (hC2) (hss) (hcov) (h) : ProjW W h` — every finite-length weak module
  surjecting onto a simple module (of any bottom `h`) splits.
* `resonantWholeSplitting_of_mcRaeCover` and
  `admissiblyRational_of_mcRaeCover (hC2) (hss) (hcov) : AdmissiblyRational W`.

The induction (McRae's, with his injectivity step replaced by the socle field):
1. *No weights below `h` in `P_S`.*  If `x ∈ P_S` has generalized weight `m`, `Re m < Re h`, then
   the cyclic module `⟨x⟩` has a simple quotient of bottom `m'`, `Re m' ≤ Re m`.  By induction that
   quotient is projective, so it is (isomorphic to) a nonzero submodule `d ⊆ ⟨x⟩ ⊆ P_S`; the socle
   field forces `i(S) = d`, so `S` has generalized weight `m'`, contradicting `Re h ≤ Re m'`.
2. *Top splitting.*  Regrade `P_S` with level zero at `h` (`exists_admissible_at_spectral_bottom`);
   Zhu semisimplicity gives a zero-mode stable complement `S₀` to `ker p ∩ P(0)`
   (`exists_bottom_complement`).  The module generated by `S₀` maps onto `S`, so it is `P_S`
   (superfluous kernel), and bottom recovery (`genSub_le_bottom`) gives `ker p ∩ P(0) = 0`.
3. *`p` is injective.*  `i(S)` meets level zero outside `ker p`, so `i(S) ⊄ ker p`; the socle field
   then forces `ker p = 0`.  A projective `P_S ≅ S` splits every surjection onto `S`.

The induction measure is `∑_{ν ∈ s} ⌈Re h − Re ν⌉₊`, where `s` is the finite set of natural-number
rays carrying every generalized weight of every weak module
(`exists_finite_weak_conformal_spectrum`, a `C₂` theorem); it strictly decreases along
`Re m' < Re h`.
-/

set_option maxSynthPendingDepth 3

noncomputable section

namespace VOA.Classification.COne.OrbMcRae

open VOA VertexOperatorAlgebra PlusRational PlusSplitting ABDWeakAdmissible
open VOA.Huang.LogRemovalAdmissible VOA.Huang.BottomRecovery

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}

/-! ## The categorical input -/

/-- Projectivity relative to finite-length weak modules: every map to the target of a surjection
from a finite-length weak module lifts. -/
def IsProjFL {P : Type u} [AddCommGroup P] [Module ℂ P] (BP : WeakModule W P) : Prop :=
  ∀ {Y Z : Type u} [AddCommGroup Y] [Module ℂ Y] [AddCommGroup Z] [Module ℂ Z]
    (BY : WeakModule W Y) (BZ : WeakModule W Z),
    IsFiniteLength (modeAlg BY) Y →
    ∀ g : BY.Hom BZ, Function.Surjective g.toLinearMap →
    ∀ f : BP.Hom BZ, ∃ k : BP.Hom BY, ∀ x, g.toLinearMap (k.toLinearMap x) = f.toLinearMap x

/-- A projective cover of `S` with essential socle `S` (Huang's projective cover, together with
McRae's unimodularity consequence `S ↪ P_S` and `P_S` injective). -/
structure McRaeCover {X : Type u} [AddCommGroup X] [Module ℂ X] (B : WeakModule W X) where
  /-- The carrier of the cover. -/
  P : Type u
  [acg : AddCommGroup P]
  [mod : Module ℂ P]
  /-- The weak-module structure of the cover. -/
  BP : WeakModule W P
  /-- The covering surjection. -/
  p : BP.Hom B
  /-- The socle embedding. -/
  i : B.Hom BP
  finiteLength : IsFiniteLength (modeAlg BP) P
  proj : IsProjFL BP
  surj : Function.Surjective p.toLinearMap
  /-- Superfluous kernel. -/
  superfluous : ∀ N : Submodule (modeAlg BP) P, modeMap p N = ⊤ → N = ⊤
  inj : Function.Injective i.toLinearMap
  /-- Essential simple socle: the image of `S` lies in every nonzero submodule. -/
  socle : ∀ N : Submodule (modeAlg BP) P, N ≠ ⊥ → modeMap i ⊤ ≤ N

attribute [instance] McRaeCover.acg McRaeCover.mod

/-- **The categorical half of McRae's theorem, as a named `Prop`** (NOT proved, NOT an axiom):
every simple weak `W`-module has a McRae cover. -/
def McRaeCoverFact (W : VertexOperatorAlgebra 𝒱) : Prop :=
  ∀ {X : Type u} [AddCommGroup X] [Module ℂ X] (B : WeakModule W X),
    IsSimpleModule (modeAlg B) X → Nonempty (McRaeCover B)

/-- Every finite-length weak module surjecting onto a simple module of bottom `h` splits. -/
def ProjW (W : VertexOperatorAlgebra 𝒱) (h : ℂ) : Prop :=
  ∀ {Y : Type u} [AddCommGroup Y] [Module ℂ Y] (BY : WeakModule W Y)
    (K : Submodule (modeAlg BY) Y), K ⋖ ⊤ → FactorBottom BY K ⊤ h →
    IsFiniteLength (modeAlg BY) Y → ∃ Q : Submodule (modeAlg BY) Y, IsCompl K Q

/-! ## Generalized eigenvectors and intertwiners -/

section Eigen

variable {X Y : Type u} [AddCommGroup X] [Module ℂ X] [AddCommGroup Y] [Module ℂ Y]

theorem L0_hom {A : WeakModule W X} {B : WeakModule W Y} (π : A.Hom B) (x : X) :
    π.toLinearMap (L0 A x) = L0 B (π.toLinearMap x) :=
  π.map_act W.conformalVector 1 x

theorem pow_hom {A : WeakModule W X} {B : WeakModule W Y} (π : A.Hom B) (m : ℂ) (n : ℕ)
    (x : X) : π.toLinearMap (((L0 A - m • 1) ^ n) x) = ((L0 B - m • 1) ^ n) (π.toLinearMap x) := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ', Module.End.mul_apply, pow_succ', Module.End.mul_apply, ← ih]
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply, map_sub,
      map_smul, L0_hom]

theorem mem_gen_of_hom_injective {A : WeakModule W X} {B : WeakModule W Y} (π : A.Hom B)
    (hπ : Function.Injective π.toLinearMap) (m : ℂ) {x : X}
    (hx : π.toLinearMap x ∈ (L0 B).maxGenEigenspace m) : x ∈ (L0 A).maxGenEigenspace m := by
  obtain ⟨n, hn⟩ := (Module.End.mem_maxGenEigenspace _ m _).mp hx
  apply (Module.End.mem_maxGenEigenspace _ m _).mpr
  refine ⟨n, hπ ?_⟩
  rw [pow_hom, hn, map_zero]

end Eigen

/-- `L(0)` is in the mode algebra. -/
theorem L0_mem_sub {X : Type u} [AddCommGroup X] [Module ℂ X] (A : WeakModule W X)
    (P : Submodule (modeAlg A) X) {x : X} (hx : x ∈ P) : L0 A x ∈ P :=
  (ofR A P).act_mem W.conformalVector 1 hx

theorem pow_mem_sub {X : Type u} [AddCommGroup X] [Module ℂ X] (A : WeakModule W X)
    (P : Submodule (modeAlg A) X) (m : ℂ) (n : ℕ) {x : X} (hx : x ∈ P) :
    ((L0 A - m • 1) ^ n) x ∈ P := by
  induction n generalizing x with
  | zero => simpa using hx
  | succ n ih =>
    rw [pow_succ', Module.End.mul_apply]
    have h1 := ih hx
    simp only [LinearMap.sub_apply, LinearMap.smul_apply, Module.End.one_apply]
    exact P.sub_mem (L0_mem_sub A P h1) (P.smul_of_tower_mem m h1)

/-- The `Q`-component of a generalized eigenvector, along a complement pair `K ⊕ Q`, is a
generalized eigenvector. -/
theorem gen_component {X : Type u} [AddCommGroup X] [Module ℂ X] (A : WeakModule W X)
    {K Q : Submodule (modeAlg A) X} (hKQ : Disjoint K Q) (m : ℂ) {k q : X} (hk : k ∈ K)
    (hq : q ∈ Q) (hz : k + q ∈ (L0 A).maxGenEigenspace m) :
    q ∈ (L0 A).maxGenEigenspace m := by
  obtain ⟨n, hn⟩ := (Module.End.mem_maxGenEigenspace _ m _).mp hz
  apply (Module.End.mem_maxGenEigenspace _ m _).mpr
  refine ⟨n, ?_⟩
  rw [map_add] at hn
  have h1 := pow_mem_sub A K m n hk
  have h2 := pow_mem_sub A Q m n hq
  have heq : ((L0 A - m • 1) ^ n) q = -(((L0 A - m • 1) ^ n) k) := eq_neg_of_add_eq_zero_right hn
  exact (Submodule.disjoint_def.mp hKQ) _ (heq ▸ K.neg_mem h1) h2

/-! ## The induction measure -/

/-- `∑_{ν ∈ s} ⌈Re c − Re ν⌉₊`. -/
def measure (s : Finset ℂ) (c : ℂ) : ℕ := ∑ ν ∈ s, ⌈c.re - ν.re⌉₊

theorem measure_lt (s : Finset ℂ) {c c' : ℂ} (hc' : ∃ ν ∈ s, ∃ n : ℕ, c' = ν + n)
    (hlt : c'.re < c.re) : measure s c' < measure s c := by
  obtain ⟨ν, hν, n, rfl⟩ := hc'
  apply Finset.sum_lt_sum
  · intro μ _
    exact Nat.ceil_mono (by linarith)
  · refine ⟨ν, hν, ?_⟩
    have h1 : ((ν + (n : ℂ)).re - ν.re) = (n : ℝ) := by simp
    rw [h1, Nat.ceil_natCast]
    apply Nat.lt_ceil.mpr
    have : ((ν + (n : ℂ)).re) = ν.re + n := by simp
    linarith


/-! ## Step 1: no weights below the bottom in the cover -/

section Steps

variable {X P : Type u} [AddCommGroup X] [Module ℂ X] [AddCommGroup P] [Module ℂ P]

/-- A nonzero generalized eigenvector `x` of weight `m` in a weak module yields a finite-length
cyclic weak module with a coatom whose quotient bottom has real part at most `Re m`. -/
theorem nonzero_eigen_witness {s : Finset ℂ} {h : ℂ}
    (IH : ∀ m', (∃ ν ∈ s, ∃ n : ℕ, m' = ν + n) → m'.re < h.re → ProjW W m')
    (hs : ∀ {M : Type u} [AddCommGroup M] [Module ℂ M] (A : WeakModule W M) (α : ℂ),
      (L0 A).maxGenEigenspace α ≠ ⊥ → ∃ μ ∈ s, ∃ n : ℕ, α = μ + n)
    (hC2 : C2Cofinite W) (B : WeakModule W X) (hbot : FactorBottom B ⊥ ⊤ h)
    (BP : WeakModule W P) (i : B.Hom BP) (hinj : Function.Injective i.toLinearMap)
    (hsoc : ∀ N : Submodule (modeAlg BP) P, N ≠ ⊥ → modeMap i ⊤ ≤ N)
    (m : ℂ) (hm : (L0 BP).maxGenEigenspace m ≠ ⊥) : h.re ≤ m.re := by
  by_contra hlt'
  have hlt : m.re < h.re := not_le.mp hlt'
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm
  obtain ⟨k, hk⟩ := Module.End.mem_genEigenspace_top.mp hx
  -- the cyclic weak module generated by `x`
  let Nc := cyclic BP x
  let BN : WeakModule W (ofR BP Nc).carrier := WeakModule.submodule BP (ofR BP Nc)
  let z : (ofR BP Nc).carrier := ⟨x, Submodule.mem_span_singleton_self x⟩
  let ι : BN.Hom BP := { toLinearMap := ((ofR BP Nc).carrier).subtype
                         map_act := fun _ _ _ => rfl }
  have hιinj : Function.Injective ι.toLinearMap := Subtype.val_injective
  have hcyc : cyclic BN z = ⊤ := cyclic_restriction_eq_top BP x
  have hz : ((L0 BN - m • 1) ^ k) z = 0 := by
    apply hιinj
    rw [pow_hom ι m k z, map_zero]
    exact hk
  have hFL : IsFiniteLength (modeAlg BN) (ofR BP Nc).carrier :=
    PlusFiniteLength.finiteLength_of_generalized_cyclic hC2 k BN z m hz hcyc
  have hzne : z ≠ 0 := fun h0 => hx0 (congrArg Subtype.val h0)
  have hzgen : z ∈ (L0 BN).maxGenEigenspace m :=
    mem_gen_of_hom_injective ι hιinj m hx
  -- a coatom of the cyclic module
  obtain ⟨hN, hA⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp hFL
  have hbt : (⊥ : Submodule (modeAlg BN) (ofR BP Nc).carrier) ≠ ⊤ := by
    intro he
    apply hzne
    have hm' : z ∈ (⊤ : Submodule (modeAlg BN) (ofR BP Nc).carrier) := Submodule.mem_top
    rw [← he] at hm'
    exact (Submodule.mem_bot _).mp hm'
  obtain ⟨K', hK', -⟩ := (IsCoatomic.eq_top_or_exists_le_coatom
    (⊥ : Submodule (modeAlg BN) (ofR BP Nc).carrier)).resolve_left hbt
  have hKcov : K' ⋖ ⊤ := covBy_top_iff.mpr hK'
  obtain ⟨m', hm'⟩ := exists_factorBottom hC2 BN hK'.lt_top
  -- `z ∉ K'`
  have hzK : z ∉ K' := by
    intro hzK
    apply hK'.1
    rw [eq_top_iff, ← hcyc]
    exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hzK)
  have hFWm : FactorWeight BN K' ⊤ m := by
    intro hle
    exact hzK (hle ⟨Submodule.mem_top, hzgen⟩)
  have hm'le : m'.re ≤ m.re := hm'.2 m hFWm
  have hm's : ∃ ν ∈ s, ∃ n : ℕ, m' = ν + n := by
    apply hs BN m'
    intro he
    apply hm'.1
    rw [he, inf_bot_eq]
    exact bot_le
  obtain ⟨Q', hQ'⟩ := IH m' hm's (lt_of_le_of_lt hm'le hlt) BN K' hKcov hm' hFL
  -- a nonzero generalized `m'`-vector in `Q'`
  obtain ⟨z', ⟨-, hz'gen⟩, hz'K⟩ := SetLike.not_le_iff_exists.mp hm'.1
  have hz'sup : z' ∈ K' ⊔ Q' := by rw [hQ'.sup_eq_top]; exact Submodule.mem_top
  obtain ⟨a, ha, q, hq, haq⟩ := Submodule.mem_sup.mp hz'sup
  have hqgen : q ∈ (L0 BN).maxGenEigenspace m' :=
    gen_component BN hQ'.disjoint m' ha hq (haq ▸ hz'gen)
  have hq0 : q ≠ 0 := by
    intro h0
    apply hz'K
    rw [← haq, h0, add_zero]
    exact ha
  -- `Q'` is an atom, and so is its image `d`
  have hQatom : IsAtom Q' := (hQ'.symm.isAtom_iff_isCoatom).mpr hK'
  have hk0 : modeComap ι ⊥ ≤ ⊥ := by
    intro y hy
    have hy' : ι.toLinearMap y = 0 := hy
    exact (Submodule.mem_bot _).mpr (hιinj (hy'.trans (map_zero _).symm))
  have hdcov := modeMap_covBy ι (bot_covBy_iff.mpr hQatom) hk0
  have hmb : modeMap ι (⊥ : Submodule (modeAlg BN) (ofR BP Nc).carrier) = ⊥ := by
    apply Submodule.restrictScalars_injective ℂ
    change ((⊥ : Submodule (modeAlg BN) (ofR BP Nc).carrier).restrictScalars ℂ).map
      ι.toLinearMap = ⊥
    rw [Submodule.restrictScalars_bot, Submodule.map_bot]
  rw [hmb] at hdcov
  have hdatom : IsAtom (modeMap ι Q') := bot_covBy_iff.mp hdcov
  -- the socle image equals `d`
  have hXnt : ∃ y : X, y ∈ (L0 B).maxGenEigenspace h ∧ y ≠ 0 := by
    obtain ⟨y, ⟨-, hy⟩, hy0⟩ := SetLike.not_le_iff_exists.mp hbot.1
    exact ⟨y, hy, fun h0 => hy0 (h0 ▸ Submodule.zero_mem _)⟩
  obtain ⟨y0, -, hy0⟩ := hXnt
  have hine : modeMap i ⊤ ≠ ⊥ := by
    intro he
    apply hy0
    have hmem : i.toLinearMap y0 ∈ modeMap i ⊤ := ⟨y0, Submodule.mem_top, rfl⟩
    rw [he] at hmem
    exact hinj (((Submodule.mem_bot _).mp hmem).trans (map_zero _).symm)
  have hdne : modeMap ι Q' ≠ ⊥ := hdatom.1
  have hid : modeMap i ⊤ = modeMap ι Q' :=
    ((hdatom.le_iff).mp (hsoc _ hdne)).resolve_left hine
  -- transport `q` back to `S`
  have hqd : ι.toLinearMap q ∈ modeMap ι Q' := ⟨q, hq, rfl⟩
  rw [← hid] at hqd
  obtain ⟨y, -, hy⟩ := hqd
  have hygen : y ∈ (L0 B).maxGenEigenspace m' := by
    apply mem_gen_of_hom_injective i hinj m'
    rw [hy]
    exact map_mem_maxGenEigenspace (L0 BN) (L0 BP) ι.toLinearMap (L0_hom ι) m' hqgen
  have hyne : y ≠ 0 := by
    intro h0
    apply hq0
    apply hιinj
    rw [← hy, h0, map_zero, map_zero]
  have hFW : FactorWeight B ⊥ ⊤ m' := by
    intro hle
    exact hyne ((Submodule.mem_bot _).mp (hle ⟨Submodule.mem_top, hygen⟩))
  have := hbot.2 m' hFW
  linarith

/-- Steps 2 and 3: when the cover has no weights below `h`, Zhu semisimplicity and the socle
field force the covering map to be injective. -/
theorem cover_injective (hC2 : C2Cofinite W)
    (hss : letI := instRingA W; IsSemisimpleRing (VOA.A W))
    (B : WeakModule W X) (hsimple : IsSimpleModule (modeAlg B) X) {h : ℂ}
    (hbot : FactorBottom B ⊥ ⊤ h)
    (BP : WeakModule W P) (p : BP.Hom B) (i : B.Hom BP)
    (hsurj : Function.Surjective p.toLinearMap)
    (hsup : ∀ N : Submodule (modeAlg BP) P, modeMap p N = ⊤ → N = ⊤)
    (hinj : Function.Injective i.toLinearMap)
    (hsoc : ∀ N : Submodule (modeAlg BP) P, N ≠ ⊥ → modeMap i ⊤ ≤ N)
    (hlow : ∀ m, (L0 BP).maxGenEigenspace m ≠ ⊥ → h.re ≤ m.re) :
    Function.Injective p.toLinearMap := by
  obtain ⟨N, he, hlev⟩ := exists_admissible_at_spectral_bottom BP
    (weak_spectral_decomposition BP (weakL0LocallyFinite hC2 BP)) h hlow
  subst he
  set K₀ := modeComap p ⊥ with hK₀
  have hmemK : ∀ x, x ∈ K₀ ↔ p.toLinearMap x = 0 := fun x => Iff.rfl
  have hptop : modeMap p ⊤ = ⊤ := by
    apply top_unique
    intro y _
    obtain ⟨x, rfl⟩ := hsurj y
    exact ⟨x, Submodule.mem_top, rfl⟩
  have hpK : modeMap p K₀ = ⊥ := by
    rw [hK₀, modeMap_comap, bot_inf_eq]
  have hFW : FactorWeight N.toWeakModule K₀ ⊤ h := by
    have h1 : FactorWeight B (modeMap p K₀) (modeMap p ⊤) h := by
      rw [hpK, hptop]; exact hbot.1
    exact (factorWeight_modeMap_iff hC2 p K₀ ⊤ le_rfl h).mp h1
  obtain ⟨S0, hS0, hSo, hd, hsum⟩ := exists_bottom_complement hss N K₀
  -- `S0 ⊄ K₀`
  have hS0K : ∃ s0 ∈ S0, s0 ∉ K₀ := by
    by_contra hn
    push Not at hn
    apply hFW
    intro y hy
    have hy0 : y ∈ N.lev 0 := hlev hy.2
    rw [← hsum] at hy0
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hy0
    exact K₀.add_mem ha.1 (hn b hb)
  obtain ⟨s0, hs0S, hs0K⟩ := hS0K
  -- the submodule generated by `S0` is everything
  let G : Submodule (modeAlg N.toWeakModule) P := toR N.toWeakModule (genSub (N := N) S0)
  have hs0G : s0 ∈ G := le_genSub (N := N) S0 hs0S
  have hGtop : G = ⊤ := by
    apply hsup
    rcases hsimple.eq_bot_or_eq_top (modeMap p G) with hb | ht
    · exfalso
      apply hs0K
      have hm : p.toLinearMap s0 ∈ modeMap p G := ⟨s0, hs0G, rfl⟩
      rw [hb] at hm
      exact (Submodule.mem_bot _).mp hm
    · exact ht
  -- hence level zero lies in `S0`, and meets `K₀` trivially
  have hlevS : ∀ y ∈ N.lev 0, y ∈ S0 := by
    intro y hy
    have hyG : y ∈ G := by rw [hGtop]; exact Submodule.mem_top
    exact genSub_le_bottom (N := N) S0 hS0 hSo hyG hy
  have hKlev : ∀ y, y ∈ K₀ → y ∈ N.lev 0 → y = 0 := fun y hyK hy0 =>
    (Submodule.disjoint_def.mp hd) y hyK (hlevS y hy0)
  -- the socle image is not inside `K₀`
  obtain ⟨y, ⟨-, hygen⟩, hy0⟩ := SetLike.not_le_iff_exists.mp hbot.1
  have hyne : y ≠ 0 := fun h0 => hy0 (h0 ▸ Submodule.zero_mem _)
  have hnot : ¬ modeMap i ⊤ ≤ K₀ := by
    intro hle
    apply hyne
    apply hinj
    rw [map_zero]
    apply hKlev
    · exact hle ⟨y, Submodule.mem_top, rfl⟩
    · exact hlev (map_mem_maxGenEigenspace (L0 B) (L0 N.toWeakModule) i.toLinearMap
        (L0_hom i) h hygen)
  have hKbot : K₀ = ⊥ := by
    by_contra hne
    exact hnot (hsoc K₀ hne)
  intro a b hab
  have hsub : a - b ∈ K₀ := by
    rw [hmemK, map_sub, hab, sub_self]
  rw [hKbot] at hsub
  exact sub_eq_zero.mp ((Submodule.mem_bot _).mp hsub)

end Steps


/-! ## The induction -/

/-- **McRae §5.3 (case `A = V`), Zhu half.**  For a `C₂`-cofinite VOA with semisimple Zhu
algebra, McRae covers make every simple module projective: every finite-length weak module
surjecting onto a simple module of bottom `h` splits. -/
theorem projW_of_mcRaeCover (hC2 : C2Cofinite W)
    (hss : letI := instRingA W; IsSemisimpleRing (VOA.A W))
    (hcov : McRaeCoverFact W) (h : ℂ) : ProjW W h := by
  obtain ⟨s, hs⟩ := exists_finite_weak_conformal_spectrum (W := W) hC2
  suffices H : ∀ n : ℕ, ∀ h : ℂ, measure s h = n → ProjW W h by
    exact @H (measure s h) h rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n IHn =>
  intro h hn Y _ _ BY K hKcov hbotK hFL
  have IH : ∀ m', (∃ ν ∈ s, ∃ n : ℕ, m' = ν + n) → m'.re < h.re → ProjW W m' :=
    fun m' hm' hlt => IHn _ (hn ▸ measure_lt s hm' hlt) m' rfl
  -- the simple quotient `Y / K`
  let BX : WeakModule W (Y ⧸ (ofR BY K).carrier) := WeakModule.quotient BY (ofR BY K)
  let π : BY.Hom BX := WeakModule.quotientMk BY (ofR BY K)
  have hπsurj : Function.Surjective π.toLinearMap := (ofR BY K).carrier.mkQ_surjective
  have hker : modeComap π ⊥ = K := by
    ext x
    exact Submodule.Quotient.mk_eq_zero ((ofR BY K).carrier)
  have htop : modeMap π ⊤ = ⊤ := by
    apply top_unique
    intro y _
    obtain ⟨x, rfl⟩ := hπsurj y
    exact ⟨x, Submodule.mem_top, rfl⟩
  have hzero : modeMap π K = ⊥ := by
    have h1 := modeMap_comap π ⊥
    rw [hker, bot_inf_eq] at h1
    exact h1
  have hbotX : FactorBottom BX ⊥ ⊤ h := by
    have := (factorBottom_modeMap_iff hC2 π K ⊤ hker.le h).mpr hbotK
    rwa [hzero, htop] at this
  have hsimple : IsSimpleModule (modeAlg BX) (Y ⧸ (ofR BY K).carrier) := by
    refine { toIsSimpleOrder := { exists_pair_ne := ⟨⊥, ⊤, ?_⟩, eq_bot_or_eq_top := ?_ } }
    · intro he
      apply hKcov.lt.ne
      have := congrArg (modeComap π) he
      rw [hker] at this
      rw [this]
      ext x
      exact iff_of_true Submodule.mem_top Submodule.mem_top
    · intro D
      have hDK : K ≤ modeComap π D := hker.symm.le.trans (modeComap_mono π bot_le)
      have hDD : modeMap π (modeComap π D) = D := by
        rw [modeMap_comap, htop, inf_top_eq]
      rcases hKcov.wcovBy.eq_or_eq hDK le_top with he | he
      · left; rw [← hDD, he, hzero]
      · right; rw [← hDD, he, htop]
  -- the cover
  obtain ⟨C⟩ := hcov BX hsimple
  obtain ⟨P, BP, p, i, -, hproj, hsurj, hsup, hinj, hsoc⟩ := C
  have hlow : ∀ m, (L0 BP).maxGenEigenspace m ≠ ⊥ → h.re ≤ m.re :=
    nonzero_eigen_witness IH hs hC2 BX hbotX BP i hinj hsoc
  have hpinj : Function.Injective p.toLinearMap :=
    cover_injective hC2 hss BX hsimple hbotX BP p i hsurj hsup hinj hsoc hlow
  -- lift the cover through `π`
  obtain ⟨k, hk⟩ := hproj BY BX hFL π hπsurj p
  refine ⟨modeMap k ⊤, ?_, ?_⟩
  · rw [disjoint_iff]
    apply eq_bot_iff.mpr
    intro y hy
    obtain ⟨hyK, hyQ⟩ := Submodule.mem_inf.mp hy
    obtain ⟨x, -, hx⟩ := hyQ
    subst hx
    have h1 : π.toLinearMap (k.toLinearMap x) = 0 :=
      (Submodule.Quotient.mk_eq_zero ((ofR BY K).carrier)).mpr hyK
    rw [hk] at h1
    have hx : x = 0 := hpinj (h1.trans (map_zero _).symm)
    rw [hx, map_zero]
    exact Submodule.zero_mem _
  · rw [codisjoint_iff]
    apply top_unique
    intro y _
    obtain ⟨x, hx⟩ := hsurj (π.toLinearMap y)
    have hyK : y - k.toLinearMap x ∈ K := by
      apply hker.le
      change π.toLinearMap (y - k.toLinearMap x) = 0
      rw [map_sub, hk, hx, sub_self]
    have : y = (y - k.toLinearMap x) + k.toLinearMap x := by abel
    rw [this]
    exact Submodule.add_mem_sup hyK ⟨x, Submodule.mem_top, rfl⟩

/-- Length-two weak modules have finite length. -/
theorem isFiniteLength_of_atom_coatom {X : Type u} [AddCommGroup X] [Module ℂ X]
    (B : WeakModule W X) (Pa : Submodule (modeAlg B) X) (hP : IsAtom Pa) (hQ : Pa ⋖ ⊤) :
    IsFiniteLength (modeAlg B) X := by
  haveI : IsSimpleModule (modeAlg B) Pa := isSimpleModule_iff_isAtom.mpr hP
  haveI : IsSimpleModule (modeAlg B) (X ⧸ Pa) :=
    isSimpleModule_iff_isCoatom.mpr (covBy_top_iff.mp hQ)
  haveI : IsSimpleModule (modeAlg B) (Pa ⧸ (⊥ : Submodule (modeAlg B) Pa)) :=
    IsSimpleModule.congr (Submodule.quotEquivOfEqBot ⊥ rfl)
  have hPa : IsFiniteLength (modeAlg B) Pa :=
    .of_simple_quotient (N := ⊥) .of_subsingleton
  exact .of_simple_quotient (N := Pa) hPa

/-- Resonant whole splitting from McRae covers (in fact every length-two extension splits). -/
theorem resonantWholeSplitting_of_mcRaeCover (hC2 : C2Cofinite W)
    (hss : letI := instRingA W; IsSemisimpleRing (VOA.A W))
    (hcov : McRaeCoverFact W) : OrbRat.ResonantWholeSplitting W := by
  intro X _ _ B Pa h k hP hQ _ ht _
  exact projW_of_mcRaeCover hC2 hss hcov k B Pa hQ ht (isFiniteLength_of_atom_coatom B Pa hP hQ)

/-- **McRae's Zhu criterion, reduced to the categorical half.**  A `C₂`-cofinite VOA with
semisimple Zhu algebra and McRae covers is (admissibly) rational. -/
theorem admissiblyRational_of_mcRaeCover (hC2 : C2Cofinite W)
    (hss : letI := instRingA W; IsSemisimpleRing (VOA.A W))
    (hcov : McRaeCoverFact W) : AdmissiblyRational W :=
  OrbRat.admissiblyRational_of_resonantWholeSplitting hC2 hss
    (resonantWholeSplitting_of_mcRaeCover hC2 hss hcov)


/-! ## Exactness of the reduction: rational VOAs have McRae covers -/

section Converse

variable {Y Z X : Type u} [AddCommGroup Y] [Module ℂ Y] [AddCommGroup Z] [Module ℂ Z]
  [AddCommGroup X] [Module ℂ X]

/-- In a weak module that is semisimple over its mode algebra, every map into the target of a
surjection lifts. -/
theorem exists_lift_of_semisimple (BY : WeakModule W Y) (BZ : WeakModule W Z) (BX : WeakModule W X)
    [IsSemisimpleModule (modeAlg BY) Y] (g : BY.Hom BZ) (hg : Function.Surjective g.toLinearMap)
    (f : BX.Hom BZ) :
    ∃ k : BX.Hom BY, ∀ x, g.toLinearMap (k.toLinearMap x) = f.toLinearMap x := by
  obtain ⟨C, hC⟩ := exists_isCompl (modeComap g ⊥)
  let Cc : Submodule ℂ Y := C.restrictScalars ℂ
  let gC : Cc →ₗ[ℂ] Z := g.toLinearMap ∘ₗ Cc.subtype
  have hinj : Function.Injective gC := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro c hc
    have h0 : (c : Y) = 0 :=
      (Submodule.disjoint_def.mp hC.disjoint) _ (show g.toLinearMap c = 0 from hc) c.2
    exact (Submodule.mem_bot ℂ).mpr (Subtype.ext h0)
  have hsurj : Function.Surjective gC := by
    intro z
    obtain ⟨y, rfl⟩ := hg z
    have hy : y ∈ modeComap g ⊥ ⊔ C := by rw [hC.sup_eq_top]; exact Submodule.mem_top
    obtain ⟨a, ha, c, hc, rfl⟩ := Submodule.mem_sup.mp hy
    refine ⟨⟨c, hc⟩, ?_⟩
    change g.toLinearMap c = g.toLinearMap (a + c)
    rw [map_add, show g.toLinearMap a = 0 from ha, zero_add]
  let e : Cc ≃ₗ[ℂ] Z := LinearEquiv.ofBijective gC ⟨hinj, hsurj⟩
  have he : ∀ c : Cc, e c = g.toLinearMap c := fun _ => rfl
  refine ⟨{ toLinearMap := Cc.subtype ∘ₗ e.symm.toLinearMap ∘ₗ f.toLinearMap,
             map_act := ?_ }, ?_⟩
  · intro a n x
    let c := e.symm (f.toLinearMap x)
    have hcm : BY.act a n (c : Y) ∈ Cc := (ofR BY C).act_mem a n c.2
    have hc' : e.symm (f.toLinearMap (BX.act a n x)) = ⟨BY.act a n (c : Y), hcm⟩ := by
      apply e.injective
      rw [LinearEquiv.apply_symm_apply, he, f.map_act]
      change _ = g.toLinearMap (BY.act a n (c : Y))
      rw [g.map_act]
      congr 1
      have : e c = f.toLinearMap x := LinearEquiv.apply_symm_apply e _
      rw [he] at this
      exact this.symm
    change ((e.symm (f.toLinearMap (BX.act a n x)) : Cc) : Y) = BY.act a n (c : Y)
    rw [hc']
  · intro x
    change g.toLinearMap ((e.symm (f.toLinearMap x) : Cc) : Y) = f.toLinearMap x
    rw [← he, LinearEquiv.apply_symm_apply]

/-- The identity cover of a simple module of a rational VOA is a McRae cover. -/
theorem mcRaeCoverFact_of_admissiblyRational (hC2 : C2Cofinite W)
    (hss : letI := instRingA W; IsSemisimpleRing (VOA.A W)) (hR : AdmissiblyRational W) :
    McRaeCoverFact W := by
  intro X _ _ B hsimple
  have hres : OrbRat.ResonantWholeSplitting W := by
    intro Y _ _ BY Pa h k a b c d e
    exact OrbRat.resonantWholeSplitting_of_admissiblyRational hC2 hR BY Pa h k a b c d e
  have hss' : ∀ {Y : Type u} [AddCommGroup Y] [Module ℂ Y] (BY : WeakModule W Y),
      IsSemisimpleModule (modeAlg BY) Y := fun BY =>
    semisimple_of_generalized_cyclic_splitting hC2 BY (fun _ x _ =>
      twoStepSplitting_submodule
        (OrbRat.twoStepSplitting_of_resonantWholeSplitting hC2 hss hres BY) (cyclic BY x))
  let idH : B.Hom B := { toLinearMap := LinearMap.id, map_act := fun _ _ _ => rfl }
  have hmap : ∀ N : Submodule (modeAlg B) X, modeMap idH N = N := by
    intro N
    apply Submodule.restrictScalars_injective ℂ
    change (N.restrictScalars ℂ).map LinearMap.id = N.restrictScalars ℂ
    exact Submodule.map_id _
  refine ⟨{ P := X, BP := B, p := idH, i := idH, finiteLength := ?_, proj := ?_,
            surj := Function.surjective_id, superfluous := ?_,
            inj := Function.injective_id, socle := ?_ }⟩
  · haveI : IsSimpleModule (modeAlg B) (X ⧸ (⊥ : Submodule (modeAlg B) X)) :=
      IsSimpleModule.congr (Submodule.quotEquivOfEqBot ⊥ rfl)
    exact .of_simple_quotient (N := ⊥) .of_subsingleton
  · intro Y Z _ _ _ _ BY BZ _ g hg f
    haveI := hss' BY
    exact exists_lift_of_semisimple BY BZ B g hg f
  · intro N hN
    rwa [hmap] at hN
  · intro N hN
    rw [hmap]
    rcases hsimple.eq_bot_or_eq_top N with h | h
    · exact absurd h hN
    · rw [h]

end Converse

/-- **The reduction is exact**: for a `C₂`-cofinite VOA with semisimple Zhu algebra, McRae
covers exist if and only if the VOA is (admissibly) rational. -/
theorem mcRaeCoverFact_iff_admissiblyRational (hC2 : C2Cofinite W)
    (hss : letI := instRingA W; IsSemisimpleRing (VOA.A W)) :
    McRaeCoverFact W ↔ AdmissiblyRational W :=
  ⟨admissiblyRational_of_mcRaeCover hC2 hss, mcRaeCoverFact_of_admissiblyRational hC2 hss⟩

end VOA.Classification.COne.OrbMcRae
