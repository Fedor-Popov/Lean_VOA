   sc2548Part1,
   sc2548Part2].flatten

set_option maxHeartbeats 2000000 in
-- Exact normalization of at most 231 oscillator monomials.
set_option maxRecDepth 4096 in
theorem sc2548_check :
    reduceTwo (prependC 1 sc1895 ++ scaleR (-1) (prependC 0 sc1896)) = sc2548 := by
  decide +kernel

theorem sc2548_sound {r : ℕ} (a : Fin r) (c : ℂ)
    (hc : c * c = ((2 : ℚ) : ℂ)) :
    evRc a c sc2548 = evRc a c (expWordR [1, 2, 2, 4, 4] (-1)) := by
  rw [← sc2548_check]
  exact expTwo_step _ _ hc 0 [2, 2, 4, 4] (-1)
    sc1895 sc1896 (sc1895_sound a c hc) (sc1896_sound a c hc)

