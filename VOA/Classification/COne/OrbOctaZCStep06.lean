set_option maxHeartbeats 500000 in
-- One row is added, and all equal mode indices are merged.
theorem step14_check :
    equalRelCheck (scaleRel weight_sing13 sing13 ++ partial13)
      partial14 = true := by decide +kernel

theorem partial14_holds : evalRel W selfMode partial14 = 0 := by
  have h := equalRelCheck_sound W selfMode step14_check
  rw [evalRel_append, evalRel_scale, sing13_holds, map_zero, partial13_holds,
    add_zero] at h
  exact h.symm

end VOA.Classification.COne.OrbOctaZC
