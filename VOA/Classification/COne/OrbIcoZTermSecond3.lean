noncomputable section
namespace VOA.Classification.COne.OrbIcoZ
open VOA OrbOdd OrbZhu Polynomial OrbIco

def detTermSecond3 : PL := [mkRat (0) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat () 1]

set_option maxHeartbeats 8000000 in
-- One product only: avoid retaining the full determinant calculation in one reduction.
theorem detTermSecond3_check :
    ptrim (paddL (pmulL matrixEntry9_3 commonMinor3) (pscaleL (-1) detTermSecond3)) = [] := by
  decide +kernel

theorem detTermSecond3_sound : zp detTermSecond3 =
    (zp matrixEntry9_3 * zp commonMinor3) := by
  have hh := (zp_eq_of_trim detTermSecond3_check).symm
  simpa [zp_pscaleL, zp_pmulL] using hh

