-- Add ten already cached words; no singular-word recursion is recomputed.
theorem vectorPartial7_check : equalRawCheck (rawChunk7 ++ vectorPartial6) vectorPartial7 = true := by
  decide +kernel

theorem vectorPartial7_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector prefixVector7) = evalSym W k a (symMap vectorPartial7) := by
  rw [prefixVector7, evalSym_vector_append, vectorPartial6_sound W k a,
    vectorChunk7_sound W k a]
  have hh := equalRawCheck_sound W k a vectorPartial7_check
  rw [symMap_append, evalSym_append] at hh
  simpa only [add_comm] using hh

