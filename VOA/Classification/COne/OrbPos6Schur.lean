import VOA.Classification.COne.OrbPos5Delta
import VOA.Moonshine.LatticeTwistedExp
import VOA.Moonshine.HeisenbergTwistedModuleFieldComm

/-! # The scalar binomial correction to the creation exponential under Δ -/

namespace VOA.Classification.COne.OrbPos6
open VOA VOA.IntegralLattice VOA.LatGen VOA.LatGen.Triplet VOA.HeisenbergN
open OrbPos2 OrbPos3 OrbPos4 OrbPos5 LatMod TwistedReduction
open VOA.Moonshine.LatticeTwisted

theorem binomial_alternating_sum (c : ℂ) (N : ℕ) :
    ∑ k ∈ Finset.range (N + 1), (-1 : ℂ) ^ k * cbinom c (N - k) = cbinom (c - 1) N := by
  induction N with
  | zero => simp [cbinom_zero]
  | succ N ih =>
    rw [Finset.sum_range_succ']
    simp only [pow_zero, Nat.sub_zero, one_mul, Nat.add_sub_add_right, pow_succ,
      mul_neg_one, neg_mul, Finset.sum_neg_distrib]
    rw [ih]
    have hp : cbinom c (N + 1) = cbinom (c - 1) N + cbinom (c - 1) (N + 1) := by
      simpa only [sub_add_cancel] using
        (show cbinom ((c - 1) + 1) (N + 1) = cbinom (c - 1) N + cbinom (c - 1) (N + 1) by
          simp only [cbinom_eq_ringChoose, Ring.choose_succ_succ])
    rw [hp]
    ring

/-- The scalar exponential generated by the Δ correction is `(1+X)^c`. -/
theorem nexp_binomial (c : ℂ) (N : ℕ) :
    nexp (fun k => c * (-1 : ℂ) ^ (k - 1)) N = cbinom c N := by
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    cases N with
    | zero => simp [cbinom_zero]
    | succ N =>
      rw [nexp_succ]
      simp only [Nat.add_sub_cancel, smul_eq_mul]
      rw [Finset.sum_congr rfl (fun k hk => by
        rw [ih (N - k) (by omega)]),
        show (∑ k ∈ Finset.range (N + 1), c * (-1 : ℂ) ^ k * cbinom c (N - k)) =
          c * ∑ k ∈ Finset.range (N + 1), (-1 : ℂ) ^ k * cbinom c (N - k) by
            rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro k _; ring,
        binomial_alternating_sum, ← cbinom_succ_mul]
      have h : (N : ℂ) + 1 ≠ 0 := by exact_mod_cast Nat.succ_ne_zero N
      field_simp

theorem vSchur_eq_nexp (β : ℤ) (N : ℕ) :
    vSchur (latP 1) β N = nexp (fun k => vVar (latP 1) β (k - 1)) N := by
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    cases N with
    | zero => rw [vSchur_zero, nexp_zero]
    | succ N =>
      rw [vSchur_succ, nexp_succ]
      simp only [Nat.add_sub_cancel]
      congr 1
      apply Finset.sum_congr rfl
      intro k hk
      rw [ih (N - k) (by omega)]

theorem delta_vVar (t : ℂ) (β : ℤ) (i : ℕ) :
    delta t (vVar (latP 1) β i) = Polynomial.C (vVar (latP 1) β i) +
      Polynomial.C (MvPolynomial.C (-2 * t * β * (-1 : ℂ) ^ i)) * Polynomial.X ^ (i + 1) := by
  have hp := sum_chargeCoord (latP 1) (latP_posDef 1 le_rfl) β (1 : ℤ)
  rw [sum_rankOne, latP_form] at hp
  change chargeCoord (latP 1) β (a0 1) * rootCoord = ((2 * β * 1 : ℤ) : ℂ) at hp
  push_cast at hp
  haveI : Subsingleton (Fin (rank (latP 1))) := by rw [rank_latP]; infer_instance
  letI : Unique (Fin (rank (latP 1))) := ⟨⟨a0 1⟩, fun _ => Subsingleton.elim _ _⟩
  simp only [vVar, Fintype.sum_unique, map_smul, delta_X]
  change _ = Polynomial.C (chargeCoord (latP 1) β (a0 1) •
    (MvPolynomial.X (i, a0 1) : Osc)) + _
  simp only [Algebra.smul_def, Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq,
    map_mul, map_neg, map_pow, map_ofNat, map_one]
  have hp' := congrArg (fun c : ℂ => (Polynomial.C (MvPolynomial.C c) : Polynomial Osc)) hp
  simp only [map_mul, map_ofNat, mul_one] at hp'
  linear_combination -(Polynomial.C (MvPolynomial.C t)) *
    (-1 : Polynomial Osc) ^ i * Polynomial.X ^ (i + 1) * hp'

theorem nexp_congr_pos {R : Type*} [CommRing R] [Algebra ℂ R]
    (d e : ℕ → R) (h : ∀ k, 0 < k → d k = e k) (N : ℕ) :
    nexp d N = nexp e N := by
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    cases N with
    | zero => rw [nexp_zero, nexp_zero]
    | succ N =>
      rw [nexp_succ, nexp_succ]
      congr 1
      apply Finset.sum_congr rfl
      intro k hk
      rw [h (k + 1) (by omega), ih (N - k) (by omega)]

/-- The full Δ correction to every creation-exponential coefficient.
Equivalently, applying Δ to `E⁻(β,z₀)` multiplies its generating series
by `(1+z₀ w)^(-2tβ)`. This keeps both formal variables. -/
theorem delta_vSchur (t : ℂ) (β : ℤ) (N : ℕ) :
    delta t (vSchur (latP 1) β N) =
      ∑ p ∈ Finset.antidiagonal N,
        Polynomial.C (vSchur (latP 1) β p.1) *
          (Polynomial.C (MvPolynomial.C (cbinom (-2 * t * β) p.2)) *
            Polynomial.X ^ p.2) := by
  let d : ℕ → Polynomial Osc := fun k => Polynomial.C (vVar (latP 1) β (k - 1))
  let c : ℂ →ₐ[ℂ] Polynomial Osc := Algebra.ofId ℂ (Polynomial Osc)
  let b : ℕ → ℂ := fun k => (-2 * t * β) * (-1 : ℂ) ^ (k - 1)
  let e : ℕ → Polynomial Osc := fun k => Polynomial.X ^ k * c (b k)
  have hsplit : ∀ k, 0 < k →
      delta t (vVar (latP 1) β (k - 1)) = (d + e) k := by
    intro k hk
    rw [delta_vVar]
    dsimp [d, e, c, b]
    rw [show k - 1 + 1 = k by omega]
    ring
  rw [vSchur_eq_nexp, nexp_map,
    nexp_congr_pos _ (d + e) hsplit]
  have hsum := congrArg (PowerSeries.coeff N) (nexpPS_add d e)
  rw [coeff_nexpPS, PowerSeries.coeff_mul] at hsum
  simp only [coeff_nexpPS] at hsum
  rw [hsum]
  apply Finset.sum_congr rfl
  intro p hp
  have hd : nexp d p.1 = Polynomial.C (vSchur (latP 1) β p.1) := by
    rw [vSchur_eq_nexp]
    exact (nexp_map (Polynomial.CAlgHom (R := ℂ) (A := Osc)) _ _).symm
  have he : nexp e p.2 = Polynomial.X ^ p.2 * c (cbinom (-2 * t * β) p.2) := by
    rw [show e = fun k => Polynomial.X ^ k * c (b k) from rfl, nexp_scale,
      ← nexp_map c b, nexp_binomial]
  rw [hd, he]
  dsimp [c]
  ring

/-- Finite coefficients of the two-variable exponential correction. -/
theorem deltaCoeffs_vSchur (t : ℂ) (β : ℤ) (N : ℕ) :
    deltaCoeffs t (vSchur (latP 1) β N) =
      ∑ q ∈ Finset.range (N + 1), Finsupp.single q
        (cbinom (-2 * t * β) q • vSchur (latP 1) β (N - q)) := by
  change (delta t (vSchur (latP 1) β N)).toFinsupp = _
  rw [delta_vSchur, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
    (fun i k => Polynomial.C (vSchur (latP 1) β i) *
      (Polynomial.C (MvPolynomial.C (cbinom (-2 * t * β) k)) * Polynomial.X ^ k)),
    ← Finset.sum_range_reflect]
  simp only [Nat.succ_sub_one, Nat.succ_eq_add_one]
  have hpoly : (∑ q ∈ Finset.range (N + 1),
      Polynomial.C (vSchur (latP 1) β (N - q)) *
        (Polynomial.C (MvPolynomial.C (cbinom (-2 * t * β) (N - (N - q)))) *
          Polynomial.X ^ (N - (N - q)))) =
      ∑ q ∈ Finset.range (N + 1), Polynomial.monomial q
        (cbinom (-2 * t * β) q • vSchur (latP 1) β (N - q)) := by
    apply Finset.sum_congr rfl
    intro q hq
    have hqN := Finset.mem_range.mp hq
    rw [Nat.sub_sub_self (by omega : q ≤ N)]
    rw [← Polynomial.C_mul_X_pow_eq_monomial, MvPolynomial.smul_eq_C_mul]
    simp only [map_mul]
    ring
  rw [hpoly]
  exact map_sum (Polynomial.toFinsuppIsoLinear Osc) _ _

end VOA.Classification.COne.OrbPos6
