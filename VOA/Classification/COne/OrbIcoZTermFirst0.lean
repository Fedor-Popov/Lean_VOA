import VOA.Classification.COne.OrbIcoZMinor3

/-! One bounded determinant cofactor product. -/
set_option Elab.async false
set_option maxSynthPendingDepth 3
set_option maxRecDepth 100000
set_option linter.style.longLine false
noncomputable section
namespace VOA.Classification.COne.OrbIcoZ
open VOA OrbOdd OrbZhu Polynomial OrbIco

def detTermFirst0 : PL := [mkRat (0) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat () 1, mkRat () 1, mkRat () 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1, mkRat (-) 1]

set_option maxHeartbeats 8000000 in
-- One product only: avoid retaining the full determinant calculation in one reduction.
theorem detTermFirst0_check :
    ptrim (paddL (pscaleL (-1) (pmulL matrixEntry7_0 commonMinor0)) (pscaleL (-1) detTermFirst0)) = [] := by
  decide +kernel

theorem detTermFirst0_sound : zp detTermFirst0 =
    -(zp matrixEntry7_0 * zp commonMinor0) := by
  have hh := (zp_eq_of_trim detTermFirst0_check).symm
  simpa [zp_pscaleL, zp_pmulL] using hh

end VOA.Classification.COne.OrbIcoZ
