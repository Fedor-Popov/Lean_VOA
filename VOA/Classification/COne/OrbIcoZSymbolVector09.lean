theorem vectorPartial9_sound {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) (k : ℤ) (a : ℤ → A W) :
    evalSym W k a (symVector prefixVector9) = evalSym W k a (symMap vectorPartial9) := by
  rw [prefixVector9, evalSym_vector_append, vectorPartial8_sound W k a,
    vectorChunk9_sound W k a]
  have hh := equalRawCheck_sound W k a vectorPartial9_check
  rw [symMap_append, evalSym_append] at hh
  simpa only [add_comm] using hh

