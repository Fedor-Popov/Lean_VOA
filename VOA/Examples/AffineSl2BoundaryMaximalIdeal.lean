import VOA.Core.SimpleImage
import VOA.Examples.AffineSl2BoundaryC2PBWInstances
import VOA.Examples.AffineSl2WakimotoLiLeading
import VOA.Foundations.RootDatum
import VOA.Modules.ZhuPolynomialSimplicity

/-!
# The maximal-singular-ideal gate for boundary affine `sl₂`

This file identifies exactly what remains to transport the classical
Adamović--Milas maximal-submodule theorem into the repository's VOA language.

There are three a priori different objects attached to a vector `s` in the universal affine
vacuum VOA:

* the abstract VOA ideal `SingVec.idealGen W s`;
* the span of all affine-current words applied to `s`, representing `U(ŝl₂)s`;
* for a positive-current-singular `s`, the span of nonpositive-current words.

The first part of the file proves that all-current span and VOA ideal are equal, without a PBW
independence hypothesis.  Positive-current singularity then identifies them with the
nonpositive-current span constructed in `AffineSl2BoundaryC2PBWUpper`.  Consequently the
published statement that `U(ŝl₂)s` is the maximal vacuum submodule has *exactly* the Lean
conclusion needed by the boundary `C₂` proof.

The second part gives an equivalent irreducibility route.  If the quotient by `(s)` is
irreducible merely under the three descended current fields, it is simple as a VOA, and the
generic simple-image theorem forces `(s)` to equal the maximal graded ideal.

## Honest status

All bridges in this file are proved.  What is deliberately not installed as an axiom is the
model-specific representation theorem asserting current irreducibility, or directly that the
all-current span is maximal.  Adamović--Milas, Theorem 3.1.4, is the external source: in their
notation an admissible `k = p/q` has

`L(k,0) = M(k,0) / U(ŝl₂) v_sing`,

with `v_sing` the unique singular vector of the stated weight.  At the boundary levels
`k = -2 + 2/P` with odd `P`, their parameters are `q=P` and `2q+p-1=1`; hence the generator has
conformal weight `P` and horizontal highest weight two.  The remaining Lean step is therefore
not a further VOA-ideal argument: it is a formal carrier for that affine highest-weight theorem
and its identification with the repository's explicit singular vector family.  At present that
family exists concretely only for `P=3` and `P=5`.

The primitive-vector existence half of the usual highest-weight proof is also internal.
Positive energy produces a nonzero vector killed by every positive loop mode in any nonzero
current submodule.  Horizontal `e₀` is locally nilpotent on every negative-current word by an
elementary induction with the three `sl₂` commutators, hence on the universal module and every
singular quotient.  Taking the last nonzero vector in the resulting `e₀` string gives an affine
primitive vector.  Therefore the sharp alternative external input is only the model-specific
statement that the singular quotient has no affine primitive vectors outside its vacuum line.

No `sorry`, `admit`, `native_decide`, or new axiom occurs here.

## Why the generic highest-weight API does not close the gate

`Foundations.AffineLie` constructs an arbitrarily chosen coatom
`AffineLie.vacuumMaxSubmodule` and proves that its quotient is an `IsSimpleModule` over the
universal enveloping algebra.  It does not identify that chosen coatom with
`QuotVOA.maxGradedIdeal`, nor with the submodule generated by a specified admissible singular
vector.  Conversely, `SingVec.idealGen` is bundled as a `ℂ`-submodule, not as a submodule over the
affine universal enveloping algebra.  The current-stability formulation below is therefore the
sharp existing common language: it is proved equivalent both to VOA simplicity of the singular
quotient and to maximal current-submodule generation.
-/

namespace VOA

open VertexOperatorAlgebra

namespace AffineSl2BoundaryMaximalIdeal

open VOA.AffineVOA
open VOA.AffineVOA.Inst
open VOA.AffineVOA.Strong
open VOA.AffineSl2BoundaryC2
open VOA.QuasiLisseSl2
open VOA.SingVec
open VOA.Sl2Pres
open VOA.Sl2Sing85
open VOA.Sl2Symbol
open VOA.Sl2Symbol85

noncomputable section

variable (k : ℂ) (hk : k + 2 ≠ 0)

private abbrev W : VertexOperatorAlgebra (WakModule k) := affineSl2VOA_closed k hk

/-! ## The affine enveloping submodule is the abstract VOA ideal -/

/-- The span of all affine-current descendants of `s`.  This is the direct linear-algebra
translation of the representation-theoretic notation `U(ŝl₂)s`; no choice of PBW ordering is
built into the definition. -/
def currentDescendantSpan (s : WakModule k) : Submodule ℂ (WakModule k) :=
  Submodule.span ℂ {x | ∃ l : List (Fin 3 × ℤ), currentWord k l s = x}

/-- Every current word based at `s` belongs to the VOA ideal generated by `s`. -/
theorem currentWord_mem_idealGen (s : WakModule k) :
    ∀ l : List (Fin 3 × ℤ), currentWord k l s ∈ idealGen (W k hk) s
  | [] => mem_idealGen_self (W k hk) s
  | (a, m) :: l => by
      rw [currentWord_cons, ← smul_currentState_eq_J k hk]
      exact idealGen_isIdeal (W k hk) s (currentState k a) _ m
        (currentWord_mem_idealGen s l)

/-- The all-current descendant span is contained in the abstract generated VOA ideal. -/
theorem currentDescendantSpan_le_idealGen (s : WakModule k) :
    currentDescendantSpan k s ≤ idealGen (W k hk) s := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨l, rfl⟩ := hx
      exact currentWord_mem_idealGen k hk s l
  | zero => exact Submodule.zero_mem _
  | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
  | smul c x _ hx => exact Submodule.smul_mem _ c hx

/-- Applying any current mode preserves the all-current descendant span. -/
theorem currentMode_mem_currentDescendantSpan (s : WakModule k)
    (a : Fin 3) (m : ℤ) {x : WakModule k} (hx : x ∈ currentDescendantSpan k s) :
    J k a m x ∈ currentDescendantSpan k s := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨l, rfl⟩ := hx
      exact Submodule.subset_span ⟨(a, m) :: l, rfl⟩
  | zero =>
      rw [map_zero]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  | smul c x _ hx =>
      rw [map_smul]
      exact Submodule.smul_mem _ c hx

/-- Reconstruction upgrades all-current stability to VOA ideality. -/
theorem currentDescendantSpan_isIdeal (s : WakModule k) :
    (W k hk).IsIdeal (currentDescendantSpan k s) :=
  isIdeal_of_currentMode_stable k hk fun a m _ hx =>
    currentMode_mem_currentDescendantSpan k s a m hx

/-- The base vector belongs to its all-current descendant span. -/
theorem mem_currentDescendantSpan_self (s : WakModule k) :
    s ∈ currentDescendantSpan k s :=
  Submodule.subset_span ⟨[], rfl⟩

/-- **Affine-submodule/VOA-ideal bridge.**  The abstract VOA ideal generated by `s` is exactly
the affine enveloping submodule `U(ŝl₂)s`, represented by all current words.  This needs strong
generation/reconstruction but no singularity or PBW linear independence. -/
theorem idealGen_eq_currentDescendantSpan (s : WakModule k) :
    idealGen (W k hk) s = currentDescendantSpan k s := by
  apply le_antisymm
  · exact idealGen_le (currentDescendantSpan_isIdeal k hk s)
      (mem_currentDescendantSpan_self k s)
  · exact currentDescendantSpan_le_idealGen k hk s

/-- The nonpositive-current span is always contained in the generated VOA ideal. -/
theorem nonpositiveCurrentSpan_le_idealGen (s : WakModule k) :
    nonpositiveCurrentSpan k s ≤ idealGen (W k hk) s := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨l, -, rfl⟩ := hx
      exact currentWord_mem_idealGen k hk s l
  | zero => exact Submodule.zero_mem _
  | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
  | smul c x _ hx => exact Submodule.smul_mem _ c hx

/-- For a positive-current-singular vector, PBW straightening identifies the generated VOA ideal
with the nonpositive-current descendant span. -/
theorem idealGen_eq_nonpositiveCurrentSpan_of_SingP (s : WakModule k)
    (hsing : SingP k s) :
    idealGen (W k hk) s = nonpositiveCurrentSpan k s :=
  le_antisymm (singularCurrentPBWSpanning_of_SingP k hk s hsing)
    (nonpositiveCurrentSpan_le_idealGen k hk s)

/-! ## Exact representation-theoretic interfaces -/

/-- The direct Lean rendering of the published maximal-submodule assertion:
`U(ŝl₂)s` is the maximal proper vacuum submodule. -/
def AffineVacuumMaximalSubmoduleGenerated (s : WakModule k) : Prop :=
  currentDescendantSpan k s = QuotVOA.maxGradedIdeal (W k hk)

/-- The published affine maximal-submodule assertion implies exactly the maximal-VOA-ideal
equality used by the boundary `C₂` presentation. -/
theorem maxGradedIdeal_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated
    (s : WakModule k) (hmax : AffineVacuumMaximalSubmoduleGenerated k hk s) :
    QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s := by
  rw [idealGen_eq_currentDescendantSpan k hk s]
  exact hmax.symm

/-- Conversely, the VOA maximal-ideal equality recovers the affine maximal-submodule statement.
Thus no representation-theoretic strength is lost in translating between the two languages. -/
theorem affineVacuumMaximalSubmoduleGenerated_of_maxGradedIdeal_eq_idealGen
    (s : WakModule k)
    (hmax : QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s) :
    AffineVacuumMaximalSubmoduleGenerated k hk s := by
  rw [AffineVacuumMaximalSubmoduleGenerated, ← idealGen_eq_currentDescendantSpan k hk s]
  exact hmax.symm

/-- Exact equivalence between the affine and VOA formulations of maximal singular generation. -/
theorem affineVacuumMaximalSubmoduleGenerated_iff (s : WakModule k) :
    AffineVacuumMaximalSubmoduleGenerated k hk s ↔
      QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s :=
  ⟨maxGradedIdeal_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated k hk s,
    affineVacuumMaximalSubmoduleGenerated_of_maxGradedIdeal_eq_idealGen k hk s⟩

/-! ## Irreducibility of the singular quotient is enough -/

/-- The universal affine `sl₂` vacuum is nonzero without using the abstract PBW
theorem `VOA.pbw`: it follows from the explicit Wakimoto
triangularity PBW basis. -/
theorem affineSl2_vacuum_ne_zero : (W k hk).vacuum ≠ 0 := by
  change AffineLie.vacuumVector kappaForm kappaForm_isInvariant k ≠ 0
  exact (AffineSl2WakimotoLiLeading.affineSl2PBWBasis k hk).vacuumVector_ne_zero

/-! ### Horizontal local nilpotence on the universal vacuum module

This elementary current-word argument is stronger than the finite-dimensional-weight-space
route: it uses only the three `sl₂` commutators and the proved spanning theorem by negative-current
words.  In particular no finite-dimensional representation-theory theorem is imported. -/

/-- A single vector is killed by some power of a linear endomorphism. -/
private def LocallyKilledBy {M : Type*} [AddCommGroup M] [Module ℂ M]
    (T : Module.End ℂ M) (v : M) : Prop :=
  ∃ r : ℕ, (T ^ r) v = 0

private theorem locallyKilledBy_zero {M : Type*} [AddCommGroup M] [Module ℂ M]
    (T : Module.End ℂ M) : LocallyKilledBy T 0 := by
  exact ⟨0, by simp⟩

private theorem LocallyKilledBy.smul {M : Type*} [AddCommGroup M] [Module ℂ M]
    {T : Module.End ℂ M} {v : M} (hv : LocallyKilledBy T v) (c : ℂ) :
    LocallyKilledBy T (c • v) := by
  obtain ⟨r, hr⟩ := hv
  exact ⟨r, by rw [map_smul, hr, smul_zero]⟩

private theorem LocallyKilledBy.add {M : Type*} [AddCommGroup M] [Module ℂ M]
    {T : Module.End ℂ M} {u v : M}
    (hu : LocallyKilledBy T u) (hv : LocallyKilledBy T v) :
    LocallyKilledBy T (u + v) := by
  obtain ⟨r, hr⟩ := hu
  obtain ⟨q, hq⟩ := hv
  refine ⟨r + q, ?_⟩
  rw [map_add]
  have hru : (T ^ (r + q)) u = 0 := by
    rw [add_comm, pow_add, Module.End.mul_apply, hr, map_zero]
  have hqv : (T ^ (r + q)) v = 0 := by
    rw [pow_add, Module.End.mul_apply, hq, map_zero]
  rw [hru, hqv, add_zero]

/-- If `T v` is locally killed by `T`, then so is `v`. -/
private theorem locallyKilledBy_of_apply {M : Type*} [AddCommGroup M] [Module ℂ M]
    {T : Module.End ℂ M} {v : M} (hv : LocallyKilledBy T (T v)) :
    LocallyKilledBy T v := by
  obtain ⟨r, hr⟩ := hv
  exact ⟨r + 1, by rw [pow_succ, Module.End.mul_apply, hr]⟩

/-- Horizontal `e₀`-local nilpotence is preserved by every negative `e` current. -/
private theorem locallyKilledBy_Eneg (n : ℕ) {v : WakModule k}
    (hv : LocallyKilledBy (J k colE 0) v) :
    LocallyKilledBy (J k colE 0) (J k colE (-((n : ℤ)) - 1) v) := by
  obtain ⟨r, hr⟩ := hv
  induction r generalizing v with
  | zero =>
      have hv0 : v = 0 := by simpa using hr
      rw [hv0, map_zero]
      exact locallyKilledBy_zero _
  | succ r ih =>
      apply locallyKilledBy_of_apply
      rw [Sl2Sing.EEs]
      apply ih
      simpa only [pow_succ, Module.End.mul_apply] using hr

/-- Horizontal `e₀`-local nilpotence is preserved by every negative `h` current. -/
private theorem locallyKilledBy_Hneg (n : ℕ) {v : WakModule k}
    (hv : LocallyKilledBy (J k colE 0) v) :
    LocallyKilledBy (J k colE 0) (J k colH (-((n : ℤ)) - 1) v) := by
  obtain ⟨r, hr⟩ := hv
  induction r generalizing v with
  | zero =>
      have hv0 : v = 0 := by simpa using hr
      rw [hv0, map_zero]
      exact locallyKilledBy_zero _
  | succ r ih =>
      apply locallyKilledBy_of_apply
      rw [Sl2Sing.EHs k 0 (-((n : ℤ)) - 1) (-((n : ℤ)) - 1) (by ring)]
      rw [sub_eq_add_neg]
      apply LocallyKilledBy.add
      · apply ih
        simpa only [pow_succ, Module.End.mul_apply] using hr
      · simpa only [neg_smul] using
          LocallyKilledBy.smul (locallyKilledBy_Eneg k n ⟨r + 1, hr⟩) (-2)

/-- Horizontal `e₀`-local nilpotence is preserved by every negative `f` current. -/
private theorem locallyKilledBy_Fneg (n : ℕ) {v : WakModule k}
    (hv : LocallyKilledBy (J k colE 0) v) :
    LocallyKilledBy (J k colE 0) (J k colF (-((n : ℤ)) - 1) v) := by
  obtain ⟨r, hr⟩ := hv
  induction r generalizing v with
  | zero =>
      have hv0 : v = 0 := by simpa using hr
      rw [hv0, map_zero]
      exact locallyKilledBy_zero _
  | succ r ih =>
      apply locallyKilledBy_of_apply
      rw [Sl2Sing.EFs k 0 (-((n : ℤ)) - 1) (-((n : ℤ)) - 1) (by ring) (by omega)]
      apply LocallyKilledBy.add
      · apply ih
        simpa only [pow_succ, Module.End.mul_apply] using hr
      · exact locallyKilledBy_Hneg k n ⟨r + 1, hr⟩

/-- Every negative-current word is locally killed by horizontal `e₀`. -/
private theorem currentWord_horizontalRaising_locallyKilled :
    ∀ l : List (Fin 3 × ℕ), LocallyKilledBy (J k colE 0) (wordStateA k l)
  | [] => ⟨1, Sl2Sing.E_vac0 k⟩
  | (a, n) :: l => by
      rw [wordStateA_cons]
      fin_cases a
      · exact locallyKilledBy_Eneg k n (currentWord_horizontalRaising_locallyKilled l)
      · exact locallyKilledBy_Fneg k n (currentWord_horizontalRaising_locallyKilled l)
      · exact locallyKilledBy_Hneg k n (currentWord_horizontalRaising_locallyKilled l)

/-- The horizontal raising zero mode is locally nilpotent on the entire universal affine vacuum
module.  This follows from current-word spanning and the preceding elementary `sl₂`-string
induction; neither positive energy nor a finite-dimensional representation theorem is needed. -/
theorem horizontalRaisingLocallyNilpotent_universal :
    AffineLie.LocallyNilpotentEnd (J k colE 0) := by
  intro v
  have hv : v ∈ Submodule.span ℂ (Set.range (wordStateA k)) := by
    rw [wordStateA_span]
    exact Submodule.mem_top
  induction hv using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨l, rfl⟩ := hx
      exact currentWord_horizontalRaising_locallyKilled k l
  | zero => exact locallyKilledBy_zero _
  | add u v _ _ hu hv => exact LocallyKilledBy.add hu hv
  | smul c v _ hv => exact LocallyKilledBy.smul hv c

/-- Stability under every descended affine-current mode in the quotient by `(s)`. -/
def SingularQuotientCurrentStable (s : WakModule k)
    (Q : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) : Prop :=
  ∀ (a : Fin 3) (m : ℤ) (x : WakModule k ⧸ idealGen (W k hk) s), x ∈ Q →
    (quotientBySingular (W k hk) s).smul
      ((idealGen (W k hk) s).mkQ (currentState k a)) m x ∈ Q

/-- A current-stable quotient subspace is a VOA ideal.  This is the reusable form of the
pullback/reconstruction argument used in the simplicity equivalence below. -/
theorem singularQuotientCurrentStable_isIdeal (s : WakModule k)
    (Q : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s))
    (hcur : SingularQuotientCurrentStable k hk s Q) :
    (quotientBySingular (W k hk) s).IsIdeal Q := by
  let I := idealGen (W k hk) s
  have hcur_comap : ∀ (a : Fin 3) (m : ℤ) (x : WakModule k),
      x ∈ Q.comap I.mkQ → J k a m x ∈ Q.comap I.mkQ := by
    intro a m x hx
    change I.mkQ (J k a m x) ∈ Q
    rw [← smul_currentState_eq_J k hk,
      ← SingVec.quotientBySingular_mkQ_smul (W k hk) s]
    exact hcur a m (I.mkQ x) hx
  have hcomapIdeal : (W k hk).IsIdeal (Q.comap I.mkQ) :=
    isIdeal_of_currentMode_stable k hk hcur_comap
  intro ubar vbar m hvbar
  obtain ⟨u, rfl⟩ := I.mkQ_surjective ubar
  obtain ⟨v, rfl⟩ := I.mkQ_surjective vbar
  rw [SingVec.quotientBySingular_mkQ_smul]
  exact hcomapIdeal u v m hvbar

/-- Current-stable quotient subspaces are automatically homogeneous for the positive-energy
grading.  Thus gradedness is not an additional representation-theoretic hypothesis. -/
theorem singularQuotientCurrentStable_isGraded (s : WakModule k)
    (Q : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s))
    (hcur : SingularQuotientCurrentStable k hk s Q) :
    QuotVOA.IsGradedIdeal (quotientBySingular (W k hk) s) Q :=
  QuotVOA.isGradedIdeal_of_isIdeal
    (singularQuotientCurrentStable_isIdeal k hk s Q hcur)

/-- Irreducibility of the quotient by `(s)` under the descended affine currents.  The first
clause excludes the zero quotient.  The second asks only about subspaces stable under modes of
the three current states, rather than under modes of every VOA state. -/
def SingularQuotientCurrentIrreducible (s : WakModule k) : Prop :=
  let I := idealGen (W k hk) s
  (⊤ : Submodule ℂ (WakModule k ⧸ I)) ≠ ⊥ ∧
    ∀ Q : Submodule ℂ (WakModule k ⧸ I),
      SingularQuotientCurrentStable k hk s Q →
      Q = ⊥ ∨ Q = ⊤

/-- Current irreducibility implies VOA simplicity because every VOA ideal is, in particular,
stable under the three current fields. -/
theorem quotientBySingular_isSimple_of_currentIrreducible (s : WakModule k)
    (hirr : SingularQuotientCurrentIrreducible k hk s) :
    (quotientBySingular (W k hk) s).IsSimple := by
  refine ⟨hirr.1, ?_⟩
  intro Q hQ
  exact hirr.2 Q (fun a m x hx => hQ _ x m hx)

/-- Conversely, VOA simplicity of the singular quotient implies irreducibility under the three
affine currents.  A current-stable quotient subspace pulls back to a current-stable subspace of
the universal vacuum module, hence to a VOA ideal by affine strong generation; pushing the ideal
condition back down proves that the original quotient subspace is a VOA ideal. -/
theorem currentIrreducible_of_quotientBySingular_isSimple (s : WakModule k)
    (hsimple : (quotientBySingular (W k hk) s).IsSimple) :
    SingularQuotientCurrentIrreducible k hk s := by
  refine ⟨hsimple.1, fun Q hcur => hsimple.2 Q ?_⟩
  exact singularQuotientCurrentStable_isIdeal k hk s Q hcur

/-- Current irreducibility is exactly VOA simplicity for a quotient of the universal affine
`sl₂` vacuum by one generated ideal.  Thus the external representation theorem can be imported
in its usual irreducible-quotient form without losing or adding mathematical content. -/
theorem singularQuotientCurrentIrreducible_iff_isSimple (s : WakModule k) :
    SingularQuotientCurrentIrreducible k hk s ↔
      (quotientBySingular (W k hk) s).IsSimple :=
  ⟨quotientBySingular_isSimple_of_currentIrreducible k hk s,
    currentIrreducible_of_quotientBySingular_isSimple k hk s⟩

/-! ## The primitive-vector irreducibility mechanism -/

/-- A vector in the singular quotient killed by every strictly positive affine-current mode.
This is the loop-positive part of the affine highest-weight condition. -/
def SingularQuotientPositiveCurrentSingular (s : WakModule k)
    (v : WakModule k ⧸ idealGen (W k hk) s) : Prop :=
  ∀ (a : Fin 3) (m : ℤ), 1 ≤ m →
    (quotientBySingular (W k hk) s).smul
      ((idealGen (W k hk) s).mkQ (currentState k a)) m v = 0

/-- Applying a descended current mode to a quotient representative is the class of the original
affine current action. -/
theorem singularQuotient_mkQ_J (s : WakModule k) (a : Fin 3) (m : ℤ)
    (v : WakModule k) :
    (quotientBySingular (W k hk) s).smul
      ((idealGen (W k hk) s).mkQ (currentState k a)) m
      ((idealGen (W k hk) s).mkQ v) =
        (idealGen (W k hk) s).mkQ (J k a m v) := by
  rw [SingVec.quotientBySingular_mkQ_smul, smul_currentState_eq_J]

/-- The descended affine-current mode as a linear endomorphism of the singular quotient. -/
noncomputable def singularQuotientCurrentMode (s : WakModule k) (a : Fin 3) (m : ℤ) :
    Module.End ℂ (WakModule k ⧸ idealGen (W k hk) s) :=
  mode ((quotientBySingular (W k hk) s).Y
    ((idealGen (W k hk) s).mkQ (currentState k a))) m

@[simp] theorem singularQuotientCurrentMode_apply (s : WakModule k) (a : Fin 3) (m : ℤ)
    (v : WakModule k ⧸ idealGen (W k hk) s) :
    singularQuotientCurrentMode k hk s a m v =
      (quotientBySingular (W k hk) s).smul
        ((idealGen (W k hk) s).mkQ (currentState k a)) m v := rfl

/-- The horizontal finiteness statement used in the standard primitive-vector existence proof:
the raising zero mode acts locally nilpotently on the singular quotient. -/
def SingularQuotientHorizontalRaisingLocallyNilpotent (s : WakModule k) : Prop :=
  AffineLie.LocallyNilpotentEnd (singularQuotientCurrentMode k hk s colE 0)

/-- Powers of a descended current mode act on a quotient representative by descending the
corresponding power of the universal current mode. -/
theorem singularQuotientCurrentMode_pow_mkQ (s : WakModule k) (a : Fin 3) (m : ℤ)
    (v : WakModule k) : ∀ r : ℕ,
    (singularQuotientCurrentMode k hk s a m ^ r)
        ((idealGen (W k hk) s).mkQ v) =
      (idealGen (W k hk) s).mkQ ((J k a m ^ r) v)
  | 0 => by simp
  | r + 1 => by
      rw [pow_succ', Module.End.mul_apply, singularQuotientCurrentMode_apply,
        singularQuotientCurrentMode_pow_mkQ s a m v r, singularQuotient_mkQ_J,
        pow_succ', Module.End.mul_apply]

/-- Horizontal `e₀` is locally nilpotent on every singular quotient.  This is not an
external finiteness hypothesis: local nilpotence was proved above on the universal current-word
span and passes immediately to a quotient. -/
theorem horizontalRaisingLocallyNilpotent_singularQuotient (s : WakModule k) :
    SingularQuotientHorizontalRaisingLocallyNilpotent k hk s := by
  intro vbar
  obtain ⟨v, rfl⟩ := (idealGen (W k hk) s).mkQ_surjective vbar
  obtain ⟨r, hr⟩ := horizontalRaisingLocallyNilpotent_universal k v
  refine ⟨r, ?_⟩
  rw [singularQuotientCurrentMode_pow_mkQ, hr, map_zero]

/-- The horizontal raising zero mode preserves the loop-positive singular subspace.  This is the
quotient version of `Strong.SingP.zeroMode`, proved from the three `sl₂` current commutators. -/
theorem SingularQuotientPositiveCurrentSingular.horizontalRaising (s : WakModule k)
    {v : WakModule k ⧸ idealGen (W k hk) s}
    (hv : SingularQuotientPositiveCurrentSingular k hk s v) :
    SingularQuotientPositiveCurrentSingular k hk s
      ((quotientBySingular (W k hk) s).smul
        ((idealGen (W k hk) s).mkQ (currentState k colE)) 0 v) := by
  let I := idealGen (W k hk) s
  obtain ⟨x, rfl⟩ := I.mkQ_surjective v
  intro a m hm
  rw [singularQuotient_mkQ_J, singularQuotient_mkQ_J]
  have hkill (b : Fin 3) : I.mkQ (J k b m x) = 0 := by
    rw [← singularQuotient_mkQ_J]
    exact hv b m hm
  have hraise {y : WakModule k} (hy : I.mkQ y = 0) : I.mkQ (J k colE 0 y) = 0 := by
    rw [← singularQuotient_mkQ_J, hy, PreVertexAlgebra.smul_zero_right]
  fin_cases a
  · change I.mkQ (J k colE m (J k colE 0 x)) = 0
    rw [Sl2Sing.EEs k m 0, hraise (hkill colE)]
  · change I.mkQ (J k colF m (J k colE 0 x)) = 0
    rw [Sl2Sing.FEs k m 0 m (by ring) (by omega) x, map_sub,
      hraise (hkill colF), hkill colH, sub_zero]
  · change I.mkQ (J k colH m (J k colE 0 x)) = 0
    rw [Sl2Sing.HEs k m 0 m (by ring) x, map_add, map_smul,
      hraise (hkill colH), hkill colE, smul_zero, add_zero]

/-- Iterating horizontal raising preserves every current-stable quotient submodule. -/
theorem singularQuotientCurrentMode_pow_mem (s : WakModule k)
    (Q : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s))
    (hcur : SingularQuotientCurrentStable k hk s Q)
    {v : WakModule k ⧸ idealGen (W k hk) s} (hv : v ∈ Q) :
    ∀ r : ℕ, (singularQuotientCurrentMode k hk s colE 0 ^ r) v ∈ Q
  | 0 => by simpa
  | r + 1 => by
      rw [pow_succ', Module.End.mul_apply, singularQuotientCurrentMode_apply]
      exact hcur colE 0 _ (singularQuotientCurrentMode_pow_mem s Q hcur hv r)

/-- Iterating horizontal raising preserves loop-positive singularity. -/
theorem SingularQuotientPositiveCurrentSingular.horizontalRaising_pow (s : WakModule k)
    {v : WakModule k ⧸ idealGen (W k hk) s}
    (hv : SingularQuotientPositiveCurrentSingular k hk s v) :
    ∀ r : ℕ, SingularQuotientPositiveCurrentSingular k hk s
      ((singularQuotientCurrentMode k hk s colE 0 ^ r) v)
  | 0 => by simpa
  | r + 1 => by
      rw [pow_succ', Module.End.mul_apply, singularQuotientCurrentMode_apply]
      exact SingularQuotientPositiveCurrentSingular.horizontalRaising (k := k) (hk := hk) s
        (SingularQuotientPositiveCurrentSingular.horizontalRaising_pow s hv r)

/-- An affine primitive vector in the singular quotient: it is nonzero, killed by all strictly
positive loop modes, and killed by the horizontal raising operator `e₀`.  This is the standard
positive affine Borel condition for `sl₂`. -/
def SingularQuotientAffinePrimitive (s : WakModule k)
    (v : WakModule k ⧸ idealGen (W k hk) s) : Prop :=
  v ≠ 0 ∧ SingularQuotientPositiveCurrentSingular k hk s v ∧
    (quotientBySingular (W k hk) s).smul
      ((idealGen (W k hk) s).mkQ (currentState k colE)) 0 v = 0

/-- The literal standard highest-weight existence input: every nonzero proper graded affine
current submodule of the singular quotient contains an affine primitive vector.  Gradedness is
shown separately because it is automatic for current-stable subspaces, but retaining it here
makes the interface match the textbook least-energy argument exactly. -/
def EveryProperGradedCurrentSubmoduleContainsPrimitive (s : WakModule k) : Prop :=
  ∀ Q : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s),
    SingularQuotientCurrentStable k hk s Q →
    QuotVOA.IsGradedIdeal (quotientBySingular (W k hk) s) Q →
    Q ≠ ⊥ → Q ≠ ⊤ →
    ∃ v, v ∈ Q ∧ SingularQuotientAffinePrimitive k hk s v

/-- Absence of new primitive vectors in the singular quotient: every affine primitive belongs
to the vacuum line.  This is the precise uniqueness statement needed by the standard
highest-weight irreducibility argument. -/
def OnlyVacuumAffinePrimitives (s : WakModule k) : Prop :=
  ∀ v : WakModule k ⧸ idealGen (W k hk) s,
    SingularQuotientAffinePrimitive k hk s v →
      v ∈ ℂ ∙ (quotientBySingular (W k hk) s).vacuum

/-- Positive energy already supplies the loop-positive part of a primitive vector in every
nonzero current submodule.  The bottom-weight construction is entirely internal: current
stability gives a VOA ideal, `idealBottomWeight` chooses its least occupied integral grade, and
`mode_lowering_vanish` kills every current mode `m ≥ 1` on that bottom. -/
theorem exists_positiveCurrentSingular_of_currentStable (s : WakModule k)
    (Q : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s))
    (hcur : SingularQuotientCurrentStable k hk s Q) (hne : Q ≠ ⊥) :
    ∃ v, v ∈ Q ∧ v ≠ 0 ∧ SingularQuotientPositiveCurrentSingular k hk s v := by
  let QW := quotientBySingular (W k hk) s
  have hI : QW.IsIdeal Q := singularQuotientCurrentStable_isIdeal k hk s Q hcur
  let N := QW.idealOrdModule Q hI
  let n := QW.idealBottomWeight hI hne
  have hn : N.weight (n : ℂ) ≠ ⊥ := QW.idealBottomWeight_ne_bot hI hne
  obtain ⟨x, hx, hx0⟩ := (Submodule.ne_bot_iff _).mp hn
  let v : WakModule k ⧸ idealGen (W k hk) s := (x : Q)
  have hvQ : v ∈ Q := x.property
  have hv0 : v ≠ 0 := by
    intro hv
    apply hx0
    apply Subtype.ext
    exact hv
  refine ⟨v, hvQ, hv0, ?_⟩
  intro a m hm
  have hstate : (idealGen (W k hk) s).mkQ (currentState k a) ∈ QW.grading 1 := by
    change (idealGen (W k hk) s).mkQ (currentState k a) ∈
      (QuotVOA.quotientVOA (W k hk) (idealGen (W k hk) s)
        (idealGen_isIdeal (W k hk) s)
        (QuotVOA.isGradedIdeal_of_isIdeal (idealGen_isIdeal (W k hk) s))).grading 1
    exact QuotVOA.quotientVOA_mkQ_grading
      (idealGen_isIdeal (W k hk) s)
      (QuotVOA.isGradedIdeal_of_isIdeal (idealGen_isIdeal (W k hk) s))
      (currentState_mem_grading k hk a)
  have hz := mode_lowering_vanish N (QW.idealOrdModule_isLowestWeight hI hne)
    hstate hx hm
  exact congrArg Subtype.val hz

/-- Horizontal raising local nilpotence upgrades a nonzero loop-positive singular vector to a
full affine primitive vector by taking the last nonzero vector in its `e₀` string. -/
theorem exists_affinePrimitive_of_horizontalRaisingLocallyNilpotent (s : WakModule k)
    (Q : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s))
    (hcur : SingularQuotientCurrentStable k hk s Q)
    (hln : SingularQuotientHorizontalRaisingLocallyNilpotent k hk s)
    {v : WakModule k ⧸ idealGen (W k hk) s} (hvQ : v ∈ Q) (hv0 : v ≠ 0)
    (hvpos : SingularQuotientPositiveCurrentSingular k hk s v) :
    ∃ w, w ∈ Q ∧ SingularQuotientAffinePrimitive k hk s w := by
  classical
  let T := singularQuotientCurrentMode k hk s colE 0
  let N := Nat.find (hln v)
  have hN : (T ^ N) v = 0 := Nat.find_spec (hln v)
  have hNpos : 0 < N := by
    apply Nat.pos_of_ne_zero
    intro hN0
    apply hv0
    rw [hN0, pow_zero, Module.End.one_apply] at hN
    exact hN
  let r := N - 1
  have hrlt : r < N := by
    dsimp [r]
    omega
  have hwr0 : (T ^ r) v ≠ 0 := by
    intro hzero
    have hle : N ≤ r := Nat.find_min' (hln v) hzero
    omega
  have hrSucc : r + 1 = N := by
    dsimp [r]
    omega
  have hraise : T ((T ^ r) v) = 0 := by
    rw [← pow_succ'_apply, hrSucc, hN]
  refine ⟨(T ^ r) v,
    singularQuotientCurrentMode_pow_mem k hk s Q hcur hvQ r,
    hwr0,
    SingularQuotientPositiveCurrentSingular.horizontalRaising_pow k hk s hvpos r,
    ?_⟩
  change T ((T ^ r) v) = 0
  exact hraise

/-- Consequently horizontal `e₀` local nilpotence proves the standard primitive-vector existence
theorem for every nonzero proper graded current submodule.  Positive energy supplies the bottom
vector; local nilpotence supplies the horizontal-highest vector inside its finite `e₀` string. -/
theorem everyProperGradedCurrentSubmoduleContainsPrimitive_of_horizontalRaisingLocallyNilpotent
    (s : WakModule k) (hln : SingularQuotientHorizontalRaisingLocallyNilpotent k hk s) :
    EveryProperGradedCurrentSubmoduleContainsPrimitive k hk s := by
  intro Q hcur _ hne _
  obtain ⟨v, hvQ, hv0, hvpos⟩ :=
    exists_positiveCurrentSingular_of_currentStable k hk s Q hcur hne
  exact exists_affinePrimitive_of_horizontalRaisingLocallyNilpotent
    k hk s Q hcur hln hvQ hv0 hvpos

/-- Every nonzero proper current submodule contains an affine primitive vector.  Both ingredients
of the textbook argument are internal: positive energy supplies a loop-positive bottom vector,
and current-word `sl₂` strings supply horizontal `e₀` local nilpotence. -/
theorem everyProperGradedCurrentSubmoduleContainsPrimitive (s : WakModule k) :
    EveryProperGradedCurrentSubmoduleContainsPrimitive k hk s :=
  everyProperGradedCurrentSubmoduleContainsPrimitive_of_horizontalRaisingLocallyNilpotent
    k hk s (horizontalRaisingLocallyNilpotent_singularQuotient k hk s)

/-- A nonzero positive-weight `SingP` vector generates a proper ideal, so its singular quotient
is nonzero.  This discharges the nontriviality clause for every boundary-family `Candidate`; no
representation-theoretic irreducibility input is used. -/
theorem singularQuotient_top_ne_bot_of_SingP (s : WakModule k)
    (hsing : SingP k s) (hs0 : s ≠ 0) {w : ℤ} (hw : 0 < w)
    (hmem : s ∈ gradingZA k w) :
    (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) ≠ ⊥ := by
  have hvac : (W k hk).vacuum ≠ 0 := affineSl2_vacuum_ne_zero k hk
  have hstrong := isStronglySingular_of_SingP k hk hsing hs0 hw hmem
  have hproper : (W k hk).vacuum ∉ idealGen (W k hk) s :=
    idealGen_proper_of_stronglySingular
      (canonicalInvariantForm_isFullyInvariant hvac (affineSl2_qp k hk))
      (canonicalInvariantForm_normalized hvac (affineSl2_qp k hk)) hstrong
  have hvacQ : (quotientBySingular (W k hk) s).vacuum ≠ 0 :=
    quotientBySingular_vacuum_ne_zero hproper
  intro htop
  apply hvacQ
  have hmemtop : (quotientBySingular (W k hk) s).vacuum ∈
      (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) := Submodule.mem_top
  rw [htop, Submodule.mem_bot] at hmemtop
  exact hmemtop

/-- The standard primitive-vector criterion.  If every nonzero proper graded current submodule
contains a primitive vector but the quotient has no primitive vectors outside its vacuum line,
then the singular quotient is current-irreducible. -/
theorem currentIrreducible_of_primitiveCriterion (s : WakModule k)
    (hnonzero : (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) ≠ ⊥)
    (hexists : EveryProperGradedCurrentSubmoduleContainsPrimitive k hk s)
    (honly : OnlyVacuumAffinePrimitives k hk s) :
    SingularQuotientCurrentIrreducible k hk s := by
  refine ⟨hnonzero, fun Q hcur => ?_⟩
  rcases eq_or_ne Q ⊥ with hbot | hbot
  · exact Or.inl hbot
  rcases eq_or_ne Q ⊤ with htop | htop
  · exact Or.inr htop
  obtain ⟨v, hvQ, hvprim⟩ := hexists Q hcur
    (singularQuotientCurrentStable_isGraded k hk s Q hcur) hbot htop
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (honly v hvprim)
  have hc0 : c ≠ 0 := by
    intro hc0
    apply hvprim.1
    rw [← hc, hc0, zero_smul]
  have hvacQ : (quotientBySingular (W k hk) s).vacuum ∈ Q := by
    have hcv := Q.smul_mem c⁻¹ hvQ
    rw [← hc, smul_smul, inv_mul_cancel₀ hc0, one_smul] at hcv
    exact hcv
  exact absurd
    (QuotVOA.eq_top_of_vacuum_mem
      (singularQuotientCurrentStable_isIdeal k hk s Q hcur) hvacQ)
    htop

/-- A sharper form of the criterion: positive energy and the current commutators construct the
primitive vector once horizontal `e₀` local nilpotence is supplied.  Thus only horizontal local
nilpotence and vacuum-line uniqueness remain as hypotheses. -/
theorem currentIrreducible_of_horizontalRaisingLocallyNilpotent
    (s : WakModule k)
    (hnonzero : (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) ≠ ⊥)
    (hln : SingularQuotientHorizontalRaisingLocallyNilpotent k hk s)
    (honly : OnlyVacuumAffinePrimitives k hk s) :
    SingularQuotientCurrentIrreducible k hk s :=
  currentIrreducible_of_primitiveCriterion k hk s hnonzero
    (everyProperGradedCurrentSubmoduleContainsPrimitive_of_horizontalRaisingLocallyNilpotent
      k hk s hln)
    honly

/-- For a nonzero singular quotient, vacuum-line uniqueness of affine primitive vectors is the
only remaining representation-theoretic input for current irreducibility. -/
theorem currentIrreducible_of_onlyVacuumAffinePrimitives
    (s : WakModule k)
    (hnonzero : (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) ≠ ⊥)
    (honly : OnlyVacuumAffinePrimitives k hk s) :
    SingularQuotientCurrentIrreducible k hk s :=
  currentIrreducible_of_primitiveCriterion k hk s hnonzero
    (everyProperGradedCurrentSubmoduleContainsPrimitive k hk s) honly

/-- Simplicity of the singular quotient forces the singular ideal to be the maximal ideal. -/
theorem maxGradedIdeal_eq_idealGen_of_quotientBySingular_isSimple
    (s : WakModule k) (hsimple : (quotientBySingular (W k hk) s).IsSimple) :
    QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s := by
  have hker :=
    IsVOAHom.ker_eq_maxGradedIdeal
      (isVOAHom_mkQ (W k hk) (idealGen (W k hk) s) (idealGen_isIdeal (W k hk) s))
      (idealGen (W k hk) s).mkQ_surjective hsimple
  rw [Submodule.ker_mkQ] at hker
  exact hker.symm

/-- If the singular ideal is the maximal ideal and the universal vacuum is nonzero, then the
singular quotient is simple.  Together with the preceding theorem this makes simplicity of
`V^k(sl₂)/(s)` an exact reformulation of maximal singular generation. -/
theorem quotientVOA'_isSimple_of_eq_maxGradedIdeal
    {I : Submodule ℂ (WakModule k)} (hI : (W k hk).IsIdeal I)
    (hvac : (W k hk).vacuum ≠ 0)
    (hmax : I = QuotVOA.maxGradedIdeal (W k hk)) :
    (QuotVOA.quotientVOA' (W k hk) I hI).IsSimple := by
  let hgr := QuotVOA.isGradedIdeal_of_isIdeal hI
  change (QuotVOA.quotientVOA (W k hk) I hI hgr).IsSimple
  have hvacI : (W k hk).vacuum ∉ I := by
    rw [hmax]
    exact QuotVOA.vacuum_not_mem_maxGradedIdeal (W k hk) hvac
  refine ⟨?_, fun Q hQ => ?_⟩
  · intro htop
    have hmem : I.mkQ (W k hk).vacuum ∈
        (⊤ : Submodule ℂ (WakModule k ⧸ I)) := Submodule.mem_top
    rw [htop, Submodule.mem_bot, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] at hmem
    exact hvacI hmem
  · have hcomapIdeal : (W k hk).IsIdeal (Q.comap I.mkQ) :=
      QuotVOA.isIdeal_comap hI hgr hQ
    have hmapcomap : (Q.comap I.mkQ).map I.mkQ = Q :=
      Submodule.map_comap_eq_self (by rw [Submodule.range_mkQ]; exact le_top)
    by_cases hv : (W k hk).vacuum ∈ Q.comap I.mkQ
    · right
      have htop : Q.comap I.mkQ = ⊤ := QuotVOA.eq_top_of_vacuum_mem hcomapIdeal hv
      rw [← hmapcomap, htop, Submodule.map_top, Submodule.range_mkQ]
    · left
      have hleMax : Q.comap I.mkQ ≤ QuotVOA.maxGradedIdeal (W k hk) :=
        QuotVOA.le_maxGradedIdeal' hcomapIdeal hv
      have hle : Q.comap I.mkQ ≤ I :=
        le_trans hleMax (le_of_eq hmax.symm)
      have hbot : (Q.comap I.mkQ).map I.mkQ = ⊥ := by
        rw [eq_bot_iff, Submodule.map_le_iff_le_comap, Submodule.comap_bot,
          Submodule.ker_mkQ]
        exact hle
      rw [← hmapcomap, hbot]

theorem quotientBySingular_isSimple_of_maxGradedIdeal_eq_idealGen
    (s : WakModule k) (hvac : (W k hk).vacuum ≠ 0)
    (hmax : QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s) :
    (quotientBySingular (W k hk) s).IsSimple :=
  quotientVOA'_isSimple_of_eq_maxGradedIdeal k hk (idealGen_isIdeal (W k hk) s) hvac hmax.symm

/-- Maximal singular generation is equivalent to simplicity of the singular quotient, once the
source vacuum is known to be nonzero. -/
theorem maxGradedIdeal_eq_idealGen_iff_quotientBySingular_isSimple
    (s : WakModule k) (hvac : (W k hk).vacuum ≠ 0) :
    QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s ↔
      (quotientBySingular (W k hk) s).IsSimple :=
  ⟨quotientBySingular_isSimple_of_maxGradedIdeal_eq_idealGen k hk s hvac,
    maxGradedIdeal_eq_idealGen_of_quotientBySingular_isSimple k hk s⟩

/-- **Smallest irreducibility gate.**  Affine-current irreducibility of the quotient by the
displayed singular vector proves maximal-ideal generation, with all VOA translation discharged. -/
theorem maxGradedIdeal_eq_idealGen_of_currentIrreducible
    (s : WakModule k) (hirr : SingularQuotientCurrentIrreducible k hk s) :
    QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s :=
  maxGradedIdeal_eq_idealGen_of_quotientBySingular_isSimple k hk s
    (quotientBySingular_isSimple_of_currentIrreducible k hk s hirr)

/-- **Source-faithful Adamović--Milas interface.**  Generation of the maximal affine vacuum
submodule by `s` is equivalent to irreducibility of the quotient by its current descendants.
The forward implication uses the axiom-clean Wakimoto PBW basis only to know that the universal
vacuum survives; all remaining steps are internal ideal/current reconstruction. -/
theorem affineVacuumMaximalSubmoduleGenerated_iff_currentIrreducible (s : WakModule k) :
    AffineVacuumMaximalSubmoduleGenerated k hk s ↔
      SingularQuotientCurrentIrreducible k hk s := by
  constructor
  · intro hmax
    apply currentIrreducible_of_quotientBySingular_isSimple k hk s
    exact quotientBySingular_isSimple_of_maxGradedIdeal_eq_idealGen k hk s
      (affineSl2_vacuum_ne_zero k hk)
      (maxGradedIdeal_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated k hk s hmax)
  · intro hirr
    exact affineVacuumMaximalSubmoduleGenerated_of_maxGradedIdeal_eq_idealGen k hk s
      (maxGradedIdeal_eq_idealGen_of_currentIrreducible k hk s hirr)

/-- Primitive existence and vacuum-line uniqueness imply maximal generation of the affine vacuum
submodule by `s`. -/
theorem affineVacuumMaximalSubmoduleGenerated_of_primitiveCriterion (s : WakModule k)
    (hnonzero : (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) ≠ ⊥)
    (hexists : EveryProperGradedCurrentSubmoduleContainsPrimitive k hk s)
    (honly : OnlyVacuumAffinePrimitives k hk s) :
    AffineVacuumMaximalSubmoduleGenerated k hk s :=
  (affineVacuumMaximalSubmoduleGenerated_iff_currentIrreducible k hk s).2
    (currentIrreducible_of_primitiveCriterion k hk s hnonzero hexists honly)

/-- Horizontal raising local nilpotence plus vacuum-line uniqueness implies maximal generation. -/
theorem affineVacuumMaximalSubmoduleGenerated_of_horizontalRaisingLocallyNilpotent
    (s : WakModule k)
    (hnonzero : (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) ≠ ⊥)
    (hln : SingularQuotientHorizontalRaisingLocallyNilpotent k hk s)
    (honly : OnlyVacuumAffinePrimitives k hk s) :
    AffineVacuumMaximalSubmoduleGenerated k hk s :=
  (affineVacuumMaximalSubmoduleGenerated_iff_currentIrreducible k hk s).2
    (currentIrreducible_of_horizontalRaisingLocallyNilpotent
      k hk s hnonzero hln honly)

/-- For a nonzero singular quotient, vacuum-line uniqueness of affine primitive vectors already
implies maximal generation by the displayed singular vector. -/
theorem affineVacuumMaximalSubmoduleGenerated_of_onlyVacuumAffinePrimitives
    (s : WakModule k)
    (hnonzero : (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W k hk) s)) ≠ ⊥)
    (honly : OnlyVacuumAffinePrimitives k hk s) :
    AffineVacuumMaximalSubmoduleGenerated k hk s :=
  (affineVacuumMaximalSubmoduleGenerated_iff_currentIrreducible k hk s).2
    (currentIrreducible_of_onlyVacuumAffinePrimitives k hk s hnonzero honly)

/-! ## Concrete `p=3` and `p=5` adapters -/

/-- At `p=3`, the Adamović--Milas affine-submodule statement supplies the exact `hmax` expected by
the boundary presentation theorem. -/
theorem maxGradedIdeal43_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated
    (hAM : AffineVacuumMaximalSubmoduleGenerated (-4 / 3 : ℂ) admLevel_noncritical
      Sl2Sing.sl2Singular) :
    QuotVOA.maxGradedIdeal Wadm = idealGen Wadm Sl2Sing.sl2Singular :=
  maxGradedIdeal_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated
    (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular hAM

/-- At `p=5`, the same bridge supplies the exact `hmax` expected by the boundary presentation
theorem. -/
theorem maxGradedIdeal85_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated
    (hAM : AffineVacuumMaximalSubmoduleGenerated (-8 / 5 : ℂ) level85_noncritical
      sl2Singular85) :
    QuotVOA.maxGradedIdeal W85 = idealGen W85 sl2Singular85 :=
  maxGradedIdeal_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated
    (-8 / 5 : ℂ) level85_noncritical sl2Singular85 hAM

/-- At `p=3`, the literature's irreducible-singular-quotient formulation supplies the existing
maximal-current-submodule interface. -/
theorem affineVacuumMaximalSubmoduleGenerated43_of_currentIrreducible
    (hirr : SingularQuotientCurrentIrreducible
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular) :
    AffineVacuumMaximalSubmoduleGenerated
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular :=
  (affineVacuumMaximalSubmoduleGenerated_iff_currentIrreducible
    (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular).2 hirr

/-- At `p=5`, the same irreducible-quotient formulation supplies maximal generation. -/
theorem affineVacuumMaximalSubmoduleGenerated85_of_currentIrreducible
    (hirr : SingularQuotientCurrentIrreducible
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85) :
    AffineVacuumMaximalSubmoduleGenerated
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85 :=
  (affineVacuumMaximalSubmoduleGenerated_iff_currentIrreducible
    (-8 / 5 : ℂ) level85_noncritical sl2Singular85).2 hirr

/-- The `p=3` generated ideal is already the nonpositive-current span. -/
theorem idealGen43_eq_nonpositiveCurrentSpan :
    idealGen Wadm Sl2Sing.sl2Singular =
      nonpositiveCurrentSpan (-4 / 3 : ℂ) Sl2Sing.sl2Singular :=
  idealGen_eq_nonpositiveCurrentSpan_of_SingP (-4 / 3 : ℂ) admLevel_noncritical
    Sl2Sing.sl2Singular (fun a m hm => Sl2Sing.sl2Singular_pos a (m := m) hm)

/-- The `p=5` generated ideal is already the nonpositive-current span. -/
theorem idealGen85_eq_nonpositiveCurrentSpan :
    idealGen W85 sl2Singular85 =
      nonpositiveCurrentSpan (-8 / 5 : ℂ) sl2Singular85 :=
  idealGen_eq_nonpositiveCurrentSpan_of_SingP (-8 / 5 : ℂ) level85_noncritical
    sl2Singular85 (fun a m hm => sl2Singular85_pos a (m := m) hm)

/-- At `p=3`, exactness is reduced to the literal external affine maximal-submodule theorem,
rather than an opaque VOA-ideal equality.  Universal-symbol injectivity is already proved. -/
theorem exact_boundary_simple43_of_affineMaximalSubmodule
    (hAM : AffineVacuumMaximalSubmoduleGenerated (-4 / 3 : ℂ) admLevel_noncritical
      Sl2Sing.sl2Singular) :
    Presentation.IsExactPresentation (boundaryIdeal 1)
      (quotientSymbol (-4 / 3 : ℂ) admLevel_noncritical
        (QuotVOA.maxGradedIdeal Wadm)
        (QuotVOA.maxGradedIdeal_isIdeal Wadm)
        (QuotVOA.maxGradedIdeal_isGradedIdeal Wadm)) :=
  exact_boundary_simple43_of_maxIdeal
    (maxGradedIdeal43_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated hAM)

/-- At `p=5`, exactness is reduced to the same literal representation-theoretic input. -/
theorem exact_boundary_simple85_of_affineMaximalSubmodule
    (hAM : AffineVacuumMaximalSubmoduleGenerated (-8 / 5 : ℂ) level85_noncritical
      sl2Singular85) :
    Presentation.IsExactPresentation (boundaryIdeal 2)
      (quotientSymbol (-8 / 5 : ℂ) level85_noncritical
        (QuotVOA.maxGradedIdeal W85)
        (QuotVOA.maxGradedIdeal_isIdeal W85)
        (QuotVOA.maxGradedIdeal_isGradedIdeal W85)) :=
  exact_boundary_simple85_of_maxIdeal
    (maxGradedIdeal85_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated hAM)

/-- The exact `p=3` nonreduced `C₂` presentation from the literal irreducibility statement for
the singular quotient. -/
theorem exact_boundary_simple43_of_currentIrreducible
    (hirr : SingularQuotientCurrentIrreducible
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular) :
    Presentation.IsExactPresentation (boundaryIdeal 1)
      (quotientSymbol (-4 / 3 : ℂ) admLevel_noncritical
        (QuotVOA.maxGradedIdeal Wadm)
        (QuotVOA.maxGradedIdeal_isIdeal Wadm)
        (QuotVOA.maxGradedIdeal_isGradedIdeal Wadm)) :=
  exact_boundary_simple43_of_affineMaximalSubmodule
    (affineVacuumMaximalSubmoduleGenerated43_of_currentIrreducible hirr)

/-- The exact `p=5` nonreduced `C₂` presentation from the literal irreducibility statement for
the singular quotient. -/
theorem exact_boundary_simple85_of_currentIrreducible
    (hirr : SingularQuotientCurrentIrreducible
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85) :
    Presentation.IsExactPresentation (boundaryIdeal 2)
      (quotientSymbol (-8 / 5 : ℂ) level85_noncritical
        (QuotVOA.maxGradedIdeal W85)
        (QuotVOA.maxGradedIdeal_isIdeal W85)
        (QuotVOA.maxGradedIdeal_isGradedIdeal W85)) :=
  exact_boundary_simple85_of_affineMaximalSubmodule
    (affineVacuumMaximalSubmoduleGenerated85_of_currentIrreducible hirr)

