import VOA.Examples.InverseDSScreeningLowering

/-!
# Finite generation of the Lee--Yang primary Ward identity

The Virasoro factor in the inverse-DS screening is a heterotypic primary field: its coefficients
map the source Virasoro carrier to a shifted carrier.  `InverseDSScreeningLowering` records the
full coefficientwise Ward identity as an interface, but checking that interface mode by mode
would leave an infinite family of analytic obligations.

This file proves that only five Virasoro modes have to be checked.  If the source and target are
representations with the same central charge, the induced action on a heterotypic linear map has
no central term.  The Jacobi identity for this induced action then propagates Ward identities at
two distinct modes to their sum.  Since the Witt algebra is generated by modes `-2,-1,0,1,2`,
Ward at precisely those five modes implies Ward at every integer mode.

This is the sharp algebraic reduction needed by a concrete Lee--Yang intertwining-operator
construction.  The remaining input is finite: lower truncation and five explicit coefficient
identities.  No intertwining-operator axiom is introduced here.
-/

set_option linter.style.longLine false

namespace VOA
namespace InverseDS
namespace LeeYangWardClosure

open Module (End)
open ScreeningCoset
open ScreeningLowering

noncomputable section

universe u v

variable {Source : Type u} {Target : Type v}
variable [AddCommGroup Source] [Module ℂ Source]
variable [AddCommGroup Target] [Module ℂ Target]

/-! ## Virasoro modes of a representation -/

/-- The mode `L_m` belonging to a Virasoro representation. -/
def virMode (R : VirRep Source) (m : ℤ) : End ℂ Source := R.ρ (L m)

/-- Virasoro commutator for the modes of an arbitrary representation. -/
theorem virMode_comm (R : VirRep Source) (m n : ℤ) :
    virMode R m * virMode R n - virMode R n * virMode R m
      = ((m : ℂ) - n) • virMode R (m + n)
        + (if m + n = 0
            then (((m : ℂ) ^ 3 - m) / 12 * R.centralCharge) •
              (1 : End ℂ Source)
            else 0) := by
  rw [virMode, virMode, ← LieRing.of_associative_ring_bracket,
    ← R.ρ.map_lie (L m) (L n), virasoro_bracket, map_add, map_smul]
  congr 1
  by_cases hmn : m + n = 0
  · rw [if_pos hmn, if_pos hmn, map_smul, R.acts_central, smul_smul]
    rfl
  · simp only [if_neg hmn, map_zero]

/-! ## The induced action on heterotypic operators -/

/-- The action of a pair of source/target operators on a heterotypic linear map. -/
def homBracket (targetOp : End ℂ Target) (f : Source →ₗ[ℂ] Target)
    (sourceOp : End ℂ Source) : Source →ₗ[ℂ] Target :=
  targetOp.comp f - f.comp sourceOp

theorem homBracket_eq_heterotypicBracketCoeff
    (targetOp : End ℂ Target) (f : Source →ₗ[ℂ] Target)
    (sourceOp : End ℂ Source) :
    homBracket targetOp f sourceOp =
      VOA.InverseDS.ScreeningCoset.heterotypicBracketCoeff
        targetOp f sourceOp := rfl

theorem homBracket_smul (targetOp : End ℂ Target) (f : Source →ₗ[ℂ] Target)
    (sourceOp : End ℂ Source) (a : ℂ) :
    homBracket targetOp (a • f) sourceOp = a • homBracket targetOp f sourceOp := by
  apply LinearMap.ext
  intro x
  simp only [homBracket, LinearMap.sub_apply, LinearMap.comp_apply,
    LinearMap.smul_apply, map_smul]
  module

/-- The central terms cancel between source and target in the induced action on heterotypic
operators.  This is the operator-valued Jacobi identity used to propagate primary Ward
relations. -/
theorem homBracket_comm
    (sourceM sourceN sourceMN : End ℂ Source)
    (targetM targetN targetMN : End ℂ Target)
    (f : Source →ₗ[ℂ] Target) (a z : ℂ)
    (hSource : sourceM * sourceN - sourceN * sourceM =
      a • sourceMN + z • (1 : End ℂ Source))
    (hTarget : targetM * targetN - targetN * targetM =
      a • targetMN + z • (1 : End ℂ Target)) :
    homBracket targetM (homBracket targetN f sourceN) sourceM
        - homBracket targetN (homBracket targetM f sourceM) sourceN
      = a • homBracket targetMN f sourceMN := by
  apply LinearMap.ext
  intro x
  have hS := LinearMap.congr_fun hSource x
  have hT := LinearMap.congr_fun hTarget (f x)
  simp only [homBracket, LinearMap.sub_apply, LinearMap.comp_apply,
    LinearMap.add_apply, LinearMap.smul_apply, Module.End.mul_apply,
    Module.End.one_apply] at hS hT ⊢
  have hfS := congrArg f hS
  simp only [map_sub, map_add, map_smul] at hfS
  rw [show
      targetM (targetN (f x) - f (sourceN x)) -
          (targetN (f (sourceM x)) - f (sourceN (sourceM x))) -
        (targetN (targetM (f x) - f (sourceM x)) -
          (targetM (f (sourceN x)) - f (sourceM (sourceN x)))) =
        (targetM (targetN (f x)) - targetN (targetM (f x))) -
          f (sourceM (sourceN x) - sourceN (sourceM x)) by
        simp only [map_sub]
        abel,
    hT]
  rw [map_sub, hfS]
  module

/-! ## Ward at one mode and propagation under addition -/

/-- The primary Ward identity at a single Virasoro mode `m`, with half-power coefficient
labels.  The full interface in `InverseDSScreeningLowering` is `∀ m, PrimaryWardAt h ... m`. -/
def PrimaryWardAt (h : ℂ)
    (sourceL : ℤ → End ℂ Source) (targetL : ℤ → End ℂ Target)
    (I : FormalDist (Source →ₗ[ℂ] Target)) (m : ℤ) : Prop :=
  ∀ t : ℤ,
    homBracket (targetL m) (I t) (sourceL m) =
      (((t - 2 * m : ℤ) : ℂ) / 2 + ((m + 1 : ℤ) : ℂ) * h) •
        I (t - 2 * m)

theorem primaryWard_iff_forall_at (h : ℂ)
    (sourceL : ℤ → End ℂ Source) (targetL : ℤ → End ℂ Target)
    (I : FormalDist (Source →ₗ[ℂ] Target)) :
    (∀ m, PrimaryWardAt h sourceL targetL I m) ↔
      (∀ m t : ℤ,
        (targetL m).comp (I t) - (I t).comp (sourceL m) =
          (((t - 2 * m : ℤ) : ℂ) / 2 + ((m + 1 : ℤ) : ℂ) * h) •
            I (t - 2 * m)) := by
  rfl

/-- Ward at two distinct modes propagates to their sum.  Equality of the source and target
central terms is the only representation-theoretic input. -/
def leeYangCentralCharge : ℂ := -22 / 5

theorem PrimaryWardAt.add
    (h : ℂ) (sourceL : ℤ → End ℂ Source) (targetL : ℤ → End ℂ Target)
    (I : FormalDist (Source →ₗ[ℂ] Target)) (m n : ℤ) (hmn : m ≠ n)
    (hSource : sourceL m * sourceL n - sourceL n * sourceL m =
      ((m : ℂ) - n) • sourceL (m + n) +
        (if m + n = 0 then
          (((m : ℂ) ^ 3 - m) / 12 * leeYangCentralCharge) •
            (1 : End ℂ Source) else 0))
    (hTarget : targetL m * targetL n - targetL n * targetL m =
      ((m : ℂ) - n) • targetL (m + n) +
        (if m + n = 0 then
          (((m : ℂ) ^ 3 - m) / 12 * leeYangCentralCharge) •
            (1 : End ℂ Target) else 0))
    (hm : PrimaryWardAt h sourceL targetL I m)
    (hn : PrimaryWardAt h sourceL targetL I n) :
    PrimaryWardAt h sourceL targetL I (m + n) := by
  intro t
  let am : ℤ → ℤ → ℂ := fun r s =>
    (((s - 2 * r : ℤ) : ℂ) / 2 + ((r + 1 : ℤ) : ℂ) * h)
  have hSource' : sourceL m * sourceL n - sourceL n * sourceL m =
      ((m : ℂ) - n) • sourceL (m + n) +
        (if m + n = 0 then
          (((m : ℂ) ^ 3 - m) / 12 * leeYangCentralCharge) else 0) •
            (1 : End ℂ Source) := by
    simpa only [ite_smul, zero_smul] using hSource
  have hTarget' : targetL m * targetL n - targetL n * targetL m =
      ((m : ℂ) - n) • targetL (m + n) +
        (if m + n = 0 then
          (((m : ℂ) ^ 3 - m) / 12 * leeYangCentralCharge) else 0) •
            (1 : End ℂ Target) := by
    simpa only [ite_smul, zero_smul] using hTarget
  have hcomm := homBracket_comm
    (sourceL m) (sourceL n) (sourceL (m + n))
    (targetL m) (targetL n) (targetL (m + n)) (I t)
    ((m : ℂ) - n)
    (if m + n = 0 then
      (((m : ℂ) ^ 3 - m) / 12 * leeYangCentralCharge) else 0)
    hSource' hTarget'
  rw [hn t, homBracket_smul, hm (t - 2 * n),
    hm t, homBracket_smul, hn (t - 2 * m)] at hcomm
  have hcoef :
      am n t * am m (t - 2 * n) - am m t * am n (t - 2 * m) =
        (((m : ℂ) - n) * am (m + n) t) := by
    simp only [am]
    push_cast
    ring
  have hscaled :
      ((m : ℂ) - n) • homBracket (targetL (m + n)) (I t) (sourceL (m + n)) =
        ((m : ℂ) - n) •
          (am (m + n) t • I (t - 2 * (m + n))) := by
    rw [← hcomm]
    change
      am n t • (am m (t - 2 * n) • I (t - 2 * n - 2 * m)) -
          am m t • (am n (t - 2 * m) • I (t - 2 * m - 2 * n)) =
        ((m : ℂ) - n) •
          (am (m + n) t • I (t - 2 * (m + n)))
    rw [show t - 2 * n - 2 * m = t - 2 * (m + n) by ring,
      show t - 2 * m - 2 * n = t - 2 * (m + n) by ring,
      smul_smul, smul_smul, ← sub_smul, hcoef, smul_smul]
  have hscalar : (m : ℂ) - n ≠ 0 := by
    exact sub_ne_zero.mpr (fun heq => hmn (Int.cast_injective heq))
  exact smul_right_injective (Source →ₗ[ℂ] Target) hscalar hscaled

/-! ## Five modes imply all modes -/

/-- The Virasoro relation in the exact form consumed by `PrimaryWardAt.add`. -/
def IsLeeYangModeFamily (Lop : ℤ → End ℂ Source) : Prop :=
  ∀ m n : ℤ,
    Lop m * Lop n - Lop n * Lop m =
      ((m : ℂ) - n) • Lop (m + n) +
        (if m + n = 0 then
          (((m : ℂ) ^ 3 - m) / 12 * leeYangCentralCharge) •
            (1 : End ℂ Source) else 0)

theorem virMode_isLeeYangModeFamily (R : VirRep Source)
    (hc : R.centralCharge = leeYangCentralCharge) :
    IsLeeYangModeFamily (virMode R) := by
  intro m n
  rw [virMode_comm, hc]

/-- The finite-mode closure theorem: Ward at `-2,-1,0,1,2` implies the full primary Ward
identity. -/
theorem primaryWard_all_of_five
    (h : ℂ) (sourceL : ℤ → End ℂ Source) (targetL : ℤ → End ℂ Target)
    (I : FormalDist (Source →ₗ[ℂ] Target))
    (hSource : IsLeeYangModeFamily sourceL)
    (hTarget : IsLeeYangModeFamily targetL)
    (hnegTwo : PrimaryWardAt h sourceL targetL I (-2))
    (hnegOne : PrimaryWardAt h sourceL targetL I (-1))
    (hzero : PrimaryWardAt h sourceL targetL I 0)
    (hone : PrimaryWardAt h sourceL targetL I 1)
    (htwo : PrimaryWardAt h sourceL targetL I 2) :
    ∀ m : ℤ, PrimaryWardAt h sourceL targetL I m := by
  have hadd : ∀ m n : ℤ, m ≠ n →
      PrimaryWardAt h sourceL targetL I m →
      PrimaryWardAt h sourceL targetL I n →
      PrimaryWardAt h sourceL targetL I (m + n) := by
    intro m n hmn hm hn
    exact PrimaryWardAt.add h sourceL targetL I m n hmn
      (hSource m n) (hTarget m n) hm hn
  have hpos : ∀ d : ℕ, PrimaryWardAt h sourceL targetL I (d : ℤ) := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
        rcases d with _ | _ | d
        · simpa using hzero
        · simpa using hone
        · rcases d with _ | d
          · simpa using htwo
          · have hprev := ih (d + 2) (by omega)
            have hsum := hadd 1 (d + 2 : ℕ) (by omega) hone (by simpa using hprev)
            convert hsum using 1 <;> push_cast <;> ring
  have hneg : ∀ d : ℕ, PrimaryWardAt h sourceL targetL I (-(d : ℤ)) := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
        rcases d with _ | _ | d
        · simpa using hzero
        · simpa using hnegOne
        · rcases d with _ | d
          · simpa using hnegTwo
          · have hprev := ih (d + 2) (by omega)
            have hsum := hadd (-1) (-(d + 2 : ℕ) : ℤ) (by omega)
              hnegOne (by simpa using hprev)
            have hindex : (-1 : ℤ) + -(d + 2 : ℕ) = -((d + 3 : ℕ) : ℤ) := by
              push_cast
              ring
            rw [hindex] at hsum
            exact hsum
  intro m
  by_cases hm : 0 ≤ m
  · obtain ⟨d, rfl⟩ := Int.eq_ofNat_of_zero_le hm
    exact hpos d
  · have hnegm : 0 ≤ -m := by omega
    obtain ⟨d, hd⟩ := Int.eq_ofNat_of_zero_le hnegm
    have hmd : m = -(d : ℤ) := by omega
    rw [hmd]
    exact hneg d

/-! ## Specialization to the inverse-DS Lee--Yang interface -/

/-- Five checked Ward modes are enough to populate the exact lowering-current interface. -/
theorem k85VirasoroIntertwinerWard_of_five
    (sourceL : ℤ → End ℂ Source) (targetL : ℤ → End ℂ Target)
    (I : FormalDist (Source →ₗ[ℂ] Target))
    (hSource : IsLeeYangModeFamily sourceL)
    (hTarget : IsLeeYangModeFamily targetL)
    (hnegTwo : PrimaryWardAt k85ScreeningVirWeight sourceL targetL I (-2))
    (hnegOne : PrimaryWardAt k85ScreeningVirWeight sourceL targetL I (-1))
    (hzero : PrimaryWardAt k85ScreeningVirWeight sourceL targetL I 0)
    (hone : PrimaryWardAt k85ScreeningVirWeight sourceL targetL I 1)
    (htwo : PrimaryWardAt k85ScreeningVirWeight sourceL targetL I 2) :
    K85VirasoroIntertwinerWard sourceL targetL I := by
  exact primaryWard_all_of_five k85ScreeningVirWeight sourceL targetL I
    hSource hTarget hnegTwo hnegOne hzero hone htwo

/-- Finite data sufficient to construct the lowering-current Virasoro screening interface. -/
structure K85VirasoroScreeningFiveModeData where
  sourceL : ℤ → End ℂ Source
  targetL : ℤ → End ℂ Target
  field : FormalDist (Source →ₗ[ℂ] Target)
  isHeterotypicField : ScreeningCoset.IsHeterotypicField field
  sourceVirasoro : IsLeeYangModeFamily sourceL
  targetVirasoro : IsLeeYangModeFamily targetL
  ward_negTwo : PrimaryWardAt k85ScreeningVirWeight sourceL targetL field (-2)
  ward_negOne : PrimaryWardAt k85ScreeningVirWeight sourceL targetL field (-1)
  ward_zero : PrimaryWardAt k85ScreeningVirWeight sourceL targetL field 0
  ward_one : PrimaryWardAt k85ScreeningVirWeight sourceL targetL field 1
  ward_two : PrimaryWardAt k85ScreeningVirWeight sourceL targetL field 2

/-- Assembly of the original infinite Ward-data structure from the finite five-mode package. -/
def K85VirasoroScreeningFiveModeData.toScreeningFieldData
    (D : K85VirasoroScreeningFiveModeData (Source := Source) (Target := Target)) :
    K85VirasoroScreeningFieldData (Vir := Source) (ShiftedVir := Target) where
  sourceL := D.sourceL
  targetL := D.targetL
  field := D.field
  isHeterotypicField := D.isHeterotypicField
  ward := k85VirasoroIntertwinerWard_of_five D.sourceL D.targetL D.field
    D.sourceVirasoro D.targetVirasoro D.ward_negTwo D.ward_negOne D.ward_zero D.ward_one D.ward_two

end
end LeeYangWardClosure
