import VOA.Examples.TwoSeriesHighJet

/-!
# The model ring at the point `u = ε / √(1 + b t)`, `v = √(1 + b t)`

The membership space `vMem` lives in the model ring `R_n[u_j, v_j]`, whose words are products of
current letters (jets of `u², uv, v²`) and Sugawara letters `T_m - J_m`.  This file specialises the
jet variables, **keeping `R = ℂ[T_j]` untouched**, to

  `v = √(1 + b t)`,   `u = ε / √(1 + b t)`,   `ε² = 0`,

with values in `𝔸[ε]`, `𝔸 = ℂ[b, T_0, T_1, …]` (`b = X none`, `T_m = X (some m)`).  Then `u² = 0`,
`uv = ε`, `v² = 1 + b t` and `J = u'v - uv' = ε (-b)/(1 + b t)`, so a Sugawara letter becomes
`T_m - ε (-b)^{m+1}`.

The key observation is a filtration that every letter respects.  With `Dβ` the derivation of `𝔸`
with `T_m ↦ (-b)^{m+1}`, `b ↦ 0`, put `Λ (x + ε y) = y + Dβ x` and

  `Good r = {x + ε y | deg x ≤ r, deg (b · Λ) ≤ r}`  (total degree in `b, T_j`).

`Λ` satisfies the Leibniz rule `Λ(PQ) = fst P · Λ Q + Λ P · fst Q`, so `Good` is multiplicative;
current letters lie in `Good 1` and **every Sugawara letter has `Λ = 0`** (its `ε`-part is exactly
cancelled by `Dβ T_m`).  Hence every model word of length `r` maps into `Good r`.

* `psiM` — the specialisation of `ℂ[T_j][u_j, v_j]`; `Good r`; `mul_mem_Good`;
* `psiM_mletter_mem_Good`, `psiM_mword_mem_Good` — words of length `r` land in `Good r`;
* `modelCond_of_vMem` — **the model condition**: if `τ ∈ vMem (R_n) r d (2N)` and `F` lifts `τ`,
  then `inl F - x` lies in the ideal generated by `J_n` for some `x ∈ Good r`.

Everything is proved outright.
-/

namespace VOA.TwoSeries.StrictModel

open MvPolynomial VOA.SymbolModel VOA.AdamovicSymbol

noncomputable section

-- The dual numbers over `ℂ[b, T_j]` make instance search and unification expensive.
set_option synthInstance.maxHeartbeats 400000
set_option maxHeartbeats 1600000

namespace HighModel

open InclLow HighJet

/-- `𝔸 = ℂ[b, T_0, T_1, …]` with `b = X none`, `T_m = X (some m)`. -/
abbrev AbH : Type := MvPolynomial (Option ℕ) ℂ

/-- `𝔸[ε]`, `ε² = 0`. -/
abbrev DbH : Type := DualNumber AbH

/-- `b`. -/
abbrev bv : AbH := MvPolynomial.X none

/-- `ℂ[T_j] → 𝔸`. -/
abbrev ιT : TPoly →ₐ[ℂ] AbH := rename some

/-- `𝔸 → 𝔸[ε]`. -/
abbrev inlA : AbH →+* DbH := TrivSqZeroExt.inlHom AbH AbH

/-- The images of the jet variables: `u = ε / √(1 + b t)`, `v = √(1 + b t)`. -/
def psiV (x : Fin 2 × ℕ) : DbH :=
  if x.1 = 0 then DualNumber.eps * TrivSqZeroExt.inl (PowerSeries.coeff x.2 (cS bv))
  else TrivSqZeroExt.inl (PowerSeries.coeff x.2 (bS bv))

/-- The specialisation on `ℂ[u_j, v_j]`. -/
def psi0 : JetPoly →ₐ[ℂ] DbH := aeval psiV

/-- The specialisation on `ℂ[T_j][u_j, v_j]`: coefficients `F ↦ inl (ιT F)`. -/
def psiM : MPoly TPoly →+* DbH := eval₂Hom (inlA.comp ιT.toRingHom) psiV

theorem psiM_C (F : TPoly) : psiM (MvPolynomial.C F) = TrivSqZeroExt.inl (ιT F) := by
  simp [psiM]

theorem psiM_X (x : Fin 2 × ℕ) : psiM (MvPolynomial.X x) = psiV x := by
  simp [psiM]

theorem psiM_ι (P : JetPoly) : psiM (ι TPoly P) = psi0 P := by
  change eval₂Hom (inlA.comp ιT.toRingHom) psiV (map (algebraMap ℂ TPoly) P) = aeval psiV P
  rw [eval₂Hom_map_hom, aeval_def, coe_eval₂Hom]
  congr 1
  refine RingHom.ext fun c => ?_
  simp [TrivSqZeroExt.algebraMap_eq_inl']

/-! ### The series -/

/-- The `u`-series. -/
abbrev uB : PowerSeries DbH := PowerSeries.C DualNumber.eps * PowerSeries.map inlA (cS bv)

/-- The `v`-series. -/
abbrev vB : PowerSeries DbH := PowerSeries.map inlA (bS bv)

theorem map_psi0_colSer_zero : PowerSeries.map psi0.toRingHom (colSer 0) = uB := by
  refine PowerSeries.ext fun j => ?_
  rw [PowerSeries.coeff_map, colSer, PowerSeries.coeff_mk, PowerSeries.coeff_C_mul,
    PowerSeries.coeff_map]
  simp [psi0, psiV]

theorem map_psi0_colSer_one : PowerSeries.map psi0.toRingHom (colSer 1) = vB := by
  refine PowerSeries.ext fun j => ?_
  rw [PowerSeries.coeff_map, colSer, PowerSeries.coeff_mk, PowerSeries.coeff_map]
  simp [psi0, psiV]

theorem epsB_sq : (PowerSeries.C DualNumber.eps : PowerSeries DbH) * PowerSeries.C DualNumber.eps =
    0 := by
  rw [← map_mul, DualNumber.eps_mul_eps, map_zero]

theorem map_psi0_xSer : PowerSeries.map psi0.toRingHom xSer = 0 := by
  rw [xSer, map_mul, map_psi0_colSer_zero]
  linear_combination (PowerSeries.map inlA (cS bv)) ^ 2 * epsB_sq

theorem map_psi0_ySer : PowerSeries.map psi0.toRingHom ySer = PowerSeries.C DualNumber.eps := by
  rw [ySer, map_mul, map_psi0_colSer_zero, map_psi0_colSer_one]
  have hcb := congrArg (PowerSeries.map inlA) (cS_mul_bS bv)
  rw [map_mul, map_one] at hcb
  linear_combination PowerSeries.C DualNumber.eps * hcb

theorem map_psi0_zSer : PowerSeries.map psi0.toRingHom zSer =
    PowerSeries.map inlA (1 + PowerSeries.C bv * PowerSeries.X) := by
  rw [zSer, map_mul, map_psi0_colSer_one, ← map_mul, bS_mul_bS]

theorem map_psi0_jSer :
    PowerSeries.map psi0.toRingHom jSer =
      PowerSeries.C DualNumber.eps * PowerSeries.map inlA (wS bv) := by
  rw [jSer, map_sub, map_mul, map_mul, InclDegOne.map_derivative, InclDegOne.map_derivative,
    map_psi0_colSer_zero, map_psi0_colSer_one, derivative_C_mul', ← map_derivativeFun',
    ← map_derivativeFun', wS]
  simp only [map_mul, map_sub]
  ring

theorem psi0_coeff (P : PowerSeries JetPoly) (m : ℕ) :
    psi0 (PowerSeries.coeff m P) = PowerSeries.coeff m (PowerSeries.map psi0.toRingHom P) := by
  rw [PowerSeries.coeff_map]; rfl

/-! ### The derivation `Dβ` and the filtration `Good` -/

/-- `Dβ : T_m ↦ (-b)^{m+1}`, `b ↦ 0`. -/
def dbV : Option ℕ → AbH
  | none => 0
  | some m => (-bv) ^ (m + 1)

/-- The derivation `Dβ` of `𝔸`. -/
def Dβ : Derivation ℂ AbH AbH := mkDerivation ℂ dbV

theorem Dβ_X_none : Dβ bv = 0 := by rw [Dβ, mkDerivation_X]; rfl

theorem Dβ_X_some (m : ℕ) : Dβ (MvPolynomial.X (some m)) = (-bv) ^ (m + 1) := by
  rw [Dβ, mkDerivation_X]; rfl

theorem Dβ_C (c : ℂ) : Dβ (MvPolynomial.C c) = 0 := by
  rw [← MvPolynomial.algebraMap_eq, Derivation.map_algebraMap]

/-- `Λ (x + ε y) = y + Dβ x`. -/
def Lam (x : DbH) : AbH := TrivSqZeroExt.snd x + Dβ (TrivSqZeroExt.fst x)

theorem Lam_add (x y : DbH) : Lam (x + y) = Lam x + Lam y := by
  simp only [Lam, TrivSqZeroExt.snd_add, TrivSqZeroExt.fst_add, map_add]; ring

theorem Lam_smul (c : ℂ) (x : DbH) : Lam (c • x) = c • Lam x := by
  rw [Lam, Lam, TrivSqZeroExt.snd_smul, TrivSqZeroExt.fst_smul, Dβ.map_smul, smul_add]

/-- The Leibniz rule for `Λ`. -/
theorem Lam_mul (x y : DbH) :
    Lam (x * y) = TrivSqZeroExt.fst x * Lam y + Lam x * TrivSqZeroExt.fst y := by
  simp only [Lam, TrivSqZeroExt.snd_mul, TrivSqZeroExt.fst_mul, Derivation.leibniz, smul_eq_mul,
    op_smul_eq_mul]
  ring

/-- `Good r`: total degree of `fst` and of `b · Λ` at most `r`. -/
def Good (r : ℕ) : Submodule ℂ DbH where
  carrier := {x | (TrivSqZeroExt.fst x).totalDegree ≤ r ∧ (bv * Lam x).totalDegree ≤ r}
  add_mem' := by
    rintro x y ⟨hx1, hx2⟩ ⟨hy1, hy2⟩
    refine ⟨?_, ?_⟩
    · rw [TrivSqZeroExt.fst_add]
      exact (totalDegree_add _ _).trans (max_le hx1 hy1)
    · rw [Lam_add, mul_add]
      exact (totalDegree_add _ _).trans (max_le hx2 hy2)
  zero_mem' := by
    refine ⟨?_, ?_⟩
    · simp
    · simp [Lam]
  smul_mem' := by
    rintro c x ⟨hx1, hx2⟩
    refine ⟨?_, ?_⟩
    · rw [TrivSqZeroExt.fst_smul]
      exact (totalDegree_smul_le _ _).trans hx1
    · rw [Lam_smul, mul_smul_comm]
      exact (totalDegree_smul_le _ _).trans hx2

theorem mem_Good {r : ℕ} {x : DbH} :
    x ∈ Good r ↔ (TrivSqZeroExt.fst x).totalDegree ≤ r ∧ (bv * Lam x).totalDegree ≤ r := Iff.rfl

/-- `Good` is multiplicative. -/
theorem mul_mem_Good {a b : ℕ} {x y : DbH} (hx : x ∈ Good a) (hy : y ∈ Good b) :
    x * y ∈ Good (a + b) := by
  obtain ⟨hx1, hx2⟩ := mem_Good.mp hx
  obtain ⟨hy1, hy2⟩ := mem_Good.mp hy
  refine mem_Good.mpr ⟨?_, ?_⟩
  · rw [TrivSqZeroExt.fst_mul]
    exact (totalDegree_mul _ _).trans (add_le_add hx1 hy1)
  · rw [Lam_mul, show bv * (TrivSqZeroExt.fst x * Lam y + Lam x * TrivSqZeroExt.fst y) =
      TrivSqZeroExt.fst x * (bv * Lam y) + (bv * Lam x) * TrivSqZeroExt.fst y by ring]
    refine (totalDegree_add _ _).trans (max_le ?_ ?_)
    · exact (totalDegree_mul _ _).trans (add_le_add hx1 hy2)
    · exact (totalDegree_mul _ _).trans (by omega)

theorem one_mem_Good : (1 : DbH) ∈ Good 0 := by
  refine mem_Good.mpr ⟨?_, ?_⟩
  · rw [TrivSqZeroExt.fst_one]; simp
  · simp [Lam, TrivSqZeroExt.fst_one, TrivSqZeroExt.snd_one]

theorem Good_mono {a b : ℕ} (h : a ≤ b) : Good a ≤ Good b := by
  rintro x ⟨h1, h2⟩
  exact ⟨h1.trans h, h2.trans h⟩

/-! ### The letters -/

theorem inl_const_mem_Good (c : ℂ) :
    TrivSqZeroExt.inl (MvPolynomial.C c : AbH) ∈ (Good 1 : Set DbH) := by
  refine mem_Good.mpr ⟨?_, ?_⟩
  · rw [TrivSqZeroExt.fst_inl, totalDegree_C]; omega
  · rw [Lam, TrivSqZeroExt.snd_inl, TrivSqZeroExt.fst_inl, Dβ_C, add_zero, mul_zero]; simp

theorem coeff_one_add_bX (m : ℕ) :
    PowerSeries.coeff m (1 + PowerSeries.C bv * PowerSeries.X : PowerSeries AbH) =
      (if m = 0 then 1 else 0) + (if m = 1 then bv else 0) := by
  rw [map_add, PowerSeries.coeff_one, PowerSeries.coeff_C_mul, PowerSeries.coeff_X]
  split_ifs <;> simp

theorem zletter_mem_Good (m : ℕ) :
    TrivSqZeroExt.inl (PowerSeries.coeff m (1 + PowerSeries.C bv * PowerSeries.X : PowerSeries AbH))
      ∈ Good 1 := by
  rw [coeff_one_add_bX]
  refine mem_Good.mpr ⟨?_, ?_⟩
  · rw [TrivSqZeroExt.fst_inl]
    refine (totalDegree_add _ _).trans (max_le ?_ ?_)
    · split_ifs <;> simp
    · split_ifs
      · rw [totalDegree_X]
      · simp
  · rw [Lam, TrivSqZeroExt.snd_inl, TrivSqZeroExt.fst_inl, zero_add, map_add]
    have h1 : Dβ (if m = 0 then (1 : AbH) else 0) = 0 := by
      split_ifs
      · exact Dβ.map_one_eq_zero
      · exact map_zero _
    have h2 : Dβ (if m = 1 then bv else 0) = 0 := by
      split_ifs
      · exact Dβ_X_none
      · exact map_zero _
    rw [h1, h2, add_zero, mul_zero]; simp

/-- The current letters land in `Good 1`. -/
theorem psi0_current_mem_Good (a : Fin 3) (m : ℕ) : psi0 (letterSym (.current a, m)) ∈ Good 1 := by
  match a with
  | 0 =>
    change psi0 (PowerSeries.coeff m xSer) ∈ Good 1
    rw [psi0_coeff, map_psi0_xSer, map_zero]
    exact Submodule.zero_mem _
  | 1 =>
    change psi0 (PowerSeries.coeff m (-zSer)) ∈ Good 1
    rw [map_neg, map_neg, psi0_coeff, map_psi0_zSer, PowerSeries.coeff_map]
    exact (Good 1).neg_mem (zletter_mem_Good m)
  | 2 =>
    change psi0 (PowerSeries.coeff m (-(ySer + ySer))) ∈ Good 1
    rw [map_neg, map_add, map_neg, map_add, psi0_coeff, map_psi0_ySer, PowerSeries.coeff_C]
    have h : DualNumber.eps ∈ Good 1 := by
      refine mem_Good.mpr ⟨?_, ?_⟩
      · rw [DualNumber.fst_eps]; simp
      · rw [Lam, DualNumber.snd_eps, DualNumber.fst_eps, map_zero, add_zero, mul_one,
          totalDegree_X]
    refine (Good 1).neg_mem ((Good 1).add_mem ?_ ?_) <;>
    · split_ifs
      · exact h
      · exact Submodule.zero_mem _

/-- **A Sugawara letter has `Λ = 0`**: `T_m - ε (-b)^{m+1}`. -/
theorem psiM_sugawara (m : ℕ) :
    psiM (mletter TPoly MvPolynomial.X (.sugawara, m)) =
      TrivSqZeroExt.inl (MvPolynomial.X (some m)) -
        DualNumber.eps * TrivSqZeroExt.inl ((-bv) ^ (m + 1)) := by
  change psiM (ι TPoly (PowerSeries.coeff m (-jSer)) + MvPolynomial.C (MvPolynomial.X m)) = _
  rw [map_add, psiM_ι, psiM_C, map_neg, map_neg, psi0_coeff, map_psi0_jSer, PowerSeries.coeff_C_mul,
    PowerSeries.coeff_map, coeff_wS, rename_X]
  rw [show ∀ y : AbH, inlA y = TrivSqZeroExt.inl y from fun _ => rfl]
  ring

theorem psiM_sugawara_mem_Good (m : ℕ) :
    psiM (mletter TPoly MvPolynomial.X (.sugawara, m)) ∈ Good 1 := by
  rw [psiM_sugawara]
  refine mem_Good.mpr ⟨?_, ?_⟩
  · rw [TrivSqZeroExt.fst_sub, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_mul, DualNumber.fst_eps,
      zero_mul, sub_zero, totalDegree_X]
  · have hL : Lam (TrivSqZeroExt.inl (MvPolynomial.X (some m)) -
        DualNumber.eps * TrivSqZeroExt.inl ((-bv) ^ (m + 1))) = 0 := by
      rw [Lam, TrivSqZeroExt.snd_sub, TrivSqZeroExt.fst_sub, TrivSqZeroExt.snd_inl,
        TrivSqZeroExt.fst_inl, TrivSqZeroExt.snd_mul, TrivSqZeroExt.fst_mul, DualNumber.fst_eps,
        DualNumber.snd_eps, TrivSqZeroExt.fst_inl, TrivSqZeroExt.snd_inl, zero_mul, sub_zero,
        Dβ_X_some]
      simp
    rw [hL, mul_zero]; simp

/-- Every letter lands in `Good 1`. -/
theorem psiM_mletter_mem_Good (l : VOA.AffineVOA.CorrectedR.Generator × ℕ) :
    psiM (mletter TPoly MvPolynomial.X l) ∈ Good 1 := by
  obtain ⟨g, m⟩ := l
  cases g with
  | current a =>
    change psiM (ι TPoly (letterSym (.current a, m))) ∈ Good 1
    rw [psiM_ι]
    exact psi0_current_mem_Good a m
  | sugawara => exact psiM_sugawara_mem_Good m

/-- Every model word of length `r` lands in `Good r`. -/
theorem psiM_mword_mem_Good (w : List (VOA.AffineVOA.CorrectedR.Generator × ℕ)) :
    psiM (mword TPoly MvPolynomial.X w) ∈ Good w.length := by
  induction w with
  | nil => rw [mword_nil, map_one]; exact one_mem_Good
  | cons l w ih =>
    rw [mword_cons, map_mul, List.length_cons, add_comm]
    exact mul_mem_Good (psiM_mletter_mem_Good l) ih

theorem psiM_smul (c : ℂ) (Y : MPoly TPoly) : psiM (c • Y) = c • psiM Y := by
  rw [Algebra.smul_def, map_mul, Algebra.smul_def]
  congr 1
  rw [MvPolynomial.algebraMap_apply, psiM_C, TrivSqZeroExt.algebraMap_eq_inl', AlgHom.commutes]

/-- The model span `modelDeg r d` lands in `Good r`. -/
theorem psiM_mem_Good_of_modelDeg {r : ℕ} {d : ℤ} {Y : MPoly TPoly}
    (hY : Y ∈ modelDeg TPoly MvPolynomial.X r d) : psiM Y ∈ Good r := by
  induction hY using Submodule.span_induction with
  | mem P hP =>
    obtain ⟨w, hw, -, rfl⟩ := hP
    rw [← hw]; exact psiM_mword_mem_Good w
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add P Q _ _ hP hQ => rw [map_add]; exact add_mem hP hQ
  | smul c P _ hP => rw [psiM_smul]; exact Submodule.smul_mem _ c hP

/-! ### The model condition -/

/-- The ideal of `𝔸[ε]` generated by the jet ideal `J_n`. -/
abbrev JdH (n : ℕ) : Ideal DbH := Ideal.map (inlA.comp ιT.toRingHom) (jetIdealT n)

/-- Reduction of coefficients `ℂ[T_j] → R_n` on the model ring. -/
abbrev qM (n : ℕ) : MPoly TPoly →+* MPoly (Rn n) :=
  MvPolynomial.map (Ideal.Quotient.mk (jetIdealT n))

theorem qM_ι (n : ℕ) (P : JetPoly) : qM n (ι TPoly P) = ι (Rn n) P := by
  change MvPolynomial.map _ (MvPolynomial.map (algebraMap ℂ TPoly) P) =
    MvPolynomial.map (algebraMap ℂ (Rn n)) P
  rw [MvPolynomial.map_map]
  congr 1

theorem qM_mletter (n : ℕ) (l : VOA.AffineVOA.CorrectedR.Generator × ℕ) :
    qM n (mletter TPoly MvPolynomial.X l) = mletter (Rn n) (tn n) l := by
  obtain ⟨g, m⟩ := l
  cases g with
  | current a => exact qM_ι n _
  | sugawara =>
    change qM n (ι TPoly _ + MvPolynomial.C (MvPolynomial.X m)) =
      ι (Rn n) _ + MvPolynomial.C (tn n m)
    rw [map_add, qM_ι, MvPolynomial.map_C]
    rfl

theorem qM_mword (n : ℕ) (w : List (VOA.AffineVOA.CorrectedR.Generator × ℕ)) :
    qM n (mword TPoly MvPolynomial.X w) = mword (Rn n) (tn n) w := by
  induction w with
  | nil => simp
  | cons l w ih => rw [mword_cons, mword_cons, map_mul, qM_mletter, ih]

theorem qM_smul (n : ℕ) (c : ℂ) (Y : MPoly TPoly) : qM n (c • Y) = c • qM n Y := by
  rw [Algebra.smul_def, map_mul, Algebra.smul_def]
  congr 1
  rw [MvPolynomial.algebraMap_apply, MvPolynomial.map_C, MvPolynomial.algebraMap_apply]
  rfl

theorem exists_lift_modelDeg (n r : ℕ) (d : ℤ) {Z : MPoly (Rn n)}
    (hZ : Z ∈ modelDeg (Rn n) (tn n) r d) :
    ∃ Y ∈ modelDeg TPoly MvPolynomial.X r d, qM n Y = Z := by
  induction hZ using Submodule.span_induction with
  | mem P hP =>
    obtain ⟨w, hw, hwd, rfl⟩ := hP
    exact ⟨mword TPoly MvPolynomial.X w, Submodule.subset_span ⟨w, hw, hwd, rfl⟩, qM_mword n w⟩
  | zero => exact ⟨0, Submodule.zero_mem _, map_zero _⟩
  | add P Q _ _ hP hQ =>
    obtain ⟨Y1, h1, e1⟩ := hP
    obtain ⟨Y2, h2, e2⟩ := hQ
    exact ⟨Y1 + Y2, add_mem h1 h2, by rw [map_add, e1, e2]⟩
  | smul c P _ hP =>
    obtain ⟨Y, h, e⟩ := hP
    exact ⟨c • Y, Submodule.smul_mem _ c h, by rw [qM_smul, e]⟩

theorem psiV_v0 : psiV (1, 0) = 1 := by
  simp [psiV, coeff_zero_bS]

/-- **The model condition.** If `τ ∈ vMem (R_n) r d (2N)` and `F ∈ ℂ[T_j]` lifts `τ`, then
`inl F` agrees modulo the ideal generated by `J_n` with an element of `Good r`. -/
theorem modelCond_of_vMem {n r N : ℕ} {d : ℤ} {τ : Rn n}
    (hτ : τ ∈ vMem (Rn n) (tn n) r d (2 * N)) (F : TPoly)
    (hF : Ideal.Quotient.mk (jetIdealT n) F = τ) :
    ∃ x ∈ Good r, TrivSqZeroExt.inl (ιT F) - x ∈ JdH n := by
  have h1 : MvPolynomial.C τ * MvPolynomial.X (1, 0) ^ (2 * N) ∈ modelDeg (Rn n) (tn n) r d := by
    have := hτ
    rwa [vMem, Submodule.mem_comap, vLift_apply] at this
  obtain ⟨Y, hY, hYeq⟩ := exists_lift_modelDeg n r d h1
  have h2 : MvPolynomial.C F * MvPolynomial.X (1, 0) ^ (2 * N) - Y ∈ RingHom.ker (qM n) := by
    rw [RingHom.mem_ker, map_sub, map_mul, map_pow, MvPolynomial.map_C, MvPolynomial.map_X, hF,
      hYeq, sub_self]
  rw [MvPolynomial.ker_map, Ideal.mk_ker] at h2
  refine ⟨psiM Y, psiM_mem_Good_of_modelDeg hY, ?_⟩
  have h3 := Ideal.mem_map_of_mem psiM h2
  rw [Ideal.map_map] at h3
  have hcomp : psiM.comp MvPolynomial.C = inlA.comp ιT.toRingHom :=
    RingHom.ext fun G => psiM_C G
  rw [hcomp, map_sub, map_mul, map_pow, psiM_C, psiM_X, psiV_v0, one_pow, mul_one] at h3
  exact h3

end HighModel

end

end VOA.TwoSeries.StrictModel
