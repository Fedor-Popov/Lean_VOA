import VOA.Examples.TripletScreening

/-!
# The doublet generators `a⁻`, `a⁺` of the singlet/doublet algebra `A(p)`

This is the **half-lattice** analogue of `Examples.TripletScreening`.  The triplet `W(p)` lives
inside the lattice VOA of `L = ℤα` with `⟨α,α⟩ = 2p`; the doublet `A(p)` needs the *half* lattice
`½ℤγ` with `⟨γ,γ⟩ = 2p`, i.e. a lattice containing a vector

  `g := γ/2`,      `⟨g,g⟩ = p/2`.

Since the Gram form of an `IntegralLattice` is `ℤ`-valued, we record this hypothesis in the
denominator-free form

  `hgg : 2 * ⟨g,g⟩ = p`                                   (`form_two_form_gg`)

which by itself already forces `p` to be **even** (`p_even`).  The background charge is the same
`λ = ((p−1)/(2p))·γ = ((p−1)/p)·g` as for the triplet, recorded through its pairing with `g`:

  `hlam : ⟨λ,g⟩ = (p−1)/2`.

## The arithmetic (all of it proved below, none assumed)

| state | deformed weight `½⟨β,β⟩ − ⟨λ,β⟩` | theorem |
|---|---|---|
| `e^{γ} = e^{2g}` | `p − (p−1) = 1` | `gamma_wt_one` |
| `a⁻ = e^{−g}`    | `p/4 + (p−1)/2 = (3p−2)/4` | `LBG_zero_aMinus` |
| `a⁺ = Q a⁻`      | `(3p−2)/4` (same, `Q` has weight `0`) | `LBG_zero_aPlus` |
| `e^{+g}`         | `p/4 − (p−1)/2 = (2−p)/4` | `LBG_zero_eG` |

The last line is the reason the doublet's positivity **cannot** be inherited from the ambient
half-lattice VOA: `(2−p)/4 < 0` as soon as `p > 2` (`eG_weight_neg`), e.g. `−1/2` at `p = 4` and
`−1` at `p = 6`.  `e^{+g}` must therefore be *excluded* from the subalgebra generated by
`a⁻, a⁺`, and positivity has to be proved on that subalgebra.

## Main results

* `form_gamma_g` — `⟨γ,g⟩ = ⟨2g,g⟩ = p` is an **integer**.  This is what makes the short
  screening `Q = (e^{γ})₍₀₎` act on half-lattice states with no branch cut: the mode index
  `−1 − ⟨γ,β⟩` occurring in `Screen.Qscr_latStateGen` stays in `ℤ` on the whole half lattice.
  (In this formalization `L` is integral by construction, so the content of the statement is the
  *value* `p`, which is what all the weight bookkeeping below consumes.)
* `Qdb`, `aMinus`, `aPlus` — the screening `Q := (e^{2g})₍₀₎` and the two doublet generators
  `a⁻ := e^{−g}`, `a⁺ := Q a⁻`.
* `gamma_wt_one` — `wt(e^{2g}) = 1`, hence (`Screen.LBG_zero_comm_Qscr`) `[L^λ₀, Q] = 0`.
* `LBG_zero_aMinus`, `LBG_zero_aPlus` — **both generators sit at deformed weight `(3p−2)/4`**.
* `aPlus_eq` — the explicit formula `a⁺ = ε(2g,−g) · S_{p−1}(2g) ⊗ e^{g}`, a vector Schur state.
* `aPlus_ne_zero` — **`a⁺ ≠ 0`**, via `Screen.vSchur_ne_zero`.
* `Qdb_aPlus` — `Q a⁺ = Q² a⁻ = 0`: the doublet is exactly two-dimensional as a `Q`-string
  (charge `2g` at weight `(3p−2)/4` would need boson degree `−2`).
* `p_even`, `form_gg_even_iff` — the mod-4 dichotomy: `⟨g,g⟩ = p/2` is an integer iff `p` is even,
  and is *even* (so the half lattice is an even lattice, and the VOA is bosonic) iff `4 ∣ p`.
  Complementarily `(3p−2)/4` is a half-integer exactly when `4 ∣ p` (`doubletWt_four_mul`) and an
  integer exactly when `p ≡ 2 mod 4` (`doubletWt_four_mul_add_two`).

## What is *not* here

Everything about the *algebra*: the derivation property of `Q`, the closure of `span{a⁻,a⁺}` under
the VOA products, the `A(p)` subalgebra itself, and the exclusion of `e^{+g}` from it.  Also the
half lattice as an `IntegralLattice` and the `ℂ`-graded ambient instance are built elsewhere; every
statement here is against an **arbitrary** `IntegralLattice L` carrying a vector `g` with
`2⟨g,g⟩ = p`, so those instances plug in directly.

All `sorry`-free, axiom-clean.
-/

set_option linter.style.longLine false

namespace VOA.LatGen.Doublet

open scoped BigOperators TensorProduct
open Module (End)
open VOA VOA.IntegralLattice HeisenbergN
open VOA.LatGen VOA.LatGen.BgB

variable (L : IntegralLattice)

/-! ## §0  The half-lattice arithmetic

Throughout, `g` plays the role of `γ/2` and `γ = g + g`.  The hypothesis is always the
denominator-free `2⟨g,g⟩ = p`. -/

/-- `p` is forced to be **even**: `⟨g,g⟩ = p/2` has to be an integer. -/
theorem p_even (g : L.carrier) (p : ℕ) (hgg : 2 * L.form g g = (p : ℤ)) : 2 ∣ p := by
  omega

/-- **`⟨γ,g⟩ = ⟨2g,g⟩ = p`** — an integer.  This is the half-lattice statement that makes the
short screening operator `Q = (e^{γ})₍₀₎` well defined on the *half* lattice: the boson-mode index
`−1 − ⟨γ,β⟩` of `Screen.Qscr_latStateGen` is integral for `β` in the half lattice, not merely for
`β` in `ℤγ`. -/
theorem form_gamma_g (g : L.carrier) (p : ℕ) (hgg : 2 * L.form g g = (p : ℤ)) :
    L.form (g + g) g = (p : ℤ) := by
  rw [map_add, LinearMap.add_apply]
  omega

/-- `⟨γ,−g⟩ = −p`. -/
theorem form_gamma_neg_g (g : L.carrier) (p : ℕ) (hgg : 2 * L.form g g = (p : ℤ)) :
    L.form (g + g) (-g) = -(p : ℤ) := by
  rw [map_neg, form_gamma_g L g p hgg]

/-- `⟨γ,γ⟩ = 4⟨g,g⟩ = 2p` — the triplet normalization, recovered on the doubled vector. -/
theorem form_gamma_gamma (g : L.carrier) (p : ℕ) (hgg : 2 * L.form g g = (p : ℤ)) :
    L.form (g + g) (g + g) = 2 * (p : ℤ) := by
  rw [Screen.form_add_self]
  omega

/-- `γ = 2g ≠ 0` (its norm is `2p ≠ 0`). -/
theorem gamma_ne_zero (g : L.carrier) (p : ℕ) (hp : 1 ≤ p) (hgg : 2 * L.form g g = (p : ℤ)) :
    g + g ≠ 0 := by
  intro h
  have h0 : L.form (g + g) (g + g) = 0 := by rw [h]; simp
  rw [form_gamma_gamma L g p hgg] at h0
  omega

/-- The complex value of the half norm: `⟨g,g⟩ = p/2`. -/
theorem form_gg_cast (g : L.carrier) (p : ℕ) (hgg : 2 * L.form g g = (p : ℤ)) :
    ((L.form g g : ℤ) : ℂ) = (p : ℂ) / 2 := by
  have h : ((2 * L.form g g : ℤ) : ℂ) = ((p : ℤ) : ℂ) := by rw [hgg]
  push_cast at h
  linear_combination h / 2

/-- `⟨λ,γ⟩ = 2⟨λ,g⟩ = p − 1`, the triplet background-charge normalization. -/
theorem bgPair_gamma (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    bgPair L lam (g + g) = (p : ℂ) - 1 := by
  rw [Screen.bgPair_add, hlam]
  ring

/-- `⟨λ,−g⟩ = −(p−1)/2`. -/
theorem bgPair_neg_g (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    bgPair L lam (-g) = -(((p : ℂ) - 1) / 2) := by
  rw [Screen.bgPair_neg, hlam]

/-! ## §1  The mod-4 dichotomy

`⟨g,g⟩ = p/2` is an integer iff `2 ∣ p`; it is *even* — i.e. the half lattice is an **even**
lattice, so the ambient VOA is bosonic — iff `4 ∣ p`.  Complementarily, the doublet weight
`(3p−2)/4` is a half-integer for `4 ∣ p` and an integer for `p ≡ 2 mod 4`.  These are the two
complementary classes referred to in the project decision that "super" and "half-integer weight"
never occur at the same `p`. -/

/-- The half lattice is **even at `g`** exactly when `4 ∣ p`. -/
theorem form_gg_even_iff (g : L.carrier) (p : ℕ) (hgg : 2 * L.form g g = (p : ℤ)) :
    2 ∣ L.form g g ↔ 4 ∣ p := by
  constructor <;> intro h <;> omega

/-- For `p = 4k` the doublet weight `(3p−2)/4 = 3k − ½` is a **half-integer**. -/
theorem doubletWt_four_mul (k : ℕ) :
    (3 * ((4 * k : ℕ) : ℂ) - 2) / 4 = 3 * (k : ℂ) - 1 / 2 := by
  push_cast
  ring

/-- For `p = 4k + 2` the doublet weight `(3p−2)/4 = 3k + 1` is an **integer**. -/
theorem doubletWt_four_mul_add_two (k : ℕ) :
    (3 * ((4 * k + 2 : ℕ) : ℂ) - 2) / 4 = 3 * (k : ℂ) + 1 := by
  push_cast
  ring

/-! ## §2  The screening operator and the two doublet generators -/

/-- **The doublet screening operator** `Q := (e^{γ})₍₀₎ = (e^{2g})₍₀₎`.  It is literally the short
screening of `Examples.TripletScreening` evaluated at the *doubled* vector `γ = 2g`, but it is
applied to states of the half lattice. -/
noncomputable def Qdb (g : L.carrier) : End ℂ (LatModuleGen L) := Screen.Qscr L (g + g)

/-- `Q` is the zero mode of the **reconstructed** vertex operator `Y(e^{2g}, z)` of the ambient
lattice VOA. -/
theorem Qdb_eq_mode_YfullGen (hEven : L.Even) (hPos : L.PosDef) (g : L.carrier) :
    Qdb L g = mode (YfullGen L hEven hPos (latChargeGen L (g + g))) 0 :=
  Screen.Qscr_eq_mode_YfullGen L hEven hPos (g + g)

/-- `a⁻ := e^{−g}`, the lower doublet generator, of deformed weight `(3p−2)/4`. -/
noncomputable def aMinus (g : L.carrier) : LatModuleGen L := latChargeGen L (-g)

/-- `a⁺ := Q a⁻`, the upper doublet generator. -/
noncomputable def aPlus (g : L.carrier) : LatModuleGen L := Qdb L g (aMinus L g)

/-- `a⁻ = e^{−g} ≠ 0`. -/
theorem aMinus_ne_zero (g : L.carrier) : aMinus L g ≠ 0 := Screen.Fscr_ne_zero L g

/-- **`a⁺` is a vector Schur state**: `a⁺ = ε(2g,−g) · S_{p−1}(2g) ⊗ e^{g}`.

`Q` moves `e^{−g}` into the charge-`g` sector, and the dressing index is
`−1 − ⟨2g,−g⟩ = −1 + p = p − 1 ≥ 0`, so `EE(2g)_{p−1}|0⟩ = S_{p−1}(2g)` by `EEVec_vacuum`. -/
theorem aPlus_eq (g : L.carrier) (p : ℕ) (hp : 1 ≤ p) (hgg : 2 * L.form g g = (p : ℤ)) :
    aPlus L g = latticeCocycle L (g + g) (-g) • latStateGen L (vSchur L (g + g) (p - 1)) g := by
  have hform : (-1 : ℤ) - L.form (g + g) (-g) = (p : ℤ) - 1 := by
    rw [form_gamma_neg_g L g p hgg]; ring
  have hsum : g + g + -g = g := by abel
  rw [aPlus, Qdb, aMinus, Screen.Qscr_latChargeGen, hform, EEVec_vacuum,
    if_pos (by omega : (0 : ℤ) ≤ (p : ℤ) - 1),
    show ((p : ℤ) - 1).toNat = p - 1 from by omega, hsum]

/-- **`a⁺ ≠ 0`** — the upper doublet generator is a genuine state.  It is the Schur state
`S_{p−1}(2g) ⊗ e^{g}` up to the (non-zero) FLM cocycle sign, and the vector Schur polynomials never
vanish. -/
theorem aPlus_ne_zero (hPos : L.PosDef) (g : L.carrier) (p : ℕ) (hp : 1 ≤ p)
    (hgg : 2 * L.form g g = (p : ℤ)) : aPlus L g ≠ 0 := by
  rw [aPlus_eq L g p hp hgg]
  simp only [ne_eq, smul_eq_zero, not_or]
  exact ⟨Screen.latticeCocycle_ne_zero L (g + g) (-g),
    Screen.latStateGen_ne_zero L
      (Screen.vSchur_ne_zero L hPos (g + g) (gamma_ne_zero L g p hp hgg) (p - 1)) g⟩

/-! ## §3  `Q` has weight zero -/

/-- **`wt(e^{γ}) = wt(e^{2g}) = ½·2p − (p−1) = 1`** — exactly the hypothesis of
`Screen.LBG_zero_comm_Qscr`, so `[L^λ₀, Q] = 0` and `Q` preserves the deformed grading.  Note this
is the *same* computation as for the triplet: `γ = 2g` has `⟨γ,γ⟩ = 2p` and `⟨λ,γ⟩ = p−1`. -/
theorem gamma_wt_one (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    (1 / 2 : ℂ) * ((L.form (g + g) (g + g) : ℤ) : ℂ) - bgPair L lam (g + g) = 1 :=
  Screen.triplet_wt_one L lam (g + g) p (form_gamma_gamma L g p hgg) (bgPair_gamma L lam g p hlam)

/-- `[L^λ₀, Q] = 0` for the doublet screening. -/
theorem LBG_zero_comm_Qdb (hPos : L.PosDef) (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    LBG L lam 0 * Qdb L g = Qdb L g * LBG L lam 0 :=
  Screen.LBG_zero_comm_Qscr L hPos lam (g + g) (gamma_wt_one L lam g p hgg hlam)

/-- `Q` maps deformed-weight-`k` vectors to deformed-weight-`k` vectors. -/
theorem Qdb_preserves_weight (hPos : L.PosDef) (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2)
    {v : LatModuleGen L} {k : ℂ} (hv : LBG L lam 0 v = k • v) :
    LBG L lam 0 (Qdb L g v) = k • Qdb L g v :=
  Screen.Qscr_preserves_weight L hPos lam (g + g) (gamma_wt_one L lam g p hgg hlam) hv

/-! ## §4  The doublet weights -/

/-- **`wt a⁻ = ½⟨g,g⟩ + ⟨λ,g⟩ = p/4 + (p−1)/2 = (3p−2)/4`.** -/
theorem LBG_zero_aMinus (hPos : L.PosDef) (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    LBG L lam 0 (aMinus L g) = ((3 * (p : ℂ) - 2) / 4) • aMinus L g := by
  rw [aMinus, LBG_zero_latChargeGen L hPos lam (-g)]
  congr 1
  rw [Screen.form_neg_self, bgPair_neg_g L lam g p hlam, form_gg_cast L g p hgg]
  ring

/-- **`wt a⁺ = (3p−2)/4`, the same as `wt a⁻`** — because `Q` has weight `0`.  (Directly:
the boson degree of `a⁺` is `p−1` and its charge is `g`, giving
`(p−1) + p/4 − (p−1)/2 = (3p−2)/4`.) -/
theorem LBG_zero_aPlus (hPos : L.PosDef) (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    LBG L lam 0 (aPlus L g) = ((3 * (p : ℂ) - 2) / 4) • aPlus L g := by
  rw [aPlus]
  exact Qdb_preserves_weight L hPos lam g p hgg hlam (LBG_zero_aMinus L hPos lam g p hgg hlam)

/-- **`wt(e^{+g}) = ½⟨g,g⟩ − ⟨λ,g⟩ = p/4 − (p−1)/2 = (2−p)/4`.**  This is the state that must be
kept *out* of the doublet algebra. -/
theorem LBG_zero_eG (hPos : L.PosDef) (lam : Fin (rank L) → ℂ) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    LBG L lam 0 (latChargeGen L g) = ((2 - (p : ℂ)) / 4) • latChargeGen L g := by
  rw [LBG_zero_latChargeGen L hPos lam g]
  congr 1
  rw [hlam, form_gg_cast L g p hgg]
  ring

/-- **`wt(e^{+g}) < 0` for `p > 2`**: the ambient half-lattice VOA deformed by `λ` has states of
*negative* deformed weight, so `BoundedBelow`/positivity is **not** inherited from the ambient and
must be proved on the doublet subalgebra itself.  (`−1/2` at `p = 4`, `−1` at `p = 6`.) -/
theorem eG_weight_neg (p : ℕ) (hp : 2 < p) : (2 - (p : ℝ)) / 4 < 0 := by
  have h : (2 : ℝ) < (p : ℝ) := by exact_mod_cast hp
  linarith

/-! ## §5  The `Q`-string stops: `Q a⁺ = Q² a⁻ = 0` -/

/-- **`Q a⁺ = 0`.**  `Q` preserves the deformed weight `(3p−2)/4` but raises the lattice charge
by `γ = 2g`; the charge-`3g` sector would need boson degree `(p−1) + (−1 − ⟨2g,g⟩) = −2 < 0`.  So
the doublet `{a⁻, a⁺}` is exactly a two-step `Q`-string, the half-lattice counterpart of
`Screen.Qscr_cube_Fscr` (`Q³F = 0`). -/
theorem Qdb_aPlus (g : L.carrier) (p : ℕ) (hp : 1 ≤ p) (hgg : 2 * L.form g g = (p : ℤ)) :
    Qdb L g (aPlus L g) = 0 := by
  have hS : vSchur L (g + g) (p - 1) ∈ gradingZN (rank L) (((p - 1 : ℕ) : ℤ)) :=
    mem_gradingZN_of_gradingWN (Screen.vSchur_mem_gradingWN L (g + g) (p - 1))
  have h1 := Screen.EEVec_mem_gradingZN L (g + g) (-1 - (p : ℤ)) hS
  rw [gradingZN_of_neg (show ((p - 1 : ℕ) : ℤ) + (-1 - (p : ℤ)) < 0 from by omega),
    Submodule.mem_bot] at h1
  rw [aPlus_eq L g p hp hgg, Qdb, map_smul, Screen.Qscr_latStateGen, form_gamma_g L g p hgg, h1,
    latStateGen, TensorProduct.zero_tmul, smul_zero, smul_zero]

/-- `Q² a⁻ = 0`, spelled out. -/
theorem Qdb_sq_aMinus (g : L.carrier) (p : ℕ) (hp : 1 ≤ p) (hgg : 2 * L.form g g = (p : ℤ)) :
    Qdb L g (Qdb L g (aMinus L g)) = 0 :=
  Qdb_aPlus L g p hp hgg

end VOA.LatGen.Doublet
