/-! ### `T`-polynomials homogeneous in the `T`-degree -/

/-- The span of the `T`-monomials of degree `k`. -/
def tDeg (k : ℕ) : Submodule ℂ TPoly :=
  Submodule.span ℂ {x | ∃ l : List ℕ, l.length = k ∧ (l.map X).prod = x}

theorem tMonW_le_tDeg (k : ℕ) (e : ℤ) : tMonW TPoly X k e ≤ tDeg k := by
  rw [tMonW, Submodule.span_le]
  rintro _ ⟨l, hl, -, rfl⟩
  exact Submodule.subset_span ⟨l, hl, rfl⟩

theorem mul_X_mem_tDeg {k : ℕ} {P : TPoly} (hP : P ∈ tDeg k) (m : ℕ) :
    P * X m ∈ tDeg (k + 1) := by
  have h : tDeg k ≤ (tDeg (k + 1)).comap (LinearMap.mulRight ℂ (X m : TPoly)) := by
    rw [tDeg, Submodule.span_le]
    rintro _ ⟨l, rfl, rfl⟩
    refine Submodule.subset_span ⟨l ++ [m], by simp, ?_⟩
    simp
  exact h hP

theorem aeval_mul_tDeg {B : Type} [CommRing B] [Algebra ℂ B] (c : B) (h : ℕ → B) {k : ℕ}
    {F : TPoly} (hF : F ∈ tDeg k) :
    aeval (fun m => c * h m) F = c ^ k * aeval h F := by
  induction hF using Submodule.span_induction with
  | mem P hP =>
    obtain ⟨l, rfl, rfl⟩ := hP
    induction l with
    | nil => simp
    | cons x l ih => simp [ih, pow_succ]; ring
  | zero => simp
  | add P Q _ _ hP hQ => rw [map_add, map_add, hP, hQ, mul_add]
  | smul a P _ hP => rw [map_smul, map_smul, hP, mul_smul_comm]

theorem cut_tDeg_le_V (M k : ℕ) :
    (tDeg k).map (cut (· ≤ M)).toLinearMap ≤ InclLead.V M k := by
  rw [tDeg, Submodule.map_span_le]
  rintro _ ⟨l, hl, rfl⟩
  rw [AlgHom.toLinearMap_apply, cut_listProd]
  split_ifs with h
  · exact Submodule.subset_span ⟨l, hl, h, rfl⟩
  · exact Submodule.zero_mem _

theorem cut_lt_zero_tDeg {k : ℕ} (hk : 1 ≤ k) {F : TPoly} (hF : F ∈ tDeg k) :
    cut (· < 0) F = 0 := by
  induction hF using Submodule.span_induction with
  | mem P hP =>
    obtain ⟨l, hl, rfl⟩ := hP
    rw [cut_listProd, if_neg]
    intro h
    obtain ⟨x, hx⟩ := List.exists_mem_of_length_pos (by omega : 0 < l.length)
    exact absurd (h x hx) (Nat.not_lt_zero _)
  | zero => simp
  | add P Q _ _ hP hQ => rw [map_add, hP, hQ, add_zero]
  | smul a P _ hP => rw [map_smul, hP, smul_zero]

/-! ### Letters-only sharpness for `tDeg` -/

set_option synthInstance.maxHeartbeats 400000 in
-- The dual numbers over `Cq[s]` make instance search expensive (as in `TwoSeriesInclLow`).
set_option maxHeartbeats 1600000 in
-- The same unification through `TrivSqZeroExt` over `Cq[s]` needs the larger budget.
/-- The `ε s^D` coefficients (`D ≥ r`) of `chi` vanish when the letters-only test holds. -/
theorem coeff_theta_eq_zero_free {N r k : ℕ} {F : TPoly} (hF : F ∈ tDeg k)
    (hL : aeval tco F * X (1, 0) ^ (2 * N) ∈ Lpoly ^ r) {D : ℕ} (hD : r ≤ D) :
    (TrivSqZeroExt.snd (InclLead.theta Aco Bco F)).coeff D = 0 := by
  have hW : chi (aeval tco F * X (1, 0) ^ (2 * N)) ∈ W r := chi_Lpoly_pow r hL
  have hg : (fun m => chi (tco m)) = fun m =>
      TrivSqZeroExt.inl a2 * (TrivSqZeroExt.inl (Aco m) +
        DualNumber.eps * TrivSqZeroExt.inl (Bco m)) := funext chi_tSug
  have hchiP : chi (aeval tco F) = (TrivSqZeroExt.inl a2 : DP) ^ k * InclLead.theta Aco Bco F := by
    rw [MvPolynomial.comp_aeval_apply, hg, aeval_mul_tDeg _ _ hF]
    rfl
  rw [map_mul, map_pow, chi_v0, one_pow, mul_one, hchiP] at hW
  have h0 := coeff_eq_zero_of_mem_W hW hD
  rw [TrivSqZeroExt.inl_pow, TrivSqZeroExt.snd_mul, TrivSqZeroExt.snd_inl, smul_zero, add_zero,
    TrivSqZeroExt.fst_inl, smul_eq_mul, a2, ← map_pow, Polynomial.coeff_C_mul, ← pow_mul] at h0
  exact (mul_eq_zero.mp h0).resolve_left (pow_ne_zero _ (X_ne_zero _))

/-- **Letters-only sharpness** for polynomials homogeneous in the `T`-degree. -/
theorem vars_lt_of_free {N k : ℕ} {F : TPoly} (hF : F ∈ tDeg k)
    (hL : aeval tco F * X (1, 0) ^ (2 * N) ∈ Lpoly ^ (N + k)) : ∀ m ∈ F.vars, m < N := by
  by_contra hcon
  push Not at hcon
  obtain ⟨m0, hm0, hm0N⟩ := hcon
  have hne : F.vars.Nonempty := ⟨m0, hm0⟩
  have hMmem : F.vars.max' hne ∈ F.vars := Finset.max'_mem _ _
  have hMle : ∀ m ∈ F.vars, m ≤ F.vars.max' hne := fun m hm => Finset.le_max' _ _ hm
  have hNM : N ≤ F.vars.max' hne := le_trans hm0N (hMle m0 hm0)
  have hFV : F ∈ InclLead.V (F.vars.max' hne) k := by
    have := cut_tDeg_le_V (F.vars.max' hne) k (Submodule.mem_map.mpr ⟨F, hF, rfl⟩)
    rwa [AlgHom.toLinearMap_apply, cut_eq_self (fun m hm => hMle m hm)] at this
  obtain ⟨-, hlead⟩ :=
    InclLead.lead_span Aco Bco natDegree_Aco natDegree_Bco coeff_Bco hFV
  have h0 : piA ((TrivSqZeroExt.snd (InclLead.theta Aco Bco F)).coeff
      (k + F.vars.max' hne)) = 0 := by
    rw [coeff_theta_eq_zero_free hF hL (by omega), map_zero]
  rw [hlead, map_mul, map_pow, map_neg, map_one] at h0
  have hsq : piA (aeval (InclLead.sb Aco) (pderiv (F.vars.max' hne) F)) =
      InclLead.sqMap (pderiv (F.vars.max' hne) F) := by
    rw [MvPolynomial.comp_aeval_apply, InclLead.sqMap]
    exact congrArg (fun g : ℕ → MvPolynomial ℕ ℂ => aeval g (pderiv (F.vars.max' hne) F))
      (funext piA_sb)
  rw [hsq] at h0
  have hpd : InclLead.sqMap (pderiv (F.vars.max' hne) F) = 0 :=
    (mul_eq_zero.mp h0).resolve_left (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
  exact InclLead.not_mem_vars_of_pderiv_eq_zero
    (InclLead.aeval_sq_injective (hpd.trans (map_zero _).symm)) hMmem

/-- **At `N = 0` the letters-only test forces `F = 0`.** -/
theorem eq_zero_of_free {k : ℕ} (hk : 1 ≤ k) {F : TPoly} (hF : F ∈ tDeg k)
    (hL : aeval tco F ∈ Lpoly ^ k) : F = 0 := by
  have hL' : aeval tco F * X (1, 0) ^ (2 * 0) ∈ Lpoly ^ (0 + k) := by
    rwa [mul_zero, pow_zero, mul_one, zero_add]
  rw [← cut_eq_self (S := (· < 0)) (vars_lt_of_free hF hL')]
  exact cut_lt_zero_tDeg hk hF

/-! ### Homogeneity -/

theorem tco_isHomogeneous (m : ℕ) : (tco m).IsHomogeneous 2 := by
  change (PowerSeries.coeff m testSer).IsHomogeneous 2
  rw [testSer, PowerSeries.coeff_mk]
  refine IsHomogeneous.add ?_ ?_
  · rw [jSer, map_sub]
    exact (coeff_mul_isHomogeneous (serH_dS (serH_colSer 0)) (serH_colSer 1) m).sub
      (coeff_mul_isHomogeneous (serH_colSer 0) (serH_dS (serH_colSer 1)) m)
  · rw [xSer]
    exact coeff_mul_isHomogeneous (serH_colSer 0) (serH_colSer 0) (m + 1)

theorem aeval_listProd_isHomogeneous :
    ∀ l : List ℕ, (aeval tco (l.map (X : ℕ → TPoly)).prod).IsHomogeneous (2 * l.length)
  | [] => by simpa using isHomogeneous_one (Fin 2 × ℕ) ℂ
  | x :: l => by
    rw [List.map_cons, List.prod_cons, map_mul, aeval_X, List.length_cons,
      show 2 * (l.length + 1) = 2 + 2 * l.length by ring]
    exact (tco_isHomogeneous x).mul (aeval_listProd_isHomogeneous l)

theorem aeval_tco_isHomogeneous {k : ℕ} {F : TPoly} (hF : F ∈ tDeg k) :
    (aeval tco F).IsHomogeneous (2 * k) := by
  have h : tDeg k ≤
      (homogeneousSubmodule (Fin 2 × ℕ) ℂ (2 * k)).comap (aeval tco).toLinearMap := by
    rw [tDeg, Submodule.span_le]
    rintro _ ⟨l, rfl, rfl⟩
    rw [SetLike.mem_coe, Submodule.mem_comap, AlgHom.toLinearMap_apply,
      mem_homogeneousSubmodule]
    exact aeval_listProd_isHomogeneous l
  exact (mem_homogeneousSubmodule _ _).mp (h hF)

theorem Lpoly_le_homogeneous : Lpoly ≤ homogeneousSubmodule (Fin 2 × ℕ) ℂ 2 := by
  rw [Lpoly, Submodule.span_le]
  rintro _ ⟨p, rfl⟩
  exact genSpan_le_homogeneous (letterSym_mem_genSpan _)

theorem Lpoly_pow_le_homogeneous :
    ∀ r : ℕ, Lpoly ^ r ≤ homogeneousSubmodule (Fin 2 × ℕ) ℂ (2 * r)
  | 0 => by
    intro x hx
    rw [pow_zero, Submodule.mem_one] at hx
    obtain ⟨c, rfl⟩ := hx
    rw [mem_homogeneousSubmodule, mul_zero, MvPolynomial.algebraMap_eq]
    exact isHomogeneous_C _ _
  | r + 1 => by
    rw [pow_succ, show 2 * (r + 1) = 2 * r + 2 by ring]
    exact Submodule.mul_le.mpr fun a ha b hb => homogeneousSubmodule_mul _ _
      (Submodule.mul_mem_mul (Lpoly_pow_le_homogeneous r ha) (Lpoly_le_homogeneous hb))

theorem testSer_pow_isHomogeneous : ∀ n j : ℕ,
    (PowerSeries.coeff j (testSer ^ n)).IsHomogeneous (2 * n)
  | 0, j => by
    rw [pow_zero, PowerSeries.coeff_one, mul_zero]
    split_ifs
    · exact isHomogeneous_one _ _
    · exact isHomogeneous_zero _ _ _
  | n + 1, j => by
    rw [pow_succ, PowerSeries.coeff_mul, show 2 * (n + 1) = 2 * n + 2 by ring]
    exact IsHomogeneous.sum _ _ _ fun p _ =>
      (testSer_pow_isHomogeneous n p.1).mul (tco_isHomogeneous p.2)

/-! ### The degree-`2n` part of the test ideal -/

/-- The degree-`m` component of `f * g` for `g` homogeneous of degree `m`. -/
theorem homogeneousComponent_mul_of_isHomogeneous {f g : JetPoly} {m : ℕ}
    (hg : g.IsHomogeneous m) :
    homogeneousComponent m (f * g) = MvPolynomial.C (coeff 0 f) * g := by
  conv_lhs => rw [← sum_homogeneousComponent f]
  rw [Finset.sum_mul, map_sum, Finset.sum_eq_single 0]
  · rw [homogeneousComponent_zero, homogeneousComponent_of_mem
      ((mem_homogeneousSubmodule _ _).mpr ((isHomogeneous_C _ _).mul hg)), zero_add, if_pos rfl]
  · intro i _ hi
    rw [homogeneousComponent_of_mem ((mem_homogeneousSubmodule _ _).mpr
      ((homogeneousComponent_isHomogeneous i f).mul hg)), if_neg (by omega)]
  · intro h
    exact absurd (Finset.mem_range.mpr (Nat.succ_pos _)) h

/-- **The degree-`2n` homogeneous elements of the test ideal are `ℂ`-combinations of the jets of
`(J + x̃)ⁿ`.** -/
theorem mem_span_of_mem_testIdeal {n : ℕ} {i : JetPoly} (hi : i ∈ testIdeal n)
    (hh : i.IsHomogeneous (2 * n)) :
    i ∈ Submodule.span ℂ (Set.range fun j => PowerSeries.coeff j (testSer ^ n)) := by
  have key : ∀ x ∈ testIdeal n, ∀ a : JetPoly, homogeneousComponent (2 * n) (a * x) ∈
      Submodule.span ℂ (Set.range fun j => PowerSeries.coeff j (testSer ^ n)) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hy
      intro a
      rw [homogeneousComponent_mul_of_isHomogeneous (testSer_pow_isHomogeneous n j),
        ← smul_eq_C_mul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    | zero => intro a; rw [mul_zero, map_zero]; exact Submodule.zero_mem _
    | add y z _ _ hy hz =>
      intro a; rw [mul_add, map_add]; exact add_mem (hy a) (hz a)
    | smul b y _ hy =>
      intro a; rw [smul_eq_mul, ← mul_assoc]; exact hy (a * b)
  have h1 := key i hi 1
  rwa [one_mul, homogeneousComponent_of_mem ((mem_homogeneousSubmodule _ _).mpr hh),
    if_pos rfl] at h1

/-! ### Lifting the generators -/

theorem map_aeval_tSer : PowerSeries.map (aeval tco).toRingHom tSer = testSer := by
  refine PowerSeries.ext fun m => ?_
  rw [PowerSeries.coeff_map, tSer, PowerSeries.coeff_mk]
  simp [tco]

theorem aeval_tco_coeff_pow (n j : ℕ) :
    aeval tco (PowerSeries.coeff j (tSer ^ n)) = PowerSeries.coeff j (testSer ^ n) := by
  rw [← map_aeval_tSer, ← map_pow, PowerSeries.coeff_map]
  rfl

theorem coeff_tSer_pow_mem_tDeg : ∀ n j : ℕ, PowerSeries.coeff j (tSer ^ n) ∈ tDeg n
  | 0, j => by
    rw [pow_zero, PowerSeries.coeff_one]
    split_ifs
    · exact Submodule.subset_span ⟨[], rfl, rfl⟩
    · exact Submodule.zero_mem _
  | n + 1, j => by
    rw [pow_succ, PowerSeries.coeff_mul]
    refine Submodule.sum_mem _ fun p _ => ?_
    rw [tSer, PowerSeries.coeff_mk]
    exact mul_X_mem_tDeg (coeff_tSer_pow_mem_tDeg n p.1) p.2

/-- The `ℂ`-span of the jets of `Tⁿ`. -/
def jetSpanT (n : ℕ) : Submodule ℂ TPoly :=
  Submodule.span ℂ (Set.range fun j => PowerSeries.coeff j (tSer ^ n))

theorem jetSpanT_le_tDeg (n : ℕ) : jetSpanT n ≤ tDeg n := by
  rw [jetSpanT, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  exact coeff_tSer_pow_mem_tDeg n j

theorem jetSpanT_le_jetIdealT (n : ℕ) : jetSpanT n ≤ (jetIdealT n).restrictScalars ℂ := by
  rw [jetSpanT, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  exact Ideal.subset_span ⟨j, rfl⟩

theorem map_jetSpanT (n : ℕ) :
    (jetSpanT n).map (aeval tco).toLinearMap =
      Submodule.span ℂ (Set.range fun j => PowerSeries.coeff j (testSer ^ n)) := by
  rw [jetSpanT, Submodule.map_span, ← Set.range_comp]
  congr 1
  ext x
  simp only [Set.mem_range, Function.comp_apply, AlgHom.toLinearMap_apply, aeval_tco_coeff_pow]

/-! ### The diagonal slot -/

/-- **`BoxInclusionTail n n` for every `n ≥ 1`**: the only tail slot at `r = n` is `N = 0`, and
there the test forces `τ = 0`. -/
theorem boxInclusionTail_diag (n : ℕ) (hn : 1 ≤ n) : BoxInclusionTail n n := by
  intro d N hN _ τ hτT
  obtain ⟨hτ, hT⟩ := hτT
  obtain rfl : N = 0 := by omega
  rw [Nat.sub_zero] at hτ ⊢
  rw [tMonW_Rn_eq] at hτ
  obtain ⟨F, hF, rfl⟩ := Submodule.mem_map.mp hτ
  rw [AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk] at hT ⊢
  rw [SetLike.mem_coe, mem_testSp, ψn_mk, ← map_pow, ← map_mul, testLetters_eq,
    ← Submodule.map_pow] at hT
  obtain ⟨y, hy, hyP⟩ := hT
  rw [AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq, mul_zero, pow_zero,
    mul_one] at hyP
  have hFd : F ∈ tDeg n := tMonW_le_tDeg _ _ hF
  have hhom : (y - aeval tco F).IsHomogeneous (2 * n) :=
    ((mem_homogeneousSubmodule _ _).mp (Lpoly_pow_le_homogeneous n hy)).sub
      (aeval_tco_isHomogeneous hFd)
  have hspan := mem_span_of_mem_testIdeal hyP hhom
  rw [← map_jetSpanT] at hspan
  obtain ⟨G, hG, hGi⟩ := Submodule.mem_map.mp hspan
  rw [AlgHom.toLinearMap_apply] at hGi
  have hFG : aeval tco (F + G) ∈ Lpoly ^ n := by
    rw [map_add, hGi, add_sub_cancel]
    exact hy
  have h0 := eq_zero_of_free hn (add_mem hFd (jetSpanT_le_tDeg n hG)) hFG
  have hFI : F ∈ jetIdealT n := by
    rw [eq_neg_of_add_eq_zero_left h0]
    exact neg_mem (jetSpanT_le_jetIdealT n hG)
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr hFI]
  exact Submodule.zero_mem _

/-- **`BoxInclusion n r` for every `r ≤ n`.** -/
theorem boxInclusion_of_le {n r : ℕ} (hn : 1 ≤ n) (hr : r ≤ n) : BoxInclusion n r := by
  rcases Nat.lt_or_ge r n with h | h
  · exact boxInclusion_of_lt h
  · obtain rfl : r = n := le_antisymm hr h
    exact boxInclusion_of_tail (boxInclusionTail_diag r hn)

theorem boxSingularTail_of_le {n r : ℕ} (hn : 1 ≤ n) (hr : r ≤ n) : BoxSingularTail n r := by
  rcases Nat.lt_or_ge r n with h | h
  · exact boxSingularTail_of_inclTail (boxInclusionTail_of_lt h)
  · obtain rfl : r = n := le_antisymm hr h
    exact boxSingularTail_of_inclTail (boxInclusionTail_diag r hn)

end SingTailDiag

open SingTailDiag

/-- **Affine GU ⇒ GU of `M(2, 2n+3)`**, `#print axioms`-clean, conditional only on `hA`,
detection `det` and the ideal-elimination input `SingularLift n r` for `r > n`. -/
theorem twoSeries_gradedUnitary_of_strictModel_singularLift_gt (n : ℕ) (hn : 1 ≤ n)
    (hA : GradedUnitary (affineForm (twoSeriesLevels n)) (affineRealStructure (twoSeriesLevels n))
      (affineFlag (twoSeriesLevels n)))
    (det : TwoSeriesModelDetects n) (lift : ∀ r, n < r → SingularLift n r) :
    VirGradedUnitary (twoSeriesLevels n).c (targetRealStructure (twoSeriesLevels n)) :=
  twoSeries_gradedUnitary_of_strictModel_singular n hn hA det fun r =>
    if h : n < r then boxSingularTail_of_singularLift (lift r h)
    else boxSingularTail_of_le hn (by omega)

end

end VOA.TwoSeries.StrictModel
