import VOA.Examples.InvariantSymbolCyclic
import Mathlib.Algebra.MvPolynomial.PDeriv

/-!
# The oscillator realization of the Cartan modes, and the pairing as a constant term

In the charge-`r` sector `C[a_1, a_2, …] e^{rα}` of the level-one lattice module, the positive
Cartan modes act by `h_{m} = 2m ∂/∂a_m` (`m ≥ 1`). Variables are indexed by `i : ℕ` standing
for the mode `i + 1`, as in `InvariantSymbolCyclic`.

* `oscGen i = 2(i+1) ∂/∂a_i` and `oscGen_comm` (the generators commute);
* `oscD : C[H_1, H_2, …] →ₐ End C[a_1, a_2, …]`, `H_{i+1} ↦ oscGen i`
  (`F ↦ F(2∂_{a_1}, 4∂_{a_2}, …)`);
* `oscD_monomial_monomial` — the explicit action on monomials;
* `constantCoeff_oscD` — **the pairing is a constant term**:
  `constantCoeff (F(2∂_{a_1}, 4∂_{a_2}, …) P) = modePairing F P` for all `F`, `P`
  (no homogeneity needed).

Everything is proved outright.
-/

namespace VOA.CyclicEval

open MvPolynomial VOA.InvariantSymbol
open scoped BigOperators

noncomputable section

/-- `2(i+1) ∂/∂a_i`, the action of the Cartan mode `h_{i+1}` on the oscillators. -/
def oscGen (i : ℕ) : Module.End ℂ (MvPolynomial ℕ ℂ) :=
  (2 * ((i : ℂ) + 1)) • (pderiv i).toLinearMap

theorem oscGen_apply (i : ℕ) (P : MvPolynomial ℕ ℂ) :
    oscGen i P = (2 * ((i : ℂ) + 1)) • pderiv i P := rfl

theorem pderiv_pderiv_comm (i j : ℕ) (P : MvPolynomial ℕ ℂ) :
    pderiv i (pderiv j P) = pderiv j (pderiv i P) := by
  classical
  induction P using MvPolynomial.induction_on' with
  | monomial s a =>
    simp only [pderiv_monomial]
    by_cases hij : i = j
    · subst hij; rfl
    · congr 1
      · rw [tsub_right_comm]
      · have h1 : (s - Finsupp.single j 1 : ℕ →₀ ℕ) i = s i := by
          simp [Ne.symm hij]
        have h2 : (s - Finsupp.single i 1 : ℕ →₀ ℕ) j = s j := by
          simp [hij]
        rw [h1, h2]; ring
  | add p q hp hq => simp only [map_add, hp, hq]

theorem oscGen_comm (i j : ℕ) : oscGen i * oscGen j = oscGen j * oscGen i := by
  refine LinearMap.ext fun P => ?_
  change oscGen i (oscGen j P) = oscGen j (oscGen i P)
  rw [oscGen_apply, oscGen_apply, oscGen_apply, oscGen_apply, Derivation.map_smul,
    Derivation.map_smul, smul_smul, smul_smul, mul_comm (2 * ((i : ℂ) + 1)),
    pderiv_pderiv_comm i j]

/-- The set of oscillator generators. -/
def oscSet : Set (Module.End ℂ (MvPolynomial ℕ ℂ)) := Set.range oscGen

theorem oscSet_comm : ∀ a ∈ oscSet, ∀ b ∈ oscSet, a * b = b * a := by
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
  exact oscGen_comm i j

/-- The commutative algebra generated by the oscillator generators. -/
abbrev OscAlg : Subalgebra ℂ (Module.End ℂ (MvPolynomial ℕ ℂ)) := Algebra.adjoin ℂ oscSet

instance oscAlg_isMulCommutative : IsMulCommutative OscAlg :=
  Algebra.isMulCommutative_adjoin ℂ oscSet_comm

open scoped IsMulCommutative

/-- `F ↦ F(2∂_{a_1}, 4∂_{a_2}, 6∂_{a_3}, …)`. -/
def oscD : MvPolynomial ℕ ℂ →ₐ[ℂ] Module.End ℂ (MvPolynomial ℕ ℂ) :=
  OscAlg.val.comp (aeval fun i => (⟨oscGen i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ : OscAlg))

@[simp] theorem oscD_X (i : ℕ) : oscD (X i) = oscGen i := by
  simp [oscD]

/-- `∂_i^k a^γ = γ_i (γ_i - 1) ⋯ (γ_i - k + 1) a^{γ - k e_i}`. -/
theorem pderiv_pow_monomial (i k : ℕ) (γ : ℕ →₀ ℕ) (c : ℂ) :
    ((pderiv i).toLinearMap ^ k) (monomial γ c) =
      monomial (γ - Finsupp.single i k) (c * ((γ i).descFactorial k : ℂ)) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply, ih]
    change pderiv i _ = _
    rw [pderiv_monomial]
    congr 1
    · rw [tsub_tsub, ← Finsupp.single_add]
    · have : (γ - Finsupp.single i k) i = γ i - k := by simp [Finsupp.tsub_apply]
      rw [this, Nat.descFactorial_succ]
      push_cast
      ring

theorem oscGen_pow_monomial (i k : ℕ) (γ : ℕ →₀ ℕ) (c : ℂ) :
    (oscGen i ^ k) (monomial γ c) =
      monomial (γ - Finsupp.single i k)
        (c * ((2 * ((i : ℂ) + 1)) ^ k * ((γ i).descFactorial k : ℂ))) := by
  rw [oscGen, smul_pow, LinearMap.smul_apply, pderiv_pow_monomial, smul_monomial]
  congr 1
  rw [smul_eq_mul]; ring

/-- The scalar of `oscD (a^α) a^β`. -/
def oscK (α β : ℕ →₀ ℕ) : ℂ :=
  α.prod fun i k => (2 * ((i : ℂ) + 1)) ^ k * ((β i).descFactorial k : ℂ)

theorem oscK_self (α : ℕ →₀ ℕ) : oscK α α = pairConst α := by
  unfold oscK pairConst
  refine Finset.prod_congr rfl fun i _ => ?_
  simp only [Nat.descFactorial_self]

theorem oscK_eq_zero {α β : ℕ →₀ ℕ} (h : ¬ α ≤ β) : oscK α β = 0 := by
  classical
  obtain ⟨i, hi⟩ : ∃ i, β i < α i := by
    by_contra hc
    push Not at hc
    exact h fun i => hc i
  unfold oscK Finsupp.prod
  refine Finset.prod_eq_zero (i := i) (Finsupp.mem_support_iff.mpr (by omega)) ?_
  simp only [(Nat.descFactorial_eq_zero_iff_lt).mpr hi, Nat.cast_zero, mul_zero]

/-- The explicit action of a monomial differential operator on a monomial. -/
theorem oscD_monomial_monomial (α β : ℕ →₀ ℕ) :
    oscD (monomial α 1) (monomial β 1) = monomial (β - α) (oscK α β) := by
  classical
  induction α using Finsupp.induction with
  | zero => simp [oscK]
  | single_add a b f ha hb ih =>
    have hfa : f a = 0 := Finsupp.notMem_support_iff.mp ha
    have hmon : (monomial (Finsupp.single a b + f) (1 : ℂ)) = X a ^ b * monomial f 1 := by
      rw [X_pow_eq_monomial, monomial_mul, one_mul]
    rw [hmon, map_mul, map_pow, oscD_X, Module.End.mul_apply, ih, oscGen_pow_monomial]
    congr 1
    · rw [tsub_tsub, add_comm f]
    · have hdisj : Disjoint (Finsupp.single a b).support f.support := by
        rw [Finsupp.support_single _ hb, Finset.disjoint_singleton_left]
        exact ha
      have hsplit : oscK (Finsupp.single a b + f) β =
          oscK (Finsupp.single a b) β * oscK f β := by
        unfold oscK
        exact Finsupp.prod_add_index_of_disjoint hdisj _
      have hsingle : oscK (Finsupp.single a b) β =
          (2 * ((a : ℂ) + 1)) ^ b * ((β a).descFactorial b : ℂ) := by
        unfold oscK
        rw [Finsupp.prod_single_index (by simp)]
      have hβa : (β - f) a = β a := by simp [Finsupp.tsub_apply, hfa]
      rw [hsplit, hsingle, hβa]
      ring

theorem constantCoeff_smul' (c : ℂ) (P : MvPolynomial ℕ ℂ) :
    constantCoeff (c • P) = c * constantCoeff P := by
  rw [smul_eq_C_mul, map_mul, constantCoeff_C]

theorem constantCoeff_oscD_monomial (α : ℕ →₀ ℕ) (c : ℂ) (P : MvPolynomial ℕ ℂ) :
    constantCoeff (oscD (monomial α c) P) = c * coeff α P * pairConst α := by
  classical
  have hc : monomial α c = c • monomial α (1 : ℂ) := by rw [smul_monomial, smul_eq_mul, mul_one]
  rw [hc, map_smul, LinearMap.smul_apply, constantCoeff_smul', mul_assoc]
  congr 1
  induction P using MvPolynomial.induction_on' with
  | monomial β d =>
    have hd : monomial β d = d • monomial β (1 : ℂ) := by
      rw [smul_monomial, smul_eq_mul, mul_one]
    rw [hd, map_smul, constantCoeff_smul', oscD_monomial_monomial, coeff_smul, smul_eq_mul,
      constantCoeff_monomial, coeff_monomial]
    by_cases hαβ : α = β
    · subst hαβ
      rw [tsub_self, if_pos rfl, if_pos rfl, oscK_self]; ring
    · rw [if_neg (Ne.symm hαβ)]
      by_cases h0 : β - α = 0
      · have hle : ¬ α ≤ β := fun hle =>
          hαβ (le_antisymm hle (tsub_eq_zero_iff_le.mp h0))
        rw [if_pos h0, oscK_eq_zero hle]; ring
      · rw [if_neg h0]; ring
  | add p q hp hq => rw [map_add, map_add, hp, hq, coeff_add]; ring

/-- **The pairing is the constant term of the differential action**:
`constantCoeff (F(2∂_{a_1}, 4∂_{a_2}, …) P) = ⟨F, P⟩`. -/
theorem constantCoeff_oscD (F P : MvPolynomial ℕ ℂ) :
    constantCoeff (oscD F P) = modePairing F P := by
  induction F using MvPolynomial.induction_on' with
  | monomial α c =>
    rw [constantCoeff_oscD_monomial]
    have hc : monomial α c = c • monomial α (1 : ℂ) := by
      rw [smul_monomial, smul_eq_mul, mul_one]
    rw [hc, map_smul, LinearMap.smul_apply, modePairing_monomial, smul_eq_mul]; ring
  | add p q hp hq => rw [map_add, LinearMap.add_apply, map_add, hp, hq, map_add,
      LinearMap.add_apply]

end

end VOA.CyclicEval
