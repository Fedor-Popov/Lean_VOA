import VOA.Examples.VirasoroSimple
import VOA.Core.DeformationReconstruction

/-!
# Conformal generation and first-order reconstruction for simple Virasoro algebras

The ordinary simple Virasoro algebra is generated by its conformal vector.
This file proves that fact directly from creation-word spanning and uses it to
make the reconstruction carrier concrete, uniformly in the central charge.

The pure conformal lift is a choice of normalization. Its generated carrier need
not exclude the pure first-order vacuum for an arbitrary deformation, even for
a trivial deformation in other coordinates. Proving separation after the right
gauge choice and the deformation-to-determinant bridge are still open. No
minimal-model rigidity theorem is asserted here.
-/
namespace VOA.VirDeformReconstruction
open VirModule VirSimple Deform.Reconstruction
variable (c : ℂ)

/-- Modes of the conformal vector generate every state of the simple Virasoro
algebra: lift to the universal vacuum module and use creation-word spanning. -/
theorem virasoroSimple_modeGenerating :
    ModeGenerating (virasoroSimple c) {(virasoroSimple c).conformalVector} := by
  intro S hvac _hgens hclosed
  have hword (l : List ℕ) : (maxIdealVir c).mkQ (negWordVir c l) ∈ S := by
    induction l with
    | nil => simpa [negWordVir_nil, virasoroSimple_vacuum] using hvac
    | cons n l ih =>
      have h := hclosed _ (Set.mem_singleton _) _ ih (-(n : ℤ) - 1)
      rw [virasoroSimple_conformalVector, virasoroSimple_mkQ_smul] at h
      change (maxIdealVir c).mkQ (mode (virYA c (omegaVir c))
        (-(n : ℤ) - 1) (negWordVir c l)) ∈ S at h
      rw [virYA_omega, mode_YomegaVir] at h
      simpa only [negWordVir_cons, show -(n : ℤ) - 1 - 1 = -(n : ℤ) - 2 by omega] using h
  have hpre : S.comap (maxIdealVir c).mkQ = ⊤ := by
    apply top_unique
    rw [← negSpanVir_eq_top c]
    apply Submodule.span_le.mpr
    rintro _ ⟨l, rfl⟩
    exact hword l
  apply top_unique
  intro x _
  obtain ⟨v, rfl⟩ := (maxIdealVir c).mkQ_surjective x
  change v ∈ S.comap (maxIdealVir c).mkQ
  rw [hpre]
  trivial

/-- Every ordinary Virasoro state has a lift in the explicit carrier generated
by the pure conformal lift, with no assumption on the deformation. -/
theorem virasoroSimple_generatedCarrier_surjective
    (D : Deform.FirstOrderDeformation (virasoroSimple c)) :
    Function.Surjective (reduction
      (generatedCarrier D {(virasoroSimple c).conformalVector})) :=
  generatedCarrier_surjective D _ (virasoroSimple_modeGenerating c)

/-- Invert the carrier's projection once its pure first-order vacuum is excluded.
Separation is an explicit unresolved input, not a conclusion of generation. -/
theorem virasoroSimple_isTrivial_of_generated_separation
    (D : Deform.FirstOrderDeformation (virasoroSimple c))
    (hsep : (0, (virasoroSimple c).vacuum) ∉
      generatedCarrier D {(virasoroSimple c).conformalVector}) : D.IsTrivial :=
  isTrivial_of_generated_separation D _ (virasoroSimple_isSimple c)
    (virasoroSimple_modeGenerating c) hsep

end VOA.VirDeformReconstruction
