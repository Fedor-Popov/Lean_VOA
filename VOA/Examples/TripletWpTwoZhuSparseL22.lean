import VOA.Examples.TripletWpTwoZhuSparseCompute

/-! # Exact sparse certificate for the two `L(-2)^2 1` Zhu circles -/

namespace VOA.LatGen.WpTwoZhuSparseCompute

open VOA.SparseRational
open VOA.LatGen.WpTwoAMSparseCompute

set_option maxRecDepth 100000

def vir22ExpectedQ : SparseRational.Poly ℕ :=
  [([0, 0, 0, 0], 1 / 64), ([0, 0, 1], 1 / 16), ([0, 2], 1 / 4),
   ([1, 1], 1 / 16), ([3], 1 / 2)]

def vir3ExpectedQ : SparseRational.Poly ℕ :=
  [([0, 1], 1 / 4), ([2], 1 / 2)]

def vir32ExpectedQ : SparseRational.Poly ℕ :=
  [([0, 0, 0, 1], 1 / 32), ([0, 0, 2], 1 / 16),
   ([0, 1, 1], 1 / 16), ([0, 3], 1 / 4), ([1, 2], 1 / 8), ([4], 1 / 2)]

theorem reifyVir22SparseQ_eq_expected :
    reifyVirWordSparseQ [2, 2] = vir22ExpectedQ := by
  norm_num (config := { maxSteps := 500000 })
    [reifyVirWordSparseQ, virActSparseQ, virVacuumSparseQ, virShiftRawQ,
    mulSparseQ, vacuumSparseQ, vir22ExpectedQ, bindQ, sumQ, addQ, scaleQ,
    normalizeQ, insertQ, sortWord, insertVar, insertSorted, compareWord,
    List.range_succ, List.range_zero, List.map_cons, List.map_nil,
    Function.comp_apply]

theorem reifyVir3SparseQ_eq_expected :
    reifyVirWordSparseQ [3] = vir3ExpectedQ := by
  norm_num (config := { maxSteps := 500000 })
    [reifyVirWordSparseQ, virActSparseQ, virVacuumSparseQ, virShiftRawQ,
    mulSparseQ, vacuumSparseQ, vir3ExpectedQ, bindQ, sumQ, addQ, scaleQ,
    normalizeQ, insertQ, sortWord, insertVar, insertSorted, compareWord,
    List.range_succ, List.range_zero, List.map_cons, List.map_nil,
    Function.comp_apply]

theorem reifyVir32SparseQ_eq_expected :
    reifyVirWordSparseQ [3, 2] = vir32ExpectedQ := by
  norm_num (config := { maxSteps := 500000 })
    [reifyVirWordSparseQ, virActSparseQ, virVacuumSparseQ, virShiftRawQ,
    mulSparseQ, vacuumSparseQ, vir32ExpectedQ, bindQ, sumQ, addQ, scaleQ,
    normalizeQ, insertQ, sortWord, insertVar, insertSorted, compareWord,
    List.range_succ, List.range_zero, List.map_cons, List.map_nil,
    Function.comp_apply]

