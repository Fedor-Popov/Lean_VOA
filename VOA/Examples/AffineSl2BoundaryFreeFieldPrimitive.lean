import VOA.Examples.AffineSl2BoundaryMaximalIdeal
import VOA.Examples.InverseDSHalfLatticeScreening
import VOA.Examples.InverseDSSimpleQuotientGate

/-!
# The free-field form of the affine primitive-vector gate

This file compares the last representation-theoretic input in the boundary affine `sl₂`
campaign with the already formalized Adamović inverse-DS/free-field evaluation.

If a concrete current realization kills a displayed affine singular vector `s`, its universal
evaluation descends to `V^k(sl₂)/(s)`.  The descended map is injective exactly when the
free-field kernel is *no larger* than the ideal generated by `s`.  Thus a finite check that the
displayed singular vector vanishes is not enough: possible quotient-level subsingular vectors
are precisely the possible kernel of the descended map.

The second part packages primitive vectors in the free-field carrier and proves one direction
of the expected comparison: an injective descended realization, together with the statement
that the affine primitives in its image form the vacuum line, implies that the source singular
quotient has no non-vacuum affine primitives.  Conversely, source primitive uniqueness and a
nonzero target vacuum force the descended realization to be injective.  The converse uses the
internally proved positive-energy primitive-existence theorem.

Consequently, once primitive rigidity of the concrete Adamović screening-kernel image is
available, source primitive uniqueness is equivalent to strict free-field descent.  This
isolates the exact remaining free-field theorem; it does not install it as an axiom.
-/

namespace VOA
namespace AffineSl2BoundaryFreeFieldPrimitive

open VertexOperatorAlgebra
open AffineLie
open AffineVOA
open AffineVOA.Inst
open SingVec
open AffineSl2BoundaryMaximalIdeal

noncomputable section

universe u

variable {k : ℂ} (hk : k + 2 ≠ 0)
variable {E : Type u} [AddCommGroup E] [Module ℂ E]

private abbrev W : VertexOperatorAlgebra (WakModule k) := affineSl2VOA_closed k hk

/-- The displayed singular ideal is exactly the kernel of a concrete current realization.
This is the algebraic "strict intersection" statement needed from a free-field construction. -/
def SingularIdealIsFreeFieldKernel (R : VacuumCurrentRealization k E) (s : WakModule k) : Prop :=
  idealGen (W hk) s = LinearMap.ker R.eval

/-- The current realization induced on the quotient by the displayed singular vector is
faithful. -/
def SingularQuotientFreeFieldFaithful (R : VacuumCurrentRealization k E)
    {s : WakModule k} (hs : R.eval s = 0) : Prop :=
  Function.Injective (InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs)

/-- **Strict-descent equivalence.**  Once the displayed singular vector vanishes, faithfulness
of the induced free-field map is exactly equality between the generated singular ideal and the
kernel of universal evaluation. -/
theorem singularQuotientFreeFieldFaithful_iff_kernel
    (R : VacuumCurrentRealization k E) {s : WakModule k} (hs : R.eval s = 0) :
    SingularQuotientFreeFieldFaithful hk R hs ↔
      SingularIdealIsFreeFieldKernel hk R s := by
  rw [SingularQuotientFreeFieldFaithful, SingularIdealIsFreeFieldKernel,
    ← LinearMap.ker_eq_bot]
  constructor
  · intro hinj
    have hinj' : Function.Injective
        (InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs) :=
      LinearMap.ker_eq_bot.mp hinj
    apply le_antisymm
    · exact InverseDS.AffineEvaluation.singularIdeal_le_eval_ker R hk hs
    · intro x hx
      have hzero : InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs
          ((idealGen (W hk) s).mkQ x) = 0 := by
        rw [InverseDS.AffineEvaluation.evalQuotientBySingular_mkQ,
          LinearMap.mem_ker.mp hx]
      have hmk : (idealGen (W hk) s).mkQ x = 0 := by
        apply hinj'
        simpa using hzero
      exact (Submodule.Quotient.mk_eq_zero _).mp hmk
  · intro hker
    exact Submodule.ker_liftQ_eq_bot _ _ _ (le_of_eq hker.symm)

/-! ## A conformal-character criterion for strict descent -/

/-- The part of the concrete free-field image produced by homogeneous universal affine states
of conformal weight `n`.  This definition does not require an independently constructed grading
on the ambient Fock carrier. -/
def FreeFieldImageGrade (R : VacuumCurrentRealization k E) (n : ℤ) : Submodule ℂ E :=
  ((W hk).grading n).map R.eval

/-- The conformal-weight-`n` piece of the quotient by the displayed singular ideal, realized as
the image of the ambient weight space under the quotient map. -/
def SingularQuotientGrade (s : WakModule k) (n : ℤ) :
    Submodule ℂ (WakModule k ⧸ idealGen (W hk) s) :=
  ((W hk).grading n).map (idealGen (W hk) s).mkQ

/-- Grade-by-grade equality of the displayed singular-quotient character with the character of
the concrete free-field image.  The target side uses only the affine-generated image pieces, so
no finite-dimensionality or direct-sum grading of the full Fock carrier is assumed. -/
def SingularQuotientHasFreeFieldImageCharacter
    (R : VacuumCurrentRealization k E) (s : WakModule k) : Prop :=
  ∀ n : ℤ,
    Module.finrank ℂ (SingularQuotientGrade hk s n) =
      Module.finrank ℂ (FreeFieldImageGrade hk R n)

/-- Restricting a linear map to a finite-dimensional ambient piece gives the usual
rank--nullity identity, with the kernel identified with the ambient kernel intersection. -/
private theorem finrank_imageGrade_add_finrank_kernel_inf
    (R : VacuumCurrentRealization k E) (n : ℤ) :
    Module.finrank ℂ (FreeFieldImageGrade hk R n) +
        Module.finrank ℂ ↑(LinearMap.ker R.eval ⊓ (W hk).grading n) =
      Module.finrank ℂ ((W hk).grading n) := by
  letI : FiniteDimensional ℂ ((W hk).grading n) := (W hk).finrank n
  let f : (W hk).grading n →ₗ[ℂ] E := R.eval.domRestrict ((W hk).grading n)
  have hrank := LinearMap.finrank_range_add_finrank_ker f
  have hrange : LinearMap.range f = FreeFieldImageGrade hk R n := by
    simpa [f, FreeFieldImageGrade] using LinearMap.range_domRestrict R.eval ((W hk).grading n)
  have hker : (LinearMap.ker f).map ((W hk).grading n).subtype =
      LinearMap.ker R.eval ⊓ (W hk).grading n := by
    simp only [f, LinearMap.ker_domRestrict, Submodule.map_comap_subtype, inf_comm]
  have hkerRank : Module.finrank ℂ (LinearMap.ker f) =
      Module.finrank ℂ ↑(LinearMap.ker R.eval ⊓ (W hk).grading n) := by
    rw [← hker]
    exact LinearEquiv.finrank_eq
      (Submodule.equivMapOfInjective ((W hk).grading n).subtype
        (Submodule.subtype_injective _) _)
  rwa [hrange, hkerRank] at hrank

/-- Rank--nullity for one conformal grade of an arbitrary linear quotient. -/
private theorem finrank_quotientGrade_add_finrank_inf
    (P : Submodule ℂ (WakModule k)) (n : ℤ) :
    Module.finrank ℂ (((W hk).grading n).map P.mkQ) +
        Module.finrank ℂ ↑(P ⊓ (W hk).grading n) =
      Module.finrank ℂ ((W hk).grading n) := by
  letI : FiniteDimensional ℂ ((W hk).grading n) := (W hk).finrank n
  let f : (W hk).grading n →ₗ[ℂ] (WakModule k ⧸ P) :=
    P.mkQ.domRestrict ((W hk).grading n)
  have hrank := LinearMap.finrank_range_add_finrank_ker f
  have hrange : LinearMap.range f = ((W hk).grading n).map P.mkQ := by
    simpa [f] using LinearMap.range_domRestrict P.mkQ ((W hk).grading n)
  have hker : (LinearMap.ker f).map ((W hk).grading n).subtype =
      P ⊓ (W hk).grading n := by
    simp only [f, LinearMap.ker_domRestrict, Submodule.ker_mkQ,
      Submodule.map_comap_subtype, inf_comm]
  have hkerRank : Module.finrank ℂ (LinearMap.ker f) =
      Module.finrank ℂ ↑(P ⊓ (W hk).grading n) := by
    rw [← hker]
    exact LinearEquiv.finrank_eq
      (Submodule.equivMapOfInjective ((W hk).grading n).subtype
        (Submodule.subtype_injective _) _)
  rwa [hrange, hkerRank] at hrank

/-- **Finite-grade strictness certificate.**  A dimension match in one conformal grade proves
that the displayed singular ideal and the free-field kernel agree in that grade.  This is the
exact theorem consumed by finite computer experiments; no extrapolation to uncomputed grades is
made. -/
theorem singularIdeal_inf_grading_eq_evalKernel_inf_grading_of_finrank
    (R : VacuumCurrentRealization k E) {s : WakModule k} (hs : R.eval s = 0) (n : ℤ)
    (hchar : Module.finrank ℂ (SingularQuotientGrade hk s n) =
      Module.finrank ℂ (FreeFieldImageGrade hk R n)) :
    idealGen (W hk) s ⊓ (W hk).grading n =
      LinearMap.ker R.eval ⊓ (W hk).grading n := by
  let P := idealGen (W hk) s
  let Q := LinearMap.ker R.eval
  have hPQ : P ≤ Q := InverseDS.AffineEvaluation.singularIdeal_le_eval_ker R hk hs
  letI : FiniteDimensional ℂ ((W hk).grading n) := (W hk).finrank n
  have hPnull :
    Module.finrank ℂ (SingularQuotientGrade hk s n) +
          Module.finrank ℂ ↑(P ⊓ (W hk).grading n) =
        Module.finrank ℂ ((W hk).grading n) := by
    simpa [P, SingularQuotientGrade] using
      finrank_quotientGrade_add_finrank_inf hk (idealGen (W hk) s) n
  have hQnull := finrank_imageGrade_add_finrank_kernel_inf hk R n
  have hinter : Module.finrank ℂ ↑(P ⊓ (W hk).grading n) =
      Module.finrank ℂ ↑(Q ⊓ (W hk).grading n) := by
    dsimp [P, Q] at hPnull hQnull ⊢
    omega
  have hle : P ⊓ (W hk).grading n ≤ Q ⊓ (W hk).grading n :=
    inf_le_inf_right _ hPQ
  exact Submodule.eq_of_le_of_finrank_eq hle hinter

/-- **Free-field character squeeze.**  If the displayed singular vector vanishes in a concrete
current realization and its quotient has the same conformal character as the affine-generated
free-field image, then the descent is strict:

`idealGen(s) = ker(eval)`.

This is the exact grade-by-grade route available for the Adamović realization.  It needs no
simplicity assertion about the ambient Fock space; finite-dimensionality comes from the universal
affine conformal-weight spaces. -/
theorem singularIdealIsFreeFieldKernel_of_character
    (R : VacuumCurrentRealization k E) {s : WakModule k} (hs : R.eval s = 0)
    (hchar : SingularQuotientHasFreeFieldImageCharacter hk R s) :
    SingularIdealIsFreeFieldKernel hk R s := by
  let P := idealGen (W hk) s
  let Q := LinearMap.ker R.eval
  have hPQ : P ≤ Q := InverseDS.AffineEvaluation.singularIdeal_le_eval_ker R hk hs
  have hQgraded : Q = ⨆ n : ℤ, Q ⊓ (W hk).grading n :=
    QuotVOA.isGradedIdeal_of_isIdeal (InverseDS.AffineEvaluation.eval_isIdeal_ker R hk)
  apply le_antisymm hPQ
  rw [hQgraded]
  refine iSup_le fun n ↦ ?_
  have heq := singularIdeal_inf_grading_eq_evalKernel_inf_grading_of_finrank
    hk R hs n (hchar n)
  change P ⊓ (W hk).grading n = Q ⊓ (W hk).grading n at heq
  rw [← heq]
  exact inf_le_left

/-! ## Primitive vectors in a concrete current realization -/

/-- An affine primitive vector in the target of a concrete current realization.  This uses
only the affine action: all strictly positive loop modes and the horizontal raising zero mode
annihilate the vector. -/
def FreeFieldAffinePrimitive (R : VacuumCurrentRealization k E) (y : E) : Prop :=
  y ≠ 0 ∧
    (∀ (a : Fin 3) (m : ℤ), 1 ≤ m →
      R.rho (ofLoop kappaForm kappaForm_isInvariant (basis a) m) y = 0) ∧
    R.rho (ofLoop kappaForm kappaForm_isInvariant (basis colE) 0) y = 0

/-- Primitive rigidity in the part of the free-field carrier actually generated by the affine
vacuum: every affine primitive in `range R.eval` belongs to the target vacuum line.  Restricting
to the image is important; the ambient Fock space can have unrelated charged primitives. -/
def OnlyVacuumAffinePrimitivesInEvaluationImage
    (R : VacuumCurrentRealization k E) : Prop :=
  ∀ y : E, y ∈ LinearMap.range R.eval → FreeFieldAffinePrimitive R y →
    y ∈ ℂ ∙ R.vacuum

/-- The descended realization intertwines every affine current mode. -/
theorem evalQuotientBySingular_current
    (R : VacuumCurrentRealization k E) {s : WakModule k} (hs : R.eval s = 0)
    (a : Fin 3) (m : ℤ)
    (v : WakModule k ⧸ idealGen (W hk) s) :
    InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs
        ((quotientBySingular (W hk) s).smul
          ((idealGen (W hk) s).mkQ (currentState k a)) m v) =
      R.rho (ofLoop kappaForm kappaForm_isInvariant (basis a) m)
        (InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs v) := by
  obtain ⟨x, rfl⟩ := (idealGen (W hk) s).mkQ_surjective v
  rw [singularQuotient_mkQ_J, InverseDS.AffineEvaluation.evalQuotientBySingular_mkQ,
    InverseDS.AffineEvaluation.evalQuotientBySingular_mkQ, R.eval_J]

/-- The descended realization sends the quotient vacuum to the concrete free-field vacuum. -/
@[simp] theorem evalQuotientBySingular_vacuum
    (R : VacuumCurrentRealization k E) {s : WakModule k} (hs : R.eval s = 0) :
    InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs
        (quotientBySingular (W hk) s).vacuum = R.vacuum := by
  rw [quotientBySingular_vacuum,
    InverseDS.AffineEvaluation.evalQuotientBySingular_mkQ, closed_vacuum, vacuumA,
    R.eval_vacuum]

/-- Faithful free-field descent transports affine primitive vectors to nonzero affine primitive
vectors in the evaluation image. -/
theorem freeFieldAffinePrimitive_of_source
    (R : VacuumCurrentRealization k E) {s : WakModule k} (hs : R.eval s = 0)
    (hfaith : SingularQuotientFreeFieldFaithful hk R hs)
    {v : WakModule k ⧸ idealGen (W hk) s}
    (hv : SingularQuotientAffinePrimitive k hk s v) :
    FreeFieldAffinePrimitive R
      (InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs v) := by
  let f := InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs
  have hnonzero : f v ≠ 0 := by
    intro hzero
    apply hv.1
    apply hfaith
    simpa [f] using hzero
  refine ⟨hnonzero, ?_, ?_⟩
  · intro a m hm
    rw [← evalQuotientBySingular_current hk R hs a m v, hv.2.1 a m hm, map_zero]
  · rw [← evalQuotientBySingular_current hk R hs colE 0 v, hv.2.2, map_zero]

/-- **Free-field primitive criterion, forward direction.**  Strict/faithful descent plus
vacuum-line primitive rigidity in the affine image excludes every quotient-level subsingular
vector. -/
theorem onlyVacuumAffinePrimitives_of_freeField
    (R : VacuumCurrentRealization k E) {s : WakModule k} (hs : R.eval s = 0)
    (hfaith : SingularQuotientFreeFieldFaithful hk R hs)
    (htarget : OnlyVacuumAffinePrimitivesInEvaluationImage R) :
    OnlyVacuumAffinePrimitives k hk s := by
  intro v hv
  let f := InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs
  have hrange : f v ∈ LinearMap.range R.eval := by
    obtain ⟨x, rfl⟩ := (idealGen (W hk) s).mkQ_surjective v
    exact ⟨x, InverseDS.AffineEvaluation.evalQuotientBySingular_mkQ R hk hs x⟩
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp
    (htarget (f v) hrange (freeFieldAffinePrimitive_of_source hk R hs hfaith hv))
  apply Submodule.mem_span_singleton.mpr
  refine ⟨c, ?_⟩
  apply hfaith
  rw [map_smul, evalQuotientBySingular_vacuum]
  exact hc

/-- Source primitive uniqueness already forces every nonzero-vacuum free-field descent to be
faithful.  Indeed its kernel is a current submodule; if nonzero, the internal positive-energy
argument constructs a primitive in it, while vacuum-line uniqueness forces that primitive to
be a nonzero multiple of the vacuum, contradicting nonvanishing of the target vacuum. -/
theorem singularQuotientFreeFieldFaithful_of_onlyVacuumAffinePrimitives
    (R : VacuumCurrentRealization k E) (hRv : R.vacuum ≠ 0)
    {s : WakModule k} (hs : R.eval s = 0)
    (honly : OnlyVacuumAffinePrimitives k hk s) :
    SingularQuotientFreeFieldFaithful hk R hs := by
  let f := InverseDS.AffineEvaluation.evalQuotientBySingular R hk hs
  have hnonzero : (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W hk) s)) ≠ ⊥ := by
    intro htop
    apply hRv
    rw [← evalQuotientBySingular_vacuum hk R hs]
    have hvac : (quotientBySingular (W hk) s).vacuum = 0 := by
      have hm : (quotientBySingular (W hk) s).vacuum ∈
          (⊤ : Submodule ℂ (WakModule k ⧸ idealGen (W hk) s)) := Submodule.mem_top
      rw [htop, Submodule.mem_bot] at hm
      exact hm
    rw [hvac, map_zero]
  have hirr := currentIrreducible_of_onlyVacuumAffinePrimitives k hk s hnonzero honly
  rw [SingularQuotientFreeFieldFaithful, ← LinearMap.ker_eq_bot]
  rcases hirr.2 (LinearMap.ker f) (by
      intro a m x hx
      rw [LinearMap.mem_ker] at hx ⊢
      rw [evalQuotientBySingular_current hk R hs, hx, map_zero]) with hbot | htop
  · exact hbot
  · exfalso
    apply hRv
    rw [← evalQuotientBySingular_vacuum hk R hs]
    have hm : (quotientBySingular (W hk) s).vacuum ∈ LinearMap.ker f := by
      rw [htop]
      exact Submodule.mem_top
    exact LinearMap.mem_ker.mp hm

/-- With primitive rigidity in the affine free-field image and nonzero target vacuum, source
primitive uniqueness is equivalent to strict free-field descent.  This is the sharp Lean-facing
form of the remaining Adamović theorem. -/
theorem onlyVacuumAffinePrimitives_iff_freeFieldFaithful
    (R : VacuumCurrentRealization k E) (hRv : R.vacuum ≠ 0)
    {s : WakModule k} (hs : R.eval s = 0)
    (htarget : OnlyVacuumAffinePrimitivesInEvaluationImage R) :
    OnlyVacuumAffinePrimitives k hk s ↔
      SingularQuotientFreeFieldFaithful hk R hs :=
  ⟨singularQuotientFreeFieldFaithful_of_onlyVacuumAffinePrimitives hk R hRv hs,
    fun hfaith ↦ onlyVacuumAffinePrimitives_of_freeField hk R hs hfaith htarget⟩

/-- Under target primitive rigidity, the last source-side representation-theoretic gate is
literally the strict free-field kernel equality.  In particular, proving only that `s` vanishes
or only that the evaluation image is simple cannot establish this conclusion. -/
theorem onlyVacuumAffinePrimitives_iff_singularIdealIsFreeFieldKernel
    (R : VacuumCurrentRealization k E) (hRv : R.vacuum ≠ 0)
    {s : WakModule k} (hs : R.eval s = 0)
    (htarget : OnlyVacuumAffinePrimitivesInEvaluationImage R) :
    OnlyVacuumAffinePrimitives k hk s ↔
      SingularIdealIsFreeFieldKernel hk R s :=
  (onlyVacuumAffinePrimitives_iff_freeFieldFaithful hk R hRv hs htarget).trans
    (singularQuotientFreeFieldFaithful_iff_kernel hk R hs)

/-! ## The first two boundary levels -/

/-- At `k=-4/3`, a faithful free-field descent and primitive rigidity of its affine image close
the sole remaining primitive-vector gate. -/
theorem onlyVacuumAffinePrimitives43_of_freeField
    (R : VacuumCurrentRealization (-4 / 3 : ℂ) E)
    (hs : R.eval Sl2Sing.sl2Singular = 0)
    (hfaith : SingularQuotientFreeFieldFaithful admLevel_noncritical R hs)
    (htarget : OnlyVacuumAffinePrimitivesInEvaluationImage R) :
    OnlyVacuumAffinePrimitives (-4 / 3 : ℂ) admLevel_noncritical
      Sl2Sing.sl2Singular :=
  onlyVacuumAffinePrimitives_of_freeField admLevel_noncritical R hs hfaith htarget

/-- At `k=-8/5`, the same strict free-field descent criterion excludes weight-five
subsingular vectors in the quotient. -/
theorem onlyVacuumAffinePrimitives85_of_freeField
    (R : VacuumCurrentRealization (-8 / 5 : ℂ) E)
    (hs : R.eval Sl2Sing85.sl2Singular85 = 0)
    (hfaith : SingularQuotientFreeFieldFaithful Sl2Symbol85.level85_noncritical R hs)
    (htarget : OnlyVacuumAffinePrimitivesInEvaluationImage R) :
    OnlyVacuumAffinePrimitives (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical
      Sl2Sing85.sl2Singular85 :=
  onlyVacuumAffinePrimitives_of_freeField Sl2Symbol85.level85_noncritical R hs hfaith htarget

/-! ## The existing `k=-8/5` Adamović screening package -/

namespace K85

open InverseDS.HalfLattice

universe v w

variable {VirCarrier : Type u} [AddCommGroup VirCarrier] [Module ℂ VirCarrier]
variable {ShiftedVirCarrier : Type v} [AddCommGroup ShiftedVirCarrier]
  [Module ℂ ShiftedVirCarrier]
variable {ShiftedPiCarrier : Type w} [AddCommGroup ShiftedPiCarrier]
  [Module ℂ ShiftedPiCarrier]

/-- For the repository's exact `p=5` Proposition 2.1 package, primitive uniqueness in the
singular quotient is equivalent to strictness of the induced map from the displayed
weight-five singular quotient.  The package already proves that the universal free-field
kernel is the maximal ideal; it does not prove this stricter displayed-generator equality. -/
theorem onlyVacuumAffinePrimitives_iff_strictDescent
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier)
    (htarget : OnlyVacuumAffinePrimitivesInEvaluationImage D.realization) :
    OnlyVacuumAffinePrimitives (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical
        Sl2Sing85.sl2Singular85 ↔
      SingularIdealIsFreeFieldKernel Sl2Symbol85.level85_noncritical D.realization
        Sl2Sing85.sl2Singular85 :=
  onlyVacuumAffinePrimitives_iff_singularIdealIsFreeFieldKernel
    Sl2Symbol85.level85_noncritical D.realization D.vacuum_ne_zero
    D.eval_sl2Singular85_zero htarget

/-- In the `p=5` Proposition 2.1 package, strict free-field descent is exactly maximal
generation by the displayed singular vector.  Thus screening-kernel image equality and simple
image, which are already fields of `D`, do not by themselves eliminate quotient subsingular
vectors. -/
theorem strictDescent_iff_maximalGeneration
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier) :
    SingularIdealIsFreeFieldKernel Sl2Symbol85.level85_noncritical D.realization
        Sl2Sing85.sl2Singular85 ↔
      QuotVOA.maxGradedIdeal
          (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical) =
        idealGen (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical)
          Sl2Sing85.sl2Singular85 := by
  rw [SingularIdealIsFreeFieldKernel, D.ker_eval_eq_maxGradedIdeal]
  exact eq_comm

/-! ### The exact character input at `k = -8/5` -/

/-- The affine conformal grade on the Adamović screening kernel, defined intrinsically from the
homogeneous universal affine states mapping into it.  Proposition 2.1 identifies the union of
these affine-generated pieces with the screening kernel, without requiring a grading on the full
half-lattice carrier. -/
def ScreeningKernelAffineGrade
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier) (n : ℤ) :
    Submodule ℂ (VirPiHalfCarrier VirCarrier) :=
  FreeFieldImageGrade Sl2Symbol85.level85_noncritical D.realization n

/-- Every affine conformal piece of the free-field image lies in the external screening kernel. -/
theorem screeningKernelAffineGrade_le_ker_screening
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier) (n : ℤ) :
    ScreeningKernelAffineGrade D n ≤ LinearMap.ker D.screening := by
  intro y hy
  obtain ⟨x, -, rfl⟩ := hy
  exact LinearMap.mem_ker.mpr (D.screening_eval_zero x)

/-- The character of the displayed weight-five singular quotient equals the known simple affine
vacuum character, grade by grade.  This is precisely the external Rocha--Caridi/
Kac--Wakimoto-style identity needed for strict descent; it is not asserted here. -/
def DisplayedSingularQuotientHasSimpleCharacter : Prop :=
  ∀ n : ℤ,
    Module.finrank ℂ
        (SingularQuotientGrade Sl2Symbol85.level85_noncritical Sl2Sing85.sl2Singular85 n) =
      Module.finrank ℂ
        (((affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical).grading n).map
          (QuotVOA.maxGradedIdeal
            (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical)).mkQ)

/-- Proposition 2.1 identifies the affine-graded character of the screening-kernel image with
the character of the simple affine quotient.  This uses equality of kernels and rank--nullity;
it does not silently assume that the ambient half-lattice grading has finite pieces. -/
theorem finrank_screeningKernelAffineGrade_eq_simpleQuotientGrade
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier) (n : ℤ) :
    Module.finrank ℂ (ScreeningKernelAffineGrade D n) =
      Module.finrank ℂ
        (((affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical).grading n).map
          (QuotVOA.maxGradedIdeal
            (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical)).mkQ) := by
  have himage := finrank_imageGrade_add_finrank_kernel_inf
    Sl2Symbol85.level85_noncritical D.realization n
  have hquot := finrank_quotientGrade_add_finrank_inf
    Sl2Symbol85.level85_noncritical
      (QuotVOA.maxGradedIdeal
        (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical)) n
  rw [D.ker_eval_eq_maxGradedIdeal] at himage
  have himage' : Module.finrank ℂ (ScreeningKernelAffineGrade D n) +
      Module.finrank ℂ ↑(QuotVOA.maxGradedIdeal
        (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical) ⊓
          (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical).grading n) =
        Module.finrank ℂ
          ((affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical).grading n) := by
    simpa only [ScreeningKernelAffineGrade, W] using himage
  have hquot' : Module.finrank ℂ
        (((affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical).grading n).map
          (QuotVOA.maxGradedIdeal
            (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical)).mkQ) +
      Module.finrank ℂ ↑(QuotVOA.maxGradedIdeal
        (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical) ⊓
          (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical).grading n) =
        Module.finrank ℂ
          ((affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical).grading n) := by
    simpa only [W] using hquot
  omega

/-- At `k=-8/5`, the displayed singular quotient has the simple affine character exactly when
it has the affine-graded character of the Adamović screening-kernel image. -/
theorem displayedSingularQuotientHasSimpleCharacter_iff_freeFieldImageCharacter
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier) :
    DisplayedSingularQuotientHasSimpleCharacter ↔
      SingularQuotientHasFreeFieldImageCharacter Sl2Symbol85.level85_noncritical D.realization
        Sl2Sing85.sl2Singular85 := by
  constructor
  · intro hchar n
    have hrank := finrank_screeningKernelAffineGrade_eq_simpleQuotientGrade D n
    change Module.finrank ℂ (FreeFieldImageGrade Sl2Symbol85.level85_noncritical
        D.realization n) = _ at hrank
    exact (hchar n).trans hrank.symm
  · intro hchar n
    have hrank := finrank_screeningKernelAffineGrade_eq_simpleQuotientGrade D n
    change Module.finrank ℂ (FreeFieldImageGrade Sl2Symbol85.level85_noncritical
        D.realization n) = _ at hrank
    exact (hchar n).trans hrank

/-- **Decisive `p=5` character criterion.**  Equality of the displayed singular-quotient
character with the simple/screening-kernel character proves strict Adamović descent. -/
theorem strictDescent_of_simpleCharacter
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier)
    (hchar : DisplayedSingularQuotientHasSimpleCharacter) :
    SingularIdealIsFreeFieldKernel Sl2Symbol85.level85_noncritical D.realization
      Sl2Sing85.sl2Singular85 := by
  apply singularIdealIsFreeFieldKernel_of_character Sl2Symbol85.level85_noncritical D.realization
    D.eval_sl2Singular85_zero
  exact (displayedSingularQuotientHasSimpleCharacter_iff_freeFieldImageCharacter D).mp hchar

/-- Consequently the same character identity proves maximal generation by the displayed
weight-five singular vector. -/
theorem maximalGeneration_of_simpleCharacter
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier)
    (hchar : DisplayedSingularQuotientHasSimpleCharacter) :
    QuotVOA.maxGradedIdeal
        (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical) =
      idealGen (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical)
        Sl2Sing85.sl2Singular85 :=
  (strictDescent_iff_maximalGeneration D).mp
    (strictDescent_of_simpleCharacter D hchar)

/-- The p=5 character input is not merely sufficient: because the displayed singular ideal is
contained in the maximal ideal and all universal affine grades are finite-dimensional, it is
equivalent to maximal generation.  This records exactly where the external mathematics remains. -/
theorem displayedSingularQuotientHasSimpleCharacter_iff_maximalGeneration
    (D : K85Prop21ScreeningData VirCarrier ShiftedVirCarrier ShiftedPiCarrier) :
    DisplayedSingularQuotientHasSimpleCharacter ↔
      QuotVOA.maxGradedIdeal
          (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical) =
        idealGen (affineSl2VOA_closed (-8 / 5 : ℂ) Sl2Symbol85.level85_noncritical)
          Sl2Sing85.sl2Singular85 := by
  constructor
  · exact maximalGeneration_of_simpleCharacter D
  · intro hmax n
    simp only [SingularQuotientGrade]
    rw [hmax]
    rfl

end K85

