import VOA.Examples.AffineSl2BoundaryC2PBWUpper
import VOA.Examples.AffineSl2Symbol85
import VOA.Examples.AffineSl2WakimotoLiLeading

/-!
# The current-PBW upper bound at the first two boundary affine levels

`AffineSl2BoundaryC2PBWUpper` proves that positive-current annihilation of a vector makes its
nonpositive-current descendant span into a VOA ideal.  Hence the ideal generated by the vector
is contained in that span, and its `C₂` image has no relations beyond the horizontal orbit of the
vector's leading symbol.

This file instantiates that theorem at the two levels where both required calculations are
already formalized:

* `k = -4/3` (`p = 3`), with symbol `9 e Cas`;
* `k = -8/5` (`p = 5`), with symbol `625 e Cas²`.

The universal PBW theorem and universal-symbol injectivity are supplied by Wakimoto
triangularity.  Exactness therefore has only the displayed maximal-ideal equality as an input;
no classical-freeness or Hilbert-series assertion is used.
-/

namespace VOA.AffineSl2BoundaryC2

open VOA.AffineVOA VOA.AffineVOA.Inst
open VOA.AffineVOA.Strong
open VOA.QuasiLisseSl2
open VOA.Sl2Pres
open VOA.Sl2Sing85
open VOA.Sl2Symbol
open VOA.Sl2Symbol85
open VOA.AffineSl2WakimotoLiLeading
open VertexOperatorAlgebra

noncomputable section

/-! ## `p = 3`, `k = -4/3` -/

/-- The weight-three singular vector satisfies the abstract current-PBW spanning property. -/
theorem singularCurrentPBWSpanning43 :
    SingularCurrentPBWSpanning (-4 / 3 : ℂ) admLevel_noncritical
      Sl2Sing.sl2Singular :=
  singularCurrentPBWSpanning_of_SingP (-4 / 3 : ℂ) admLevel_noncritical
    Sl2Sing.sl2Singular (fun a m hm => Sl2Sing.sl2Singular_pos a (m := m) hm)

/-- The hard representative upper bound at `k = -4/3`. -/
theorem singularC2PBWUpper43 :
    SingularC2PBWUpper (-4 / 3 : ℂ) admLevel_noncritical 1 Sl2Sing.sl2Singular := by
  apply singularC2PBWUpper_of_highestSymbol_and_SingP
      (-4 / 3 : ℂ) admLevel_noncritical 1 Sl2Sing.sl2Singular 9 (by norm_num)
  · rw [map_mul, map_pow, pow_one, symbolAlg_eSym, symbolAlg_casSym]
    exact mk₂_sl2Singular_casimir
  · exact fun a m hm => Sl2Sing.sl2Singular_pos a (m := m) hm

/-- At `p = 3`, exactness is reduced to maximal-ideal generation by the known singular vector;
universal-symbol injectivity is the proved Wakimoto/PBW theorem. -/
theorem exact_boundary_simple43_of_maxIdeal
    (hmax : QuotVOA.maxGradedIdeal Wadm =
      SingVec.idealGen Wadm Sl2Sing.sl2Singular) :
    Presentation.IsExactPresentation (boundaryIdeal 1)
      (quotientSymbol (-4 / 3 : ℂ) admLevel_noncritical
        (QuotVOA.maxGradedIdeal Wadm)
        (QuotVOA.maxGradedIdeal_isIdeal Wadm)
        (QuotVOA.maxGradedIdeal_isGradedIdeal Wadm)) := by
  apply exact_boundary_simple_of_highestSymbol_and_SingP
      (-4 / 3 : ℂ) admLevel_noncritical 1 Sl2Sing.sl2Singular 9 (by norm_num)
  · rw [map_mul, map_pow, pow_one, symbolAlg_eSym, symbolAlg_casSym]
    exact mk₂_sl2Singular_casimir
  · exact universalSymbolAlg_injective (-4 / 3 : ℂ) admLevel_noncritical
  · exact hmax
  · exact fun a m hm => Sl2Sing.sl2Singular_pos a (m := m) hm

/-! ## `p = 5`, `k = -8/5` -/

/-- The weight-five singular vector satisfies the abstract current-PBW spanning property. -/
theorem singularCurrentPBWSpanning85 :
    SingularCurrentPBWSpanning (-8 / 5 : ℂ) level85_noncritical sl2Singular85 :=
  singularCurrentPBWSpanning_of_SingP (-8 / 5 : ℂ) level85_noncritical
    sl2Singular85 (fun a m hm => sl2Singular85_pos a (m := m) hm)

/-- The hard representative upper bound at `k = -8/5`. -/
theorem singularC2PBWUpper85 :
    SingularC2PBWUpper (-8 / 5 : ℂ) level85_noncritical 2 sl2Singular85 := by
  apply singularC2PBWUpper_of_highestSymbol_and_SingP
      (-8 / 5 : ℂ) level85_noncritical 2 sl2Singular85 625 (by norm_num)
  · rw [map_mul, map_pow, symbolAlg_eSym, symbolAlg_casSym]
    exact mk₂_sl2Singular85_casimir_sq
  · exact fun a m hm => sl2Singular85_pos a (m := m) hm

/-- At `p = 5`, exactness is likewise reduced only to maximal-ideal generation. -/
theorem exact_boundary_simple85_of_maxIdeal
    (hmax : QuotVOA.maxGradedIdeal W85 = SingVec.idealGen W85 sl2Singular85) :
    Presentation.IsExactPresentation (boundaryIdeal 2)
      (quotientSymbol (-8 / 5 : ℂ) level85_noncritical
        (QuotVOA.maxGradedIdeal W85)
        (QuotVOA.maxGradedIdeal_isIdeal W85)
        (QuotVOA.maxGradedIdeal_isGradedIdeal W85)) := by
  apply exact_boundary_simple_of_highestSymbol_and_SingP
      (-8 / 5 : ℂ) level85_noncritical 2 sl2Singular85 625 (by norm_num)
  · rw [map_mul, map_pow, symbolAlg_eSym, symbolAlg_casSym]
    exact mk₂_sl2Singular85_casimir_sq
  · exact universalSymbolAlg_injective (-8 / 5 : ℂ) level85_noncritical
  · exact hmax
  · exact fun a m hm => sl2Singular85_pos a (m := m) hm

end
end VOA.AffineSl2BoundaryC2

section AxiomAudit
#print axioms VOA.AffineSl2BoundaryC2.singularCurrentPBWSpanning43
#print axioms VOA.AffineSl2BoundaryC2.singularC2PBWUpper43
#print axioms VOA.AffineSl2BoundaryC2.singularCurrentPBWSpanning85
#print axioms VOA.AffineSl2BoundaryC2.singularC2PBWUpper85
#print axioms VOA.AffineSl2BoundaryC2.exact_boundary_simple43_of_maxIdeal
#print axioms VOA.AffineSl2BoundaryC2.exact_boundary_simple85_of_maxIdeal
end AxiomAudit
