/-!
# The uniform boundary singular-vector interface

For the boundary admissible levels

`k_n = -2 + 2 / (2n+1)`,

the primitive vacuum singular vector has conformal weight `2n+1`, horizontal highest weight
two, and nonzero `C₂` symbol proportional to `e Cas^n`.  Adamović--Milas prove that this vector
generates the maximal affine vacuum submodule.  This file records the exact Lean data carried by
that theorem and separates it from what the already formalized free-field realizations prove.

There are four intentionally different packages:

* `Candidate` contains the affine highest-weight facts and nonvanishing;
* `PrimitiveCriterionData` carries only the assertion that the vacuum line contains all primitive
  vectors; the textbook primitive-vector existence theorem is proved internally;
* `AdamovicMilasData` adds irreducibility of the quotient by the singular vector, in the literal
  current-module form of the published theorem;
* `ClassicalData` adds the nonzero highest `C₂` symbol and maximal-ideal generation.

The first two boundary candidates (`n=1,2`, or `p=3,5`) are unconditional instances, using the
explicit repository vectors.  Their `AdamovicMilasData` constructors take exactly the external
irreducibility theorem, and their `ClassicalData` instances still expose the equivalent maximal
generation statement; installing a literature theorem as an axiom would be inappropriate.

The theorem `mem_maxGradedIdeal_of_adamovic_freeField` is the sharp conclusion furnished by an
Adamović inverse-DS/free-field realization: a singular-image identity followed by the Virasoro
null relation places the candidate in the kernel, and simplicity of the screening-kernel image
identifies that kernel with the maximal ideal.  It does **not** identify the ideal generated by
the candidate with the maximal ideal.  Likewise, without strictness for the Li/`C₂` filtration,
the free-field map does not prove the highest-symbol identity.  These are mathematical, not API,
boundaries.

No `sorry`, `admit`, `native_decide`, or new axiom occurs here.
-/

namespace VOA
namespace AffineSl2BoundarySingularFamily

open VertexOperatorAlgebra
open AffineVOA AffineVOA.Inst AffineVOA.Strong
open AffineSl2BoundaryC2 QuasiLisseSl2 Sl2Pres
open Sl2Sing85 Sl2Symbol Sl2Symbol85

noncomputable section

/-! ## Boundary arithmetic -/

/-- The odd denominator `p=2n+1` of the `n`th boundary level. -/
def denominator (n : ℕ) : ℕ := 2 * n + 1

/-- The `n`th boundary affine level. -/
def level (n : ℕ) : ℂ := -2 + 2 / (denominator n : ℂ)

@[simp] theorem denominator_pos (n : ℕ) : 0 < denominator n := by
  simp [denominator]

theorem denominator_cast_ne_zero (n : ℕ) : (denominator n : ℂ) ≠ 0 := by
  exact_mod_cast (Nat.ne_of_gt (denominator_pos n))

@[simp] theorem level_add_two (n : ℕ) : level n + 2 = 2 / (denominator n : ℂ) := by
  rw [level]
  ring

/-- Every boundary level is noncritical. -/
theorem level_noncritical (n : ℕ) : level n + 2 ≠ 0 := by
  rw [level_add_two]
  exact div_ne_zero (by norm_num) (denominator_cast_ne_zero n)

/-- Every boundary level with odd denominator at least three is nonzero.  This is the exact
extra coefficient hypothesis used by the boundary-specific Wakimoto triangularity route. -/
theorem level_ne_zero {n : ℕ} (hn : 1 ≤ n) : level n ≠ 0 := by
  rw [level]
  intro h
  have hden : (denominator n : ℂ) ≠ 0 := denominator_cast_ne_zero n
  field_simp [hden] at h
  have hn0 : (n : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (zero_lt_one.trans_le hn))
  apply hn0
  simpa [denominator] using h

@[simp] theorem level_one : level 1 = (-4 / 3 : ℂ) := by
  norm_num [level, denominator]

@[simp] theorem level_two : level 2 = (-8 / 5 : ℂ) := by
  norm_num [level, denominator]

/-! ### Adamović--Milas parameter conversion

Adamović--Milas write an admissible level in lowest terms as `a/q`.  For the boundary family
their numerator is `2-2q`.  The integer called `N=2q+a-1` in their Theorem 3.1.4 is therefore
exactly one.  Their singular weight

`k Lambda_0 - q N delta + N alpha`

consequently has conformal weight `q=2n+1` and horizontal highest weight two. -/

/-- The integer numerator in the Adamović--Milas convention `k=a/q`. -/
def amNumerator (n : ℕ) : ℤ := 2 - 2 * (denominator n : ℤ)

/-- The denominator in the same convention. -/
def amDenominator (n : ℕ) : ℕ := denominator n

/-- Their auxiliary integer `N=2q+a-1`. -/
def amN (n : ℕ) : ℤ := 2 * (amDenominator n : ℤ) + amNumerator n - 1

@[simp] theorem amNumerator_eq (n : ℕ) : amNumerator n = -4 * (n : ℤ) := by
  simp [amNumerator, denominator]
  ring

@[simp] theorem amN_eq_one (n : ℕ) : amN n = 1 := by
  simp [amN, amDenominator, amNumerator]

/-- The repository's boundary-level formula is literally the Adamović--Milas rational
parameter. -/
theorem level_eq_amFraction (n : ℕ) :
    level n = (amNumerator n : ℂ) / (amDenominator n : ℂ) := by
  rw [level, amNumerator, amDenominator]
  field_simp [denominator_cast_ne_zero n]
  push_cast
  ring

/-- The delta coefficient in the Adamović--Milas singular weight is the expected conformal
weight `2n+1`. -/
@[simp] theorem am_singularConformalWeight (n : ℕ) :
    (amDenominator n : ℤ) * amN n = (denominator n : ℤ) := by
  simp [amDenominator]

/-! ## The representation-theoretic packages -/

/-- The intrinsic affine highest-weight data of a boundary singular-vector candidate.

The level equality is retained as data because it lets the structure also package concrete
vectors whose ambient `WakModule k` type has already been fixed, without transporting vectors
through equality of level parameters. -/
structure Candidate (k : ℂ) (n : ℕ) where
  /-- The boundary family starts at `n=1`, equivalently at odd denominator `p=3`. -/
  indexPositive : 1 ≤ n
  /-- This is the boundary level `-2+2/(2n+1)`. -/
  isBoundaryLevel : k = level n
  /-- Noncriticality, needed by the closed affine VOA construction. -/
  noncritical : k + 2 ≠ 0
  /-- The singular-vector candidate. -/
  vector : WakModule k
  /-- It has the predicted conformal weight `2n+1`. -/
  homogeneous : vector ∈ gradingZA k (denominator n : ℤ)
  /-- It is horizontal-highest. -/
  horizontalRaising : J k colE 0 vector = 0
  /-- Its horizontal Cartan weight is two. -/
  horizontalCharge : J k colH 0 vector = (2 : ℂ) • vector
  /-- Every strictly positive current mode annihilates it. -/
  positiveSingular : SingP k vector
  /-- The candidate is an honest nonzero vector. -/
  nonzero : vector ≠ 0

/-- The primitive-vector route to irreducibility.  Primitive existence is internal, from
positive energy and horizontal `sl₂` local nilpotence on current words.  The sole field here is
therefore the model-specific uniqueness assertion: after quotienting by the displayed singular
vector, every remaining affine primitive vector is on the vacuum line. -/
structure PrimitiveCriterionData (k : ℂ) (n : ℕ) extends Candidate k n where
  onlyVacuumPrimitive :
    AffineSl2BoundaryMaximalIdeal.OnlyVacuumAffinePrimitives
      k noncritical vector

namespace Candidate

/-- A candidate plus model-specific primitive uniqueness gives the complete primitive-criterion
package.  The primitive-existence theorem is proved, not an input. -/
noncomputable def toPrimitiveCriterionData {k : ℂ} {n : ℕ} (C : Candidate k n)
    (honly : AffineSl2BoundaryMaximalIdeal.OnlyVacuumAffinePrimitives
      k C.noncritical C.vector) :
    PrimitiveCriterionData k n where
  toCandidate := C
  onlyVacuumPrimitive := honly

end Candidate

/-- The additional data needed by the boundary `C₂` presentation.

`maximalGeneration` is exactly the conclusion of the Adamović--Milas maximal-submodule theorem.
The symbol identity is obtained on paper from affine highest-weight data, the
Arakawa--Jiang--Moreau nonvanishing theorem, and the one-dimensional harmonic line in
`S^(2n+1)(sl₂)` of horizontal highest weight two. -/
structure ClassicalData (k : ℂ) (n : ℕ) extends Candidate k n where
  /-- Nonzero normalization of the highest `C₂` symbol. -/
  symbolCoefficient : ℂ
  symbolCoefficient_ne_zero : symbolCoefficient ≠ 0
  /-- The highest symbol is the expected harmonic vector. -/
  highestSymbol :
    mk₂ (affineSl2VOA_closed k noncritical) vector =
      symbolCoefficient • symbolAlg k noncritical (eSym * casSym ^ n)
  /-- The primitive singular vector generates the maximal vacuum ideal. -/
  maximalGeneration :
    QuotVOA.maxGradedIdeal (affineSl2VOA_closed k noncritical) =
      SingVec.idealGen (affineSl2VOA_closed k noncritical) vector

/-- The literal representation-theoretic payload of Adamović--Milas, Theorem 3.1.4, after
specializing its admissible parameters to the boundary family.

The published formula `L(k,0) = M(k,0) / U(ŝl₂)v_sing` says precisely that the quotient by the
singular current submodule is irreducible.  We therefore carry current irreducibility, not a VOA
ideal equality.  `AffineSl2BoundaryMaximalIdeal` proves it equivalent to generation of the maximal
current submodule and transports it to the maximal graded VOA ideal.

The direct irreducible-quotient theorem remains the strongest source-faithful import.  The
alternative `PrimitiveCriterionData` route shows that it can be reduced to the literal assertion
that every affine primitive vector in the singular quotient lies on the vacuum line; primitive
existence is proved internally. -/
structure AdamovicMilasData (k : ℂ) (n : ℕ) extends Candidate k n where
  quotientIrreducible :
    AffineSl2BoundaryMaximalIdeal.SingularQuotientCurrentIrreducible
      k noncritical vector

namespace PrimitiveCriterionData

/-- The quotient is nonzero from the already stored positive-weight singular-vector data. -/
theorem quotientNonzero {k : ℂ} {n : ℕ} (D : PrimitiveCriterionData k n) :
    (⊤ : Submodule ℂ
      (WakModule k ⧸ SingVec.idealGen (affineSl2VOA_closed k D.noncritical) D.vector)) ≠ ⊥ := by
  apply AffineSl2BoundaryMaximalIdeal.singularQuotient_top_ne_bot_of_SingP
    k D.noncritical D.vector D.positiveSingular D.nonzero
    (w := (denominator n : ℤ))
  · exact_mod_cast denominator_pos n
  · exact D.homogeneous

/-- Internal primitive existence plus vacuum-line uniqueness gives current irreducibility. -/
theorem quotientIrreducible {k : ℂ} {n : ℕ} (D : PrimitiveCriterionData k n) :
    AffineSl2BoundaryMaximalIdeal.SingularQuotientCurrentIrreducible
      k D.noncritical D.vector :=
  AffineSl2BoundaryMaximalIdeal.currentIrreducible_of_onlyVacuumAffinePrimitives
    k D.noncritical D.vector D.quotientNonzero D.onlyVacuumPrimitive

/-- The primitive-vector package promotes to the direct Adamović--Milas irreducible-quotient
package by a proved adapter. -/
noncomputable def toAdamovicMilasData {k : ℂ} {n : ℕ} (D : PrimitiveCriterionData k n) :
    AdamovicMilasData k n where
  toCandidate := D.toCandidate
  quotientIrreducible := D.quotientIrreducible

/-- The same criterion gives maximal affine-current-submodule generation. -/
theorem maximalSubmodule {k : ℂ} {n : ℕ} (D : PrimitiveCriterionData k n) :
    AffineSl2BoundaryMaximalIdeal.AffineVacuumMaximalSubmoduleGenerated
      k D.noncritical D.vector :=
  AffineSl2BoundaryMaximalIdeal.affineVacuumMaximalSubmoduleGenerated_of_onlyVacuumAffinePrimitives
    k D.noncritical D.vector D.quotientNonzero D.onlyVacuumPrimitive

end PrimitiveCriterionData

namespace AdamovicMilasData

/-- The irreducible-quotient statement transported to maximal generation of the affine current
submodule. -/
theorem maximalSubmodule {k : ℂ} {n : ℕ} (D : AdamovicMilasData k n) :
    AffineSl2BoundaryMaximalIdeal.AffineVacuumMaximalSubmoduleGenerated
      k D.noncritical D.vector :=
  (AffineSl2BoundaryMaximalIdeal.affineVacuumMaximalSubmoduleGenerated_iff_currentIrreducible
    k D.noncritical D.vector).2 D.quotientIrreducible

/-- The published affine-module conclusion transported to the exact VOA maximal-ideal equality. -/
theorem maximalGeneration {k : ℂ} {n : ℕ} (D : AdamovicMilasData k n) :
    QuotVOA.maxGradedIdeal (affineSl2VOA_closed k D.noncritical) =
      SingVec.idealGen (affineSl2VOA_closed k D.noncritical) D.vector :=
  AffineSl2BoundaryMaximalIdeal.maxGradedIdeal_eq_idealGen_of_affineVacuumMaximalSubmoduleGenerated
    k D.noncritical D.vector D.maximalSubmodule

/-- Adding the independent highest-symbol input upgrades the published singular-vector theorem
to all data needed by the boundary `C₂` presentation. -/
noncomputable def toClassicalData {k : ℂ} {n : ℕ} (D : AdamovicMilasData k n)
    (coefficient : ℂ) (hcoefficient : coefficient ≠ 0)
    (hsymbol :
      mk₂ (affineSl2VOA_closed k D.noncritical) D.vector =
        coefficient • symbolAlg k D.noncritical (eSym * casSym ^ n)) :
    ClassicalData k n where
  toCandidate := D.toCandidate
  symbolCoefficient := coefficient
  symbolCoefficient_ne_zero := hcoefficient
  highestSymbol := hsymbol
  maximalGeneration := D.maximalGeneration

end AdamovicMilasData

namespace ClassicalData

/-- Positive-current singularity gives the uniform representative PBW upper bound. -/
theorem singularC2PBWUpper {k : ℂ} {n : ℕ} (D : ClassicalData k n) :
    SingularC2PBWUpper k D.noncritical n D.vector :=
  singularC2PBWUpper_of_highestSymbol_and_SingP k D.noncritical n D.vector
    D.symbolCoefficient D.symbolCoefficient_ne_zero D.highestSymbol D.positiveSingular

/-- The full boundary `C₂` presentation follows from `ClassicalData`.  Universal affine symbol
injectivity is supplied internally by the proved Wakimoto/PBW theorem. -/
theorem exactPresentation {k : ℂ} {n : ℕ} (D : ClassicalData k n) :
    Presentation.IsExactPresentation (boundaryIdeal n)
      (quotientSymbol k D.noncritical
        (QuotVOA.maxGradedIdeal (affineSl2VOA_closed k D.noncritical))
        (QuotVOA.maxGradedIdeal_isIdeal _)
        (QuotVOA.maxGradedIdeal_isGradedIdeal _)) :=
  exact_boundary_simple_of_highestSymbol_and_SingP k D.noncritical n D.vector
    D.symbolCoefficient D.symbolCoefficient_ne_zero D.highestSymbol
    (AffineSl2WakimotoLiLeading.universalSymbolAlg_injective k D.noncritical)
    D.maximalGeneration D.positiveSingular

end ClassicalData

/-! ## Exact scope of the Adamović free-field route -/

universe u

/-- A singular-image identity and the Virasoro null relation put a boundary candidate in the
maximal affine ideal, provided the realized screening-kernel image is simple.

This is the strongest conclusion available from these hypotheses.  In particular the conclusion
is membership, not generation of the maximal ideal. -/
theorem mem_maxGradedIdeal_of_adamovic_freeField
    {k : ℂ} {n : ℕ} (C : Candidate k n)
    {E : Type u} [AddCommGroup E] [Module ℂ E]
    (R : VacuumCurrentRealization k E) (hRv : R.vacuum ≠ 0)
    {virSingularTimesExp : E}
    (himage : InverseDS.AdamovicCor53SingularImage
      R.eval C.vector virSingularTimesExp)
    (hvir : virSingularTimesExp = 0)
    (hsimple : InverseDS.VacuumModeHom.HasSimpleVOAImage
      (affineSl2VOA_closed k C.noncritical) R.eval) :
    C.vector ∈ QuotVOA.maxGradedIdeal (affineSl2VOA_closed k C.noncritical) := by
  have hzero : R.eval C.vector = 0 :=
    InverseDS.singular_vanishes_of_adamovicCor53 himage hvir
  have hker : LinearMap.ker R.eval =
      QuotVOA.maxGradedIdeal (affineSl2VOA_closed k C.noncritical) :=
    InverseDS.AffineEvaluation.eval_ker_eq_maxGradedIdeal_of_simpleImage
      R C.noncritical hRv hsimple
  rw [← hker, LinearMap.mem_ker]
  exact hzero

/-! ## What the Wakimoto free field supplies uniformly -/

/-- The general Wakimoto representation separates a class in the universal affine vacuum module
as soon as it separates one enveloping-algebra representative.

For a uniform MFF/screening construction this reduces nonvanishing to one explicit free-field
coefficient.  It says nothing about singularity or maximal generation: those must be proved for
the chosen representative by separate current-mode or representation-theoretic arguments. -/
theorem quotientMk_ne_zero_of_wakimotoEval_ne_zero
    {k : ℂ} (hk : k + 2 ≠ 0) (w : Wak.UW)
    (hval : Wak.valW k hk w ≠ 0) :
    (Submodule.Quotient.mk w : WakModule k) ≠ 0 := by
  intro hzero
  have hmem : w ∈ AffineLie.vacuumIdeal kappaForm kappaForm_isInvariant k := by
    rw [← Submodule.Quotient.mk_eq_zero]
    exact hzero
  exact hval (Wak.valW_vacuumIdeal k hk w hmem)

/-! ## The first two boundary candidates -/

/-- The explicit weight-three vector is the `n=1` boundary candidate. -/
noncomputable def candidate43 : Candidate (-4 / 3 : ℂ) 1 where
  indexPositive := by norm_num
  isBoundaryLevel := by norm_num [level, denominator]
  noncritical := admLevel_noncritical
  vector := Sl2Sing.sl2Singular
  homogeneous := Sl2Sing.sl2Singular_mem
  horizontalRaising := Sl2Sing.sl2Singular_E0
  horizontalCharge := Sl2Sing.sl2Singular_H0
  positiveSingular := fun a _ hm => Sl2Sing.sl2Singular_pos a hm
  nonzero := Wak.sl2Singular_ne_zero

/-- The explicit weight-five vector is the `n=2` boundary candidate. -/
noncomputable def candidate85 : Candidate (-8 / 5 : ℂ) 2 where
  indexPositive := by norm_num
  isBoundaryLevel := by norm_num [level, denominator]
  noncritical := level85_noncritical
  vector := sl2Singular85
  homogeneous := sl2Singular85_mem
  horizontalRaising := sl2Singular85_E0
  horizontalCharge := sl2Singular85_H0
  positiveSingular := fun a _ hm => sl2Singular85_pos a hm
  nonzero := WakLY.sl2Singular85_ne_zero

/-- Exact `p=3` primitive-vector interface.  Its sole argument is the model-specific assertion
that the quotient has no new primitive vector outside its vacuum line. -/
noncomputable def primitiveCriterionData43
    (honly : AffineSl2BoundaryMaximalIdeal.OnlyVacuumAffinePrimitives
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular) :
    PrimitiveCriterionData (-4 / 3 : ℂ) 1 where
  toCandidate := candidate43
  onlyVacuumPrimitive := honly

/-- Exact `p=5` primitive-vector interface. -/
noncomputable def primitiveCriterionData85
    (honly : AffineSl2BoundaryMaximalIdeal.OnlyVacuumAffinePrimitives
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85) :
    PrimitiveCriterionData (-8 / 5 : ℂ) 2 where
  toCandidate := candidate85
  onlyVacuumPrimitive := honly

/-- Exact `p=3` specialization of the source-faithful Adamović--Milas interface.  Its sole
argument is the external irreducibility theorem for the quotient by the displayed vector. -/
noncomputable def adamovicMilasData43
    (hirr : AffineSl2BoundaryMaximalIdeal.SingularQuotientCurrentIrreducible
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular) :
    AdamovicMilasData (-4 / 3 : ℂ) 1 where
  toCandidate := candidate43
  quotientIrreducible := hirr

/-- Exact `p=5` specialization of the source-faithful Adamović--Milas interface. -/
noncomputable def adamovicMilasData85
    (hirr : AffineSl2BoundaryMaximalIdeal.SingularQuotientCurrentIrreducible
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85) :
    AdamovicMilasData (-8 / 5 : ℂ) 2 where
  toCandidate := candidate85
  quotientIrreducible := hirr

/-- Sanity check: the generic Wakimoto-separation bridge recovers the `p=3` nonvanishing theorem
from the already computed `gamma_3` coefficient. -/
theorem singular43_ne_zero_via_uniform_wakimoto_bridge : Sl2Sing.sl2Singular ≠ 0 := by
  rw [Wak.sl2Singular_mk]
  apply quotientMk_ne_zero_of_wakimotoEval_ne_zero Wak.hk43 Wak.wSing
  intro hzero
  have h := congrArg (Wak.Gam 3) hzero
  rw [Wak.Gam3_valW_wSing (-4 / 3 : ℂ) Wak.hk43, map_zero] at h
  have hne : ((-8 : ℂ) • (1 : Wak.WakFock)) ≠ 0 := by
    rw [smul_ne_zero_iff]
    exact ⟨by norm_num, one_ne_zero⟩
  exact hne h

/-- Sanity check: the same bridge recovers the `p=5` nonvanishing theorem from the computed
`gamma_5` coefficient. -/
theorem singular85_ne_zero_via_uniform_wakimoto_bridge : sl2Singular85 ≠ 0 := by
  rw [sl2Singular85_eq_LY, WakLY.sl2SingularLY_mk]
  apply quotientMk_ne_zero_of_wakimotoEval_ne_zero WakLY.hk85 WakLY.wSingLY
  intro hzero
  have h := congrArg (Wak.Gam 5) hzero
  rw [WakLY.Gam5_valW_wSingLY (-8 / 5 : ℂ) WakLY.hk85, map_zero] at h
  have hne : ((-384 : ℂ) • (1 : Wak.WakFock)) ≠ 0 := by
    rw [smul_ne_zero_iff]
    exact ⟨by norm_num, one_ne_zero⟩
  exact hne h

/-- At `p=3`, only maximal generation remains an input: all candidate and symbol data are
already theorems. -/
noncomputable def classicalData43
    (hmax : QuotVOA.maxGradedIdeal
        (affineSl2VOA_closed (-4 / 3 : ℂ) admLevel_noncritical) =
      SingVec.idealGen (affineSl2VOA_closed (-4 / 3 : ℂ) admLevel_noncritical)
        Sl2Sing.sl2Singular) :
    ClassicalData (-4 / 3 : ℂ) 1 where
  toCandidate := candidate43
  symbolCoefficient := 9
  symbolCoefficient_ne_zero := by norm_num
  highestSymbol := by
    rw [map_mul, map_pow, pow_one, symbolAlg_eSym, symbolAlg_casSym]
    exact mk₂_sl2Singular_casimir
  maximalGeneration := by simpa [candidate43] using hmax

/-- At `p=5`, only maximal generation remains an input as well. -/
noncomputable def classicalData85
    (hmax : QuotVOA.maxGradedIdeal
        (affineSl2VOA_closed (-8 / 5 : ℂ) level85_noncritical) =
      SingVec.idealGen (affineSl2VOA_closed (-8 / 5 : ℂ) level85_noncritical)
        sl2Singular85) :
    ClassicalData (-8 / 5 : ℂ) 2 where
  toCandidate := candidate85
  symbolCoefficient := 625
  symbolCoefficient_ne_zero := by norm_num
  highestSymbol := by
    rw [map_mul, map_pow, symbolAlg_eSym, symbolAlg_casSym]
    exact mk₂_sl2Singular85_casimir_sq
  maximalGeneration := by simpa [candidate85] using hmax

/-- At `p=3`, irreducibility of the singular quotient supplies all representation-theoretic data
needed by the already proved candidate and symbol calculation. -/
noncomputable def classicalData43_of_currentIrreducible
    (hirr : AffineSl2BoundaryMaximalIdeal.SingularQuotientCurrentIrreducible
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular) :
    ClassicalData (-4 / 3 : ℂ) 1 :=
  classicalData43
    (AffineSl2BoundaryMaximalIdeal.maxGradedIdeal_eq_idealGen_of_currentIrreducible
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular hirr)

/-- At `p=5`, irreducibility of the singular quotient likewise supplies all remaining
representation-theoretic data. -/
noncomputable def classicalData85_of_currentIrreducible
    (hirr : AffineSl2BoundaryMaximalIdeal.SingularQuotientCurrentIrreducible
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85) :
    ClassicalData (-8 / 5 : ℂ) 2 :=
  classicalData85
    (AffineSl2BoundaryMaximalIdeal.maxGradedIdeal_eq_idealGen_of_currentIrreducible
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85 hirr)

/-- At `p=3`, the primitive-vector criterion supplies the complete exact-`C₂` data package. -/
noncomputable def classicalData43_of_primitiveCriterion
    (honly : AffineSl2BoundaryMaximalIdeal.OnlyVacuumAffinePrimitives
      (-4 / 3 : ℂ) admLevel_noncritical Sl2Sing.sl2Singular) :
    ClassicalData (-4 / 3 : ℂ) 1 :=
  classicalData43_of_currentIrreducible
    (primitiveCriterionData43 honly).quotientIrreducible

/-- At `p=5`, the same criterion supplies the complete exact-`C₂` data package. -/
noncomputable def classicalData85_of_primitiveCriterion
    (honly : AffineSl2BoundaryMaximalIdeal.OnlyVacuumAffinePrimitives
      (-8 / 5 : ℂ) level85_noncritical sl2Singular85) :
    ClassicalData (-8 / 5 : ℂ) 2 :=
  classicalData85_of_currentIrreducible
    (primitiveCriterionData85 honly).quotientIrreducible

end
