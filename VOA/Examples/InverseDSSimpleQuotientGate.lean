import VOA.Examples.AffineSl2NotSimple85
import VOA.Examples.AffineSl2VacuumEvaluation
import VOA.Examples.AffineSl2Strong
import VOA.Core.SimpleImage
import VOA.Core.SuperNearVOA

/-!
# The finite simple-quotient gate for inverse DS at level `-8/5`

This file isolates exactly what a free-field realization must prove after the three affine
current OPEs have produced a vertex-algebra homomorphism.  It has two independent parts.

First, `sl2Singular85Eval` is the literal twenty-one-term substitution of three arbitrary
families of current modes into the known weight-five singular vector.  The theorem
`map_sl2Singular85` proves that every linear map intertwining the three current modes sends the
affine singular vector to this finite expression.  Thus the free-field null calculation is the
single equality `sl2Singular85Eval K vac = 0`.

Second, vanishing of that vector makes a VOA homomorphism factor through the quotient by the
ideal it generates.  If one supplies the standard representation-theoretic statement that this
ideal is the maximal graded ideal, then the induced map from the simple quotient is injective.
Surjectivity is needed only if one wants to identify the entire target, rather than the vertex
subalgebra generated by the three current images, with the simple affine quotient.

The file does not assert either missing input: the current-mode intertwiner and the equality of
the singular ideal with the maximal ideal remain explicit hypotheses.  In particular, checking
the finite null relation does not by itself construct the inverse-DS homomorphism.

The quotient argument itself is formulated below for a `VacuumModeHom`.  This deliberately
forgets the target grading, conformal vector, and finite-dimensionality: only its vacuum and
right-linear mode products enter the proof.  In particular the result applies to a `NearVOA`
target such as the indefinite free-field algebra `Pi(0)`, whose fixed-weight spaces need not be
finite-dimensional.  Adapters are supplied for ordinary and super near-VOAs.
-/

namespace VOA
namespace InverseDS

open Module (End)
open AffineVOA AffineLie Sl2Sing85

noncomputable section

universe u v w

/-! ## The literal weight-five substitution -/

/-- Apply a list of coloured modes, operator first, to a target vacuum. -/
def evalCurrentWord {A : Type u} [AddCommGroup A] [Module ℂ A]
    (K : Fin 3 → ℤ → End ℂ A) (vac : A) : List (Fin 3 × ℤ) → A
  | [] => vac
  | (a, m) :: w => K a m (evalCurrentWord K vac w)

/-- The known weight-five singular vector with every affine mode replaced by an arbitrary
target current mode.  This is the finite identity to be checked in the inverse-DS free fields. -/
def sl2Singular85Eval {A : Type u} [AddCommGroup A] [Module ℂ A]
    (K : Fin 3 → ℤ → End ℂ A) (vac : A) : A :=
  (625 : ℂ) • evalCurrentWord K vac
      [(colE, -1), (colH, -1), (colH, -1), (colH, -1), (colH, -1)]
    + (5000 : ℂ) • evalCurrentWord K vac
      [(colE, -1), (colE, -1), (colF, -1), (colH, -1), (colH, -1)]
    + (10000 : ℂ) • evalCurrentWord K vac
      [(colE, -1), (colE, -1), (colE, -1), (colF, -1), (colF, -1)]
    + (-1500 : ℂ) • evalCurrentWord K vac
      [(colH, -2), (colE, -1), (colH, -1), (colH, -1)]
    + (-16000 : ℂ) • evalCurrentWord K vac
      [(colH, -2), (colE, -1), (colE, -1), (colF, -1)]
    + (300 : ℂ) • evalCurrentWord K vac [(colH, -2), (colH, -2), (colE, -1)]
    + (-10000 : ℂ) • evalCurrentWord K vac
      [(colF, -2), (colE, -1), (colE, -1), (colH, -1)]
    + (-1000 : ℂ) • evalCurrentWord K vac
      [(colE, -2), (colH, -1), (colH, -1), (colH, -1)]
    + (6000 : ℂ) • evalCurrentWord K vac
      [(colE, -2), (colE, -1), (colF, -1), (colH, -1)]
    + (1200 : ℂ) • evalCurrentWord K vac [(colE, -2), (colH, -2), (colH, -1)]
    + (-14400 : ℂ) • evalCurrentWord K vac [(colE, -2), (colF, -2), (colE, -1)]
    + (-9600 : ℂ) • evalCurrentWord K vac [(colE, -2), (colE, -2), (colF, -1)]
    + (-19200 : ℂ) • evalCurrentWord K vac [(colH, -3), (colE, -1), (colH, -1)]
    + (-14720 : ℂ) • evalCurrentWord K vac [(colH, -3), (colE, -2)]
    + (1600 : ℂ) • evalCurrentWord K vac [(colF, -3), (colE, -1), (colE, -1)]
    + (4200 : ℂ) • evalCurrentWord K vac [(colE, -3), (colH, -1), (colH, -1)]
    + (78400 : ℂ) • evalCurrentWord K vac [(colE, -3), (colE, -1), (colF, -1)]
    + (-1680 : ℂ) • evalCurrentWord K vac [(colE, -3), (colH, -2)]
    + (2960 : ℂ) • evalCurrentWord K vac [(colH, -4), (colE, -1)]
    + (17440 : ℂ) • evalCurrentWord K vac [(colE, -4), (colH, -1)]
    + (25904 : ℂ) • evalCurrentWord K vac [(colE, -5)]

/-- Evaluation of a mode word commutes with every linear map that intertwines the modes and
sends the source vacuum to the target vacuum. -/
theorem map_evalCurrentWord {A : Type u} {B : Type v}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    (K : Fin 3 → ℤ → End ℂ A) (K' : Fin 3 → ℤ → End ℂ B)
    (vac : A) (vac' : B) (φ : A →ₗ[ℂ] B)
    (hvac : φ vac = vac') (hmode : ∀ a m x, φ (K a m x) = K' a m (φ x)) :
    ∀ w, φ (evalCurrentWord K vac w) = evalCurrentWord K' vac' w
  | [] => hvac
  | (a, m) :: w => by
      rw [evalCurrentWord, hmode, map_evalCurrentWord K K' vac vac' φ hvac hmode w,
        evalCurrentWord]

/-- The abstract target expression specializes back to the repository's affine singular vector. -/
theorem sl2Singular85Eval_source :
    sl2Singular85Eval (J (-8 / 5 : ℂ)) (vacuumA (-8 / 5 : ℂ)) = sl2Singular85 := by
  rw [sl2Singular85_def]
  rfl

/-- **Finite substitution theorem.**  A current-mode intertwiner sends the affine singular
vector to the literal twenty-one-term target expression. -/
theorem map_sl2Singular85 {A : Type u} [AddCommGroup A] [Module ℂ A]
    (K : Fin 3 → ℤ → End ℂ A) (vac : A)
    (φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A)
    (hvac : φ (vacuumA (-8 / 5 : ℂ)) = vac)
    (hmode : ∀ a m x, φ (J (-8 / 5 : ℂ) a m x) = K a m (φ x)) :
    φ sl2Singular85 = sl2Singular85Eval K vac := by
  rw [← sl2Singular85Eval_source]
  simp only [sl2Singular85Eval, map_add, map_smul]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]
  rw [map_evalCurrentWord _ _ _ _ φ hvac hmode]

/-! ## From a concrete affine-current representation to the quotient map -/

namespace AffineEvaluation

open AffineVOA.Inst

variable {k : ℂ} {E : Type v} [AddCommGroup E] [Module ℂ E]

/-- The kernel of universal vacuum evaluation is stable under every affine current mode. -/
theorem eval_J_mem_ker (R : VacuumCurrentRealization k E) (a : Fin 3) (n : ℤ)
    {x : WakModule k} (hx : x ∈ LinearMap.ker R.eval) :
    J k a n x ∈ LinearMap.ker R.eval := by
  rw [LinearMap.mem_ker] at hx ⊢
  rw [R.eval_J, hx, map_zero]

/-- Stability under current modes propagates to modes of every affine creation word.  This is
the strong-generation step which lets `VacuumCurrentRealization.eval` factor through a VOA ideal
without first assuming that the free-field carrier has already been assembled into a near-VOA. -/
theorem eval_wordMode_mem_ker (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0) :
    ∀ (word : List (Fin 3 × ℕ)) (x : WakModule k),
      x ∈ LinearMap.ker R.eval → ∀ N : ℤ,
        (affineSl2VOA_closed k hk).smul (wordStateA k word) N x ∈
          LinearMap.ker R.eval
  | [], x, hx, N => by
      rw [wordStateA_nil]
      change (affineSl2VOA_closed k hk).smul (affineSl2VOA_closed k hk).vacuum N x ∈ _
      rw [PreVertexAlgebra.smul_vacuum_left]
      split_ifs
      · exact hx
      · exact Submodule.zero_mem _
  | (ai :: word), x, hx, N => by
      rw [wordStateA_cons]
      rw [← smul_currentState_eq_J k hk ai.1 (-(ai.2 : ℤ) - 1) (wordStateA k word)]
      rw [VertexOperatorAlgebra.mode_iterate]
      apply QuotVOA.finsum_mem_submodule
      intro i
      apply Submodule.smul_mem
      apply Submodule.sub_mem
      · rw [smul_currentState_eq_J]
        exact eval_J_mem_ker R ai.1 (-(ai.2 : ℤ) - 1 - (i : ℤ))
          (eval_wordMode_mem_ker R hk word x hx (N + (i : ℤ)))
      · apply Submodule.smul_mem
        rw [smul_currentState_eq_J]
        exact eval_wordMode_mem_ker R hk word _
          (eval_J_mem_ker R ai.1 (i : ℤ) hx) ((-(ai.2 : ℤ) - 1) + N - (i : ℤ))

/-- The creation-word result extended linearly to the homogeneous word span. -/
theorem eval_hspanMode_mem_ker (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0)
    {m : ℤ} {u x : WakModule k} (hu : u ∈ HSpan k m)
    (hx : x ∈ LinearMap.ker R.eval) (N : ℤ) :
    (affineSl2VOA_closed k hk).smul u N x ∈ LinearMap.ker R.eval := by
  rw [HSpan] at hu
  induction hu using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨word, -, rfl⟩ := hy
      exact eval_wordMode_mem_ker R hk word x hx N
  | zero => simp
  | add a b _ _ ha hb =>
      rw [PreVertexAlgebra.smul_add_left]
      exact Submodule.add_mem _ ha hb
  | smul c a _ ha =>
      rw [PreVertexAlgebra.smul_smul_left]
      exact Submodule.smul_mem _ c ha

/-- Universal vacuum evaluation has an ideal kernel.  This is stronger than the affine-module
statement in `AffineSl2VacuumEvaluation`: it uses strong generation of the universal affine VOA
by its three currents, but no algebraic structure at all on `E`. -/
theorem eval_isIdeal_ker (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0) :
    (affineSl2VOA_closed k hk).IsIdeal (LinearMap.ker R.eval) := by
  classical
  intro u x N hx
  let S : Submodule ℂ (WakModule k) :=
    { carrier := {a | (affineSl2VOA_closed k hk).smul a N x ∈ LinearMap.ker R.eval}
      zero_mem' := by simp
      add_mem' := by
        intro a b ha hb
        change (affineSl2VOA_closed k hk).smul (a + b) N x ∈ LinearMap.ker R.eval
        rw [PreVertexAlgebra.smul_add_left]
        exact Submodule.add_mem _ ha hb
      smul_mem' := by
        intro c a ha
        change (affineSl2VOA_closed k hk).smul (c • a) N x ∈ LinearMap.ker R.eval
        rw [PreVertexAlgebra.smul_smul_left]
        exact Submodule.smul_mem _ c ha }
  change u ∈ S
  obtain ⟨components, rfl⟩ := (gradingZA_isInternal k).2 u
  rw [DirectSum.coeAddMonoidHom_eq_dfinsuppSum, DFinsupp.sum]
  apply Submodule.sum_mem
  intro m hm
  change (affineSl2VOA_closed k hk).smul (components m) N x ∈ LinearMap.ker R.eval
  have hspan : (components m : WakModule k) ∈ HSpan k m :=
    gradingZA_le_hspan k m (components m).2
  exact eval_hspanMode_mem_ker R hk hspan hx N

/-- A singular vector killed by a concrete current realization kills its whole generated VOA
ideal under universal evaluation. -/
theorem singularIdeal_le_eval_ker (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0)
    {s : WakModule k} (hs : R.eval s = 0) :
    SingVec.idealGen (affineSl2VOA_closed k hk) s ≤ LinearMap.ker R.eval :=
  SingVec.idealGen_le (eval_isIdeal_ker R hk) (LinearMap.mem_ker.mpr hs)

/-- The quotient map produced directly from a concrete affine-current representation.  The
target `E` need not yet carry a vertex- or near-VOA structure. -/
noncomputable def evalQuotientBySingular (R : VacuumCurrentRealization k E)
    (hk : k + 2 ≠ 0) {s : WakModule k} (hs : R.eval s = 0) :
    (WakModule k ⧸ SingVec.idealGen (affineSl2VOA_closed k hk) s) →ₗ[ℂ] E :=
  (SingVec.idealGen (affineSl2VOA_closed k hk) s).liftQ R.eval
    (singularIdeal_le_eval_ker R hk hs)

@[simp] theorem evalQuotientBySingular_mkQ (R : VacuumCurrentRealization k E)
    (hk : k + 2 ≠ 0) {s : WakModule k} (hs : R.eval s = 0) (x : WakModule k) :
    evalQuotientBySingular R hk hs
      ((SingVec.idealGen (affineSl2VOA_closed k hk) s).mkQ x) = R.eval x := rfl

/-- If the singular vector generates the maximal ideal and the concrete free-field vacuum is
nonzero, the evaluation-induced quotient map is injective. -/
theorem evalQuotientBySingular_injective (R : VacuumCurrentRealization k E)
    (hk : k + 2 ≠ 0) (hRv : R.vacuum ≠ 0) {s : WakModule k} (hs : R.eval s = 0)
    (hmax : SingVec.idealGen (affineSl2VOA_closed k hk) s =
      QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)) :
    Function.Injective (evalQuotientBySingular R hk hs) := by
  rw [← LinearMap.ker_eq_bot]
  apply Submodule.ker_liftQ_eq_bot
  rw [hmax]
  exact QuotVOA.le_maxGradedIdeal' (eval_isIdeal_ker R hk) (by
    intro hvac
    rw [LinearMap.mem_ker, closed_vacuum, vacuumA, R.eval_vacuum] at hvac
    exact hRv hvac)

end AffineEvaluation

/-! ## Target-independent vacuum-and-mode homomorphisms -/

/-- The part of a vertex-algebra homomorphism used by the simple-quotient argument.

The source is a genuine VOA, because its maximal graded ideal and singular quotient are formed
there.  The target is deliberately only a vector space with a vacuum and right-linear mode
products.  This is the correct abstraction for mapping into free-field near-VOAs with
infinite-dimensional weight spaces: no target grading, conformal vector, or CFT-type axiom is
used in the kernel argument. -/
structure VacuumModeHom {A : Type u} {B : Type v}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    (V : VertexOperatorAlgebra A) (vacB : B) (prodB : B → ℤ → B → B)
    (f : A →ₗ[ℂ] B) : Prop where
  /-- The source vacuum maps to the target vacuum. -/
  map_vacuum : f V.vacuum = vacB
  /-- The map intertwines every mode product. -/
  map_smul : ∀ u n x, f (V.smul u n x) = prodB (f u) n (f x)
  /-- Target modes kill the zero vector in their right argument. -/
  prod_zero_right : ∀ u n, prodB u n 0 = 0

namespace VacuumModeHom

variable {A : Type u} {B : Type v}
variable [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
variable {V : VertexOperatorAlgebra A} {vacB : B} {prodB : B → ℤ → B → B}
variable {f : A →ₗ[ℂ] B}

/-- Category-free formulation that a linear map out of a VOA has simple image: the only source
ideals containing its kernel are the kernel and the whole source. -/
def HasSimpleVOAImage (V : VertexOperatorAlgebra A) (f : A →ₗ[ℂ] B) : Prop :=
  ∀ I : Submodule ℂ A, V.IsIdeal I → LinearMap.ker f ≤ I →
    I = LinearMap.ker f ∨ I = ⊤

/-- The kernel of a vacuum-and-mode homomorphism is an ideal of its VOA source. -/
theorem isIdeal_ker (hf : VacuumModeHom V vacB prodB f) :
    V.IsIdeal (LinearMap.ker f) := by
  intro u x n hx
  rw [LinearMap.mem_ker] at hx ⊢
  rw [hf.map_smul, hx, hf.prod_zero_right]

/-- A nonzero target vacuum makes the kernel proper. -/
theorem vacuum_not_mem_ker (hf : VacuumModeHom V vacB prodB f) (hvac : vacB ≠ 0) :
    V.vacuum ∉ LinearMap.ker f := by
  intro h
  rw [LinearMap.mem_ker, hf.map_vacuum] at h
  exact hvac h

/-- Consequently the kernel lies below the unique maximal graded ideal of the VOA source. -/
theorem ker_le_maxGradedIdeal (hf : VacuumModeHom V vacB prodB f) (hvac : vacB ≠ 0) :
    LinearMap.ker f ≤ QuotVOA.maxGradedIdeal V :=
  QuotVOA.le_maxGradedIdeal' hf.isIdeal_ker (hf.vacuum_not_mem_ker hvac)

/-- Category-free formulation that the homomorphic image is simple: the only source ideals
containing the kernel are the kernel and the whole source.  This avoids asking an indefinite
near-VOA target to carry the CFT-type `VertexOperatorAlgebra.IsSimple` API. -/
def HasSimpleImage (_hf : VacuumModeHom V vacB prodB f) : Prop :=
  HasSimpleVOAImage V f

/-- A nonzero-vacuum mode homomorphism with simple image has exactly the maximal source ideal
as kernel. -/
theorem ker_eq_maxGradedIdeal_of_simpleImage
    (hf : VacuumModeHom V vacB prodB f) (hvac : vacB ≠ 0) (hsimple : hf.HasSimpleImage) :
    LinearMap.ker f = QuotVOA.maxGradedIdeal V := by
  have hvacV : V.vacuum ≠ 0 := by
    intro h
    apply hvac
    rw [← hf.map_vacuum, h, map_zero]
  obtain hmax | htop := hsimple (QuotVOA.maxGradedIdeal V)
    (QuotVOA.maxGradedIdeal_isIdeal V) (hf.ker_le_maxGradedIdeal hvac)
  · exact hmax.symm
  · exfalso
    exact QuotVOA.vacuum_not_mem_maxGradedIdeal V hvacV
      (htop.symm ▸ Submodule.mem_top)

end VacuumModeHom

/-! ## Concrete evaluation from the maximal quotient

The following consequences use only the current representation constructed by
`VacuumCurrentRealization`.  In particular the free-field carrier still need not have a
vertex-algebra structure. -/

namespace AffineEvaluation

open AffineVOA.Inst

variable {k : ℂ} {E : Type v} [AddCommGroup E] [Module ℂ E]

/-- If the image of universal current evaluation is simple, its kernel is the affine maximal
ideal.  Strong generation supplies ideality of the kernel; nonvanishing of the concrete vacuum
supplies properness. -/
theorem eval_ker_eq_maxGradedIdeal_of_simpleImage
    (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0) (hRv : R.vacuum ≠ 0)
    (hsimple : VacuumModeHom.HasSimpleVOAImage (affineSl2VOA_closed k hk) R.eval) :
    LinearMap.ker R.eval = QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk) := by
  have hle : LinearMap.ker R.eval ≤
      QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk) :=
    QuotVOA.le_maxGradedIdeal' (eval_isIdeal_ker R hk) (by
      intro hvac
      rw [LinearMap.mem_ker, closed_vacuum, vacuumA, R.eval_vacuum] at hvac
      exact hRv hvac)
  obtain hEq | htop := hsimple (QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk))
    (QuotVOA.maxGradedIdeal_isIdeal _) hle
  · exact hEq.symm
  · exfalso
    exact QuotVOA.vacuum_not_mem_maxGradedIdeal (affineSl2VOA_closed k hk)
      (by
        intro hvac
        rw [closed_vacuum, vacuumA] at hvac
        apply hRv
        rw [← R.eval_vacuum, hvac, map_zero])
      (htop.symm ▸ Submodule.mem_top)

/-- Linear map from the simple affine quotient induced by a concrete current realization whose
kernel has already been identified with the maximal ideal. -/
noncomputable def evalMaxQuotient (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0)
    (hker : LinearMap.ker R.eval =
      QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)) :
    (WakModule k ⧸ QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)) →ₗ[ℂ] E :=
  (QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)).liftQ R.eval (by
    rw [← hker])

@[simp] theorem evalMaxQuotient_mkQ (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0)
    (hker : LinearMap.ker R.eval =
      QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)) (x : WakModule k) :
    evalMaxQuotient R hk hker
      ((QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)).mkQ x) = R.eval x := rfl

/-- Exactness at the source makes the descended maximal-quotient evaluation injective. -/
theorem evalMaxQuotient_injective (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0)
    (hker : LinearMap.ker R.eval =
      QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)) :
    Function.Injective (evalMaxQuotient R hk hker) := by
  rw [← LinearMap.ker_eq_bot]
  exact Submodule.ker_liftQ_eq_bot _ _ _ (le_of_eq hker)

/-- Passing from the universal affine vacuum module to its simple quotient does not change the
image in the free-field carrier. -/
theorem range_evalMaxQuotient_eq (R : VacuumCurrentRealization k E) (hk : k + 2 ≠ 0)
    (hker : LinearMap.ker R.eval =
      QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)) :
    LinearMap.range (evalMaxQuotient R hk hker) = LinearMap.range R.eval := by
  apply le_antisymm
  · rintro y ⟨q, rfl⟩
    obtain ⟨x, rfl⟩ :=
      (QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)).mkQ_surjective q
    exact ⟨x, rfl⟩
  · rintro y ⟨x, rfl⟩
    exact ⟨(QuotVOA.maxGradedIdeal (affineSl2VOA_closed k hk)).mkQ x, rfl⟩

end AffineEvaluation

/-- Every VOA homomorphism has the target-independent vacuum-and-mode interface. -/
def IsVOAHom.toVacuumModeHom {A : Type u} {B : Type v}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    {V : VertexOperatorAlgebra A} {W : VertexOperatorAlgebra B} {f : A →ₗ[ℂ] B}
    (hf : IsVOAHom V W f) : VacuumModeHom V W.vacuum W.smul f where
  map_vacuum := hf.map_vacuum
  map_smul := hf.map_smul
  prod_zero_right := W.toPreVertexAlgebra.smul_zero_right

/-- A mode-preserving map from a VOA into an ordinary near-VOA.  Unlike `IsVOAHom`, this
notion imposes no finite-dimensionality or CFT-type condition on the target. -/
structure IsVOAToNearVOAHom {A : Type u} {B : Type v}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    (V : VertexOperatorAlgebra A) (W : NearVOA B) (f : A →ₗ[ℂ] B) : Prop where
  map_vacuum : f V.vacuum = W.vacuum
  map_smul : ∀ u n x, f (V.smul u n x) = mode (W.Y (f u)) n (f x)

/-- Forget an ordinary near-VOA target down to the target-independent interface. -/
def IsVOAToNearVOAHom.toVacuumModeHom {A : Type u} {B : Type v}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    {V : VertexOperatorAlgebra A} {W : NearVOA B} {f : A →ₗ[ℂ] B}
    (hf : IsVOAToNearVOAHom V W f) :
    VacuumModeHom V W.vacuum (fun u n x => mode (W.Y u) n x) f where
  map_vacuum := hf.map_vacuum
  map_smul := hf.map_smul
  prod_zero_right := fun u n => map_zero (mode (W.Y u) n)

/-- A bosonic VOA homomorphism into a super near-VOA.  The quotient argument needs only mode
preservation.  An application that needs the image to lie in the even sector should add that as
a separate hypothesis; it is irrelevant for factorization and injectivity. -/
structure IsVOAToSuperNearVOAHom {A : Type u} {B : Type v}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    (V : VertexOperatorAlgebra A) (W : SuperNearVOA B) (f : A →ₗ[ℂ] B) : Prop where
  map_vacuum : f V.vacuum = W.vacuum
  map_smul : ∀ u n x, f (V.smul u n x) = W.smul (f u) n (f x)

/-- Forget a super near-VOA target down to the target-independent interface. -/
def IsVOAToSuperNearVOAHom.toVacuumModeHom {A : Type u} {B : Type v}
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    {V : VertexOperatorAlgebra A} {W : SuperNearVOA B} {f : A →ₗ[ℂ] B}
    (hf : IsVOAToSuperNearVOAHom V W f) :
    VacuumModeHom V W.vacuum W.smul f where
  map_vacuum := hf.map_vacuum
  map_smul := hf.map_smul
  prod_zero_right := fun u n => map_zero (mode (W.Y u) n)

/-! ## Factoring a homomorphism through the singular quotient -/

variable {Source : Type u} [AddCommGroup Source] [Module ℂ Source]
variable {Target : Type v} [AddCommGroup Target] [Module ℂ Target]
variable {SourceVOA : VertexOperatorAlgebra Source}
variable {targetVacuum : Target} {targetProd : Target → ℤ → Target → Target}
variable {f : Source →ₗ[ℂ] Target} {singular : Source}

/-- Killing one vector kills the VOA ideal it generates, for an arbitrary
vacuum-and-mode target. -/
theorem singularIdeal_le_ker_mode
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hs : f singular = 0) :
    SingVec.idealGen SourceVOA singular ≤ LinearMap.ker f :=
  SingVec.idealGen_le hf.isIdeal_ker (LinearMap.mem_ker.mpr hs)

/-- The linear map induced on the quotient by the singular ideal. -/
noncomputable def quotientBySingularModeHom
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hs : f singular = 0) :
    (Source ⧸ SingVec.idealGen SourceVOA singular) →ₗ[ℂ] Target :=
  (SingVec.idealGen SourceVOA singular).liftQ f (singularIdeal_le_ker_mode hf hs)

@[simp] theorem quotientBySingularModeHom_mkQ
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hs : f singular = 0)
    (x : Source) :
    quotientBySingularModeHom hf hs ((SingVec.idealGen SourceVOA singular).mkQ x) = f x := rfl

/-- The descended map still preserves the vacuum and every mode.  Notice that the target is
still only the abstract mode target; no grading or finiteness has been introduced. -/
theorem quotientBySingularModeHom_isVacuumModeHom
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hs : f singular = 0) :
    VacuumModeHom (SingVec.quotientBySingular SourceVOA singular)
      targetVacuum targetProd (quotientBySingularModeHom hf hs) where
  map_vacuum := hf.map_vacuum
  map_smul := by
    intro u n x
    obtain ⟨u, rfl⟩ := (SingVec.idealGen SourceVOA singular).mkQ_surjective u
    obtain ⟨x, rfl⟩ := (SingVec.idealGen SourceVOA singular).mkQ_surjective x
    rw [SingVec.quotientBySingular_mkQ_smul, quotientBySingularModeHom_mkQ,
      quotientBySingularModeHom_mkQ, quotientBySingularModeHom_mkQ, hf.map_smul]
  prod_zero_right := hf.prod_zero_right

/-- If the singular vector generates the source maximal ideal, a nonzero target vacuum forces
the kernel of the original map to be exactly that maximal ideal. -/
theorem ker_eq_maxGradedIdeal_of_singular_mode
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hvac : targetVacuum ≠ 0)
    (hs : f singular = 0)
    (hmax : SingVec.idealGen SourceVOA singular = QuotVOA.maxGradedIdeal SourceVOA) :
    LinearMap.ker f = QuotVOA.maxGradedIdeal SourceVOA := by
  apply le_antisymm (hf.ker_le_maxGradedIdeal hvac)
  rw [← hmax]
  exact singularIdeal_le_ker_mode hf hs

/-- The finite singular-vector calculation therefore gives an embedding of the simple
quotient into any vacuum-and-mode target. -/
theorem quotientBySingularModeHom_injective
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hvac : targetVacuum ≠ 0)
    (hs : f singular = 0)
    (hmax : SingVec.idealGen SourceVOA singular = QuotVOA.maxGradedIdeal SourceVOA) :
    Function.Injective (quotientBySingularModeHom hf hs) := by
  rw [← LinearMap.ker_eq_bot]
  exact Submodule.ker_liftQ_eq_bot _ _ _ (by
    rw [hmax]
    exact le_of_eq (ker_eq_maxGradedIdeal_of_singular_mode hf hvac hs hmax))

/-- The descended generic map, viewed specifically as a homomorphism into an ordinary
near-VOA. -/
theorem quotientBySingularModeHom_isVOAToNearVOAHom
    {W : NearVOA Target} (hf : IsVOAToNearVOAHom SourceVOA W f)
    (hs : f singular = 0) :
    IsVOAToNearVOAHom (SingVec.quotientBySingular SourceVOA singular) W
      (quotientBySingularModeHom hf.toVacuumModeHom hs) := by
  let hdesc := quotientBySingularModeHom_isVacuumModeHom hf.toVacuumModeHom hs
  exact ⟨hdesc.map_vacuum, hdesc.map_smul⟩

/-- The analogous descended map into a super near-VOA. -/
theorem quotientBySingularModeHom_isVOAToSuperNearVOAHom
    {W : SuperNearVOA Target} (hf : IsVOAToSuperNearVOAHom SourceVOA W f)
    (hs : f singular = 0) :
    IsVOAToSuperNearVOAHom (SingVec.quotientBySingular SourceVOA singular) W
      (quotientBySingularModeHom hf.toVacuumModeHom hs) := by
  let hdesc := quotientBySingularModeHom_isVacuumModeHom hf.toVacuumModeHom hs
  exact ⟨hdesc.map_vacuum, hdesc.map_smul⟩

/-! ## Literature-facing singular and screening interfaces -/

/-- The Lean-facing content of the singular-image identity in Adamović, Corollary 5.3:
the affine maximal singular generator maps to a Virasoro singular vector multiplied by a
lattice exponential.

This predicate is parameterized by the source VOA and singular vector, so the same theorem below
applies uniformly to every boundary parameter once its affine singular vector has been
constructed.  The separate equality saying that the Virasoro factor vanishes in the simple
Virasoro quotient is intentionally not folded into the identity. -/
def AdamovicCor53SingularImage
    (f : Source →ₗ[ℂ] Target) (singular : Source) (virSingularTimesExp : Target) : Prop :=
  f singular = virSingularTimesExp

/-- Corollary 5.3 plus vanishing of the Virasoro singular factor gives exactly the finite
factorization hypothesis. -/
theorem singular_vanishes_of_adamovicCor53
    {virSingularTimesExp : Target}
    (himage : AdamovicCor53SingularImage f singular virSingularTimesExp)
    (hvir : virSingularTimesExp = 0) :
    f singular = 0 := by
  rw [himage, hvir]

/-- **Uniform boundary-family quotient gate.**  Adamović's singular-image identity, the
Virasoro null relation, and maximal-ideal generation imply an embedding of the affine simple
quotient into any nonzero vacuum-and-mode target.  This is parameterized by the source rather
than by a hard-coded formula for the boundary levels, because the repository currently contains
only the explicit affine singular vector at `-8/5`. -/
theorem adamovicCor53_quotient_injective
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hvac : targetVacuum ≠ 0)
    {virSingularTimesExp : Target}
    (himage : AdamovicCor53SingularImage f singular virSingularTimesExp)
    (hvir : virSingularTimesExp = 0)
    (hmax : SingVec.idealGen SourceVOA singular = QuotVOA.maxGradedIdeal SourceVOA) :
    Function.Injective
      (quotientBySingularModeHom hf
        (singular_vanishes_of_adamovicCor53 himage hvir)) :=
  quotientBySingularModeHom_injective hf hvac _ hmax

/-- The precise image statement supplied in the vacuum case by Adamović--Milas,
arXiv:2502.01766, Proposition 2.1, should be instantiated with
`sector = L^Vir(c, h_(1,n+1)) ⊗ Pi(0)^(1/2)`.  At `n = 0`, it identifies the simple affine
vacuum algebra with the screening kernel *inside this half-lattice sector*.

Recording the sector in the predicate prevents the commonly over-strong replacement by the
kernel on an unspecified full Pi ambient algebra. -/
def AdamovicMilasProp21SectorImage
    {Shifted : Type w} [AddCommGroup Shifted] [Module ℂ Shifted]
    (f : Source →ₗ[ℂ] Target) (sector : Submodule ℂ Target)
    (screening : Target →ₗ[ℂ] Shifted) : Prop :=
  LinearMap.range f = sector ⊓ LinearMap.ker screening

/-- The exact sector-image hypothesis implies both containment in the sector screening kernel
and surjectivity onto it. -/
theorem adamovicMilasProp21SectorImage_iff
    {Shifted : Type w} [AddCommGroup Shifted] [Module ℂ Shifted]
    {sector : Submodule ℂ Target} {screening : Target →ₗ[ℂ] Shifted} :
    AdamovicMilasProp21SectorImage f sector screening ↔
      (∀ x, f x ∈ sector ∧ screening (f x) = 0) ∧
      (∀ y, y ∈ sector → screening y = 0 → ∃ x, f x = y) := by
  constructor
  · intro h
    constructor
    · intro x
      have hx : f x ∈ LinearMap.range f := ⟨x, rfl⟩
      rw [h, Submodule.mem_inf, LinearMap.mem_ker] at hx
      exact hx
    · intro y hy hsy
      have hy' : y ∈ sector ⊓ LinearMap.ker screening :=
        Submodule.mem_inf.mpr ⟨hy, LinearMap.mem_ker.mpr hsy⟩
      rw [← h] at hy'
      exact hy'
  · rintro ⟨hin, honto⟩
    apply le_antisymm
    · rintro y ⟨x, rfl⟩
      exact Submodule.mem_inf.mpr
        ⟨(hin x).1, LinearMap.mem_ker.mpr (hin x).2⟩
    · intro y hy
      rw [Submodule.mem_inf, LinearMap.mem_ker] at hy
      obtain ⟨x, rfl⟩ := honto y hy.1 hy.2
      exact ⟨x, rfl⟩

/-- Compatibility data for a screening `Q` which maps the free-field ambient space to a
possibly different, shifted module.  `shiftedAction a n` is the action of an ambient current
state `a` on the target module.  The commutation law is required only for currents in the
affine image, which is exactly what is needed to make `ker Q` an affine submodule.

This formulation covers the Adamović--Milas operator
`Res Y(v^(k) ⊗ exp(nu), z)`, whose natural codomain is shifted; it is strictly more general
than `Core.Screening`, where a screening is the zero mode of a state and hence an endomorphism
of one VOA. -/
structure ExternalScreeningCompatibility
    {Shifted : Type w} [AddCommGroup Shifted] [Module ℂ Shifted]
    (ambientVacuum : Target) (ambientProd : Target → ℤ → Target → Target)
    (shiftedAction : Target → ℤ → Shifted → Shifted)
    (f : Source →ₗ[ℂ] Target) (screening : Target →ₗ[ℂ] Shifted) : Prop where
  /-- The ambient vacuum lies in the external screening kernel. -/
  map_vacuum : screening ambientVacuum = 0
  /-- The screening commutes with modes of all currents in the affine image. -/
  commutes_image_modes : ∀ u n x,
    screening (ambientProd (f u) n x) = shiftedAction (f u) n (screening x)
  /-- A target-module mode kills zero. -/
  action_zero_right : ∀ a n, shiftedAction a n 0 = 0

/-- The kernel of an external compatible screening is stable under all modes coming from the
affine image. -/
theorem ExternalScreeningCompatibility.imageMode_mem_ker
    {Shifted : Type w} [AddCommGroup Shifted] [Module ℂ Shifted]
    {ambientVacuum : Target} {ambientProd : Target → ℤ → Target → Target}
    {shiftedAction : Target → ℤ → Shifted → Shifted}
    {screening : Target →ₗ[ℂ] Shifted}
    (hQ : ExternalScreeningCompatibility ambientVacuum ambientProd shiftedAction f screening)
    (u : Source) (n : ℤ) {x : Target} (hx : x ∈ LinearMap.ker screening) :
    ambientProd (f u) n x ∈ LinearMap.ker screening := by
  rw [LinearMap.mem_ker] at hx ⊢
  rw [hQ.commutes_image_modes, hx, hQ.action_zero_right]

/-- Complete Lean-facing interface for the vacuum case of Adamović--Milas Proposition 2.1.
It records all three logically distinct pieces supplied by the analytic construction:

* the affine image is the kernel of an *external* screening in the specified half-lattice
  sector;
* the external screening commutes with the affine current modes, with values in its shifted
  module;
* that image is the simple affine vacuum algebra.

The last field is kept separate because sector-kernel equality and mode compatibility alone do
not prove simplicity. -/
structure AdamovicMilasProp21VacuumIdentification
    {Shifted : Type w} [AddCommGroup Shifted] [Module ℂ Shifted]
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f)
    (sector : Submodule ℂ Target) (screening : Target →ₗ[ℂ] Shifted)
    (shiftedAction : Target → ℤ → Shifted → Shifted) : Prop where
  sector_image : AdamovicMilasProp21SectorImage f sector screening
  screening_compatible :
    ExternalScreeningCompatibility targetVacuum targetProd shiftedAction f screening
  simple_image : hf.HasSimpleImage

/-- The exact Proposition 2.1 interface identifies the kernel of the universal affine map with
its maximal ideal. -/
theorem ker_eq_maxGradedIdeal_of_adamovicMilasProp21
    {Shifted : Type w} [AddCommGroup Shifted] [Module ℂ Shifted]
    (hf : VacuumModeHom SourceVOA targetVacuum targetProd f) (hvac : targetVacuum ≠ 0)
    {sector : Submodule ℂ Target} {screening : Target →ₗ[ℂ] Shifted}
    {shiftedAction : Target → ℤ → Shifted → Shifted}
    (hAM : AdamovicMilasProp21VacuumIdentification hf sector screening shiftedAction) :
    LinearMap.ker f = QuotVOA.maxGradedIdeal SourceVOA :=
  hf.ker_eq_maxGradedIdeal_of_simpleImage hvac hAM.simple_image

variable {VType : Type u} [AddCommGroup VType] [Module ℂ VType]
variable {TType : Type v} [AddCommGroup TType] [Module ℂ TType]
variable {V : VertexOperatorAlgebra VType} {T : VertexOperatorAlgebra TType}
variable {φ : VType →ₗ[ℂ] TType} {s : VType}

/-- Killing `s` kills the whole VOA ideal generated by `s`. -/
theorem singularIdeal_le_ker (hφ : IsVOAHom V T φ) (hs : φ s = 0) :
    SingVec.idealGen V s ≤ LinearMap.ker φ :=
  SingVec.idealGen_le hφ.isIdeal_ker (LinearMap.mem_ker.mpr hs)

/-- The generated ideal lies in the kernel exactly when its generator does. -/
theorem singularIdeal_le_ker_iff (hφ : IsVOAHom V T φ) :
    SingVec.idealGen V s ≤ LinearMap.ker φ ↔ φ s = 0 := by
  constructor
  · intro h
    exact LinearMap.mem_ker.mp (h (SingVec.mem_idealGen_self V s))
  · exact singularIdeal_le_ker hφ

/-- The map induced on the quotient by the singular ideal. -/
noncomputable def quotientBySingularHom (hφ : IsVOAHom V T φ) (hs : φ s = 0) :
    (VType ⧸ SingVec.idealGen V s) →ₗ[ℂ] TType :=
  (SingVec.idealGen V s).liftQ φ (singularIdeal_le_ker hφ hs)

@[simp] theorem quotientBySingularHom_mkQ (hφ : IsVOAHom V T φ) (hs : φ s = 0)
    (x : VType) :
    quotientBySingularHom hφ hs ((SingVec.idealGen V s).mkQ x) = φ x := rfl

/-- The induced linear map is again a VOA homomorphism. -/
theorem quotientBySingularHom_isVOAHom (hφ : IsVOAHom V T φ) (hs : φ s = 0) :
    IsVOAHom (SingVec.quotientBySingular V s) T (quotientBySingularHom hφ hs) where
  map_vacuum := hφ.map_vacuum
  map_smul := by
    intro u n v
    obtain ⟨u, rfl⟩ := (SingVec.idealGen V s).mkQ_surjective u
    obtain ⟨v, rfl⟩ := (SingVec.idealGen V s).mkQ_surjective v
    rw [SingVec.quotientBySingular_mkQ_smul, quotientBySingularHom_mkQ,
      quotientBySingularHom_mkQ, quotientBySingularHom_mkQ, hφ.map_smul]

/-- **Exact kernel theorem from the finite null calculation.**  If the standard affine
representation-theoretic input says that the maximal ideal is generated by `s`, then a
vacuum-preserving VOA map to a nonzero target has exactly the maximal ideal as kernel as soon as
it kills `s`. -/
theorem ker_eq_maxGradedIdeal_of_singular (hφ : IsVOAHom V T φ) (hT : T.vacuum ≠ 0)
    (hs : φ s = 0)
    (hmax : SingVec.idealGen V s = QuotVOA.maxGradedIdeal V) :
    LinearMap.ker φ = QuotVOA.maxGradedIdeal V := by
  apply le_antisymm (hφ.ker_le_maxGradedIdeal hT)
  rw [← hmax]
  exact singularIdeal_le_ker hφ hs

/-- The induced map from the simple quotient is injective.  No surjectivity onto the ambient
free-field VOA is required for the inverse-DS embedding. -/
theorem quotientBySingularHom_injective (hφ : IsVOAHom V T φ) (hT : T.vacuum ≠ 0)
    (hs : φ s = 0)
    (hmax : SingVec.idealGen V s = QuotVOA.maxGradedIdeal V) :
    Function.Injective (quotientBySingularHom hφ hs) := by
  rw [← LinearMap.ker_eq_bot]
  exact Submodule.ker_liftQ_eq_bot _ _ _ (by
    rw [hmax]
    exact le_of_eq (ker_eq_maxGradedIdeal_of_singular hφ hT hs hmax))

/-! ## The boundary `sl₂` specialization -/

/-- The standard external representation-theoretic input still absent from the repository:
the known weight-five singular vector generates the maximal ideal at level `-8/5`. -/
def K85MaxIdealGenerated : Prop :=
  SingVec.idealGen (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num))
      sl2Singular85 =
    QuotVOA.maxGradedIdeal
      (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num))

/-- Once a concrete inverse-DS homomorphism and the finite weight-five vanishing are supplied,
the map descends injectively from `L_{-8/5}(sl₂)` (assuming `K85MaxIdealGenerated`). -/
theorem k85_inverseDS_quotient_injective
    {A : Type u} [AddCommGroup A] [Module ℂ A] {W : VertexOperatorAlgebra A}
    {φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A}
    (hφ : IsVOAHom (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) W φ)
    (hW : W.vacuum ≠ 0) (hnull : φ sl2Singular85 = 0)
    (hmax : K85MaxIdealGenerated) :
    Function.Injective (quotientBySingularHom hφ hnull) :=
  quotientBySingularHom_injective hφ hW hnull hmax

/-- **The finite Adamović route in one theorem.**  To obtain the simple-quotient embedding it
is enough to construct the affine VOA homomorphism, prove that it intertwines the three current
modes, and reduce the literal weight-five target expression to zero.  The remaining
representation-theoretic input is exactly `K85MaxIdealGenerated`.

In Adamović's construction the stronger intermediate identity identifies this target expression
with the Lee--Yang vacuum singular vector times a lattice exponential (Corollary 5.3); after the
Virasoro simple quotient that right-hand side is zero, and Theorem 5.5 supplies the resulting
factorization.  This theorem records the Lean-facing specialization without pretending that the
ambient tensor VOA or that intermediate identity has already been constructed. -/
theorem k85_inverseDS_quotient_injective_of_current_eval
    {A : Type u} [AddCommGroup A] [Module ℂ A] {W : VertexOperatorAlgebra A}
    (K : Fin 3 → ℤ → End ℂ A)
    {φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A}
    (hφ : IsVOAHom (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) W φ)
    (hW : W.vacuum ≠ 0)
    (hmode : ∀ a m x, φ (J (-8 / 5 : ℂ) a m x) = K a m (φ x))
    (heval : sl2Singular85Eval K W.vacuum = 0)
    (hmax : K85MaxIdealGenerated) :
    Function.Injective
      (quotientBySingularHom hφ
        (show φ sl2Singular85 = 0 by
          rw [map_sl2Singular85 K W.vacuum φ hφ.map_vacuum hmode, heval])) := by
  apply quotientBySingularHom_injective hφ hW _ hmax

/-! ### The same `-8/5` gate in the correct free-field target category -/

/-- The simple-quotient embedding at `-8/5` with an ordinary near-VOA target.  This is the
version intended for `Vir ⊗ Pi(0)`: it does not assume finite-dimensional weight spaces or
CFT type in the target. -/
theorem k85_inverseDS_near_quotient_injective
    {A : Type v} [AddCommGroup A] [Module ℂ A] {W : NearVOA A}
    {φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A}
    (hφ : IsVOAToNearVOAHom
      (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) W φ)
    (hW : W.vacuum ≠ 0) (hnull : φ sl2Singular85 = 0)
    (hmax : K85MaxIdealGenerated) :
    Function.Injective (quotientBySingularModeHom hφ.toVacuumModeHom hnull) :=
  quotientBySingularModeHom_injective hφ.toVacuumModeHom hW hnull hmax

/-- The finite twenty-one-term current calculation, with an ordinary near-VOA target. -/
theorem k85_inverseDS_near_quotient_injective_of_current_eval
    {A : Type v} [AddCommGroup A] [Module ℂ A] {W : NearVOA A}
    (K : Fin 3 → ℤ → End ℂ A)
    {φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A}
    (hφ : IsVOAToNearVOAHom
      (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) W φ)
    (hW : W.vacuum ≠ 0)
    (hmode : ∀ a m x, φ (J (-8 / 5 : ℂ) a m x) = K a m (φ x))
    (heval : sl2Singular85Eval K W.vacuum = 0)
    (hmax : K85MaxIdealGenerated) :
    Function.Injective
      (quotientBySingularModeHom hφ.toVacuumModeHom
        (show φ sl2Singular85 = 0 by
          rw [map_sl2Singular85 K W.vacuum φ hφ.map_vacuum hmode, heval])) := by
  apply quotientBySingularModeHom_injective hφ.toVacuumModeHom hW _ hmax

/-- The `-8/5` specialization of the named Adamović Corollary 5.3 interface for a near-VOA
free-field target. -/
theorem k85_inverseDS_near_quotient_injective_of_adamovicCor53
    {A : Type v} [AddCommGroup A] [Module ℂ A] {W : NearVOA A}
    {φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A}
    (hφ : IsVOAToNearVOAHom
      (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) W φ)
    (hW : W.vacuum ≠ 0) {virSingularTimesExp : A}
    (himage : AdamovicCor53SingularImage φ sl2Singular85 virSingularTimesExp)
    (hvir : virSingularTimesExp = 0)
    (hmax : K85MaxIdealGenerated) :
    Function.Injective
      (quotientBySingularModeHom hφ.toVacuumModeHom
        (singular_vanishes_of_adamovicCor53 himage hvir)) :=
  adamovicCor53_quotient_injective hφ.toVacuumModeHom hW himage hvir hmax

/-! ## A narrower state-endomorphism screening route

The following older `Core.Screening` criterion remains useful when the screening really is a
zero-mode endomorphism of one CFT-type VOA and its kernel in that whole VOA is the image.  It is
not the literal Adamović--Milas Proposition 2.1 setup: there the screening is external, lands in
a shifted module, and the kernel is taken in a specified Virasoro--half-lattice sector.  That
correct interface is `AdamovicMilasProp21VacuumIdentification` above. -/

/-- At level `-8/5`, an affine homomorphism whose image is exactly a simple screening kernel has
the maximal affine ideal as its kernel.  This conditional criterion does not assume
`K85MaxIdealGenerated`, but its hypotheses should not be inferred from sector-kernel results. -/
theorem k85_ker_eq_maxGradedIdeal_of_screeningKernel
    {A : Type u} [AddCommGroup A] [Module ℂ A] {W : VertexOperatorAlgebra A}
    {a : A} (ha : a ∈ W.grading 1)
    {φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A}
    (hφ : IsVOAHom (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) W φ)
    (hin : ∀ x, Screening.screening W a (φ x) = 0)
    (honto : ∀ y, Screening.screening W a y = 0 → ∃ x, φ x = y)
    (hsimple : (Screening.screeningKernelVOA W a ha).IsSimple) :
    LinearMap.ker φ = QuotVOA.maxGradedIdeal
      (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) :=
  Screening.ker_eq_maxGradedIdeal_of_screeningKernel ha hφ hin honto hsimple

/-- Under the same screening-kernel hypotheses, the explicit weight-five singular vector
vanishes automatically.  Thus a direct twenty-one-term free-field computation is a useful
finite check, but it is logically redundant once exact image and simplicity are known. -/
theorem k85_singular_vanishes_of_screeningKernel
    {A : Type u} [AddCommGroup A] [Module ℂ A] {W : VertexOperatorAlgebra A}
    {a : A} (ha : a ∈ W.grading 1)
    {φ : WakModule (-8 / 5 : ℂ) →ₗ[ℂ] A}
    (hφ : IsVOAHom (AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) (by norm_num)) W φ)
    (hin : ∀ x, Screening.screening W a (φ x) = 0)
    (honto : ∀ y, Screening.screening W a y = 0 → ∃ x, φ x = y)
    (hsimple : (Screening.screeningKernelVOA W a ha).IsSimple) :
    φ sl2Singular85 = 0 := by
  rw [← LinearMap.mem_ker]
  rw [k85_ker_eq_maxGradedIdeal_of_screeningKernel ha hφ hin honto hsimple]
  exact Sl2NotSimple85.mem_maxGradedIdeal_85

end
