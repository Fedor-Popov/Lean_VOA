import VOA.Examples.VirasoroLengthTwoTowers
import VOA.Examples.VirasoroGram4
import VOA.Examples.LeeYangProper

/-!
# Quotient survival and the Lee--Yang exception for length two

This file gives the canonical-radical criterion needed to pass a nonzero length-two norm to the
simple quotient.  It also identifies `Q₄` exactly with one fifth of the Lee--Yang singular vector,
so its exceptional vanishing in `L(-22/5,0)` is unconditional.
-/

set_option linter.style.longLine false

namespace VOA

namespace VirGradedUnitarity

open VOA.VirModule VOA.VirSimple
open VOA.VertexOperatorAlgebra

variable (c : ℂ)

/-- A vector with nonzero canonical self-pairing cannot die in the simple quotient. -/
theorem mkQ_ne_zero_of_canB_self_ne_zero {x : VirUniv c}
    (hx : (VirGram4.canB c).form x x ≠ 0) : (maxIdealVir c).mkQ x ≠ 0 := by
  intro hzero
  have hideal : x ∈ maxIdealVir c := (Submodule.Quotient.mk_eq_zero _).mp hzero
  have hrad : x ∈ InvariantForm.leftRadical (VirGram4.canB c) := by
    rw [VirGram4.canB, LiRadical.leftRadical_canonical_eq_maxGradedIdeal]
    exact hideal
  have hfun := InvariantForm.mem_leftRadical.mp hrad
  exact hx (DFunLike.congr_fun hfun x)

/-- Conditional survival of `Q_{2m}`: the only missing input is its explicit base norm. -/
theorem lengthTwoQSimple_ne_zero_of_canB_self_ne_zero (m : ℕ)
    (hnorm : (VirGram4.canB c).form (lengthTwoQ c m) (lengthTwoQ c m) ≠ 0) :
    lengthTwoQSimple c m ≠ 0 := by
  exact mkQ_ne_zero_of_canB_self_ne_zero c hnorm

/-- The closed canonical norm of the first length-two quasi-primary:
`(Q₄|Q₄) = c(5c+22)/10`. -/
theorem canB_lengthTwoQ_two_self :
    (VirGram4.canB c).form (lengthTwoQ c 2) (lengthTwoQ c 2) =
      c * (5 * c + 22) / 10 := by
  rw [lengthTwoQ_two, LeeYang.negWordVir_zero_zero,
    LeeYang.negWordVir_two]
  simp only [map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul,
    VirGram4.canB_L2L2_L2L2,
    VirGram4.canB_L2L2_L4, VirGram4.canB_L4_L2L2, VirGram4.canB_L4_L4]
  ring

/-- Away from `c=0,-22/5`, the `Q₄` direction survives in the simple quotient. -/
theorem lengthTwoQSimple_two_ne_zero (hc0 : c ≠ 0) (hcLY : 5 * c + 22 ≠ 0) :
    lengthTwoQSimple c 2 ≠ 0 := by
  apply lengthTwoQSimple_ne_zero_of_canB_self_ne_zero
  rw [canB_lengthTwoQ_two_self]
  exact div_ne_zero (mul_ne_zero hc0 hcLY) (by norm_num)

end VirGradedUnitarity

namespace LeeYang

open VOA.VirModule VOA.VirSimple
open VOA.VirGradedUnitarity

/-- The chosen normalization is exactly `5Q₄ = s`, where `s` is the primitive Lee--Yang
singular vector. -/
theorem five_smul_lengthTwoQ_two :
    (5 : ℂ) • lengthTwoQ leeYangC 2 = leeYangSingular := by
  rw [lengthTwoQ_two, negWordVir_zero_zero,
    negWordVir_two, leeYangSingular]
  module

/-- The exceptional length-two quasi-primary `Q₄` dies in the Lee--Yang simple quotient. -/
theorem mkQ_lengthTwoQ_two_eq_zero :
    (maxIdealVir leeYangC).mkQ (lengthTwoQ leeYangC 2) = 0 := by
  apply eq_zero_of_smul_eq_zero (by norm_num : (5 : ℂ) ≠ 0)
  rw [← map_smul, five_smul_lengthTwoQ_two, mkQ_leeYangSingular_eq_zero]

/-- In the notation used for all simple-quotient length-two generators, `Q₄` is zero at the
Lee--Yang charge. -/
theorem lengthTwoQSimple_two_eq_zero : lengthTwoQSimple leeYangC 2 = 0 :=
  mkQ_lengthTwoQ_two_eq_zero

/-- The entire global tower generated by the Lee--Yang `Q₄` vanishes in the simple quotient. -/
theorem lengthTwoQSimple_two_tower_eq_zero (r : ℕ) :
    ((virasoroSimple leeYangC).L (-1) ^ r) (lengthTwoQSimple leeYangC 2) = 0 := by
  rw [lengthTwoQSimple_two_eq_zero, map_zero]

end LeeYang

end VOA
