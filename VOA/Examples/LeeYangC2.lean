import VOA.Examples.LeeYangProper
import VOA.Examples.VirasoroQuotientForm
import VOA.Examples.TripletW2Nilpotent

/-!
# C2-cofiniteness and strong finiteness of the Lee--Yang simple Virasoro VOA

This file proves that the simple quotient `L(-22/5,0)` is `C2Cofinite`, and hence
`StronglyFinite`.  The proof uses only the already established universal-Virasoro spanning
theorem and the level-four singular-vector relation

`5 L_{-2}^2 |0> - 3 L_{-4} |0> = 0`

in the simple quotient.  The quotient is strongly generated by its conformal vector.  In its
Poisson quotient the `L_{-4}|0>` term is zero because it is a mode of index `-3`, so the relation
has the orientation `5 [omega]^2 = 0`, and therefore `[omega]^2 = 0`.  The existing finite
nilpotent-generator criterion then gives `C2Cofinite`, with the explicit bound
`finrank_C A2(L(-22/5,0)) <= 2`.

Nothing here proves admissible rationality or regularity.  The last two declarations package the
exact remaining route: either of those genuine module-theoretic inputs upgrades the unconditional
strong-finiteness theorem to `StronglyRational`.
-/

namespace VOA.LeeYangC2

open VOA
open VOA.VertexOperatorAlgebra
open VOA.VirModule
open VOA.VirSimple
open VOA.VirQuotForm
open VOA.LeeYang
open VOA.TripletNilp

/-! ## Strong generation by the conformal vector -/

/-- Every negative Virasoro creation word remains an iterated product of the conformal vector
after passage to the simple quotient. -/
theorem mkQ_negWordVir_mem_iterProdSpan (c : ℂ) (ws : List ℕ) :
    (maxIdealVir c).mkQ (negWordVir c ws) ∈
      iterProdSpan (virasoroSimple c) {(virasoroSimple c).conformalVector} := by
  induction ws with
  | nil =>
      rw [negWordVir_nil, ← virasoroSimple_vacuum]
      exact vacuum_mem_iterProdSpan _ _
  | cons n ws ih =>
      rw [negWordVir_cons, ← virasoroVOA_L_eq_Lop, mkQ_L,
        VertexOperatorAlgebra.L_def, ← PreVertexAlgebra.smul_def]
      simpa only [show (-((n : ℤ) + 1)) = -1 - (n : ℤ) by ring,
        show (-(n : ℤ) - 2 + 1) = -1 - (n : ℤ) by ring] using
        smul_mem_iterProdSpan (virasoroSimple c)
        {(virasoroSimple c).conformalVector} (Set.mem_singleton _)
        (m := (n : ℤ) + 1) (by omega) ih

/-- The simple Virasoro quotient is strongly generated by its conformal vector, for every central
charge.  This is the quotient descent of `negSpanVir_eq_top`; it does not use an equality between
the maximal ideal and any chosen singular-vector submodule. -/
theorem virasoroSimple_iterProdSpan_conformalVector_eq_top (c : ℂ) :
    iterProdSpan (virasoroSimple c) {(virasoroSimple c).conformalVector} = ⊤ := by
  rw [eq_top_iff]
  intro x hx
  clear hx
  obtain ⟨u, rfl⟩ := virasoroSimple_mkQ_surjective c x
  have hu : u ∈ negSpanVir c := by rw [negSpanVir_eq_top c]; trivial
  induction hu using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨ws, rfl⟩ := hy
      exact mkQ_negWordVir_mem_iterProdSpan c ws
  | zero =>
      rw [map_zero]
      exact (iterProdSpan (virasoroSimple c)
        {(virasoroSimple c).conformalVector}).zero_mem
  | add y z _ _ hy hz =>
      rw [map_add]
      exact (iterProdSpan (virasoroSimple c)
        {(virasoroSimple c).conformalVector}).add_mem hy hz
  | smul a y _ hy =>
      rw [map_smul]
      exact (iterProdSpan (virasoroSimple c)
        {(virasoroSimple c).conformalVector}).smul_mem a hy

/-! ## The level-four relation in the Poisson quotient -/

/-- The class of `L_{-2}^2|0>` in the C2 quotient of the simple Virasoro VOA is the square of
the conformal-vector class. -/
theorem mk₂_mkQ_L2L2vac (c : ℂ) :
    mk₂ (virasoroSimple c) ((maxIdealVir c).mkQ (L2L2vac c)) =
      mk₂ (virasoroSimple c) (virasoroSimple c).conformalVector *
        mk₂ (virasoroSimple c) (virasoroSimple c).conformalVector := by
  have houter := mkQ_L c (-2) (L2vac c)
  rw [virasoroVOA_L_eq_Lop, L2vac] at houter
  rw [L2L2vac, houter,
    show (maxIdealVir c).mkQ (Lop c (-2) (vacVec c)) =
      (virasoroSimple c).conformalVector by rfl,
    VertexOperatorAlgebra.L_def, ← PreVertexAlgebra.smul_def]
  exact (A₂_mul_mk (virasoroSimple c) _ _).symm

/-- The class of `L_{-4}|0>` vanishes in the C2 quotient.  After quotienting by the maximal VOA
ideal this is still the `-3` product of the conformal vector with the vacuum, hence belongs to
`O2`; no injectivity or equality of ideals is used. -/
theorem mk₂_mkQ_L4vac (c : ℂ) :
    mk₂ (virasoroSimple c) ((maxIdealVir c).mkQ (L4vac c)) = 0 := by
  apply (mk₂_eq_zero_iff (virasoroSimple c)).2
  have houter := mkQ_L c (-4) (vacVec c)
  rw [virasoroVOA_L_eq_Lop] at houter
  rw [L4vac, houter, VertexOperatorAlgebra.L_def, ← PreVertexAlgebra.smul_def]
  exact smul_le_neg_two_mem_O₂ (virasoroSimple c) _ _ (by norm_num)

/-- The Lee--Yang level-four relation has the orientation `5 [omega]^2 = 0` in the C2 quotient:
the coefficient `-3` multiplies the already-zero `L_{-4}|0>` class. -/
theorem five_smul_leeYangOmega_sq_eq_zero :
    (5 : ℂ) •
        (mk₂ (virasoroSimple leeYangC) (virasoroSimple leeYangC).conformalVector) ^ 2 = 0 := by
  have h := congrArg (mk₂ (virasoroSimple leeYangC)) mkQ_leeYangSingular_eq_zero
  simp only [leeYangSingular, map_add, map_smul, map_zero, mk₂_mkQ_L2L2vac,
    mk₂_mkQ_L4vac, smul_zero, add_zero] at h
  simpa only [pow_two] using h

/-- The conformal-vector class in `A2(L(-22/5,0))` is square-zero. -/
theorem leeYangOmega_sq_eq_zero :
    (mk₂ (virasoroSimple leeYangC) (virasoroSimple leeYangC).conformalVector) ^ 2 = 0 :=
  eq_zero_of_smul_eq_zero (by norm_num : (5 : ℂ) ≠ 0) five_smul_leeYangOmega_sq_eq_zero

/-- The one-element strong-generating family used by the finite nilpotent-generator criterion. -/
noncomputable def leeYangGenerator : Fin 1 → VirUniv leeYangC ⧸ maxIdealVir leeYangC :=
  fun _ => (virasoroSimple leeYangC).conformalVector

theorem leeYangGenerator_iterProdSpan_eq_top :
    iterProdSpan (virasoroSimple leeYangC) (Set.range leeYangGenerator) = ⊤ := by
  change iterProdSpan (virasoroSimple leeYangC)
    (Set.range (fun _ : Fin 1 => (virasoroSimple leeYangC).conformalVector)) = ⊤
  rw [Set.range_const]
  exact virasoroSimple_iterProdSpan_conformalVector_eq_top leeYangC

theorem leeYangGenerator_sq_eq_zero (i : Fin 1) :
    (mk₂ (virasoroSimple leeYangC) (leeYangGenerator i)) ^ 2 = 0 := by
  simpa [leeYangGenerator] using leeYangOmega_sq_eq_zero

/-! ## C2-cofiniteness and the strong-finiteness benchmark -/

/-- The Lee--Yang benchmark is strict rather than the one-dimensional trivial VOA: its conformal
vector survives in the simple quotient because the central charge `-22/5` is nonzero. -/
theorem leeYang_conformalVector_ne_zero :
    (virasoroSimple leeYangC).conformalVector ≠ 0 :=
  virasoroSimple_conformalVector_ne_zero leeYangC (by simp [leeYangC])

/-- `L(-22/5,0)` is C2-cofinite. -/
theorem leeYang_c2Cofinite : C2Cofinite (virasoroSimple leeYangC) :=
  c2Cofinite_of_iterProdSpan_of_isNilpotent
    (virasoroSimple leeYangC) leeYangGenerator leeYangGenerator_iterProdSpan_eq_top
    (fun i => ⟨2, leeYangGenerator_sq_eq_zero i⟩)

/-- The explicit nilpotence argument bounds the C2 quotient dimension by two. -/
theorem finrank_a₂_leeYang_le_two :
    Module.finrank ℂ (A₂ (virasoroSimple leeYangC)) ≤ 2 := by
  simpa using finrank_a₂_le_of_iterProdSpan
    (virasoroSimple leeYangC) leeYangGenerator (fun _ => 2)
    leeYangGenerator_iterProdSpan_eq_top leeYangGenerator_sq_eq_zero

/-- The simple Lee--Yang Virasoro VOA is unconditionally strongly finite: simplicity and
self-duality hold for every simple Virasoro quotient, while C2-cofiniteness is the theorem above. -/
theorem leeYang_stronglyFinite : StronglyFinite (virasoroSimple leeYangC) where
  simple := virasoroSimple_isSimple leeYangC
  selfDual := virasoroSimple_selfDual leeYangC
  c2Cofinite := leeYang_c2Cofinite

/-- Admissible rationality is the exact remaining input for strong rationality of the Lee--Yang
benchmark. -/
theorem leeYang_stronglyRational_of_admissiblyRational
    (h : AdmissiblyRational (virasoroSimple leeYangC)) :
    StronglyRational (virasoroSimple leeYangC) where
  toStronglyFinite := leeYang_stronglyFinite
  rational := h

/-- The regularity route to strong rationality, using the unconditional strong-finiteness theorem. -/
theorem leeYang_stronglyRational_of_regular (h : Regular (virasoroSimple leeYangC)) :
    StronglyRational (virasoroSimple leeYangC) :=
  stronglyRational_of_regular leeYang_stronglyFinite h

end VOA.LeeYangC2
