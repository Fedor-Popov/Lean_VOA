import Mathlib

/-!
# The presented jet ring `R_n = ℂ[T_j]/(jets of Tⁿ)`

The coefficient ring shared by the strict symbol model (`TwoSeriesStrictEndpoint`) and the
leading-symbol theorem for `M(2, 2m+3)` (`TwoSeriesDSVirSymbol`, used by
`VirasoroMinimalClassicalFreeness`): `R_n = ℂ[T_j]/(jets of Tⁿ)`, the arc algebra of
`ℂ[T]/(Tⁿ)`, with `T_j ↦ tn n j`.

These definitions are kept apart from `TwoSeriesStrictEndpoint.lean` so that the
Virasoro classical-freeness theorem does not import the graded-unitarity strict-model files.
Declaration names and namespace are unchanged.
-/

namespace VOA.TwoSeries.StrictModel

open MvPolynomial

noncomputable section

/-! ### The coefficient ring `R_n` -/

/-- The polynomial ring `ℂ[T_j]`. -/
abbrev TPoly : Type := MvPolynomial ℕ ℂ

/-- The series `T(s) = Σ T_j s^j`. -/
def tSer : PowerSeries TPoly := PowerSeries.mk X

/-- The jet ideal of `Tⁿ`: generated by the coefficients of `T(s)ⁿ`. -/
def jetIdealT (n : ℕ) : Ideal TPoly :=
  Ideal.span (Set.range fun j => PowerSeries.coeff j (tSer ^ n))

/-- `R_n = ℂ[T_j]/(jets of Tⁿ)`, the arc algebra of `M(2, 2n+1)`. -/
abbrev Rn (n : ℕ) : Type := TPoly ⧸ jetIdealT n

/-- The images of the jets `T_j` in `R_n`. -/
def tn (n : ℕ) (j : ℕ) : Rn n := Ideal.Quotient.mk (jetIdealT n) (X j)

end

end VOA.TwoSeries.StrictModel
