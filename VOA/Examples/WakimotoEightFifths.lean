/-! ## §6  The separating computation -/

/-- **The separating computation.**  `γ₅` sends the Wakimoto image of the weight-5 Lee–Yang
combination to the constant `-384`, at *every* non-critical level `k`. -/
theorem Gam5_valW_wSingLY (k : ℂ) (hk : k + 2 ≠ 0) :
    Gam 5 (valW k hk wSingLY) = (-384 : ℂ) • (1 : WakFock) := by
  rw [wSingLY]
  simp only [map_add, map_smul, valW_wN01, valW_wN02, valW_wN03, valW_wN04, valW_wN05,
    valW_wN06, valW_wN07, valW_wN08, valW_wN09, valW_wN10, valW_wN11, valW_wN12, valW_wN13,
    valW_wN14, valW_wN15, valW_wN16, valW_wN17, valW_wN18, valW_wN19, valW_wN20, valW_wN21]
  rw [Gam5_N01, Gam5_N02, Gam5_N03 k hk, Gam5_N04, Gam5_N05, Gam5_N06, Gam5_N07, Gam5_N08,
    Gam5_N09, Gam5_N10, Gam5_N11, Gam5_N12, Gam5_N13, Gam5_N14, Gam5_N15, Gam5_N16, Gam5_N17,
    Gam5_N18, Gam5_N19, Gam5_N20, Gam5_N21]
  module


/-! ## §7  The main result -/

/-- `k = -8/5` is not the critical level: `k + 2 = 2/5`. -/
theorem hk85 : (-8 / 5 : ℂ) + 2 ≠ 0 := by norm_num

/-- **The Lee–Yang coefficient vector is nonzero at every non-critical level.**  (At levels
other than `-8/5` it is simply not singular; nonvanishing is level-independent because the
witness coefficient `-384` is.) -/
theorem ansatzLY_ne_zero (k : ℂ) (hk : k + 2 ≠ 0) :
    Sl2SingLY.ansatz5 k 625 5000 10000 (-1500) (-16000) 300 (-10000) (-1000) 6000 1200
      (-14400) (-9600) (-19200) (-14720) 1600 4200 78400 (-1680) 2960 17440 25904 ≠ 0 := by
  intro h
  have hmem : wSingLY ∈ AffineLie.vacuumIdeal AffineVOA.kappaForm
      AffineVOA.kappaForm_isInvariant k := by
    rw [← Submodule.Quotient.mk_eq_zero, ← ansatzLY_mk k]
    exact h
  have h0 : valW k hk wSingLY = 0 := valW_vacuumIdeal _ hk _ hmem
  have h1 := Gam5_valW_wSingLY k hk
  rw [h0, map_zero] at h1
  have h2 : ((-384 : ℂ) • (1 : WakFock)) ≠ 0 := by
    rw [smul_ne_zero_iff]
    exact ⟨by norm_num, one_ne_zero⟩
  exact h2 h1.symm

/-- **The weight-5 singular vector of `V^{-8/5}(𝔰𝔩₂)` is nonzero.**  Unconditional and
`pbw`-free: it discharges the hypothesis under which
`Sl2SingLY.sl2SingularLY_ne_zero_of_indep` was stated, without proving that hypothesis.  Since
`k = -8/5` is the level whose Drinfeld–Sokolov reduction is the Lee–Yang minimal model at
`c = -22/5`, this is the nonvanishing the deformation-rigidity programme needs. -/
theorem sl2SingularLY_ne_zero : Sl2SingLY.sl2SingularLY ≠ 0 := by
  rw [Sl2SingLY.sl2SingularLY_def]
  exact ansatzLY_ne_zero _ hk85

/-- **The module-level statement without `NIndep`.**  `Sl2SingLY.exists_singular_ansatz_iff`
with the twenty-one-fold independence hypothesis removed: only `TIndep` and `UIndep`, which the
*converse* half genuinely needs, remain. -/
theorem exists_singular_ansatz_iff' {k : ℂ} (hT : Sl2SingLY.TIndep k)
    (hU : Sl2SingLY.UIndep k) :
    (∃ c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 : ℂ,
        Sl2SingLY.ansatz5 k c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16
            c17 c18 c19 c20 c21 ≠ 0
          ∧ AffineVOA.J k AffineVOA.colE 0 (Sl2SingLY.ansatz5 k c1 c2 c3 c4 c5 c6 c7 c8 c9 c10
            c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21) = 0
          ∧ AffineVOA.J k AffineVOA.colF 1 (Sl2SingLY.ansatz5 k c1 c2 c3 c4 c5 c6 c7 c8 c9 c10
            c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21) = 0)
      ↔ 5 * k + 8 = 0 := by
  constructor
  · rintro ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18,
      c19, c20, c21, hne, hE, hF⟩
    by_contra hk
    exact hne (Sl2SingLY.ansatz5_eq_zero_of_level_ne hT hU hk hE hF)
  · intro hk
    have hk' : k = -8 / 5 := by linear_combination hk / 5
    subst hk'
    refine ⟨625, 5000, 10000, (-1500), (-16000), 300, (-10000), (-1000), 6000, 1200, (-14400),
      (-9600), (-19200), (-14720), 1600, 4200, 78400, (-1680), 2960, 17440, 25904, ?_, ?_, ?_⟩
    · exact sl2SingularLY_ne_zero
    · exact Sl2SingLY.sl2SingularLY_E0
    · exact Sl2SingLY.sl2SingularLY_F1


/-! ## §8  Consequences

Two things follow at once from this file alone: the module `V^{-8/5}(𝔰𝔩₂)` is nonzero without
`pbw`, and the VOA ideal generated by the singular vector is nonzero.

### ⚠ Properness of `(s)` without PBW

**Properness** of `(s)` — the statement `𝟙 ∉ (s)` — looks out of reach if one follows the
standard argument, which factors `U(𝔰𝔩₂^) = U(n̂₋)U(ĝ₀)U(n̂₊)`, a PBW input this route avoids.
Properness follows with no PBW at all, via the *invariant
form*: a strongly singular vector pairs to `0` against the whole algebra under the canonical
normalised fully invariant form, so it cannot generate an ideal containing `𝟙`.  That is
`SingVec.idealGen_proper_of_stronglySingular` (`Core/SingularVector`), resting on Li's theorem
`leftRadical_eq_maxGradedIdeal` (`Core/InvariantFormRadical`).

The two remaining inputs to that route — quasi-primarity of `𝒱₁`, and the upgrade from "all
positive *current* modes kill `s`" to "all non-weight-raising modes of *all states* kill `s`" —
are supplied at every non-critical level by `Examples/AffineSl2Strong`.  Consequently
`Examples/AffineSl2NotSimple85` proves, unconditionally and `pbw`-free:

* `Sl2NotSimple85.not_isSimple_85` — `V^{-8/5}(𝔰𝔩₂)` is **not simple**;
* `Sl2NotSimple85.mkQ_85_not_injective` — `L_{-8/5}(𝔰𝔩₂)` is a **proper** quotient;
* `Sl2NotSimple85.maxGradedIdeal_85_ne_bot`, `Sl2NotSimple85.mkQ_sl2Singular85_eq_zero`.

Note that `NIndep (-8/5)` is not discharged (see the "⚠ What is *not* proved" section
above); it is simply not on the critical path to non-simplicity. -/

/-- `V^{-8/5}(𝔰𝔩₂)` has a nonzero vacuum, `pbw`-free (specialising `vacuumA_ne_zero_free`). -/
theorem vacuumA85_ne_zero : AffineVOA.vacuumA (-8 / 5 : ℂ) ≠ 0 :=
  vacuumA_ne_zero_free (-8 / 5 : ℂ) hk85

/-- The packaging name of `Examples/AffineSl2Singular85`: the weight-5 singular vector is
nonzero.  (`sl2Singular85` is `Sl2SingLY.sl2SingularLY` by `rfl`.) -/
theorem sl2Singular85_ne_zero : Sl2Sing85.sl2Singular85 ≠ 0 := by
  rw [Sl2Sing85.sl2Singular85_eq_LY]; exact sl2SingularLY_ne_zero

/-- The vertex operator algebra `V^{-8/5}(𝔰𝔩₂)`, the `k = -8/5` instance of
`AffineVOA.affineSl2VOA_closed`. -/
noncomputable def voaSl2LY : VertexOperatorAlgebra (AffineVOA.WakModule (-8 / 5 : ℂ)) :=
  AffineVOA.affineSl2VOA_closed (-8 / 5 : ℂ) hk85

/-- **The VOA ideal generated by the singular vector is nonzero** — unconditionally, and
without `pbw`.  This is the half of "`V^{-8/5}(𝔰𝔩₂)` is not simple" that the nonvanishing
buys.  The other half — properness of the ideal — is proved in
`Examples/AffineSl2NotSimple85` (`Sl2NotSimple85.not_isSimple_85`), via the invariant form and
without `pbw`; see §8's corrected preamble. -/
theorem sl2SingularLY_idealGen_ne_bot :
    SingVec.idealGen voaSl2LY Sl2SingLY.sl2SingularLY ≠ ⊥ :=
  SingVec.idealGen_ne_bot sl2SingularLY_ne_zero

end VOA.WakLY
