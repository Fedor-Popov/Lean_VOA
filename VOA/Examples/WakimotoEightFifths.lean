Colours are `colE = 0`, `colF = 1`, `colH = 2`, matching `genW` and `Jw`. -/

/-- The word `e₋₁h₋₁h₋₁h₋₁h₋₁`. -/
noncomputable def wN01 : UW :=
  genW 0 (-1) * (genW 2 (-1) * (genW 2 (-1) * (genW 2 (-1) * (genW 2 (-1) * 1))))
