open VOA.LatGen.WpTwoAMSparseCompute
set_option maxRecDepth 100000

def l22CircleBModeSparseQ (i : ℕ) : SparseRational.Poly ℕ :=
  scaleQ (1669 / 128) (scaleQ (Nat.choose 4 i)
    (vir22ModeSparseQ ((i : ℤ) - 2) 5
      (reifyVirWordSparseQ [3, 2])))


