import VOA.Examples.VirasoroLengthTwoTowers
import VOA.Examples.VirasoroAdmissibleCombinatorics
import VOA.Examples.VirasoroTopSymbol
import Mathlib.LinearAlgebra.Eigenspace.Basic

/-!
# The universal Virasoro length-two tower basis

This file proves the metric-independent vector-space statement behind the length-two
graded-unitarity argument.  At every weight `N ≥ 2`, the creation-word-length-at-most-two
subspace of the universal vacuum module is spanned by the global conformal tower of the
stress tensor and the towers generated by the explicit quasi-primaries `Q_{2m}`.

The proof is PBW-free in the project sense.  It uses the already proved partition basis of
`V(c,0)`, whose independence comes from the free-boson top-symbol argument, and the global
`sl₂` relations.  It uses no invariant-form norm, no simple-quotient character theorem, and no
admissible-basis hypothesis.
-/

set_option linter.style.longLine false

namespace VOA

namespace VirGradedUnitarity

open VOA.VirModule VOA.VirGoodFil
open VOA.VertexOperatorAlgebra
open VOA.AdmissiblePartitions
open Module (finrank)

variable (c : ℂ)

/-! ## The bounded part of the universal partition basis -/

/-- Sorted creation words of energy `N` and length at most `p`. -/
def SortedOfEnergyLengthLE (N p : ℕ) :=
  {w : SortedOfEnergy N // w.1.length ≤ p}

instance (N p : ℕ) : DecidableEq (SortedOfEnergyLengthLE N p) := Subtype.instDecidableEq

noncomputable instance (N p : ℕ) : Fintype (SortedOfEnergyLengthLE N p) := by
  exact Fintype.subtype
    (Finset.univ.filter fun w : SortedOfEnergy N => w.1.length ≤ p) (by simp)

/-- The bounded partition family, regarded in the ambient universal module. -/
noncomputable def sortedWordLE (N p : ℕ) : SortedOfEnergyLengthLE N p → VirUniv c :=
  fun w => negWordVir c w.1.1

theorem sortedWordLE_linearIndependent (N p : ℕ) :
    LinearIndependent ℂ (sortedWordLE c N p) := by
  have hli := (sortedBasisVir c).linearIndependent.comp
    (fun w : SortedOfEnergyLengthLE N p => ⟨w.1.1, w.1.2.1⟩)
    (fun x y h => by
      have hl : x.1.1 = y.1.1 :=
        congrArg (fun z : {w : List ℕ // SortedWord w} => z.1) h
      exact Subtype.ext (Subtype.ext hl))
  convert hli using 1
  ext w
  simp only [Function.comp_apply, sortedBasisVir_apply, sortedWordLE]

/-- The definition of `virFil` is exactly the span of the bounded part of the proved partition
basis. -/
theorem span_sortedWordLE_eq_virFil (N p : ℕ) :
    Submodule.span ℂ (Set.range (sortedWordLE c N p)) = virFil c p (N : ℤ) := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨w, rfl⟩
    exact Submodule.subset_span ⟨w.1.1, w.1.2.1, by exact_mod_cast w.1.2.2,
      w.2, rfl⟩
  · rw [virFil, Submodule.span_le]
    rintro _ ⟨w, hw, henergy, hlength, rfl⟩
    have henergy' : energyVir w = N := by exact_mod_cast henergy
    exact Submodule.subset_span
      ⟨⟨⟨w, hw, henergy'⟩, hlength⟩, rfl⟩

theorem finrank_virFil_eq_card_sortedWordLE (N p : ℕ) :
    finrank ℂ (virFil c p (N : ℤ)) = Fintype.card (SortedOfEnergyLengthLE N p) := by
  rw [← span_sortedWordLE_eq_virFil c N p]
  exact finrank_span_eq_card (sortedWordLE_linearIndependent c N p)

/-- In length at most two, ordinary sorted words are the same finite set as the automatically
`3`-admissible words.  This is used only as a convenient reuse of the exact finite count. -/
noncomputable def sortedLengthLETwoEquivAdmissible (N : ℕ) :
    SortedOfEnergyLengthLE N 2 ≃ AdmissibleOfEnergyLengthLE 3 N 2 where
  toFun w := ⟨⟨w.1, isNAdmissible_of_length_le_two (n := 3) (by omega) w.2⟩, w.2⟩
  invFun w := ⟨w.1.1, w.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The universal length-at-most-two step has dimension `⌊N/2⌋` in every weight `N ≥ 2`. -/
theorem finrank_virFil_two (N : ℕ) (hN : 2 ≤ N) :
    finrank ℂ (virFil c 2 (N : ℤ)) = N / 2 := by
  rw [finrank_virFil_eq_card_sortedWordLE c,
    Fintype.card_congr (sortedLengthLETwoEquivAdmissible N)]
  change admissibleCumulativeCount 3 N 2 = N / 2
  rw [admissibleCumulativeCount_eq_sum]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add]
  rw [admissibleCount_zero_of_ne_zero 3 N (by omega),
    admissibleCount_one (n := 3) (N := N) (by omega),
    admissibleCount_two (n := 3) (N := N) (by omega)]
  simp only [if_pos hN, if_neg (by omega : (3 : ℕ) ≠ 2)]
  omega

/-! ## The combined tower family -/

/-- The length-one tower in final weight `N`.  Its base is the conformal vector in weight two. -/
noncomputable def lengthOneTowerAt (N : ℕ) : VirUniv c :=
  ((virasoroVOA c).L (-1) ^ (N - 2)) (omegaVir c)

/-- One index for the length-one tower (`m=1`) and one for every length-two tower (`m≥2`). -/
def LengthLETwoTowerIndex (N : ℕ) := {m : ℕ // 1 ≤ m ∧ 2 * m ≤ N}

instance (N : ℕ) : DecidableEq (LengthLETwoTowerIndex N) := Subtype.instDecidableEq

noncomputable instance (N : ℕ) : Fintype (LengthLETwoTowerIndex N) := by
  exact Fintype.ofFinset
    ((Finset.range (N + 1)).filter fun m => 1 ≤ m ∧ 2 * m ≤ N) (by
      intro m
      simp only [Finset.mem_filter, Finset.mem_range]
      constructor
      · rintro ⟨-, hm⟩
        exact hm
      · rintro ⟨hm1, hmN⟩
        exact ⟨by omega, ⟨hm1, hmN⟩⟩)

/-- The combined family.  Index `m=1` is the stress-tensor tower; index `m≥2` is the tower
generated by `Q_{2m}`. -/
noncomputable def lengthLETwoTowerAt (N : ℕ) (m : LengthLETwoTowerIndex N) : VirUniv c :=
  if hm : m.1 = 1 then lengthOneTowerAt c N
  else lengthTwoTowerAt c N ⟨m.1, by rcases m.2 with ⟨hm1, -⟩; omega, m.2.2⟩

@[simp] theorem lengthLETwoTowerAt_one {N : ℕ} (hN : 2 ≤ N) :
    lengthLETwoTowerAt c N ⟨1, by omega, hN⟩ = lengthOneTowerAt c N := by
  simp [lengthLETwoTowerAt]

theorem lengthLETwoTowerAt_of_two_le {N : ℕ} (m : LengthLETwoTowerIndex N)
    (hm : 2 ≤ m.1) :
    lengthLETwoTowerAt c N m = lengthTwoTowerAt c N ⟨m.1, hm, m.2.2⟩ := by
  simp [lengthLETwoTowerAt, show m.1 ≠ 1 by omega]

/-- The combined indices are the integers `1,…,⌊N/2⌋`. -/
noncomputable def lengthLETwoTowerIndexEquivFin (N : ℕ) :
    LengthLETwoTowerIndex N ≃ Fin (N / 2) where
  toFun m := ⟨m.1 - 1, by
    have hmle : m.1 ≤ N / 2 :=
      (Nat.le_div_iff_mul_le (by omega : 0 < 2)).2 (by simpa [mul_comm] using m.2.2)
    have hm1 := m.2.1
    omega⟩
  invFun i := ⟨i.1 + 1, by omega, by
    have hi : i.1 + 1 ≤ N / 2 := by omega
    have hmul := (Nat.le_div_iff_mul_le (by omega : 0 < 2)).1 hi
    omega⟩
  left_inv m := by
    have hm1 := m.2.1
    apply Subtype.ext
    dsimp
    omega
  right_inv i := by
    apply Fin.ext
    simp

theorem card_lengthLETwoTowerIndex (N : ℕ) :
    Fintype.card (LengthLETwoTowerIndex N) = N / 2 := by
  rw [Fintype.card_congr (lengthLETwoTowerIndexEquivFin N), Fintype.card_fin]

/-! ## Nonvanishing without the invariant form -/

/-- Translation on a one-letter creation word. -/
theorem Lop_neg_one_negWordVir_singleton (i : ℕ) :
    Lop c (-1) (negWordVir c [i]) = ((i : ℂ) + 1) • negWordVir c [i + 1] := by
  rw [VirGoodFil.Lop_neg_one_negWordVir_cons,
    VirGoodFil.Lop_neg_one_negWordVir_nil, map_zero, zero_add]

/-- The stress-tensor tower is a nonzero factorial multiple of the unique length-one word. -/
theorem Lop_neg_one_pow_omegaVir (r : ℕ) :
    (Lop c (-1) ^ r) (omegaVir c) = (r.factorial : ℂ) • negWordVir c [r] := by
  induction r with
  | zero => simp [omegaVir, negWordVir]
  | succ r ih =>
      rw [pow_succ', Module.End.mul_apply, ih, map_smul,
        Lop_neg_one_negWordVir_singleton]
      rw [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
      module

theorem lengthOneTowerAt_eq (N : ℕ) :
    lengthOneTowerAt c N = ((N - 2).factorial : ℂ) • negWordVir c [N - 2] := by
  rw [lengthOneTowerAt, virasoroVOA_L_eq_Lop, Lop_neg_one_pow_omegaVir]

theorem lengthOneTowerAt_ne_zero (N : ℕ) : lengthOneTowerAt c N ≠ 0 := by
  rw [lengthOneTowerAt_eq]
  exact smul_ne_zero (by exact_mod_cast Nat.factorial_ne_zero (N - 2))
    (negWordVir_ne_zero c (sortedWord_singleton _))

/-- Coordinate extraction in the proved global partition basis. -/
noncomputable def sortedCoeff (u : {w : List ℕ // SortedWord w}) : VirUniv c →ₗ[ℂ] ℂ :=
  (Finsupp.lapply u).comp (sortedBasisVir c).repr.toLinearMap

theorem sortedCoeff_negWordVir (u : {w : List ℕ // SortedWord w})
    (w : List ℕ) (hw : SortedWord w) :
    sortedCoeff c u (negWordVir c w) = if w = u.1 then 1 else 0 := by
  let j : {w : List ℕ // SortedWord w} := ⟨w, hw⟩
  have hj : negWordVir c w = sortedBasisVir c j := by simp [j]
  rw [hj, sortedCoeff, LinearMap.comp_apply]
  change (Finsupp.lapply u) ((sortedBasisVir c).repr ((sortedBasisVir c) j)) = _
  rw [Module.Basis.repr_self]
  by_cases h : w = u.1
  · have hju : j = u := Subtype.ext h
    subst hju
    simp [j]
  · have hju : j ≠ u := fun h' => h (congrArg Subtype.val h')
    simp [h, hju, j]

/-- The diagonal word used to detect `Q_{2m}` in the universal partition basis. -/
def lengthTwoDiagonalWord (m : ℕ) : {w : List ℕ // SortedWord w} :=
  ⟨[m - 2, m - 2], by exact SortedWord.cons (sortedWord_singleton _) (by simp)⟩

private theorem sortedCoeff_lengthTwoQOffDiag (m : ℕ) (hm : 2 ≤ m) :
    sortedCoeff c (lengthTwoDiagonalWord m) (lengthTwoQOffDiag c m) = 0 := by
  rw [lengthTwoQOffDiag, map_smul, map_sum]
  apply smul_eq_zero.mpr
  right
  apply Finset.sum_eq_zero
  intro j hj
  rw [Finset.mem_range] at hj
  rw [map_smul]
  apply smul_eq_zero.mpr
  right
  have hsort : SortedWord [2 * m - 4 - j, j] := by
    exact SortedWord.cons (sortedWord_singleton _) (by
      simp only [List.mem_singleton]
      intro b hb
      subst b
      omega)
  have hne : [2 * m - 4 - j, j] ≠ [m - 2, m - 2] := by
    intro h
    simp only [List.cons.injEq, and_true] at h
    omega
  rw [sortedCoeff_negWordVir c (lengthTwoDiagonalWord m) _ hsort]
  simp [lengthTwoDiagonalWord, hne]

/-- The diagonal partition coordinate of `Q_{2m}` is its advertised nonzero coefficient. -/
theorem sortedCoeff_lengthTwoQ_diagonal (m : ℕ) (hm : 2 ≤ m) :
    sortedCoeff c (lengthTwoDiagonalWord m) (lengthTwoQ c m) =
      ((lengthTwoACoeff m (m - 2) : ℚ) : ℂ) := by
  rw [lengthTwoQ, map_add, map_add, sortedCoeff_lengthTwoQOffDiag c m hm, zero_add,
    map_smul, map_smul]
  have hdiag := sortedCoeff_negWordVir c (lengthTwoDiagonalWord m)
    [m - 2, m - 2] (lengthTwoDiagonalWord m).2
  have hlast := sortedCoeff_negWordVir c (lengthTwoDiagonalWord m)
    [2 * m - 2] (sortedWord_singleton _)
  have hsame : [m - 2, m - 2] = (lengthTwoDiagonalWord m).1 := rfl
  have hne : [2 * m - 2] ≠ (lengthTwoDiagonalWord m).1 := by
    simp [lengthTwoDiagonalWord]
  rw [if_pos hsame] at hdiag
  rw [if_neg hne] at hlast
  rw [hdiag, hlast, smul_eq_mul, mul_one, smul_zero, add_zero]
  rfl

/-- Every `Q_{2m}` is nonzero in the universal vacuum module, even when its invariant-form norm
vanishes at a minimal-model charge. -/
theorem lengthTwoQ_ne_zero (m : ℕ) (hm : 2 ≤ m) : lengthTwoQ c m ≠ 0 := by
  intro hzero
  have hcoord := congrArg (sortedCoeff c (lengthTwoDiagonalWord m)) hzero
  rw [sortedCoeff_lengthTwoQ_diagonal c m hm, map_zero] at hcoord
  exact lengthTwoADiagonal_ne_zero m hm hcoord

/-! ## A metric-independent global-`sl₂` eigenvector argument -/

section GlobalTowerEigenvectors

variable {V : Type*} [AddCommGroup V] [Module ℂ V] (W : VertexOperatorAlgebra V)

/-- The degree-preserving operator `L₋₁L₁`. -/
noncomputable def globalTowerOperator : Module.End ℂ V := W.L (-1) * W.L 1

/-- Its eigenvalue on the depth-`r` descendant of a quasi-primary of weight `m`. -/
def globalTowerEigenvalue (m : ℤ) (r : ℕ) : ℂ :=
  (r : ℂ) * (2 * (m : ℂ) + (r : ℂ) - 1)

/-- A positive-weight quasi-primary has no zero global descendants. -/
theorem globalDescendant_ne_zero {m : ℤ} {v : V} (hm : 0 < m)
    (hv : v ∈ W.grading m) (hqp : W.L 1 v = 0) (hv0 : v ≠ 0) (r : ℕ) :
    (W.L (-1) ^ r) v ≠ 0 := by
  intro hzero
  have h : (W.L 1 ^ r) ((W.L (-1) ^ r) v) = 0 := by
    rw [hzero, map_zero]
  rw [L1_pow_Lneg1_pow W hv hqp] at h
  obtain ⟨a, ha, hfactor⟩ := globalDescendantFactor_real_pos hm r
  have hfac0 : globalDescendantFactor m r ≠ 0 := by
    rw [hfactor]
    exact Complex.ofReal_ne_zero.mpr (ne_of_gt ha)
  exact hv0 ((smul_eq_zero.mp h).resolve_left hfac0)

/-- Global descendants are eigenvectors of `L₋₁L₁`; this separates towers born at
different weights without using an invariant form. -/
theorem globalDescendant_hasEigenvector {m : ℤ} {v : V} (hm : 0 < m)
    (hv : v ∈ W.grading m) (hqp : W.L 1 v = 0) (hv0 : v ≠ 0) (r : ℕ) :
    (globalTowerOperator W).HasEigenvector (globalTowerEigenvalue m r) ((W.L (-1) ^ r) v) := by
  refine ⟨Module.End.mem_eigenspace_iff.mpr ?_, globalDescendant_ne_zero W hm hv hqp hv0 r⟩
  cases r with
  | zero => simp [globalTowerOperator, globalTowerEigenvalue, hqp]
  | succ j =>
      rw [globalTowerOperator, Module.End.mul_apply, L1_tower W hv hqp j, map_smul]
      rw [show W.L (-1) ((W.L (-1) ^ j) v) = (W.L (-1) ^ (j + 1)) v by
        rw [pow_succ', Module.End.mul_apply]]
      simp only [globalTowerEigenvalue, Nat.cast_add, Nat.cast_one]
      congr 1
      ring

end GlobalTowerEigenvectors

/-- The `L₋₁L₁` eigenvalue of the tower indexed by `m` in final weight `N`, written as
a natural number and then embedded in `ℂ`. -/
def lengthLETwoTowerEigenvalue (N : ℕ) (m : LengthLETwoTowerIndex N) : ℂ :=
  (((N - 2 * m.1) * (N + 2 * m.1 - 1) : ℕ) : ℂ)

theorem lengthLETwoTowerEigenvalue_injective (N : ℕ) :
    Function.Injective (lengthLETwoTowerEigenvalue N) := by
  intro i j hij
  apply Subtype.ext
  have hijNat :
      (N - 2 * i.1) * (N + 2 * i.1 - 1) =
        (N - 2 * j.1) * (N + 2 * j.1 - 1) := by
    change (((N - 2 * i.1) * (N + 2 * i.1 - 1) : ℕ) : ℂ) =
      (((N - 2 * j.1) * (N + 2 * j.1 - 1) : ℕ) : ℂ) at hij
    exact_mod_cast hij
  have hiN := i.2.2
  have hjN := j.2.2
  have hi1 := i.2.1
  have hj1 := j.2.1
  have hijZ :
      ((N : ℤ) - 2 * (i.1 : ℤ)) * ((N : ℤ) + 2 * i.1 - 1) =
        ((N : ℤ) - 2 * j.1) * ((N : ℤ) + 2 * j.1 - 1) := by
    have hz :
        (((N - 2 * i.1) * (N + 2 * i.1 - 1) : ℕ) : ℤ) =
          (((N - 2 * j.1) * (N + 2 * j.1 - 1) : ℕ) : ℤ) := by
      exact_mod_cast hijNat
    push_cast at hz
    rw [Nat.cast_sub hiN, Nat.cast_sub hjN] at hz
    have hiSub : (1 : ℕ) ≤ N + 2 * i.1 := by omega
    have hjSub : (1 : ℕ) ≤ N + 2 * j.1 := by omega
    rw [Nat.cast_sub hiSub, Nat.cast_sub hjSub] at hz
    push_cast at hz
    exact hz
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hltZ : (i.1 : ℤ) < j.1 := by exact_mod_cast hlt
    have hi1Z : (1 : ℤ) ≤ i.1 := by exact_mod_cast hi1
    have hj1Z : (1 : ℤ) ≤ j.1 := by exact_mod_cast hj1
    nlinarith
  · have hgtZ : (j.1 : ℤ) < i.1 := by exact_mod_cast hgt
    have hi1Z : (1 : ℤ) ≤ i.1 := by exact_mod_cast hi1
    have hj1Z : (1 : ℤ) ≤ j.1 := by exact_mod_cast hj1
    nlinarith

/-- The abstract global-tower eigenvalue agrees with the natural-number formula at final
weight `N`. -/
theorem globalTowerEigenvalue_eq_lengthLETwoTowerEigenvalue (N : ℕ)
    (m : LengthLETwoTowerIndex N) :
    globalTowerEigenvalue (2 * (m.1 : ℤ)) (N - 2 * m.1) =
      lengthLETwoTowerEigenvalue N m := by
  rw [globalTowerEigenvalue, lengthLETwoTowerEigenvalue]
  have hsub : 2 * m.1 ≤ N := m.2.2
  have hmpos : 0 < m.1 := lt_of_lt_of_le Nat.zero_lt_one m.2.1
  have htwopos : 0 < 2 * m.1 := Nat.mul_pos (by omega) hmpos
  have hsub' : 1 ≤ N + 2 * m.1 := by omega
  rw [Nat.cast_mul, Nat.cast_sub hsub, Nat.cast_sub hsub']
  push_cast
  ring

/-- Every member of the combined family is a nonzero `L₋₁L₁` eigenvector with the displayed
eigenvalue. -/
theorem lengthLETwoTowerAt_hasEigenvector (N : ℕ) (m : LengthLETwoTowerIndex N) :
    (globalTowerOperator (virasoroVOA c)).HasEigenvector
      (lengthLETwoTowerEigenvalue N m) (lengthLETwoTowerAt c N m) := by
  by_cases hm : m.1 = 1
  · rw [lengthLETwoTowerAt, dif_pos hm, lengthOneTowerAt]
    have hbase : omegaVir c ≠ 0 := by
      simpa [omegaVir, negWordVir] using
        (negWordVir_ne_zero c (sortedWord_singleton 0))
    have h := globalDescendant_hasEigenvector (virasoroVOA c)
      (m := (2 : ℤ)) (v := omegaVir c) (by omega)
      (omegaVir_mem_gradingVir_two c)
      (by simpa using L1_conformal_zero (virasoroVOA c)) hbase (N - 2)
    rw [← globalTowerEigenvalue_eq_lengthLETwoTowerEigenvalue N m]
    simpa [hm] using h
  · have hm1 : 1 ≤ m.1 := m.2.1
    have hm2 : 2 ≤ m.1 := by omega
    rw [lengthLETwoTowerAt_of_two_le c m hm2, lengthTwoTowerAt,
      ← globalTowerEigenvalue_eq_lengthLETwoTowerEigenvalue N m]
    exact globalDescendant_hasEigenvector (virasoroVOA c)
      (m := (2 * m.1 : ℕ)) (v := lengthTwoQ c m.1) (by omega)
      (lengthTwoQ_mem_grading c m.1 hm2)
      (by simpa [virasoroVOA_L_eq_Lop] using lengthTwoQ_quasiPrimary c m.1 hm2)
      (lengthTwoQ_ne_zero c m.1 hm2) (N - 2 * m.1)

/-- The combined universal tower family is linearly independent, with no metric hypothesis. -/
theorem lengthLETwoTowerAt_linearIndependent (N : ℕ) :
    LinearIndependent ℂ (lengthLETwoTowerAt c N) := by
  exact (globalTowerOperator (virasoroVOA c)).eigenvectors_linearIndependent'
    (lengthLETwoTowerEigenvalue N) (lengthLETwoTowerEigenvalue_injective N)
    (lengthLETwoTowerAt c N) (lengthLETwoTowerAt_hasEigenvector c N)

/-! ## Spanning and the universal basis -/

/-- The stress-tensor tower lies in word-length filtration one. -/
theorem lengthOneTowerAt_mem_virFil (N : ℕ) (hN : 2 ≤ N) :
    lengthOneTowerAt c N ∈ virFil c 1 (N : ℤ) := by
  rw [lengthOneTowerAt_eq]
  apply Submodule.smul_mem
  apply Submodule.subset_span
  refine ⟨[N - 2], sortedWord_singleton _, ?_, by simp, rfl⟩
  simp only [energyVir_cons, energyVir_nil]
  push_cast
  omega

/-- Every member of the combined tower family lies in the length-at-most-two filtration step. -/
theorem lengthLETwoTowerAt_mem_virFil (N : ℕ) (m : LengthLETwoTowerIndex N) :
    lengthLETwoTowerAt c N m ∈ virFil c 2 (N : ℤ) := by
  by_cases hm : m.1 = 1
  · rw [lengthLETwoTowerAt, dif_pos hm]
    apply virFil_mono c (N : ℤ) (by omega : 1 ≤ 2)
    apply lengthOneTowerAt_mem_virFil c N
    have hbound := m.2.2
    omega
  · have hm1 : 1 ≤ m.1 := m.2.1
    have hm2 : 2 ≤ m.1 := by omega
    rw [lengthLETwoTowerAt_of_two_le c m hm2, lengthTwoTowerAt,
      virasoroVOA_L_eq_Lop]
    have h := lengthTwoQ_tower_mem_virFil c m.1 hm2 (N - 2 * m.1)
    have hsum : 2 * m.1 + (N - 2 * m.1) = N :=
      Nat.add_sub_of_le m.2.2
    simpa only [hsum] using h

/-- The universal word-length-at-most-two step is exactly the span of the global towers born in
weights `2,4,…,2⌊N/2⌋`.  This is the metric-independent bridge needed by the `p ≤ 2`
graded-unitarity argument. -/
theorem virFil_two_eq_span_towers (N : ℕ) (hN : 2 ≤ N) :
    virFil c 2 (N : ℤ) =
      Submodule.span ℂ (Set.range (lengthLETwoTowerAt c N)) := by
  letI : FiniteDimensional ℂ (virFil c 2 (N : ℤ)) := by
    exact ((Module.Basis.span (sortedWordLE_linearIndependent c N 2)).map
      (LinearEquiv.ofEq _ _ (span_sortedWordLE_eq_virFil c N 2))).finiteDimensional_of_finite
  symm
  apply Submodule.eq_of_le_of_finrank_eq
  · rw [Submodule.span_le]
    rintro _ ⟨m, rfl⟩
    exact lengthLETwoTowerAt_mem_virFil c N m
  · rw [finrank_span_eq_card (lengthLETwoTowerAt_linearIndependent c N),
      card_lengthLETwoTowerIndex N, finrank_virFil_two c N hN]

/-- The combined tower family, packaged as a basis of `virFil c 2 N`. -/
noncomputable def virFilTwoTowerBasis (N : ℕ) (hN : 2 ≤ N) :
    Module.Basis (LengthLETwoTowerIndex N) ℂ (virFil c 2 (N : ℤ)) :=
  (Module.Basis.span (lengthLETwoTowerAt_linearIndependent c N)).map
    (LinearEquiv.ofEq _ _ (virFil_two_eq_span_towers c N hN).symm)


end VirGradedUnitarity

end VOA
