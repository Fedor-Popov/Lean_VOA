import VOA.Examples.TwoSeriesArrangementGen
import VOA.Examples.TwoSeriesGenInclLex

/-!
# The generation input `GenInclusion n` holds for every `n ≥ 2`

Every polynomial `f ∈ L = (x_0^N, …, x_{k-1}^N)` vanishing on all `n`-fold diagonals lies in the
ideal of the block generators `blockProd c pt · dD pt m`.

Proof (lexicographic division by the nonzero block generators, `MonomialOrder.div_set`): the
remainder `r` lies in `L` and vanishes on the `n`-fold diagonals.  If `r ≠ 0`, its leading exponent
`e` has some `e_i ≥ N` (`L` is a monomial ideal) and, by the point game of `TwoSeriesGenInclLex`
(`not_win_of_vanish` + `exists_blocks_of_not_win`), there is a block labelling
`c : Fin k → Fin (n - 1)` with `#{j > i : c_j = c_i} ≤ e_i`.  The generator built from `c`, the
suffix of the block of `i` starting at `i`, and the power `max N r` has leading exponent
`Σ_{same-block pairs a < b} e_a + (m - r) e_i ≤ e` (`exists_small_gen`), contradicting the
remainder property.  Hence `r = 0`.

In particular the lexicographic initial ideal of the `n`-equal ideal is generated by the leading
monomials of the block-Vandermonde products (the Li–Li generators form a lex Gröbner basis).

* `vanIdeal` — the ideal of polynomials vanishing on all `n`-fold diagonals;
* `eval_eq_zero_of_Q` — such polynomials vanish at every point with an `n`-fold value;
* `span_genSet_le_vanIdeal`;
* `exists_small_gen` — a block labelling dominated by `e` and `e_i ≥ N` give a nonzero block
  generator with leading exponent `≤ e`;
* `genInclusion` — **`GenInclusion n` for every `n ≥ 2`**;
* `arrangementInclusion`, `symArrangementInclusion` (all `n ≥ 1`);
* `JetPoincareTwo.twoSeries_gradedUnitary_of_affine_final` — **affine GU ⇒ GU of
  `M(2, 2m+5)` for every `m`, conditional only on `hA`**.

Everything is proved outright.
-/

namespace VOA.TwoSeries.GenIncl

open MvPolynomial Finset JetPoincareVdm JetPoincareArr ArrangementGen

noncomputable section

variable {k : ℕ}

/-! ### The vanishing ideal of the `n`-equal arrangement -/

/-- The polynomials vanishing on every `n`-fold diagonal. -/
def vanIdeal (n k : ℕ) : Ideal (XP k) where
  carrier := {f | ∀ S : Finset (Fin k), #S = n → VanishOn S f}
  add_mem' := fun {a b} ha hb S hS s₀ hs₀ => by
    rw [map_add, ha S hS s₀ hs₀, hb S hS s₀ hs₀, add_zero]
  zero_mem' := fun _ _ _ _ => map_zero _
  smul_mem' := fun c x hx S hS s₀ hs₀ => by
    rw [smul_eq_mul, map_mul, hx S hS s₀ hs₀, mul_zero]

theorem mem_vanIdeal {n : ℕ} {f : XP k} :
    f ∈ vanIdeal n k ↔ ∀ S : Finset (Fin k), #S = n → VanishOn S f := Iff.rfl

/-- Vanishing on the `n`-fold diagonals gives vanishing at every point with an `n`-fold value. -/
theorem eval_eq_zero_of_Q {n : ℕ} (hn : 1 ≤ n) {f : XP k} (hf : f ∈ vanIdeal n k)
    (x : Fin k → ℂ) (hx : Q n 0 x) : eval x f = 0 := by
  obtain ⟨z, hz⟩ := hx
  rw [Finsupp.coe_zero, Pi.zero_apply, zero_add, ← card_filter] at hz
  obtain ⟨S, hSsub, hS⟩ := exists_subset_card_eq hz
  obtain ⟨s₀, hs₀⟩ : S.Nonempty := card_pos.mp (by omega)
  have h := hf S hS s₀ hs₀
  have hxc : x ∘ collapseTo s₀ S = x := funext fun i => by
    simp only [Function.comp, collapseTo]
    split_ifs with hi
    · rw [(mem_filter.mp (hSsub hs₀)).2, (mem_filter.mp (hSsub hi)).2]
    · rfl
  rw [← hxc, ← eval_rename, h, map_zero]

/-- The block generators vanish on the `n`-fold diagonals. -/
theorem gen_mem_vanIdeal {n N : ℕ} (hn : 2 ≤ n) {g : XP k} (hg : g ∈ genSet n k N) :
    g ∈ vanIdeal n k := by
  obtain ⟨c, r, pt, m, hpt, -, -, rfl⟩ := hg
  intro S hS
  have hlt : (univ : Finset (Fin (n - 1))).card < S.card := by
    rw [card_univ, Fintype.card_fin, hS]; omega
  obtain ⟨a, ha, b, hb, hab, hcab⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hlt (fun x _ => mem_univ (c x))
  wlog hlt' : a < b generalizing a b
  · exact this b hb a ha hab.symm hcab.symm (lt_of_le_of_ne (not_lt.mp hlt') hab.symm)
  by_cases hboth : a ∈ univ.image pt ∧ b ∈ univ.image pt
  · obtain ⟨x, -, hx⟩ := mem_image.mp hboth.1
    obtain ⟨y, -, hy⟩ := mem_image.mp hboth.2
    have hxy : x < y := hpt.lt_iff_lt.mp (hx ▸ hy ▸ hlt')
    have hd := dvd_dD hpt m hxy
    rw [hx, hy] at hd
    exact vanishOn_of_dvd ha hb (dvd_mul_of_dvd_right hd _)
  · have hmem : (a, b) ∈ blockPairs c pt := by
      simp only [blockPairs, mem_filter, mem_univ, true_and]
      exact ⟨hlt', hcab, hboth⟩
    refine vanishOn_of_dvd ha hb (dvd_mul_of_dvd_left ?_ _)
    have hd : (X (a, b).2 - X (a, b).1 : XP k) ∣ ∏ q ∈ blockPairs c pt, (X q.2 - X q.1 : XP k) :=
      Finset.dvd_prod_of_mem (fun q : Fin k × Fin k => (X q.2 - X q.1 : XP k)) hmem
    exact hd

/-- The ideal of the block generators lies in the vanishing ideal. -/
theorem span_genSet_le_vanIdeal {n N : ℕ} (hn : 2 ≤ n) :
    Ideal.span (genSet n k N) ≤ vanIdeal n k :=
  Ideal.span_le.mpr fun _ hg => gen_mem_vanIdeal hn hg

theorem span_genSet_le_Lid {n N : ℕ} (hn : 2 ≤ n) : Ideal.span (genSet n k N) ≤ Lid k N :=
  fun _ hf => Wn_le_Lid (span_genSet_le_Wn hn hf)

/-! ### Same-block pairs -/

/-- The increasing pairs inside a common block. -/
def samePairs {M : ℕ} (c : Fin k → Fin M) : Finset (Fin k × Fin k) :=
  univ.filter fun q => q.1 < q.2 ∧ c q.1 = c q.2

theorem samePairs_lt {M : ℕ} (c : Fin k → Fin M) : ∀ q ∈ samePairs c, q.1 < q.2 :=
  fun _ hq => (mem_filter.mp hq).2.1

theorem blockProd_mul_vdm {M r : ℕ} (c : Fin k → Fin M) {pt : Fin (r + 1) → Fin k}
    (hpt : StrictMono pt) (hc : ∀ p, c (pt p) = c (pt 0)) :
    blockProd c pt * vdm pt = pprod (samePairs c) := by
  have hsub : vpairs pt ⊆ samePairs c := by
    intro q hq
    obtain ⟨p, p', h, h1, h2⟩ := mem_vpairs.mp hq
    simp only [samePairs, mem_filter, mem_univ, true_and]
    rw [← h1, ← h2]
    exact ⟨hpt h, by rw [hc p, hc p']⟩
  have hbp : blockPairs c pt = samePairs c \ vpairs pt := by
    ext q
    simp only [blockPairs, samePairs, mem_filter, mem_univ, true_and, mem_sdiff]
    constructor
    · rintro ⟨hlt, hcq, hnot⟩
      refine ⟨⟨hlt, hcq⟩, fun hq => hnot ?_⟩
      obtain ⟨p, p', -, h1, h2⟩ := mem_vpairs.mp hq
      exact ⟨mem_image.mpr ⟨p, mem_univ _, h1⟩, mem_image.mpr ⟨p', mem_univ _, h2⟩⟩
    · rintro ⟨⟨hlt, hcq⟩, hnot⟩
      refine ⟨hlt, hcq, ?_⟩
      rintro ⟨h1, h2⟩
      obtain ⟨x, -, hx⟩ := mem_image.mp h1
      obtain ⟨y, -, hy⟩ := mem_image.mp h2
      refine hnot (mem_vpairs.mpr ⟨x, y, hpt.lt_iff_lt.mp ?_, hx, hy⟩)
      rw [hx, hy]; exact hlt
  rw [blockProd, hbp, vdm_eq_pprod hpt, pprod, pprod, pprod, prod_sdiff hsub]

theorem pprod_ne_zero {P : Finset (Fin k × Fin k)} (hP : ∀ q ∈ P, q.1 < q.2) : pprod P ≠ 0 :=
  prod_ne_zero_iff.mpr fun q hq => X_sub_X_ne_zero (ne_of_lt (hP q hq))

theorem degree_pprod {P : Finset (Fin k × Fin k)} (hP : ∀ q ∈ P, q.1 < q.2) :
    (lexO k).degree (pprod P) = ∑ q ∈ P, Finsupp.single q.1 1 := by
  rw [pprod, MonomialOrder.degree_prod (fun q hq => X_sub_X_ne_zero (ne_of_lt (hP q hq)))]
  exact sum_congr rfl fun q hq => degree_X_sub_X (hP q hq)

theorem degree_samePairs_apply {M : ℕ} (c : Fin k → Fin M) (j : Fin k) :
    (∑ q ∈ samePairs c, Finsupp.single q.1 1 : Fin k →₀ ℕ) j = laterCol c j := by
  rw [Finsupp.finsetSum_apply]
  simp only [Finsupp.single_apply]
  rw [samePairs, sum_filter, ← univ_product_univ, sum_product, sum_eq_single j]
  · refine sum_congr rfl fun b _ => ?_
    by_cases h : j < b ∧ c j = c b
    · rw [if_pos h, if_pos rfl, if_pos ⟨h.1, h.2.symm⟩]
    · rw [if_neg h, if_neg fun h' => h ⟨h'.1, h'.2.symm⟩]
  · intro a _ ha
    exact sum_eq_zero fun b _ => by rw [if_neg ha]; simp
  · intro h; exact absurd (mem_univ j) h

/-! ### A small generator -/

/-- **A block labelling dominated by `e`, and `e_i ≥ N`, give a nonzero block generator with
leading exponent `≤ e`.** -/
theorem exists_small_gen {n N : ℕ} (c : Fin k → Fin (n - 1)) {e : Fin k →₀ ℕ}
    (hc : ∀ i, laterCol c i ≤ e i) {i : Fin k} (hi : N ≤ e i) :
    ∃ g ∈ genSet n k N, g ≠ 0 ∧ (lexO k).degree g ≤ e := by
  obtain ⟨r, hr⟩ : ∃ r, laterCol c i = r := ⟨_, rfl⟩
  set T := univ.filter fun j => i ≤ j ∧ c j = c i with hT
  have hTcard : T.card = r + 1 := by
    have hTi : T = insert i (univ.filter fun j => i < j ∧ c j = c i) := by
      ext j
      simp only [hT, mem_filter, mem_univ, true_and, mem_insert]
      constructor
      · rintro ⟨h1, h2⟩
        rcases h1.lt_or_eq with h | h
        · exact Or.inr ⟨h, h2⟩
        · exact Or.inl h.symm
      · rintro (rfl | ⟨h1, h2⟩)
        · exact ⟨le_rfl, rfl⟩
        · exact ⟨h1.le, h2⟩
    rw [hTi, card_insert_of_notMem (by simp), ← hr, laterCol, card_filter]
  set pt := T.orderEmbOfFin hTcard with hpt
  have hptm : StrictMono pt := pt.strictMono
  have hptT : ∀ p, pt p ∈ T := fun p => orderEmbOfFin_mem T hTcard p
  have hpt0 : pt 0 = i := by
    have h0 : pt ⟨0, Nat.succ_pos r⟩ = T.min' _ := orderEmbOfFin_zero hTcard (Nat.succ_pos r)
    have h0' : (0 : Fin (r + 1)) = ⟨0, Nat.succ_pos r⟩ := rfl
    rw [h0', h0]
    apply le_antisymm
    · exact min'_le _ _ (by simp [hT])
    · exact (mem_filter.mp (min'_mem T _)).2.1
  have hblock : ∀ p, c (pt p) = c (pt 0) := fun p => by
    rw [hpt0]; exact (mem_filter.mp (hptT p)).2.2
  set m := max N r with hm
  have hrm : r ≤ m := le_max_right N r
  refine ⟨blockProd c pt * dD pt m, ⟨c, r, pt, m, hptm, hblock, le_max_left _ _, rfl⟩, ?_⟩
  obtain ⟨G, hG⟩ := vdm_dvd_dD hptm m
  obtain ⟨hdeg, hne⟩ := degree_dD hptm hrm
  have hG0 : G ≠ 0 := by rintro rfl; rw [mul_zero] at hG; exact hne hG
  have hGdeg : (lexO k).degree G = Finsupp.single (pt 0) (m - r) := by
    have h1 := hdeg
    rw [hG, MonomialOrder.degree_mul (vdm_ne_zero hptm) hG0, degree_dT hptm] at h1
    have h2 := (degree_dD hptm (le_refl r)).1
    rw [dD_self, degree_dT hptm] at h2
    rw [h2, show Finsupp.single (pt 0) m =
        Finsupp.single (pt 0) r + Finsupp.single (pt 0) (m - r) by
      rw [← Finsupp.single_add, Nat.add_sub_cancel' hrm]] at h1
    have h3 := add_left_cancel (by simpa only [add_assoc] using h1)
    rw [add_comm (Finsupp.single (pt 0) (m - r))] at h3
    exact add_left_cancel h3
  have heq : blockProd c pt * dD pt m = pprod (samePairs c) * G := by
    rw [hG, ← mul_assoc, blockProd_mul_vdm c hptm hblock]
  rw [heq]
  have hsp := samePairs_lt c
  refine ⟨mul_ne_zero (pprod_ne_zero hsp) hG0, ?_⟩
  rw [MonomialOrder.degree_mul (pprod_ne_zero hsp) hG0, degree_pprod hsp, hGdeg, hpt0]
  refine Finsupp.le_def.mpr fun j => ?_
  rw [Finsupp.coe_add, Pi.add_apply, degree_samePairs_apply, Finsupp.single_apply]
  split_ifs with hij
  · subst hij
    have h1 : m ≤ e i := max_le hi (hr ▸ hc i)
    omega
  · rw [add_zero]; exact hc j

/-! ### The generation input -/

/-- **`GenInclusion n` for every `n ≥ 2`.** -/
theorem genInclusion {n : ℕ} (hn : 2 ≤ n) : GenInclusion n := by
  intro k N f hL hV
  set B : Set (XP k) := {g | g ∈ genSet n k N ∧ g ≠ 0} with hBdef
  have hB : ∀ b ∈ B, IsUnit ((lexO k).leadingCoeff b) := fun b hb =>
    IsUnit.mk0 _ (MonomialOrder.leadingCoeff_ne_zero_iff.mpr hb.2)
  obtain ⟨g, r, hdec, -, hrem⟩ := (lexO k).div_set hB f
  have hcomb : Finsupp.linearCombination (XP k) (fun b : B => (b : XP k)) g ∈
      Ideal.span (genSet n k N) := by
    rw [Finsupp.linearCombination_apply, Finsupp.sum]
    refine Ideal.sum_mem _ fun b _ => ?_
    rw [smul_eq_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span b.2.1)
  have hr0 : r = 0 := by
    by_contra hr
    have hreq : r = f - Finsupp.linearCombination (XP k) (fun b : B => (b : XP k)) g := by
      rw [hdec]; ring
    have hrL : r ∈ Lid k N := by
      rw [hreq]; exact sub_mem hL (span_genSet_le_Lid hn hcomb)
    have hrV : r ∈ vanIdeal n k := by
      rw [hreq]; exact sub_mem hV (span_genSet_le_vanIdeal hn hcomb)
    have he := (lexO k).degree_mem_support hr
    obtain ⟨i, hi⟩ := exists_ge_of_mem_Lid hrL _ he
    have hnw := not_win_of_vanish k (Q n 0) r hr (eval_eq_zero_of_Q (by omega) hrV)
    obtain ⟨c, hc⟩ := exists_blocks_of_not_win hn hnw
    obtain ⟨b, hbgen, hb0, hble⟩ := exists_small_gen c hc hi
    exact hrem _ he b ⟨hbgen, hb0⟩ hble
  rw [hdec, hr0, add_zero]
  exact hcomb

/-- **The arrangement inclusion for every `n ≥ 2`.** -/
theorem arrangementInclusion {n : ℕ} (hn : 2 ≤ n) : ArrangementInclusion n :=
  arrangementInclusion_of_genInclusion hn (genInclusion hn)

theorem symArrangementInclusion_one : ArrangementSym.SymArrangementInclusion 1 := by
  intro N k d _ hk _ _ f _ _ _ hV
  set i : Fin k := ⟨0, by omega⟩
  have h := hV {i} (card_singleton i) i (mem_singleton_self i)
  have hid : collapseTo i ({i} : Finset (Fin k)) = id := funext fun j => by
    simp only [collapseTo, mem_singleton, id]
    split_ifs with hj
    · exact hj.symm
    · rfl
  rw [hid, rename_id_apply] at h
  rw [h]
  exact Submodule.zero_mem _

/-- **The narrowed arrangement inclusion for every `n ≥ 1`.** -/
theorem symArrangementInclusion {n : ℕ} (hn : 1 ≤ n) :
    ArrangementSym.SymArrangementInclusion n := by
  rcases Nat.lt_or_ge n 2 with h | h
  · obtain rfl : n = 1 := by omega
    exact symArrangementInclusion_one
  · exact symArrangementInclusion_of_genInclusion h (genInclusion h)

end

