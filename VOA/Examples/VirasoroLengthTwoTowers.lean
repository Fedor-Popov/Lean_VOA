import VOA.Examples.VirasoroLengthTwoQuasiPrimary
import VOA.Core.GlobalConformalTowers

/-!
# Global towers generated by the length-two Virasoro quasi-primaries

This file combines the explicit vectors `lengthTwoQ c m` with the general global-conformal-tower
lemmas.  It records filtration preservation, the closed descendant-pairing recursion, and tower
orthogonality.  The only scalar not evaluated here is the base norm of `lengthTwoQ c m` itself.
-/

set_option linter.style.longLine false

namespace VOA

namespace VirGradedUnitarity

open VOA.VirModule VOA.VirSimple VOA.VirQuotForm
open VOA.VirGoodFil VOA.VertexOperatorAlgebra

variable (c : ℂ)

/-- The image of `Q_{2m}` in the simple quotient `L(c,0)`. -/
noncomputable def lengthTwoQSimple (m : ℕ) : VirUniv c ⧸ maxIdealVir c :=
  (maxIdealVir c).mkQ (lengthTwoQ c m)

/-- The `r`-th universal global descendant of `Q_{2m}` remains in filtration degree two and has
weight `2m+r`. -/
theorem lengthTwoQ_tower_mem_virFil (m : ℕ) (hm : 2 ≤ m) (r : ℕ) :
    (Lop c (-1) ^ r) (lengthTwoQ c m) ∈ virFil c 2 ((2 * m + r : ℕ) : ℤ) := by
  induction r with
  | zero => simpa using lengthTwoQ_mem_virFil c m hm
  | succ r ih =>
      rw [pow_succ', Module.End.mul_apply]
      have h := Lop_neg_one_virFil c ih
      have hweight : ((2 * m + r : ℕ) : ℤ) + 1 = ((2 * m + (r + 1) : ℕ) : ℤ) := by
        push_cast
        ring
      rwa [hweight] at h

/-- `Q_{2m}` belongs to filtration degree two after passage to the simple quotient. -/
theorem lengthTwoQSimple_mem_goodFil (m : ℕ) (hm : 2 ≤ m) :
    lengthTwoQSimple c m ∈ goodFil c 2 (2 * m : ℤ) := by
  rw [lengthTwoQSimple, goodFil]
  exact ⟨lengthTwoQ c m, lengthTwoQ_mem_virFil c m hm, rfl⟩

/-- The simple-quotient image of `Q_{2m}` is quasi-primary (possibly zero). -/
theorem lengthTwoQSimple_quasiPrimary (m : ℕ) (hm : 2 ≤ m) :
    (virasoroSimple c).L 1 (lengthTwoQSimple c m) = 0 := by
  rw [lengthTwoQSimple, ← mkQ_L, virasoroVOA_L_eq_Lop, lengthTwoQ_quasiPrimary c m hm,
    map_zero]

/-- Every simple-quotient global descendant of `Q_{2m}` remains in filtration degree two. -/
theorem lengthTwoQSimple_tower_mem_goodFil (m : ℕ) (hm : 2 ≤ m) (r : ℕ) :
    ((virasoroSimple c).L (-1) ^ r) (lengthTwoQSimple c m) ∈
      goodFil c 2 ((2 * m + r : ℕ) : ℤ) := by
  simpa [lengthTwoQSimple] using
    L_neg_one_pow_goodFil c (lengthTwoQSimple_mem_goodFil c m hm) r

/-- The exact invariant-form norm recursion along the tower generated by `Q_{2m}`. -/
theorem form_lengthTwoQ_tower (B : InvariantForm (virasoroVOA c)) (m : ℕ) (hm : 2 ≤ m)
    (r : ℕ) :
    B.form (((virasoroVOA c).L (-1) ^ r) (lengthTwoQ c m))
        (((virasoroVOA c).L (-1) ^ r) (lengthTwoQ c m)) =
      globalDescendantFactor (2 * m : ℤ) r •
        B.form (lengthTwoQ c m) (lengthTwoQ c m) := by
  apply B.form_globalDescendant
  · exact lengthTwoQ_mem_grading c m hm
  · simpa [virasoroVOA_L_eq_Lop] using lengthTwoQ_quasiPrimary c m hm

/-- Distinct descendant depths of length-two quasi-primary towers are orthogonal.  In particular,
at a fixed final weight this separates towers born at distinct even weights. -/
theorem form_lengthTwoQ_towers_eq_zero_of_depth_ne
    (B : InvariantForm (virasoroVOA c)) (hB : B.IsSymmetric)
    (m k : ℕ) (hm : 2 ≤ m) (hk : 2 ≤ k) {r s : ℕ} (hrs : r ≠ s) :
    B.form (((virasoroVOA c).L (-1) ^ r) (lengthTwoQ c m))
        (((virasoroVOA c).L (-1) ^ s) (lengthTwoQ c k)) = 0 := by
  apply B.form_globalTowers_eq_zero_of_ne hB
  · exact lengthTwoQ_mem_grading c m hm
  · simpa [virasoroVOA_L_eq_Lop] using lengthTwoQ_quasiPrimary c m hm
  · exact lengthTwoQ_mem_grading c k hk
  · simpa [virasoroVOA_L_eq_Lop] using lengthTwoQ_quasiPrimary c k hk
  · exact hrs

/-! ## The triangular family at a fixed final weight -/

/-- Indices of the new length-two towers that have begun by weight `N`. -/
def LengthTwoTowerIndex (N : ℕ) := {m : ℕ // 2 ≤ m ∧ 2 * m ≤ N}

/-- The vector in weight `N` obtained from the quasi-primary born in weight `2m`. -/
noncomputable def lengthTwoTowerAt (N : ℕ) (m : LengthTwoTowerIndex N) : VirUniv c :=
  ((virasoroVOA c).L (-1) ^ (N - 2 * m.1)) (lengthTwoQ c m.1)

/-- **Conditional tower independence.**  Once every base norm is known to be nonzero, the
length-two tower vectors present at weight `N` are linearly independent.  The proof uses only
global-tower orthogonality and the positive descendant factor; it does not use PBW. -/
theorem lengthTwoTowerAt_linearIndependent
    (B : InvariantForm (virasoroVOA c)) (hB : B.IsSymmetric) (N : ℕ)
    (hnorm : ∀ m : LengthTwoTowerIndex N,
      B.form (lengthTwoQ c m.1) (lengthTwoQ c m.1) ≠ 0) :
    LinearIndependent ℂ (lengthTwoTowerAt c N) := by
  refine LinearMap.BilinForm.linearIndependent_of_iIsOrtho
    (B := B.form) (v := lengthTwoTowerAt c N) ?_ ?_
  · rw [LinearMap.BilinForm.iIsOrtho_def]
    intro i j hij
    apply form_lengthTwoQ_towers_eq_zero_of_depth_ne c B hB i.1 j.1 i.2.1 j.2.1
    intro hdepth
    apply hij
    apply Subtype.ext
    have hi : 2 * i.1 ≤ N := i.2.2
    have hj : 2 * j.1 ≤ N := j.2.2
    have hdouble : 2 * i.1 = 2 * j.1 := by omega
    omega
  · intro i
    change B.form (lengthTwoTowerAt c N i) (lengthTwoTowerAt c N i) ≠ 0
    rw [lengthTwoTowerAt, form_lengthTwoQ_tower c B i.1 i.2.1]
    have hweight : (0 : ℤ) < 2 * (i.1 : ℤ) := by
      have him : (2 : ℤ) ≤ (i.1 : ℤ) := by exact_mod_cast i.2.1
      omega
    obtain ⟨a, ha, hfactor⟩ := globalDescendantFactor_real_pos
      (m := 2 * (i.1 : ℤ)) hweight (N - 2 * i.1)
    rw [hfactor, smul_eq_mul]
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (ne_of_gt ha)) (hnorm i)

end VirGradedUnitarity

end VOA
