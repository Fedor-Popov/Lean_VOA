import VOA.Examples.AffineSl2QuasiLisse

/-!
# Candidate `C₂` ideals for the boundary affine `sl₂` series

For the boundary level `k = -2 + 2 / p`, with `p = 2n + 1`, the paper proof identifies the
`sl₂`-stable ideal generated by the leading symbol of the vacuum singular vector as

```text
(Cas^n e, Cas^n h, Cas^n f) ⊂ Sym(sl₂).
```

This file records that concrete commutative-algebra ideal.  It does not identify it with the
kernel of a VOA symbol map; that exact-presentation statement remains a separate theorem.

For `n = 1` the ideal agrees with the existing `casIdeal` used at level `-4/3`.  Uniformly,
`Cas^(n+1)` belongs to the ideal, an elementary consequence of
`Cas = h^2 + 4 e f`.
-/

namespace VOA.AffineSl2BoundaryC2

open VOA.QuasiLisseSl2

noncomputable section

/-- The candidate boundary `C₂` ideal `(Cas^n e, Cas^n h, Cas^n f)` in `Sym(sl₂)`.

At the boundary level indexed by `p = 2n + 1`, these are the three classical relations obtained
from the highest-weight singular symbol and its `sl₂` orbit. -/
def boundaryIdeal (n : ℕ) : Ideal SymSl2 :=
  Ideal.span
    ({casSym ^ n * eSym, casSym ^ n * hSym, casSym ^ n * fSym} : Set SymSl2)

/-- The `Cas^n e` generator belongs to `boundaryIdeal n`. -/
theorem cas_pow_mul_e_mem (n : ℕ) : casSym ^ n * eSym ∈ boundaryIdeal n :=
  Ideal.subset_span (by simp)

/-- The `Cas^n h` generator belongs to `boundaryIdeal n`. -/
theorem cas_pow_mul_h_mem (n : ℕ) : casSym ^ n * hSym ∈ boundaryIdeal n :=
  Ideal.subset_span (by simp)

/-- The `Cas^n f` generator belongs to `boundaryIdeal n`. -/
theorem cas_pow_mul_f_mem (n : ℕ) : casSym ^ n * fSym ∈ boundaryIdeal n :=
  Ideal.subset_span (by simp)

/-- The first boundary ideal is the existing `casIdeal = (Cas e, Cas h, Cas f)` used for the
exceptional level `k = -4/3`. -/
theorem boundaryIdeal_one : boundaryIdeal 1 = casIdeal := by
  apply le_antisymm
  · rw [boundaryIdeal, Ideal.span_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · simpa [eSym] using cas_mul_X_mem 0
    · simpa [hSym] using cas_mul_X_mem 1
    · simpa [fSym] using cas_mul_X_mem 2
  · rw [casIdeal, Ideal.span_le]
    rintro x ⟨i, rfl⟩
    fin_cases i
    · simpa [eSym] using cas_pow_mul_e_mem 1
    · simpa [hSym] using cas_pow_mul_h_mem 1
    · simpa [fSym] using cas_pow_mul_f_mem 1

/-- The candidate boundary relations imply `Cas^(n+1) = 0` in the quotient.

Indeed, after writing `Cas = h^2 + 4 e f`, each summand of `Cas^n Cas` is a multiple of one of
the three generators. -/
theorem cas_pow_succ_mem_boundaryIdeal (n : ℕ) :
    casSym ^ (n + 1) ∈ boundaryIdeal n := by
  have hh : hSym * (casSym ^ n * hSym) ∈ boundaryIdeal n :=
    Ideal.mul_mem_left _ _ (cas_pow_mul_h_mem n)
  have hef : (4 * fSym) * (casSym ^ n * eSym) ∈ boundaryIdeal n :=
    Ideal.mul_mem_left _ _ (cas_pow_mul_e_mem n)
  simp only [casSym] at hh hef
  rw [pow_succ, casSym]
  convert Ideal.add_mem _ hh hef using 1
  ring_nf

/-! ## Horizontal adjoint stability -/

/-- A derivation killing the Casimir also kills every power of the Casimir. -/
theorem derivation_cas_pow_eq_zero (D : SymSl2 →ₗ[ℂ] SymSl2)
    (hlei : ∀ p q : SymSl2, D (p * q) = D p * q + p * D q)
    (hcas : D casSym = 0) (n : ℕ) :
    D (casSym ^ n) = 0 := by
  induction n with
  | zero =>
      have h := hlei 1 1
      have h' : D 1 + D 1 = D 1 + 0 := by
        simpa only [one_mul, mul_one, add_zero] using h.symm
      exact add_left_cancel h'
  | succ n ih => rw [pow_succ, hlei, ih, hcas, zero_mul, mul_zero, add_zero]

/-- A derivation preserves `boundaryIdeal n` once it preserves its three displayed generators. -/
theorem boundaryIdeal_stable (D : SymSl2 →ₗ[ℂ] SymSl2)
    (hlei : ∀ p q : SymSl2, D (p * q) = D p * q + p * D q)
    (hgen :
      D (casSym ^ n * eSym) ∈ boundaryIdeal n ∧
      D (casSym ^ n * hSym) ∈ boundaryIdeal n ∧
      D (casSym ^ n * fSym) ∈ boundaryIdeal n) :
    ∀ p ∈ boundaryIdeal n, D p ∈ boundaryIdeal n := by
  intro p hp
  induction hp using Submodule.span_induction with
  | mem x hx =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl
      · exact hgen.1
      · exact hgen.2.1
      · exact hgen.2.2
  | zero => simp
  | add x y _ _ hx hy =>
      rw [map_add]
      exact Ideal.add_mem _ hx hy
  | smul r x hx hxm =>
      rw [smul_eq_mul, hlei]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hx) (Ideal.mul_mem_left _ _ hxm)

/-- A Casimir-killing derivation whose values on the three coordinates remain linear preserves
every uniform boundary ideal. -/
theorem boundary_cas_ad_mem (D : SymSl2 →ₗ[ℂ] SymSl2)
    (hlei : ∀ p q : SymSl2, D (p * q) = D p * q + p * D q) (hcas : D casSym = 0)
    (hX : ∀ i : Fin 3, ∃ (c : SymSl2) (j : Fin 3), D (MvPolynomial.X i) = c * MvPolynomial.X j)
    (n : ℕ) : ∀ p ∈ boundaryIdeal n, D p ∈ boundaryIdeal n := by
  refine boundaryIdeal_stable D hlei ?_
  have hpow := derivation_cas_pow_eq_zero D hlei hcas n
  have hgen (i : Fin 3) : D (casSym ^ n * MvPolynomial.X i) ∈ boundaryIdeal n := by
    obtain ⟨c, j, hij⟩ := hX i
    have heq : D (casSym ^ n * MvPolynomial.X i) = c * (casSym ^ n * MvPolynomial.X j) := by
      rw [hlei, hpow, zero_mul, zero_add, hij]
      ac_rfl
    rw [heq]
    fin_cases j
    · exact Ideal.mul_mem_left _ _ (cas_pow_mul_e_mem n)
    · exact Ideal.mul_mem_left _ _ (cas_pow_mul_h_mem n)
    · exact Ideal.mul_mem_left _ _ (cas_pow_mul_f_mem n)
  exact ⟨hgen 0, hgen 1, hgen 2⟩

/-- The uniform boundary ideal is stable under the horizontal raising derivation. -/
theorem adE_boundaryIdeal (n : ℕ) : ∀ p ∈ boundaryIdeal n, adE p ∈ boundaryIdeal n := by
  refine boundary_cas_ad_mem adE adE_mul adE_cas ?_ n
  intro i
  fin_cases i
  · exact ⟨0, 0, by simp [adE, eSym, hSym, MvPolynomial.pderiv_X]⟩
  · exact ⟨-2, 0, by simp [adE, eSym, hSym, MvPolynomial.pderiv_X]⟩
  · exact ⟨1, 1, by simp [adE, eSym, hSym, MvPolynomial.pderiv_X]⟩

/-- The uniform boundary ideal is stable under the Cartan derivation. -/
theorem adH_boundaryIdeal (n : ℕ) : ∀ p ∈ boundaryIdeal n, adH p ∈ boundaryIdeal n := by
  refine boundary_cas_ad_mem adH adH_mul adH_cas ?_ n
  intro i
  fin_cases i
  · exact ⟨2, 0, by simp [adH, eSym, fSym, MvPolynomial.pderiv_X]⟩
  · exact ⟨0, 0, by simp [adH, eSym, fSym, MvPolynomial.pderiv_X]⟩
  · exact ⟨-2, 2, by simp [adH, eSym, fSym, MvPolynomial.pderiv_X]⟩

/-- The uniform boundary ideal is stable under the horizontal lowering derivation. -/
theorem adF_boundaryIdeal (n : ℕ) : ∀ p ∈ boundaryIdeal n, adF p ∈ boundaryIdeal n := by
  refine boundary_cas_ad_mem adF adF_mul adF_cas ?_ n
  intro i
  fin_cases i
  · exact ⟨-1, 1, by simp [adF, hSym, fSym, MvPolynomial.pderiv_X]⟩
  · exact ⟨2, 2, by simp [adF, hSym, fSym, MvPolynomial.pderiv_X]⟩
  · exact ⟨0, 0, by simp [adF, hSym, fSym, MvPolynomial.pderiv_X]⟩

end
end VOA.AffineSl2BoundaryC2
