import VOA.Examples.AffineSl2QuasiLisse
import VOA.Examples.AffineSl2Presentation

/-!
# The boundary affine harmonic line in `Sym(sl₂)`

This file proves that the homogeneous horizontal highest-weight space of polynomial degree
`2n+1` and horizontal weight `2` is the line generated by `e · Cas^n`.  The proof first classifies
the possible monomial support, extracts the two-term coefficient recurrence imposed by `adE`,
and compares an arbitrary solution with the explicit Casimir candidate.
-/

namespace VOA
namespace QuasiLisseSl2

noncomputable section

/-- The candidate boundary harmonic line `e · Cas^n`. -/
def harmonicLine (n : ℕ) : SymSl2 :=
  eSym * casSym ^ n

@[simp] theorem harmonicLine_zero : harmonicLine 0 = eSym := by
  simp [harmonicLine]

/-- The Casimir is homogeneous of degree `2`. -/
theorem casSym_homogeneous : (casSym : SymSl2).IsHomogeneous 2 := by
  rw [casSym]
  have hh : (hSym ^ 2 : SymSl2).IsHomogeneous 2 := by
    simpa using (MvPolynomial.isHomogeneous_X_pow (R := ℂ) 1 2)
  have hef : ((MvPolynomial.C (4 : ℂ) : SymSl2) * eSym * fSym).IsHomogeneous 2 := by
    have he : (eSym : SymSl2).IsHomogeneous 1 := by
      simpa using (MvPolynomial.isHomogeneous_X (R := ℂ) 0)
    have hf : (fSym : SymSl2).IsHomogeneous 1 := by
      simpa using (MvPolynomial.isHomogeneous_X (R := ℂ) 2)
    simpa [mul_assoc, mul_left_comm, mul_comm] using (he.C_mul (4 : ℂ)).mul hf
  simpa [casSym, add_comm, add_left_comm, add_assoc] using hh.add hef

/-- The coefficient of the top pure-`h` monomial in `casSym^n` is `1`. -/
theorem coeff_casSym_pow_pure_h (n : ℕ) :
    MvPolynomial.coeff (Finsupp.single 1 (2 * n)) (casSym ^ n) = 1 := by
  induction n with
  | zero =>
      simp [casSym]
  | succ n ih =>
      have hh0 : (MvPolynomial.monomial (Finsupp.single 1 2) (1 : ℂ) : SymSl2) = hSym ^ 2 := by
        rw [monomial_one_eq]
        simp [eSym, hSym, fSym, pow_zero, pow_one, mul_assoc, mul_left_comm, mul_comm,
          MvPolynomial.X]
      have hh : (hSym ^ 2 : SymSl2) = MvPolynomial.monomial (Finsupp.single 1 2) (1 : ℂ) :=
        hh0.symm
      have hef0 : (MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 2 1) (1 : ℂ) :
          SymSl2) = eSym * fSym := by
        rw [monomial_one_eq]
        simp [eSym, hSym, fSym, pow_zero, pow_one, mul_assoc, mul_left_comm, mul_comm,
          MvPolynomial.X]
      have hef : ((MvPolynomial.C (4 : ℂ) : SymSl2) * eSym * fSym) =
          MvPolynomial.monomial (Finsupp.single 0 1 + Finsupp.single 2 1) (4 : ℂ) := by
        rw [mul_assoc, ← hef0, MvPolynomial.C_mul_monomial, mul_one]
      have hle : Finsupp.single (1 : Fin 3) 2 ≤ Finsupp.single 1 (2 * (n + 1)) := by
        simp [Finsupp.single_le_iff]
      have hsubNat : 2 * (n + 1) - 2 = 2 * n := by
        omega
      have hsub :
          Finsupp.single (1 : Fin 3) (2 * (n + 1)) - Finsupp.single 1 2 =
            Finsupp.single 1 (2 * n) := by
        ext i
        fin_cases i <;> simp [hsubNat]
      have hbad :
          ¬ Finsupp.single (0 : Fin 3) 1 + Finsupp.single 2 1 ≤
            Finsupp.single 1 (2 * (n + 1)) := by
        intro hs
        have h0 := hs 0
        simp at h0
      have hfirst :
          MvPolynomial.coeff (Finsupp.single 1 (2 * (n + 1)))
            (hSym ^ 2 * casSym ^ n) = 1 := by
        rw [hh, MvPolynomial.coeff_monomial_mul']
        rw [if_pos hle, hsub, ih, one_mul]
      have hsecond :
          MvPolynomial.coeff (Finsupp.single 1 (2 * (n + 1)))
            (((4 : SymSl2) * eSym * fSym) * casSym ^ n) = 0 := by
        change MvPolynomial.coeff (Finsupp.single 1 (2 * (n + 1)))
          (((MvPolynomial.C (4 : ℂ) : SymSl2) * eSym * fSym) * casSym ^ n) = 0
        rw [hef, MvPolynomial.coeff_monomial_mul']
        rw [if_neg hbad]
      calc
        MvPolynomial.coeff (Finsupp.single 1 (2 * (n + 1))) (casSym ^ (n + 1))
            = MvPolynomial.coeff (Finsupp.single 1 (2 * (n + 1)))
                ((hSym ^ 2 + ((4 : SymSl2) * eSym * fSym)) * casSym ^ n) := by
                  rw [pow_succ, casSym]
                  congr 1
                  exact mul_comm _ _
        _ = MvPolynomial.coeff (Finsupp.single 1 (2 * (n + 1)))
              (hSym ^ 2 * casSym ^ n) +
            MvPolynomial.coeff (Finsupp.single 1 (2 * (n + 1)))
              (((4 : SymSl2) * eSym * fSym) * casSym ^ n) := by
                  rw [add_mul, MvPolynomial.coeff_add]
        _ = 1 := by
          simp [hfirst, hsecond]

/-- `adE` kills every power of the Casimir. -/
theorem adE_casPow (n : ℕ) : adE (casSym ^ n) = 0 := by
  induction n with
  | zero =>
      simp [adE]
  | succ n ih =>
      rw [pow_succ, adE_mul, ih, adE_cas, zero_mul, mul_zero, add_zero]

/-- `adH` kills every power of the Casimir. -/
theorem adH_casPow (n : ℕ) : adH (casSym ^ n) = 0 := by
  induction n with
  | zero =>
      simp [adH]
  | succ n ih =>
      rw [pow_succ, adH_mul, ih, adH_cas, zero_mul, mul_zero, add_zero]

/-- `adF` kills every power of the Casimir. -/
theorem adF_casPow (n : ℕ) : adF (casSym ^ n) = 0 := by
  induction n with
  | zero =>
      simp [adF]
  | succ n ih =>
      rw [pow_succ, adF_mul, ih, adF_cas, zero_mul, mul_zero, add_zero]

/-- The Cartan action on a monomial `e^a h^c f^b` is the expected horizontal weight. -/
theorem adH_monomial (a c b : ℕ) :
    adH (eSym ^ a * hSym ^ c * fSym ^ b) =
      ((2 * a - 2 * b : ℂ)) • (eSym ^ a * hSym ^ c * fSym ^ b) := by
  have hf : adH (fSym ^ b) = ((-2 * b : ℂ)) • fSym ^ b := by
    simpa [pow_zero] using adH_hf (c := 0) b
  change adH ((eSym ^ a * hSym ^ c) * fSym ^ b) =
    ((2 * a - 2 * b : ℂ)) • (eSym ^ a * hSym ^ c * fSym ^ b)
  calc
    adH ((eSym ^ a * hSym ^ c) * fSym ^ b) =
        adH (eSym ^ a * hSym ^ c) * fSym ^ b + (eSym ^ a * hSym ^ c) * adH (fSym ^ b) := by
      rw [adH_mul]
    _ = (((2 * a : ℂ) • (eSym ^ a * hSym ^ c)) * fSym ^ b +
        (eSym ^ a * hSym ^ c) * ((-2 * b : ℂ) • fSym ^ b)) := by
      rw [adH_eh, hf]
    _ = (((2 * a : ℂ) • (eSym ^ a * hSym ^ c * fSym ^ b)) +
        ((-2 * b : ℂ) • (eSym ^ a * hSym ^ c * fSym ^ b))) := by
      simp [mul_smul, mul_assoc]
    _ = (((2 * a : ℂ) + (-2 * b : ℂ)) • (eSym ^ a * hSym ^ c * fSym ^ b)) := by
      simpa using (add_smul (2 * a : ℂ) (-2 * b : ℂ)
        (eSym ^ a * hSym ^ c * fSym ^ b)).symm
    _ = ((2 * a - 2 * b : ℂ)) • (eSym ^ a * hSym ^ c * fSym ^ b) := by
      congr 1
      ring

/-- The Cartan action on any monomial `X₀^a X₁^c X₂^b` is the expected horizontal weight. -/
theorem adH_monomial_general (m : Fin 3 →₀ ℕ) (r : ℂ) :
    adH (MvPolynomial.monomial m r) = ((2 * m 0 - 2 * m 2 : ℂ)) •
      MvPolynomial.monomial m r := by
  rw [adH, adOf_apply]
  simp only [eSym, fSym, mul_assoc]
  rw [MvPolynomial.X_mul_pderiv_monomial (R := ℂ) (i := 0) (m := m) (r := r),
    MvPolynomial.X_mul_pderiv_monomial (R := ℂ) (i := 2) (m := m) (r := r)]
  simp [Algebra.smul_def]
  rw [C_two]
  ring

/-- The coefficient of `adH p` at a fixed monomial is the expected horizontal weight times the
coefficient of `p`. -/
theorem coeff_adH (p : SymSl2) (s : Fin 3 →₀ ℕ) :
    MvPolynomial.coeff s (adH p) = ((2 * s 0 - 2 * s 2 : ℂ)) * MvPolynomial.coeff s p := by
  classical
  rw [MvPolynomial.as_sum p, map_sum, MvPolynomial.coeff_sum]
  by_cases hs : s ∈ p.support
  · rw [Finset.sum_eq_single s
        (fun v _ hv => by
          simp [adH_monomial_general, MvPolynomial.coeff_monomial, hv])
        (fun h => by
          exact absurd hs h)]
    simp [adH_monomial_general]
  · have hcoeff : MvPolynomial.coeff s p = 0 := by
      simpa [MvPolynomial.notMem_support_iff] using hs
    simp [hcoeff, adH_monomial_general, hs]

/-- The raising action on a general monomial is the expected `∂₁/∂₂` formula. -/
theorem adE_monomial (m : Fin 3 →₀ ℕ) (r : ℂ) :
    adE (MvPolynomial.monomial m r) =
      (-2 * eSym) * MvPolynomial.monomial (m - Finsupp.single 1 1) (r * m 1) +
        hSym * MvPolynomial.monomial (m - Finsupp.single 2 1) (r * m 2) := by
  simp [adE, eSym, hSym, fSym, adOf_apply, MvPolynomial.pderiv_monomial]

/-- The harmonic basis exponent `e^(j+1) h^(2(n-j)) f^j`. -/
def harmonicExp (n j : ℕ) : Fin 3 →₀ ℕ :=
  Finsupp.single 0 (j + 1) + Finsupp.single 1 (2 * (n - j)) + Finsupp.single 2 j

/-- The target exponent `e^(j+2) h^(2(n-j)-1) f^j` used in the `adE` recurrence. -/
def targetExp (n j : ℕ) : Fin 3 →₀ ℕ :=
  Finsupp.single 0 (j + 2) + Finsupp.single 1 (2 * (n - j) - 1) + Finsupp.single 2 j

@[simp] theorem harmonicExp_zero (n j : ℕ) : harmonicExp n j 0 = j + 1 := by
  simp [harmonicExp]

@[simp] theorem harmonicExp_one (n j : ℕ) : harmonicExp n j 1 = 2 * (n - j) := by
  simp [harmonicExp]

@[simp] theorem harmonicExp_two (n j : ℕ) : harmonicExp n j 2 = j := by
  simp [harmonicExp]

theorem harmonicExp_one_cast (n j : ℕ) :
    ((harmonicExp n j 1 : ℕ) : ℂ) = ((2 * (n - j) : ℕ) : ℂ) := by
  simp [harmonicExp]

theorem harmonicExp_two_cast (n j : ℕ) :
    ((harmonicExp n j 2 : ℕ) : ℂ) = (j : ℂ) := by
  simp [harmonicExp]

@[simp] theorem targetExp_zero (n j : ℕ) : targetExp n j 0 = j + 2 := by
  simp [targetExp]

@[simp] theorem targetExp_one (n j : ℕ) : targetExp n j 1 = 2 * (n - j) - 1 := by
  simp [targetExp]

@[simp] theorem targetExp_two (n j : ℕ) : targetExp n j 2 = j := by
  simp [targetExp]

/-- `harmonicExp n j - single 1 1` has the expected explicit coordinates. -/
theorem harmonicExp_sub_one (n j : ℕ) :
    harmonicExp n j - Finsupp.single 1 1 =
      Finsupp.single 0 (j + 1) + Finsupp.single 1 (2 * (n - j) - 1) + Finsupp.single 2 j := by
  ext i <;> fin_cases i <;> simp [harmonicExp]

/-- `harmonicExp n (j+1) - single 2 1` has the expected explicit coordinates. -/
theorem harmonicExp_sub_two_succ (n j : ℕ) :
    harmonicExp n (j + 1) - Finsupp.single 2 1 =
      Finsupp.single 0 (j + 2) + Finsupp.single 1 (2 * (n - (j + 1))) + Finsupp.single 2 j := by
  ext i <;> fin_cases i <;> simp [harmonicExp]

/-- `targetExp n j - single 0 1` has the expected explicit coordinates. -/
theorem targetExp_sub_zero (n j : ℕ) :
    targetExp n j - Finsupp.single 0 1 =
      Finsupp.single 0 (j + 1) + Finsupp.single 1 (2 * (n - j) - 1) + Finsupp.single 2 j := by
  ext i <;> fin_cases i <;> simp [targetExp]

/-- `targetExp n j - single 1 1` has the expected explicit coordinates. -/
theorem targetExp_sub_one (n j : ℕ) :
    targetExp n j - Finsupp.single 1 1 =
      Finsupp.single 0 (j + 2) + Finsupp.single 1 (2 * (n - j) - 2) + Finsupp.single 2 j := by
  ext i <;> fin_cases i <;> simp [targetExp]
  · omega

/-- The target exponent cannot equal the `e`-branch shift unless the harmonic index matches. -/
theorem targetExp_minus_e_ne (n i j : ℕ) (hij : i ≠ j) :
    targetExp n j - Finsupp.single 0 1 ≠ harmonicExp n i - Finsupp.single 1 1 := by
  intro h
  have h2 := congrArg (fun s : Fin 3 →₀ ℕ => s 2) h
  simp [harmonicExp, targetExp] at h2
  omega

/-- The target exponent cannot equal the `h`-branch shift unless the harmonic index matches. -/
theorem targetExp_minus_h_ne (n i j : ℕ) (hij : i ≠ j + 1) :
    targetExp n j - Finsupp.single 1 1 ≠ harmonicExp n i - Finsupp.single 2 1 := by
  intro h
  have h0 := congrArg (fun s : Fin 3 →₀ ℕ => s 0) h
  simp [harmonicExp, targetExp] at h0
  omega

/-- The `e`-branch contribution vanishes away from the matching harmonic index. -/
theorem coeff_target_first_term_zero (n i j : ℕ) (hj : j < n) (hij : i ≠ j) (a c : ℂ) :
    MvPolynomial.coeff (targetExp n j)
      (((MvPolynomial.C a : SymSl2) * eSym) * MvPolynomial.monomial (harmonicExp n i - Finsupp.single 1 1)
        c) = 0 := by
  have he : ((MvPolynomial.C a : SymSl2) * eSym : SymSl2) =
      MvPolynomial.monomial (Finsupp.single 0 1) a := by
    simpa [eSym, MvPolynomial.monomial_eq, C_two]
  rw [he, MvPolynomial.coeff_monomial_mul']
  by_cases hsle : Finsupp.single 0 1 ≤ targetExp n j
  · rw [if_pos hsle]
    have hcoeff :
        MvPolynomial.coeff (targetExp n j - Finsupp.single 0 1)
          (MvPolynomial.monomial (harmonicExp n i - Finsupp.single 1 1) c) = 0 := by
      rw [MvPolynomial.coeff_monomial]
      exact if_neg (by
        intro h
        exact (targetExp_minus_e_ne n i j hij) h.symm)
    simp [hcoeff]
  · rw [if_neg hsle]

/-- The `h`-branch contribution vanishes away from the matching harmonic index. -/
theorem coeff_target_second_term_zero (n i j : ℕ) (hj : j < n) (hij : i ≠ j + 1) (c : ℂ) :
    MvPolynomial.coeff (targetExp n j)
      ((hSym : SymSl2) * MvPolynomial.monomial (harmonicExp n i - Finsupp.single 2 1)
        c) = 0 := by
  have hh : (hSym : SymSl2) = MvPolynomial.monomial (Finsupp.single 1 1) (1 : ℂ) := by
    simpa [hSym, MvPolynomial.monomial_eq, C_two]
  rw [hh, MvPolynomial.coeff_monomial_mul']
  by_cases hsle : Finsupp.single 1 1 ≤ targetExp n j
  · rw [if_pos hsle]
    have hcoeff :
        MvPolynomial.coeff (targetExp n j - Finsupp.single 1 1)
          (MvPolynomial.monomial (harmonicExp n i - Finsupp.single 2 1) c) = 0 := by
      rw [MvPolynomial.coeff_monomial]
      exact if_neg (by
        intro h
        exact (targetExp_minus_h_ne n i j hij) h.symm)
    simp [hcoeff]
  · rw [if_neg hsle]

/-- The first `adE` contribution at the target exponent. -/
theorem coeff_target_first_term (n j : ℕ) (hj : j < n) (r : ℂ) :
    MvPolynomial.coeff (targetExp n j)
      ((-2 * eSym : SymSl2) * MvPolynomial.monomial (harmonicExp n j - Finsupp.single 1 1)
        (r * (2 * (n - j) : ℂ))) =
      (-4 * (n - j) : ℂ) * r := by
  have he : (-2 * eSym : SymSl2) = MvPolynomial.monomial (Finsupp.single 0 1) (-2 : ℂ) := by
    simpa [eSym, MvPolynomial.monomial_eq, C_two]
  rw [he]
  have hsle : Finsupp.single 0 1 ≤ targetExp n j := by
    rw [Finsupp.single_le_iff]
    have hsub : 1 ≤ n - j := Nat.succ_le_of_lt (Nat.sub_pos_of_lt hj)
    have htarget : 1 ≤ 2 * (n - j) - 1 := by omega
    simpa [targetExp] using htarget
  rw [MvPolynomial.coeff_monomial_mul']
  have hif : harmonicExp n j - Finsupp.single 1 1 = targetExp n j - Finsupp.single 0 1 := by
    ext i <;> fin_cases i <;> simp [harmonicExp, targetExp, hj]
  simp [hsle, hif]
  ring

/-- The second `adE` contribution at the target exponent. -/
theorem coeff_target_second_term (n j : ℕ) (hj : j < n) (r : ℂ) :
    MvPolynomial.coeff (targetExp n j)
      ((hSym : SymSl2) * MvPolynomial.monomial (harmonicExp n (j + 1) - Finsupp.single 2 1)
        (r * ((j + 1 : ℕ) : ℂ))) =
      (j + 1 : ℂ) * r := by
  have hh : (hSym : SymSl2) = MvPolynomial.monomial (Finsupp.single 1 1) (1 : ℂ) := by
    simpa [hSym, MvPolynomial.monomial_eq, C_two]
  rw [hh]
  have hsle : Finsupp.single 1 1 ≤ targetExp n j := by
    rw [Finsupp.single_le_iff]
    have hsub : 1 ≤ n - j := Nat.succ_le_of_lt (Nat.sub_pos_of_lt hj)
    have htarget : 1 ≤ 2 * (n - j) - 1 := by omega
    simpa [targetExp] using htarget
  rw [MvPolynomial.coeff_monomial_mul']
  have hif : harmonicExp n (j + 1) - Finsupp.single 2 1 = targetExp n j - Finsupp.single 1 1 := by
    ext i <;> fin_cases i <;> simp [harmonicExp, targetExp, hj]
    · omega
  simp [hsle, hif]
  ring

/-- The coefficient of `adE` on a harmonic monomial only sees the two neighboring indices. -/
theorem coeff_target_adE_harmonicExp (n i j : ℕ) (hj : j < n) (r : ℂ) :
    MvPolynomial.coeff (targetExp n j)
      (adE (MvPolynomial.monomial (harmonicExp n i) r)) =
      (if i = j then (-4 * (n - j) : ℂ) * r else 0) +
        (if i = j + 1 then (j + 1 : ℂ) * r else 0) := by
  rw [adE_monomial, MvPolynomial.coeff_add]
  by_cases hij : i = j
  · rw [hij]
    have h1Nat : r * ↑((harmonicExp n j) 1) = r * ((2 * (n - j) : ℕ) : ℂ) := by
      simpa [harmonicExp, mul_assoc, mul_left_comm, mul_comm] using
        congrArg (fun t : ℂ => r * t) (harmonicExp_one_cast (n := n) (j := j))
    have hcast : ((2 * (n - j) : ℕ) : ℂ) = 2 * (n - j : ℂ) := by
      rw [Nat.cast_mul]
      congr 1
      exact_mod_cast Nat.cast_sub (Nat.le_of_lt hj)
    have h1 : r * ↑((harmonicExp n j) 1) = r * (2 * (n - j : ℂ)) := by
      rw [h1Nat, hcast]
    have h2 : r * ↑((harmonicExp n j) 2) = r * ((j : ℕ) : ℂ) := by
      simpa [harmonicExp, mul_assoc, mul_left_comm, mul_comm] using
        congrArg (fun t : ℂ => r * t) (harmonicExp_two_cast (n := n) (j := j))
    have hfirst := coeff_target_first_term (n := n) (j := j) (hj := hj) (r := r)
    have hzero : MvPolynomial.coeff (targetExp n j)
        ((hSym : SymSl2) * MvPolynomial.monomial (harmonicExp n j - Finsupp.single 2 1)
          (r * ((j : ℕ) : ℂ))) = 0 := by
      exact coeff_target_second_term_zero (n := n) (i := j) (j := j) hj
        (Nat.ne_of_lt (Nat.lt_succ_self j)) (r * ((j : ℕ) : ℂ))
    rw [h1, h2, hfirst, hzero]
    simp
  · by_cases hij1 : i = j + 1
    · rw [hij1]
      have h1 : r * ↑((harmonicExp n (j + 1)) 1) = r * ((2 * (n - (j + 1)) : ℕ) : ℂ) := by
        simpa [harmonicExp, mul_assoc, mul_left_comm, mul_comm] using
          congrArg (fun t : ℂ => r * t) (harmonicExp_one_cast (n := n) (j := j + 1))
      have h2 : r * ↑((harmonicExp n (j + 1)) 2) = r * ((j + 1 : ℕ) : ℂ) := by
        simpa [harmonicExp, mul_assoc, mul_left_comm, mul_comm] using
          congrArg (fun t : ℂ => r * t) (harmonicExp_two_cast (n := n) (j := j + 1))
      have hsecond := coeff_target_second_term (n := n) (j := j) (hj := hj) (r := r)
      have hzero : MvPolynomial.coeff (targetExp n j)
          ((2 * eSym : SymSl2) *
            MvPolynomial.monomial (harmonicExp n (j + 1) - Finsupp.single 1 1)
              (r * (2 * ((n - (j + 1) : ℕ) : ℂ)))) = 0 := by
        simpa using
          (coeff_target_first_term_zero (n := n) (i := j + 1) (j := j) hj
              (Nat.succ_ne_self j) (2 : ℂ) (r * (2 * ((n - (j + 1) : ℕ) : ℂ))))
      have hfirst :
          MvPolynomial.coeff (targetExp n j)
            ((-2 * eSym : SymSl2) *
              MvPolynomial.monomial (harmonicExp n (j + 1) - Finsupp.single 1 1)
                (r * (2 * ((n - (j + 1) : ℕ) : ℂ)))) = 0 := by
        have hneg :
            ((-2 * eSym : SymSl2) *
              MvPolynomial.monomial (harmonicExp n (j + 1) - Finsupp.single 1 1)
                (r * (2 * ((n - (j + 1) : ℕ) : ℂ)))) =
              -((2 * eSym : SymSl2) *
                MvPolynomial.monomial (harmonicExp n (j + 1) - Finsupp.single 1 1)
                  (r * (2 * ((n - (j + 1) : ℕ) : ℂ)))) := by
          ring
        rw [hneg, MvPolynomial.coeff_neg, hzero]
        simp
      rw [h1, h2]
      have hcast :
          ((2 * (n - (j + 1)) : ℕ) : ℂ) = 2 * ((n - (j + 1) : ℕ) : ℂ) := by
        norm_num
      rw [hcast]
      rw [hfirst, hsecond]
      simp
    · have hzero1 : MvPolynomial.coeff (targetExp n j)
          ((2 * eSym : SymSl2) *
            MvPolynomial.monomial (harmonicExp n i - Finsupp.single 1 1)
              (r * (2 * ((n - i : ℕ) : ℂ)))) = 0 := by
          simpa using
            (coeff_target_first_term_zero (n := n) (i := i) (j := j) hj hij
              (2 : ℂ) (r * (2 * ((n - i : ℕ) : ℂ))))
      have hzero2 : MvPolynomial.coeff (targetExp n j)
          ((hSym : SymSl2) * MvPolynomial.monomial (harmonicExp n i - Finsupp.single 2 1)
            (r * ((i : ℕ) : ℂ))) = 0 := by
          exact coeff_target_second_term_zero (n := n) (i := i) (j := j) hj hij1
            (r * ((i : ℕ) : ℂ))
      have h1 : r * ↑((harmonicExp n i) 1) = r * ((2 * (n - i) : ℕ) : ℂ) := by
        simpa [harmonicExp, mul_assoc, mul_left_comm, mul_comm] using
          congrArg (fun t : ℂ => r * t) (harmonicExp_one_cast (n := n) (j := i))
      have h2 : r * ↑((harmonicExp n i) 2) = r * ((i : ℕ) : ℂ) := by
        simpa [harmonicExp, mul_assoc, mul_left_comm, mul_comm] using
          congrArg (fun t : ℂ => r * t) (harmonicExp_two_cast (n := n) (j := i))
      rw [h1, h2, if_neg hij, if_neg hij1]
      simp [hzero1, hzero2]

/-- `adE` on powers of `h` has the expected coefficient. -/
theorem adE_hPow_succ (c : ℕ) :
    adE (hSym ^ (c + 1)) = ((-2 * (c + 1) : ℂ)) • (eSym * hSym ^ c) := by
  induction c with
  | zero =>
      simpa [VOA.Sl2Pres.adE_h]
  | succ c ih =>
      rw [pow_succ, adE_mul, ih, VOA.Sl2Pres.adE_h]
      repeat rw [Algebra.smul_def]
      simp [C_two, mul_assoc, mul_left_comm, mul_comm]
      ring

/-- `adE` on powers of `f` has the expected coefficient. -/
theorem adE_fPow_succ (b : ℕ) :
    adE (fSym ^ (b + 1)) = ((b + 1 : ℂ)) • (hSym * fSym ^ b) := by
  induction b with
  | zero =>
      simpa [VOA.Sl2Pres.adE_f]
  | succ b ih =>
      rw [pow_succ, adE_mul, ih, VOA.Sl2Pres.adE_f]
      repeat rw [Algebra.smul_def]
      simp [mul_assoc, mul_left_comm, mul_comm]
      ring

/-- A homogeneous horizontal weight-two polynomial has only the harmonic support monomials. -/
theorem support_harmonic (n : ℕ) (p : SymSl2)
    (hp : p.IsHomogeneous (2 * n + 1)) (hH : adH p = (2 : ℂ) • p) :
    ∀ s ∈ p.support, ∃ j ≤ n,
      j = s 2 ∧
        s = Finsupp.single 0 (j + 1) + Finsupp.single 1 (2 * (n - j)) + Finsupp.single 2 j := by
  intro s hs
  have hnonzero : MvPolynomial.coeff s p ≠ 0 := by
    simpa [MvPolynomial.notMem_support_iff] using hs
  have hEq' : MvPolynomial.coeff s (adH p) = (2 : ℂ) * MvPolynomial.coeff s p := by
    have h := congrArg (MvPolynomial.coeff s) hH
    simpa [MvPolynomial.coeff_smul] using h
  have hEq : ((2 * s 0 - 2 * s 2 : ℂ)) * MvPolynomial.coeff s p =
      (2 : ℂ) * MvPolynomial.coeff s p := by
    rw [coeff_adH (p := p) s] at hEq'
    exact hEq'
  have hscalar : ((2 * s 0 - 2 * s 2 : ℂ)) = 2 := by
    exact mul_right_cancel₀ hnonzero hEq
  have hscalarZ : (2 * (s 0 : ℤ) - 2 * (s 2 : ℤ)) = 2 := by
    exact_mod_cast hscalar
  have h0 : s 0 = s 2 + 1 := by
    omega
  have hdeg : s.degree = 2 * n + 1 := by
    by_contra hdeg
    exact hnonzero (hp.coeff_eq_zero hdeg)
  have hsum' : ∑ i : Fin 3, s i = 2 * n + 1 := by
    simpa [hdeg] using (Finsupp.degree_eq_sum (f := s)).symm
  have hsum : s 0 + s 1 + s 2 = 2 * n + 1 := by
    simpa [Fin.sum_univ_three] using hsum'
  have hle : s 2 ≤ n := by
    omega
  have hs1 : s 1 = 2 * (n - s 2) := by
    omega
  refine ⟨s 2, hle, rfl, ?_⟩
  ext i
  fin_cases i <;> simp [h0, hs1]

/-- A homogeneous horizontal weight-two polynomial is a finite sum of harmonic support monomials. -/
theorem harmonic_support_normalForm (n : ℕ) (p : SymSl2)
    (hp : p.IsHomogeneous (2 * n + 1)) (hH : adH p = (2 : ℂ) • p) :
    p = ∑ s ∈ p.support,
      MvPolynomial.monomial (harmonicExp n (s 2)) (MvPolynomial.coeff (harmonicExp n (s 2)) p) := by
  conv_lhs => rw [MvPolynomial.as_sum p]
  refine Finset.sum_congr rfl ?_
  intro s hs
  rcases support_harmonic n p hp hH s hs with ⟨j, hj, hjs, hsdef⟩
  subst hsdef
  simp [harmonicExp] at hjs ⊢

/-- A homogeneous horizontal weight-two polynomial has the range-indexed harmonic normal form. -/
theorem harmonic_range_normalForm (n : ℕ) (p : SymSl2)
    (hp : p.IsHomogeneous (2 * n + 1)) (hH : adH p = (2 : ℂ) • p) :
    p = ∑ j ∈ Finset.range (n + 1),
      MvPolynomial.monomial (harmonicExp n j) (MvPolynomial.coeff (harmonicExp n j) p) := by
  ext s
  by_cases hs : s ∈ p.support
  · rcases support_harmonic n p hp hH s hs with ⟨j, hj, hjs, hsdef⟩
    subst j
    have hjmem : s 2 ∈ Finset.range (n + 1) :=
      Finset.mem_range.mpr (Nat.lt_succ_iff.mpr hj)
    rw [MvPolynomial.coeff_sum]
    rw [Finset.sum_eq_single (s 2)]
    · have heq : harmonicExp n (s 2) = s := by
        rw [harmonicExp]
        exact hsdef.symm
      rw [MvPolynomial.coeff_monomial, if_pos heq, heq]
    · intro b hb hne
      rw [MvPolynomial.coeff_monomial]
      split_ifs with heq
      · have h2 := congrArg (fun t : Fin 3 →₀ ℕ => t 2) heq
        simp [harmonicExp] at h2
        exact (hne h2) |> False.elim
      · simp
    · exact fun h => (h hjmem).elim
  · have hzero : MvPolynomial.coeff s p = 0 := by
      simpa [MvPolynomial.notMem_support_iff] using hs
    rw [MvPolynomial.coeff_sum]
    simp only [MvPolynomial.coeff_monomial]
    rw [hzero]
    symm
    apply Finset.sum_eq_zero
    intro j hj
    split_ifs with heq
    · subst s
      simpa [MvPolynomial.notMem_support_iff] using hs
    · simp

/-- The raising equation gives the two-term recurrence for neighboring harmonic coefficients. -/
theorem harmonic_coeff_recurrence (n : ℕ) (p : SymSl2)
    (hp : p.IsHomogeneous (2 * n + 1)) (hH : adH p = (2 : ℂ) • p)
    (hE : adE p = 0) (j : ℕ) (hj : j < n) :
    ((j + 1 : ℕ) : ℂ) * MvPolynomial.coeff (harmonicExp n (j + 1)) p =
      (4 * (n - j) : ℂ) * MvPolynomial.coeff (harmonicExp n j) p := by
  have hcoeff := congrArg (MvPolynomial.coeff (targetExp n j)) hE
  rw [harmonic_range_normalForm n p hp hH] at hcoeff
  simp only [map_sum, MvPolynomial.coeff_sum, MvPolynomial.coeff_zero] at hcoeff
  simp_rw [coeff_target_adE_harmonicExp n _ j hj] at hcoeff
  have hjmem : j ∈ Finset.range (n + 1) :=
    Finset.mem_range.mpr (Nat.lt_succ_of_lt hj)
  have hjsmem : j + 1 ∈ Finset.range (n + 1) :=
    Finset.mem_range.mpr (Nat.succ_lt_succ hj)
  simp [Finset.sum_add_distrib, hjmem, hjsmem] at hcoeff
  norm_num [Nat.cast_sub (Nat.le_of_lt hj)] at hcoeff ⊢
  linear_combination hcoeff

/-- The boundary harmonic candidate is homogeneous of degree `2n+1`. -/
theorem harmonicLine_homogeneous (n : ℕ) :
    (harmonicLine n).IsHomogeneous (2 * n + 1) := by
  have he : (eSym : SymSl2).IsHomogeneous 1 := by
    simpa [eSym] using (MvPolynomial.isHomogeneous_X (R := ℂ) 0)
  have hcas : (casSym ^ n : SymSl2).IsHomogeneous (2 * n) :=
    casSym_homogeneous.pow n
  simpa [harmonicLine, Nat.add_comm] using he.mul hcas

/-- The top harmonic coefficient of `e · Cas^n` is `1`. -/
theorem coeff_harmonicLine_top (n : ℕ) :
    MvPolynomial.coeff (harmonicExp n 0) (harmonicLine n) = 1 := by
  have he : (eSym : SymSl2) =
      MvPolynomial.monomial (Finsupp.single 0 1) (1 : ℂ) := by
    simpa [eSym, MvPolynomial.monomial_eq, C_two]
  have hsle : Finsupp.single (0 : Fin 3) 1 ≤ harmonicExp n 0 := by
    rw [Finsupp.single_le_iff]
    simp [harmonicExp]
  have hsub : harmonicExp n 0 - Finsupp.single 0 1 = Finsupp.single 1 (2 * n) := by
    ext i
    fin_cases i <;> simp [harmonicExp]
  rw [harmonicLine, he, MvPolynomial.coeff_monomial_mul', if_pos hsle, hsub,
    coeff_casSym_pow_pure_h, one_mul]

/-- The boundary harmonic candidate is killed by `adE`. -/
theorem adE_harmonicLine (n : ℕ) : adE (harmonicLine n) = 0 := by
  have hE : adE eSym = 0 := by
    simp [adE, eSym, hSym, MvPolynomial.pderiv_X]
  calc
    adE (harmonicLine n) = adE eSym * casSym ^ n + eSym * adE (casSym ^ n) := by
      rw [harmonicLine, adE_mul]
    _ = 0 := by
      simp [hE, adE_casPow]

/-- The boundary harmonic candidate has horizontal weight `2`. -/
theorem adH_harmonicLine (n : ℕ) : adH (harmonicLine n) = (2 : ℂ) • harmonicLine n := by
  have hH : adH eSym = (2 : ℂ) • eSym := by
    simp [adH, eSym, fSym, MvPolynomial.pderiv_X, MvPolynomial.smul_eq_C_mul, C_two]
  calc
    adH (harmonicLine n) = adH eSym * casSym ^ n + eSym * adH (casSym ^ n) := by
      rw [harmonicLine, adH_mul]
    _ = ((2 : ℂ) • eSym) * casSym ^ n := by
      simp [hH, adH_casPow]
    _ = (2 : ℂ) • harmonicLine n := by
      simp [harmonicLine]

/-- The boundary harmonic candidate is the expected horizontal highest-weight vector. -/
theorem harmonicLine_isHighestWeight (n : ℕ) :
    adE (harmonicLine n) = 0 ∧ adH (harmonicLine n) = (2 : ℂ) • harmonicLine n :=
  ⟨adE_harmonicLine n, adH_harmonicLine n⟩

/-- The lowering action on the harmonic candidate is the obvious first descendant. -/
theorem adF_harmonicLine (n : ℕ) : adF (harmonicLine n) = (-1 : ℂ) • (hSym * casSym ^ n) := by
  have hF : adF eSym = (-1 : ℂ) • hSym := by
    simp [adF, eSym, hSym, fSym, MvPolynomial.pderiv_X]
  calc
    adF (harmonicLine n) = adF eSym * casSym ^ n + eSym * adF (casSym ^ n) := by
      rw [harmonicLine, adF_mul]
    _ = ((-1 : ℂ) • hSym) * casSym ^ n := by
      simp [hF, adF_casPow]
    _ = (-1 : ℂ) • (hSym * casSym ^ n) := by
      simp

/-- Every homogeneous horizontal highest-weight vector of degree `2n+1` and weight `2`
is a scalar multiple of `e · Cas^n`. -/
theorem eq_smul_harmonicLine (n : ℕ) (p : SymSl2)
    (hp : p.IsHomogeneous (2 * n + 1))
    (hH : adH p = (2 : ℂ) • p) (hE : adE p = 0) :
    ∃ c : ℂ, p = c • harmonicLine n := by
  let c := MvPolynomial.coeff (harmonicExp n 0) p
  let q : SymSl2 := c • harmonicLine n
  have hqhom : q.IsHomogeneous (2 * n + 1) := by
    simpa [q, Algebra.smul_def] using (harmonicLine_homogeneous n).C_mul c
  have hqH : adH q = (2 : ℂ) • q := by
    simp [q, map_smul, adH_harmonicLine, smul_smul, mul_comm]
  have hqE : adE q = 0 := by
    simp [q, map_smul, adE_harmonicLine]
  have hcoeff : ∀ j ≤ n,
      MvPolynomial.coeff (harmonicExp n j) p =
        MvPolynomial.coeff (harmonicExp n j) q := by
    intro j hj
    induction j with
    | zero =>
        simp [q, c, MvPolynomial.coeff_smul, coeff_harmonicLine_top]
    | succ j ih =>
        have hjlt : j < n := Nat.lt_of_succ_le hj
        have hpRec := harmonic_coeff_recurrence n p hp hH hE j hjlt
        have hqRec := harmonic_coeff_recurrence n q hqhom hqH hqE j hjlt
        have hprev := ih (Nat.le_of_lt hjlt)
        have hmul :
            (((j + 1 : ℕ) : ℂ) * MvPolynomial.coeff (harmonicExp n (j + 1)) p) =
              (((j + 1 : ℕ) : ℂ) * MvPolynomial.coeff (harmonicExp n (j + 1)) q) := by
          calc
            (((j + 1 : ℕ) : ℂ) * MvPolynomial.coeff (harmonicExp n (j + 1)) p) =
                (4 * (n - j) : ℂ) * MvPolynomial.coeff (harmonicExp n j) p := hpRec
            _ = (4 * (n - j) : ℂ) * MvPolynomial.coeff (harmonicExp n j) q := by
              rw [hprev]
            _ = (((j + 1 : ℕ) : ℂ) *
                MvPolynomial.coeff (harmonicExp n (j + 1)) q) := hqRec.symm
        exact mul_left_cancel₀ (by exact_mod_cast Nat.succ_ne_zero j) hmul
  refine ⟨c, ?_⟩
  change p = q
  calc
    p = ∑ j ∈ Finset.range (n + 1),
        MvPolynomial.monomial (harmonicExp n j)
          (MvPolynomial.coeff (harmonicExp n j) p) := harmonic_range_normalForm n p hp hH
    _ = ∑ j ∈ Finset.range (n + 1),
        MvPolynomial.monomial (harmonicExp n j)
          (MvPolynomial.coeff (harmonicExp n j) q) := by
      apply Finset.sum_congr rfl
      intro j hj
      rw [hcoeff j (Nat.le_of_lt_succ (Finset.mem_range.mp hj))]
    _ = q := (harmonic_range_normalForm n q hqhom hqH).symm

end
