import VOA.Examples.InverseDSLeeYangMaximalSubmodule
import VOA.Examples.VirasoroAdmissibleCombinatorics

/-!
# A general Virasoro Verma module for the inverse-DS simple-quotient problem

The universal Virasoro carrier already in the repository is the vacuum module `V(c,0)`: its
highest vector is killed by `L_{-1}`.  The inverse-DS target instead has highest weight `-1/5`,
and `L_{-1}` acts nontrivially.  This leaf supplies the missing general Verma carrier
`M(c,h) = U(Vir) / I(c,h)`.

The construction is unconditional.  It gives the Virasoro action, the highest-weight relations,
central charge, cyclicity, and the universal map to every concrete highest-weight
representation.  It also proves the complete straightening theorem for negative creation words:
inside every `M(c,h)`, arbitrary words in `L_{-1},L_{-2},...` are spanned by weakly ordered PBW
words of the same level.

PBW independence and the full general Verma basis are proved downstream in
`VirasoroVermaMomentumPolynomial` and `VirasoroVermaBasis`, for every (c,h).
The Lee--Yang gap-two quotient basis remains a separate representation theorem.  In particular, the two
singular relations at levels two and three must still be completed to the infinite
Rogers--Ramanujan/Groebner normal form; this leaf makes that statement possible without confusing
it with missing carrier or sorting infrastructure.
-/

set_option linter.style.longLine false

namespace VOA
namespace InverseDS
namespace VirasoroVerma

open LieAlgebra LieAlgebra.Extension UniversalEnvelopingAlgebra
open Module (End)
open VirModule
open LeeYangWardClosure

noncomputable section

/-! ## The general Verma quotient -/

/-- Defining left-ideal generators for the Virasoro Verma module of central charge `c` and
highest weight `h`. -/
def vermaGens (c h : ℂ) : Set UVir :=
  {a | (∃ n : ℤ, 0 < n ∧ a = ι ℂ (L n))
      ∨ a = ι ℂ C - algebraMap ℂ UVir c
      ∨ a = ι ℂ (L 0) - algebraMap ℂ UVir h}

/-- The left ideal defining `M(c,h)`. -/
noncomputable def vermaIdeal (c h : ℂ) : Submodule UVir UVir :=
  Submodule.span _ (vermaGens c h)

/-- Each defining highest-weight relation lies in the left ideal generated by those relations. This inclusion is the basic step when proving that the quotient satisfies its intended equations. -/
theorem vermaGens_subset_ideal (c h : ℂ) :
    vermaGens c h ⊆ ↑(vermaIdeal c h) :=
  Submodule.subset_span

/-- The universal Virasoro Verma module `M(c,h)`. -/
abbrev Verma (c h : ℂ) : Type := UVir ⧸ vermaIdeal c h

/-- Virasoro acts on `M(c,h)` by left multiplication. -/
noncomputable def vermaRho (c h : ℂ) : LieHom ℂ Virasoro (End ℂ (Verma c h)) :=
  (Algebra.lsmul ℂ ℂ (Verma c h)).toLieHom.comp (ι ℂ)

/-- Acting on a quotient class by a Virasoro element means multiplying its representative on the left in the enveloping algebra and then passing back to the quotient. -/
theorem vermaRho_mk (c h : ℂ) (x : Virasoro) (a : UVir) :
    vermaRho c h x (Submodule.Quotient.mk a) =
      Submodule.Quotient.mk (ι ℂ x * a) := rfl

/-- The highest-weight vector `[1]`. -/
noncomputable def highestVector (c h : ℂ) : Verma c h :=
  Submodule.Quotient.mk 1

/-- Every strictly positive Virasoro mode kills the highest vector because that mode itself is a defining generator of the quotient ideal. -/
theorem verma_pos_annihilate (c h : ℂ) (n : ℤ) (hn : 0 < n) :
    vermaRho c h (L n) (highestVector c h) = 0 := by
  rw [highestVector, vermaRho_mk, mul_one, Submodule.Quotient.mk_eq_zero]
  exact vermaGens_subset_ideal c h (Or.inl ⟨n, hn, rfl⟩)

/-- The zero mode acts on the highest vector with eigenvalue h. This follows from the defining relation L₀-h and does not assert that the highest vector is nonzero. -/
theorem verma_zero_acts (c h : ℂ) :
    vermaRho c h (L 0) (highestVector c h) = h • highestVector c h := by
  rw [highestVector, vermaRho_mk, mul_one, ← Submodule.Quotient.mk_smul,
    Algebra.smul_def, mul_one, Submodule.Quotient.eq]
  exact vermaGens_subset_ideal c h (Or.inr (Or.inr rfl))

set_option maxHeartbeats 800000 in
-- This is the same quotient-by-representatives central-action calculation as `vac_acts_central`.
/-- The centre acts on the whole Verma module by `c`. -/
theorem verma_acts_central (c h : ℂ) :
    vermaRho c h C = c • LinearMap.id := by
  refine LinearMap.ext fun m => ?_
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  rw [vermaRho_mk, LinearMap.smul_apply, LinearMap.id_coe, id_eq,
    ← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
  have hcomm : Commute a (ι ℂ C - algebraMap ℂ UVir c) :=
    (VirModule.commute_ι_C a).symm.sub_right (Algebra.commute_algebraMap_right c a)
  have heq : ι ℂ C * a - c • a = a * (ι ℂ C - algebraMap ℂ UVir c) := by
    rw [hcomm.eq, sub_mul, Algebra.smul_def]
  rw [heq, ← smul_eq_mul]
  exact (vermaIdeal c h).smul_mem a
    (vermaGens_subset_ideal c h (Or.inr (Or.inl rfl)))

/-- `M(c,h)` as a Virasoro representation. -/
noncomputable def vermaRep (c h : ℂ) : VirRep (Verma c h) where
  ρ := vermaRho c h
  centralCharge := c
  acts_central := verma_acts_central c h

/-- The highest vector cyclically generates the Verma quotient as a `U(Vir)`-module. -/
theorem verma_cyclic (c h : ℂ) :
    Submodule.span UVir {highestVector c h} = ⊤ := by
  rw [eq_top_iff]
  rintro m -
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  have hv : a • highestVector c h = Submodule.Quotient.mk a := by
    rw [highestVector, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]
  rw [← hv]
  exact Submodule.smul_mem _ a (Submodule.mem_span_singleton_self _)

/-! ## Universal property -/

universe u

variable {V : Type u} [AddCommGroup V] [Module ℂ V]

/-- A vector of highest weight `(c,h)` in a concrete Virasoro representation. -/
structure IsHighestWeightVector (R : VirRep V) (v : V) (c h : ℂ) : Prop where
  centralCharge : R.centralCharge = c
  pos_annihilate : ∀ n : ℤ, 0 < n → virMode R n v = 0
  zero_acts : virMode R 0 v = h • v

/-- Evaluation of the enveloping algebra on a vector. -/
noncomputable def eval (R : VirRep V) (v : V) : UVir →ₗ[ℂ] V where
  toFun a := (lift ℂ R.ρ a) v
  map_add' a b := by rw [map_add, LinearMap.add_apply]
  map_smul' r a := by rw [map_smul, LinearMap.smul_apply]; rfl

/-- The identity of the enveloping algebra evaluates on a vector as that same vector. This fixes the normalization of the universal evaluation map. -/
@[simp] theorem eval_one (R : VirRep V) (v : V) : eval R v 1 = v := by
  change (lift ℂ R.ρ 1) v = v
  rw [map_one, Module.End.one_apply]

/-- Evaluating an enveloping-algebra generator agrees with the original Lie-algebra action. The extension of a representation introduces no additional operator on generators. -/
@[simp] theorem eval_ι (R : VirRep V) (v : V) (x : Virasoro) :
    eval R v (ι ℂ x) = R.ρ x v := by
  change (lift ℂ R.ρ (ι ℂ x)) v = R.ρ x v
  rw [lift_ι_apply]

/-- All defining Verma relations act as zero on a vector satisfying the highest-weight equations. Their entire left ideal therefore evaluates to zero, which is exactly what is needed to descend evaluation to the quotient. -/
theorem vermaIdeal_le_ker_eval (R : VirRep V) (v : V) {c h : ℂ}
    (hv : IsHighestWeightVector R v c h) :
    (vermaIdeal c h).restrictScalars ℂ ≤ LinearMap.ker (eval R v) := by
  intro a ha
  change a ∈ vermaIdeal c h at ha
  induction ha using Submodule.span_induction with
  | mem g hg =>
      rcases hg with ⟨n, hn, rfl⟩ | rfl | rfl
      · rw [LinearMap.mem_ker]
        change (lift ℂ R.ρ (ι ℂ (L n))) v = 0
        rw [lift_ι_apply]
        exact hv.pos_annihilate n hn
      · rw [LinearMap.mem_ker]
        change (lift ℂ R.ρ (ι ℂ C - algebraMap ℂ UVir c)) v = 0
        rw [map_sub, lift_ι_apply, R.acts_central,
          hv.centralCharge, AlgHom.commutes, Algebra.algebraMap_eq_smul_one,
          LinearMap.sub_apply]
        simp
      · rw [LinearMap.mem_ker]
        change (lift ℂ R.ρ (ι ℂ (L 0) - algebraMap ℂ UVir h)) v = 0
        rw [map_sub, lift_ι_apply, AlgHom.commutes,
          Algebra.algebraMap_eq_smul_one, LinearMap.sub_apply,
          LinearMap.smul_apply, Module.End.one_apply]
        change R.ρ (L 0) v - h • v = 0
        rw [show R.ρ (L 0) v = h • v from hv.zero_acts, sub_self]
  | zero => exact LinearMap.mem_ker.mpr (map_zero _)
  | add a b _ _ ha hb =>
      exact LinearMap.mem_ker.mpr (by rw [map_add, ha, hb, add_zero])
  | smul r a _ ha =>
      exact LinearMap.mem_ker.mpr (by
        have ha0 : eval R v a = 0 := LinearMap.mem_ker.mp ha
        change (lift ℂ R.ρ (r * a)) v = 0
        rw [map_mul, Module.End.mul_apply]
        change (lift ℂ R.ρ r) (eval R v a) = 0
        rw [ha0, map_zero])

/-- The universal map from `M(c,h)` to a concrete highest-weight representation. -/
noncomputable def universalMap (R : VirRep V) (v : V) {c h : ℂ}
    (hv : IsHighestWeightVector R v c h) : Verma c h →ₗ[ℂ] V :=
  (((vermaIdeal c h).restrictScalars ℂ).liftQ (eval R v)
      (vermaIdeal_le_ker_eval R v hv)).comp
    (Submodule.Quotient.restrictScalarsEquiv ℂ (vermaIdeal c h)).symm.toLinearMap

/-- The descended universal map evaluates any representative by the original enveloping-algebra action. Independence of the representative was established when the ideal was shown to lie in the evaluation kernel. -/
@[simp] theorem universalMap_mk (R : VirRep V) (v : V) {c h : ℂ}
    (hv : IsHighestWeightVector R v c h) (a : UVir) :
    universalMap R v hv (Submodule.Quotient.mk a) = eval R v a := rfl

/-- The universal map sends the formal highest vector to the chosen concrete highest-weight vector. This characterizes its normalization. -/
@[simp] theorem universalMap_highestVector (R : VirRep V) (v : V) {c h : ℂ}
    (hv : IsHighestWeightVector R v c h) :
    universalMap R v hv (highestVector c h) = v := by
  rw [highestVector, universalMap_mk, eval_one]

/-- The universal map commutes with every Virasoro generator. It is therefore a map of representations, not merely a linear map between their underlying spaces. -/
theorem universalMap_intertwines (R : VirRep V) (v : V) {c h : ℂ}
    (hv : IsHighestWeightVector R v c h) (x : Virasoro) (w : Verma c h) :
    universalMap R v hv (vermaRho c h x w) =
      R.ρ x (universalMap R v hv w) := by
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ w
  rw [vermaRho_mk, universalMap_mk, universalMap_mk]
  change (lift ℂ R.ρ (ι ℂ x * a)) v = R.ρ x ((lift ℂ R.ρ a) v)
  rw [map_mul, lift_ι_apply, Module.End.mul_apply]

/-- A concrete nonzero highest-weight vector certifies that the universal highest vector is nonzero: the universal map sends one to the other. The later VirasoroVermaNonvanishing module supplies such a witness for every charge and weight. -/
theorem highestVector_ne_zero_of_realization (R : VirRep V) (v : V) {c h : ℂ}
    (hv : IsHighestWeightVector R v c h) (hne : v ≠ 0) :
    highestVector c h ≠ 0 := by
  intro hz
  have := congrArg (universalMap R v hv) hz
  rw [universalMap_highestVector, map_zero] at this
  exact hne this

/-- Negative creation words in an arbitrary highest-weight representation. -/
def representationNegWord (R : VirRep V) (v : V) : List ℕ → V
  | [] => v
  | i :: w => virMode R (-(i : ℤ) - 1) (representationNegWord R v w)

/-! ## Ordered negative-mode words -/

/-- The Virasoro mode on `M(c,h)`. -/
def vermaMode (c h : ℂ) (m : ℤ) : End ℂ (Verma c h) :=
  vermaRho c h (L m)

/-- Applied Virasoro commutation relations on an arbitrary Verma state. Commuting two modes introduces the mode at their summed index and, only for opposite indices, the central scalar. -/
theorem vermaMode_comm_apply (c h : ℂ) (m n : ℤ) (w : Verma c h) :
    vermaMode c h m (vermaMode c h n w) =
      vermaMode c h n (vermaMode c h m w) +
        ((m : ℂ) - n) • vermaMode c h (m + n) w +
        (if m + n = 0 then
          ((((m : ℂ) ^ 3 - m) / 12 * c) • (1 : End ℂ (Verma c h))) w else 0) := by
  have hcomm := virMode_comm (vermaRep c h) m n
  have happ := LinearMap.congr_fun hcomm w
  simp only [vermaMode, virMode, vermaRep, LinearMap.sub_apply,
    Module.End.mul_apply, LinearMap.add_apply, LinearMap.smul_apply] at happ ⊢
  by_cases hmn : m + n = 0
  · simp only [if_pos hmn] at happ ⊢
    simp only [LinearMap.smul_apply, Module.End.one_apply] at happ ⊢
    rw [eq_add_of_sub_eq happ]
    abel
  · simp only [if_neg hmn, LinearMap.zero_apply] at happ ⊢
    rw [eq_add_of_sub_eq happ]
    abel

/-- A word entry `i` denotes the creation mode `L_{-i-1}`.  Unlike the vacuum convention, entry
zero is allowed and denotes the nontrivial `L_{-1}` action. -/
def negWord (c h : ℂ) : List ℕ → Verma c h
  | [] => highestVector c h
  | i :: w => vermaMode c h (-(i : ℤ) - 1) (negWord c h w)

/-- An empty creation word is the highest vector itself; no operators have acted yet. -/
@[simp] theorem negWord_nil (c h : ℂ) : negWord c h [] = highestVector c h := rfl

/-- A nonempty creation word applies its first negative mode to the state represented by the remaining word. Entry zero denotes L_(-1). -/
@[simp] theorem negWord_cons (c h : ℂ) (i : ℕ) (w : List ℕ) :
    negWord c h (i :: w) = vermaMode c h (-(i : ℤ) - 1) (negWord c h w) := rfl

/-- The universal map carries every abstract Verma PBW word to the corresponding concrete
creation word. -/
theorem universalMap_negWord (R : VirRep V) (v : V) {c h : ℂ}
    (hv : IsHighestWeightVector R v c h) (w : List ℕ) :
    universalMap R v hv (negWord c h w) = representationNegWord R v w := by
  induction w with
  | nil => exact universalMap_highestVector R v hv
  | cons i w ih =>
      rw [negWord_cons, representationNegWord, vermaMode,
        universalMap_intertwines, ih]
      rfl

/-- Conformal level of a highest-weight creation word. -/
def energyHW (w : List ℕ) : ℕ := (w.map fun i => i + 1).sum

/-- The highest vector is at relative level zero, so the empty word has zero creation energy. -/
@[simp] theorem energyHW_nil : energyHW [] = 0 := rfl

/-- Adding a mode L_(-i-1) increases the relative conformal level by i+1. -/
@[simp] theorem energyHW_cons (i : ℕ) (w : List ℕ) :
    energyHW (i :: w) = i + 1 + energyHW w := by
  simp [energyHW]

/-- Adjacent negative modes straighten by one energy-preserving merged mode. -/
theorem negWord_swap (c h : ℂ) (i j : ℕ) (rest : List ℕ) :
    negWord c h (i :: j :: rest) =
      negWord c h (j :: i :: rest) +
        ((j : ℂ) - (i : ℂ)) • negWord c h ((i + j + 1) :: rest) := by
  have hcomm := vermaMode_comm_apply c h (-(i : ℤ) - 1) (-(j : ℤ) - 1)
    (negWord c h rest)
  rw [if_neg (by omega : ¬((-(i : ℤ) - 1) + (-(j : ℤ) - 1) = 0)), add_zero,
    show (-(i : ℤ) - 1) + (-(j : ℤ) - 1) = -((i + j + 1 : ℕ) : ℤ) - 1 by
      push_cast; ring,
    show ((-(i : ℤ) - 1 : ℤ) : ℂ) - ((-(j : ℤ) - 1 : ℤ) : ℂ) =
        (j : ℂ) - (i : ℂ) by push_cast; ring] at hcomm
  simpa only [negWord_cons] using hcomm

/-- Swapping adjacent creation modes, or replacing them by the commutator mode, preserves total conformal level. Thus straightening never mixes levels. -/
theorem energyHW_swap (i j : ℕ) (rest : List ℕ) :
    energyHW (i :: j :: rest) = energyHW (j :: i :: rest) ∧
      energyHW (i :: j :: rest) = energyHW ((i + j + 1) :: rest) := by
  simp only [energyHW_cons]
  omega

/-- Span of ordered negative-mode words at one Verma level. -/
noncomputable def sortedSpan (c h : ℂ) (N : ℕ) : Submodule ℂ (Verma c h) :=
  Submodule.span ℂ {x | ∃ w : List ℕ,
    SortedWord w ∧ energyHW w = N ∧ negWord c h w = x}

/-- An already ordered word is one of the defining generators of the sorted span at its own energy. -/
theorem negWord_mem_sortedSpan_of_sorted (c h : ℂ) {w : List ℕ}
    (hw : SortedWord w) {N : ℕ} (hN : energyHW w = N) :
    negWord c h w ∈ sortedSpan c h N :=
  Submodule.subset_span ⟨w, hw, hN, rfl⟩

/-- Transport one creation-mode insertion from ordered generators to their span. -/
theorem sortedSpan_stable (c h : ℂ) {N : ℕ}
    (H : ∀ w : List ℕ, energyHW w = N → SortedWord w → ∀ i : ℕ,
      vermaMode c h (-(i : ℤ) - 1) (negWord c h w) ∈ sortedSpan c h (N + i + 1))
    (i : ℕ) {v : Verma c h} (hv : v ∈ sortedSpan c h N) :
    vermaMode c h (-(i : ℤ) - 1) v ∈ sortedSpan c h (N + i + 1) := by
  induction hv using Submodule.span_induction with
  | mem y hy => obtain ⟨w, hw, he, rfl⟩ := hy; exact H w he hw i
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [map_smul]; exact Submodule.smul_mem _ r ha

/-- Insertion sorting for Verma creation words. -/
theorem vermaMode_sorted_insert (c h : ℂ) (N : ℕ) :
    ∀ w : List ℕ, energyHW w = N → SortedWord w → ∀ i : ℕ,
      vermaMode c h (-(i : ℤ) - 1) (negWord c h w) ∈
        sortedSpan c h (N + i + 1) := by
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro w hw hsort i
    match w with
    | [] =>
        have hN : N = 0 := by rw [← hw]; rfl
        subst hN
        change negWord c h [i] ∈ sortedSpan c h (0 + i + 1)
        exact negWord_mem_sortedSpan_of_sorted c h (sortedWord_singleton i)
          (by simp only [energyHW_cons, energyHW_nil]; omega)
    | (j :: rest) =>
        have hw' : j + 1 + energyHW rest = N := by rw [← hw, energyHW_cons]
        change negWord c h (i :: j :: rest) ∈ sortedSpan c h (N + i + 1)
        rcases Nat.lt_or_ge i j with hij | hji
        · rw [negWord_swap]
          refine Submodule.add_mem _ ?_ (Submodule.smul_mem _ _ ?_)
          · have hrest : energyHW rest < N := by omega
            have h1 : vermaMode c h (-(i : ℤ) - 1) (negWord c h rest) ∈
                sortedSpan c h (energyHW rest + i + 1) :=
              ih _ hrest rest rfl hsort.tail i
            have hmiddle : energyHW rest + i + 1 < N := by omega
            have h2 := sortedSpan_stable c h (ih _ hmiddle) j h1
            have hreindex : energyHW rest + i + 1 + j + 1 = N + i + 1 := by omega
            rw [hreindex] at h2
            exact h2
          · refine negWord_mem_sortedSpan_of_sorted c h (SortedWord.cons hsort.tail ?_) ?_
            · intro b hb
              exact le_trans (hsort.head_ge b hb) (by omega)
            · simp only [energyHW_cons]
              omega
        · refine negWord_mem_sortedSpan_of_sorted c h (SortedWord.cons hsort ?_) ?_
          · intro b hb
            rcases List.mem_cons.mp hb with rfl | hb'
            · exact hji
            · exact le_trans (hsort.head_ge b hb') hji
          · simp only [energyHW_cons]
            omega

/-- Every negative-mode creation word straightens into ordered PBW words of the same level. -/
theorem negWord_mem_sortedSpan (c h : ℂ) (w : List ℕ) :
    negWord c h w ∈ sortedSpan c h (energyHW w) := by
  induction w with
  | nil => exact negWord_mem_sortedSpan_of_sorted c h sortedWord_nil rfl
  | cons i rest ih =>
      have h := sortedSpan_stable c h
        (vermaMode_sorted_insert c h (energyHW rest)) i ih
      have hreindex : energyHW rest + i + 1 = energyHW (i :: rest) := by
        rw [energyHW_cons]
        omega
      rw [hreindex] at h
      exact h

/-! ## The exact Lee--Yang normal-form target -/

/-- A Lee--Yang Verma word is admissible when adjacent parts differ by at least two.  Since an
entry `i` represents the part `i+1`, the difference condition is unchanged by the shift. -/
def IsLeeYangAdmissibleWord (w : List ℕ) : Prop :=
  SortedWord w ∧ AdmissiblePartitions.IsNAdmissible 2 w

/-- The level-two singular vector in the general Lee--Yang Verma module. -/
def leeYangVermaSingularTwo : Verma leeYangCentralCharge (-1 / 5) :=
  (5 : ℂ) • vermaMode leeYangCentralCharge (-1 / 5) (-1)
      (vermaMode leeYangCentralCharge (-1 / 5) (-1)
        (highestVector leeYangCentralCharge (-1 / 5))) +
    (-2 : ℂ) • vermaMode leeYangCentralCharge (-1 / 5) (-2)
      (highestVector leeYangCentralCharge (-1 / 5))

/-- The level-three singular vector in the general Lee--Yang Verma module. -/
def leeYangVermaSingularThree : Verma leeYangCentralCharge (-1 / 5) :=
  (25 : ℂ) • vermaMode leeYangCentralCharge (-1 / 5) (-1)
      (vermaMode leeYangCentralCharge (-1 / 5) (-1)
        (vermaMode leeYangCentralCharge (-1 / 5) (-1)
          (highestVector leeYangCentralCharge (-1 / 5)))) +
    (-40 : ℂ) • vermaMode leeYangCentralCharge (-1 / 5) (-2)
      (vermaMode leeYangCentralCharge (-1 / 5) (-1)
        (highestVector leeYangCentralCharge (-1 / 5))) +
    (-4 : ℂ) • vermaMode leeYangCentralCharge (-1 / 5) (-3)
      (highestVector leeYangCentralCharge (-1 / 5))

/-- The two-singular seed in `M(-22/5,-1/5)`. -/
noncomputable def leeYangVermaCandidateSeed :
    Submodule ℂ (Verma leeYangCentralCharge (-1 / 5)) :=
  Submodule.span ℂ {leeYangVermaSingularTwo, leeYangVermaSingularThree}

/-- The Virasoro-mode closure of the two Lee--Yang singular vectors. -/
noncomputable def leeYangVermaCandidateNull :
    Submodule ℂ (Verma leeYangCentralCharge (-1 / 5)) :=
  LeeYangConcreteDescent.modeClosure
    (vermaMode leeYangCentralCharge (-1 / 5)) leeYangVermaCandidateSeed

/-- Closing the two candidate singular vectors under all Virasoro modes produces a mode-stable subspace. This closure property alone does not show the quotient has the proposed gap-two basis. -/
theorem leeYangVermaCandidateNull_preserves :
    LeeYangIntertwinerDescent.ModeFamilyPreserves leeYangVermaCandidateNull
      (vermaMode leeYangCentralCharge (-1 / 5)) :=
  LeeYangConcreteDescent.modeClosure_preserves
    (vermaMode leeYangCentralCharge (-1 / 5)) leeYangVermaCandidateSeed

/-- The still-missing global normal-form theorem, stated on the newly available carrier.  It says
that modulo the mode closure of the level-two and level-three singular vectors, every ordered PBW
word reduces to a combination of the Rogers--Ramanujan gap-two words at the same level. -/
def HasLeeYangGapTwoNormalForm
    (P : Submodule ℂ (Verma leeYangCentralCharge (-1 / 5))) : Prop :=
  ∀ N : ℕ,
    (sortedSpan leeYangCentralCharge (-1 / 5) N).map P.mkQ =
      Submodule.span ℂ {x | ∃ w : List ℕ,
        IsLeeYangAdmissibleWord w ∧ energyHW w = N ∧
          P.mkQ (negWord leeYangCentralCharge (-1 / 5) w) = x}

/-- The finite-level admissible-word index used by the desired Lee--Yang quotient basis. -/
def LeeYangAdmissibleAtLevel (N : ℕ) : Type :=
  {w : List ℕ // IsLeeYangAdmissibleWord w ∧ energyHW w = N}

/-- An admissible PBW word in a quotient of the Lee--Yang Verma module. -/
noncomputable def leeYangQuotientWord
    (P : Submodule ℂ (Verma leeYangCentralCharge (-1 / 5))) (N : ℕ) :
    LeeYangAdmissibleAtLevel N →
      (Verma leeYangCentralCharge (-1 / 5) ⧸ P) :=
  fun w => P.mkQ (negWord leeYangCentralCharge (-1 / 5) w.1)

/-- The sharp Rogers--Ramanujan basis theorem still required after the present infrastructure:
gap-two words both span each PBW level modulo `P` and are linearly independent. -/
def HasLeeYangGapTwoBasis
    (P : Submodule ℂ (Verma leeYangCentralCharge (-1 / 5))) : Prop :=
  HasLeeYangGapTwoNormalForm P ∧
    ∀ N : ℕ, LinearIndependent ℂ (leeYangQuotientWord P N)

/-- The proposed gap-two basis property contains both spanning and independence. Extracting its spanning part gives the normal-form property, without asserting that either property has been proved for the candidate quotient. -/
theorem HasLeeYangGapTwoBasis.normalForm
    {P : Submodule ℂ (Verma leeYangCentralCharge (-1 / 5))}
    (hP : HasLeeYangGapTwoBasis P) : HasLeeYangGapTwoNormalForm P :=
  hP.1

/-- The exact remaining two-singular Lee--Yang theorem, with no unspecified containing
submodule: the mode closure of the displayed level-two and level-three vectors has the gap-two
Rogers--Ramanujan basis. -/
def LeeYangTwoSingularBasisTheorem : Prop :=
  HasLeeYangGapTwoBasis leeYangVermaCandidateNull

end
end VirasoroVerma
end InverseDS
end VOA
