import VOA.Examples.AffineSl2CentralCurrentRealization

/-!
# The central polynomial of the affine singular-word pairing

This finite calculation uses only the affine commutators and nonnegative-mode
annihilation of a vacuum vector. The center is an operator, not an assumed scalar.
The reduction certificates are generated by Notes/certificates/affine_singular_norm.py;
each step is checked by Lean's kernel using the displayed commutation laws.
-/
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.style.longLine false
namespace VOA.AffineVOA.SingularNorm
open Module (End)
variable {E : Type*} [AddCommGroup E] [Module ℂ E]
variable (A : AffineCentralCurrentData E)

/-- A colour-basis current in a representation with a commuting central operator. -/
noncomputable def J (a : Fin 3) (m : ℤ) : End ℂ E := A.loopMode m (basis a)

/-- Push one current past another, retaining the full central operator. -/
theorem push (a b : Fin 3) (m n : ℤ) (x : E) :
    J A a m (J A b n x) = J A b n (J A a m x) +
      (∑ c, fabc a b c • J A c (m+n) x) +
      if m+n=0 then ((m : ℂ) * kappa a b) • A.central x else 0 := by
  have h := LinearMap.congr_fun (A.loop_comm (basis a) (basis b) m n) x
  rw [basis_bracket_eq] at h
  simp only [map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply,
    kappaForm_basis, LieRing.of_associative_ring_bracket, LinearMap.sub_apply,
    Module.End.mul_apply, LinearMap.add_apply] at h
  split_ifs at h ⊢ <;> simp only [LinearMap.smul_apply, LinearMap.zero_apply] at h
  all_goals change J A a m (J A b n x) - J A b n (J A a m x) = _ at h
  all_goals rw [sub_eq_iff_eq_add] at h
  all_goals
    rw [h]
    dsimp only [J]
    abel

/-- A current can be moved through any power of the central operator. -/
theorem J_central_pow (a : Fin 3) (m : ℤ) (p : ℕ) (x : E) :
    J A a m ((A.central ^ p) x) = (A.central ^ p) (J A a m x) := by
  have h : Commute A.central (J A a m) :=
    sub_eq_zero.mp (A.central_comm (basis a) m)
  exact (LinearMap.congr_fun (h.pow_left p) x).symm

/-- Nested central powers multiply by adding their exponents. -/
theorem central_pow_apply (p q : ℕ) (x : E) :
    (A.central ^ p) ((A.central ^ q) x) = (A.central ^ (p+q)) x := by
  rw [pow_add, Module.End.mul_apply]

variable (v : E) (hv : ∀ (a : Fin 3) (n : ℤ), 0 ≤ n → J A a n v = 0)
include hv
/-- Move colour 1 at mode 0 through the creation word [(0, -3)]. This
finite reduction follows from the affine commutator and vacuum annihilation. -/
private theorem step000 :
    J A 1 (0) (J A 0 (-3) (v)) = (-1 : ℂ) • (J A 2 (-3) (v)) := by
  rw [push A 1 0 (0) (-3)]
  norm_num [Fin.sum_univ_three, fabc, kappa]
  all_goals try simp only [map_add, map_smul, map_zero, J_central_pow, central_pow_apply, pow_zero, Module.End.one_apply]
  all_goals try simp [hv]
  all_goals module

