import VOA.Examples.VirasoroVermaBSAAllLevels
import VOA.Examples.VirasoroVermaSingularEmbedding
import VOA.Examples.VirasoroFusionLabelRoots

/-!
# Actual singular states at the two Kac collision parameters

At t=1 and t=-1, successive BSA embeddings compose to give actual nonzero
singular states for all positive label pairs. Injectivity prevents the nested
states from disappearing. These are special-parameter constructions, not a
proof of generic Kac singular existence or vacuum simple-root multiplicity.
-/
namespace VOA.InverseDS.VirasoroVerma
open VirModule

/-- An ordinary actual singular-state existence statement: a nonzero vector
in the indicated PBW level is killed by the two positive generators. It has
no deformation, determinant or rigidity hypothesis hidden in its definition. -/
def HasNonzeroSingular (c h : ℂ) (n : ℕ) : Prop :=
  ∃ v : Verma c h, v≠0 ∧ v∈sortedSpan c h n ∧
    vermaMode c h 1 v=0 ∧ vermaMode c h 2 v=0

/-- Every actual highest vector supplies the level-zero starting point for
composing singular embeddings. This is not a positive-level degeneracy. -/
theorem hasNonzeroSingular_zero (c h : ℂ) : HasNonzeroSingular c h 0 := by
  refine ⟨highestVector c h, highestVector_ne_zero c h, ?_,
    verma_pos_annihilate c h 1 (by norm_num), verma_pos_annihilate c h 2 (by norm_num)⟩
  exact negWord_mem_sortedSpan_of_sorted c h sortedWord_nil rfl

/-- A nonzero singular state inside the Verma module generated by another
nonzero singular state remains nonzero in the original module. Actual modes
intertwine and the relative levels add; injectivity is proved, not assumed. -/
theorem hasNonzeroSingular_compose (c h : ℂ) (n m : ℕ)
    (hn : HasNonzeroSingular c h n)
    (hm : HasNonzeroSingular c (h+(n:ℂ)) m) : HasNonzeroSingular c h (n+m) := by
  obtain ⟨v,hv,hlev,h1,h2⟩ := hn
  obtain ⟨w,hw,wlev,w1,w2⟩ := hm
  let f := vermaSingularMap c h n v hlev h1 h2
  have hi : Function.Injective f := vermaSingularMap_injective c h n v hlev hv h1 h2
  refine ⟨f w, ?_, (vermaSingularMap_mem_level_iff c h n m v hlev hv h1 h2 w).mpr wlev, ?_, ?_⟩
  · intro hz
    exact hw (hi (hz.trans (map_zero f).symm))
  · have hh := vermaSingularMap_mode c h n v hlev h1 h2 1 w
    rw [w1,map_zero] at hh
    exact hh.symm
  · have hh := vermaSingularMap_mode c h n v hlev h1 h2 2 w
    rw [w2,map_zero] at hh
    exact hh.symm

/-- The actual BSA family supplies a nonzero singular state at every positive
axis label and every nonzero parameter, including both small boundary levels. -/
theorem hasNonzeroSingular_bsa (t : ℂ) (N : ℕ) (ht : t≠0) (hN : 0<N) :
    HasNonzeroSingular (vermaBSACharge t) (vermaBSAWeight N t) N := by
  obtain ⟨v,hv,hlev,hhigh⟩ := vermaBSA_nonzero_highest_all t N ht hN
  exact ⟨v,hv,hlev,hhigh.pos_annihilate 1 (by norm_num),
    hhigh.pos_annihilate 2 (by norm_num)⟩

/-- At charge one, the axis state of level d+1 embeds the module of weight
(d+2)^2/4 into the module of weight d^2/4. Repeating this k times gives the
actual nonzero level k(d+k), with no character or determinant formula. -/
theorem hasNonzeroSingular_charge_one_chain (d k : ℕ) :
    HasNonzeroSingular 1 ((d:ℂ)^2/4) (k*(d+k)) := by
  induction k generalizing d with
  | zero => simpa using hasNonzeroSingular_zero 1 ((d:ℂ)^2/4)
  | succ k ih =>
    have hs := hasNonzeroSingular_bsa 1 (d+1) (by norm_num) (by omega)
    have hc : vermaBSACharge 1=1 := by norm_num [vermaBSACharge]
    have hh : vermaBSAWeight (d+1) 1=(d:ℂ)^2/4 := by
      unfold vermaBSAWeight
      push_cast
      ring
    rw [hc,hh] at hs
    have hw : (d:ℂ)^2/4+((d+1:ℕ):ℂ)=((d+2:ℕ):ℂ)^2/4 := by push_cast; ring
    have he := hasNonzeroSingular_compose 1 ((d:ℂ)^2/4) (d+1) (k*((d+2)+k)) hs
      (by rw [hw]; exact ih (d+2))
    convert he using 1 <;> ring

/-- At charge twenty-five, the descending chain uses BSA levels
 d+2k-1, d+2k-3, ..., d+1. Their sum is k(d+k), and every map is injective.
Thus the full label-sized state is genuinely nonzero even at this collision. -/
theorem hasNonzeroSingular_charge_twentyFive_chain (d k : ℕ) :
    HasNonzeroSingular 25 (1-((d:ℂ)+2*(k:ℂ))^2/4) (k*(d+k)) := by
  induction k with
  | zero => simpa using hasNonzeroSingular_zero 25 (1-(d:ℂ)^2/4)
  | succ k ih =>
    have hs := hasNonzeroSingular_bsa (-1) (d+2*k+1) (by norm_num) (by omega)
    have hc : vermaBSACharge (-1)=25 := by norm_num [vermaBSACharge]
    have hh : vermaBSAWeight (d+2*k+1) (-1)=1-((d:ℂ)+2*((k+1:ℕ):ℂ))^2/4 := by
      unfold vermaBSAWeight
      push_cast
      ring
    rw [hc,hh] at hs
    have hw : (1-((d:ℂ)+2*((k+1:ℕ):ℂ))^2/4)+((d+2*k+1:ℕ):ℂ)=
        1-((d:ℂ)+2*(k:ℂ))^2/4 := by push_cast; ring
    have he := hasNonzeroSingular_compose 25
      (1-((d:ℂ)+2*((k+1:ℕ):ℂ))^2/4) (d+2*k+1) (k*(d+k)) hs
      (by rw [hw]; exact ih)
    convert he using 1 <;> ring

/-- Every pair of positive Kac labels has an actual nonzero level-rs
singular Verma state at t=1. This is an existence theorem at a fixed collision
parameter, not an assertion about a generic family or its normalization. -/
theorem kacSingular_at_one (r s : ℕ) :
    HasNonzeroSingular (vermaBSACharge 1) (fusionKacWeight r s 1) (r*s) := by
  have hc : vermaBSACharge 1=1 := by norm_num [vermaBSACharge]
  rw [hc]
  rcases le_total r s with h | h
  · obtain ⟨d,rfl⟩ := Nat.exists_eq_add_of_le h
    have he := hasNonzeroSingular_charge_one_chain d r
    convert he using 1 <;> norm_num [fusionKacWeight] <;> ring <;> simp
  · obtain ⟨d,rfl⟩ := Nat.exists_eq_add_of_le h
    have he := hasNonzeroSingular_charge_one_chain d s
    convert he using 1 <;> norm_num [fusionKacWeight] <;> ring <;> simp

/-- Every pair of positive Kac labels likewise has an actual nonzero
level-rs singular state at t=-1. The construction composes BSA embeddings;
it does not specialize a potentially vanishing generic formula. -/
theorem kacSingular_at_neg_one (r s : ℕ) :
    HasNonzeroSingular (vermaBSACharge (-1)) (fusionKacWeight r s (-1)) (r*s) := by
  have hc : vermaBSACharge (-1)=25 := by norm_num [vermaBSACharge]
  rw [hc]
  rcases le_total r s with h | h
  · obtain ⟨d,rfl⟩ := Nat.exists_eq_add_of_le h
    have he := hasNonzeroSingular_charge_twentyFive_chain d r
    convert he using 1 <;> norm_num [fusionKacWeight] <;> ring <;> simp
  · obtain ⟨d,rfl⟩ := Nat.exists_eq_add_of_le h
    have he := hasNonzeroSingular_charge_twentyFive_chain d s
    convert he using 1 <;> norm_num [fusionKacWeight] <;> ring <;> simp

/-- The full BSA axis gives actual determinant factors at every positive
singular level, including levels one and two. The exponent counts
all Verma descendants at the added level m. -/
theorem vermaWeightDeterminant_bsa_factor_all (t : ℂ) (N m : ℕ)
    [DecidableEq (VermaPartitions (N+m))] (ht : t≠0) (hN : 0<N) :
    (Polynomial.X-Polynomial.C (vermaBSAWeight N t))^
      Fintype.card (VermaPartitions m) ∣
      (vermaWeightGramPolynomial (vermaBSACharge t) (N+m)).det := by
  obtain ⟨v,hv,hlev,h1,h2⟩ := hasNonzeroSingular_bsa t N ht hN
  exact vermaWeightDeterminant_dvd_of_singular _ _ N m hN ⟨v,hlev⟩
    (fun hz => hv (congrArg Subtype.val hz)) h1 h2

/-- At either collision parameter every positive label pair supplies its
actual full Verma descendant determinant factor. Factors from colliding
weights cannot be multiplied using coprimality, so this is a lower bound
for each label separately, not the Kac determinant multiplicity formula. -/
theorem vermaWeightDeterminant_collision_factor (t : ℂ) (ht : t=1 ∨ t=-1)
    (r s m : ℕ) [DecidableEq (VermaPartitions (r*s+m))] (hr : 0<r) (hs : 0<s) :
    (Polynomial.X-Polynomial.C (fusionKacWeight r s t))^
      Fintype.card (VermaPartitions m) ∣
      (vermaWeightGramPolynomial (vermaBSACharge t) (r*s+m)).det := by
  have hx : HasNonzeroSingular (vermaBSACharge t) (fusionKacWeight r s t) (r*s) := by
    rcases ht with rfl | rfl
    · exact kacSingular_at_one r s
    · exact kacSingular_at_neg_one r s
  obtain ⟨v,hv,hlev,h1,h2⟩ := hx
  exact vermaWeightDeterminant_dvd_of_singular _ _ (r*s) m (Nat.mul_pos hr hs) ⟨v,hlev⟩
    (fun hz => hv (congrArg Subtype.val hz)) h1 h2

end VOA.InverseDS.VirasoroVerma
