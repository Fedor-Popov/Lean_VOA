namespace VOA.LatGen.WpC2

open scoped BigOperators TensorProduct
open Module (End)
open VOA VOA.IntegralLattice HeisenbergN
open VOA.LatGen VOA.LatGen.Triplet VOA.LatGen.Wp

/-! ## §1  The one lattice input: `(e^α)₍ₙ₎e^β = 0` for `n ≥ −⟨α,β⟩` -/

/-- **The lattice product formula, in the only form the proof needs.**  On a charged vacuum,
`Y(e^α,z)e^β = ε(α,β)·z^{⟨α,β⟩}·E⁻(−α,z)e^{α+β}`, so the `z`-expansion starts at `z^{⟨α,β⟩}`:
every mode `(e^α)₍ₙ₎` with `n ≥ −⟨α,β⟩` annihilates `e^β`.

This is Adamović–Milas eq. (2.4) — `Y(e^α,x₁)Y(e^α,x₂)` carries the factor `(x₁−x₂)^{2p}` — read
off directly from the definition of the lattice vertex operator.  Concretely: `Yeαvec_tmul` puts
the boson factor `EE(α)₍ₜ₋⟨α,β⟩₎` in front of the vacuum, and `EEVec_vacuum` says that factor
vanishes as soon as its index is negative. **No null vector, no character computation.** -/
theorem smul_latChargeGen_eq_zero (L : IntegralLattice) (α β : L.carrier) {n : ℤ}
    (hn : -L.form α β ≤ n) :
    mode (Yeαvec L α) n (latChargeGen L β) = 0 := by
  rw [mode_apply, latChargeGen, Yeαvec_tmul]
  have h : EEVec L α (-n - 1 - L.form α β) (vacuumN (rank L)) = 0 := by
    rw [EEVec_vacuum, if_neg (by omega)]
  rw [h, latStateGen, TensorProduct.zero_tmul, smul_zero]

/-- The vertex operator of a charged vacuum `e^β` in the deformed lattice VOA is the hand-built
`Yeαvec` (the deformation changes `ω`, never `Y`). -/
theorem Y_latChargeGen (p : ℕ) (hp : 1 ≤ p) (β : (latP p).carrier) :
    (tripletLatticeVOA p hp).Y (latChargeGen (latP p) β) = Yeαvec (latP p) β := by
  have hw := YfullGen_word (latP p) (latP_even p) (latP_posDef p hp) [] β
  rw [wordStateLatGen_nil, YwordLatGen_nil] at hw
  rw [tripletLatticeVOA_Y]
  exact hw

/-- **`F₍ₙ₎F = 0` for every `n ≥ −2p`** (Adamović–Milas (2.2), the `F` half; Adamović,
J. Algebra **270** (2003), Lemma 3.1).  Here `F = e^{−α}` and `⟨−α,−α⟩ = 2p`. -/
theorem smul_Ftrip_Ftrip (p : ℕ) (hp : 1 ≤ p) {n : ℤ} (hn : -(2 * (p : ℤ)) ≤ n) :
    (tripletLatticeVOA p hp).smul (Ftrip p) n (Ftrip p) = 0 := by
  have hF : Ftrip p = latChargeGen (latP p) (-alphaP p) := rfl
  have hform : (latP p).form (-alphaP p) (-alphaP p) = 2 * (p : ℤ) := by
    rw [Screen.form_neg_self, latP_form_alpha]
  rw [PreVertexAlgebra.smul_def, hF, Y_latChargeGen]
  exact smul_latChargeGen_eq_zero (latP p) (-alphaP p) (-alphaP p) (by rw [hform]; omega)

/-! ## §2  The long screening operator `Q = (e^α)₍₀₎` as a derivation -/

/-- Cancelling a non-zero scalar in a `ℂ`-module. -/
theorem eq_zero_of_smul_eq_zero {M : Type*} [AddCommGroup M] [Module ℂ M] {c : ℂ} (hc : c ≠ 0)
    {x : M} (h : c • x = 0) : x = 0 := by
  have h2 := congrArg (fun y : M => c⁻¹ • y) h
  simpa [smul_smul, inv_mul_cancel₀ hc] using h2

/-- **The long screening operator** `Q = (e^α)₍₀₎`, presented as the *generic* screening
operator `Core.ScreeningKernel.Screening.screening` of the deformed lattice VOA.  Presenting it
this way — rather than as the hand-built `Screen.Qscr` — is what makes `screening_leibniz`
applicable: `Q` is a derivation of **every** product `u₍ₙ₎v`. -/
noncomputable def Qwp (p : ℕ) (hp : 1 ≤ p) : End ℂ (LatModuleGen (latP p)) :=
  Screening.screening (tripletLatticeVOA p hp) (latChargeGen (latP p) (alphaP p))

/-- `Q` is the hand-built `Screen.Qscr` of `Examples.TripletScreening`. -/
theorem Qwp_eq_Qscr (p : ℕ) (hp : 1 ≤ p) : Qwp p hp = Screen.Qscr (latP p) (alphaP p) :=
  Screening.screening_eq_mode_of_Y_eq _ _ _ (Y_latChargeGen p hp (alphaP p))

/-- `Q F = H`. -/
theorem Qwp_Ftrip (p : ℕ) (hp : 1 ≤ p) : Qwp p hp (Ftrip p) = Htrip p := by
  rw [Qwp_eq_Qscr]; rfl

/-- `Q H = E`. -/
theorem Qwp_Htrip (p : ℕ) (hp : 1 ≤ p) : Qwp p hp (Htrip p) = Etrip p := by
  rw [Qwp_eq_Qscr]; rfl

/-- **`Q E = 0`**, i.e. `Q³F = 0` (`Screen.Qscr_Escr`): the charge-`2α` sector carries no state
of deformed weight `2p−1`. -/
theorem Qwp_Etrip (p : ℕ) (hp : 1 ≤ p) : Qwp p hp (Etrip p) = 0 := by
  rw [Qwp_eq_Qscr]
  exact Screen.Qscr_Escr (latP p) (alphaP p) p hp (latP_form_alpha p)

/-- **`Q` is a derivation of every vertex product** (`Screening.screening_leibniz`, the `ℓ = 0`
slice of the Borcherds commutator formula).  This is the *only* property of `Q` that §3 uses. -/
theorem Qwp_leibniz (p : ℕ) (hp : 1 ≤ p) (u : LatModuleGen (latP p)) (n : ℤ)
    (v : LatModuleGen (latP p)) :
    Qwp p hp ((tripletLatticeVOA p hp).smul u n v)
      = (tripletLatticeVOA p hp).smul (Qwp p hp u) n v
        + (tripletLatticeVOA p hp).smul u n (Qwp p hp v) :=
  Screening.screening_leibniz _ _ u n v

/-! ## §3  The screening relations (Adamović–Milas (2.2), and the `Q²` relation of Theorem 3.1)

Everything here is `Q` applied repeatedly to the single lattice identity `F₍ₙ₎F = 0`, using only
that `Q` is a derivation and that `Q³F = 0`.  No singular vector is computed anywhere. -/

/-- `Q(F₍ₙ₎F) = 0`: **`H₍ₙ₎F + F₍ₙ₎H = 0`** for `n ≥ −2p`. -/
theorem HF_add_FH (p : ℕ) (hp : 1 ≤ p) {n : ℤ} (hn : -(2 * (p : ℤ)) ≤ n) :
    (tripletLatticeVOA p hp).smul (Htrip p) n (Ftrip p)
      + (tripletLatticeVOA p hp).smul (Ftrip p) n (Htrip p) = 0 := by
  have h := congrArg (Qwp p hp) (smul_Ftrip_Ftrip p hp hn)
  rwa [map_zero, Qwp_leibniz, Qwp_Ftrip] at h

/-- `Q²(F₍ₙ₎F) = 0`, in the raw shape the Leibniz rule produces:
`E₍ₙ₎F + H₍ₙ₎H + (H₍ₙ₎H + F₍ₙ₎E) = 0`. -/
theorem EF_add_HH_add_HH_add_FE (p : ℕ) (hp : 1 ≤ p) {n : ℤ} (hn : -(2 * (p : ℤ)) ≤ n) :
    (tripletLatticeVOA p hp).smul (Etrip p) n (Ftrip p)
        + (tripletLatticeVOA p hp).smul (Htrip p) n (Htrip p)
      + ((tripletLatticeVOA p hp).smul (Htrip p) n (Htrip p)
        + (tripletLatticeVOA p hp).smul (Ftrip p) n (Etrip p)) = 0 := by
  have h := congrArg (Qwp p hp) (HF_add_FH p hp hn)
  rwa [map_zero, map_add, Qwp_leibniz, Qwp_leibniz, Qwp_Ftrip, Qwp_Htrip] at h

/-- `Q²(F₍ₙ₎F) = 0`: **`E₍ₙ₎F + F₍ₙ₎E + 2·H₍ₙ₎H = 0`** for `n ≥ −2p`.  This is the displayed
relation in the proof of Adamović–Milas Theorem 3.1 (there at `n = −1`). -/
theorem EF_add_FE_add_two_HH (p : ℕ) (hp : 1 ≤ p) {n : ℤ} (hn : -(2 * (p : ℤ)) ≤ n) :
    (tripletLatticeVOA p hp).smul (Etrip p) n (Ftrip p)
      + (tripletLatticeVOA p hp).smul (Ftrip p) n (Etrip p)
      + (2 : ℂ) • (tripletLatticeVOA p hp).smul (Htrip p) n (Htrip p) = 0 := by
  have h := EF_add_HH_add_HH_add_FE p hp hn
  have key : (tripletLatticeVOA p hp).smul (Etrip p) n (Ftrip p)
        + (tripletLatticeVOA p hp).smul (Ftrip p) n (Etrip p)
        + (2 : ℂ) • (tripletLatticeVOA p hp).smul (Htrip p) n (Htrip p)
      = ((tripletLatticeVOA p hp).smul (Etrip p) n (Ftrip p)
          + (tripletLatticeVOA p hp).smul (Htrip p) n (Htrip p))
        + ((tripletLatticeVOA p hp).smul (Htrip p) n (Htrip p)
          + (tripletLatticeVOA p hp).smul (Ftrip p) n (Etrip p)) := by
    rw [two_smul]; abel
  rw [key, h]

/-- `Q³(F₍ₙ₎F) = 0`: **`E₍ₙ₎H + H₍ₙ₎E = 0`** for `n ≥ −2p` (i.e. `Q(H₍ₙ₎H) = 0`, the third
clause of Adamović–Milas (2.2)). -/
theorem EH_add_HE (p : ℕ) (hp : 1 ≤ p) {n : ℤ} (hn : -(2 * (p : ℤ)) ≤ n) :
    (tripletLatticeVOA p hp).smul (Etrip p) n (Htrip p)
      + (tripletLatticeVOA p hp).smul (Htrip p) n (Etrip p) = 0 := by
  have h := congrArg (Qwp p hp) (EF_add_FE_add_two_HH p hp hn)
  rw [map_zero, map_add, map_add, map_smul, Qwp_leibniz, Qwp_leibniz, Qwp_leibniz,
    Qwp_Ftrip, Qwp_Htrip, Qwp_Etrip, PreVertexAlgebra.smul_zero_left,
    PreVertexAlgebra.smul_zero_right] at h
  refine eq_zero_of_smul_eq_zero (c := (3 : ℂ)) (by norm_num) ?_
  rw [← h]
  rw [two_smul, show (3 : ℂ) = 1 + 1 + 1 from by norm_num, add_smul, add_smul, one_smul]
  abel

/-- `Q⁴(F₍ₙ₎F) = 0`: **`E₍ₙ₎E = 0`** for `n ≥ −2p` (the `E` half of Adamović–Milas (2.2)). -/
theorem smul_Etrip_Etrip (p : ℕ) (hp : 1 ≤ p) {n : ℤ} (hn : -(2 * (p : ℤ)) ≤ n) :
    (tripletLatticeVOA p hp).smul (Etrip p) n (Etrip p) = 0 := by
  have h := congrArg (Qwp p hp) (EH_add_HE p hp hn)
  rw [map_zero, map_add, Qwp_leibniz, Qwp_leibniz, Qwp_Htrip, Qwp_Etrip,
    PreVertexAlgebra.smul_zero_left, PreVertexAlgebra.smul_zero_right] at h
  refine eq_zero_of_smul_eq_zero (c := (2 : ℂ)) (by norm_num) ?_
  rw [two_smul, ← h]
  abel

/-! ## §4  The four generators as states of `W(p)`, and transport of the relations

`tripletW p hp` is a `VOASubalgebra` of `V_{L_p}`, so its vertex operators are the ambient ones
restricted (`tripletWVOA_Y_coe`).  Hence every product computed above in `V_{L_p}` *is* the
product computed in `W(p)`, and the relations transport by injectivity of the inclusion. -/

/-- Products in `W(p)` are the ambient products. -/
theorem smul_coe (p : ℕ) (hp : 1 ≤ p) (u v : (tripletW p hp).carrier) (n : ℤ) :
    (((tripletWVOA p hp).smul u n v : (tripletW p hp).carrier) : LatModuleGen (latP p))
      = (tripletLatticeVOA p hp).smul (u : LatModuleGen (latP p))
          (n) (v : LatModuleGen (latP p)) := by
  rw [PreVertexAlgebra.smul_def, PreVertexAlgebra.smul_def, mode_apply, mode_apply]
  exact tripletWVOA_Y_coe p hp u (-n - 1) v

/-- `ω_λ` as a state of `W(p)`. -/
noncomputable def genOmega (p : ℕ) (hp : 1 ≤ p) : (tripletW p hp).carrier :=
  ⟨omegaTrip p, omegaTrip_mem_tripletW p hp⟩

/-- `E = Q²e^{−α}` as a state of `W(p)`. -/
noncomputable def genE (p : ℕ) (hp : 1 ≤ p) : (tripletW p hp).carrier :=
  ⟨Etrip p, Etrip_mem_tripletW p hp⟩

/-- `H = Qe^{−α}` as a state of `W(p)`. -/
noncomputable def genH (p : ℕ) (hp : 1 ≤ p) : (tripletW p hp).carrier :=
  ⟨Htrip p, Htrip_mem_tripletW p hp⟩

/-- `F = e^{−α}` as a state of `W(p)`. -/
noncomputable def genF (p : ℕ) (hp : 1 ≤ p) : (tripletW p hp).carrier :=
  ⟨Ftrip p, Ftrip_mem_tripletW p hp⟩

@[simp] theorem genOmega_coe (p : ℕ) (hp : 1 ≤ p) :
    ((genOmega p hp : (tripletW p hp).carrier) : LatModuleGen (latP p)) = omegaTrip p := rfl

@[simp] theorem genE_coe (p : ℕ) (hp : 1 ≤ p) :
    ((genE p hp : (tripletW p hp).carrier) : LatModuleGen (latP p)) = Etrip p := rfl

@[simp] theorem genH_coe (p : ℕ) (hp : 1 ≤ p) :
    ((genH p hp : (tripletW p hp).carrier) : LatModuleGen (latP p)) = Htrip p := rfl

@[simp] theorem genF_coe (p : ℕ) (hp : 1 ≤ p) :
    ((genF p hp : (tripletW p hp).carrier) : LatModuleGen (latP p)) = Ftrip p := rfl

/-- **The four strong generators of `W(p)`**, indexed by `Fin 4` in the order `ω, E, H, F`. -/
noncomputable def genWp (p : ℕ) (hp : 1 ≤ p) : Fin 4 → (tripletW p hp).carrier
  | 0 => genOmega p hp
  | 1 => genE p hp
  | 2 => genH p hp
  | 3 => genF p hp

@[simp] theorem genWp_zero (p : ℕ) (hp : 1 ≤ p) : genWp p hp 0 = genOmega p hp := rfl
@[simp] theorem genWp_one (p : ℕ) (hp : 1 ≤ p) : genWp p hp 1 = genE p hp := rfl
@[simp] theorem genWp_two (p : ℕ) (hp : 1 ≤ p) : genWp p hp 2 = genH p hp := rfl
@[simp] theorem genWp_three (p : ℕ) (hp : 1 ≤ p) : genWp p hp 3 = genF p hp := rfl

/-- The generating family sits over `tripGens p = {ω_λ, E, H, F}`: the strong-generation
hypothesis below is literally Adamović–Milas Proposition 2.3(ii). -/
theorem val_range_genWp (p : ℕ) (hp : 1 ≤ p) :
    (Subtype.val '' (Set.range (genWp p hp)) : Set (LatModuleGen (latP p))) = tripGens p := by
  ext x
  constructor
  · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
    fin_cases i
    · exact omegaTrip_mem_tripGens p
    · exact Etrip_mem_tripGens p
    · exact Htrip_mem_tripGens p
    · exact Ftrip_mem_tripGens p
  · intro hx
    rcases hx with rfl | hx
    · exact ⟨genOmega p hp, ⟨0, rfl⟩, rfl⟩
    rcases hx with rfl | hx
    · exact ⟨genE p hp, ⟨1, rfl⟩, rfl⟩
    rcases hx with rfl | hx
    · exact ⟨genH p hp, ⟨2, rfl⟩, rfl⟩
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨genF p hp, ⟨3, rfl⟩, rfl⟩

/-! ### The relations, inside `W(p)` -/

/-- `F₍₋₁₎F = 0` inside `W(p)`. -/
theorem smul_genF_genF (p : ℕ) (hp : 1 ≤ p) :
    (tripletWVOA p hp).smul (genF p hp) (-1) (genF p hp) = 0 := by
  apply Subtype.ext
  rw [smul_coe, genF_coe]
  exact smul_Ftrip_Ftrip p hp (by exact_mod_cast by omega : -(2 * (p : ℤ)) ≤ (-1 : ℤ))

/-- `E₍₋₁₎E = 0` inside `W(p)`. -/
theorem smul_genE_genE (p : ℕ) (hp : 1 ≤ p) :
    (tripletWVOA p hp).smul (genE p hp) (-1) (genE p hp) = 0 := by
  apply Subtype.ext
  rw [smul_coe, genE_coe]
  exact smul_Etrip_Etrip p hp (by exact_mod_cast by omega : -(2 * (p : ℤ)) ≤ (-1 : ℤ))

/-- `E₍₋₁₎F + H₍₋₁₎H + (H₍₋₁₎H + F₍₋₁₎E) = 0` inside `W(p)`. -/
theorem EF_HH_HH_FE_genW (p : ℕ) (hp : 1 ≤ p) :
    (tripletWVOA p hp).smul (genE p hp) (-1) (genF p hp)
        + (tripletWVOA p hp).smul (genH p hp) (-1) (genH p hp)
      + ((tripletWVOA p hp).smul (genH p hp) (-1) (genH p hp)
        + (tripletWVOA p hp).smul (genF p hp) (-1) (genE p hp)) = 0 := by
  apply Subtype.ext
  push_cast [Submodule.coe_add, smul_coe, genE_coe, genF_coe, genH_coe]
  exact EF_add_HH_add_HH_add_FE p hp (by exact_mod_cast by omega : -(2 * (p : ℤ)) ≤ (-1 : ℤ))

/-! ## §5  The relations in the Poisson algebra `A₂(W(p)) = W(p)/C₂(W(p))`

`Modules.PoissonDescent` makes `A₂(W(p))` a commutative ring with `[u]·[v] = [u₍₋₁₎v]`, and
`Modules.PoissonQuotient.A₂Algebra` makes it a `ℂ`-algebra.  The three relations of
Adamović–Milas Theorem 3.1 follow by applying the (linear) projection `mk₂` to §4. -/

/-- **`F̄² = 0`**. -/
theorem mk₂_genF_sq (p : ℕ) (hp : 1 ≤ p) :
    (mk₂ (tripletWVOA p hp) (genF p hp)) ^ 2 = 0 := by
  rw [pow_two, ← TripletNilp.mk₂_smul_neg_one, smul_genF_genF, map_zero]

/-- **`Ē² = 0`**. -/
theorem mk₂_genE_sq (p : ℕ) (hp : 1 ≤ p) :
    (mk₂ (tripletWVOA p hp) (genE p hp)) ^ 2 = 0 := by
  rw [pow_two, ← TripletNilp.mk₂_smul_neg_one, smul_genE_genE, map_zero]

/-- **`H̄² = −Ē·F̄`** — the `Q²`-relation, pushed to `A₂` and symmetrised by commutativity. -/
theorem mk₂_genH_sq (p : ℕ) (hp : 1 ≤ p) :
    (mk₂ (tripletWVOA p hp) (genH p hp)) ^ 2
      = -(mk₂ (tripletWVOA p hp) (genE p hp) * mk₂ (tripletWVOA p hp) (genF p hp)) := by
  have h := congrArg (mk₂ (tripletWVOA p hp)) (EF_HH_HH_FE_genW p hp)
  rw [map_zero, map_add, map_add, map_add] at h
  simp only [TripletNilp.mk₂_smul_neg_one] at h
  set Ec := mk₂ (tripletWVOA p hp) (genE p hp) with hEc
  set Fc := mk₂ (tripletWVOA p hp) (genF p hp) with hFc
  set Hc := mk₂ (tripletWVOA p hp) (genH p hp) with hHc
  rw [mul_comm Fc Ec] at h
  have h2 : (Ec * Fc + Hc * Hc) + (Ec * Fc + Hc * Hc) = 0 := by rw [← h]; ring
  have h3 : Ec * Fc + Hc * Hc = 0 :=
    eq_zero_of_smul_eq_zero (c := (2 : ℂ)) (by norm_num) (by rw [two_smul]; exact h2)
  rw [pow_two]
  linear_combination h3

/-- **`H̄⁴ = 0`**: `H̄⁴ = (Ē F̄)² = Ē² F̄² = 0`. -/
theorem mk₂_genH_pow_four (p : ℕ) (hp : 1 ≤ p) :
    (mk₂ (tripletWVOA p hp) (genH p hp)) ^ 4 = 0 := by
  have hsq := mk₂_genH_sq p hp
  have hE := mk₂_genE_sq p hp
  have key : (mk₂ (tripletWVOA p hp) (genH p hp)) ^ 4
      = ((mk₂ (tripletWVOA p hp) (genH p hp)) ^ 2) ^ 2 := by ring
  rw [key, hsq]
  have : (-(mk₂ (tripletWVOA p hp) (genE p hp) * mk₂ (tripletWVOA p hp) (genF p hp))) ^ 2
      = (mk₂ (tripletWVOA p hp) (genE p hp)) ^ 2
        * (mk₂ (tripletWVOA p hp) (genF p hp)) ^ 2 := by ring
  rw [this, hE, zero_mul]

/-! ## §6  The two carried hypotheses, and the theorem -/

/-- **(AM-1) Strong generation** — Adamović–Milas Proposition 2.3(ii): `W(p)` is spanned by the
iterated products `g^{i₁}₍₋m₁₎⋯g^{iₖ}₍₋mₖ₎|0⟩` of `{ω_λ, E, H, F}` with all `mⱼ ≥ 1`.

This is *not* the definition of `tripletW p hp`, which is the smallest vertex **sub**algebra
containing those four states — closure under *all* products `u₍ₙ₎v`, `n ∈ ℤ`, of *arbitrary*
elements.  Generation in that sense does not imply strong generation, so the hypothesis is real.
Adamović–Milas prove it by induction on the charge, using the Feigin–Fuchs structure theory of
`V_L` as a Virasoro module. -/
def StrongGenWp (p : ℕ) (hp : 1 ≤ p) : Prop :=
  iterProdSpan (tripletWVOA p hp) (Set.range (genWp p hp)) = ⊤

/-- **(AM-1′) Algebra generation of `A₂(W(p))`** — the *strictly weaker* hypothesis the proof
actually consumes: the commutative `ℂ`-algebra `A₂(W(p)) = W(p)/C₂(W(p))` is generated by the
four classes `ω̄, Ē, H̄, F̄`.

This is Adamović–Milas Theorem 3.1 **step 1** (equivalently Abe, *Math. Z.* **255** (2007),
Prop. 2.2), and — unlike `StrongGenWp` — it is a statement about the **quotient only**, not about
`W(p)`.  Strong generation implies it (`adjoinGenWp_of_strongGenWp`) and the converse fails in
general, so replacing `StrongGenWp` by `AdjoinGenWp` throughout is a genuine weakening of every
theorem below, at no cost: the engine
`TripletNilp.c2Cofinite_of_adjoin_of_isNilpotent` never touches `W(p)` itself. -/
def AdjoinGenWp (p : ℕ) (hp : 1 ≤ p) : Prop :=
  Algebra.adjoin ℂ (Set.range (fun i => mk₂ (tripletWVOA p hp) (genWp p hp i))) = ⊤

/-- **Strong generation ⟹ algebra generation of the quotient.**  One way only. -/
theorem adjoinGenWp_of_strongGenWp (p : ℕ) (hp : 1 ≤ p) (h : StrongGenWp p hp) :
    AdjoinGenWp p hp :=
  TripletNilp.adjoin_range_mk₂_of_iterProdSpan (tripletWVOA p hp) (genWp p hp) h

/-- **(AM-5) Nilpotency of `ω̄`** — the one step of Adamović–Milas Theorem 3.1 that their printed
argument does **not** establish (see the module docstring).  Carried here as an explicit named
hypothesis, exponent-free so that no guessed exponent can make anything vacuous. -/
def OmegaNilpotentWp (p : ℕ) (hp : 1 ≤ p) : Prop :=
  IsNilpotent (mk₂ (tripletWVOA p hp) (genOmega p hp))

/-- **`C₂`-cofiniteness of the triplet `W(p)`, at general `p`**, from
(AM-1′) algebra generation of `A₂(W(p))` and (AM-5) nilpotency of `ω̄`.

Everything between the two — `Ē² = F̄² = 0`, `H̄² = −ĒF̄`, `H̄⁴ = 0` — is proved here, from the
lattice product formula and the derivation property of the long screening `Q` alone. -/
theorem c2Cofinite_tripletWVOA (p : ℕ) (hp : 1 ≤ p) (hgen : AdjoinGenWp p hp)
    (homega : OmegaNilpotentWp p hp) : C2Cofinite (tripletWVOA p hp) := by
  refine TripletNilp.c2Cofinite_of_adjoin_of_isNilpotent _ (genWp p hp) hgen ?_
  intro i
  fin_cases i
  · exact homega
  · exact ⟨2, mk₂_genE_sq p hp⟩
  · exact ⟨4, mk₂_genH_pow_four p hp⟩
  · exact ⟨2, mk₂_genF_sq p hp⟩

/-- The `StrongGenWp` form of `c2Cofinite_tripletWVOA`, kept for continuity. -/
theorem c2Cofinite_tripletWVOA_of_strongGen (p : ℕ) (hp : 1 ≤ p) (hgen : StrongGenWp p hp)
    (homega : OmegaNilpotentWp p hp) : C2Cofinite (tripletWVOA p hp) :=
  c2Cofinite_tripletWVOA p hp (adjoinGenWp_of_strongGenWp p hp hgen) homega

/-- The nilpotency exponents of the four generators: `m` for `ω̄`, then `2, 4, 2`. -/
def expWp (m : ℕ) : Fin 4 → ℕ
  | 0 => m
  | 1 => 2
  | 2 => 4
  | 3 => 2

theorem prod_expWp (m : ℕ) : ∏ i : Fin 4, expWp m i = 16 * m := by
  rw [Fin.prod_univ_four]
  change m * 2 * 4 * 2 = 16 * m
  ring

/-- **The dimension bound.**  With an explicit exponent `ω̄ ^ m = 0`,
`dim_ℂ W(p)/C₂(W(p)) ≤ 16·m`.  Adamović–Milas Corollary 4.6 gives `m = 3p − 1`, hence
`dim ≤ 48p − 16`; their Theorem 3.1 as printed would give only `m = 4p − 2`. -/
theorem finrank_a₂_tripletWVOA_le (p : ℕ) (hp : 1 ≤ p) (m : ℕ) (hgen : AdjoinGenWp p hp)
    (homega : (mk₂ (tripletWVOA p hp) (genOmega p hp)) ^ m = 0) :
    Module.finrank ℂ (A₂ (tripletWVOA p hp)) ≤ 16 * m := by
  have h := TripletNilp.finrank_a₂_le_of_adjoin (tripletWVOA p hp) (genWp p hp)
    (expWp m) hgen ?_
  · rwa [prod_expWp] at h
  · intro i
    fin_cases i
    · exact homega
    · exact mk₂_genE_sq p hp
    · exact mk₂_genH_pow_four p hp
    · exact mk₂_genF_sq p hp

/-- The `p = 2` instance of `c2Cofinite_tripletWVOA`.

⚠ This is `W(2)` **as built in `Examples.TripletWp`**, i.e. inside the deformed lattice VOA
`V_{L_2}`.  No isomorphism with the symplectic-fermion `SympFerm.tripletW2` is proved or claimed
anywhere in this repository — only the numerical agreement of central charges
(`Wp.tripletW_centralCharge_eq_tripletW2`). -/
theorem c2Cofinite_tripletWVOA_two (hp : 1 ≤ 2) (hgen : AdjoinGenWp 2 hp)
    (homega : OmegaNilpotentWp 2 hp) : C2Cofinite (tripletWVOA 2 hp) :=
  c2Cofinite_tripletWVOA 2 hp hgen homega

/-! ## §7  The residual, as a concrete vector membership

`OmegaNilpotentWp` is an abstract nilpotency statement in a quotient.  This section turns it into
an explicit membership of a named vector in `C₂(W(p))`, so that what remains to be proved is a
sentence about `L₋₂` acting on the vacuum and not about a quotient ring — the shape in which
Adamović–Milas Corollary 4.6 delivers it. -/

/-- `genOmega` is the conformal vector of `W(p)`. -/
theorem genOmega_eq_conformalVector (p : ℕ) (hp : 1 ≤ p) :
    genOmega p hp = (tripletWVOA p hp).conformalVector := Subtype.ext rfl

/-- The Poisson powers of `ω` are the iterated `L₋₂`: `ω̄ ^ (m+1)` is represented by
`L₋₂(L₋₂ ⋯ L₋₂ 𝟙)`. -/
theorem pMulPow_genOmega_succ (p : ℕ) (hp : 1 ≤ p) (m : ℕ) :
    TripletNilp.pMulPow (tripletWVOA p hp) (genOmega p hp) (m + 1)
      = (tripletWVOA p hp).L (-2)
          (TripletNilp.pMulPow (tripletWVOA p hp) (genOmega p hp) m) := by
  rw [TripletNilp.pMulPow_succ, genOmega_eq_conformalVector,
    TripletNilp.smul_conformal_neg_one]

/-- **The residual, concretely.**  `ω̄ ^ m = 0` in `A₂(W(p))` **is** the membership
`L₋₂^m|0⟩ ∈ C₂(W(p))`. -/
theorem mk₂_genOmega_pow_eq_zero_iff (p : ℕ) (hp : 1 ≤ p) (m : ℕ) :
    (mk₂ (tripletWVOA p hp) (genOmega p hp)) ^ m = 0
      ↔ TripletNilp.pMulPow (tripletWVOA p hp) (genOmega p hp) m ∈ O₂ (tripletWVOA p hp) :=
  TripletNilp.pow_mk₂_eq_zero_iff _ _ _

/-- The explicit-exponent form of `OmegaNilpotentWp`: `L₋₂^m|0⟩ ∈ C₂(W(p))`.  Adamović–Milas
Corollary 4.4 is this statement at `m = 3p − 1`. -/
def OmegaPowMem (p : ℕ) (hp : 1 ≤ p) (m : ℕ) : Prop :=
  TripletNilp.pMulPow (tripletWVOA p hp) (genOmega p hp) m ∈ O₂ (tripletWVOA p hp)

theorem omegaNilpotentWp_of_omegaPowMem (p : ℕ) (hp : 1 ≤ p) {m : ℕ}
    (h : OmegaPowMem p hp m) : OmegaNilpotentWp p hp :=
  TripletNilp.isNilpotent_mk₂_of_pMulPow_mem _ _ h

/-- **`C₂`-cofiniteness of `W(p)` with the residual in its most concrete form**, together
with the dimension bound.  At `m = 3p − 1` (Adamović–Milas Corollary 4.6) this reads
`dim_ℂ W(p)/C₂(W(p)) ≤ 48p − 16`. -/
theorem c2Cofinite_tripletWVOA_of_omegaPowMem (p : ℕ) (hp : 1 ≤ p) (m : ℕ)
    (hgen : AdjoinGenWp p hp) (homega : OmegaPowMem p hp m) :
    C2Cofinite (tripletWVOA p hp)
      ∧ Module.finrank ℂ (A₂ (tripletWVOA p hp)) ≤ 16 * m :=
  ⟨c2Cofinite_tripletWVOA p hp hgen (omegaNilpotentWp_of_omegaPowMem p hp homega),
    finrank_a₂_tripletWVOA_le p hp m hgen ((mk₂_genOmega_pow_eq_zero_iff p hp m).2 homega)⟩

end VOA.LatGen.WpC2
