import VOA.Examples.AffineSl2PrimitiveEnergy

/-! # Actual horizontal strings inside the universal affine module

The finite spin representation generated by each actual highest vector is
constructed from lowering zero modes. Its independence and exact termination
use the genuine current brackets and the Chevalley involution.
-/
namespace VOA.AffineSl2GeneralRigidity
noncomputable section
open AffineVOA AffineVOA.SugawaraCov AffineVOA.HighestModule
open Module (End)

/-- Chevalley conjugates horizontal lowering powers to signed raising powers. -/
theorem vacuumChevalley_lowering_pow (k : ℂ) (v : WakModule k) (r : ℕ) :
    vacuumChevalley k ((J k 1 0 ^ r) v) =
      (-1:ℂ)^r • (J k 0 0 ^ r) (vacuumChevalley k v) := by
  induction r with
  | zero => simp
  | succ r ih =>
      rw [pow_succ', Module.End.mul_apply, vacuumChevalley_current, ih]
      change -J k 0 0 ((-1:ℂ)^r • (J k 0 0 ^ r) (vacuumChevalley k v)) = _
      rw [map_smul, pow_succ' (J k 0 0), Module.End.mul_apply, pow_succ, mul_smul]
      module

/-- Lowering, like raising, is locally nilpotent on the actual universal module. -/
theorem horizontalLoweringLocallyNilpotent_universal (k : ℂ) (hk : k+2 ≠ 0) :
    AffineLie.LocallyNilpotentEnd (J k 1 0) := by
  intro v
  obtain ⟨r, hr⟩ := AffineSl2BoundaryMaximalIdeal.horizontalRaisingLocallyNilpotent_universal
    k (vacuumChevalley k v)
  refine ⟨r, (vacuumChevalley_involutive k hk).injective ?_⟩
  rw [vacuumChevalley_lowering_pow, show (J k 0 0 ^ r) (vacuumChevalley k v)=0 from hr,
    smul_zero, map_zero]

/-- A nonzero highest vector of nonzero charge witnesses the actual horizontal triple. -/
theorem horizontalTriple_of_charge (k h : ℂ) (v : WakModule k)
    (hv : v ≠ 0) (hh : J k 2 0 v = h • v) (hh0 : h ≠ 0) :
    IsSl2Triple (J k 2 0) (J k 0 0) (J k 1 0) where
  h_ne_zero := by
    intro hz
    have : h • v = 0 := by rw [← hh, hz, LinearMap.zero_apply]
    exact (smul_ne_zero hh0 hv) this
  lie_e_f := by
    have h := J_bracket k 0 1 0 0
    norm_num [Fin.sum_univ_succ, fabc] at h
    exact h
  lie_h_e_nsmul := by
    have h := J_bracket k 2 0 0 0
    norm_num [Fin.sum_univ_succ, fabc] at h
    simpa only [two_smul] using h
  lie_h_f_nsmul := by
    have h := J_bracket k 2 1 0 0
    norm_num [Fin.sum_univ_succ, fabc] at h
    rw [Ring.lie_def, h]
    module

/-- Every lowering vector through the highest natural charge is nonzero. -/
theorem lowering_pow_ne_zero (k : ℂ) (d : ℕ) (hd : 0 < d) (v : WakModule k)
    (hv : v ≠ 0) (he : J k 0 0 v = 0) (hh : J k 2 0 v = (d:ℂ) • v)
    (i : ℕ) (hi : i ≤ d) : (J k 1 0 ^ i) v ≠ 0 := by
  have ht := horizontalTriple_of_charge k d v hv hh (by exact_mod_cast Nat.ne_of_gt hd)
  have hp : ht.HasPrimitiveVectorWith v (d:ℂ) := ⟨hv, hh, he⟩
  exact hp.pow_toEnd_f_ne_zero_of_eq_nat rfl hi

/-- The actual lowering string has its standard horizontal weights. -/
theorem lowering_pow_charge (k : ℂ) (d : ℕ) (hd : 0 < d) (v : WakModule k)
    (hv : v ≠ 0) (he : J k 0 0 v = 0) (hh : J k 2 0 v = (d:ℂ) • v)
    (i : ℕ) : J k 2 0 ((J k 1 0 ^ i) v) = ((d:ℂ)-2*i) • (J k 1 0 ^ i) v := by
  have ht := horizontalTriple_of_charge k d v hv hh (by exact_mod_cast Nat.ne_of_gt hd)
  have hp : ht.HasPrimitiveVectorWith v (d:ℂ) := ⟨hv, hh, he⟩
  exact hp.lie_h_pow_toEnd_f i

/-- A locally nilpotent lowering string ends exactly after its highest charge. -/
theorem lowering_pow_succ_eq_zero (k : ℂ) (hk : k+2 ≠ 0)
    (d : ℕ) (hd : 0 < d) (v : WakModule k)
    (hv : v ≠ 0) (he : J k 0 0 v = 0) (hh : J k 2 0 v = (d:ℂ) • v) :
    (J k 1 0 ^ (d+1)) v = 0 := by
  have ht := horizontalTriple_of_charge k d v hv hh (by exact_mod_cast Nat.ne_of_gt hd)
  have hp : ht.HasPrimitiveVectorWith v (d:ℂ) := ⟨hv, hh, he⟩
  obtain ⟨i, hi, his⟩ := Nat.exists_not_and_succ_of_not_zero_of_exists
    (show ¬(J k 1 0 ^ 0) v=0 by simpa using hv)
    (horizontalLoweringLocallyNilpotent_universal k hk v)
  have hm := hp.lie_e_pow_succ_toEnd_f i
  change J k 0 0 ((J k 1 0 ^ (i+1)) v)=(((i:ℂ)+1)*((d:ℂ)-i)) • (J k 1 0 ^ i) v at hm
  rw [his, map_zero, eq_comm, smul_eq_zero_iff_left hi, mul_eq_zero] at hm
  have hdi : (d:ℂ)=(i:ℂ) := sub_eq_zero.mp (hm.resolve_left (by exact_mod_cast Nat.succ_ne_zero i))
  have : d=i := by exact_mod_cast hdi
  simpa only [this] using his

/-- The literal finite horizontal string is linearly independent. -/
theorem lowering_string_linearIndependent (k : ℂ) (d : ℕ) (hd : 0 < d)
    (v : WakModule k) (hv : v ≠ 0) (he : J k 0 0 v = 0)
    (hh : J k 2 0 v = (d:ℂ) • v) :
    LinearIndependent ℂ (fun i : Fin (d+1) => (J k 1 0 ^ i.val) v) := by
  refine (J k 2 0).eigenvectors_linearIndependent'
    (fun i : Fin (d+1) => (d:ℂ)-2*i.val) ?_ _ ?_
  · intro i j hij
    apply Fin.ext
    have : (i.val:ℂ)=(j.val:ℂ) := by linear_combination -hij/2
    exact_mod_cast this
  · intro i
    exact ⟨(Module.End.mem_eigenspace_iff.mpr
      (lowering_pow_charge k d hd v hv he hh i)),
      lowering_pow_ne_zero k d hd v hv he hh i (by omega)⟩

/-- The span of the actual lowering string has dimension d+1. -/
theorem lowering_string_finrank (k : ℂ) (d : ℕ) (hd : 0 < d)
    (v : WakModule k) (hv : v ≠ 0) (he : J k 0 0 v = 0)
    (hh : J k 2 0 v = (d:ℂ) • v) :
    Module.finrank ℂ (Submodule.span ℂ (Set.range
      (fun i : Fin (d+1) => (J k 1 0 ^ i.val) v))) = d+1 := by
  simpa using finrank_span_eq_card (lowering_string_linearIndependent k d hd v hv he hh)

/-- The finite string stays in its original energy subspace. -/
theorem lowering_pow_mem_grading (k : ℂ) (n : ℤ) (v : WakModule k)
    (hv : v ∈ gradingZA k n) (i : ℕ) : (J k 1 0 ^ i) v ∈ gradingZA k n := by
  induction i with
  | zero => simpa using hv
  | succ i ih =>
      rw [pow_succ', Module.End.mul_apply]
      simpa using J_mem_gradingZA k 1 0 n ih

/-- Every first admissible null state generates an actual finite horizontal
multiplet of dimension 2p-1 inside the maximal ideal, at energy q(p-1). -/
theorem admissible_first_null_horizontal_dimension (p q : ℕ)
    (hp : 2 ≤ p) (hq : 0 < q) (hcop : p.Coprime q) :
    ∃ U : Submodule ℂ (WakModule ((p:ℂ)/q-2)),
      U ≤ gradingZA _ (q*(p-1):ℕ) ∧
      U ≤ QuotVOA.maxGradedIdeal (universal _ (admissible_level_noncritical p q hp hq)) ∧
      Module.finrank ℂ U = 2*p-1 := by
  let k : ℂ := (p:ℂ)/q-2
  let hk := admissible_level_noncritical p q hp hq
  obtain ⟨v, hv, hj, hi⟩ := admissible_first_null p q hp hq hcop
  have he := admissible_first_null_raising p q hp hq hcop v hj hi
  have hh' : J k 2 0 v = ((2*(p-1):ℕ):ℂ) • v := by
    have h := ((mem_jointSpace_iff k hk _ _ v).mp hj).2
    change J k 2 0 v = ((2*((p:ℤ)-1):ℤ):ℂ) • v at h
    have hc : ((p-1:ℕ):ℂ)=(p:ℂ)-1 := by
      rw [Nat.cast_sub (by omega : 1 ≤ p), Nat.cast_one]
    simpa only [Int.cast_mul, Int.cast_ofNat, Int.cast_sub, Int.cast_natCast,
      Int.cast_one, Nat.cast_mul, Nat.cast_ofNat, hc] using h
  have hd : 0 < 2*(p-1) := by omega
  let U := Submodule.span ℂ (Set.range
    (fun i : Fin (2*(p-1)+1) => (J k 1 0 ^ i.val) v))
  refine ⟨U, ?_, ?_, ?_⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact lowering_pow_mem_grading k _ v (jointSpace_le_grading k hk _ _ hj) i
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    have hpow (j : ℕ) : (J k 1 0 ^ j) v ∈ QuotVOA.maxGradedIdeal (universal k hk) := by
      induction j with
      | zero => simpa using hi
      | succ j ih =>
          rw [pow_succ', Module.End.mul_apply]
          exact current_mem_maxIdeal k hk 1 0 _ ih
    exact hpow i
  · have hdim := lowering_string_finrank k (2*(p-1)) hd v hv he hh'
    exact hdim.trans (by omega)

end
end VOA.AffineSl2GeneralRigidity
