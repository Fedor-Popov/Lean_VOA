/-- One summand of the outermost `aWordActSparseQ [0,0,0]` expansion. -/
def hMode1Part0OuterSparseQ (m : ℤ) : SparseRational.Poly ℕ :=
  scaleQ (-4725 / 2048) (scaleQ 3 (scaleQ (1 / 6)
    (if 0 ≤ m then
      aFieldActSparseQ 0 m
        (aWordActSparseQ [0, 0] (-m) 6 l3hExpectedQ)
    else
      aWordActSparseQ [0, 0] (-m) (7 + m).toNat
        (aFieldActSparseQ 0 m l3hExpectedQ))))

