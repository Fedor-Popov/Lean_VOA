import VOA.Examples.TwoSeriesArakawaTriplet
import VOA.Examples.AffineSl2BoundarySingularFamily

/-!
# The slice Arakawa property from the bottom of the singular vector

`SliceArakawa (dsSliceMap c L)` asks that the Drinfeld–Sokolov slice map
`W : V^k(sl₂) → Vir^c` send the maximal ideal of `V^k` into the maximal ideal of `Vir^c`.

We reduce it to **one Virasoro membership**.  Let `s ∈ V^k` be a singular vector generating the
maximal ideal (the Adamović–Milas description of `L_k(sl₂)` at admissible level), normalised as a
horizontal highest-weight vector of `sl₂`-weight `2` (`e₀ s = 0`, `h₀ s = 2 s`; then `f₀³ s = 0`
is automatic, `TwoSeriesArakawaTriplet.f0_cube_eq_zero`).  Then

  `SliceArakawa (dsSliceMap c L)  ⇐  W(f₀² s) ∈ maxIdeal(Vir^c)`.

Proof.  The preimage `Z` of `maxIdeal(Vir^c)` is slice-closed (`TwoSeriesArakawaTransport`:
exact `f`, `h`, Sugawara transport and `f_{-1}`-saturation), so it contains the slice closure of
`f₀² s`; that closure contains `U(ŝl₂_{≤0}) s` (`TwoSeriesArakawaClosure`), which equals the
ideal generated by `s` (positive singularity), which is the maximal ideal (generation).

## Results

* `sliceMaxPreimage_closed` — the preimage of the Virasoro maximal ideal is slice-closed;
* `sliceArakawa_of_singularBottom` — the reduction above;
* `twoSeries_gradedUnitary_of_singularBottom` — **Affine GU ⇒ GU of `M(2, 2n+3)`**,
  `#print axioms`-clean, conditional on `hA`, Adamović–Milas generation of the maximal ideal by
  a horizontal-highest singular vector `s`, the single Virasoro membership
  `W(f₀² s) ∈ maxIdeal(Vir^c)`, and the jet-ideal Poincaré input `JetPoincareCoreT0`.

Numerical evidence (exact arithmetic mod `1000003`, `scripts/two_series_invariants/detect/`
style; not a proof): at `k = -8/5`, `c = -22/5` the singular vector `s` (weight `5`, unique up to
scale) has `f₀³ s = 0` and `W(f₀² s)`, `W(f₀ s)`, `W(s)` are nonzero elements of the maximal
ideal at Virasoro weights `4, 5, 6`.

**Status.**  Both inputs of this reduction are discharged elsewhere: the bottom membership is proved
for every level in `TwoSeriesArakawaBottom.bottom_mem_maxIdealVir`, and `SliceArakawa` itself is
proved with no generation hypothesis at all in
`TwoSeriesArakawaUnconditional.twoSeries_sliceArakawa`.  The closure route recorded here remains
a valid independent proof given Adamović–Milas generation.

Everything here is proved; no new axiom.
-/

namespace VOA.TwoSeries.SliceMap

open VOA.AffineVOA VOA.AffineVOA.SugawaraCov VOA.AffineVOA.Strong
open VOA.VirModule VOA.TwoSeries.DSSlice VOA.VirSimple VOA.LeeYangCharacter
open VOA.TwoSeries.StrictModel VOA.SymbolModel VOA.AffineVOA.Inst
open VOA.GradedUnitaryCohomology VirGradedUnitarity Sl2CosetConcrete
open VOA.AffineSl2BoundaryMaximalIdeal

noncomputable section

variable (c k : ℂ) (hk : k + 2 ≠ 0)

/-- The preimage of the Virasoro maximal ideal under the graded slice map is slice-closed. -/
theorem sliceMaxPreimage_closed : SliceClosed k hk (sliceMaxPreimage c k hk) where
  f_mem y hy j a := by
    rcases j with _ | j
    · have h := Wslice_f_one c k hk y a
      rw [show -((0 : ℕ) : ℤ) - 1 = -1 by norm_num, h]
      exact Submodule.neg_mem _ (hy (a - 1))
    · rw [show -((j + 1 : ℕ) : ℤ) - 1 = -(j : ℤ) - 2 by push_cast; ring, Wslice_f_high,
        Finsupp.zero_apply]
      exact Submodule.zero_mem _
  h_mem y _ j a := by
    rw [Wslice_h, Finsupp.zero_apply]
    exact Submodule.zero_mem _
  L_mem y hy j a := by
    rw [Wslice_Lm c k hk (by omega)]
    exact Lop_mem_maxIdealVir c _ (hy a)
  div_mem y hy a := by
    have h := Wslice_f_one c k hk y (a + 1)
    rw [add_sub_cancel_right] at h
    have h2 := Submodule.neg_mem _ (hy (a + 1))
    rwa [h, neg_neg] at h2

/-- **The slice Arakawa property from the bottom of a generating singular vector.** -/
theorem sliceArakawa_of_singularBottom (L : CosetLevels) (s : WakModule L.kA)
    (hgen : AffineVacuumMaximalSubmoduleGenerated L.kA L.aNoncritical s)
    (hS : SingP L.kA s) (he : J L.kA 0 0 s = 0) (hh : J L.kA 2 0 s = (2 : ℂ) • s)
    (hbot : ∀ a, Wslice c L.kA L.aNoncritical (J L.kA 1 0 (J L.kA 1 0 s)) a ∈ maxIdealVir c) :
    SliceArakawa (dsSliceMap c L) := by
  intro y hy a
  have hy' : y ∈ currentDescendantSpan L.kA s := by
    rw [hgen]; exact hy
  rw [← idealGen_eq_currentDescendantSpan L.kA L.aNoncritical s,
    idealGen_eq_nonpositiveCurrentSpan_of_SingP L.kA L.aNoncritical s hS] at hy'
  have hcl := nonpositiveCurrentSpan_le_sliceClosure (hk := L.aNoncritical) s hS he hh
    (f0_cube_eq_zero s he hh) hy'
  exact sliceClosure_le (Z := sliceMaxPreimage c L.kA L.aNoncritical) hbot
    (sliceMaxPreimage_closed c L.kA L.aNoncritical) hcl a

/-- The bottom membership for a charge-homogeneous bottom vector reduces to the ungraded map. -/
theorem wslice_mem_of_W1_mem {p : ℕ} {q : ℤ} {y : WakModule k} (hy : y ∈ KC k p q)
    (h : W1 c k hk y ∈ maxIdealVir c) : ∀ a, Wslice c k hk y a ∈ maxIdealVir c := by
  intro a
  rw [Wslice_KC c k hk hy, Finsupp.single_apply]
  split_ifs
  · exact h
  · exact Submodule.zero_mem _

/-- **Affine GU ⇒ GU of `M(2, 2n+3)`** (`n = m + 1`), `#print axioms`-clean, conditional on
`hA`, a horizontal-highest singular vector `s` generating the maximal ideal of `V^{k_n}(sl₂)`
(Adamović–Milas), the single Virasoro membership `W(f₀² s) ∈ maxIdeal(Vir^{c_{2,2n+1}})`, and the
jet-ideal Poincaré input. -/
theorem twoSeries_gradedUnitary_of_singularBottom (m : ℕ)
    (hA : GradedUnitary (affineForm (twoSeriesLevels (m + 1)))
      (affineRealStructure (twoSeriesLevels (m + 1))) (affineFlag (twoSeriesLevels (m + 1))))
    (s : WakModule (twoSeriesLevels (m + 1)).kA)
    (hgen : AffineVacuumMaximalSubmoduleGenerated (twoSeriesLevels (m + 1)).kA
      (twoSeriesLevels (m + 1)).aNoncritical s)
    (hS : SingP (twoSeriesLevels (m + 1)).kA s)
    (he : J (twoSeriesLevels (m + 1)).kA 0 0 s = 0)
    (hh : J (twoSeriesLevels (m + 1)).kA 2 0 s = (2 : ℂ) • s)
    (hbot : ∀ a, Wslice (twoSeriesLevels m).c (twoSeriesLevels (m + 1)).kA
      (twoSeriesLevels (m + 1)).aNoncritical
        (J (twoSeriesLevels (m + 1)).kA 1 0 (J (twoSeriesLevels (m + 1)).kA 1 0 s)) a ∈
          maxIdealVir (twoSeriesLevels m).c)
    (h : PoincareZero.JetPoincareCoreT0 (m + 1)) :
    VirGradedUnitary (twoSeriesLevels (m + 1)).c (targetRealStructure (twoSeriesLevels (m + 1))) :=
  twoSeries_gradedUnitary_of_sliceArakawa m hA
    (sliceArakawa_of_singularBottom _ _ s hgen hS he hh hbot) h

/-! ## The Adamović–Milas package -/

/-- **The bottom input of the closure route, as a proposition** (proved, see
`TwoSeriesArakawaBottom`).  At the level datum `L` and central charge `c`:
the Adamović–Milas package (a horizontal-highest positive-singular vector of weight `2n+1` whose
current descendants form the maximal ideal of `V^{kA}(sl₂)`), together with the statement that
the slice image of the bottom vector `f₀² s` of its horizontal triplet lies in `maxIdeal(Vir^c)`. -/
def SingularBottomInput (L : CosetLevels) (n : ℕ) : Prop :=
  ∃ D : AffineSl2BoundarySingularFamily.AdamovicMilasData L.kA n,
    ∀ a, Wslice c L.kA L.aNoncritical (J L.kA 1 0 (J L.kA 1 0 D.vector)) a ∈ maxIdealVir c

/-- `SliceArakawa` from the Adamović–Milas package and the bottom membership. -/
theorem sliceArakawa_of_singularBottomInput (L : CosetLevels) (n : ℕ)
    (h : SingularBottomInput c L n) : SliceArakawa (dsSliceMap c L) := by
  obtain ⟨D, hbot⟩ := h
  exact sliceArakawa_of_singularBottom c L D.vector D.maximalSubmodule D.positiveSingular
    D.horizontalRaising D.horizontalCharge hbot

/-- **Affine GU ⇒ GU of `M(2, 2m+5)`**, `#print axioms`-clean, conditional on `hA`,
`SingularBottomInput` at `k = -2 + 2/(2m+3)`, `c = c_{2,2m+3}`, and `JetPoincareCoreT0 (m+1)`. -/
theorem twoSeries_gradedUnitary_of_singularBottomInput (m : ℕ)
    (hA : GradedUnitary (affineForm (twoSeriesLevels (m + 1)))
      (affineRealStructure (twoSeriesLevels (m + 1))) (affineFlag (twoSeriesLevels (m + 1))))
    (hB : SingularBottomInput (twoSeriesLevels m).c (twoSeriesLevels (m + 1)) (m + 1))
    (h : PoincareZero.JetPoincareCoreT0 (m + 1)) :
    VirGradedUnitary (twoSeriesLevels (m + 1)).c (targetRealStructure (twoSeriesLevels (m + 1))) :=
  twoSeries_gradedUnitary_of_sliceArakawa m hA (sliceArakawa_of_singularBottomInput _ _ _ hB) h

end

end VOA.TwoSeries.SliceMap
