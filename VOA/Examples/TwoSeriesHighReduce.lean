import VOA.Examples.TwoSeriesHighModel

/-!
# From the model condition to the jet-ideal Poincaré lemma

`TwoSeriesHighModel` turns a membership `τ ∈ vMem (R_n) (N + k) d (2N)` into the model condition:
`inl F - x ∈ (J_n)` for a lift `F` of `τ` and some `x = Φ + ε Y ∈ Good (N + k)`.  Here we read off
the coefficients of `b^a` (via `optionEquivLeft`, `𝔸 ≅ ℂ[T_j][b]`) and obtain, for the
`T`-degree-`k` parts `G_a` of the `b^a`-coefficients of `Φ`:

* `G_0 ≡ F`, `G_a ∈ J_n` for `a ≥ 1`, `G_a = 0` for `a > N` (total degree `≤ N + k`);
* for every `q ≥ N + 1`: `Σ_{a<q} (-1)^{q-a} ∂_{q-a-1} G_a ∈ J_n` (the `b^q`-coefficient of
  `Dβ Φ = Λ x - Y`, using `deg (b Λ x) ≤ N + k`).

The jet shift (`HighJet.pderiv_shiftJ_sub`) then packages the `G_a` into **one** lift
`F' = G_0 + Σ_{a=1}^N (-1)^a (G_a shifted by a)` of `τ` with `∂_M F' ∈ J_n` for **every** `M ≥ N`.
Projecting to `T`-degree `k` and weight `E`, the jet-ideal Poincaré lemma `JetPoincare n N k E`
puts `τ` in the box.

* `mem_Jd` — the two components of the ideal generated by `J_n`;
* `coeff_E_mem` — coefficients of elements of `J_n 𝔸` lie in `J_n`;
* `hc_coeff_eq_zero` — the degree bound kills the `T`-degree-`k` part of high `b`-coefficients;
* `coeff_E_Dβ` — **the `b^q`-coefficient of `Dβ p`**:
  `Σ_{a<q} (-1)^{q-a} ∂_{q-a-1} (b^a-coeff p)`;
* `exists_good_lift` — the lift `F'` with `∂_M F' ∈ J_n` for all `M ≥ N`;
* `vMem_le_box_of_jetPoincare` — **`vMem (R_n) (N + k) d (2N) ⊆ box`** from `JetPoincare`.

Everything is proved outright.
-/

namespace VOA.TwoSeries.StrictModel

open MvPolynomial VOA.SymbolModel VOA.AdamovicSymbol

noncomputable section

namespace HighReduce

open InclLow HighJet HighModel LiftDegN

/-- `𝔸 ≅ ℂ[T_j][b]`. -/
abbrev Eb : AbH ≃ₐ[ℂ] Polynomial TPoly := optionEquivLeft ℂ ℕ

/-- The `b^a`-coefficient. -/
abbrev κ (a : ℕ) (p : AbH) : TPoly := (Eb p).coeff a

/-- `J_n 𝔸`. -/
abbrev JA (n : ℕ) : Ideal AbH := Ideal.map ιT.toRingHom (jetIdealT n)

theorem Eb_ιT (f : TPoly) : Eb (ιT f) = Polynomial.C f := by
  have h : (Eb.toAlgHom.comp ιT) = (Polynomial.CAlgHom : TPoly →ₐ[ℂ] Polynomial TPoly) := by
    refine MvPolynomial.algHom_ext fun i => ?_
    simp [optionEquivLeft_X_some]
  exact congrArg (fun φ : TPoly →ₐ[ℂ] Polynomial TPoly => φ f) h

theorem κ_ιT (f : TPoly) (a : ℕ) : κ a (ιT f) = if a = 0 then f else 0 := by
  rw [κ, Eb_ιT, Polynomial.coeff_C]

/-- The components of the ideal generated by `J_n` in `𝔸[ε]`. -/
theorem mem_Jd {n : ℕ} {z : DbH} (hz : z ∈ JdH n) :
    TrivSqZeroExt.fst z ∈ JA n ∧ TrivSqZeroExt.snd z ∈ JA n := by
  induction hz using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, hi, rfl⟩ := hy
    refine ⟨?_, ?_⟩
    · change TrivSqZeroExt.fst (TrivSqZeroExt.inl (ιT i)) ∈ JA n
      rw [TrivSqZeroExt.fst_inl]
      exact Ideal.mem_map_of_mem _ hi
    · change TrivSqZeroExt.snd (TrivSqZeroExt.inl (ιT i) : DbH) ∈ JA n
      rw [TrivSqZeroExt.snd_inl]
      exact Submodule.zero_mem _
  | zero => simp
  | add x y _ _ hx hy =>
    rw [TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add]
    exact ⟨add_mem hx.1 hy.1, add_mem hx.2 hy.2⟩
  | smul a x _ hx =>
    rw [smul_eq_mul, TrivSqZeroExt.fst_mul, TrivSqZeroExt.snd_mul, smul_eq_mul, op_smul_eq_mul]
    exact ⟨Ideal.mul_mem_left _ _ hx.1,
      add_mem (Ideal.mul_mem_left _ _ hx.2) (Ideal.mul_mem_left _ _ hx.1)⟩

/-- The `b^a`-coefficients of elements of `J_n 𝔸` lie in `J_n`. -/
theorem coeff_E_mem {n : ℕ} {p : AbH} (hp : p ∈ JA n) (a : ℕ) : κ a p ∈ jetIdealT n := by
  have h1 : Eb p ∈ Ideal.map Eb.toRingHom (JA n) := Ideal.mem_map_of_mem _ hp
  rw [JA, Ideal.map_map] at h1
  have hcomp : Eb.toRingHom.comp ιT.toRingHom = Polynomial.C :=
    RingHom.ext fun f => Eb_ιT f
  rw [hcomp] at h1
  exact Ideal.mem_map_C_iff.mp h1 a

/-! ### The degree bound -/

theorem sum_optionElim (a : ℕ) (d : ℕ →₀ ℕ) :
    ((Finsupp.optionElim a d).sum fun _ e => e) = a + Finsupp.degree d := by
  rw [Finsupp.sum_option_index _ _ (fun _ => rfl) (fun _ _ _ => rfl), Finsupp.optionElim_apply_none,
    Finsupp.some_optionElim, Finsupp.degree_apply, Finsupp.sum]

/-- The `b^a`-coefficient of a polynomial of total degree `≤ r` has degree `≤ r - a`. -/
theorem degree_le_of_coeff_ne {p : AbH} {r a : ℕ} (hp : p.totalDegree ≤ r) {d : ℕ →₀ ℕ}
    (hd : coeff d (κ a p) ≠ 0) : a + Finsupp.degree d ≤ r := by
  rw [κ, optionEquivLeft_coeff_coeff] at hd
  have := le_totalDegree (mem_support_iff.mpr hd)
  rw [sum_optionElim] at this
  exact this.trans hp

/-- The degree bound kills the `T`-degree-`k` part of the `b^a`-coefficients with `a + k > r`. -/
theorem hc_coeff_eq_zero {p : AbH} {r a k : ℕ} (hp : p.totalDegree ≤ r) (hak : r < a + k) :
    homogeneousComponent k (κ a p) = 0 := by
  classical
  ext d
  rw [coeff_homogeneousComponent, coeff_zero]
  split_ifs with hdk
  · by_contra hne
    have := degree_le_of_coeff_ne hp hne
    omega
  · rfl

theorem κ_bv_mul (p : AbH) (q : ℕ) : κ (q + 1) (bv * p) = κ q p := by
  rw [κ, κ, map_mul, show Eb bv = Polynomial.X from optionEquivLeft_X_none ℂ ℕ, mul_comm,
    Polynomial.coeff_mul_X]

/-! ### The `b`-coefficients of `Dβ` -/

theorem κ_add (a : ℕ) (p q : AbH) : κ a (p + q) = κ a p + κ a q := by
  rw [κ, κ, κ, map_add, Polynomial.coeff_add]

theorem κ_mul_bv (p : AbH) (a : ℕ) :
    κ a (p * bv) = if a = 0 then 0 else κ (a - 1) p := by
  rw [κ, κ, map_mul, show Eb bv = Polynomial.X from optionEquivLeft_X_none ℂ ℕ]
  rcases a with _ | a
  · simp
  · rw [Polynomial.coeff_mul_X]; simp

theorem κ_mul_X (p : AbH) (i a : ℕ) :
    κ a (p * MvPolynomial.X (some i)) = κ a p * MvPolynomial.X i := by
  rw [κ, κ, map_mul, optionEquivLeft_X_some, Polynomial.coeff_mul_C]

theorem κ_mul_negbv_pow (p : AbH) (i q : ℕ) :
    κ q (p * (-bv) ^ (i + 1)) =
      if i + 1 ≤ q then (-1) ^ (i + 1) * κ (q - (i + 1)) p else 0 := by
  rw [κ, κ, map_mul, map_pow, map_neg, show Eb bv = Polynomial.X from optionEquivLeft_X_none ℂ ℕ,
    neg_pow, mul_comm ((-1 : Polynomial TPoly) ^ (i + 1)), ← mul_assoc,
    show ((-1 : Polynomial TPoly) ^ (i + 1)) = Polynomial.C ((-1) ^ (i + 1)) by simp,
    Polynomial.coeff_mul_C, Polynomial.coeff_mul_X_pow']
  split_ifs <;> ring

/-- **The `b^q`-coefficient of `Dβ p`.** -/
theorem coeff_E_Dβ (p : AbH) : ∀ q : ℕ,
    κ q (Dβ p) = ∑ a ∈ Finset.range q, (-1) ^ (q - a) * pderiv (q - a - 1) (κ a p) := by
  induction p using MvPolynomial.induction_on with
  | C c =>
    intro q
    rw [Dβ_C, show κ q 0 = 0 by simp [κ]]
    refine (Finset.sum_eq_zero fun a _ => ?_).symm
    rw [show (MvPolynomial.C c : AbH) = ιT (MvPolynomial.C c) by simp, κ_ιT]
    split_ifs <;> simp
  | add p q hp hq =>
    intro r
    rw [map_add, κ_add, hp, hq, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [κ_add, map_add, mul_add]
  | mul_X p o hp =>
    intro q
    cases o with
    | none =>
      rw [Derivation.leibniz, show Dβ (MvPolynomial.X none) = 0 from Dβ_X_none, smul_zero,
        zero_add, smul_eq_mul, mul_comm, show (MvPolynomial.X none : AbH) = bv from rfl, κ_mul_bv]
      rcases q with _ | q
      · simp
      · rw [if_neg (Nat.succ_ne_zero q), Nat.add_sub_cancel, hp, Finset.sum_range_succ', κ_mul_bv,
          if_pos rfl, map_zero, mul_zero, add_zero]
        refine Finset.sum_congr rfl fun a ha => ?_
        rw [κ_mul_bv, if_neg (Nat.succ_ne_zero a), Nat.add_sub_cancel,
          show q + 1 - (a + 1) = q - a by omega]
    | some i =>
      rw [Derivation.leibniz, Dβ_X_some, smul_eq_mul, smul_eq_mul, κ_add, κ_mul_negbv_pow,
        mul_comm (MvPolynomial.X (some i)) (Dβ p), κ_mul_X, hp, Finset.sum_mul]
      simp only [κ_mul_X, Derivation.leibniz, pderiv_X, smul_eq_mul, mul_add,
        Finset.sum_add_distrib]
      have h1 : ∑ x ∈ Finset.range q,
          (-1) ^ (q - x) * (κ x p * (Pi.single (q - x - 1) 1 : ℕ → TPoly) i) =
          if i + 1 ≤ q then (-1) ^ (i + 1) * κ (q - (i + 1)) p else 0 := by
        split_ifs with hq
        · rw [Finset.sum_eq_single (q - (i + 1))]
          · rw [Pi.single_apply, if_pos (by omega), mul_one,
              show q - (q - (i + 1)) = i + 1 by omega]
          · intro a ha' ha
            have := Finset.mem_range.mp ha'
            rw [Pi.single_apply, if_neg (by omega), mul_zero, mul_zero]
          · intro h; exact absurd (Finset.mem_range.mpr (by omega)) h
        · refine Finset.sum_eq_zero fun a ha => ?_
          have := Finset.mem_range.mp ha
          rw [Pi.single_apply, if_neg (by omega), mul_zero, mul_zero]
      rw [h1]
      congr 1
      refine Finset.sum_congr rfl fun a _ => ?_
      ring

/-! ### Weighted components and the high derivatives -/

theorem pderiv_wc_mem {w : ℕ → ℕ} {I : Ideal TPoly}
    (hI : ∀ (E' : ℕ) (f : TPoly), f ∈ I → weightedHomogeneousComponent w E' f ∈ I)
    {g : TPoly} {M : ℕ} (E : ℕ) (hg : pderiv M g ∈ I) :
    pderiv M (weightedHomogeneousComponent w E g) ∈ I := by
  by_cases h : w M ≤ E
  · have := wc_pderiv w M (E - w M) g
    rw [Nat.sub_add_cancel h] at this
    rw [← this]; exact hI _ _ hg
  · have h0 : pderiv M (weightedHomogeneousComponent w E g) = 0 := by
      rw [as_sum (weightedHomogeneousComponent w E g), map_sum]
      refine Finset.sum_eq_zero fun s hs => ?_
      rw [pderiv_monomial]
      have hsE := weightedHomogeneousComponent_isWeightedHomogeneous E g (mem_support_iff.mp hs)
      by_cases hsM : s M = 0
      · rw [hsM]; simp
      · exfalso
        have := weight_sub_single (w := w) (Nat.one_le_iff_ne_zero.mpr hsM)
        omega
    rw [h0]; exact Submodule.zero_mem _

theorem hc_neg_one_pow_mul (d j : ℕ) (f : TPoly) :
    homogeneousComponent d ((-1 : TPoly) ^ j * f) = (-1) ^ j * homogeneousComponent d f := by
  rw [show ((-1 : TPoly) ^ j) = MvPolynomial.C ((-1 : ℂ) ^ j) by simp, ← smul_eq_C_mul,
    ← smul_eq_C_mul, map_smul]

theorem κ_sub (a : ℕ) (p q : AbH) : κ a (p - q) = κ a p - κ a q := by
  rw [κ, κ, κ, map_sub, Polynomial.coeff_sub]

/-! ### The lift -/

/-- **The lift.** From the model condition (`x ∈ Good (N + k)`, `inl F - x` in the ideal of
`J_n`) one gets a lift `F'` of `F` modulo `J_n` all of whose derivatives `∂_M F'`, `M ≥ N`, lie in
`J_n`. -/
theorem exists_good_lift {n N k : ℕ} (hn : 1 ≤ n) (hk : 1 ≤ k) {F : TPoly}
    (hFh : F.IsHomogeneous k) {x : DbH} (hx : x ∈ Good (N + k))
    (hj : TrivSqZeroExt.inl (ιT F) - x ∈ JdH n) :
    ∃ F' : TPoly, F' - F ∈ jetIdealT n ∧ ∀ M, N ≤ M → pderiv M F' ∈ jetIdealT n := by
  obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
  obtain ⟨hx1, hx2⟩ := mem_Good.mp hx
  obtain ⟨hj1, hj2⟩ := mem_Jd hj
  rw [TrivSqZeroExt.fst_sub, TrivSqZeroExt.fst_inl] at hj1
  rw [TrivSqZeroExt.snd_sub, TrivSqZeroExt.snd_inl, zero_sub] at hj2
  set Φ := TrivSqZeroExt.fst x with hΦ
  set G : ℕ → TPoly := fun a => homogeneousComponent k (κ a Φ) with hGdef
  have hFk : homogeneousComponent k F = F := by
    rw [homogeneousComponent_of_mem ((mem_homogeneousSubmodule _ _).mpr hFh), if_pos rfl]
  have hκ : ∀ a, κ a (ιT F - Φ) ∈ jetIdealT (n' + 1) := fun a => coeff_E_mem hj1 a
  have hG0 : G 0 - F ∈ jetIdealT (n' + 1) := by
    have h := hc_mem_jetIdealT k (hκ 0)
    rw [κ_sub, κ_ιT, if_pos rfl, map_sub, hFk] at h
    have := (jetIdealT (n' + 1)).neg_mem h
    rwa [neg_sub] at this
  have hGa : ∀ a, 1 ≤ a → G a ∈ jetIdealT (n' + 1) := by
    intro a ha
    have h := hc_mem_jetIdealT k (hκ a)
    rw [κ_sub, κ_ιT, if_neg (by omega), zero_sub, map_neg] at h
    have := (jetIdealT (n' + 1)).neg_mem h
    rwa [neg_neg] at this
  have hGN : ∀ a, N < a → G a = 0 := fun a ha => hc_coeff_eq_zero hx1 (by omega)
  -- the `b^q`-coefficients of `Dβ Φ`
  have hCN : ∀ q, N + 1 ≤ q →
      ∑ a ∈ Finset.range q, (-1) ^ (q - a) * pderiv (q - a - 1) (G a) ∈ jetIdealT (n' + 1) := by
    intro q hq
    have hD : Dβ Φ = Lam x - TrivSqZeroExt.snd x := by rw [Lam]; ring
    have h1 := coeff_E_Dβ Φ q
    rw [hD, κ_sub] at h1
    have h2 := congrArg (homogeneousComponent (k - 1)) h1
    rw [map_sub, map_sum] at h2
    have hL : homogeneousComponent (k - 1) (κ q (Lam x)) = 0 := by
      rw [← κ_bv_mul]; exact hc_coeff_eq_zero hx2 (by omega)
    rw [hL, zero_sub] at h2
    have hterm : ∀ a ∈ Finset.range q, homogeneousComponent (k - 1)
        ((-1) ^ (q - a) * pderiv (q - a - 1) (κ a Φ)) =
        (-1) ^ (q - a) * pderiv (q - a - 1) (G a) := by
      intro a _
      rw [hc_neg_one_pow_mul]
      congr 1
      have := wc_pderiv 1 (q - a - 1) (k - 1) (κ a Φ)
      rw [show k - 1 + (1 : ℕ → ℕ) (q - a - 1) = k by simp; omega] at this
      exact this
    rw [Finset.sum_congr rfl hterm] at h2
    rw [← h2]
    have hj2' : TrivSqZeroExt.snd x ∈ JA (n' + 1) := by
      have := (JA (n' + 1)).neg_mem hj2
      rwa [neg_neg] at this
    exact (jetIdealT (n' + 1)).neg_mem (hc_mem_jetIdealT _ (coeff_E_mem hj2' q))
  -- representations of `G a`, `a ≥ 1`
  have hrep : ∀ a, ∃ c : ℕ →₀ TPoly, 1 ≤ a → G a = shiftJ (n' + 1) 0 c := by
    intro a
    by_cases ha : 1 ≤ a
    · obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp (hGa a ha)
      exact ⟨c, fun _ => by rw [shiftJ_zero, ← hc]⟩
    · exact ⟨0, fun h => absurd h ha⟩
  choose c hc using hrep
  refine ⟨G 0 + ∑ a ∈ Finset.range N, (-1) ^ (a + 1) * shiftJ (n' + 1) (a + 1) (c (a + 1)),
    ?_, ?_⟩
  · rw [add_sub_right_comm]
    exact add_mem hG0 (Ideal.sum_mem _ fun a _ =>
      Ideal.mul_mem_left _ _ (shiftJ_mem _ _ _))
  · intro M hM
    have hconst : ∀ (j : ℕ) (y : TPoly), pderiv M ((-1 : TPoly) ^ j * y) =
        (-1) ^ j * pderiv M y := by
      intro j y
      rw [show ((-1 : TPoly) ^ j) = MvPolynomial.C ((-1 : ℂ) ^ j) by simp, ← smul_eq_C_mul,
        ← smul_eq_C_mul, (pderiv M).map_smul]
    rw [map_add, map_sum]
    simp only [hconst]
    -- compare with `Σ_{a ≤ N} (-1)^a ∂_{M-a} G_a`
    have hdiff : ∑ a ∈ Finset.range N,
        (-1) ^ (a + 1) * pderiv M (shiftJ (n' + 1) (a + 1) (c (a + 1))) -
        ∑ a ∈ Finset.range N, (-1) ^ (a + 1) * pderiv (M - (a + 1)) (G (a + 1)) ∈
          jetIdealT (n' + 1) := by
      rw [← Finset.sum_sub_distrib]
      refine Ideal.sum_mem _ fun a ha => ?_
      have haN := Finset.mem_range.mp ha
      rw [← mul_sub, hc (a + 1) (by omega)]
      exact Ideal.mul_mem_left _ _ (pderiv_shiftJ_sub n' (a + 1) M (by omega) _)
    have hsplit : ∑ a ∈ Finset.range (M + 1),
        (-1) ^ (M + 1 - a) * pderiv (M + 1 - a - 1) (G a) =
        ∑ a ∈ Finset.range (N + 1), (-1) ^ (M + 1 - a) * pderiv (M - a) (G a) := by
      rw [Finset.sum_congr rfl (fun a _ => by rw [show M + 1 - a - 1 = M - a by omega])]
      refine (Finset.sum_subset (Finset.range_subset_range.mpr (by omega : N + 1 ≤ M + 1))
        (fun a ha hna => ?_)).symm
      simp only [Finset.mem_range] at ha hna
      rw [hGN a (by omega), map_zero, mul_zero]
    have hsign : ∀ a, a ≤ M + 1 → ((-1 : TPoly) ^ (M + 1 - a)) = (-1) ^ (M + 1) * (-1) ^ a := by
      intro a ha
      have h1 : ((-1 : TPoly) ^ (M + 1)) = (-1) ^ (M + 1 - a) * (-1) ^ a := by
        rw [← pow_add, Nat.sub_add_cancel ha]
      rw [h1, mul_assoc, ← pow_add, ← two_mul, pow_mul]; simp
    have hmain : ∑ a ∈ Finset.range (N + 1), (-1) ^ a * pderiv (M - a) (G a) ∈
        jetIdealT (n' + 1) := by
      have h := hCN (M + 1) (by omega)
      rw [hsplit] at h
      rw [Finset.sum_congr rfl (fun a ha => by
        rw [hsign a (by simp at ha; omega), mul_assoc])] at h
      rw [← Finset.mul_sum] at h
      have h' := Ideal.mul_mem_left (jetIdealT (n' + 1)) ((-1) ^ (M + 1)) h
      rwa [← mul_assoc, ← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow, one_mul] at h'
    rw [Finset.sum_range_succ', pow_zero, one_mul, Nat.sub_zero] at hmain
    have := add_mem hmain hdiff
    convert this using 1
    ring

/-! ### The box -/

/-- **`vMem ⊆ box` from the jet-ideal Poincaré lemma.** In the slot `(N, k)` with `k ≥ 1`, the
membership space lies in the box as soon as `JetPoincare n N k E` holds in the weight
`E = d - r`. -/
theorem vMem_le_box_of_jetPoincare {n N k : ℕ} (hn : 1 ≤ n) (hk : 1 ≤ k) (d : ℤ)
    (hJP : ∀ E : ℕ, (E : ℤ) = d - ((N + k : ℕ) : ℤ) → JetPoincare n N k E) :
    vMem (Rn n) (tn n) (N + k) d (2 * N) ≤ boxW (tn n) N k (d - ((N + k : ℕ) : ℤ)) := by
  intro τ hτ
  have hτT := vMem_le_tMonW (Rn n) (tn n) (show N ≤ N + k by omega) d hτ
  rw [show N + k - N = k by omega] at hτT
  rcases lt_or_ge (d - ((N + k : ℕ) : ℤ)) 0 with hneg | hpos
  · rw [TailWitt.tMonW_neg _ _ hneg] at hτT
    rw [(Submodule.mem_bot ℂ).mp hτT]; exact Submodule.zero_mem _
  obtain ⟨E, hE⟩ : ∃ E : ℕ, d - ((N + k : ℕ) : ℤ) = (E : ℤ) :=
    ⟨_, (Int.toNat_of_nonneg hpos).symm⟩
  rw [hE] at hτT ⊢
  rw [tMonW_Rn_eq] at hτT
  obtain ⟨F, hF, hFτ⟩ := Submodule.mem_map.mp hτT
  rw [AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk] at hFτ
  obtain ⟨x, hx, hj⟩ := modelCond_of_vMem hτ F hFτ
  obtain ⟨F', hF'F, hF'd⟩ := exists_good_lift hn hk (homogeneous_of_tMonW hF) hx hj
  have hF''T : pw E (homogeneousComponent k F') ∈ tMonW TPoly MvPolynomial.X k (E : ℤ) :=
    proj_mem_tMonW k E F'
  have hFk : homogeneousComponent k F = F := by
    rw [homogeneousComponent_of_mem
      ((mem_homogeneousSubmodule _ _).mpr (homogeneous_of_tMonW hF)), if_pos rfl]
  have hFE : pw E F = F := pw_tMonW hF
  have hF''F : pw E (homogeneousComponent k F') - F ∈ jetIdealT n := by
    have h : pw E (homogeneousComponent k F') - F = pw E (homogeneousComponent k (F' - F)) := by
      rw [map_sub, map_sub, hFk, hFE]
    rw [h]; exact pw_mem_jetIdealT E (hc_mem_jetIdealT k hF'F)
  have hF''d : ∀ M, N ≤ M → pderiv M (pw E (homogeneousComponent k F')) ∈ jetIdealT n := by
    intro M hM
    refine pderiv_wc_mem (w := wT) (fun E' f hf => pw_mem_jetIdealT E' hf) E ?_
    exact pderiv_wc_mem (w := 1) (fun E' f hf => hc_mem_jetIdealT E' hf) k (hF'd M hM)
  have hbox := hJP E hE.symm _ hF''T hF''d
  have hmk : Ideal.Quotient.mk (jetIdealT n) (pw E (homogeneousComponent k F')) = τ := by
    rw [← hFτ, Ideal.Quotient.eq]; exact hF''F
  rwa [hmk] at hbox

end HighReduce

end

end VOA.TwoSeries.StrictModel
