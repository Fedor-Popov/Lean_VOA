import VOA.Examples.AffineSl2HighestTensorRep

/-!
# Actual affine sl2 highest modules and unconditional word independence

The carrier is the usual enveloping-algebra quotient by the positive Borel,
fixed centre, highest Cartan weight and degree-zero relations. Evaluation
into the actual triple tensor model proves independence of all occupation
creation words at every pair of parameters. Spanning and the ordinary
contravariant form are separate constructions, not assumed here.
-/
namespace VOA.AffineVOA.HighestModule
open Module (End)
open UniversalEnvelopingAlgebra
open HighestNormalOrdering
open NormalOrdering (currentWord)
open Wak.Charged (Occupation occupationWord)
noncomputable section

/-- The existing full affine enveloping algebra, including its derivation. -/
abbrev U := UniversalEnvelopingAlgebra ℂ AffSl2

/-- A basis-coloured loop element in the actual affine Lie algebra. -/
def modeElement (a : Fin 3) (n : ℤ) : AffSl2 :=
  AffineLie.ofLoop kappaForm kappaForm_isInvariant (basis a) n

/-- Defining generators of the actual highest-weight left ideal. All
noncreation currents have their prescribed highest-vector value. -/
def highestGens (k h : ℂ) : Set U := {u |
    (∃ a n,¬IsLower a n ∧ u=ι ℂ (modeElement a n)-
      algebraMap ℂ U (if n=0 ∧ a=2 then h else 0)) ∨
    u=ι ℂ (AffineLie.C kappaForm kappaForm_isInvariant)-algebraMap ℂ U k ∨
    u=ι ℂ (AffineLie.ell0 kappaForm kappaForm_isInvariant)}

/-- The genuine left ideal generated by the highest relations. -/
def highestIdeal (k h : ℂ) : Submodule U U := Submodule.span U (highestGens k h)

/-- The actual affine Verma carrier at arbitrary complex level and weight. -/
abbrev Verma (k h : ℂ) := U ⧸ highestIdeal k h

/-- Full affine Lie action by left multiplication on the quotient. -/
def rho (k h : ℂ) : AffSl2→ₗ⁅ℂ⁆End ℂ (Verma k h) :=
  (Algebra.lsmul ℂ ℂ (Verma k h)).toLieHom.comp (ι ℂ)

/-- Quotient action on a representative is literal left multiplication. -/
theorem rho_mk (k h : ℂ) (x : AffSl2) (u : U) :
    rho k h x (Submodule.Quotient.mk u)=Submodule.Quotient.mk (ι ℂ x*u) := rfl

/-- The universal highest vector is the class of the enveloping unit. -/
def highestVector (k h : ℂ) : Verma k h := Submodule.Quotient.mk 1

/-- Actual basis-coloured Verma current operators. -/
def mode (k h : ℂ) (a : Fin 3) (n : ℤ) : End ℂ (Verma k h) := rho k h (modeElement a n)

/-- Each prescribed highest current equation holds in the actual quotient. -/
theorem mode_highest (k h : ℂ) (a : Fin 3) (n : ℤ) (hn : ¬IsLower a n) :
    mode k h a n (highestVector k h)=if n=0 ∧ a=2 then h • highestVector k h else 0 := by
  have hh : mode k h a n (highestVector k h)=
      (if n=0 ∧ a=2 then h else 0) • highestVector k h := by
    rw [mode,highestVector,rho_mk,mul_one,← Submodule.Quotient.mk_smul,
      Algebra.smul_def,mul_one,Submodule.Quotient.eq]
    exact Submodule.subset_span (Or.inl ⟨a,n,hn,rfl⟩)
  simpa only [ite_smul,zero_smul] using hh

/-- The derivation kills the highest vector by its defining relation. -/
theorem degree_highest (k h : ℂ) :
    rho k h (AffineLie.ell0 kappaForm kappaForm_isInvariant) (highestVector k h)=0 := by
  rw [highestVector,rho_mk,mul_one,Submodule.Quotient.mk_eq_zero]
  exact Submodule.subset_span (Or.inr (Or.inr rfl))

set_option maxHeartbeats 800000 in
/-- The centre acts by the specified scalar on the WHOLE actual Verma
module, because the central correction commutes with every representative. -/
theorem rho_central (k h : ℂ) :
    rho k h (AffineLie.C kappaForm kappaForm_isInvariant)=k • (1 : End ℂ (Verma k h)) := by
  apply LinearMap.ext
  intro v
  obtain ⟨u,rfl⟩ := Submodule.Quotient.mk_surjective (highestIdeal k h) v
  rw [rho_mk,LinearMap.smul_apply,Module.End.one_apply,← Submodule.Quotient.mk_smul,
    Submodule.Quotient.eq]
  have hc : Commute u (ι ℂ (AffineLie.C kappaForm kappaForm_isInvariant)-algebraMap ℂ U k) :=
    (AffineLie.commute_ι_C kappaForm kappaForm_isInvariant u).symm.sub_right
      (Algebra.commute_algebraMap_right k u)
  have he : ι ℂ (AffineLie.C kappaForm kappaForm_isInvariant)*u-k • u=
      u*(ι ℂ (AffineLie.C kappaForm kappaForm_isInvariant)-algebraMap ℂ U k) := by
    rw [hc.eq,sub_mul,Algebra.smul_def]
  rw [he,← smul_eq_mul]
  exact (highestIdeal k h).smul_mem u (Submodule.subset_span (Or.inr (Or.inl rfl)))

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- The precise actual highest-vector equations used by universal evaluation. -/
structure IsHighest (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) (k h : ℂ) : Prop where
  central : R (AffineLie.C kappaForm kappaForm_isInvariant)=k • (1 : End ℂ E)
  degree : R (AffineLie.ell0 kappaForm kappaForm_isInvariant) v=0
  modes : ∀ a n,¬IsLower a n → R (modeElement a n) v=
    if n=0 ∧ a=2 then h • v else 0

/-- Actual enveloping evaluation on a chosen highest vector. -/
def evaluate (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) : U→ₗ[ℂ]E where
  toFun u := (lift ℂ R u) v
  map_add' a b := by rw [map_add,LinearMap.add_apply]
  map_smul' z a := by rw [map_smul,LinearMap.smul_apply]; rfl

/-- The unit evaluates to the chosen actual vector. -/
theorem evaluate_one (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) : evaluate R v 1=v := by
  change (lift ℂ R 1) v=v
  rw [map_one,Module.End.one_apply]

/-- The actual highest relations and their entire left ideal evaluate to
zero, so no well-definedness assumption is required for the universal map. -/
theorem highestIdeal_le_ker (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) {k h : ℂ}
    (hv : IsHighest R v k h) : (highestIdeal k h).restrictScalars ℂ≤LinearMap.ker (evaluate R v) := by
  intro u hu
  change u∈highestIdeal k h at hu
  induction hu using Submodule.span_induction with
  | mem g hg =>
      rcases hg with ⟨a,n,hn,rfl⟩|rfl|rfl
      · rw [LinearMap.mem_ker]
        change (lift ℂ R (ι ℂ (modeElement a n)-algebraMap ℂ U _)) v=0
        rw [map_sub,lift_ι_apply,AlgHom.commutes,Algebra.algebraMap_eq_smul_one,
          LinearMap.sub_apply,LinearMap.smul_apply,Module.End.one_apply,hv.modes a n hn]
        split_ifs <;> simp
      · rw [LinearMap.mem_ker]
        change (lift ℂ R (ι ℂ (AffineLie.C kappaForm kappaForm_isInvariant)-algebraMap ℂ U k)) v=0
        rw [map_sub,lift_ι_apply,AlgHom.commutes,Algebra.algebraMap_eq_smul_one,
          hv.central,sub_self,LinearMap.zero_apply]
      · rw [LinearMap.mem_ker]
        change (lift ℂ R (ι ℂ (AffineLie.ell0 kappaForm kappaForm_isInvariant))) v=0
        rw [lift_ι_apply,hv.degree]
  | zero => exact LinearMap.mem_ker.mpr (map_zero _)
  | add u w _ _ hu hw => exact LinearMap.mem_ker.mpr (by rw [map_add,hu,hw,add_zero])
  | smul a u _ hu =>
      apply LinearMap.mem_ker.mpr
      have hz : evaluate R v u=0 := LinearMap.mem_ker.mp hu
      change (lift ℂ R (a*u)) v=0
      rw [map_mul,Module.End.mul_apply]
      change (lift ℂ R a) (evaluate R v u)=0
      rw [hz,map_zero]

/-- The canonical ACTUAL highest-module evaluation map to any representation
satisfying its highest equations. The tensor construction supplies such a
representation at every pair of complex parameters. -/
def universalMap (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) {k h : ℂ} (hv : IsHighest R v k h) :
    Verma k h→ₗ[ℂ]E :=
  (((highestIdeal k h).restrictScalars ℂ).liftQ (evaluate R v) (highestIdeal_le_ker R v hv)).comp
    (Submodule.Quotient.restrictScalarsEquiv ℂ (highestIdeal k h)).symm.toLinearMap

/-- Evaluation of a quotient representative uses the original enveloping action. -/
theorem universalMap_mk (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) {k h : ℂ}
    (hv : IsHighest R v k h) (u : U) :
    universalMap R v hv (Submodule.Quotient.mk u)=evaluate R v u := rfl

/-- The universal evaluation sends the formal highest vector to the actual one. -/
theorem universalMap_highest (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) {k h : ℂ}
    (hv : IsHighest R v k h) : universalMap R v hv (highestVector k h)=v := by
  rw [highestVector,universalMap_mk,evaluate_one]

/-- The universal map intertwines every actual affine Lie operator. -/
theorem universalMap_intertwines (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) {k h : ℂ}
    (hv : IsHighest R v k h) (x : AffSl2) (u : Verma k h) :
    universalMap R v hv (rho k h x u)=R x (universalMap R v hv u) := by
  obtain ⟨a,rfl⟩ := Submodule.Quotient.mk_surjective (highestIdeal k h) u
  rw [rho_mk,universalMap_mk,universalMap_mk]
  change (lift ℂ R (ι ℂ x*a)) v=R x ((lift ℂ R a) v)
  rw [map_mul,lift_ι_apply,Module.End.mul_apply]

/-- Literal current words are evaluated by the corresponding actual word,
with their order preserved. -/
theorem universalMap_word (R : AffSl2→ₗ⁅ℂ⁆End ℂ E) (v : E) {k h : ℂ}
    (hv : IsHighest R v k h) (w : List (Fin 3×ℤ)) :
    universalMap R v hv (currentWord (mode k h) w (highestVector k h))=
      currentWord (fun a n => R (modeElement a n)) w v := by
  induction w with
  | nil => exact universalMap_highest R v hv
  | cons an w ih =>
      rw [currentWord,Module.End.mul_apply,mode,universalMap_intertwines,ih]
      rfl

/-- Every actual affine highest module has a nonzero highest vector, at
ALL complex levels and weights, witnessed by the explicit tensor model. -/
theorem highestVector_ne_zero (k h : ℂ) : highestVector k h≠0 := by
  obtain ⟨R,hC,hD,hM,hI⟩ := Wak.Charged.exists_independent_highest_realization k h
  have hv : IsHighest R Wak.Charged.highestTensorVacuum k h := ⟨hC,hD,hM⟩
  intro hz
  have he := congrArg (universalMap R _ hv) hz
  rw [universalMap_highest,map_zero] at he
  exact Wak.Charged.highestTensorVacuum_ne_zero he

/-- Creation occupation words in the ACTUAL affine Verma quotient are
linearly independent at EVERY complex level and highest weight, including
F_0 powers and critical level. The proof uses verified vacuum independence
and explicit tensor evaluation, not a project PBW axiom. -/
theorem occupationWords_independent (k h : ℂ) :
    LinearIndependent ℂ (fun d : Occupation => currentWord (mode k h)
      (occupationWord d) (highestVector k h)) := by
  obtain ⟨R,hC,hD,hM,hI⟩ := Wak.Charged.exists_independent_highest_realization k h
  have hv : IsHighest R Wak.Charged.highestTensorVacuum k h := ⟨hC,hD,hM⟩
  have hi : LinearIndependent ℂ (fun d : Occupation => universalMap R _ hv
      (currentWord (mode k h) (occupationWord d) (highestVector k h))) := by
    simpa only [universalMap_word,modeElement] using hI
  exact LinearIndependent.of_comp (universalMap R _ hv) hi

end
end VOA.AffineVOA.HighestModule
