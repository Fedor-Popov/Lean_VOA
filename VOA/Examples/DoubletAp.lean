import VOA.Core.SuperEvenPart
import VOA.Examples.DoubletGenerators
import VOA.Examples.TripletWp

/-!
# The doublet algebra `A(p)` as a super subalgebra

`A(p)` is the subalgebra of the (background-charge deformed) **half**-lattice algebra
`½ℤγ`, `⟨γ,γ⟩ = 2p`, generated by the conformal vector `ω` together with the two states

  `a⁻ = e^{−γ/2}`,   `a⁺ = Q a⁻`,   `Q = (e^{γ})₍₀₎`,

both of deformed weight `(3p−2)/4` (`Examples.DoubletGenerators`).  This file performs the
**assembly**: it forms the generated `SuperVOASubalgebra`, records its non-degeneracy, and
proves the one structural property that the design of `SuperNearVOA` was built for —
`BoundedBelow` descends to a subalgebra even though `positivity` does not.

## ⚠ The ambient is not yet constructed — read this first

The ambient object for `A(p)` is a `SuperNearVOA` on the `ℂ`-graded half-lattice module.
That object **does not exist in this repository**: the half lattice `½ℤγ` as an
`IntegralLattice` and the `ℂ`-graded super near-VOA on it were the subject of separate work
that produced no file.  Consequently *nothing here is instantiated at a concrete `p`*.

Everything below is therefore stated for an **arbitrary** ambient `W : SuperNearVOA 𝒱`
together with two states `am ap : 𝒱`.  §4 narrows this to the half-lattice setting through
the one-field structure `DeformedAmbient`, which packages exactly what the missing
construction has to supply: a `SuperNearVOA` on `LatModuleGen L` whose `L₀` is the deformed
`BgB.LBG L lam 0`.  Given such a structure every weight statement of
`Examples.DoubletGenerators` (an *operator eigenvalue* statement) is upgraded here to a
*grading membership* statement, and the assembly of §2 applies verbatim.  See the
"Gaps" section at the end of this docstring for the precise list.

## Main definitions

* `doubletA W am ap` — `A(p) := ⟨ω, a⁻, a⁺⟩` as a `SuperVOASubalgebra W`.
* `doubletAEvenVOA` — the even part `A(p)₀̄` as a *bosonic* `VertexOperatorAlgebra`, given
  the three even-part hypotheses of `Core.SuperEvenPart`.
* `DeformedAmbient L lam` — the interface the missing half-lattice construction must meet.

## Main results

* `subalgebra_boundedBelow` — **a subalgebra of a bounded-below super near-VOA is
  bounded below**, hence `doubletA_boundedBelow`.  This is the target: the ambient
  half-lattice algebra genuinely has states of negative weight (`ambient_not_positivity`
  below *proves* this, it is not an assumption), so `positivity` cannot be inherited, but
  `BoundedBelow` can be and is.
* `doubletA_positivity_of_subalgebra`, `not_mem_doubletA_of_subalgebra` — the honest
  reduction of the two remaining questions to the exhibition of *one* intermediate
  subalgebra.  Because `A(p)` is defined as a minimum, any subalgebra containing the three
  generators sandwiches it.
* `ambient_not_positivity` — for `p > 2` the deformed half-lattice ambient has a **non-zero
  state of negative conformal weight** (`e^{+γ/2}`, weight `(2−p)/4`).  So the failure of
  positivity in the ambient is a theorem, and the passage through `BoundedBelow` is forced,
  not a stylistic choice.
* `aMinus_mem_grading`, `aPlus_mem_grading`, `eG_mem_grading` — the generators as elements
  of the ambient weight spaces.
* `centralChargeAp_eq_tripletW` — the honest half of target (e): `A(p)` and `W(p)` carry the
  same central charge `1 − 6(p−1)²/p`.

## Gaps (nothing below is proved here, and nothing below is assumed silently)

1. **No ambient.** No `DeformedAmbient L lam` is constructed for any `L`.  Missing: the half
   lattice `½ℤγ` as an `IntegralLattice`, and a `SuperNearVOA` structure on `LatModuleGen L`
   whose `L₀` is `BgB.LBG L lam 0` and whose parity assigns `a⁻, a⁺` odd degree.
2. **No `BoundedBelow` for the ambient.**  `subalgebra_boundedBelow` is an implication; its
   hypothesis `W.BoundedBelow` is an obligation on the missing ambient.  (It is the *easy*
   half — the half-lattice weights `pm²/4 − (p−1)m/2` are bounded below on `m ∈ ℤ` — but it
   cannot be stated without the ambient.)
3. **No positivity for `A(p)`.**  Deliberately.  The honest proof needs `A(p) = Ker Q̃` for
   the long screening, which this project route avoids.  What is offered instead is
   `doubletA_positivity_of_subalgebra`.
4. **`e^{+γ/2} ∉ A(p)` is not proved**, only reduced (`not_mem_doubletA_of_subalgebra`).
5. **`A(p)₀̄ ≅ W(p)` is not proved** and is not attempted; only the central charges are
   matched.  Whether `A(p)₀̄` is bosonic at all depends on `p mod 4`
   (`LatGen.Doublet.form_gg_even_iff`): the doublet weight `(3p−2)/4` is an integer exactly
   for `p ≡ 2 mod 4` and a half-integer exactly for `4 ∣ p`.
-/

set_option linter.style.longLine false

namespace VOA.DoubletAp

open scoped BigOperators
open Module (End)
open VOA VOA.IntegralLattice
open VOA.LatGen VOA.LatGen.BgB VOA.LatGen.Doublet

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]

/-! ## §0  Two non-degeneracy facts about an arbitrary super near-VOA

Both are needed for target (b) and neither is in `Core`.  They are stated with an explicit
witness `u ≠ 0` rather than `[Nontrivial 𝒱]`, because the concrete carriers in this project
carry no registered `Nontrivial` instance. -/

/-- **The vacuum is non-zero** as soon as *some* vector is: `𝟙 = 0` would force
`u = u₍₋₁₎𝟙 = 0` for every `u`. -/
theorem vacuum_ne_zero (W : SuperNearVOA 𝒱) {u : 𝒱} (hu : u ≠ 0) : W.vacuum ≠ 0 := by
  intro h
  apply hu
  have hc := (W.creation u).1
  rw [h, map_zero] at hc
  exact hc.symm

/-- **The conformal vector is non-zero** when the central charge is.  If `ω = 0` then
`Y(ω,z) = 0`, so every `Lₙ` vanishes, and the Virasoro relation at `(m,n) = (2,−2)` reads
`0 = (c/2)·id`. -/
theorem conformalVector_ne_zero (W : SuperNearVOA 𝒱) {u : 𝒱} (hu : u ≠ 0)
    (hc : W.centralCharge ≠ 0) : W.conformalVector ≠ 0 := by
  intro h
  have hY : W.Y W.conformalVector = 0 := by rw [h]; exact map_zero _
  have hL : ∀ n : ℤ, W.L n = 0 := by
    intro n
    rw [SuperNearVOA.L_def, mode_apply, hY]
    rfl
  have hvir := W.virasoro_L 2 (-2)
  rw [hL 2, hL (-2), hL (2 + -2), lie_zero, smul_zero, zero_add,
    if_pos (show (2 : ℤ) + -2 = 0 from by decide)] at hvir
  have happ := congrArg (fun T : End ℂ 𝒱 => T W.vacuum) hvir
  simp only [LinearMap.zero_apply, LinearMap.smul_apply, Module.End.one_apply] at happ
  rcases smul_eq_zero.mp happ.symm with hz | hz
  · rcases mul_eq_zero.mp hz with h1 | h2
    · norm_num at h1
    · exact hc h2
  · exact vacuum_ne_zero W hu hz

/-! ## §1  `BoundedBelow` descends to a subalgebra — the design point

`positivity` does **not** descend to a subalgebra of an arbitrary near-VOA, and for the
doublet's ambient it is outright false (§4, `ambient_not_positivity`).  `BoundedBelow` does
descend, for the trivial reason that a subspace of a vanishing weight space vanishes.  This
is precisely why `Core.SuperNearVOA` isolates `BoundedBelow` as a `Prop` outside the
structure. -/

/-- **A super vertex operator subalgebra of a bounded-below super near-VOA is bounded
below**, with the *same* bound.

(This is the general statement; `Core.SuperEvenPart` has only the `evenPart` special case
`SuperVOASubalgebra.evenPart_boundedBelow`.) -/
theorem subalgebra_boundedBelow {W : SuperNearVOA 𝒱} (S : SuperVOASubalgebra W)
    (hW : W.BoundedBelow) : S.toSuperNearVOA.BoundedBelow := by
  obtain ⟨B, hB⟩ := hW
  exact ⟨B, fun h hh => S.gradingS_eq_bot_of_bot (hB h hh)⟩

/-- Weight spaces are monotone along inclusions of subalgebras: if `S ≤ B` and the weight
`h` is absent from `B`, it is absent from `S`. -/
theorem gradingS_eq_bot_of_le {W : SuperNearVOA 𝒱} {S B : SuperVOASubalgebra W}
    (hle : S.carrier ≤ B.carrier) {h : ℂ} (hb : B.gradingS h = ⊥) : S.gradingS h = ⊥ := by
  refine le_antisymm (fun x hx => ?_) bot_le
  have hxW : (x : 𝒱) ∈ W.grading h := hx
  have hxB : (⟨(x : 𝒱), hle x.2⟩ : B.carrier) ∈ B.gradingS h := hxW
  rw [hb, Submodule.mem_bot] at hxB
  have hval : (x : 𝒱) = 0 := congrArg Subtype.val hxB
  exact (Submodule.mem_bot ℂ).mpr (Subtype.ext hval)

/-- A subalgebra of a subalgebra with no negative weights has no negative weights.  This is
the shape in which positivity would be *transported* if an intermediate object were ever
exhibited. -/
theorem subalgebra_positivity_of_le {W : SuperNearVOA 𝒱} {S B : SuperVOASubalgebra W}
    (hle : S.carrier ≤ B.carrier)
    (hB : ∀ h : ℂ, h.re < 0 → B.gradingS h = ⊥) :
    ∀ h : ℂ, h.re < 0 → S.toSuperNearVOA.grading h = ⊥ :=
  fun h hh => gradingS_eq_bot_of_le hle (hB h hh)

/-! ## §2  The assembly: `A(p) = ⟨ω, a⁻, a⁺⟩`

`am` and `ap` stand for `a⁻` and `a⁺`.  Nothing in this section knows that they are
half-lattice states; §4 supplies that. -/

variable (W : SuperNearVOA 𝒱)

/-- **The doublet algebra `A(p)`**: the super vertex operator subalgebra of the ambient
generated by the conformal vector and the two weight-`(3p−2)/4` doublet states.

Being defined as `SuperVOASubalgebra.generated`, it is the *smallest* subalgebra containing
the three generators (`doubletA_le`); that minimality is what makes `A(p)` amenable to the
sandwich arguments of `doubletA_positivity_of_subalgebra` and
`not_mem_doubletA_of_subalgebra`, and it is the only handle available until the ambient is
built. -/
def doubletA (am ap : 𝒱) : SuperVOASubalgebra W :=
  SuperVOASubalgebra.generated W {W.conformalVector, am, ap}

theorem doubletA_def (am ap : 𝒱) :
    doubletA W am ap = SuperVOASubalgebra.generated W {W.conformalVector, am, ap} := rfl

variable {W}

/-! ### Target (b): the four distinguished states are members -/

theorem gens_subset (am ap : 𝒱) :
    ({W.conformalVector, am, ap} : Set 𝒱) ⊆ (doubletA W am ap).carrier :=
  SuperVOASubalgebra.subset_generated _

/-- `ω ∈ A(p)`. -/
theorem conformalVector_mem_doubletA (am ap : 𝒱) :
    W.conformalVector ∈ (doubletA W am ap).carrier :=
  gens_subset am ap (Set.mem_insert _ _)

/-- `a⁻ ∈ A(p)`. -/
theorem aMinus_mem_doubletA (am ap : 𝒱) : am ∈ (doubletA W am ap).carrier :=
  gens_subset am ap (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

/-- `a⁺ ∈ A(p)`. -/
theorem aPlus_mem_doubletA (am ap : 𝒱) : ap ∈ (doubletA W am ap).carrier :=
  gens_subset am ap (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))

/-- `𝟙 ∈ A(p)` — a subalgebra contains the vacuum by definition. -/
theorem vacuum_mem_doubletA (am ap : 𝒱) : W.vacuum ∈ (doubletA W am ap).carrier :=
  (doubletA W am ap).vacuum_mem

/-! ### Target (b): non-degeneracy -/

/-- The carrier of `A(p)` is non-trivial as soon as `a⁻ ≠ 0`. -/
theorem doubletA_carrier_ne_bot {am : 𝒱} (ap : 𝒱) (ham : am ≠ 0) :
    (doubletA W am ap).carrier ≠ ⊥ := by
  intro h
  exact ham ((Submodule.eq_bot_iff _).mp h am (aMinus_mem_doubletA am ap))

/-- `A(p)` contains a non-zero vector when `a⁻` does not vanish. -/
theorem exists_ne_zero_doubletA {am : 𝒱} (ap : 𝒱) (ham : am ≠ 0) :
    ∃ x ∈ (doubletA W am ap).carrier, x ≠ 0 :=
  ⟨am, aMinus_mem_doubletA am ap, ham⟩

/-- `ω ≠ 0` for the doublet ambient, from `c ≠ 0` — see `conformalVector_ne_zero`.  Restated
here because target (b) asks for it at `A(p)`. -/
theorem conformalVector_ne_zero_doubletA {am : 𝒱} (_ap : 𝒱) (ham : am ≠ 0)
    (hc : W.centralCharge ≠ 0) : W.conformalVector ≠ 0 :=
  conformalVector_ne_zero W ham hc

/-- `𝟙 ≠ 0` for the doublet ambient. -/
theorem vacuum_ne_zero_doubletA {am : 𝒱} (_ap : 𝒱) (ham : am ≠ 0) : W.vacuum ≠ 0 :=
  vacuum_ne_zero W ham

/-! ### Minimality, and the sandwich reductions -/

/-- **Minimality**: any subalgebra containing the three generators contains `A(p)`. -/
theorem doubletA_le (am ap : 𝒱) (B : SuperVOASubalgebra W)
    (hω : W.conformalVector ∈ B.carrier) (ham : am ∈ B.carrier) (hap : ap ∈ B.carrier) :
    (doubletA W am ap).carrier ≤ B.carrier := by
  refine SuperVOASubalgebra.generated_le B ?_
  rintro x (rfl | rfl | rfl)
  · exact hω
  · exact ham
  · exact hap

/-- ⚠ **The positivity reduction.**  To prove that `A(p)` has no states of negative
conformal weight it suffices to exhibit *one* subalgebra of the ambient that contains
`ω, a⁻, a⁺` and has none.  This is the honest content of target (c) beyond
`BoundedBelow`: the statement is reduced, not proved, and the intended witness — the kernel
of the long screening — is not constructed in this project. -/
theorem doubletA_positivity_of_subalgebra (am ap : 𝒱) (B : SuperVOASubalgebra W)
    (hω : W.conformalVector ∈ B.carrier) (ham : am ∈ B.carrier) (hap : ap ∈ B.carrier)
    (hB : ∀ h : ℂ, h.re < 0 → B.gradingS h = ⊥) :
    ∀ h : ℂ, h.re < 0 → (doubletA W am ap).toSuperNearVOA.grading h = ⊥ :=
  subalgebra_positivity_of_le (doubletA_le am ap B hω ham hap) hB

/-- ⚠ **The exclusion reduction** (target (c), bonus).  A state is outside `A(p)` as soon as
it is outside *some* subalgebra containing the generators.  Applied to `x = e^{+γ/2}` — the
negative-weight state of `ambient_not_positivity` — this is exactly the missing step. -/
theorem not_mem_doubletA_of_subalgebra {x : 𝒱} (am ap : 𝒱) (B : SuperVOASubalgebra W)
    (hω : W.conformalVector ∈ B.carrier) (ham : am ∈ B.carrier) (hap : ap ∈ B.carrier)
    (hx : x ∉ B.carrier) : x ∉ (doubletA W am ap).carrier :=
  fun hmem => hx (doubletA_le am ap B hω ham hap hmem)

/-! ### Target (c): `BoundedBelow` -/

/-- **`A(p)` is bounded below whenever the ambient is.**  The ambient half-lattice
algebra is *not* positive (§4), so this — and not `positivity` — is the property that
survives the construction. -/
theorem doubletA_boundedBelow (am ap : 𝒱) (hW : W.BoundedBelow) :
    (doubletA W am ap).toSuperNearVOA.BoundedBelow :=
  subalgebra_boundedBelow _ hW

/-- `A(p)` inherits the ambient central charge. -/
@[simp] theorem doubletA_centralCharge (am ap : 𝒱) :
    (doubletA W am ap).toSuperNearVOA.centralCharge = W.centralCharge := rfl

/-! ## §3  Target (d): the even part `A(p)₀̄` as a bosonic VOA

`Core.SuperEvenPart.SuperNearVOA.evenPartVOA` takes its three CFT-type hypotheses
*restricted to the even part*, which is exactly the situation here: the ambient has negative
weights, `A(p)` may still have half-integer ones, and only `A(p)₀̄` is expected to be an
honest bosonic VOA.  All three hypotheses remain **obligations**. -/

/-- **The even part of `A(p)` as a bosonic vertex operator algebra**, given the three
even-part conditions:

* `hint` — the even part has integral weights.  By `LatGen.Doublet.doubletWt_four_mul` and
  `doubletWt_four_mul_add_two` this is the `p`-dependent condition: the generators have
  weight `(3p−2)/4`, an integer exactly for `p ≡ 2 mod 4` and a half-integer exactly for
  `4 ∣ p`, so `A(p)₀̄` can be integrally graded in both cases but for different reasons
  (in the `4 ∣ p` case only because the half-integer weights are odd and get discarded).
* `hvac` — the even weight-zero space is `ℂ𝟙`.
* `hpos` — the even part has no negative integer weights. -/
noncomputable def doubletAEvenVOA (am ap : 𝒱)
    (hint : ∀ h : ℂ, (¬ ∃ n : ℤ, (n : ℂ) = h) →
      ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
        x ∈ (doubletA W am ap).toSuperNearVOA.grading h → x = 0)
    (hvac : ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
      x ∈ (doubletA W am ap).toSuperNearVOA.grading 0 →
        ∃ c : ℂ, x = c • (doubletA W am ap).toSuperNearVOA.vacuum)
    (hpos : ∀ n : ℤ, n < 0 → ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
      x ∈ (doubletA W am ap).toSuperNearVOA.grading (n : ℂ) → x = 0) :
    VertexOperatorAlgebra ((doubletA W am ap).toSuperNearVOA.parity 0) :=
  (doubletA W am ap).toSuperNearVOA.evenPartVOA hint hvac hpos

/-- The even part carries the ambient central charge — the honest half of target (e). -/
@[simp] theorem doubletAEvenVOA_centralCharge (am ap : 𝒱)
    (hint : ∀ h : ℂ, (¬ ∃ n : ℤ, (n : ℂ) = h) →
      ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
        x ∈ (doubletA W am ap).toSuperNearVOA.grading h → x = 0)
    (hvac : ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
      x ∈ (doubletA W am ap).toSuperNearVOA.grading 0 →
        ∃ c : ℂ, x = c • (doubletA W am ap).toSuperNearVOA.vacuum)
    (hpos : ∀ n : ℤ, n < 0 → ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
      x ∈ (doubletA W am ap).toSuperNearVOA.grading (n : ℂ) → x = 0) :
    (doubletAEvenVOA am ap hint hvac hpos).centralCharge = W.centralCharge := rfl

/-- The even part of `A(p)` is bounded below whenever the ambient is. -/
theorem doubletAEven_boundedBelow (am ap : 𝒱) (hW : W.BoundedBelow) :
    (SuperVOASubalgebra.evenPart (doubletA W am ap).toSuperNearVOA).toSuperNearVOA.BoundedBelow :=
  SuperVOASubalgebra.evenPart_boundedBelow _ (doubletA_boundedBelow am ap hW)

/-! ## §4  The half-lattice ambient: the interface, and what follows from it

Everything above is ambient-agnostic.  This section fixes the ambient to be a super near-VOA
on the half-lattice module `LatModuleGen L` whose `L₀` is the background-charge-deformed
`BgB.LBG L lam 0`, and converts the *operator* statements of `Examples.DoubletGenerators`
into *grading* statements.  No such structure is constructed here — that is gap 1. -/

variable (L : IntegralLattice)

/-- **The interface the missing half-lattice construction must meet.**

A `DeformedAmbient L lam` is a super near-VOA on the half-lattice module whose Virasoro zero
mode is the `λ`-deformed one, `L₀ = L^λ₀`.  This single field is all that
`Examples.DoubletGenerators` needs in order to hand over its weight computations: those are
statements of the form `LBG L lam 0 v = h • v`, and `SuperNearVOA.mem_grading_of_L0_eq`
turns each of them into `v ∈ W.grading h`.

Constructing one is the open task (the `ℂ`-graded super lattice algebra on the half lattice
`½ℤγ`); the `p ≡ 2 mod 4` case is the genuinely *super* one, and `4 ∣ p` gives an even
lattice with half-integer weights instead — `LatGen.Doublet.form_gg_even_iff`. -/
structure DeformedAmbient (lam : Fin (rank L) → ℂ) where
  /-- The ambient super near-VOA on the half-lattice module. -/
  W : SuperNearVOA (LatModuleGen L)
  /-- Its Virasoro zero mode is the background-charge deformed one. -/
  L0_eq : W.L 0 = LBG L lam 0

variable {L}

/-- The lower doublet generator sits in the ambient weight space of weight `(3p−2)/4`. -/
theorem aMinus_mem_grading {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (hPos : L.PosDef) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    aMinus L g ∈ da.W.grading ((3 * (p : ℂ) - 2) / 4) :=
  da.W.mem_grading_of_L0_eq (by
    rw [da.L0_eq]; exact LBG_zero_aMinus L hPos lam g p hgg hlam)

/-- The upper doublet generator sits at the **same** weight `(3p−2)/4`. -/
theorem aPlus_mem_grading {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (hPos : L.PosDef) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    aPlus L g ∈ da.W.grading ((3 * (p : ℂ) - 2) / 4) :=
  da.W.mem_grading_of_L0_eq (by
    rw [da.L0_eq]; exact LBG_zero_aPlus L hPos lam g p hgg hlam)

/-- `e^{+γ/2}` sits at weight `(2−p)/4`. -/
theorem eG_mem_grading {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (hPos : L.PosDef) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    latChargeGen L g ∈ da.W.grading ((2 - (p : ℂ)) / 4) :=
  da.W.mem_grading_of_L0_eq (by
    rw [da.L0_eq]; exact LBG_zero_eG L hPos lam g p hgg hlam)

/-- `e^{+γ/2} ≠ 0`: it is a pure charge state of the half lattice. -/
theorem eG_ne_zero (g : L.carrier) : latChargeGen L g ≠ 0 := by
  have h := Screen.Fscr_ne_zero L (-g)
  have he : Screen.Fscr L (-g) = latChargeGen L g := by
    change latChargeGen L (- -g) = latChargeGen L g
    rw [neg_neg]
  rwa [he] at h

/-- The real part of the `e^{+γ/2}` weight. -/
theorem eG_weight_re (p : ℕ) : (((2 - (p : ℂ)) / 4)).re = (2 - (p : ℝ)) / 4 := by
  have h : ((2 : ℂ) - (p : ℂ)) / 4 = (((2 - (p : ℝ)) / 4 : ℝ) : ℂ) := by
    push_cast
    ring
  rw [h, Complex.ofReal_re]

/-- The weight-`(2−p)/4` space of the ambient is **non-zero**. -/
theorem ambient_grading_ne_bot {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (hPos : L.PosDef) (g : L.carrier) (p : ℕ)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    da.W.grading ((2 - (p : ℂ)) / 4) ≠ ⊥ := by
  intro h
  exact eG_ne_zero g
    ((Submodule.eq_bot_iff _).mp h _ (eG_mem_grading da hPos g p hgg hlam))

/-- **The ambient genuinely fails positivity for `p > 2`.**

This is the theorem behind the whole design: `e^{+γ/2}` is a non-zero ambient state of
conformal weight `(2−p)/4 < 0` (`−1/2` at `p = 4`, `−1` at `p = 6`).  Hence the ambient
cannot be upgraded by `SuperNearVOA.toSVOA`, positivity cannot be inherited by `A(p)`, and
`BoundedBelow` (`subalgebra_boundedBelow`) is the correct property to transport. -/
theorem ambient_not_positivity {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (hPos : L.PosDef) (g : L.carrier) (p : ℕ) (hp : 2 < p)
    (hgg : 2 * L.form g g = (p : ℤ)) (hlam : bgPair L lam g = ((p : ℂ) - 1) / 2) :
    ¬ (∀ h : ℂ, h.re < 0 → da.W.grading h = ⊥) := by
  intro hcon
  refine ambient_grading_ne_bot da hPos g p hgg hlam (hcon _ ?_)
  rw [eG_weight_re]
  exact eG_weight_neg p hp

/-- The doublet algebra `A(p)` inside a deformed half-lattice ambient. -/
noncomputable def doubletAp {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam) (g : L.carrier) :
    SuperVOASubalgebra da.W :=
  doubletA da.W (aMinus L g) (aPlus L g)

/-- `a⁻ ∈ A(p)`. -/
theorem aMinus_mem_doubletAp {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (g : L.carrier) : aMinus L g ∈ (doubletAp da g).carrier :=
  aMinus_mem_doubletA _ _

/-- `a⁺ ∈ A(p)`. -/
theorem aPlus_mem_doubletAp {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (g : L.carrier) : aPlus L g ∈ (doubletAp da g).carrier :=
  aPlus_mem_doubletA _ _

/-- `ω ∈ A(p)`. -/
theorem conformalVector_mem_doubletAp {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (g : L.carrier) : da.W.conformalVector ∈ (doubletAp da g).carrier :=
  conformalVector_mem_doubletA _ _

/-- `𝟙 ∈ A(p)`. -/
theorem vacuum_mem_doubletAp {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (g : L.carrier) : da.W.vacuum ∈ (doubletAp da g).carrier :=
  vacuum_mem_doubletA _ _

/-- Target (b), concretely: `A(p)` is non-trivial, because `a⁻ = e^{−γ/2} ≠ 0`. -/
theorem doubletAp_carrier_ne_bot {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (g : L.carrier) : (doubletAp da g).carrier ≠ ⊥ :=
  doubletA_carrier_ne_bot _ (aMinus_ne_zero L g)

/-- Target (b), concretely: `a⁺ ≠ 0` (this is `LatGen.Doublet.aPlus_ne_zero`, whose proof
runs through the vector Schur polynomial `S_{p−1}(γ)`). -/
theorem aPlus_ne_zero_doubletAp (hPos : L.PosDef) (g : L.carrier) (p : ℕ) (hp : 1 ≤ p)
    (hgg : 2 * L.form g g = (p : ℤ)) : aPlus L g ≠ 0 :=
  aPlus_ne_zero L hPos g p hp hgg

/-- Target (b), concretely: `𝟙 ≠ 0` in the half-lattice ambient. -/
theorem vacuum_ne_zero_doubletAp {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (g : L.carrier) : da.W.vacuum ≠ 0 :=
  vacuum_ne_zero da.W (aMinus_ne_zero L g)

/-- Target (b), concretely: `ω ≠ 0`, given `c ≠ 0`.  For `A(p)` the central charge is
`1 − 6(p−1)²/p`, which vanishes for no natural `p ≥ 1`. -/
theorem conformalVector_ne_zero_doubletAp {lam : Fin (rank L) → ℂ}
    (da : DeformedAmbient L lam) (g : L.carrier) (hc : da.W.centralCharge ≠ 0) :
    da.W.conformalVector ≠ 0 :=
  conformalVector_ne_zero da.W (aMinus_ne_zero L g) hc

/-- Target (c) in the concrete setting: `A(p)` is bounded below whenever the deformed
half-lattice ambient is — even though that ambient is **not** positive
(`ambient_not_positivity`). -/
theorem doubletAp_boundedBelow {lam : Fin (rank L) → ℂ} (da : DeformedAmbient L lam)
    (g : L.carrier) (hW : da.W.BoundedBelow) :
    (doubletAp da g).toSuperNearVOA.BoundedBelow :=
  doubletA_boundedBelow _ _ hW

/-- The exclusion of the offending negative-weight state, reduced to one intermediate
subalgebra.  This is the precise form of the unproved bonus in target (c). -/
theorem eG_not_mem_doubletAp_of_subalgebra {lam : Fin (rank L) → ℂ}
    (da : DeformedAmbient L lam) (g : L.carrier) (B : SuperVOASubalgebra da.W)
    (hω : da.W.conformalVector ∈ B.carrier) (ham : aMinus L g ∈ B.carrier)
    (hap : aPlus L g ∈ B.carrier) (hx : latChargeGen L g ∉ B.carrier) :
    latChargeGen L g ∉ (doubletAp da g).carrier :=
  not_mem_doubletA_of_subalgebra _ _ B hω ham hap hx

/-! ## §5  Target (e): the central charge of `A(p)` matches `W(p)`

`A(p)` and its even part carry whatever central charge the ambient does.  The expected value
is the triplet's, `c = 1 − 6(p−1)²/p`.  Matching central charges is the honest check; an
isomorphism `A(p)₀̄ ≅ W(p)` is a research problem and is **not** attempted. -/

/-- The central charge of the `(1,p)` models. -/
noncomputable def centralChargeAp (p : ℕ) : ℂ := 1 - 6 * ((p : ℂ) - 1) ^ 2 / (p : ℂ)

/-- `A(p)` and `W(p)` carry the same central charge, `1 − 6(p−1)²/p`. -/
theorem centralChargeAp_eq_tripletW (p : ℕ) (hp : 1 ≤ p) :
    centralChargeAp p = (Wp.tripletWVOA p hp).centralCharge := rfl

/-- At `p = 2` the value is `c = −2`, the symplectic-fermion central charge. -/
theorem centralChargeAp_two : centralChargeAp 2 = -2 := by
  rw [centralChargeAp]
  norm_num

/-- If the ambient has the `(1,p)` central charge, so does `A(p)`. -/
theorem doubletA_centralCharge_eq {W : SuperNearVOA 𝒱} (am ap : 𝒱) (p : ℕ)
    (hW : W.centralCharge = centralChargeAp p) :
    (doubletA W am ap).toSuperNearVOA.centralCharge = centralChargeAp p := hW

/-- …and so does its even part, which is the algebra expected to be `W(p)`.  **This is the
whole of target (e) that is honest**: the central charges agree.  An isomorphism
`A(p)₀̄ ≅ W(p)` is a research problem and is not attempted anywhere in this file. -/
theorem doubletAEvenVOA_centralCharge_eq {W : SuperNearVOA 𝒱} (am ap : 𝒱) (p : ℕ) (hp : 1 ≤ p)
    (hW : W.centralCharge = centralChargeAp p)
    (hint : ∀ h : ℂ, (¬ ∃ n : ℤ, (n : ℂ) = h) →
      ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
        x ∈ (doubletA W am ap).toSuperNearVOA.grading h → x = 0)
    (hvac : ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
      x ∈ (doubletA W am ap).toSuperNearVOA.grading 0 →
        ∃ c : ℂ, x = c • (doubletA W am ap).toSuperNearVOA.vacuum)
    (hpos : ∀ n : ℤ, n < 0 → ∀ x ∈ (doubletA W am ap).toSuperNearVOA.parity 0,
      x ∈ (doubletA W am ap).toSuperNearVOA.grading (n : ℂ) → x = 0) :
    (doubletAEvenVOA am ap hint hvac hpos).centralCharge
      = (Wp.tripletWVOA p hp).centralCharge := by
  rw [doubletAEvenVOA_centralCharge, hW]
  exact centralChargeAp_eq_tripletW p hp

end VOA.DoubletAp
