import VOA.Examples.VirasoroFockConjugation
import VOA.Examples.VirasoroSimple
import VOA.Core.RealStructure

/-!
# The canonical real structure on real Virasoro VOAs

The partition-basis conjugation constructed through the Feigin--Fuchs embedding commutes with
every Virasoro mode at a real background charge.  Since the universal Virasoro VOA is strongly
generated by its conformal vector, this mode calculation propagates through derivatives and
normal-ordered products to the full state--field map.
-/

set_option linter.style.longLine false

namespace VOA

open Module (End)
open VOA.VirModule VOA.VirSimple
open VOA.VertexOperatorAlgebra

/-- The zero formal distribution has zero at every mode index. This lets
coefficientwise conjugation arguments reduce immediately to the zero state. -/
@[simp] theorem virReal_dist_zero_apply {V : Type*} [AddCommGroup V] (j : ℤ) :
    (0 : FormalDist V) j = 0 := rfl

/-- Addition of formal distributions is coefficientwise. Checking conjugation
on a sum therefore reduces to checking its two summands. -/
@[simp] theorem virReal_dist_add_apply {V : Type*} [AddCommGroup V]
    (a b : FormalDist V) (j : ℤ) : (a + b) j = a j + b j := rfl

/-- Scaling a formal distribution scales each mode by the same complex
number. Conjugation will conjugate that scalar because it is semilinear. -/
@[simp] theorem virReal_dist_smul_apply {V : Type*} [AddCommGroup V] [Module ℂ V]
    (r : ℂ) (a : FormalDist V) (j : ℤ) : (r • a) j = r • a j := rfl

/-! ## Universal mode and word covariance -/

/-- The vacuum is the empty partition word, with real coefficient one,
so partition-basis conjugation fixes it at every central charge. -/
@[simp] theorem virBasisConj_vacuum (c : ℂ) : virBasisConj c (vacVec c) = vacVec c := by
  have hempty : SortedWord ([] : List ℕ) := sortedWord_nil
  simpa only [negWordVir_nil] using
    virBasisConj_sorted c (⟨[], hempty⟩ : {w : List ℕ // SortedWord w})

/-- At a real background charge, conjugation commutes with each creation
mode. Starting from the fixed vacuum therefore fixes every creation word,
including words that have not been sorted into the partition basis. -/
theorem virBasisConj_negWord {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) (ws : List ℕ) :
    virBasisConj c (negWordVir c ws) = negWordVir c ws := by
  induction ws with
  | nil => exact virBasisConj_vacuum c
  | cons i ws ih =>
      rw [negWordVir_cons, virBasisConj_Lop hlam hreal, ih]

/-- The conformal vector is the single L-minus-two creation word. It is
therefore fixed by the same conjugation that fixes the vacuum. -/
@[simp] theorem virBasisConj_omega {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) : virBasisConj c (omegaVir c) = omegaVir c := by
  exact virBasisConj_negWord hlam hreal [0]

/-- A distribution is coefficientwise equivariant for partition-basis conjugation. -/
def VirConjCov (c : ℂ) (a : FormalDist (End ℂ (VirUniv c))) : Prop :=
  ∀ (j : ℤ) (v : VirUniv c), virBasisConj c (a j v) = a j (virBasisConj c v)

/-- A conjugation-equivariant field remains equivariant after multiplication
by a real scalar. The scalar must be fixed by complex conjugation. -/
theorem VirConjCov.smul_fixed {c : ℂ} {a : FormalDist (End ℂ (VirUniv c))}
    (ha : VirConjCov c a) {r : ℂ} (hr : (starRingEnd ℂ) r = r) :
    VirConjCov c (r • a) := by
  intro j v
  change virBasisConj c (r • a j v) = r • a j (virBasisConj c v)
  rw [map_smulₛₗ, hr, ha]

/-- Formal differentiation shifts mode indices and multiplies by integers.
These real coefficients commute with conjugation, preserving covariance. -/
theorem VirConjCov.deriv {c : ℂ} {a : FormalDist (End ℂ (VirUniv c))}
    (ha : VirConjCov c a) : VirConjCov c (VOA.deriv a) := by
  intro j v
  rw [deriv_apply]
  change virBasisConj c ((j + 1) • a (j + 1) v) =
    (j + 1) • a (j + 1) (virBasisConj c v)
  rw [map_zsmul, ha]

/-- Repeating formal differentiation preserves conjugation covariance
at every order, by applying the one-derivative result inductively. -/
theorem VirConjCov.deriv_iterate {c : ℂ} {a : FormalDist (End ℂ (VirUniv c))}
    (ha : VirConjCov c a) : ∀ i : ℕ, VirConjCov c (VOA.deriv^[i] a)
  | 0 => ha
  | i + 1 => by
      rw [Function.iterate_succ_apply']
      exact (ha.deriv_iterate i).deriv

/-- Normal ordering preserves conjugation covariance. Each summand is an
ordered composition of covariant modes, and field truncation makes its
action on a fixed state a finite sum that conjugation can pass through. -/
theorem VirConjCov.nprod {c : ℂ} {a b : FormalDist (End ℂ (VirUniv c))}
    (haF : IsField a) (hbF : IsField b) (ha : VirConjCov c a) (hb : VirConjCov c b) :
    VirConjCov c (nprod haF hbF) := by
  intro s v
  rw [nprod_apply, nprod_apply]
  change virBasisConj c (∑ᶠ m : ℤ, normalOrdered a b m (s - m) v) =
    ∑ᶠ m : ℤ, normalOrdered a b m (s - m) (virBasisConj c v)
  rw [map_finsum (virBasisConj c)
    (normalOrdered_diag_support_finite haF hbF s v)]
  exact finsum_congr fun m => by
    rw [normalOrdered_apply]
    split_ifs with hm
    · rw [Module.End.mul_apply, Module.End.mul_apply, ha, hb]
    · rw [Module.End.mul_apply, Module.End.mul_apply, hb, ha]

/-- The conformal field is conjugation-equivariant because all its modes
are the Virasoro operators whose covariance is already proved. -/
theorem virConjCov_Yomega {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) : VirConjCov c (YomegaVir c) := by
  intro j v
  rw [YomegaVir_apply, virBasisConj_Lop hlam hreal]

/-- Each generating field is a divided derivative of the conformal field.
Derivative covariance and the real inverse-factorial coefficient give
conjugation covariance for every such generator. -/
theorem virConjCov_genField {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) (i : ℕ) : VirConjCov c (genFieldVir c i) := by
  rw [genFieldVir]
  apply VirConjCov.smul_fixed ((virConjCov_Yomega hlam hreal).deriv_iterate i)
  simp only [map_inv₀, map_natCast]

/-- The vacuum field has only the identity mode and zero modes. Both
commute with conjugation, so the field is covariant at every index. -/
theorem virConjCov_idField (c : ℂ) : VirConjCov c (idFieldVir c) := by
  intro j v
  rw [idFieldVir]
  split_ifs
  · rfl
  · rw [LinearMap.zero_apply, LinearMap.zero_apply, map_zero]

/-- A creation-word field is built from generating fields by repeated
normal ordering. Their covariance therefore propagates to every word field. -/
theorem virConjCov_Yword {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) : ∀ ws : List ℕ, VirConjCov c (YwordVir c ws)
  | [] => by rw [YwordVir_nil]; exact virConjCov_idField c
  | i :: ws => by
      rw [YwordVir_cons]
      exact VirConjCov.nprod _ _ (virConjCov_genField hlam hreal i)
        (virConjCov_Yword hlam hreal ws)

/-- Full conjugation covariance of the universal Virasoro state--field map. -/
theorem virBasisConj_virYA {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) (u : VirUniv c) (j : ℤ) (v : VirUniv c) :
    virBasisConj c (virYA c u j v) = virYA c (virBasisConj c u) j (virBasisConj c v) := by
  have hu : u ∈ negSpanVir c := by rw [negSpanVir_eq_top c]; trivial
  induction hu using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨ws, rfl⟩ := hx
      rw [virBasisConj_negWord hlam hreal, virYA_word]
      exact virConjCov_Yword hlam hreal ws j v
  | zero =>
      simp only [(virYA c).map_zero, (virBasisConj c).map_zero,
        virReal_dist_zero_apply, LinearMap.zero_apply]
  | add x y _ _ hx hy =>
      simp only [(virYA c).map_add, (virBasisConj c).map_add,
        virReal_dist_add_apply, LinearMap.add_apply]
      exact congrArg₂ (fun a b => a + b) hx hy
  | smul r x _ hx =>
      simp only [(virYA c).map_smul, (virBasisConj c).map_smulₛₗ,
        virReal_dist_smul_apply, LinearMap.smul_apply]
      exact congrArg (fun y => (starRingEnd ℂ) r • y) hx

/-- The universal partition-basis conjugation preserves every VOA mode product. -/
theorem virBasisConj_smul {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) (u : VirUniv c) (n : ℤ) (v : VirUniv c) :
    virBasisConj c ((virasoroVOA c).smul u n v) =
      (virasoroVOA c).smul (virBasisConj c u) n (virBasisConj c v) := by
  exact virBasisConj_virYA hlam hreal u (-n - 1) v

/-- The canonical real structure on the universal Virasoro VOA, presented at a real
Feigin--Fuchs background charge. -/
noncomputable def virasoroUniversalRealStructure {c lam : ℂ}
    (hlam : 1 - 12 * lam ^ 2 = c) (hreal : (starRingEnd ℂ) lam = lam) :
    RealStructure (virasoroVOA c) where
  rho := (virBasisConj c).toAddMonoidHom
  antilinear := (virBasisConj c).map_smulₛₗ
  map_smul := virBasisConj_smul hlam hreal
  map_vacuum := virBasisConj_vacuum c
  map_omega := virBasisConj_omega hlam hreal
  parity := fun _ => 1
  sq := by
    intro h v hv
    change virBasisConj c (virBasisConj c v) = 1 • v
    rw [virBasisConj_sq, one_smul]

/-! ## Descent through the maximal ideal -/

/-- The inverse image of a VOA ideal under the universal conjugation is again an ideal. -/
theorem virBasisConj_comap_isIdeal {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) {I : Submodule ℂ (VirUniv c)}
    (hI : (virasoroVOA c).IsIdeal I) :
    (virasoroVOA c).IsIdeal (I.comap (virBasisConj c)) := by
  intro u v n hv
  change virBasisConj c ((virasoroVOA c).smul u n v) ∈ I
  rw [virBasisConj_smul hlam hreal]
  exact hI (virBasisConj c u) (virBasisConj c v) n hv

/-- The maximal proper Virasoro ideal is stable under the canonical conjugation. -/
theorem virBasisConj_maxIdeal_stable {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) :
    maxIdealVir c ≤ (maxIdealVir c).comap (virBasisConj c) := by
  have hproper : vacVec c ∉ (maxIdealVir c).comap (virBasisConj c) := by
    intro hv
    change virBasisConj c (vacVec c) ∈ maxIdealVir c at hv
    rw [virBasisConj_vacuum c] at hv
    exact vacVec_not_mem_maxIdealVir c hv
  have hle : (maxIdealVir c).comap (virBasisConj c) ≤ maxIdealVir c :=
    le_maxIdealVir c (virBasisConj_comap_isIdeal hlam hreal (maxIdealVir_isIdeal c)) hproper
  intro x hx
  have hrx : virBasisConj c x ∈ (maxIdealVir c).comap (virBasisConj c) := by
    change virBasisConj c (virBasisConj c x) ∈ maxIdealVir c
    simpa only [virBasisConj_sq] using hx
  exact hle hrx

/-- The descended semilinear conjugation on the simple Virasoro quotient. -/
noncomputable def virasoroSimpleConj {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) :
    (VirUniv c ⧸ maxIdealVir c) →ₛₗ[starRingEnd ℂ] (VirUniv c ⧸ maxIdealVir c) :=
  (maxIdealVir c).mapQ (maxIdealVir c) (virBasisConj c)
    (virBasisConj_maxIdeal_stable hlam hreal)

/-- Conjugating a class in the simple quotient is computed by conjugating
any representative first. Stability of the maximal ideal makes this
independent of the representative. -/
@[simp] theorem virasoroSimpleConj_mkQ {c lam : ℂ} (hlam : 1 - 12 * lam ^ 2 = c)
    (hreal : (starRingEnd ℂ) lam = lam) (v : VirUniv c) :
    virasoroSimpleConj hlam hreal ((maxIdealVir c).mkQ v) =
      (maxIdealVir c).mkQ (virBasisConj c v) := rfl

/-- The canonical real structure on the simple Virasoro VOA at a real background charge. -/
noncomputable def virasoroSimpleRealStructure {c lam : ℂ}
    (hlam : 1 - 12 * lam ^ 2 = c) (hreal : (starRingEnd ℂ) lam = lam) :
    RealStructure (virasoroSimple c) where
  rho := (virasoroSimpleConj hlam hreal).toAddMonoidHom
  antilinear := (virasoroSimpleConj hlam hreal).map_smulₛₗ
  map_smul := by
    intro u n v
    obtain ⟨u, rfl⟩ := (maxIdealVir c).mkQ_surjective u
    obtain ⟨v, rfl⟩ := (maxIdealVir c).mkQ_surjective v
    change virasoroSimpleConj hlam hreal
        ((maxIdealVir c).mkQ ((virasoroVOA c).smul u n v)) =
      (virasoroSimple c).smul
        (virasoroSimpleConj hlam hreal ((maxIdealVir c).mkQ u)) n
        (virasoroSimpleConj hlam hreal ((maxIdealVir c).mkQ v))
    rw [virasoroSimpleConj_mkQ, virBasisConj_smul hlam hreal,
      virasoroSimpleConj_mkQ, virasoroSimpleConj_mkQ,
      virasoroSimple_mkQ_smul]
  map_vacuum := by
    change virasoroSimpleConj hlam hreal (virasoroSimple c).vacuum =
      (virasoroSimple c).vacuum
    rw [virasoroSimple_vacuum, virasoroSimpleConj_mkQ, virBasisConj_vacuum]
  map_omega := by
    change virasoroSimpleConj hlam hreal (virasoroSimple c).conformalVector =
      (virasoroSimple c).conformalVector
    rw [virasoroSimple_conformalVector, virasoroSimpleConj_mkQ,
      virBasisConj_omega hlam hreal]
  parity := fun _ => 1
  sq := by
    intro h v hv
    obtain ⟨v, rfl⟩ := (maxIdealVir c).mkQ_surjective v
    change virasoroSimpleConj hlam hreal
        (virasoroSimpleConj hlam hreal ((maxIdealVir c).mkQ v)) =
      1 • (maxIdealVir c).mkQ v
    rw [virasoroSimpleConj_mkQ, virasoroSimpleConj_mkQ, virBasisConj_sq, one_smul]

end VOA
