import VOA.Examples.InverseDSLeeYangPBWClosure

/-!
# The character criterion missing from the inverse-DS Lee--Yang PBW closure

This leaf does not assume a Lee--Yang character formula or a maximal-submodule theorem.  It
formalizes the finite-dimensional graded argument which would turn either of those inputs into
the required equality of submodules.

The criterion is deliberately stated first for an arbitrary internally graded vector space.  If
`P ⊆ Q`, `Q` is the sum of its homogeneous intersections, and the two intersections have the
same dimension in every grade, then `P = Q`.  An equivalent quotient-character version compares
the images of each ambient grade in `V/P` and `V/Q`.

For the charged Lee--Yang Fock carrier the ambient grades and their finite-dimensionality already
exist: they are `HeisenbergN.gradingZN 1`.  Thus the remaining representation-theoretic input is
isolated exactly as a graded containing submodule `Q`, together with equality of the quotient
characters.  The repository currently has neither a general Virasoro Verma module at highest
weight `-1/5` nor a theorem identifying such a `Q` (for example the radical of a contravariant
form) with the maximal null submodule.  No literature statement is installed as an axiom or a
structure field here.
-/

set_option linter.style.longLine false

namespace VOA
namespace InverseDS
namespace LeeYangMaximalSubmodule

open Module (End finrank)
open ScreeningLowering
open LeeYangFockExponential LeeYangFockVirasoro LeeYangFullFockWard
open LeeYangConcreteDescent LeeYangTargetNull LeeYangBPZ LeeYangPBWClosure

noncomputable section

/-! ## A generic grade-by-grade equality criterion -/

section GradedLinearAlgebra

variable {K V ι : Type*} [DivisionRing K] [AddCommGroup V] [Module K V]

/-- A submodule is homogeneous for a family of ambient pieces when it is the supremum of its
intersections with those pieces.  Independence of the ambient pieces is not needed for the
dimension-comparison argument. -/
def IsGradedBy (grade : ι → Submodule K V) (P : Submodule K V) : Prop :=
  P = ⨆ i, P ⊓ grade i

/-- Grade-by-grade equality of finite-dimensional intersections forces equality of submodules.

Only the larger submodule has to be known graded.  In particular, proving gradedness of a
candidate generated by explicit homogeneous vectors is not an additional prerequisite for using
the criterion. -/
theorem submodule_eq_of_le_of_isGradedBy_of_finrank_eq
    (grade : ι → Submodule K V) (P Q : Submodule K V)
    (hPQ : P ≤ Q) (hQ : IsGradedBy grade Q)
    (hfinite : ∀ i, FiniteDimensional K ↑(Q ⊓ grade i))
    (hrank : ∀ i, finrank K ↑(P ⊓ grade i) = finrank K ↑(Q ⊓ grade i)) :
    P = Q := by
  apply le_antisymm hPQ
  rw [hQ]
  refine iSup_le fun i => ?_
  letI : FiniteDimensional K ↑(Q ⊓ grade i) := hfinite i
  have hle : P ⊓ grade i ≤ Q ⊓ grade i := inf_le_inf_right _ hPQ
  have heq : P ⊓ grade i = Q ⊓ grade i :=
    Submodule.eq_of_le_of_finrank_eq hle (hrank i)
  rw [← heq]
  exact inf_le_left

/-- Local version: equality of the two intersections at one finite grade transfers membership of
a homogeneous vector from the larger submodule to the smaller one. -/
theorem mem_of_le_of_mem_grade_of_finrank_inf_eq
    (grade : Submodule K V) (P Q : Submodule K V) (hPQ : P ≤ Q)
    [FiniteDimensional K ↑(Q ⊓ grade)]
    (hrank : finrank K ↑(P ⊓ grade) = finrank K ↑(Q ⊓ grade))
    {x : V} (hxQ : x ∈ Q) (hxgrade : x ∈ grade) : x ∈ P := by
  have hle : P ⊓ grade ≤ Q ⊓ grade := inf_le_inf_right _ hPQ
  have heq : P ⊓ grade = Q ⊓ grade :=
    Submodule.eq_of_le_of_finrank_eq hle hrank
  have hx : x ∈ Q ⊓ grade := ⟨hxQ, hxgrade⟩
  rw [← heq] at hx
  exact hx.1

/-- The quotient map restricted to one ambient grade. -/
def quotientGradeMap (grade : Submodule K V) (P : Submodule K V) :
    grade →ₗ[K] (V ⧸ P) :=
  P.mkQ.domRestrict grade

theorem quotientGradeMap_range (grade : Submodule K V) (P : Submodule K V) :
    LinearMap.range (quotientGradeMap grade P) = grade.map P.mkQ := by
  rw [quotientGradeMap, LinearMap.range_domRestrict]

theorem quotientGradeMap_ker_map_subtype (grade : Submodule K V) (P : Submodule K V) :
    (LinearMap.ker (quotientGradeMap grade P)).map grade.subtype = P ⊓ grade := by
  rw [quotientGradeMap, LinearMap.ker_domRestrict, Submodule.ker_mkQ,
    Submodule.map_comap_subtype, inf_comm]

theorem finrank_quotientGradeMap_ker (grade : Submodule K V) (P : Submodule K V) :
    finrank K (LinearMap.ker (quotientGradeMap grade P)) = finrank K ↑(P ⊓ grade) := by
  rw [← quotientGradeMap_ker_map_subtype grade P]
  exact LinearEquiv.finrank_eq
    (Submodule.equivMapOfInjective grade.subtype (Submodule.subtype_injective _) _)

/-- Rank-nullity on one ambient grade, in the form used by character comparisons. -/
theorem finrank_quotientGrade_add_finrank_inf (grade : Submodule K V)
    (P : Submodule K V) [FiniteDimensional K grade] :
    finrank K (grade.map P.mkQ) + finrank K ↑(P ⊓ grade) = finrank K grade := by
  have h := LinearMap.finrank_range_add_finrank_ker (quotientGradeMap grade P)
  rwa [quotientGradeMap_range, finrank_quotientGradeMap_ker] at h

/-- Equality of the quotient characters is equivalent to equality of the dimensions removed in
each finite-dimensional ambient grade. -/
theorem finrank_inf_eq_of_quotientGrade_finrank_eq (grade : Submodule K V)
    (P Q : Submodule K V) [FiniteDimensional K grade]
    (hquot : finrank K (grade.map P.mkQ) = finrank K (grade.map Q.mkQ)) :
    finrank K ↑(P ⊓ grade) = finrank K ↑(Q ⊓ grade) := by
  have hP := finrank_quotientGrade_add_finrank_inf grade P
  have hQ := finrank_quotientGrade_add_finrank_inf grade Q
  omega

/-- Local quotient-character form of `mem_of_le_of_mem_grade_of_finrank_inf_eq`. -/
theorem mem_of_le_of_mem_grade_of_quotientGrade_finrank_eq
    (grade : Submodule K V) (P Q : Submodule K V) (hPQ : P ≤ Q)
    [FiniteDimensional K grade]
    (hquot : finrank K (grade.map P.mkQ) = finrank K (grade.map Q.mkQ))
    {x : V} (hxQ : x ∈ Q) (hxgrade : x ∈ grade) : x ∈ P := by
  letI : FiniteDimensional K ↑(Q ⊓ grade) :=
    FiniteDimensional.of_injective
      (Submodule.inclusion inf_le_right) (Submodule.inclusion_injective _)
  exact mem_of_le_of_mem_grade_of_finrank_inf_eq grade P Q hPQ
    (finrank_inf_eq_of_quotientGrade_finrank_eq grade P Q hquot) hxQ hxgrade

/-- The character-equality version of the graded submodule criterion. -/
theorem submodule_eq_of_le_of_isGradedBy_of_quotientCharacter
    (grade : ι → Submodule K V) (P Q : Submodule K V)
    (hPQ : P ≤ Q) (hQ : IsGradedBy grade Q)
    (hfinite : ∀ i, FiniteDimensional K (grade i))
    (hchar : ∀ i, finrank K ((grade i).map P.mkQ) =
      finrank K ((grade i).map Q.mkQ)) :
    P = Q := by
  apply submodule_eq_of_le_of_isGradedBy_of_finrank_eq grade P Q hPQ hQ
  · intro i
    letI : FiniteDimensional K (grade i) := hfinite i
    exact FiniteDimensional.of_injective
      (Submodule.inclusion inf_le_right) (Submodule.inclusion_injective _)
  · intro i
    letI : FiniteDimensional K (grade i) := hfinite i
    exact finrank_inf_eq_of_quotientGrade_finrank_eq (grade i) P Q (hchar i)

end GradedLinearAlgebra

/-! ## Specialization to the charged Lee--Yang Fock carrier -/

/-- The oscillator-energy grading on the charged Fock carrier.  The charge shifts the Virasoro
`L₀` eigenvalue by `-1/5`, but it does not change these finite-dimensional underlying pieces. -/
def k85TargetLevel (d : ℤ) : Submodule ℂ LeeYangFock :=
  HeisenbergN.gradingZN 1 d

theorem k85TargetLevel_finiteDimensional (d : ℤ) :
    FiniteDimensional ℂ (k85TargetLevel d) :=
  HeisenbergN.gradingZN_finrank 1 d

/-- A target submodule is graded when it is the sum of its oscillator-energy intersections. -/
def IsK85TargetGraded (Q : Submodule ℂ LeeYangFock) : Prop :=
  IsGradedBy k85TargetLevel Q

theorem alphaMode_mem_k85TargetLevel (m d : ℤ) {x : LeeYangFock}
    (hx : x ∈ k85TargetLevel d) :
    alphaMode m x ∈ k85TargetLevel (d - m) := by
  rcases lt_or_ge d 0 with hd | hd
  · rw [k85TargetLevel, HeisenbergN.gradingZN_of_neg hd, Submodule.mem_bot] at hx
    rw [hx, map_zero]
    exact Submodule.zero_mem _
  · rw [k85TargetLevel, HeisenbergN.gradingZN_of_nonneg hd] at hx
    have h := HeisenbergN.oscN_mem_gradingZN 1 2 0 m hx
    rw [Int.toNat_of_nonneg hd] at h
    exact h

theorem LvirN_mem_k85TargetLevel (m d : ℤ) {x : LeeYangFock}
    (hx : x ∈ k85TargetLevel d) :
    HeisenbergN.LvirN 1 2 m x ∈ k85TargetLevel (d - m) := by
  rw [HeisenbergN.LvirN_eq_mode_YN_omega]
  have h := (HeisenbergN.heisVAN 1 2 (by norm_num : (2 : ℂ) ≠ 0)).smul_mem_grading
    (HeisenbergN.ωN_mem_gradingZN_two 1 2) hx (m + 1)
  change mode (HeisenbergN.YN 1 2 (HeisenbergN.ωN 1 2)) (m + 1) x ∈
    HeisenbergN.gradingZN 1 (2 + d - (m + 1) - 1) at h
  rw [show 2 + d - (m + 1) - 1 = d - m by ring] at h
  exact h

theorem sectorCurrent_mem_k85TargetLevel (p : ℂ) (m d : ℤ) {x : LeeYangFock}
    (hx : x ∈ k85TargetLevel d) :
    sectorCurrent p m x ∈ k85TargetLevel (d - m) := by
  by_cases hm : m = 0
  · subst m
    rw [sectorCurrent, if_pos rfl, LinearMap.add_apply, LinearMap.smul_apply,
      Module.End.one_apply, sub_zero]
    exact Submodule.add_mem _ (by simpa using alphaMode_mem_k85TargetLevel 0 d hx)
      (Submodule.smul_mem _ _ hx)
  · rw [sectorCurrent, if_neg hm, zero_smul, add_zero]
    exact alphaMode_mem_k85TargetLevel m d hx

theorem sectorSugawara_mem_k85TargetLevel (p : ℂ) (m d : ℤ) {x : LeeYangFock}
    (hx : x ∈ k85TargetLevel d) :
    sectorSugawara p m x ∈ k85TargetLevel (d - m) := by
  by_cases hm : m = 0
  · subst m
    simp only [sectorSugawara, LinearMap.add_apply, LinearMap.smul_apply, if_true,
      Module.End.one_apply, sub_zero]
    exact Submodule.add_mem _
      (Submodule.add_mem _ (by simpa using LvirN_mem_k85TargetLevel 0 d hx)
        (Submodule.smul_mem _ _ (by simpa using alphaMode_mem_k85TargetLevel 0 d hx)))
      (Submodule.smul_mem _ _ hx)
  · simp only [sectorSugawara, LinearMap.add_apply, LinearMap.smul_apply, if_neg hm,
      zero_smul, add_zero]
    exact Submodule.add_mem _ (LvirN_mem_k85TargetLevel m d hx)
      (Submodule.smul_mem _ _ (alphaMode_mem_k85TargetLevel m d hx))

theorem sectorVirasoro_mem_k85TargetLevel (ell p : ℂ) (m d : ℤ) {x : LeeYangFock}
    (hx : x ∈ k85TargetLevel d) :
    sectorVirasoro ell p m x ∈ k85TargetLevel (d - m) := by
  rw [sectorVirasoro, LinearMap.sub_apply, sectorBackgroundCurrent, LinearMap.smul_apply,
    LinearMap.smul_apply]
  exact Submodule.sub_mem _ (sectorSugawara_mem_k85TargetLevel p m d hx)
    (Submodule.smul_mem _ _ (Submodule.smul_mem _ _
      (sectorCurrent_mem_k85TargetLevel p m d hx)))

/-- The charged target Virasoro mode `L_m` shifts oscillator energy by `-m`. -/
theorem k85TargetL_mem_level (m d : ℤ) {x : LeeYangFock}
    (hx : x ∈ k85TargetLevel d) :
    k85TargetL m x ∈ k85TargetLevel (d - m) := by
  exact sectorVirasoro_mem_k85TargetLevel k85FockBackground k85FockCharge m d hx

theorem k85TargetTop_mem_level_zero : k85TargetTop ∈ k85TargetLevel 0 := by
  exact HeisenbergN.mem_gradingZN_of_gradingWN (HeisenbergN.vacuumN_mem_gradingWN 1)

theorem k85TargetNegOnePower_mem_level (n : ℕ) :
    k85TargetNegOnePower n ∈ k85TargetLevel (n : ℤ) := by
  induction n with
  | zero => exact k85TargetTop_mem_level_zero
  | succ n ih =>
      rw [k85TargetNegOnePower]
      simpa only [Nat.cast_add, Nat.cast_one, sub_neg_eq_add] using
        k85TargetL_mem_level (-1) (n : ℤ) ih

/-- Every cleared PBW numerator is homogeneous of oscillator energy `n+4`. -/
theorem k85PBWNumerator_mem_level (n : ℕ) :
    k85PBWNumerator n ∈ k85TargetLevel ((n : ℤ) + 4) := by
  rw [k85PBWNumerator]
  have hn := k85TargetNegOnePower_mem_level n
  have h22 := k85TargetL_mem_level (-2) ((n : ℤ) + 2)
    (k85TargetL_mem_level (-2) (n : ℤ) hn)
  have hn2 := k85TargetNegOnePower_mem_level (n + 2)
  have h2 := k85TargetL_mem_level (-2) ((n + 2 : ℕ) : ℤ) hn2
  have hn4 := k85TargetNegOnePower_mem_level (n + 4)
  have h4 := k85TargetL_mem_level (-4) (n : ℤ) hn
  push_cast at h22 h2 hn4 h4
  exact Submodule.add_mem _
    (Submodule.add_mem _
      (Submodule.add_mem _ (Submodule.smul_mem _ _ h22) (Submodule.smul_mem _ _ h2))
      (Submodule.smul_mem _ _ hn4))
    (Submodule.smul_mem _ _ h4)

theorem k85TargetSingularTwo_mem_level :
    k85TargetSingularTwo ∈ k85TargetLevel 2 := by
  rw [k85TargetSingularTwo]
  have h11 := k85TargetL_mem_level (-1) 1
    (k85TargetL_mem_level (-1) 0 k85TargetTop_mem_level_zero)
  have h2 := k85TargetL_mem_level (-2) 0 k85TargetTop_mem_level_zero
  norm_num at h11 h2
  exact Submodule.add_mem _ (Submodule.smul_mem _ _ h11) (Submodule.smul_mem _ _ h2)

theorem k85TargetSingularThree_mem_level :
    k85TargetSingularThree ∈ k85TargetLevel 3 := by
  rw [k85TargetSingularThree]
  have h111 := k85TargetL_mem_level (-1) 2
    (k85TargetL_mem_level (-1) 1
      (k85TargetL_mem_level (-1) 0 k85TargetTop_mem_level_zero))
  have h21 := k85TargetL_mem_level (-2) 1
    (k85TargetL_mem_level (-1) 0 k85TargetTop_mem_level_zero)
  have h3 := k85TargetL_mem_level (-3) 0 k85TargetTop_mem_level_zero
  norm_num at h111 h21 h3
  exact Submodule.add_mem _
    (Submodule.add_mem _ (Submodule.smul_mem _ _ h111) (Submodule.smul_mem _ _ h21))
    (Submodule.smul_mem _ _ h3)

/-- A word of charged Virasoro modes shifts oscillator energy by minus the sum of its indices. -/
theorem applyModeWord_k85TargetL_mem_level (w : List ℤ) (d : ℤ) {x : LeeYangFock}
    (hx : x ∈ k85TargetLevel d) :
    applyModeWord k85TargetL w x ∈ k85TargetLevel (d - w.sum) := by
  induction w generalizing d with
  | nil => simpa
  | cons m w ih =>
      simp only [applyModeWord_cons, List.sum_cons]
      have h := k85TargetL_mem_level m (d - w.sum) (ih d hx)
      rw [show d - w.sum - m = d - (m + w.sum) by omega] at h
      exact h

theorem k85TargetSingularTwo_mem_seed :
    k85TargetSingularTwo ∈ k85TargetCandidateSeed :=
  Submodule.subset_span (Set.mem_insert _ _)

theorem k85TargetSingularThree_mem_seed :
    k85TargetSingularThree ∈ k85TargetCandidateSeed :=
  Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The explicit two-singular mode closure is itself homogeneous for the finite Fock grading.
This follows directly from homogeneous seeds and the mode-shift theorem; no maximal-submodule or
character input is used. -/
theorem k85TargetCandidateNull_isK85TargetGraded :
    IsK85TargetGraded k85TargetCandidateNull := by
  apply le_antisymm
  · intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨w, y, hy, rfl⟩ := hx
        induction hy using Submodule.span_induction with
        | mem y hy =>
            simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
            rcases hy with rfl | rfl
            · apply Submodule.mem_iSup_of_mem (2 - w.sum)
              exact ⟨Submodule.subset_span ⟨w, k85TargetSingularTwo,
                  k85TargetSingularTwo_mem_seed, rfl⟩,
                applyModeWord_k85TargetL_mem_level w 2 k85TargetSingularTwo_mem_level⟩
            · apply Submodule.mem_iSup_of_mem (3 - w.sum)
              exact ⟨Submodule.subset_span ⟨w, k85TargetSingularThree,
                  k85TargetSingularThree_mem_seed, rfl⟩,
                applyModeWord_k85TargetL_mem_level w 3 k85TargetSingularThree_mem_level⟩
        | zero =>
            rw [map_zero]
            exact Submodule.zero_mem _
        | add a b _ _ ha hb =>
            rw [map_add]
            exact Submodule.add_mem _ ha hb
        | smul c a _ ha =>
            rw [map_smul]
            exact Submodule.smul_mem _ c ha
    | zero => exact Submodule.zero_mem _
    | add a b _ _ ha hb => exact Submodule.add_mem _ ha hb
    | smul c a _ ha => exact Submodule.smul_mem _ c ha
  · exact iSup_le fun _ => inf_le_left

/-- Exact finite-grade criterion for identifying the explicit two-singular mode closure with a
graded containing target submodule. -/
theorem k85TargetCandidateNull_eq_of_finrank
    (Q : Submodule ℂ LeeYangFock)
    (hCQ : k85TargetCandidateNull ≤ Q) (hQ : IsK85TargetGraded Q)
    (hrank : ∀ d : ℤ,
      finrank ℂ ↑(k85TargetCandidateNull ⊓ k85TargetLevel d) =
        finrank ℂ ↑(Q ⊓ k85TargetLevel d)) :
    k85TargetCandidateNull = Q := by
  apply submodule_eq_of_le_of_isGradedBy_of_finrank_eq
    k85TargetLevel k85TargetCandidateNull Q hCQ hQ
  · intro d
    letI : FiniteDimensional ℂ (k85TargetLevel d) :=
      k85TargetLevel_finiteDimensional d
    exact FiniteDimensional.of_injective
      (Submodule.inclusion inf_le_right) (Submodule.inclusion_injective _)
  · exact hrank

/-- Quotient-character criterion for identifying the explicit two-singular closure.  This is the
precise interface a Rocha--Caridi/Rogers--Ramanujan character computation would discharge once a
graded maximal null submodule `Q` has been constructed. -/
theorem k85TargetCandidateNull_eq_of_quotientCharacter
    (Q : Submodule ℂ LeeYangFock)
    (hCQ : k85TargetCandidateNull ≤ Q) (hQ : IsK85TargetGraded Q)
    (hchar : ∀ d : ℤ,
      finrank ℂ ((k85TargetLevel d).map k85TargetCandidateNull.mkQ) =
        finrank ℂ ((k85TargetLevel d).map Q.mkQ)) :
    k85TargetCandidateNull = Q := by
  exact submodule_eq_of_le_of_isGradedBy_of_quotientCharacter
    k85TargetLevel k85TargetCandidateNull Q hCQ hQ
      k85TargetLevel_finiteDimensional hchar

/-- One numerator needs character equality only in its own grade `n+4`; neither global
gradedness of `Q` nor equality in unrelated grades is required. -/
theorem k85PBWNumerator_mem_of_quotientLevel_finrank_eq (n : ℕ)
    (Q : Submodule ℂ LeeYangFock) (hCQ : k85TargetCandidateNull ≤ Q)
    (hnum : k85PBWNumerator n ∈ Q)
    (hchar :
      finrank ℂ ((k85TargetLevel ((n : ℤ) + 4)).map k85TargetCandidateNull.mkQ) =
        finrank ℂ ((k85TargetLevel ((n : ℤ) + 4)).map Q.mkQ)) :
    k85PBWNumerator n ∈ k85TargetCandidateNull := by
  letI : FiniteDimensional ℂ (k85TargetLevel ((n : ℤ) + 4)) :=
    k85TargetLevel_finiteDimensional _
  exact mem_of_le_of_mem_grade_of_quotientGrade_finrank_eq
    (k85TargetLevel ((n : ℤ) + 4)) k85TargetCandidateNull Q hCQ hchar hnum
      (k85PBWNumerator_mem_level n)

/-- Grade-local character equality plus membership in a containing null submodule suffices for
the full PBW family. -/
theorem k85PBWNumerator_all_mem_of_quotientLevel_finrank_eq
    (Q : Submodule ℂ LeeYangFock) (hCQ : k85TargetCandidateNull ≤ Q)
    (hnum : ∀ n : ℕ, k85PBWNumerator n ∈ Q)
    (hchar : ∀ n : ℕ,
      finrank ℂ ((k85TargetLevel ((n : ℤ) + 4)).map k85TargetCandidateNull.mkQ) =
        finrank ℂ ((k85TargetLevel ((n : ℤ) + 4)).map Q.mkQ)) :
    ∀ n : ℕ, k85PBWNumerator n ∈ k85TargetCandidateNull := by
  intro n
  exact k85PBWNumerator_mem_of_quotientLevel_finrank_eq n Q hCQ (hnum n) (hchar n)

/-- Once the containing null submodule is known to contain the PBW numerators, character equality
turns that membership into membership in the explicit two-singular closure. -/
theorem k85PBWNumerator_all_mem_of_quotientCharacter
    (Q : Submodule ℂ LeeYangFock)
    (hCQ : k85TargetCandidateNull ≤ Q) (hQ : IsK85TargetGraded Q)
    (hchar : ∀ d : ℤ,
      finrank ℂ ((k85TargetLevel d).map k85TargetCandidateNull.mkQ) =
        finrank ℂ ((k85TargetLevel d).map Q.mkQ))
    (hnum : ∀ n : ℕ, k85PBWNumerator n ∈ Q) :
    ∀ n : ℕ, k85PBWNumerator n ∈ k85TargetCandidateNull := by
  rw [k85TargetCandidateNull_eq_of_quotientCharacter Q hCQ hQ hchar]
  exact hnum

/-!
## Exact remaining representation-theoretic interface

The preceding theorem is fully constructive, but its hypotheses expose two facts absent from the
current repository:

1. a graded target null submodule `Q` containing every coefficient numerator (typically obtained
   as the radical of a contravariant form, or as the kernel of a map to the irreducible module);
2. the equality of the graded quotient dimensions for `Q` and the explicit mode closure.

The universal Virasoro development in this repository is the vacuum module `V(c,0)`, whose
creation modes start at `L₋₂`.  It cannot present the present `h=-1/5` sector, where `L₋₁`
acts nontrivially.  The VOA maximal-ideal and canonical-form APIs consequently do not produce the
submodule `Q` above.  A general `M(c,h)` Verma construction with PBW grading and its contravariant
form (or a direct Feigin--Fuchs cyclic/PBW presentation of this Fock carrier) is the first missing
data structure; the Lee--Yang embedding/character theorem is the first missing representation
theorem after that construction.
-/

end
