import VOA.Examples.TwoSeriesMembershipLine

/-!
# A test homomorphism that turns the Sugawara letters into current letters

The Sugawara letter of the model is `(-J)_m + T_m`.  Send `T_m` to `J_m + x_{m+1}`, where
`J = u'v - uv'` and `x = u²`: the Sugawara letter becomes the current letter `x_{m+1}`.  For
this to be a ring map out of `R_n = ℂ[T_j]/(jets of Tⁿ)` the target must kill the jets of
`(J + x̃)ⁿ`, `x̃(s) = Σ_m x_{m+1} s^m`.  So:

* `testSer` — the series `J(s) + x̃(s)`; `testIdeal n` — the ideal of `ℂ[u_j, v_j]` generated by
  the coefficients of `testSerⁿ`; `TestRing n` — the quotient;
* `ψn n : R_n → TestRing n` — `T_m ↦ J_m + x_{m+1}`; `testHom n` — its extension to the model
  ring `R_n[u_j, v_j]` (identity on `u_j, v_j`), as a `ℂ`-linear ring map;
* `testHom_mletter_sugawara` — the image of a Sugawara letter is the image of a current letter;
* `testLetters n` — the `ℂ`-span of the images of the current letters (the jets of `u², uv, v²`
  in `TestRing n`);
* `testHom_modelDeg` — every element of `S_{n,r}` maps into `testLetters n ^ r` (the span of
  products of `r` jets of `u², uv, v²`, modulo `testIdeal n`);
* `testSp n r N` — the `τ ∈ R_n` with `ψn τ · v₀^{2N} ∈ testLetters n ^ r`;
* `vMem_le_testSp` — **every membership space lies in the test space**.

Combined with `vMem_le_tMonW` this bounds the membership space by a space defined without the
model words: a `T`-polynomial `τ` of degree `r - N` such that `τ(J + x̃) · v₀^{2N}` lies in the
span of products of `r` jets of `u², uv, v²` modulo the jets of `(J + x̃)ⁿ`.

Everything is proved outright.
-/

namespace VOA.TwoSeries.StrictModel

open MvPolynomial VOA.SymbolModel VOA.InvariantSymbol VOA.SocleEval
open VOA.AdamovicSymbol Module
open VOA.AffineVOA.CorrectedR (Generator)

noncomputable section

/-- The series `J(s) + x̃(s)` with `x̃(s) = Σ_m x_{m+1} s^m`. -/
def testSer : JetSer :=
  PowerSeries.mk fun m => PowerSeries.coeff m jSer + PowerSeries.coeff (m + 1) xSer

/-- The ideal generated by the jets of `(J + x̃)ⁿ`. -/
def testIdeal (n : ℕ) : Ideal JetPoly :=
  Ideal.span (Set.range fun j => PowerSeries.coeff j (testSer ^ n))

/-- The test ring `ℂ[u_j, v_j]/(jets of (J + x̃)ⁿ)`. -/
abbrev TestRing (n : ℕ) : Type := JetPoly ⧸ testIdeal n

/-- The quotient map onto the test ring. -/
abbrev tmk (n : ℕ) : JetPoly →+* TestRing n := Ideal.Quotient.mk (testIdeal n)

/-- `T_m ↦ J_m + x_{m+1}` on `ℂ[T_j]`. -/
def testT (n : ℕ) : TPoly →ₐ[ℂ] TestRing n :=
  aeval fun m => tmk n (PowerSeries.coeff m testSer)

theorem map_testT_tSer (n : ℕ) :
    PowerSeries.map (testT n).toRingHom tSer = PowerSeries.map (tmk n) testSer := by
  refine PowerSeries.ext fun j => ?_
  rw [PowerSeries.coeff_map, PowerSeries.coeff_map, tSer, PowerSeries.coeff_mk]
  simp [testT]

theorem jetIdealT_le_ker_testT (n : ℕ) : jetIdealT n ≤ RingHom.ker (testT n).toRingHom := by
  rw [jetIdealT, Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  rw [SetLike.mem_coe, RingHom.mem_ker]
  have h := PowerSeries.coeff_map (testT n).toRingHom j (tSer ^ n)
  rw [map_pow, map_testT_tSer, ← map_pow, PowerSeries.coeff_map] at h
  rw [← h]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)

/-- `T_m ↦ J_m + x_{m+1}` on `R_n`. -/
def ψn (n : ℕ) : Rn n →ₐ[ℂ] TestRing n :=
  Ideal.Quotient.liftₐ (jetIdealT n) (testT n) fun _ ha => jetIdealT_le_ker_testT n ha

theorem ψn_tn (n m : ℕ) :
    ψn n (tn n m) = tmk n (PowerSeries.coeff m jSer + PowerSeries.coeff (m + 1) xSer) := by
  simp [ψn, tn, testT, testSer]

/-- The test homomorphism on the model ring: `ψn` on coefficients, `u_j, v_j ↦ u_j, v_j`. -/
def testHomR (n : ℕ) : MPoly (Rn n) →+* TestRing n :=
  eval₂Hom (ψn n).toRingHom fun x => tmk n (X x)

theorem testHomR_smul (n : ℕ) (c : ℂ) (Q : MPoly (Rn n)) :
    testHomR n (c • Q) = c • testHomR n Q := by
  rw [Algebra.smul_def, map_mul, MvPolynomial.algebraMap_apply, Algebra.smul_def]
  congr 1
  simp [testHomR]

/-- The test homomorphism as a `ℂ`-linear map. -/
def testHom (n : ℕ) : MPoly (Rn n) →ₗ[ℂ] TestRing n where
  toFun := testHomR n
  map_add' := map_add _
  map_smul' := testHomR_smul n

theorem testHom_apply (n : ℕ) (Q : MPoly (Rn n)) : testHom n Q = testHomR n Q := rfl

theorem testHomR_C (n : ℕ) (a : Rn n) : testHomR n (MvPolynomial.C a) = ψn n a := by
  simp [testHomR]

theorem testHomR_X (n : ℕ) (x : Fin 2 × ℕ) : testHomR n (X x) = tmk n (X x) := by
  simp [testHomR]

theorem testHomR_ι (n : ℕ) (P : JetPoly) : testHomR n (ι (Rn n) P) = tmk n P := by
  induction P using MvPolynomial.induction_on with
  | C c =>
    rw [ι_C, testHomR_C, AlgHom.commutes]
    rfl
  | add p q hp hq => rw [map_add, map_add, hp, hq, map_add]
  | mul_X p x hp => rw [map_mul, map_mul, hp, ι_X, testHomR_X, map_mul]

theorem testHom_mletter_current (n : ℕ) (a : Fin 3) (m : ℕ) :
    testHomR n (mletter (Rn n) (tn n) (.current a, m)) = tmk n (letterSym (.current a, m)) :=
  testHomR_ι n _

/-- **A Sugawara letter maps to the current letter `x_{m+1}`.** -/
theorem testHom_mletter_sugawara (n m : ℕ) :
    testHomR n (mletter (Rn n) (tn n) (.sugawara, m)) =
      testHomR n (mletter (Rn n) (tn n) (.current 0, m + 1)) := by
  change testHomR n (ι (Rn n) (letterSym _) + MvPolynomial.C (tn n m)) = _
  rw [map_add, testHomR_ι, testHomR_C, ψn_tn, testHom_mletter_current, ← map_add]
  congr 1
  change PowerSeries.coeff m (-jSer) + _ = PowerSeries.coeff (m + 1) xSer
  rw [map_neg]
  ring

/-- The `ℂ`-span of the images of the current letters. -/
def testLetters (n : ℕ) : Submodule ℂ (TestRing n) :=
  Submodule.span ℂ (Set.range fun p : Fin 3 × ℕ =>
    testHomR n (mletter (Rn n) (tn n) (.current p.1, p.2)))

theorem testHom_mletter_mem (n : ℕ) (l : Generator × ℕ) :
    testHomR n (mletter (Rn n) (tn n) l) ∈ testLetters n := by
  obtain ⟨g, m⟩ := l
  cases g with
  | current a => exact Submodule.subset_span ⟨(a, m), rfl⟩
  | sugawara =>
    rw [testHom_mletter_sugawara]
    exact Submodule.subset_span ⟨(0, m + 1), rfl⟩

theorem testHom_mword_mem (n : ℕ) (w : List (Generator × ℕ)) :
    testHomR n (mword (Rn n) (tn n) w) ∈ testLetters n ^ w.length := by
  induction w with
  | nil =>
    rw [mword_nil, map_one, List.length_nil, pow_zero]
    exact Submodule.one_le.mp le_rfl
  | cons l w ih =>
    rw [mword_cons, map_mul, List.length_cons, pow_succ']
    exact Submodule.mul_mem_mul (testHom_mletter_mem n l) ih

/-- **The model maps into the span of products of `r` jets of `u², uv, v²`.** -/
theorem testHom_modelDeg (n r : ℕ) (d : ℤ) :
    modelDeg (Rn n) (tn n) r d ≤ (testLetters n ^ r).comap (testHom n) := by
  rw [modelDeg, Submodule.span_le]
  rintro _ ⟨w, hw, -, rfl⟩
  rw [SetLike.mem_coe, Submodule.mem_comap, testHom_apply, ← hw]
  exact testHom_mword_mem n w

/-- **The test space**: the `τ ∈ R_n` with `ψn τ · v₀^{2N}` in the span of products of `r`
jets of `u², uv, v²` modulo the jets of `(J + x̃)ⁿ`. -/
def testSp (n r N : ℕ) : Submodule ℂ (Rn n) :=
  (testLetters n ^ r).comap ((testHom n).comp (vLift (Rn n) (2 * N)))

theorem mem_testSp (n r N : ℕ) (τ : Rn n) :
    τ ∈ testSp n r N ↔ ψn n τ * tmk n (X (1, 0)) ^ (2 * N) ∈ testLetters n ^ r := by
  rw [testSp, Submodule.mem_comap, LinearMap.comp_apply, vLift_apply, testHom_apply, map_mul,
    map_pow, testHomR_C, testHomR_X]

/-- **Every membership space lies in the test space.** -/
theorem vMem_le_testSp (n r : ℕ) (d : ℤ) (N : ℕ) :
    vMem (Rn n) (tn n) r d (2 * N) ≤ testSp n r N := fun _ hτ =>
  testHom_modelDeg n r d hτ

end

end VOA.TwoSeries.StrictModel
