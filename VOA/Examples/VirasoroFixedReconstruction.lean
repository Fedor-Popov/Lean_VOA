import VOA.Examples.VirasoroVacuumEvaluation
import VOA.Examples.VirasoroDeformationGram4
import VOA.Core.DeformationIteration

/-!
# Reconstruction from actual fixed-charge normalized Virasoro modes

The cyclic image is generated by the corrected conformal state, rather than its
pure lift. Creation words control grading directly. Product iteration then closes
the image under all deformed products, allowing reconstruction of a coboundary.
-/
namespace VOA.VirDeformModes
open Module (End)
open VirModule VirSimple VertexOperatorAlgebra Deform Deform.Reconstruction
variable (c : ℂ) (D : FirstOrderDeformation (virasoroSimple c))
variable (β : ℂ) (A : CentralVirasoroData ((VirUniv c ⧸ maxIdealVir c) ×
  (VirUniv c ⧸ maxIdealVir c)))
variable (hA : A.L = normalizedL D β) (hK : A.central = c • 1)

/-- Evaluate universal vacuum states by the actual normalized deformation modes.
The fixed-center hypothesis is used only to descend through the vacuum ideal. -/
noncomputable def fixedEval : VirUniv c →ₗ[ℂ]
    ((VirUniv c ⧸ maxIdealVir c) × (VirUniv c ⧸ maxIdealVir c)) :=
  (fixedVacuum A hK ((virasoroSimple c).vacuum, 0)
    (fun n hn => by rw [hA]; exact normalizedL_vacuum D β n hn)).eval

/-- The evaluation vacuum has no tangent component. -/
theorem fixedEval_vacuum : fixedEval c D β A hA hK (vacVec c) =
    ((virasoroSimple c).vacuum, 0) :=
  VacuumVirasoroRealization.eval_vacuum _

/-- Evaluation intertwines every ordinary universal mode with the actual
normalized mode on the extension. -/
theorem fixedEval_L (n : ℤ) (v : VirUniv c) :
    fixedEval c D β A hA hK (Lop c n v) =
      normalizedL D β n (fixedEval c D β A hA hK v) := by
  unfold fixedEval
  rw [show Lop c n = virVacRho c (VOA.L n) from rfl,
    VacuumVirasoroRealization.eval_action]
  change fixedRho A hK (VOA.L n) _ = _
  rw [fixedRho_L, hA]

/-- Forgetting the tangent coordinate gives exactly the original simple
quotient map. Creation-word spanning extends this identity to all states. -/
theorem fixedEval_fst (v : VirUniv c) :
    (fixedEval c D β A hA hK v).1 = (maxIdealVir c).mkQ v := by
  let F := (LinearMap.fst ℂ _ _).comp (fixedEval c D β A hA hK)
  have hw (l : List ℕ) : F (negWordVir c l) = (maxIdealVir c).mkQ (negWordVir c l) := by
    induction l with
    | nil => exact congrArg Prod.fst (fixedEval_vacuum c D β A hA hK)
    | cons i l ih =>
      change (fixedEval c D β A hA hK (negWordVir c (i::l))).1 = _
      rw [negWordVir_cons, fixedEval_L, normalizedL_apply]
      change (virasoroSimple c).L _ (F (negWordVir c l)) = _
      rw [ih, ← VirQuotForm.mkQ_L, virasoroVOA_L_eq_Lop]
  have hv : v ∈ Submodule.span ℂ (Set.range (negWordVir c)) := by
    change v ∈ negSpanVir c
    rw [negSpanVir_eq_top]; trivial
  change F v = (maxIdealVir c).mkQ v
  induction hv using Submodule.span_induction with
  | mem x hx => obtain ⟨l, rfl⟩ := hx; exact hw l
  | zero => simp only [map_zero]
  | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
  | smul r x _ hx => rw [map_smul, map_smul, hx]

/-- Evaluation preserves homogeneous weights in both coordinates. Induction
on creation words uses their grade shifts, without equating the normalized
zero mode with an externally chosen grading operator on the entire extension. -/
theorem fixedEval_mem_grading (hD : D.IsGraded) {n : ℤ} {v : VirUniv c}
    (hv : v ∈ gradingVir c n) :
    (fixedEval c D β A hA hK v).1 ∈ (virasoroSimple c).grading n ∧
    (fixedEval c D β A hA hK v).2 ∈ (virasoroSimple c).grading n := by
  let F := fixedEval c D β A hA hK
  have hw (l : List ℕ) : (F (negWordVir c l)).1 ∈
      (virasoroSimple c).grading (energyVir l) ∧
      (F (negWordVir c l)).2 ∈ (virasoroSimple c).grading (energyVir l) := by
    induction l with
    | nil =>
      change (fixedEval c D β A hA hK (vacVec c)).1 ∈ (virasoroSimple c).grading 0 ∧
        (fixedEval c D β A hA hK (vacVec c)).2 ∈ (virasoroSimple c).grading 0
      rw [fixedEval_vacuum]
      exact ⟨(virasoroSimple c).vacuum_mem, Submodule.zero_mem _⟩
    | cons i l ih =>
      change (fixedEval c D β A hA hK (negWordVir c (i::l))).1 ∈ _ ∧
        (fixedEval c D β A hA hK (negWordVir c (i::l))).2 ∈ _
      rw [negWordVir_cons, fixedEval_L]
      have h := normalizedL_mem_grading D hD β (-(i : ℤ)-2) (energyVir l) (F _) ih
      have he : (energyVir (i::l) : ℤ) = (energyVir l : ℤ) - (-(i : ℤ)-2) := by
        simp only [energyVir_cons, Nat.cast_add, Nat.cast_ofNat]; omega
      rw [he]
      exact h
  induction hv using Submodule.span_induction with
  | mem x hx => obtain ⟨l, he, rfl⟩ := hx; simpa only [← he] using hw l
  | zero =>
      simp only [map_zero, Prod.fst_zero, Prod.snd_zero]
      exact ⟨Submodule.zero_mem _, Submodule.zero_mem _⟩
  | add x y _ _ hx hy =>
      rw [map_add]; exact ⟨Submodule.add_mem _ hx.1 hy.1, Submodule.add_mem _ hx.2 hy.2⟩
  | smul r x _ hx =>
      rw [map_smul]; exact ⟨Submodule.smul_mem _ r hx.1, Submodule.smul_mem _ r hx.2⟩

/-- Projecting a homogeneous state to a different weight gives zero. -/
private theorem gradePart_other {V : Type*} [AddCommGroup V] [Module ℂ V]
    (W : VertexOperatorAlgebra V) {n k : ℤ} {v : V}
    (hkn : k ≠ n) (hv : v ∈ W.grading k) : gradePart W n v = 0 := by
  letI : DirectSum.Decomposition W.grading := W.isInternal.chooseDecomposition W.grading
  unfold gradePart
  change (W.gradedProj n v : V) = 0
  rw [W.gradedProj_of_mem_ne hkn hv]
  rfl

/-- Evaluation commutes with homogeneous projection in both coordinates.
This follows by decomposing the source into homogeneous states, whose weights
were proved directly from creation words. -/
theorem fixedEval_gradePart (hD : D.IsGraded) (n : ℤ) (v : VirUniv c) :
    fixedEval c D β A hA hK (gradePart (virasoroVOA c) n v) =
      (gradePart (virasoroSimple c) n (fixedEval c D β A hA hK v).1,
       gradePart (virasoroSimple c) n (fixedEval c D β A hA hK v).2) := by
  let F := fixedEval c D β A hA hK
  let P := (gradePart (virasoroSimple c) n).prodMap (gradePart (virasoroSimple c) n)
  change F (gradePart (virasoroVOA c) n v) = P (F v)
  have hv : v ∈ ⨆ k, gradingVir c k := by rw [iSup_gradingVir]; trivial
  refine Submodule.iSup_induction (gradingVir c)
    (motive := fun v => F (gradePart (virasoroVOA c) n v) = P (F v)) hv ?_ ?_ ?_
  · intro k v hv
    obtain ⟨h1, h2⟩ := fixedEval_mem_grading c D β A hA hK hD hv
    change F (gradePart (virasoroVOA c) n v) =
      (gradePart (virasoroSimple c) n (F v).1, gradePart (virasoroSimple c) n (F v).2)
    by_cases hkn : k = n
    · subst k
      rw [gradePart_of_mem hv, gradePart_of_mem h1, gradePart_of_mem h2]
    · rw [gradePart_other _ hkn hv, gradePart_other _ hkn h1, gradePart_other _ hkn h2]
      exact F.map_zero
  · simp only [map_zero]
  · intro x y hx hy
    rw [map_add, map_add, map_add, map_add, hx, hy]

/-- Every homogeneous part of an evaluated state is still in the cyclic image. -/
theorem fixedEval_gradeClosed (hD : D.IsGraded) :
    GradeClosed (virasoroSimple c) (LinearMap.range (fixedEval c D β A hA hK)) := by
  intro x hx n
  obtain ⟨v, rfl⟩ := hx
  rw [← fixedEval_gradePart c D β A hA hK hD]
  exact LinearMap.mem_range_self _ _

/-- The cyclic image excludes the pure tangent vacuum. Project a hypothetical
preimage to weight zero; the universal weight-zero line evaluates only to pure
ordinary vacua, so it cannot produce a nonzero tangent vacuum. -/
theorem fixedEval_separation (hD : D.IsGraded) :
    (0, (virasoroSimple c).vacuum) ∉ LinearMap.range (fixedEval c D β A hA hK) := by
  rintro ⟨v, he⟩
  have hp := fixedEval_gradePart c D β A hA hK hD 0 v
  rw [he, map_zero, gradePart_of_mem (virasoroSimple c).vacuum_mem] at hp
  have hmem := gradePart_mem (W := virasoroVOA c) 0 v
  change gradePart (virasoroVOA c) 0 v ∈ gradingVir c 0 at hmem
  rw [gradingVir_zero, Submodule.mem_span_singleton] at hmem
  obtain ⟨r, hr⟩ := hmem
  rw [← hr, map_smul, fixedEval_vacuum] at hp
  have hsecond := congrArg Prod.snd hp
  simp only [Prod.smul_snd, smul_zero] at hsecond
  exact virasoroSimple_vacuum_ne_zero c hsecond.symm

/-- Product by the corrected conformal state is exactly the normalized mode.
This identity is why the cyclic image must use the corrected generator. -/
theorem corrected_conformal_product (n : ℤ)
    (x : (VirUniv c ⧸ maxIdealVir c) × (VirUniv c ⧸ maxIdealVir c)) :
    product D ((virasoroSimple c).conformalVector,
      -(β/2) • (virasoroSimple c).conformalVector) n x = normalizedL D β (n-1) x := by
  apply Prod.ext <;>
    simp only [product, normalizedL_apply, L_def, sub_add_cancel,
      ← PreVertexAlgebra.smul_def, PreVertexAlgebra.smul_smul_left]
  all_goals module

/-- Every mode of the corrected conformal state preserves the cyclic image. -/
theorem fixedEval_generator_preserves :
    ((virasoroSimple c).conformalVector, -(β/2) • (virasoroSimple c).conformalVector) ∈
      modePreservers D (LinearMap.range (fixedEval c D β A hA hK)) := by
  intro x hx n
  obtain ⟨v, rfl⟩ := hx
  rw [corrected_conformal_product, ← fixedEval_L c D β A hA hK]
  exact LinearMap.mem_range_self _ _

/-- The iterate identity propagates mode preservation from the corrected
conformal generator along creation words and then to every evaluated state. -/
theorem fixedEval_modeClosed : ModeClosed D (LinearMap.range (fixedEval c D β A hA hK)) := by
  let F := fixedEval c D β A hA hK
  let S := LinearMap.range F
  have hw (l : List ℕ) : F (negWordVir c l) ∈ modePreservers D S := by
    induction l with
    | nil =>
      change fixedEval c D β A hA hK (vacVec c) ∈ _
      rw [fixedEval_vacuum]
      exact vacuum_mem_modePreservers D S
    | cons i l ih =>
      change fixedEval c D β A hA hK (negWordVir c (i::l)) ∈ _
      rw [negWordVir_cons, fixedEval_L]
      have h := modePreservers_product D S
        (fixedEval_generator_preserves c D β A hA hK) ih (-(i : ℤ)-1)
      rw [corrected_conformal_product] at h
      simpa only [show -(i : ℤ)-1-1 = -(i : ℤ)-2 by omega] using h
  have hpre : (modePreservers D S).comap F = ⊤ := by
    apply top_unique
    rw [← negSpanVir_eq_top c, negSpanVir]
    apply Submodule.span_le.mpr
    rintro _ ⟨l, rfl⟩
    exact hw l
  intro x hx y hy n
  obtain ⟨v, rfl⟩ := hx
  have hv : F v ∈ modePreservers D S := by
    change v ∈ (modePreservers D S).comap F
    rw [hpre]
    trivial
  exact hv y hy n

/-- Reduction of the cyclic image is onto, since its constant term is the
surjective simple quotient map. -/
theorem fixedEval_reduction_surjective :
    Function.Surjective (reduction (LinearMap.range (fixedEval c D β A hA hK))) := by
  intro x
  obtain ⟨v, rfl⟩ := (maxIdealVir c).mkQ_surjective x
  exact ⟨⟨fixedEval c D β A hA hK v, LinearMap.mem_range_self _ _⟩,
    fixedEval_fst c D β A hA hK v⟩

/-- Actual fixed-charge normalized modes force a graded deformation to be a
coboundary. Universal evaluation, product and grade closure, surjectivity and
separation are all constructed above; no reconstruction assumption remains. -/
theorem isTrivial_of_fixed_modes (hA : A.L = normalizedL D β)
    (hK : A.central = c • 1) (hD : D.IsGraded) : D.IsTrivial := by
  apply isTrivial_of_closed_lift D (LinearMap.range (fixedEval c D β A hA hK))
    (virasoroSimple_isSimple c) (fixedEval_modeClosed c D β A hA hK)
    (fixedEval_reduction_surjective c D β A hA hK) (fixedEval_separation c D β A hA hK hD)
  · rw [← fixedEval_vacuum c D β A hA hK]
    exact LinearMap.mem_range_self _ _
  · exact fixedEval_gradeClosed c D β A hA hK hD

/-- Vanishing of the extracted central variation is sufficient for a
coboundary at any charge. The actual normalized mode construction discharges
all representation hypotheses before applying fixed-charge reconstruction. -/
theorem isTrivial_of_zero_central_variation (hD : D.IsGraded) (α β : ℂ)
    (ha : D.smul₁ (virasoroSimple c).conformalVector 3
      (virasoroSimple c).conformalVector = α • (virasoroSimple c).vacuum)
    (hb : D.smul₁ (virasoroSimple c).conformalVector 1
      (virasoroSimple c).conformalVector = β • (virasoroSimple c).conformalVector)
    (hz : 2*α-β*c = 0) : D.IsTrivial := by
  let A := normalizedData D hD (virasoroSimple_grading_one c) α β ha hb
  have hK : A.central = c • 1 := by
    change c • 1 + (2*α-β*c) • tangentShift = c • 1
    rw [hz, zero_smul, add_zero]
  exact isTrivial_of_fixed_modes c D β A rfl hK hD

/-- Every graded first-order deformation of the Lee–Yang simple Virasoro
algebra is a grade-preserving, vacuum-preserving change of coordinates.
Both central-charge obstruction and fixed-charge reconstruction are proved. -/
theorem leeYang_graded_rigidity : Deform.IsRigidGraded (virasoroSimple LeeYang.leeYangC) := by
  intro D hD
  obtain ⟨β, A, hA, hK⟩ := leeYang_exists_fixed_central_modes D hD
  exact isTrivial_of_fixed_modes _ D β A hA hK hD

end VOA.VirDeformModes
