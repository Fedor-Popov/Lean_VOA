import VOA.Examples.KoszulResidualEndpoint

/-!
# Evaluating the auxiliary symbols at `x = -a`

The leading creation operators `aLead q` on `A` commute, so they generate a commutative
subalgebra `CA` of `End A`. Evaluation of polynomials at `x_q = -aLead q` gives

  `evalA : ℂ[x] →ₐ CA`,

and the **symbol evaluation** on the matter space

  `ev : (A ⊗ B) ⊗ U → A ⊗ B`,   `(x ⊗ y) ⊗ u ↦ evalA (PhiU u) x ⊗ y`

("evaluate the `U`-PBW symbol at `x = -a`").

* `ev_mLead` — `ev ∘ u_q = 0`: the Koszul boundaries are killed;
* `ev_const` — on `U`-constants `ev` is the identity.

Everything is proved outright from `hA`.
-/

set_option linter.deprecated false

namespace VOA.KoszulResidual

open VOA.ConcreteHodge VOA.GradedUnitaryCohomology VOA.VertexOperatorAlgebra
open Sl2CosetConcrete Sl2SemiInfinite AffineSl2GeneralRigidity AffineSl2BelowCritical
open VOA.LeeYangTransferAssembly VOA.KoszulConcrete MvPolynomial
open scoped TensorProduct

noncomputable section

variable (hA : GradedUnitary affineForm affineRealStructure affineFlag)

/-- The leading creation operators on `A`. -/
def aLeadSet : Set (Module.End ℂ ASpace) := Set.range fun q => aLead hA q

theorem aLeadSet_comm : ∀ a ∈ aLeadSet hA, ∀ b ∈ aLeadSet hA, a * b = b * a := by
  rintro _ ⟨q, rfl⟩ _ ⟨q', rfl⟩
  exact aLead_comm hA q q'

/-- The commutative algebra generated by the leading creation operators. -/
abbrev CA : Subalgebra ℂ (Module.End ℂ ASpace) := Algebra.adjoin ℂ (aLeadSet hA)

instance CA_commRing : CommRing (CA hA) := Algebra.adjoinCommRingOfComm ℂ (aLeadSet_comm hA)

/-- Evaluation at `x_q = -aLead q`. -/
def evalA : MvPolynomial LexLetter ℂ →ₐ[ℂ] CA hA :=
  aeval fun q => -⟨aLead hA q, Algebra.subset_adjoin ⟨q, rfl⟩⟩

theorem evalA_X (q : LexLetter) : (evalA hA (X q) : Module.End ℂ ASpace) = -aLead hA q := by
  simp [evalA]

theorem evalA_comm_aLead (p : MvPolynomial LexLetter ℂ) (q : LexLetter) :
    (evalA hA p : Module.End ℂ ASpace) * aLead hA q = aLead hA q * (evalA hA p) := by
  have h := mul_comm (evalA hA p) (⟨aLead hA q, Algebra.subset_adjoin ⟨q, rfl⟩⟩ : CA hA)
  exact congrArg Subtype.val h

/-- The `U`-symbol evaluation as a map `U → End A`. -/
def evU : USpace →ₗ[ℂ] Module.End ℂ ASpace :=
  (CA hA).val.toLinearMap ∘ₗ (evalA hA).toLinearMap ∘ₗ PhiU.toLinearMap

theorem evU_apply (u : USpace) : evU hA u = (evalA hA (PhiU u) : Module.End ℂ ASpace) := rfl

/-- **The symbol evaluation** `(x ⊗ y) ⊗ u ↦ evalA (PhiU u) x ⊗ y`. -/
def ev : MatterSpace →ₗ[ℂ] ASpace ⊗[ℂ] BSpace :=
  TensorProduct.lift ((LinearMap.rTensorHom BSpace ∘ₗ evU hA).flip)

theorem ev_tmul (xy : ASpace ⊗[ℂ] BSpace) (u : USpace) :
    ev hA (xy ⊗ₜ[ℂ] u) = LinearMap.rTensor BSpace (evU hA u) xy := by
  simp [ev]

/-- **`ev` kills the Koszul boundaries**: `ev ∘ u_q = 0`. -/
theorem ev_mLead (q : LexLetter) (m : MatterSpace) : ev hA (mLead hA q m) = 0 := by
  induction m using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, add_zero]
  | tmul xy u =>
      rw [mLead, LinearMap.add_apply, TensorProduct.map_tmul, TensorProduct.map_tmul,
        LinearMap.id_apply, LinearMap.id_apply, map_add, ev_tmul, ev_tmul, evU_apply,
        evU_apply, PhiU_uLead, map_mul, Subalgebra.coe_mul, evalA_X]
      rw [show TensorProduct.map (aLead hA q) (LinearMap.id : Module.End ℂ BSpace) =
        LinearMap.rTensor BSpace (aLead hA q) from rfl]
      rw [← LinearMap.rTensor_comp_apply, ← LinearMap.add_apply, ← LinearMap.rTensor_add]
      have : (evalA hA (PhiU u) : Module.End ℂ ASpace) ∘ₗ aLead hA q +
          (-aLead hA q * (evalA hA (PhiU u) : Module.End ℂ ASpace)) = 0 := by
        rw [← Module.End.mul_eq_comp, evalA_comm_aLead, neg_mul, add_neg_cancel]
      rw [this, LinearMap.rTensor_zero, LinearMap.zero_apply]

end

end VOA.KoszulResidual
