import VOA.Examples.TripletWpTwoAMSparseCompute

/-!
# Exact sparse Zhu certificate for the lattice `W(2)` calculation

This file contains only the rational Fock-coordinate calculation.  In particular it makes no
claim about Zhu's `O`-space.  The 37 circle products below were found by an untrusted exact
rational row reduction (104 columns, rank 38, and 133 Fock-coordinate rows across weights
two through ten); the theorem at the end rechecks the resulting ledger in Lean's kernel.
-/

namespace VOA.LatGen.WpTwoZhuSparseCompute

set_option maxHeartbeats 8000000
set_option maxRecDepth 100000

open VOA.SparseRational
open VOA.LatGen.WpTwoAMSparseCompute

/-- Apply coefficient `s` of the formal field represented by `P` to a homogeneous state `Q`.
Thus the corresponding VOA mode is `-s-1`. -/
def zhuStateActSparseQ (P : SparseRational.Poly ℕ) (coefficient : ℤ) (rightWeight : ℕ)
    (Q : SparseRational.Poly ℕ) : SparseRational.Poly ℕ :=
  bindQ P fun word q => scaleQ q (aWordActSparseQ word coefficient rightWeight Q)

/-- Explicit conversion from a VOA mode to the formal-series coefficient expected by the
current evaluator. -/
def voaModeActSparseQ (P : SparseRational.Poly ℕ) (mode : ℤ) (rightWeight : ℕ)
    (Q : SparseRational.Poly ℕ) : SparseRational.Poly ℕ :=
  zhuStateActSparseQ P (-mode - 1) rightWeight Q

/-- Fock-coordinate realization of the Zhu circle product `P ∘ Q`. -/
def circleSparseQ (leftWeight : ℕ) (P : SparseRational.Poly ℕ) (rightWeight : ℕ)
    (Q : SparseRational.Poly ℕ) : SparseRational.Poly ℕ :=
  sumQ ((List.range (leftWeight + 1)).map fun i =>
    scaleQ (Nat.choose leftWeight i)
      (voaModeActSparseQ P ((i : ℤ) - 2) rightWeight Q))

/-- Regression guard for the convention at the most error-prone interface: the VOA mode
`i - 2` is coefficient `-(i - 2) - 1 = 1 - i` in `AWordField`. -/
theorem zhuCircle_mode_to_coefficient (i : ℕ) :
    -((i : ℤ) - 2) - 1 = 1 - (i : ℤ) := by ring

def vacuumSparseQ : SparseRational.Poly ℕ := normalizeQ [(1, [])]

/-- The background-charge Virasoro vector `L(-2)|0⟩`. -/
def omegaSparseQ : SparseRational.Poly ℕ :=
  normalizeQ [(1 / 8, [0, 0]), (1 / 4, [1])]

def zhuOmegaPartSparseQ
    (x : ℕ × SparseRational.Poly ℕ) : List (ℕ × SparseRational.Poly ℕ) :=
  [(x.1 + 2, voaModeActSparseQ omegaSparseQ (-1) x.1 x.2),
   (x.1 + 1, scaleQ 2 (voaModeActSparseQ omegaSparseQ 0 x.1 x.2)),
   (x.1, voaModeActSparseQ omegaSparseQ 1 x.1 x.2)]

def zhuOmegaPartsSparseQ : ℕ → List (ℕ × SparseRational.Poly ℕ)
  | 0 => [(0, vacuumSparseQ)]
  | n + 1 => (zhuOmegaPartsSparseQ n).flatMap zhuOmegaPartSparseQ

def flattenGradedSparseQ
    (P : List (ℕ × SparseRational.Poly ℕ)) : SparseRational.Poly ℕ :=
  sumQ (P.map Prod.snd)

/-- The expanded Fock representative of
`[ω]⁵ - (5/4)[ω]⁴ + (13/64)[ω]³ + (3/64)[ω]²`. -/
def fTwoSparseQ : SparseRational.Poly ℕ :=
  sumQ [flattenGradedSparseQ (zhuOmegaPartsSparseQ 5),
    scaleQ (-5 / 4) (flattenGradedSparseQ (zhuOmegaPartsSparseQ 4)),
    scaleQ (13 / 64) (flattenGradedSparseQ (zhuOmegaPartsSparseQ 3)),
    scaleQ (3 / 64) (flattenGradedSparseQ (zhuOmegaPartsSparseQ 2))]

def mulSparseQ (P Q : SparseRational.Poly ℕ) : SparseRational.Poly ℕ :=
  bindQ P fun w q => bindQ Q fun v r => normalizeQ [(q * r, w ++ v)]

def schurSparseQ : ℕ → SparseRational.Poly ℕ
  | 0 => vacuumSparseQ
  | n + 1 => scaleQ (1 / (n + 1 : ℚ))
      (sumQ ((List.range (n + 1)).map fun i =>
        mulSparseQ (normalizeQ [(1, [i])]) (schurSparseQ (n - i))))

