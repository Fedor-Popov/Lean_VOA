/-- Public 37-circle ledger, separated into short families so both coordinate and semantic
proofs can process it without duplicating coefficients. -/
def certificateCircleLedger : List ZhuCircleDesc :=
  certificateL2Ledger ++ certificateL3Ledger ++ certificateL4Ledger ++
    certificateL22Ledger ++ certificateL5Ledger ++ certificateHLedger

theorem certificateCircleLedger_length : certificateCircleLedger.length = 37 := by
  norm_num [certificateCircleLedger, certificateL2Ledger, certificateL3Ledger,
    certificateL4Ledger, certificateL22Ledger, certificateL5Ledger, certificateHLedger]

def evalCircleLedger (ledger : List ZhuCircleDesc) : SparseRational.Poly ℕ :=
  sumQ (ledger.map ZhuCircleDesc.eval)

/-- A Virasoro mode `L(mode)` evaluated through the conformal vector.  The argument of
`voaModeActSparseQ` is a VOA mode; it is the unique mode/coefficient conversion boundary. -/
def virModeSparseQ (mode : ℤ) (rightWeight : ℕ) (Q : SparseRational.Poly ℕ) :
    SparseRational.Poly ℕ :=
  voaModeActSparseQ omegaSparseQ (mode + 1) rightWeight Q

/-- The derivative coefficient in
`(L(-r)𝟙)_n = ((r-2)!)⁻¹ ∏_{j<r-2} (-(n-j)) · ω_(n-r+2)` for the four
single-part Virasoro descendants used by the ledger. -/
def virVacModeCoefficientQ : ℕ → ℤ → ℚ
  | 2, _n => 1
  | 3, n => -(n : ℚ)
  | 4, n => (-(n : ℚ)) * (1 - (n : ℚ)) / 2
  | 5, n => (-(n : ℚ)) * (1 - (n : ℚ)) * (2 - (n : ℚ)) / 6
  | _, _n => 0

/-- The VOA mode of `L(-r)𝟙`, evaluated as one conformal-vector mode using translation
covariance.  Its argument `n` is a VOA mode, not a formal-series coefficient. -/
def virVacModeSparseQ (r : ℕ) (n : ℤ) (rightWeight : ℕ)
    (Q : SparseRational.Poly ℕ) : SparseRational.Poly ℕ :=
  scaleQ (virVacModeCoefficientQ r n)
    (voaModeActSparseQ omegaSparseQ (n - (r - 2 : ℕ)) rightWeight Q)

/-- The Zhu circle sum for a single-part Virasoro vacuum descendant `L(-r)𝟙`. -/
def virVacCircleSparseQ (r rightWeight : ℕ) (Q : SparseRational.Poly ℕ) :
    SparseRational.Poly ℕ :=
  sumQ ((List.range (r + 1)).map fun i =>
    scaleQ (Nat.choose r i) (virVacModeSparseQ r ((i : ℤ) - 2) rightWeight Q))

/-- The normal-product formula for the VOA mode `(L(-2)^2 𝟙)_n` on a homogeneous
weight-`rightWeight` coordinate.  The two sums are
`m = n - 3 - rightWeight, ..., -2` and `m = -1, ..., rightWeight` respectively. -/
def vir22ModeSparseQ (n : ℤ) (rightWeight : ℕ) (Q : SparseRational.Poly ℕ) :
    SparseRational.Poly ℕ :=
  addQ
    (sumQ ((intIccListQ (n - 3 - (rightWeight : ℤ)) (-2)).map fun m =>
      virModeSparseQ m (((rightWeight : ℤ) - (n - 3 - m)).toNat)
        (virModeSparseQ (n - 3 - m) rightWeight Q)))
    (sumQ ((intIccListQ (-1) (rightWeight : ℤ)).map fun m =>
      virModeSparseQ (n - 3 - m) (((rightWeight : ℤ) - m).toNat)
        (virModeSparseQ m rightWeight Q)))

/-- Zhu's five-term circle sum for the weight-four state `L(-2)^2 𝟙`, evaluated via
the normal-product mode formula above. -/
def vir22CircleSparseQ (rightWeight : ℕ) (Q : SparseRational.Poly ℕ) :
    SparseRational.Poly ℕ :=
  sumQ ((List.range 5).map fun i =>
    scaleQ (Nat.choose 4 i) (vir22ModeSparseQ ((i : ℤ) - 2) rightWeight Q))

/-- Evaluate the two typed `L(-2)^2 𝟙` ledger entries through the audited normal-product
formula.  The ledger remains the single source of coefficients and right states. -/
def evalVir22Ledger (ledger : List ZhuCircleDesc) : SparseRational.Poly ℕ :=
  sumQ (ledger.map fun d =>
    scaleQ d.coefficient (vir22CircleSparseQ d.right.weight d.right.eval))

/-- Evaluate typed circles whose left state is `L(-r)𝟙` through the audited translation
formula.  A non-singleton descriptor falls back to the generic coordinate evaluator. -/
def evalVirVacLedger (ledger : List ZhuCircleDesc) : SparseRational.Poly ℕ :=
  sumQ (ledger.map fun d =>
    match d.left with
    | .vir [r] =>
        scaleQ d.coefficient (virVacCircleSparseQ r d.right.weight d.right.eval)
    | _ => d.eval)

def certificateQPartSparseQ : SparseRational.Poly ℕ :=
  scaleQ (1575 / 1024) qTwoSparseQ

/-- The rational coordinate claimed by the exact row-reduction ledger. -/
def certificateRhsSparseQ : SparseRational.Poly ℕ :=
  sumQ [certificateQPartSparseQ,
    evalVirVacLedger certificateL2Ledger,
    evalVirVacLedger certificateL3Ledger,
    evalVirVacLedger certificateL4Ledger,
    evalVir22Ledger certificateL22Ledger,
    evalVirVacLedger certificateL5Ledger,
    evalCircleLedger certificateHLedger]

