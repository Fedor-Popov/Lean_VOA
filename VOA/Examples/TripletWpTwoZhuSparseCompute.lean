def virShiftRawQ (mode : ℕ) (P : SparseRational.Poly ℕ) : RawPoly ℕ :=
  P.flatMap fun ⟨word, q⟩ => (List.range word.length).map fun position =>
    (q * ((word[position]! + 1 : ℕ) : ℚ), word.set position (word[position]! + mode))

def virVacuumSparseQ (mode : ℕ) : SparseRational.Poly ℕ :=
  normalizeQ
    (((List.range (mode - 1)).map fun i => (1 / 8, [i, mode - 2 - i])) ++
      [(((mode - 1 : ℕ) : ℚ) / 4, [mode - 1])])

def virActSparseQ (mode : ℕ) (P : SparseRational.Poly ℕ) : SparseRational.Poly ℕ :=
  addQ (mulSparseQ P (virVacuumSparseQ mode)) (normalizeQ (virShiftRawQ mode P))

/-- Public coordinate evaluator for Virasoro words; the list is in operator order. -/
def reifyVirWordSparseQ (parts : List ℕ) : SparseRational.Poly ℕ :=
  parts.foldr virActSparseQ vacuumSparseQ

def hThreeSparseQ : SparseRational.Poly ℕ := sThreeSparseQ

/-- The small collection of homogeneous states needed by the certificate. -/
inductive ZhuStateDesc where
  | vir (parts : List ℕ)
  | h
  | l3h
  deriving DecidableEq

def ZhuStateDesc.weight : ZhuStateDesc → ℕ
  | .vir parts => parts.sum
  | .h => 3
  | .l3h => 6

def ZhuStateDesc.eval : ZhuStateDesc → SparseRational.Poly ℕ
  | .vir parts => reifyVirWordSparseQ parts
  | .h => hThreeSparseQ
  | .l3h => virActSparseQ 3 hThreeSparseQ

structure ZhuCircleDesc where
  coefficient : ℚ
  left : ZhuStateDesc
  right : ZhuStateDesc
  deriving DecidableEq

def ZhuCircleDesc.eval (d : ZhuCircleDesc) : SparseRational.Poly ℕ :=
  scaleQ d.coefficient
    (circleSparseQ d.left.weight d.left.eval d.right.weight d.right.eval)

