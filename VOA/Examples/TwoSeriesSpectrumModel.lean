import VOA.Examples.TwoSeriesSpectrumLeeYang

/-!
# The socle data from a strict symbol model (route (a)), and the model at `n = 1`

The route to `TwoSeriesSocleSpectrum n` through a jet model: embed `gr_r L_{k_n}` strictly into a
model module (in the notes, the jet algebra `S_n` generated by the jets of `u², uv, v²` and
`u'v - uv' + T` inside `ℂ[u_j, v_j] ⊗ ℂ[T_j]/(jets of Tⁿ)`), and prove the socle data for the
model.  Since the socle data pull back along injective intertwiners (`SocleSpectrum.comap`),
this splits the input into two independent statements.

* `modelCart ρ hc N` — the image of the Cartan ideal `I_N` on a model with commuting Cartan modes.
* `TwoSeriesSocleModel n r` — **the route-(a) package at filtration degree `r`**: a module with
  a mode action and a grading with finite-dimensional pieces, the socle data for the socle words
  of size `r` (with the model's own Cartan image), and an injective, grading-preserving
  intertwiner from the actual `gr_r L_{k_n}`.
* `TwoSeriesSocleModel.grSpectrum`, `twoSeriesSocleSpectrum_of_models` and
  `twoSeries_gradedUnitary_of_socleModels` — **Affine GU ⇒ GU of `M(2, 2n+3)`, conditional on
  `hA` and a strict socle model in every filtration degree.**
* The model at `n = 1` is the jet image `A_r` (`T = 0`): `jetComm_e`, `jetComm_f`, `jetComm_h`
  (the jet derivations satisfy `[e_m, e₀] = 0`, `[f_m, e₀] = -h_m`, `[h_m, e₀] = 2e_m`),
  `jetZeroModeRel`, `jetSocleSpectrum` (**the socle data of `A_r`, proved**), and
  `levelOneSocleModel r : TwoSeriesSocleModel 1 r` — the route-(a) package at `n = 1` is
  inhabited, with the proved strict maps `gr_r L_{-4/3} ↪ A_r`.

Everything is proved outright.
-/

namespace VOA.TwoSeries

open VOA.SocleDual VOA.SocleEval VOA.CyclicEval VOA.InvariantSymbol MvPolynomial Module
open VOA.ConcreteHodge VOA.KoszulConcrete VOA.SymbolModel VOA.GradedUnitaryCohomology
open VirGradedUnitarity Sl2CosetConcrete

noncomputable section

/-! ### The route-(a) package -/

/-- The image of the Cartan ideal `I_N` on a module with commuting positive Cartan modes. -/
def modelCart {M : Type*} [AddCommGroup M] [Module ℂ M] (ρ : Fin 3 × ℕ → Module.End ℂ M)
    (hc : CartanCommute ρ bHPos) (N : ℕ) : Submodule ℂ M :=
  ⨆ (F : MvPolynomial ℕ ℂ) (_ : F ∈ cartanIdeal N), LinearMap.range (cartanCalc ρ bHPos hc F)

/-- **A strict socle model of `gr_r L_{k_n}`** (route (a)): a model module with the socle data of
the socle words of size `r`, and an injective, grading-preserving intertwiner from the actual
`gr_r L_{k_n}`. -/
structure TwoSeriesSocleModel (n r : ℕ) where
  M : Type
  [acg : AddCommGroup M]
  [mod : Module ℂ M]
  ρ : Fin 3 × ℕ → Module.End ℂ M
  deg : ℤ → Submodule ℂ M
  fin : ∀ d, FiniteDimensional ℂ (deg d)
  comm : CartanCommute ρ bHPos
  spectrum : SocleSpectrum ρ deg (fun i : SocleIndex n r => socleDegree i.2.1)
    (fun i => (i.1 : ℕ)) (modelCart ρ comm)
  f : GrA (twoSeriesLevels n) r →ₗ[ℂ] M
  injective : Function.Injective f
  intertwine : ∀ k, f ∘ₗ grRho (twoSeriesLevels n) r k = ρ k ∘ₗ f
  degree : ∀ d, ∀ m ∈ grDeg (twoSeriesLevels n) r d, f m ∈ deg d

attribute [instance] TwoSeriesSocleModel.acg TwoSeriesSocleModel.mod

theorem TwoSeriesSocleModel.map_cart {n r : ℕ} (S : TwoSeriesSocleModel n r) (N : ℕ) :
    ∀ m ∈ grCart (twoSeriesLevels n) r N, S.f m ∈ modelCart S.ρ S.comm N := by
  intro m hm
  have hle : grCart (twoSeriesLevels n) r N ≤ (modelCart S.ρ S.comm N).comap S.f := by
    refine iSup_le fun F => iSup_le fun hF => ?_
    rintro _ ⟨y, rfl⟩
    rw [Submodule.mem_comap]
    have h := algHom_comp_eq_of_X (grCartanCalc (twoSeriesLevels n) r)
      (cartanCalc S.ρ bHPos S.comm) S.f (fun i => by
        rw [grCartanCalc_X, cartanCalc_X, LinearMap.comp_neg, LinearMap.neg_comp,
          S.intertwine]) F
    have h' := LinearMap.congr_fun h y
    simp only [LinearMap.comp_apply] at h'
    rw [h']
    exact Submodule.mem_iSup_of_mem F (Submodule.mem_iSup_of_mem hF
      (LinearMap.mem_range_self _ _))
  exact hle hm

/-- **A strict socle model gives the socle data of `gr_r L_{k_n}`.** -/
theorem TwoSeriesSocleModel.grSpectrum {n r : ℕ} (S : TwoSeriesSocleModel n r) :
    SocleSpectrum (grRho (twoSeriesLevels n) r) (grDeg (twoSeriesLevels n) r)
      (fun i : SocleIndex n r => socleDegree i.2.1) (fun i => (i.1 : ℕ))
      (grCart (twoSeriesLevels n) r) :=
  S.spectrum.comap S.fin S.f S.injective S.intertwine S.degree S.map_cart

/-- **Strict socle models in every filtration degree give `TwoSeriesSocleSpectrum n`.** -/
theorem twoSeriesSocleSpectrum_of_models {n : ℕ} (Mod : ∀ r, TwoSeriesSocleModel n r) :
    TwoSeriesSocleSpectrum n :=
  ⟨fun r => (Mod r).grSpectrum.rank_le, fun r => (Mod r).grSpectrum.transverse⟩

/-- **Affine GU ⇒ GU of `M(2, 2n+3)` from strict socle models.**  `#print axioms`-clean,
conditional on `hA` and `Mod` (route (a): strict symbol maps into models with socle data). -/
theorem twoSeries_gradedUnitary_of_socleModels (n : ℕ)
    (hA : GradedUnitary (affineForm (twoSeriesLevels n)) (affineRealStructure (twoSeriesLevels n))
      (affineFlag (twoSeriesLevels n)))
    (Mod : ∀ r, TwoSeriesSocleModel n r) :
    VirGradedUnitary (twoSeriesLevels n).c (targetRealStructure (twoSeriesLevels n)) :=
  twoSeries_gradedUnitary_of_socleSpectrum n hA (twoSeriesSocleSpectrum_of_models Mod)

/-! ### The model at `n = 1`: the jet image `A_r` -/

theorem jetDer_shiftVar (k : Fin 3 × ℕ) (b : Fin 2) (m j : ℕ) :
    jetDer k (shiftVar b m j) = if m ≤ j then jetDerVal k (b, j - m) else 0 := by
  unfold shiftVar
  split_ifs <;> simp [jetDer_X]

theorem shiftVar_sub (b : Fin 2) (a m j : ℕ) (h : m ≤ j) :
    shiftVar b a (j - m) = shiftVar b (m + a) j := by
  unfold shiftVar
  by_cases h1 : a ≤ j - m
  · rw [if_pos h1, if_pos (by omega)]
    congr 2
    omega
  · rw [if_neg h1, if_neg (by omega)]

theorem jetDer_zero_zero_X (c : Fin 2) (j : ℕ) :
    jetDer (0, 0) (X (c, j)) = if c = 1 then X (0, j) else 0 := by
  rw [jetDer_X]
  simp [jetDerVal, shiftVar]

/-- `[e_m, e₀] = 0` on the jet ring. -/
theorem jetComm_e (m : ℕ) (Q : JetPoly) :
    jetDer (0, m) (jetDer (0, 0) Q) = jetDer (0, 0) (jetDer (0, m) Q) := by
  have h : ⁅jetDer (0, m), jetDer (0, 0)⁆ = 0 := by
    apply MvPolynomial.derivation_ext
    rintro ⟨c, j⟩
    rw [Derivation.commutator_apply, Derivation.zero_apply, jetDer_zero_zero_X, jetDer_X]
    fin_cases c
    · simp [jetDerVal]
    · simp only [jetDerVal]
      simp [jetDer_shiftVar, jetDerVal]
  have := congrArg (fun D : Derivation ℂ JetPoly JetPoly => D Q) h
  simp only [Derivation.commutator_apply, Derivation.zero_apply] at this
  exact sub_eq_zero.mp this

/-- `[f_m, e₀] = -h_m` on the jet ring. -/
theorem jetComm_f (m : ℕ) (Q : JetPoly) :
    jetDer (1, m) (jetDer (0, 0) Q) = jetDer (0, 0) (jetDer (1, m) Q) - jetDer (2, m) Q := by
  have h : ⁅jetDer (1, m), jetDer (0, 0)⁆ = -jetDer (2, m) := by
    apply MvPolynomial.derivation_ext
    rintro ⟨c, j⟩
    rw [Derivation.commutator_apply, Derivation.neg_apply, jetDer_zero_zero_X, jetDer_X,
      jetDer_X]
    fin_cases c
    · simp only [jetDerVal]
      simp only [Fin.isValue, Fin.zero_eta, zero_ne_one, ↓reduceIte, map_zero, one_ne_zero,
        Fin.reduceEq, zero_sub]
      rw [jetDer_shiftVar]
      unfold shiftVar
      split_ifs <;> simp_all [jetDerVal, shiftVar]
    · simp only [jetDerVal]
      simp only [Fin.isValue, Fin.mk_one, ↓reduceIte, one_ne_zero, map_zero, sub_zero,
        Fin.reduceEq, neg_neg]
      rw [jetDer_X]
      simp [jetDerVal]
  have := congrArg (fun D : Derivation ℂ JetPoly JetPoly => D Q) h
  simp only [Derivation.commutator_apply, Derivation.neg_apply] at this
  rw [sub_eq_iff_eq_add'.mp this, sub_eq_add_neg]

/-- `[h_m, e₀] = 2 e_m` on the jet ring. -/
theorem jetComm_h (m : ℕ) (Q : JetPoly) :
    jetDer (2, m) (jetDer (0, 0) Q) =
      jetDer (0, 0) (jetDer (2, m) Q) + (2 : ℂ) • jetDer (0, m) Q := by
  have h : ⁅jetDer (2, m), jetDer (0, 0)⁆ = (2 : ℂ) • jetDer (0, m) := by
    apply MvPolynomial.derivation_ext
    rintro ⟨c, j⟩
    rw [Derivation.commutator_apply, Derivation.smul_apply, jetDer_zero_zero_X, jetDer_X,
      jetDer_X]
    fin_cases c
    · simp only [jetDerVal]
      simp only [Fin.isValue, Fin.zero_eta, zero_ne_one, ↓reduceIte, map_zero, Fin.reduceEq,
        zero_sub, smul_zero]
      rw [jetDer_shiftVar]
      split_ifs <;> simp [jetDerVal]
    · simp only [jetDerVal]
      simp only [Fin.isValue, Fin.mk_one, ↓reduceIte, Fin.reduceEq, one_ne_zero]
      rw [jetDer_X, map_neg, jetDer_shiftVar]
      unfold shiftVar
      split_ifs <;> simp_all [jetDerVal, shiftVar, two_smul]
  have := congrArg (fun D : Derivation ℂ JetPoly JetPoly => D Q) h
  simp only [Derivation.commutator_apply, Derivation.smul_apply] at this
  exact sub_eq_iff_eq_add'.mp this

/-- **The commutation facts with `e₀` on the jet image `A_r`.** -/
theorem jetZeroModeRel (r : ℕ) : ZeroModeRel (jetImgRho r) where
  pos a j x hx := by
    apply Subtype.ext
    have hx' : ∀ b : Fin 3, jetDer (b, j + 1) (x : JetPoly) = 0 := fun b =>
      congrArg Subtype.val (hx b)
    simp only [jetImgRho_coe, ZeroMemClass.coe_zero]
    fin_cases a
    · change jetDer (0, j + 1) (jetDer (0, 0) (x : JetPoly)) = 0
      rw [jetComm_e, hx' 0, map_zero]
    · change jetDer (1, j + 1) (jetDer (0, 0) (x : JetPoly)) = 0
      rw [jetComm_f, hx' 1, hx' 2, map_zero, sub_zero]
    · change jetDer (2, j + 1) (jetDer (0, 0) (x : JetPoly)) = 0
      rw [jetComm_h, hx' 2, hx' 0, map_zero, smul_zero, add_zero]
  fe x := Subtype.ext (by
    simp only [jetImgRho_coe, AddSubgroupClass.coe_sub]
    exact jetComm_f 0 x)
  he x := Subtype.ext (by
    simp only [jetImgRho_coe, AddMemClass.coe_add, SetLike.val_smul]
    exact jetComm_h 0 x)

/-- **The socle data of the jet image `A_r`**, the model `S_1`, proved outright. -/
theorem jetSocleSpectrum (r : ℕ) :
    SocleSpectrum (jetImgRho r) (jetDeg r) (fun i : SocleIndex 1 r => socleDegree i.2.1)
      (fun i => (i.1 : ℕ)) (modelCart (jetImgRho r) (jetImg_cartanCommute r)) :=
  socleSpectrum_of_cyclic (jetZeroModeRel r) (jetCyclicVector r).w (jetCyclicVector r).cyclic
    (jetCyclicVector r).supp (jetCyclicVector r).charge
    (fun c x hx hc => jetImage_charge_bound x.2 (fun h => hx (Subtype.ext h))
      (by simpa using congrArg Subtype.val hc))
    (by
      intro m hm
      refine (iSup_le fun F => iSup_le fun hF => ?_ :
        modelCart (jetImgRho r) (jetImg_cartanCommute r) r ≤ LinearMap.ker (jetCyclicVector r).w)
        hm
      rintro _ ⟨y, rfl⟩
      exact LinearMap.congr_fun ((jetCyclicVector r).cartan F hF) y)
    (levelOneSocleLabel r) (levelOneSocleLabel_degree r) rfl

open VOA.AdamovicSymbol in
/-- **The route-(a) package at `n = 1` is inhabited**: the jet image `A_r` with its proved
socle data, and the proved strict maps `gr_r L_{-4/3} ↪ A_r`. -/
def levelOneSocleModel (r : ℕ) : TwoSeriesSocleModel 1 r where
  M := jetImage r
  ρ := jetImgRho r
  deg := jetDeg r
  fin d := (jetLeadingSymbols (jetLeadingSymbols_of_descends fun r =>
    Desc.wordSymbolDescends (r + 2)) r).jetDeg_finiteDimensional d
  comm := jetImg_cartanCommute r
  spectrum := jetSocleSpectrum r
  f := (levelOneGrJetStrict r).f
  injective := (levelOneGrJetStrict r).injective
  intertwine := (levelOneGrJetStrict r).intertwine
  degree := (levelOneGrJetStrict r).degree

/-- The `n = 1` socle data again, through route (a). -/
theorem twoSeriesSocleSpectrum_one_viaModel : TwoSeriesSocleSpectrum 1 :=
  twoSeriesSocleSpectrum_of_models levelOneSocleModel

end

end VOA.TwoSeries
