import VOA.Examples.AffineSl2BoundaryC2Propagation
import VOA.Examples.AffineSl2Strong

/-!
# A current-PBW route to the hard boundary affine `C₂` upper bound

This file proves the `SingularC2PBWUpper` input from positive-current
singularity.  A nonpositive current word is a word in modes `Jᵃ_m` with `m ≤ 0`.  Modulo `C₂`,
only two kinds of letters survive:

* `m = -1`, which is multiplication by the current symbol;
* `m = 0`, which is the horizontal Poisson bracket.

Modes `m ≤ -2` vanish.  Since the boundary ideal is stable under the horizontal `sl₂`
action, every nonpositive current descendant of a vector whose symbol is in the boundary ideal
again has symbol in that ideal.

The central theorem `singularCurrentPBWSpanning_of_SingP` proves that the VOA ideal generated by
a positive-current-singular vector is spanned by its nonpositive current descendants.  The proof
has two parts.  First, the affine commutator moves any positive mode through a nonpositive word,
with induction on word length.  Second, reconstruction from the current fields upgrades current
stability of that span to closure under every VOA mode.  Thus the result uses neither PBW linear
independence nor the desired `C₂` presentation or classical freeness.
-/

namespace VOA

open VertexOperatorAlgebra

namespace AffineSl2BoundaryC2

open VOA.AffineVOA
open VOA.AffineVOA.Inst
open VOA.QuasiLisseSl2
open VOA.SingVec
open VOA.Sl2Pres
open VOA.Sl2Symbol

noncomputable section

variable (k : ℂ) (hk : k + 2 ≠ 0)

private abbrev W : VertexOperatorAlgebra (WakModule k) := affineSl2VOA_closed k hk

/-! ## The other two universal horizontal compatibilities -/

/-- The universal affine symbol map intertwines the classical raising derivation with the
Poisson bracket by the current class `[e]`. -/
theorem symbolAlg_adE_compat (p : SymSl2) :
    symbolAlg k hk (adE p) =
      A₂bracket (W k hk) (eCl k hk) (symbolAlg k hk p) :=
  adCompat_of_generators (W k hk) (symbolAlg k hk) adE adE_mul
    (fun c => by rw [adE]; exact adOf_C _ _ _ _ c) (eCl k hk) (by
      intro i
      fin_cases i
      · change symbolAlg k hk (adE eSym) =
          A₂bracket (W k hk) (eCl k hk) (symbolAlg k hk eSym)
        rw [adE_e, map_zero, symbolAlg_eSym, A₂bracket_self]
      · change symbolAlg k hk (adE hSym) =
          A₂bracket (W k hk) (eCl k hk) (symbolAlg k hk hSym)
        rw [adE_h, map_smul, symbolAlg_eSym, symbolAlg_hSym, A₂bracket_e_h]
      · change symbolAlg k hk (adE fSym) =
          A₂bracket (W k hk) (eCl k hk) (symbolAlg k hk fSym)
        rw [Sl2Pres.adE_f, symbolAlg_hSym, symbolAlg_fSym, A₂bracket_e_f]) p

/-- The universal affine symbol map intertwines the classical Cartan derivation with the
Poisson bracket by the current class `[h]`. -/
theorem symbolAlg_adH_compat (p : SymSl2) :
    symbolAlg k hk (adH p) =
      A₂bracket (W k hk) (hCl k hk) (symbolAlg k hk p) :=
  adCompat_of_generators (W k hk) (symbolAlg k hk) adH adH_mul
    (fun c => by rw [adH]; exact adOf_C _ _ _ _ c) (hCl k hk) (by
      intro i
      fin_cases i
      · change symbolAlg k hk (adH eSym) =
          A₂bracket (W k hk) (hCl k hk) (symbolAlg k hk eSym)
        rw [adH_e, map_smul, symbolAlg_eSym, A₂bracket_h_e]
      · change symbolAlg k hk (adH hSym) =
          A₂bracket (W k hk) (hCl k hk) (symbolAlg k hk hSym)
        rw [adH_h, map_zero, symbolAlg_hSym, A₂bracket_self]
      · change symbolAlg k hk (adH fSym) =
          A₂bracket (W k hk) (hCl k hk) (symbolAlg k hk fSym)
        rw [adH_f, map_smul, symbolAlg_fSym, A₂bracket_h_f]) p

/-! ## The boundary image ideal is horizontally Poisson-stable -/

/-- The image of the boundary ideal is stable under Poisson bracketing by any of the three
current classes.  The affine current order is `e, f, h`, whereas `SymSl2` uses `e, h, f`;
the three cases below make that coordinate swap explicit. -/
theorem boundaryImage_bracket_current_mem (n : ℕ) (a : Fin 3)
    (x : A₂ (W k hk))
    (hx : x ∈ Ideal.map (symbolAlg k hk) (boundaryIdeal n)) :
    A₂bracket (W k hk) (mk₂ (W k hk) (currentState k a)) x ∈
      Ideal.map (symbolAlg k hk) (boundaryIdeal n) := by
  rw [Ideal.mem_map_iff_of_surjective _ (symbolAlg_surjective k hk)] at hx
  obtain ⟨q, hq, rfl⟩ := hx
  fin_cases a
  · change A₂bracket (W k hk) (eCl k hk) (symbolAlg k hk q) ∈ _
    rw [← symbolAlg_adE_compat k hk]
    exact Ideal.mem_map_of_mem _ (adE_boundaryIdeal n q hq)
  · change A₂bracket (W k hk) (fCl k hk) (symbolAlg k hk q) ∈ _
    rw [← symbolAlg_adF_compat k hk]
    exact Ideal.mem_map_of_mem _ (adF_boundaryIdeal n q hq)
  · change A₂bracket (W k hk) (hCl k hk) (symbolAlg k hk q) ∈ _
    rw [← symbolAlg_adH_compat k hk]
    exact Ideal.mem_map_of_mem _ (adH_boundaryIdeal n q hq)

/-! ## Nonpositive current descendants -/

/-- Apply a list of affine current modes, from the head on the outside. -/
def currentWord (l : List (Fin 3 × ℤ)) (t : WakModule k) : WakModule k :=
  l.foldr (fun am v => J k am.1 am.2 v) t

@[simp] theorem currentWord_nil (t : WakModule k) : currentWord k [] t = t := rfl

@[simp] theorem currentWord_cons (a : Fin 3) (m : ℤ) (l : List (Fin 3 × ℤ))
    (t : WakModule k) :
    currentWord k ((a, m) :: l) t = J k a m (currentWord k l t) := rfl

/-- A current word is nonpositive when every mode appearing in it has index at most zero. -/
def IsNonpositiveCurrentWord (l : List (Fin 3 × ℤ)) : Prop :=
  ∀ am ∈ l, am.2 ≤ 0

/-- The span of all nonpositive current descendants of `s`. -/
def nonpositiveCurrentSpan (s : WakModule k) : Submodule ℂ (WakModule k) :=
  Submodule.span ℂ {x | ∃ l : List (Fin 3 × ℤ),
    IsNonpositiveCurrentWord l ∧ currentWord k l s = x}

/-- The sharp representation-theory input: PBW reordering moves every positive current mode
to the right, where singularity kills it, leaving nonpositive current words.

This predicate is deliberately independent of `C₂`, the boundary ideal, and classical
freeness. -/
def SingularCurrentPBWSpanning (s : WakModule k) : Prop :=
  idealGen (W k hk) s ≤ nonpositiveCurrentSpan k s

/-! ## Current-mode straightening over a current-singular vector -/

/-- A nonpositive current mode preserves the span of nonpositive current descendants. -/
theorem currentMode_mem_nonpositiveCurrentSpan_of_nonpositive
    (s : WakModule k) (a : Fin 3) (m : ℤ) (hm : m ≤ 0) {x : WakModule k}
    (hx : x ∈ nonpositiveCurrentSpan k s) :
    J k a m x ∈ nonpositiveCurrentSpan k s := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨l, hl, rfl⟩ := hx
      exact Submodule.subset_span ⟨(a, m) :: l, by
        intro bm hbm
        simp only [List.mem_cons] at hbm
        rcases hbm with rfl | hbm
        · exact hm
        · exact hl bm hbm, rfl⟩
  | zero =>
      rw [map_zero]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  | smul c x _ hx =>
      rw [map_smul]
      exact Submodule.smul_mem _ c hx

/-- **Affine-current straightening, without a PBW-independence hypothesis.**

If every strictly positive current mode annihilates `s`, then applying an arbitrary current
mode to a nonpositive current word based at `s` lands in the span of such words.  For a positive
outer mode, commute it through the first nonpositive letter.  The affine commutator produces a
single current mode on the shorter tail and a scalar multiple of that tail, while the reordered
term is obtained by applying the nonpositive first letter to the induction hypothesis.

This is the spanning half of the triangular-decomposition argument.  It uses the exact affine
commutator but no linear independence and no `C₂` statement. -/
theorem currentMode_currentWord_mem_nonpositiveCurrentSpan
    (hk : k + 2 ≠ 0) (s : WakModule k) (hsing : Strong.SingP k s) :
    ∀ (l : List (Fin 3 × ℤ)), IsNonpositiveCurrentWord l →
      ∀ (a : Fin 3) (m : ℤ),
        J k a m (currentWord k l s) ∈ nonpositiveCurrentSpan k s
  | [], _, a, m => by
      by_cases hm : m ≤ 0
      · exact Submodule.subset_span ⟨[(a, m)], by simp [IsNonpositiveCurrentWord, hm], rfl⟩
      · rw [currentWord_nil, hsing a m (by omega)]
        exact Submodule.zero_mem _
  | (b, n) :: l, hl, a, m => by
      have hn : n ≤ 0 := hl (b, n) (by simp)
      have htail : IsNonpositiveCurrentWord l := by
        intro cm hcm
        exact hl cm (by simp [hcm])
      by_cases hm : m ≤ 0
      · exact Submodule.subset_span ⟨(a, m) :: (b, n) :: l, by
          intro cm hcm
          simp only [List.mem_cons] at hcm
          rcases hcm with rfl | hcm
          · exact hm
          · exact hl cm (by simpa only [List.mem_cons] using hcm), rfl⟩
      · have hcomm := smul_currentState_comm k hk a b m n (currentWord k l s)
        rw [sub_eq_iff_eq_add] at hcomm
        simp only [smul_currentState_eq_J] at hcomm
        rw [currentWord_cons, hcomm]
        apply Submodule.add_mem
        · apply Submodule.add_mem
          · exact Submodule.sum_mem _ fun c _ =>
              Submodule.smul_mem _ _
                (currentMode_currentWord_mem_nonpositiveCurrentSpan hk s hsing l htail c (m + n))
          · split_ifs
            · exact Submodule.smul_mem _ _
                (Submodule.subset_span ⟨l, htail, rfl⟩)
            · exact Submodule.zero_mem _
        · exact currentMode_mem_nonpositiveCurrentSpan_of_nonpositive k s b n hn
            (currentMode_currentWord_mem_nonpositiveCurrentSpan hk s hsing l htail a m)

/-- Under positive-current annihilation, the entire nonpositive-current span is stable under
every current mode. -/
theorem nonpositiveCurrentSpan_currentMode_stable
    (hk : k + 2 ≠ 0) (s : WakModule k) (hsing : Strong.SingP k s)
    (a : Fin 3) (m : ℤ) {x : WakModule k}
    (hx : x ∈ nonpositiveCurrentSpan k s) :
    J k a m x ∈ nonpositiveCurrentSpan k s := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨l, hl, rfl⟩ := hx
      exact currentMode_currentWord_mem_nonpositiveCurrentSpan k hk s hsing l hl a m
  | zero =>
      rw [map_zero]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  | smul c x _ hx =>
      rw [map_smul]
      exact Submodule.smul_mem _ c hx

/-! ## From current stability to a VOA ideal -/

/-- Coefficientwise stability of a formal distribution on the affine vacuum module. -/
def CurrentCoeffStable (I : Submodule ℂ (WakModule k))
    (A : FormalDist (Module.End ℂ (WakModule k))) : Prop :=
  ∀ (j : ℤ) (v : WakModule k), v ∈ I → A j v ∈ I

namespace CurrentCoeffStable

theorem smul {I : Submodule ℂ (WakModule k)}
    {A : FormalDist (Module.End ℂ (WakModule k))} (hA : CurrentCoeffStable k I A)
    (c : ℂ) : CurrentCoeffStable k I (c • A) := by
  intro j v hv
  change (c • A j) v ∈ I
  rw [LinearMap.smul_apply]
  exact Submodule.smul_mem _ _ (hA j v hv)

theorem deriv {I : Submodule ℂ (WakModule k)}
    {A : FormalDist (Module.End ℂ (WakModule k))} (hA : CurrentCoeffStable k I A) :
    CurrentCoeffStable k I (VOA.deriv A) := by
  intro j v hv
  rw [deriv_apply]
  change (j + 1 : ℤ) • A (j + 1) v ∈ I
  exact zsmul_mem (hA (j + 1) v hv) _

theorem deriv_iterate {I : Submodule ℂ (WakModule k)}
    {A : FormalDist (Module.End ℂ (WakModule k))} (hA : CurrentCoeffStable k I A) :
    ∀ i : ℕ, CurrentCoeffStable k I (VOA.deriv^[i] A)
  | 0 => hA
  | i + 1 => by
      rw [Function.iterate_succ_apply']
      exact (hA.deriv_iterate i).deriv

/-- Normal ordering preserves coefficientwise stability. -/
theorem nprod {I : Submodule ℂ (WakModule k)}
    {A B : FormalDist (Module.End ℂ (WakModule k))}
    (hAf : IsField A) (hBf : IsField B)
    (hA : CurrentCoeffStable k I A) (hB : CurrentCoeffStable k I B) :
    CurrentCoeffStable k I (VOA.nprod hAf hBf) := by
  intro j v hv
  rw [nprod_apply]
  refine QuotVOA.finsum_mem_submodule I _ fun m => ?_
  rw [normalOrdered_apply]
  split_ifs
  · rw [Module.End.mul_apply]
    exact hA m _ (hB (j - m) v hv)
  · rw [Module.End.mul_apply]
    exact hB (j - m) _ (hA m v hv)

end CurrentCoeffStable

/-- Stability under all affine current modes is coefficientwise stability under a current
field. -/
theorem currentCoeffStable_Jfield_of_currentMode_stable
    {I : Submodule ℂ (WakModule k)}
    (hcur : ∀ (a : Fin 3) (m : ℤ) (v : WakModule k), v ∈ I → J k a m v ∈ I)
    (a : Fin 3) : CurrentCoeffStable k I (Jfield k a) := by
  intro j v hv
  rw [Jfield_apply]
  exact hcur a (-j - 1) v hv

/-- Hence the differentiated, factorial-normalized current fields are coefficientwise stable. -/
theorem currentCoeffStable_genFieldA_of_currentMode_stable
    {I : Submodule ℂ (WakModule k)}
    (hcur : ∀ (a : Fin 3) (m : ℤ) (v : WakModule k), v ∈ I → J k a m v ∈ I)
    (a : Fin 3) (i : ℕ) : CurrentCoeffStable k I (genFieldA k a i) := by
  rw [genFieldA]
  exact CurrentCoeffStable.smul k
    (CurrentCoeffStable.deriv_iterate k
      (currentCoeffStable_Jfield_of_currentMode_stable k hcur a) i) _

/-- The identity field preserves every subspace. -/
theorem currentCoeffStable_idFieldA (I : Submodule ℂ (WakModule k)) :
    CurrentCoeffStable k I (idFieldA k) := by
  intro j v hv
  rw [idFieldA]
  split_ifs
  · exact hv
  · exact Submodule.zero_mem _

/-- Every reconstructed affine word field is coefficientwise stable under a current-stable
subspace. -/
theorem currentCoeffStable_YwordA_of_currentMode_stable
    {I : Submodule ℂ (WakModule k)}
    (hcur : ∀ (a : Fin 3) (m : ℤ) (v : WakModule k), v ∈ I → J k a m v ∈ I) :
    ∀ l : List (Fin 3 × ℕ), CurrentCoeffStable k I (YwordA k l)
  | [] => by
      rw [YwordA_nil]
      exact currentCoeffStable_idFieldA k I
  | ai :: l => by
      rw [YwordA_cons]
      exact CurrentCoeffStable.nprod k _ _
        (currentCoeffStable_genFieldA_of_currentMode_stable k hcur ai.1 ai.2)
        (currentCoeffStable_YwordA_of_currentMode_stable hcur l)

/-- Current stability propagates from the generating fields to `Y(u,z)` for every affine
vacuum-module state `u`, because the reconstructed word states span. -/
theorem currentCoeffStable_YA_of_currentMode_stable
    (hk : k + 2 ≠ 0) {I : Submodule ℂ (WakModule k)}
    (hcur : ∀ (a : Fin 3) (m : ℤ) (v : WakModule k), v ∈ I → J k a m v ∈ I)
    (u : WakModule k) : CurrentCoeffStable k I (YA k hk u) := by
  have hu : u ∈ Submodule.span ℂ (Set.range (wordStateA k)) := by
    rw [wordStateA_span k]
    exact Submodule.mem_top
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨l, rfl⟩ := hu
      rw [YA_wordState]
      exact currentCoeffStable_YwordA_of_currentMode_stable k hcur l
  | zero =>
      intro j v _
      rw [map_zero]
      change (0 : Module.End ℂ (WakModule k)) v ∈ I
      rw [LinearMap.zero_apply]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      intro j v hv
      rw [map_add]
      change (YA k hk x j + YA k hk y j) v ∈ I
      rw [LinearMap.add_apply]
      exact Submodule.add_mem _ (hx j v hv) (hy j v hv)
  | smul c x _ hx =>
      intro j v hv
      rw [map_smul]
      change (c • YA k hk x j) v ∈ I
      rw [LinearMap.smul_apply]
      exact Submodule.smul_mem _ _ (hx j v hv)

/-- **Strong generation in ideal form.** Every subspace stable under all affine-current modes is
a VOA ideal of the reconstructed universal affine `sl₂` VOA. -/
theorem isIdeal_of_currentMode_stable
    (hk : k + 2 ≠ 0) {I : Submodule ℂ (WakModule k)}
    (hcur : ∀ (a : Fin 3) (m : ℤ) (v : WakModule k), v ∈ I → J k a m v ∈ I) :
    (W k hk).IsIdeal I := by
  intro u v n hv
  rw [closed_smul, mode_apply]
  exact currentCoeffStable_YA_of_currentMode_stable k hk hcur u (-n - 1) v hv

/-- The nonpositive-current descendants of a positive-current-singular vector form a VOA
ideal. -/
theorem nonpositiveCurrentSpan_isIdeal_of_SingP
    (hk : k + 2 ≠ 0) (s : WakModule k) (hsing : Strong.SingP k s) :
    (W k hk).IsIdeal (nonpositiveCurrentSpan k s) :=
  isIdeal_of_currentMode_stable k hk fun a m v hv =>
    nonpositiveCurrentSpan_currentMode_stable k hk s hsing a m hv

/-- The base vector is a nonpositive current descendant, represented by the empty word. -/
theorem mem_nonpositiveCurrentSpan_self (s : WakModule k) :
    s ∈ nonpositiveCurrentSpan k s :=
  Submodule.subset_span ⟨[], by simp [IsNonpositiveCurrentWord], rfl⟩

/-- **The former PBW-spanning gate follows from positive-current singularity.**

The ideal generated by `s` lies in the nonpositive-current span because that span is itself a
VOA ideal and contains `s`.  Thus no independent `SingularCurrentPBWSpanning` hypothesis remains:
the only model-specific input is the expected singular-vector identity `Strong.SingP k s`. -/
theorem singularCurrentPBWSpanning_of_SingP
    (hk : k + 2 ≠ 0) (s : WakModule k) (hsing : Strong.SingP k s) :
    SingularCurrentPBWSpanning k hk s :=
  idealGen_le (nonpositiveCurrentSpan_isIdeal_of_SingP k hk s hsing)
    (mem_nonpositiveCurrentSpan_self k s)

/-- Every nonpositive current word preserves membership of the `C₂` symbol in the boundary
ideal image. -/
theorem mk₂_currentWord_mem_boundaryImage (n : ℕ) (s : WakModule k)
    (hs : mk₂ (W k hk) s ∈ Ideal.map (symbolAlg k hk) (boundaryIdeal n)) :
    ∀ (l : List (Fin 3 × ℤ)), IsNonpositiveCurrentWord l →
      mk₂ (W k hk) (currentWord k l s) ∈
        Ideal.map (symbolAlg k hk) (boundaryIdeal n) := by
  intro l hl
  induction l with
  | nil => simpa using hs
  | cons am l ih =>
      obtain ⟨a, m⟩ := am
      have hm : m ≤ 0 := hl (a, m) (by simp)
      have hl' : IsNonpositiveCurrentWord l := by
        intro bm hbm
        exact hl bm (by simp [hbm])
      have hi := ih hl'
      rcases lt_trichotomy m (-1) with hm2 | hm1 | hm0
      · rw [currentWord_cons, ← smul_currentState_eq_J k hk,
          (mk₂_eq_zero_iff (W k hk)).mpr
            (smul_le_neg_two_mem_O₂ (W k hk) (currentState k a)
              (currentWord k l s) (by omega))]
        exact Ideal.zero_mem _
      · rw [hm1, currentWord_cons, ← smul_currentState_eq_J k hk]
        change mk₂ (W k hk)
          (poissonMul (W k hk) (currentState k a) (currentWord k l s)) ∈ _
        rw [← A₂_mul_mk]
        exact Ideal.mul_mem_left _ _ hi
      · have hmzero : m = 0 := by omega
        rw [hmzero, currentWord_cons, ← smul_currentState_eq_J k hk]
        change mk₂ (W k hk)
          (poissonBracket (W k hk) (currentState k a) (currentWord k l s)) ∈ _
        rw [← A₂bracket_mk]
        exact boundaryImage_bracket_current_mem k hk n a _ hi

/-- The whole nonpositive-current span has symbol in the boundary ideal image. -/
theorem mk₂_mem_boundaryImage_of_mem_nonpositiveCurrentSpan
    (n : ℕ) (s x : WakModule k)
    (hs : mk₂ (W k hk) s ∈ Ideal.map (symbolAlg k hk) (boundaryIdeal n))
    (hx : x ∈ nonpositiveCurrentSpan k s) :
    mk₂ (W k hk) x ∈ Ideal.map (symbolAlg k hk) (boundaryIdeal n) := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨l, hl, rfl⟩ := hy
      exact mk₂_currentWord_mem_boundaryImage k hk n s hs l hl
  | zero => simpa using Ideal.zero_mem (Ideal.map (symbolAlg k hk) (boundaryIdeal n))
  | add x y _ _ hx hy =>
      rw [map_add]
      exact Ideal.add_mem _ hx hy
  | smul c x _ hx =>
      rw [map_smul]
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hx

/-- PBW reordering into nonpositive current descendants implies the hard representative upper
bound `SingularC2PBWUpper`. -/
theorem singularC2PBWUpper_of_currentPBWSpanning
    (n : ℕ) (s : WakModule k)
    (hs : mk₂ (W k hk) s ∈ Ideal.map (symbolAlg k hk) (boundaryIdeal n))
    (hPBW : SingularCurrentPBWSpanning k hk s) :
    SingularC2PBWUpper k hk n s := by
  intro x hx
  have himage := mk₂_mem_boundaryImage_of_mem_nonpositiveCurrentSpan k hk n s x hs (hPBW hx)
  rw [Ideal.mem_map_iff_of_surjective _ (symbolAlg_surjective k hk)] at himage
  obtain ⟨q, hq, hqx⟩ := himage
  exact ⟨q, hq, hqx.symm⟩

/-- Positive-current singularity discharges the current-PBW gate in the representative upper
bound. -/
theorem singularC2PBWUpper_of_SingP
    (n : ℕ) (s : WakModule k)
    (hs : mk₂ (W k hk) s ∈ Ideal.map (symbolAlg k hk) (boundaryIdeal n))
    (hsing : Strong.SingP k s) :
    SingularC2PBWUpper k hk n s :=
  singularC2PBWUpper_of_currentPBWSpanning k hk n s hs
    (singularCurrentPBWSpanning_of_SingP k hk s hsing)

/-- A nonzero highest-symbol identity supplies the base membership needed by the PBW reduction. -/
theorem singularC2PBWUpper_of_highestSymbol_and_currentPBWSpanning
    (n : ℕ) (s : WakModule k) (c : ℂ) (hc : c ≠ 0)
    (hsymbol : mk₂ (W k hk) s = c • symbolAlg k hk (eSym * casSym ^ n))
    (hPBW : SingularCurrentPBWSpanning k hk s) :
    SingularC2PBWUpper k hk n s := by
  refine singularC2PBWUpper_of_currentPBWSpanning k hk n s ?_ hPBW
  · rw [hsymbol]
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_left _ _
      (Ideal.mem_map_of_mem _ (by
        simpa [mul_comm] using cas_pow_mul_e_mem n))

/-- A highest-symbol identity and positive-current singularity prove the hard boundary `C₂`
representative upper bound, with no independent PBW-spanning assumption. -/
theorem singularC2PBWUpper_of_highestSymbol_and_SingP
    (n : ℕ) (s : WakModule k) (c : ℂ) (hc : c ≠ 0)
    (hsymbol : mk₂ (W k hk) s = c • symbolAlg k hk (eSym * casSym ^ n))
    (hsing : Strong.SingP k s) :
    SingularC2PBWUpper k hk n s :=
  singularC2PBWUpper_of_highestSymbol_and_currentPBWSpanning k hk n s c hc hsymbol
    (singularCurrentPBWSpanning_of_SingP k hk s hsing)

/-- The exact simple-boundary `C₂` presentation needs only the three genuinely
representation-theoretic inputs: the highest-symbol calculation, universal-symbol injectivity,
and generation of the maximal ideal by the positive-current-singular vector.  The former
independent current-PBW upper hypothesis is proved internally. -/
theorem exact_boundary_simple_of_highestSymbol_and_SingP
    (n : ℕ) (s : WakModule k) (c : ℂ) (hc : c ≠ 0)
    (hsymbol : mk₂ (W k hk) s = c • symbolAlg k hk (eSym * casSym ^ n))
    (huniv : Function.Injective (symbolAlg k hk))
    (hmax : QuotVOA.maxGradedIdeal (W k hk) = idealGen (W k hk) s)
    (hsing : Strong.SingP k s) :
    Presentation.IsExactPresentation (boundaryIdeal n)
      (quotientSymbol k hk (QuotVOA.maxGradedIdeal (W k hk))
        (QuotVOA.maxGradedIdeal_isIdeal _) (QuotVOA.maxGradedIdeal_isGradedIdeal _)) :=
  exact_boundary_simple_of_highestSymbol_and_PBWUpper k hk n s c hc hsymbol huniv hmax
    (singularC2PBWUpper_of_highestSymbol_and_SingP k hk n s c hc hsymbol hsing)

end
end AffineSl2BoundaryC2
