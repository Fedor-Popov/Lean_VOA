/-! ## Port of `KoszulResidualEval` -/


variable (hA : GradedUnitary (affineForm L) (affineRealStructure L) (affineFlag L))

/-- The leading creation operators on `A`. -/
def aLeadSet : Set (Module.End ℂ (ASpace L)) := Set.range fun q => (aLead L) hA q

theorem aLeadSet_comm : ∀ a ∈ (aLeadSet L) hA, ∀ b ∈ (aLeadSet L) hA, a * b = b * a := by
  rintro _ ⟨q, rfl⟩ _ ⟨q', rfl⟩
  exact (aLead_comm L) hA q q'

/-- The commutative algebra generated by the leading creation operators. -/
abbrev CA : Subalgebra ℂ (Module.End ℂ (ASpace L)) := Algebra.adjoin ℂ ((aLeadSet L) hA)

instance CA_commRing : CommRing ((CA L) hA) := Algebra.adjoinCommRingOfComm ℂ ((aLeadSet_comm L) hA)

/-- Evaluation at `x_q = -(aLead L) q`. -/
def evalA : MvPolynomial LexLetter ℂ →ₐ[ℂ] (CA L) hA :=
  aeval fun q => -⟨(aLead L) hA q, Algebra.subset_adjoin ⟨q, rfl⟩⟩

theorem evalA_X (q : LexLetter) : ((evalA L) hA (X q) : Module.End ℂ (ASpace L)) = -(aLead L) hA q := by
  simp [evalA]

theorem evalA_comm_aLead (p : MvPolynomial LexLetter ℂ) (q : LexLetter) :
    ((evalA L) hA p : Module.End ℂ (ASpace L)) * (aLead L) hA q = (aLead L) hA q * ((evalA L) hA p) := by
  have h := mul_comm ((evalA L) hA p) (⟨(aLead L) hA q, Algebra.subset_adjoin ⟨q, rfl⟩⟩ : (CA L) hA)
  exact congrArg Subtype.val h

/-- The `U`-symbol evaluation as a map `U → End A`. -/
def evU : (USpace L) →ₗ[ℂ] Module.End ℂ (ASpace L) :=
  ((CA L) hA).val.toLinearMap ∘ₗ ((evalA L) hA).toLinearMap ∘ₗ (PhiU L).toLinearMap

theorem evU_apply (u : (USpace L)) : (evU L) hA u = ((evalA L) hA ((PhiU L) u) : Module.End ℂ (ASpace L)) := rfl

/-- **The symbol evaluation** `(x ⊗ y) ⊗ u ↦ (evalA L) ((PhiU L) u) x ⊗ y`. -/
def ev : (MatterSpace L) →ₗ[ℂ] (ASpace L) ⊗[ℂ] BSpace :=
  TensorProduct.lift ((LinearMap.rTensorHom BSpace ∘ₗ (evU L) hA).flip)

theorem ev_tmul (xy : (ASpace L) ⊗[ℂ] BSpace) (u : (USpace L)) :
    (ev L) hA (xy ⊗ₜ[ℂ] u) = LinearMap.rTensor BSpace ((evU L) hA u) xy := by
  simp [ev]

/-- **`(ev L)` kills the Koszul boundaries**: `(ev L) ∘ u_q = 0`. -/
theorem ev_mLead (q : LexLetter) (m : (MatterSpace L)) : (ev L) hA ((mLead L) hA q m) = 0 := by
  induction m using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, add_zero]
  | tmul xy u =>
      rw [mLead, LinearMap.add_apply, TensorProduct.map_tmul, TensorProduct.map_tmul,
        LinearMap.id_apply, LinearMap.id_apply, map_add, ev_tmul, ev_tmul, evU_apply,
        evU_apply, PhiU_uLead, map_mul, Subalgebra.coe_mul, evalA_X]
      rw [show TensorProduct.map ((aLead L) hA q) (LinearMap.id : Module.End ℂ BSpace) =
        LinearMap.rTensor BSpace ((aLead L) hA q) from rfl]
      rw [← LinearMap.rTensor_comp_apply, ← LinearMap.add_apply, ← LinearMap.rTensor_add]
      have : ((evalA L) hA ((PhiU L) u) : Module.End ℂ (ASpace L)) ∘ₗ (aLead L) hA q +
          (-(aLead L) hA q * ((evalA L) hA ((PhiU L) u) : Module.End ℂ (ASpace L))) = 0 := by
        rw [← Module.End.mul_eq_comp, evalA_comm_aLead, neg_mul, add_neg_cancel]
      rw [this, LinearMap.rTensor_zero, LinearMap.zero_apply]


