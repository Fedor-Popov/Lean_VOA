/-! ### Generic Koszul `H₀` -/

/-! ### Letters of small weight -/

/-- The `U`-constant part. -/
def uConst : Module.End ℂ (USpace L) :=
  (PhiU L).symm.toLinearMap ∘ₗ (homogeneousComponent 0 : MvPolynomial LexLetter ℂ →ₗ[ℂ] _) ∘ₗ
    (PhiU L).toLinearMap

theorem PhiU_uConst (u : (USpace L)) : (PhiU L) ((uConst L) u) = homogeneousComponent 0 ((PhiU L) u) := by
  simp [uConst]

/-- On a layer of weight `≤ N`, the partial-degree-`0` projection is the constant part. -/
theorem uProj_zero_eq_uConst {N : ℕ} {i : (ℤ × ℤ) × ℂ}
    (hw : ∀ w : ℤ, (w : ℂ) = i.2 → w ≤ N) {u : (USpace L)} (hu : u ∈ (uDeg L) i) :
    (uProj L) (sN N) 0 u = (uConst L) u := by
  by_cases hi : ∃ t m, layerIndex t m = i
  · obtain ⟨t, m, rfl⟩ := hi
    have hmN : m ≤ N := hw m rfl
    apply (PhiU L).injective
    rw [PhiU_uProj, PhiU_uConst]
    ext μ
    rw [coeff_sProj, coeff_homogeneousComponent]
    by_cases hμ : μ ∈ ((PhiU L) u).support
    · obtain ⟨-, hen⟩ := (PhiU_support_of_mem L) hu μ hμ
      rw [sdeg_eq_degree (by omega)]
    · rw [notMem_support_iff.mp hμ]; simp
  · push Not at hi
    rw [(uDeg_eq_bot_of L) hi, Submodule.mem_bot] at hu
    rw [hu, map_zero, map_zero]

theorem abDeg_le_weight (j : (ℤ × ℤ) × ℂ) : tensorDeg (aDeg L) bDeg j ≤ (abSVA L).grading j.2 := by
  refine tensorDeg_le wtIndex _ _ (ASVA L).grading BSVA.grading (abSVA L).grading ?_ ?_ ?_ j
  · intro k k' x y hx hy
    exact TensorVA.tmul_mem_tenGrading (ASVA L) BSVA hx (by rwa [add_sub_cancel_left])
  · intro l; exact layerDeg_le_gradingC _ _ l
  · intro l; exact trivialDeg_le_gradingC l

theorem mProj_zero_eq_mConst {N : ℕ} {i : (ℤ × ℤ) × ℂ} {w : ℕ} (hwi : (w : ℂ) = i.2)
    (hwN : w ≤ N) :
    ∀ m ∈ (matterDeg L) i, (mProj L) (sN N) 0 m = TensorProduct.map LinearMap.id (uConst L) m := by
  refine tensorDeg_induction (tensorDeg (aDeg L) bDeg) (uDeg L) i _ (by simp)
    (fun x y hx hy => by beta_reduce at hx hy ⊢; rw [map_add, map_add, hx, hy])
    (fun c x hx => by beta_reduce at hx ⊢; rw [map_smul, map_smul, hx]) ?_
  intro b xy hxy u hu
  by_cases hxy0 : xy = 0
  · subst hxy0; simp
  have hb : ∃ w1 : ℕ, (w1 : ℂ) = b.2 := by
    by_contra h
    have h1 := (abDeg_le_weight L) b hxy
    rw [(abNatSupported L) _ (by rintro ⟨w1, hw1⟩; exact h ⟨w1, hw1⟩), Submodule.mem_bot] at h1
    exact hxy0 h1
  obtain ⟨w1, hw1⟩ := hb
  simp only [mProj, TensorProduct.map_tmul, LinearMap.id_apply]
  congr 1
  refine (uProj_zero_eq_uConst L) (fun w' hw' => ?_) hu
  simp only [Prod.snd_sub, ← hwi, ← hw1] at hw'
  have : (w' : ℤ) = w - w1 := by exact_mod_cast hw'
  omega

/-! ### The evaluation on the BRST space -/

section EVB

variable (hA : GradedUnitary (affineForm L) (affineRealStructure L) (affineFlag L))

/-- The symbol evaluation on the BRST space: `(ev L) ⊗ 1`. -/
def EVB : (BRSTSpace L) →ₗ[ℂ] ((ASpace L) ⊗[ℂ] BSpace) ⊗[ℂ] Sl2GhostSpace :=
  TensorProduct.map ((ev L) hA) LinearMap.id

theorem EVB_dN (s : Finset LexLetter) (v : (BRSTSpace L)) : (EVB L) hA ((dN L) hA s v) = 0 := by
  induction v using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, add_zero]
  | tmul m g =>
      simp only [dN, LinearMap.coe_sum, Finset.sum_apply, map_sum, TensorProduct.map_tmul,
        EVB, LinearMap.id_apply, ev_mLead, TensorProduct.zero_tmul, Finset.sum_const_zero]

/-- The embedding of `A ⊗ B` as the `U`-vacuum part. -/
def jU : (ASpace L) ⊗[ℂ] BSpace →ₗ[ℂ] (MatterSpace L) :=
  (TensorProduct.mk ℂ ((ASpace L) ⊗[ℂ] BSpace) (USpace L)).flip ((PhiU L).symm 1)

theorem uConst_eq (u : (USpace L)) : (uConst L) u = coeff 0 ((PhiU L) u) • (PhiU L).symm 1 := by
  apply (PhiU L).injective
  rw [PhiU_uConst, map_smul, LinearEquiv.apply_symm_apply, homogeneousComponent_zero,
    smul_eq_C_mul, mul_one]

theorem ev_one (xy : (ASpace L) ⊗[ℂ] BSpace) : (ev L) hA (xy ⊗ₜ[ℂ] (PhiU L).symm 1) = xy := by
  rw [ev_tmul, evU_apply, LinearEquiv.apply_symm_apply, map_one, Subalgebra.coe_one,
    Module.End.one_eq_id, LinearMap.rTensor_id, LinearMap.id_apply]

/-- **The `U`-constant part factors through `(ev L)`.** -/
theorem mConst_factor (m : (MatterSpace L)) :
    TensorProduct.map LinearMap.id (uConst L) m =
      (jU L) ((ev L) hA (TensorProduct.map LinearMap.id (uConst L) m)) := by
  induction m using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simp only [map_add]; rw [← hx, ← hy]
  | tmul xy u =>
      rw [TensorProduct.map_tmul, LinearMap.id_apply, uConst_eq, TensorProduct.tmul_smul,
        map_smul, map_smul, ev_one]
      rfl

/-! ### The partial-degree projections on the BRST space -/

/-- The partial-degree projection on the BRST space. -/
def mProjB (N d : ℕ) : Module.End ℂ (BRSTSpace L) :=
  TensorProduct.map ((mProj L) (sN N) d) LinearMap.id

theorem mProjB_mL (N d : ℕ) (v : (BRSTSpace L)) :
    (mProjB L) N d (TensorProduct.map ((mL L) hA (sN N)) LinearMap.id v) =
      (d : ℂ) • (mProjB L) N d v +
        TensorProduct.map ((mLA L) hA (sN N)) LinearMap.id ((mProjB L) N (d + 1) v) := by
  have h := (mProj_mL L) hA (sN N) d
  simp only [mProjB, ← LinearMap.comp_apply, ← TensorProduct.map_comp, h,
    LinearMap.id_comp, TensorProduct.map_add_left, TensorProduct.map_smul_left,
    LinearMap.add_apply, LinearMap.smul_apply, LinearMap.comp_id]

theorem exists_mProjB_bound (N : ℕ) (v : (BRSTSpace L)) :
    ∃ D : ℕ, (∀ d, D < d → (mProjB L) N d v = 0) ∧
      ∑ d ∈ Finset.range (D + 1), (mProjB L) N d v = v := by
  have key : ∃ D : ℕ, ∀ D', D ≤ D' → (∀ d, D' < d → (mProjB L) N d v = 0) ∧
      ∑ d ∈ Finset.range (D' + 1), (mProjB L) N d v = v := by
    induction v using TensorProduct.induction_on with
    | zero => exact ⟨0, fun _ _ => ⟨fun _ _ => map_zero _, by simp⟩⟩
    | tmul m g =>
        obtain ⟨D, hD⟩ := (exists_mProj_bound L) (sN N) m
        refine ⟨D, fun D' hD' => ⟨fun d hd => ?_, ?_⟩⟩
        · rw [mProjB, TensorProduct.map_tmul, (hD D' hD').1 d hd, TensorProduct.zero_tmul]
        · simp only [mProjB, TensorProduct.map_tmul, LinearMap.id_apply, ← TensorProduct.sum_tmul]
          rw [(hD D' hD').2]
    | add v w hv hw =>
        obtain ⟨D1, h1⟩ := hv
        obtain ⟨D2, h2⟩ := hw
        refine ⟨max D1 D2, fun D' hD' => ⟨fun d hd => ?_, ?_⟩⟩
        · rw [map_add, (h1 D' (le_of_max_le_left hD')).1 d hd,
            (h2 D' (le_of_max_le_right hD')).1 d hd, add_zero]
        · simp only [map_add, Finset.sum_add_distrib]
          rw [(h1 D' (le_of_max_le_left hD')).2, (h2 D' (le_of_max_le_right hD')).2]
  obtain ⟨D, hD⟩ := key
  exact ⟨D, hD D le_rfl⟩

set_option maxHeartbeats 1000000 in
/-- The weight lemma on joint pieces of weight `≤ N`. -/
theorem mProjB_zero_eq (N : ℕ) {q0 : ℤ} {v : (BRSTSpace L)} (hv : v ∈ (lapSup L) N q0) :
    (mProjB L) N 0 v = TensorProduct.map (TensorProduct.map LinearMap.id (uConst L)) LinearMap.id v := by
  refine Submodule.iSup_induction _ (motive := fun v => (mProjB L) N 0 v =
    TensorProduct.map (TensorProduct.map LinearMap.id (uConst L)) LinearMap.id v) hv ?_ (by simp)
    (fun x y hx hy => by beta_reduce at hx hy ⊢; rw [map_add, map_add, hx, hy])
  intro j y hy
  refine Submodule.iSup_induction _ (motive := fun v => (mProjB L) N 0 v =
    TensorProduct.map (TensorProduct.map LinearMap.id (uConst L)) LinearMap.id v) hy ?_ (by simp)
    (fun x y hx hy => by beta_reduce at hx hy ⊢; rw [map_add, map_add, hx, hy])
  intro hj z hz
  obtain ⟨-, n0, hn0, hw⟩ := hj
  refine tensorDeg_induction (matterBK L) KoszulConcrete.ghostB j
    (fun z => (mProjB L) N 0 z =
      TensorProduct.map (TensorProduct.map LinearMap.id (uConst L)) LinearMap.id z) (by simp)
    (fun x y hx hy => by beta_reduce at hx hy ⊢; rw [map_add, map_add, hx, hy])
    (fun c x hx => by beta_reduce at hx ⊢; rw [map_smul, map_smul, hx]) ?_ z hz
  intro b m hm g hg
  beta_reduce
  by_cases hm0 : m = 0
  · rw [hm0, TensorProduct.zero_tmul, map_zero, map_zero]
  by_cases hg0 : g = 0
  · rw [hg0, TensorProduct.tmul_zero, map_zero, map_zero]
  obtain ⟨wm, hwm⟩ := (matterB_nat L) hm hm0
  obtain ⟨wg, hwg⟩ := ghostB_nat hg hg0
  have hsum : (wm : ℤ) + wg = n0 := by
    have : (j.1.1.2 : ℂ) = b.1.1.2 + (j - b).1.1.2 := by simp
    rw [hw, ← hwm, ← hwg] at this
    exact_mod_cast this.symm
  have hmD : m ∈ (matterDeg L) b.1.1 := by
    unfold matterBK matterF at hm
    split_ifs at hm
    · exact hm
    all_goals exact absurd ((Submodule.mem_bot ℂ).mp hm) hm0
  simp only [mProjB, TensorProduct.map_tmul, LinearMap.id_apply]
  rw [mProj_zero_eq_mConst L (w := wm) hwm (by omega) m hmD]

/-- **No common kernel of `(ΔN L)` and `(EVB L)` on the antighost-free blocks.** -/
theorem ΔN_EVB_injective (N : ℕ) {v : (BRSTSpace L)} (hv : v ∈ (lapSup L) N 0)
    (h1 : (ΔN L) hA (sN N) v = 0) (h2 : (EVB L) hA v = 0) : v = 0 := by
  have hNb := (NbB_lapSup L) N 0 hv
  rw [Int.cast_zero, zero_smul] at hNb
  have hL : TensorProduct.map ((mL L) hA (sN N)) LinearMap.id v = 0 := by
    rw [ΔN, LinearMap.add_apply, hNb, add_zero] at h1; exact h1
  obtain ⟨D, hD1, hD2⟩ := (exists_mProjB_bound L) N v
  have hstep : ∀ d, 1 ≤ d → (mProjB L) N (d + 1) v = 0 → (mProjB L) N d v = 0 := by
    intro d hd hnext
    have h := (mProjB_mL L) hA N d v
    rw [hL, map_zero, hnext, map_zero, add_zero] at h
    have hne : (d : ℂ) ≠ 0 := by exact_mod_cast (show d ≠ 0 by omega)
    exact eq_zero_of_smul_eq_zero hne h.symm
  have hall : ∀ k d, 1 ≤ d → D + 1 ≤ d + k → (mProjB L) N d v = 0 := by
    intro k
    induction k with
    | zero => intro d _ hd; exact hD1 d (by omega)
    | succ k ih =>
        intro d hd1 hd
        by_cases h : D + 1 ≤ d + k
        · exact ih d hd1 h
        · exact hstep d hd1 (ih (d + 1) (by omega) (by omega))
  have hv0 : v = (mProjB L) N 0 v := by
    conv_lhs => rw [← hD2]
    rw [Finset.sum_eq_single 0 (fun d _ hd => hall (D + 1) d (by omega) (by omega))
      (by simp)]
  rw [hv0, (mProjB_zero_eq L) N hv]
  -- factor through the evaluation
  have hfac : TensorProduct.map (TensorProduct.map LinearMap.id (uConst L)) LinearMap.id v =
      TensorProduct.map ((jU L) ∘ₗ (ev L) hA ∘ₗ TensorProduct.map LinearMap.id (uConst L))
        LinearMap.id v := by
    congr 1
    congr 1
    exact LinearMap.ext fun m => (mConst_factor L) hA m
  have hvc : TensorProduct.map (TensorProduct.map LinearMap.id (uConst L)) LinearMap.id v = v := by
    rw [← (mProjB_zero_eq L) N hv, ← hv0]
  have hcomp : ∀ w : (BRSTSpace L), TensorProduct.map ((jU L) ∘ₗ (ev L) hA ∘ₗ
      TensorProduct.map LinearMap.id (uConst L)) (LinearMap.id : Module.End ℂ Sl2GhostSpace) w =
      TensorProduct.map (jU L) LinearMap.id ((EVB L) hA (TensorProduct.map
        (TensorProduct.map LinearMap.id (uConst L)) LinearMap.id w)) := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => rw [map_add, hx, hy, map_add, map_add, map_add]
    | tmul m g => simp [EVB]
  rw [hfac, hcomp, hvc, h2, map_zero]

end EVB

/-! ### Koszul `H₀` of the actual blocks -/

variable (hA : GradedUnitary (affineForm L) (affineRealStructure L) (affineFlag L)) in
/-- **Koszul `H₀` on the actual antighost-free blocks**: a block vector is a `d_K`-boundary
iff its symbol evaluation vanishes. -/
theorem range_comp_iff {n : ℤ} (hp : IsPosOn (((endpointKahler L) hA).geometry n).P ⊤)
    {b c : ℤ × ℤ} (hb : b + shQm = c) (x : ((endpointBlocks L) hA n hp).blk (c, ((0 : ℕ) : ℤ))) :
    x ∈ LinearMap.range (((endpointBlocks L) hA n hp).comp b c ((0 + 1 : ℕ) : ℤ) ((0 : ℕ) : ℤ)) ↔
      (EVB L) hA ((x : (relativeWeight L) n) : (BRSTSpace L)) = 0 :=
  h0_of_native ((endpointBlocks L) hA n hp) ((relativeWeight L) n).subtype Subtype.val_injective
    ((dN L) hA (sN n.toNat)) ((hN L) (sN n.toNat)) ((ΔN L) hA (sN n.toNat)) ((EVB L) hA)
    (fun a c hc q q' hq x => (comp_coe_eq_dN' L) hA hp hc hq x)
    (fun a b hb q q1 hq v hv => (hN_mem_blkW L) hA hp hb hq hv)
    ((dN_hN_add L) hA _) ((EVB_dN L) hA _)
    (fun c v hv hv0 hev => (ΔN_EVB_injective L) hA n.toNat
      (by have := (goodSup_le_lapSup L) ((blkW_le_goodSup L) hA hp _ hv); simpa using this) hv0 hev)
    hb x


end

