import VOA.Examples.VirasoroGramDivisibility

/-!
# From ordinary Virasoro singular states to determinant factors

In the universal vacuum module, L₁ and L₂ generate the positive Virasoro
modes. A positive-weight state killed by these two operators is orthogonal
to every creation word, hence lies in the canonical radical. Its coordinates
therefore give an actual partition Gram relation. Independent such states
supply determinant factors by the ordinary null-row theorem.

This module does not construct the minimal-model singular states. It removes
additional pairing and all-positive-mode obligations from their future construction.
-/
namespace VOA.VirDeformModes.NormalOrdering
open VirModule VirSimple VertexOperatorAlgebra

/-- Killing L₁ and L₂ kills every positive Virasoro mode. The commutator
with L₁ advances from L_n to L_(n+1), with a nonzero coefficient for n>=2. -/
theorem Lop_positive_eq_zero_of_one_two (c : ℂ) (v : VirUniv c)
    (h1 : Lop c 1 v = 0) (h2 : Lop c 2 v = 0) :
    ∀ n : ℤ, 0 < n → Lop c n v = 0 := by
  have hall : ∀ k : ℕ, Lop c ((k:ℤ)+2) v = 0 := by
    intro k
    induction k with
    | zero => simpa using h2
    | succ k ih =>
      have hh := LeeYang.Lop_apply_comm c 1 ((k:ℤ)+2) v
      have hz : ¬ (1:ℤ)+((k:ℤ)+2)=0 := by omega
      simp only [h1, ih, map_zero, if_neg hz, zero_smul, zero_add, add_zero, Int.cast_one] at hh
      have hn : (1:ℂ)-((k:ℤ)+2) ≠ 0 := by
        intro he
        have he' : (1:ℤ)-((k:ℤ)+2)=0 := by exact_mod_cast he
        omega
      push_cast at hh hn
      have he := (smul_eq_zero.mp hh.symm).resolve_left hn
      convert he using 1 <;> push_cast <;> ring
  intro n hn
  by_cases he : n=1
  · simpa [he] using h1
  · have hn2 : 2 ≤ n := by omega
    obtain ⟨k,hk⟩ := Int.eq_ofNat_of_zero_le (show 0 ≤ n-2 by omega)
    have he : n=(k:ℤ)+2 := by omega
    simpa [he] using hall k

/-- In the universal vacuum module a positive-weight singular state is
orthogonal to every creation word. For nonempty words the first mode moves
across the form and kills the singular state; the empty word uses grading. -/
theorem canB_word_singular_zero (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : VirUniv c) (hv : v ∈ gradingVir c (n:ℤ))
    (h1 : Lop c 1 v = 0) (h2 : Lop c 2 v = 0) (w : List ℕ) :
    (VirGram4.canB c).form (negWordVir c w) v = 0 := by
  cases w with
  | nil =>
    exact (VirGram4.canB c).orthogonal_of_ne (by exact_mod_cast Nat.ne_of_lt hn)
      (virasoroVOA c).vacuum_mem hv
  | cons i w =>
    rw [VirFormSym.negWord_cons_left,
      Lop_positive_eq_zero_of_one_two c v h1 h2 ((i:ℤ)+2) (by omega), map_zero]

/-- Creation words span the universal vacuum module, so their vanishing
pairings imply the entire right pairing row is zero. -/
theorem canB_singular_right_zero (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : VirUniv c) (hv : v ∈ gradingVir c (n:ℤ))
    (h1 : Lop c 1 v = 0) (h2 : Lop c 2 v = 0) (x : VirUniv c) :
    (VirGram4.canB c).form x v = 0 := by
  have htop : Submodule.span ℂ (Set.range (negWordVir c)) = ⊤ := negSpanVir_eq_top c
  have hx : x ∈ Submodule.span ℂ (Set.range (negWordVir c)) :=
    htop ▸ Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨w,rfl⟩ := hx
    exact canB_word_singular_zero c hn v hv h1 h2 w
  | zero => simp
  | add x y _ _ hx hy => simp [map_add, hx, hy]
  | smul a x _ hx => simp [map_smul, hx]

/-- Symmetry puts the singular state in the left radical as well. This
conclusion is specific to the vacuum module generated by Virasoro modes. -/
theorem canB_singular_left_zero (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : VirUniv c) (hv : v ∈ gradingVir c (n:ℤ))
    (h1 : Lop c 1 v = 0) (h2 : Lop c 2 v = 0) (x : VirUniv c) :
    (VirGram4.canB c).form v x = 0 := by
  rw [VirFormSym.canB_isSymmetric]
  exact canB_singular_right_zero c hn v hv h1 h2 x

/-- A positive-weight state killed by L₁ and L₂ belongs to the maximal
proper ideal of the universal vacuum VOA. No separate Shapovalov condition
is required for this particular Virasoro-generated module. -/
theorem singular_mem_maxIdeal (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : VirUniv c) (hv : v ∈ gradingVir c (n:ℤ))
    (h1 : Lop c 1 v = 0) (h2 : Lop c 2 v = 0) : v ∈ maxIdealVir c := by
  apply (LiRadical.mem_maxGradedIdeal_iff_grading (VirGram4.canB_isFullyInvariant c)
    (VirGram4.canB_normalized c) hv).mpr
  intro x hx
  exact canB_singular_left_zero c hn v hv h1 h2 x

/-- The genuine simple quotient kills every such singular state. -/
theorem singular_mkQ_eq_zero (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : VirUniv c) (hv : v ∈ gradingVir c (n:ℤ))
    (h1 : Lop c 1 v = 0) (h2 : Lop c 2 v = 0) :
    (maxIdealVir c).mkQ v = 0 :=
  (Submodule.Quotient.mk_eq_zero _).mpr (singular_mem_maxIdeal c hn v hv h1 h2)

/-- Every Virasoro-word descendant of a singular state remains in the
canonical radical: adjointness moves the entire word to the other argument.
No independence or dimension claim about those descendants is made here. -/
theorem canB_singular_descendant_zero (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : VirUniv c) (hv : v ∈ gradingVir c (n:ℤ))
    (h1 : Lop c 1 v = 0) (h2 : Lop c 2 v = 0)
    (w : List ℤ) (x : VirUniv c) :
    (VirGram4.canB c).form (virWord (virasoroVOA c).L w v) x = 0 := by
  rw [virWord_adjoint]
  exact canB_singular_left_zero c hn v hv h1 h2 _

/-- Coordinates of a positive-weight singular state in the partition basis
give a null row of the actual specialized polynomial Gram matrix. -/
theorem partition_coordinates_singular_row (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : gradingVir c (n:ℤ))
    (h1 : Lop c 1 (v : VirUniv c) = 0) (h2 : Lop c 2 (v : VirUniv c) = 0)
    (j : SortedOfEnergy n) :
    ∑ k, (gradedBasis c n).equivFun v k * (partitionGramPolynomial n k j).eval c = 0 := by
  let b := gradedBasis c n
  have he : ∀ k, (partitionGramPolynomial n k j).eval c =
      (VirGram4.canB c).form (b k : VirUniv c) (b j : VirUniv c) := by
    intro k
    simpa only [Matrix.map_apply, GramMat.gramMatrix_apply, b] using
      congrArg (fun M => M k j) (partitionGramPolynomial_eval c n)
  simp_rw [he]
  have hs := congrArg (gradingVir c (n:ℤ)).subtype (b.sum_equivFun v)
  simp only [map_sum, map_smul] at hs
  have hh := congrArg (fun x => (VirGram4.canB c).form x (b j : VirUniv c)) hs
  have hz := canB_singular_left_zero c hn (v : VirUniv c) v.property h1 h2 (b j)
  simpa only [map_sum, LinearMap.sum_apply, map_smul, LinearMap.smul_apply,
    smul_eq_mul] using hh.trans hz

/-- Independent positive-weight states killed by L₁ and L₂ force one
charge factor per state in the actual partition determinant. Independence
is transported through basis coordinates; all Gram-row conditions are proved. -/
theorem partitionDeterminant_dvd_of_independent_singular
    {τ : Type*} [Fintype τ] (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : τ → gradingVir c (n:ℤ)) (hv : LinearIndependent ℂ v)
    (h1 : ∀ i, Lop c 1 (v i : VirUniv c) = 0)
    (h2 : ∀ i, Lop c 2 (v i : VirUniv c) = 0) :
    (Polynomial.X-Polynomial.C c)^(Fintype.card τ) ∣ (partitionGramPolynomial n).det := by
  have hi := hv.map' (gradedBasis c n).equivFun.toLinearMap
    (LinearMap.ker_eq_bot.mpr (gradedBasis c n).equivFun.injective)
  exact pow_X_sub_C_dvd_det_of_independent_null_rows _ c _ hi
    (fun i j => partition_coordinates_singular_row c hn (v i) (h1 i) (h2 i) j)

/-- A nonzero positive-weight state killed by L₁ and L₂ forces a genuine
zero of the actual partition determinant at its charge and weight. This is
a root-existence theorem from a singular state, not a simple-root theorem. -/
theorem partitionDeterminant_eval_zero_of_singular (c : ℂ) {n : ℕ} (hn : 0 < n)
    (v : gradingVir c (n:ℤ)) (hv : v ≠ 0)
    (h1 : Lop c 1 (v : VirUniv c) = 0) (h2 : Lop c 2 (v : VirUniv c) = 0) :
    ((partitionGramPolynomial n).det).eval c = 0 := by
  have hi : LinearIndependent ℂ (fun _ : Fin 1 => v) :=
    linearIndependent_unique_iff.mpr hv
  have hd := partitionDeterminant_dvd_of_independent_singular c hn _ hi
    (fun _ => h1) (fun _ => h2)
  apply Polynomial.dvd_iff_isRoot.mp
  simpa using hd

end VOA.VirDeformModes.NormalOrdering
