import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.Algebra.Algebra.Bilinear
import Mathlib.RingTheory.SimpleModule.Basic
import VOA.Foundations.Virasoro

/-!
# The universal Virasoro vacuum module `V(c,0)`  (Goal V1 — the carrier)

The abstract vacuum module of the Virasoro algebra at central charge `c`: `M(c,0) = U(𝔙𝔦𝔯)/J(c)`
with `J(c)` the left ideal generated by `{Lₙ : n ≥ -1}` (so `L₋₁|0⟩ = 0`, the VOA translation
condition) and `C - c`.  Mirrors `Foundations/AffineLie.vacuumModule` but for the Virasoro
algebra and — crucially — the vacuum-nonvanishing (`Foundations/VirasoroNonvanishing`) is proved
**axiom-free** (no `VOA.pbw`).

Provides: `VirUniv c` (the carrier), `virVacRho` (the `𝔙𝔦𝔯`-action by left multiplication), the
vacuum vector, `C` acting by `c`, `Lₙ|0⟩=0` for `n ≥ -1`, cyclicity, and the `VirRep` packaging.

All `sorry`-free, axiom-clean, `pbw`-free.
-/

namespace VOA

open LieAlgebra LieAlgebra.Extension

/-! ## §A  `C` is central in the Virasoro algebra. -/

/-- The central element `C` is central: `⁅C, x⁆ = 0` for all `x ∈ 𝔙𝔦𝔯`. -/
theorem C_central (x : Virasoro) : ⁅C, x⁆ = 0 := by
  obtain ⟨wz, rfl⟩ := (ofProd gfCocycle).surjective x
  rw [C, bracket_ofTwoCocycle]
  apply (ofProd gfCocycle).symm.injective
  rw [Equiv.symm_apply_apply, of_symm_zero, Prod.ext_iff]
  constructor
  · show ⁅(0 : Witt), wz.1⁆ = 0
    rw [zero_lie]
  · show (gfCocycle : Witt →ₗ[ℂ] Witt →ₗ[ℂ] ℂ) 0 wz.1 + ⁅(0 : Witt), wz.2⁆ - ⁅wz.1, (1 : ℂ)⁆
        = (0 : ℂ)
    show (Witt.cocycleₗ 0) wz.1 + (0 : ℂ) - (0 : ℂ) = 0
    rw [map_zero, LinearMap.zero_apply, add_zero, sub_zero]

/-! ## §B  The universal enveloping algebra and the vacuum left ideal. -/

namespace VirModule

open UniversalEnvelopingAlgebra

/-- The universal enveloping algebra `U(𝔙𝔦𝔯)`. -/
abbrev UVir : Type := UniversalEnvelopingAlgebra ℂ Virasoro

/-- `ι C` commutes with everything in `U(𝔙𝔦𝔯)` (since `C` is central in `𝔙𝔦𝔯`). -/
theorem commute_ι_C (a : UVir) : Commute (ι ℂ C) a := by
  have hsurj : Function.Surjective (mkAlgHom ℂ Virasoro) :=
    RingQuot.mkAlgHom_surjective ℂ (Rel ℂ Virasoro)
  obtain ⟨p, rfl⟩ := hsurj a
  induction p using TensorAlgebra.induction with
  | algebraMap r => rw [AlgHom.commutes]; exact Algebra.commute_algebraMap_right r _
  | ι x =>
      change Commute (ι ℂ C) (ι ℂ x)
      have h := (ι ℂ).map_lie C x
      rw [C_central x, map_zero, LieRing.of_associative_ring_bracket] at h
      exact sub_eq_zero.mp h.symm
  | add p q hp hq => rw [map_add]; exact hp.add_right hq
  | mul p q hp hq => rw [map_mul]; exact hp.mul_right hq

/-- The generators of the vacuum left ideal `J(c)`: the modes `Lₙ` for `n ≥ -1` (the VOA
highest-weight/translation condition `Lₙ|0⟩ = 0`, `n ≥ -1`) and the central correction `C - c`. -/
def vacGens (c : ℂ) : Set UVir :=
  {a | (∃ n : ℤ, -1 ≤ n ∧ a = ι ℂ (L n)) ∨ a = ι ℂ C - algebraMap ℂ UVir c}

/-- The **vacuum left ideal** `J(c) ⊆ U(𝔙𝔦𝔯)`, annihilating the vacuum vector. -/
noncomputable def vacIdeal (c : ℂ) : Submodule UVir UVir :=
  Submodule.span _ (vacGens c)

/-- Each defining vacuum relation belongs to the left ideal it generates.
This is the entry point for proving the vacuum annihilation laws on the quotient. -/
theorem vacGens_subset_ideal (c : ℂ) : vacGens c ⊆ ↑(vacIdeal c) :=
  Submodule.subset_span

/-- The **universal Virasoro vacuum module** `V(c,0) = U(𝔙𝔦𝔯) ⧸ J(c)`, with `J(c)` the left ideal
generated by `{L n : n ≥ -1}` and `C - c`.

⚠ **Naming.** An earlier version of this docstring called this `L(c,0)`.  That was wrong, and the
error matters: `L(c,0)` denotes the **simple** quotient — this module modulo its maximal proper
graded ideal (`Examples.VirasoroSimple.virasoroSimple`).  The two agree at generic `c` and differ
*exactly* at the degenerate central charges (the minimal models), which is precisely where the
distinction is needed.  `L(c,0)` is reserved for
the simple quotient. -/
abbrev VirUniv (c : ℂ) : Type := UVir ⧸ vacIdeal c

/-- The action of `𝔙𝔦𝔯` on the vacuum module: `x` acts by left multiplication by `ι x`. -/
noncomputable def virVacRho (c : ℂ) : Virasoro →ₗ⁅ℂ⁆ Module.End ℂ (VirUniv c) :=
  (Algebra.lsmul ℂ ℂ (VirUniv c)).toLieHom.comp (ι ℂ)

/-- Acting on a quotient class means multiplying its enveloping-algebra
representative on the left by the embedded Lie element. This formula proves
that universal evaluation intertwines the entire Lie action. -/
theorem virVacRho_mk (c : ℂ) (x : Virasoro) (a : UVir) :
    virVacRho c x (Submodule.Quotient.mk a) = Submodule.Quotient.mk (ι ℂ x * a) := rfl

/-- The **vacuum vector** `|0⟩ = [1]`. -/
noncomputable def vacVec (c : ℂ) : VirUniv c := Submodule.Quotient.mk 1

set_option maxHeartbeats 800000 in
/-- `C` acts on the vacuum module as the scalar `c` — the **central charge**. -/
theorem vac_acts_central (c : ℂ) : virVacRho c C = c • LinearMap.id := by
  refine LinearMap.ext fun m => ?_
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  rw [virVacRho_mk, LinearMap.smul_apply, LinearMap.id_coe, id_eq,
    ← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
  have hcomm : Commute a (ι ℂ C - algebraMap ℂ UVir c) :=
    (commute_ι_C a).symm.sub_right (Algebra.commute_algebraMap_right c a)
  have heq : ι ℂ C * a - c • a = a * (ι ℂ C - algebraMap ℂ UVir c) := by
    rw [hcomm.eq, sub_mul, Algebra.smul_def]
  rw [heq, ← smul_eq_mul]
  exact (vacIdeal c).smul_mem a (vacGens_subset_ideal c (Or.inr rfl))

/-- The vacuum module as a `VirRep` of central charge `c`. -/
noncomputable def virVacRep (c : ℂ) : VirRep (VirUniv c) where
  ρ := virVacRho c
  centralCharge := c
  acts_central := vac_acts_central c

/-- The modes `Lₙ` for `n ≥ -1` annihilate the vacuum vector (`L₋₁|0⟩ = 0` = VOA translation of
the vacuum; `Lₙ|0⟩ = 0`, `n ≥ 0` = highest weight `0`). -/
theorem vac_pos_annihilate (c : ℂ) (n : ℤ) (hn : -1 ≤ n) :
    virVacRho c (L n) (vacVec c) = 0 := by
  rw [vacVec, virVacRho_mk, mul_one, Submodule.Quotient.mk_eq_zero]
  exact vacGens_subset_ideal c (Or.inl ⟨n, hn, rfl⟩)

/-- The vacuum vector is **cyclic**: it generates `V(c,0)` as a `U(𝔙𝔦𝔯)`-module. -/
theorem vac_cyclic (c : ℂ) :
    Submodule.span UVir {vacVec c} = ⊤ := by
  rw [eq_top_iff]
  rintro m -
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ m
  have hv : a • vacVec c = Submodule.Quotient.mk a := by
    rw [vacVec, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]
  rw [← hv]
  exact Submodule.smul_mem _ a (Submodule.mem_span_singleton_self _)

end VirModule

end VOA
