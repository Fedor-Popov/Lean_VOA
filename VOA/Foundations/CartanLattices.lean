    ((Matrix.toBilin' (CartanMatrix.D 4) v v : ℤ) : ℚ) =
      (2 : ℚ) * ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)) ^ 2 + (3/2 : ℚ) * ((v 1 : ℚ) + (-2/3 : ℚ) * (v 2 : ℚ) + (-2/3 : ℚ) * (v 3 : ℚ)) ^ 2 + (4/3 : ℚ) * ((v 2 : ℚ) + (-1/2 : ℚ) * (v 3 : ℚ)) ^ 2 + (1 : ℚ) * ((v 3 : ℚ)) ^ 2 := by
  rw [quad_D4]
  push_cast
  ring

