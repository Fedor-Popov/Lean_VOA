    (h : Matrix.toBilin' (CartanMatrix.D 4) v v ≤ 0) : v = 0 := by
  have hq : ((Matrix.toBilin' (CartanMatrix.D 4) v v : ℤ) : ℚ) ≤ 0 := by exact_mod_cast h
  rw [sos_D4] at hq
  have y0 : (v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ) = 0 :=
    pow_eq_zero_iff two_ne_zero |>.mp
      (le_antisymm (by linarith [sq_nonneg ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)), sq_nonneg ((v 1 : ℚ) + (-2/3 : ℚ) * (v 2 : ℚ) + (-2/3 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 2 : ℚ) + (-1/2 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 3 : ℚ))]) (sq_nonneg _))
  have y1 : (v 1 : ℚ) + (-2/3 : ℚ) * (v 2 : ℚ) + (-2/3 : ℚ) * (v 3 : ℚ) = 0 :=
    pow_eq_zero_iff two_ne_zero |>.mp
      (le_antisymm (by linarith [sq_nonneg ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)), sq_nonneg ((v 1 : ℚ) + (-2/3 : ℚ) * (v 2 : ℚ) + (-2/3 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 2 : ℚ) + (-1/2 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 3 : ℚ))]) (sq_nonneg _))
  have y2 : (v 2 : ℚ) + (-1/2 : ℚ) * (v 3 : ℚ) = 0 :=
    pow_eq_zero_iff two_ne_zero |>.mp
      (le_antisymm (by linarith [sq_nonneg ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)), sq_nonneg ((v 1 : ℚ) + (-2/3 : ℚ) * (v 2 : ℚ) + (-2/3 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 2 : ℚ) + (-1/2 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 3 : ℚ))]) (sq_nonneg _))
  have y3 : (v 3 : ℚ) = 0 :=
    pow_eq_zero_iff two_ne_zero |>.mp
      (le_antisymm (by linarith [sq_nonneg ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)), sq_nonneg ((v 1 : ℚ) + (-2/3 : ℚ) * (v 2 : ℚ) + (-2/3 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 2 : ℚ) + (-1/2 : ℚ) * (v 3 : ℚ)), sq_nonneg ((v 3 : ℚ))]) (sq_nonneg _))
  have e0 : (v 0 : ℚ) = 0 := by linarith
  have e1 : (v 1 : ℚ) = 0 := by linarith
  have e2 : (v 2 : ℚ) = 0 := by linarith
  have e3 : (v 3 : ℚ) = 0 := by linarith
  ext i
  fin_cases i
  · exact Int.cast_eq_zero.mp e0
  · exact Int.cast_eq_zero.mp e1
  · exact Int.cast_eq_zero.mp e2
  · exact Int.cast_eq_zero.mp e3

theorem nonneg_D4 (v : Fin 4 → ℤ) : 0 ≤ Matrix.toBilin' (CartanMatrix.D 4) v v := by
  have h : (0 : ℚ) ≤ ((Matrix.toBilin' (CartanMatrix.D 4) v v : ℤ) : ℚ) := by
    rw [sos_D4]
    positivity
  exact_mod_cast h

