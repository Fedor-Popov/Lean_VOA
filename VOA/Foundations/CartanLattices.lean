import VOA.Foundations.Lattices
import Mathlib.Data.Matrix.Cartan

/-!
# The simply-laced root lattices of the Deligne series

The root lattices `A₂`, `D₄`, `E₆`, `E₇`, `E₈` as `IntegralLattice`s on `Fin n → ℤ`, with Gram
matrix Mathlib's `CartanMatrix`, together with proofs that each is even and positive-definite.
These are exactly the hypotheses of `LatGen.latticeVOAGen`.

Both properties come from explicit polynomial identities checked by `ring`:

* **even**: `vᵀGv = 2·P(v)` with `P` an integer polynomial (diagonal entries are `2`);
* **positive-definite**: `vᵀGv = ∑ₖ dₖ yₖ²` over `ℚ`, the `LDLᵀ` factorization of `G`, with
  every pivot `dₖ > 0` and `yₖ = vₖ + ∑_{i>k} Lᵢₖ vᵢ` unitriangular in `v`.  If `vᵀGv ≤ 0` every
  `yₖ` vanishes, and back-substitution gives `v = 0`.

The identities were generated by an exact-rational script and are re-checked here by `ring`; the
script is not trusted.  The product of the pivots is the determinant: `3, 4, 3, 2, 1`.
-/

-- The generated sum-of-squares identities are long single expressions.
set_option linter.style.longLine false

namespace VOA.CartanLattices

open IntegralLattice

/-- The integral lattice `ℤⁿ` with Gram matrix `G`. -/
noncomputable def ofCartan {n : ℕ} (G : Matrix (Fin n) (Fin n) ℤ) (hG : G.IsSymm) :
    IntegralLattice where
  carrier := Fin n → ℤ
  form := Matrix.toBilin' G
  isSymm := by
    rw [LinearMap.BilinForm.isSymm_def]
    intro v w
    rw [Matrix.toBilin'_apply', Matrix.toBilin'_apply', Matrix.dotProduct_mulVec,
      ← Matrix.mulVec_transpose, hG.eq, dotProduct_comm]

theorem ofCartan_form {n : ℕ} (G : Matrix (Fin n) (Fin n) ℤ) (hG : G.IsSymm)
    (v w : Fin n → ℤ) : (ofCartan G hG).form v w = Matrix.toBilin' G v w := rfl

/-- Evenness from an explicit half-norm polynomial. -/
theorem even_of_eq {n : ℕ} (G : Matrix (Fin n) (Fin n) ℤ) (hG : G.IsSymm)
    {P : (Fin n → ℤ) → ℤ} (h : ∀ v, Matrix.toBilin' G v v = 2 * P v) :
    (ofCartan G hG).Even :=
  fun v => ⟨P v, h v⟩

/-- Positive-definiteness from nonnegativity and definiteness of the norm. -/
theorem posDef_of {n : ℕ} (G : Matrix (Fin n) (Fin n) ℤ) (hG : G.IsSymm)
    (hnn : ∀ v, 0 ≤ Matrix.toBilin' G v v)
    (hdef : ∀ v, Matrix.toBilin' G v v ≤ 0 → v = 0) :
    (ofCartan G hG).PosDef :=
  fun v hv => lt_of_le_of_ne (hnn v) fun h0 => hv (hdef v h0.symm.le)

/-! ### A2 -/

theorem quad_A2 (v : Fin 2 → ℤ) :
    Matrix.toBilin' (CartanMatrix.A 2) v v =
      2 * (v 0 ^ 2 + v 1 ^ 2 - v 0 * v 1) := by
  rw [CartanMatrix.A_two, Matrix.toBilin'_apply']
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
  ring

theorem sos_A2 (v : Fin 2 → ℤ) :
    ((Matrix.toBilin' (CartanMatrix.A 2) v v : ℤ) : ℚ) =
      (2 : ℚ) * ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)) ^ 2 + (3/2 : ℚ) * ((v 1 : ℚ)) ^ 2 := by
  rw [quad_A2]
  push_cast
  ring

theorem eq_zero_of_le_zero_A2 (v : Fin 2 → ℤ)
    (h : Matrix.toBilin' (CartanMatrix.A 2) v v ≤ 0) : v = 0 := by
  have hq : ((Matrix.toBilin' (CartanMatrix.A 2) v v : ℤ) : ℚ) ≤ 0 := by exact_mod_cast h
  rw [sos_A2] at hq
  have y0 : (v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ) = 0 :=
    pow_eq_zero_iff two_ne_zero |>.mp
      (le_antisymm (by linarith [sq_nonneg ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)), sq_nonneg ((v 1 : ℚ))]) (sq_nonneg _))
  have y1 : (v 1 : ℚ) = 0 :=
    pow_eq_zero_iff two_ne_zero |>.mp
      (le_antisymm (by linarith [sq_nonneg ((v 0 : ℚ) + (-1/2 : ℚ) * (v 1 : ℚ)), sq_nonneg ((v 1 : ℚ))]) (sq_nonneg _))
  have e0 : (v 0 : ℚ) = 0 := by linarith
  have e1 : (v 1 : ℚ) = 0 := by linarith
  ext i
  fin_cases i
  · exact Int.cast_eq_zero.mp e0
  · exact Int.cast_eq_zero.mp e1

theorem nonneg_A2 (v : Fin 2 → ℤ) : 0 ≤ Matrix.toBilin' (CartanMatrix.A 2) v v := by
  have h : (0 : ℚ) ≤ ((Matrix.toBilin' (CartanMatrix.A 2) v v : ℤ) : ℚ) := by
    rw [sos_A2]
    positivity
  exact_mod_cast h

/-- The A2 root lattice. -/
noncomputable def a2 : IntegralLattice := ofCartan (CartanMatrix.A 2) (CartanMatrix.A_isSymm 2)

theorem a2_even : a2.Even :=
  even_of_eq _ _ fun v => quad_A2 v

theorem a2_posDef : a2.PosDef :=
  posDef_of _ _ nonneg_A2 eq_zero_of_le_zero_A2

/-! ### D4 -/

theorem quad_D4 (v : Fin 4 → ℤ) :
    Matrix.toBilin' (CartanMatrix.D 4) v v =
      2 * (v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 + v 3 ^ 2 - v 0 * v 1 - v 1 * v 2 - v 1 * v 3) := by
  rw [CartanMatrix.D_four, Matrix.toBilin'_apply']
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
  ring

