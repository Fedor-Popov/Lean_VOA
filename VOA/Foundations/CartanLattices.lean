/-! ### E8 -/

theorem quad_E8 (v : Fin 8 → ℤ) :
    Matrix.toBilin' (CartanMatrix.E₈) v v =
      2 * (v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 + v 3 ^ 2 + v 4 ^ 2 + v 5 ^ 2 + v 6 ^ 2 + v 7 ^ 2 - v 0 * v 2 - v 1 * v 3 - v 2 * v 3 - v 3 * v 4 - v 4 * v 5 - v 5 * v 6 - v 6 * v 7) := by
  rw [Matrix.toBilin'_apply']; unfold CartanMatrix.E₈
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ]
  ring

theorem sos_E8 (v : Fin 8 → ℤ) :
    ((Matrix.toBilin' (CartanMatrix.E₈) v v : ℤ) : ℚ) =
      (2 : ℚ) * ((v 0 : ℚ) + (-1/2 : ℚ) * (v 2 : ℚ)) ^ 2 + (2 : ℚ) * ((v 1 : ℚ) + (-1/2 : ℚ) * (v 3 : ℚ)) ^ 2 + (3/2 : ℚ) * ((v 2 : ℚ) + (-2/3 : ℚ) * (v 3 : ℚ)) ^ 2 + (5/6 : ℚ) * ((v 3 : ℚ) + (-6/5 : ℚ) * (v 4 : ℚ)) ^ 2 + (4/5 : ℚ) * ((v 4 : ℚ) + (-5/4 : ℚ) * (v 5 : ℚ)) ^ 2 + (3/4 : ℚ) * ((v 5 : ℚ) + (-4/3 : ℚ) * (v 6 : ℚ)) ^ 2 + (2/3 : ℚ) * ((v 6 : ℚ) + (-3/2 : ℚ) * (v 7 : ℚ)) ^ 2 + (1/2 : ℚ) * ((v 7 : ℚ)) ^ 2 := by
  rw [quad_E8]
  push_cast
  ring

