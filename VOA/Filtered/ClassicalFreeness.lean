import VOA.Commutative.FiniteWeightedJetRelations
import VOA.Core.FiniteHilbertSqueeze
import VOA.Filtered.LiGradedAlgebra

/-!
# The canonical finite-jet map to the Li associated graded

This file constructs the presentation-level map which underlies classical freeness, without
asserting either surjectivity or injectivity.

The pure commutative-algebra input is the following.  If `D` is a derivation of a commutative
`ℂ`-algebra `A`, send the jet variable `x_i^(r)` to the divided iterate `D^r(x_i) / r!`.  The
order-`n` Hasse--Schmidt coefficient of a polynomial `f` then maps to `D^n(f) / n!`.  Therefore
every finite jet relation generated by an ideal already vanishing under the order-zero
evaluation lies in the kernel.

For the Li associated graded, translation supplies the derivation.  Given homogeneous state
representatives, their degree-zero Li classes give the base assignment.  A presentation ideal
whose relations vanish on those classes consequently produces a canonical algebra map from its
finite jet algebra to `liAssociatedGraded W`.

No generation theorem and no classical-freeness claim is made here.  Surjectivity is exactly the
additional assertion that the Li associated graded is generated by the translated degree-zero
classes; injectivity is the further assertion that there are no extra Li-graded relations.
-/

namespace VOA

open scoped BigOperators DirectSum

universe uσ uA uV uE uB uD

namespace FiniteJet

section DerivationEvaluation

variable {σ : Type uσ} {A : Type uA}
  [CommRing A] [Algebra ℂ A]

/-- The divided iterate `D^r(a) / r!`. -/
noncomputable def dividedIterate (D : A →ₗ[ℂ] A) (r : ℕ) (a : A) : A :=
  ((r.factorial : ℂ)⁻¹) • ((D ^ r) a)

@[simp] theorem dividedIterate_zero (D : A →ₗ[ℂ] A) (a : A) :
    dividedIterate D 0 a = a := by
  simp [dividedIterate]

@[simp] theorem dividedIterate_zero_apply (D : A →ₗ[ℂ] A) (r : ℕ) :
    dividedIterate D r 0 = 0 := by
  simp [dividedIterate]

private theorem end_pow_succ_apply (D : A →ₗ[ℂ] A) (r : ℕ) (a : A) :
    (D ^ (r + 1)) a = D ((D ^ r) a) := by
  rw [pow_succ']
  rfl

private theorem pascal_resum (k : ℕ) (g : ℕ → A) :
    (∑ i ∈ Finset.range (k + 1), (k.choose i : ℂ) • g (i + 1)) +
        (∑ i ∈ Finset.range (k + 1), (k.choose i : ℂ) • g i) =
      ∑ i ∈ Finset.range (k + 2), ((k + 1).choose i : ℂ) • g i := by
  rw [Finset.sum_range_succ' (fun i => ((k + 1).choose i : ℂ) • g i) (k + 1),
    Finset.sum_range_succ' (fun i => (k.choose i : ℂ) • g i) k]
  simp only [Nat.choose_zero_right, Nat.cast_one]
  rw [← add_assoc]
  congr 1
  · rw [Finset.sum_range_succ (fun i => (k.choose i : ℂ) • g (i + 1)) k,
      Finset.sum_range_succ (fun i => ((k + 1).choose (i + 1) : ℂ) • g (i + 1)) k,
      add_right_comm, ← Finset.sum_add_distrib]
    congr 1
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [← add_smul]
      congr 2
      rw [Nat.choose_succ_succ' k i]
      push_cast
      ring
    · rw [Nat.choose_self, Nat.choose_self]

/-- Iterated Leibniz in binomial form for a derivation of a commutative algebra. -/
private theorem iterate_leibniz (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (k : ℕ) (a b : A) :
    (D ^ k) (a * b) =
      ∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℂ) • ((D ^ i) a * (D ^ (k - i)) b) := by
  induction k generalizing a b with
  | zero => simp
  | succ k ih =>
      rw [pow_succ', Module.End.mul_apply, ih a b, map_sum]
      have step : ∀ i ∈ Finset.range (k + 1),
          D ((k.choose i : ℂ) • ((D ^ i) a * (D ^ (k - i)) b)) =
            (k.choose i : ℂ) •
                ((D ^ (i + 1)) a * (D ^ ((k + 1) - (i + 1))) b) +
              (k.choose i : ℂ) •
                ((D ^ i) a * (D ^ ((k + 1) - i)) b) := by
        intro i hi
        rw [Finset.mem_range] at hi
        rw [map_smul, hleib, smul_add]
        have h1 : (D ^ (i + 1)) a = D ((D ^ i) a) :=
          end_pow_succ_apply D i a
        have h2 : (k + 1) - (i + 1) = k - i := by omega
        have h3 : (k + 1) - i = (k - i) + 1 := by omega
        rw [h1, h2, h3, end_pow_succ_apply D (k - i) b]
      rw [Finset.sum_congr rfl step, Finset.sum_add_distrib]
      let g : ℕ → A := fun i =>
        (D ^ i) a * (D ^ ((k + 1) - i)) b
      have e1 :
          (∑ i ∈ Finset.range (k + 1),
              (k.choose i : ℂ) •
                ((D ^ (i + 1)) a * (D ^ ((k + 1) - (i + 1))) b)) =
            ∑ i ∈ Finset.range (k + 1), (k.choose i : ℂ) • g (i + 1) := rfl
      have e2 :
          (∑ i ∈ Finset.range (k + 1),
              (k.choose i : ℂ) •
                ((D ^ i) a * (D ^ ((k + 1) - i)) b)) =
            ∑ i ∈ Finset.range (k + 1), (k.choose i : ℂ) • g i := rfl
      have eT :
          (∑ i ∈ Finset.range (k + 1 + 1),
              ((k + 1).choose i : ℂ) •
                ((D ^ i) a * (D ^ ((k + 1) - i)) b)) =
            ∑ i ∈ Finset.range (k + 2), ((k + 1).choose i : ℂ) • g i := rfl
      rw [e1, e2, eT, pascal_resum k g]

private theorem factorial_inv_mul_choose (k i : ℕ) (hik : i ≤ k) :
    ((k.factorial : ℂ)⁻¹) * (k.choose i : ℂ) =
      ((i.factorial : ℂ)⁻¹) * (((k - i).factorial : ℂ)⁻¹) := by
  have hkfac : (k.factorial : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero k
  have hi : (i.factorial : ℂ) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero i
  have hki : ((k - i).factorial : ℂ) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero (k - i)
  have key : (k.choose i : ℂ) * (i.factorial : ℂ) * ((k - i).factorial : ℂ) =
      (k.factorial : ℂ) := by
    exact_mod_cast Nat.choose_mul_factorial_mul_factorial hik
  field_simp
  linear_combination key

/-- Divided iterates turn the binomial Leibniz formula into a Cauchy convolution. -/
theorem dividedIterate_mul (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (k : ℕ) (a b : A) :
    dividedIterate D k (a * b) =
      ∑ ij ∈ Finset.antidiagonal k,
        dividedIterate D ij.1 a * dividedIterate D ij.2 b := by
  rw [dividedIterate, iterate_leibniz D hleib, Finset.smul_sum,
    Finset.Nat.sum_antidiagonal_eq_sum_range_succ
      (fun i j => dividedIterate D i a * dividedIterate D j b) k]
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [Finset.mem_range] at hi
  rw [dividedIterate, dividedIterate, smul_smul,
    factorial_inv_mul_choose k i (by omega)]
  simp only [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, smul_smul]
  congr 1
  ring

/-- Evaluation of finite jet variables by divided iterates of a derivation. -/
noncomputable def derivationJetEval (D : A →ₗ[ℂ] A) (m : ℕ) (x : σ → A) :
    JetPoly ℂ σ m →ₐ[ℂ] A :=
  MvPolynomial.aeval fun v => dividedIterate D v.order (x v.generator)

@[simp] theorem derivationJetEval_jetVariable (D : A →ₗ[ℂ] A) (m : ℕ)
    (x : σ → A) (i : σ) (r : ℕ) (hr : r ≤ m) :
    derivationJetEval D m x (jetVariable (R := ℂ) m i r) = dividedIterate D r (x i) := by
  rw [jetVariable_of_le (R := ℂ) m i r hr]
  simp [derivationJetEval]

private theorem dividedIterate_algebraMap (D : A →ₗ[ℂ] A) (hOne : D 1 = 0)
    (r : ℕ) (c : ℂ) :
    dividedIterate D r (algebraMap ℂ A c) = if r = 0 then algebraMap ℂ A c else 0 := by
  cases r with
  | zero => simp
  | succ r =>
      rw [if_neg (Nat.succ_ne_zero r), dividedIterate]
      have hpow : (D ^ (r + 1)) (algebraMap ℂ A c) = 0 := by
        induction r with
        | zero =>
            rw [end_pow_succ_apply, pow_zero, Module.End.one_apply]
            rw [Algebra.algebraMap_eq_smul_one, map_smul, hOne, smul_zero]
        | succ r ih => rw [end_pow_succ_apply, ih, map_zero]
      rw [hpow, smul_zero]

/-- A Hasse--Schmidt relation coefficient evaluates to the corresponding divided iterate. -/
theorem derivationJetEval_relationCoeff (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (m n : ℕ) (hn : n ≤ m)
    (x : σ → A) (f : MvPolynomial σ ℂ) :
    derivationJetEval D m x (relationCoeff (R := ℂ) m n f) =
      dividedIterate D n (MvPolynomial.aeval x f) := by
  induction f using MvPolynomial.induction_on generalizing n with
  | C c =>
      cases n with
      | zero => simp [dividedIterate]
      | succ n => simp [dividedIterate_algebraMap D hOne]
  | add f g hf hg =>
      rw [relationCoeff_add, map_add, hf n hn, hg n hn, map_add]
      simp only [dividedIterate, map_add, smul_add]
  | mul_X f i hf =>
      rw [relationCoeff_mul, map_sum]
      apply Eq.symm
      rw [map_mul, dividedIterate_mul D hleib]
      apply Eq.symm
      refine Finset.sum_congr rfl fun ab hab => ?_
      have hab_eq : ab.1 + ab.2 = n := Finset.mem_antidiagonal.mp hab
      have hleft : ab.1 ≤ m := by omega
      have hright : ab.2 ≤ m := by omega
      rw [map_mul, hf ab.1 hleft, relationCoeff_X,
        derivationJetEval_jetVariable D m x i ab.2 hright]
      simp

/-- If the base relations vanish, every retained differential relation vanishes. -/
theorem derivationJetEval_jetIdeal_le_ker (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0)
    (m : ℕ) (x : σ → A)
    (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) :
    jetIdeal (R := ℂ) m I ≤ RingHom.ker (derivationJetEval D m x).toRingHom := by
  rw [jetIdeal, Ideal.span_le]
  rintro g ⟨fj, rfl⟩
  change derivationJetEval D m x (jetCoeff (R := ℂ) m fj.2 fj.1.1) = 0
  rw [jetCoeff_apply,
    derivationJetEval_relationCoeff D hleib hOne m fj.2 (Nat.le_of_lt_succ fj.2.isLt)]
  have hf : MvPolynomial.aeval x fj.1.1 = 0 := RingHom.mem_ker.mp (hI fj.1.2)
  rw [hf, dividedIterate_zero_apply]

/-- The finite-jet algebra map induced by a derivation and a presentation whose base relations
vanish under the chosen assignment. -/
noncomputable def presentedJetToDifferentialAlgebra (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0) (m : ℕ)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) :
    PresentedJet (R := ℂ) m I →ₐ[ℂ] A :=
  Ideal.Quotient.liftₐ (jetIdeal (R := ℂ) m I) (derivationJetEval D m x)
    (fun _a ha => RingHom.mem_ker.mp
      (derivationJetEval_jetIdeal_le_ker D hleib hOne m x I hI ha))

@[simp] theorem presentedJetToDifferentialAlgebra_mk (D : A →ₗ[ℂ] A)
    (hleib : ∀ a b : A, D (a * b) = D a * b + a * D b) (hOne : D 1 = 0) (m : ℕ)
    (x : σ → A) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) (f : JetPoly ℂ σ m) :
    presentedJetToDifferentialAlgebra D hleib hOne m x I hI
        (presentedJetMk (R := ℂ) m I f) =
      derivationJetEval D m x f := by
  rfl

end DerivationEvaluation

end FiniteJet

section LiJetMap

variable {V : Type uV} [AddCommGroup V] [Module ℂ V]

/-- Every `C₂` relation lies one step down in the adjoint Li filtration. -/
theorem O₂_le_liFiltration_one (W : VertexOperatorAlgebra V) :
    O₂ W ≤ liFiltration W 1 := by
  intro c hc
  have hvac : W.vacuum ∈
      Gfil (adjointWeakModule W) ({W.vacuum} : Set V) 0 :=
    mem_Gfil_of_mem_B (adjointWeakModule W) ({W.vacuum} : Set V)
      (Set.mem_singleton W.vacuum) (by norm_num)
  have h := O₂_act_mem_Gfil (adjointWeakModule W) ({W.vacuum} : Set V)
    (lwGenerated_adjoint W) hc (-1) hvac
  change W.smul c (-1) W.vacuum ∈
    Gfil (adjointWeakModule W) ({W.vacuum} : Set V) 1 at h
  simpa only [liFiltration, PreVertexAlgebra.smul_vacuum_neg_one] using h

/-- Translation kills the unit of the Li associated graded. -/
@[simp] theorem liAssociatedGradedTranslation_one (W : VertexOperatorAlgebra V) :
    liAssociatedGradedTranslation W (1 : liAssociatedGraded W) = 0 := by
  rw [liAssociatedGraded_one, liAssociatedGradedTranslation_of]
  have hlayer : liWeightLayerTranslation W 0 0 (liWeightLayerVacuum W) = 0 := by
    rw [liWeightLayerVacuum, liWeightLayerTranslation_mk]
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    change W.L (-1) W.vacuum ∈ liWeightPiece W 2 1
    have hv : W.L (-1) W.vacuum = W.toPreVertexAlgebra.T W.vacuum := by
      rw [VertexOperatorAlgebra.T_eq_Lneg1]
    rw [hv, PreVertexAlgebra.T_vacuum]
    exact Submodule.zero_mem _
  rw [hlayer]
  exact map_zero _

/-- The degree-zero Li class of a homogeneous state. -/
noncomputable def liDegreeZeroClass (W : VertexOperatorAlgebra V) (N : ℕ)
    (x : W.grading (N : ℤ)) : liAssociatedGraded W :=
  DirectSum.of (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (0, N)
    (((liWeightPiece W 1 N).comap (liWeightPiece W 0 N).subtype).mkQ
      ⟨x.1, by
        rw [liWeightPiece, Submodule.mem_inf]
        exact ⟨by rw [liFiltration_zero_eq_top]; exact Submodule.mem_top, x.2⟩⟩)

/-- Insert representatives of one exact fixed-weight Li layer into the external associated
graded, as a linear map. -/
noncomputable def liHomogeneousClassLinear (W : VertexOperatorAlgebra V) (p N : ℕ) :
    liWeightPiece W p N →ₗ[ℂ] liAssociatedGraded W :=
  (DirectSum.lof ℂ (ℕ × ℕ) (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (p, N)).comp
    ((liWeightPiece W (p + 1) N).comap (liWeightPiece W p N).subtype).mkQ

/-- Insert a representative of one exact fixed-weight Li layer into the external associated
graded.  This small wrapper is useful when formulating filtered normal-form criteria. -/
noncomputable def liHomogeneousClass (W : VertexOperatorAlgebra V) (p N : ℕ)
    (x : liWeightPiece W p N) : liAssociatedGraded W :=
  liHomogeneousClassLinear W p N x

@[simp] theorem liHomogeneousClass_zero (W : VertexOperatorAlgebra V) (p N : ℕ) :
    liHomogeneousClass W p N 0 = 0 := by
  exact map_zero (liHomogeneousClassLinear W p N)

theorem liHomogeneousClass_add (W : VertexOperatorAlgebra V) (p N : ℕ)
    (x y : liWeightPiece W p N) :
    liHomogeneousClass W p N (x + y) =
      liHomogeneousClass W p N x + liHomogeneousClass W p N y := by
  exact map_add (liHomogeneousClassLinear W p N) x y

theorem liHomogeneousClass_smul (W : VertexOperatorAlgebra V) (p N : ℕ)
    (c : ℂ) (x : liWeightPiece W p N) :
    liHomogeneousClass W p N (c • x) = c • liHomogeneousClass W p N x := by
  exact map_smul (liHomogeneousClassLinear W p N) c x

/-- A homogeneous `C₂` relation has zero degree-zero Li class. -/
theorem liDegreeZeroClass_eq_zero_of_mem_O₂ (W : VertexOperatorAlgebra V) (N : ℕ)
    (x : W.grading (N : ℤ)) (hx : x.1 ∈ O₂ W) :
    liDegreeZeroClass W N x = 0 := by
  rw [liDegreeZeroClass]
  have hq :
      ((liWeightPiece W 1 N).comap (liWeightPiece W 0 N).subtype).mkQ
          ⟨x.1, by
            rw [liWeightPiece, Submodule.mem_inf]
            exact ⟨by rw [liFiltration_zero_eq_top]; exact Submodule.mem_top, x.2⟩⟩ = 0 := by
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    change x.1 ∈ liWeightPiece W 1 N
    exact ⟨O₂_le_liFiltration_one W hx, x.2⟩
  rw [hq]
  exact map_zero _

/-- The polynomial finite-jet map obtained by sending a jet variable to the corresponding divided
iterate of a chosen Li degree-zero class. -/
noncomputable def liFiniteJetPolynomialMap (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) :
    FiniteJet.JetPoly ℂ σ m →ₐ[ℂ] liAssociatedGraded W :=
  FiniteJet.derivationJetEval (liAssociatedGradedTranslation W) m x

/-- The canonical presentation-level finite-jet map, conditional only on the base presentation
relations already vanishing on the chosen degree-zero Li classes.  Neither surjectivity nor
injectivity is part of this construction. -/
noncomputable def liPresentedJetMap (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) :
    FiniteJet.PresentedJet (R := ℂ) m I →ₐ[ℂ] liAssociatedGraded W :=
  FiniteJet.presentedJetToDifferentialAlgebra (liAssociatedGradedTranslation W)
    (liAssociatedGradedTranslation_leibniz W) (liAssociatedGradedTranslation_one W) m x I hI

@[simp] theorem liPresentedJetMap_mk (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (f : FiniteJet.JetPoly ℂ σ m) :
    liPresentedJetMap W m x I hI (FiniteJet.presentedJetMk (R := ℂ) m I f) =
      liFiniteJetPolynomialMap W m x f := by
  rfl

/-- Exact polynomial-kernel form of finite presentation-level injectivity.  This is the natural
output of a Gröbner, normal-form, or restricted-dual carrier calculation: the only polynomial
relations killed by the Li evaluation are the retained differential consequences of `I`. -/
theorem liPresentedJetMap_injective_iff_polynomial_kernel
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom) :
    Function.Injective (liPresentedJetMap W m x I hI) ↔
      RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom =
        FiniteJet.jetIdeal (R := ℂ) m I := by
  constructor
  · intro hinj
    apply le_antisymm
    · intro f hf
      change liFiniteJetPolynomialMap W m x f = 0 at hf
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      apply hinj
      change liPresentedJetMap W m x I hI
          (FiniteJet.presentedJetMk (R := ℂ) m I f) =
        liPresentedJetMap W m x I hI 0
      rw [liPresentedJetMap_mk, hf, map_zero]
    · intro f hf
      change liFiniteJetPolynomialMap W m x f = 0
      rw [← liPresentedJetMap_mk W m x I hI]
      have hmk : FiniteJet.presentedJetMk (R := ℂ) m I f = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hf
      rw [hmk, map_zero]
  · intro hker
    apply (injective_iff_map_eq_zero (liPresentedJetMap W m x I hI)).mpr
    intro y
    refine Submodule.Quotient.induction_on _ y fun f hf ↦ ?_
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    rw [← hker]
    apply RingHom.mem_ker.mpr
    change liFiniteJetPolynomialMap W m x f = 0
    rw [← liPresentedJetMap_mk W m x I hI]
    exact hf

/-- Componentwise carrier or Hilbert bounds imply the exact finite Li-evaluation kernel.  The
weight monoid may be a genuine bidegree: finite support of a polynomial is the only assembly
input. -/
theorem liFiniteJetPolynomialMap_kernel_eq_of_weightedComponents_mem
    {D : Type uD} [AddCommMonoid D]
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (weight : FiniteJet.JetVar σ m → D)
    (hcomponent : ∀ p ∈ RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom, ∀ d,
      MvPolynomial.weightedHomogeneousComponent weight d p ∈
        FiniteJet.jetIdeal (R := ℂ) m I) :
    RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom =
      FiniteJet.jetIdeal (R := ℂ) m I := by
  apply le_antisymm
  · intro p hp
    rw [← MvPolynomial.sum_weightedHomogeneousComponent weight p]
    rw [finsum_eq_sum _ (MvPolynomial.weightedHomogeneousComponent_finsupp p)]
    exact (FiniteJet.jetIdeal (R := ℂ) m I).sum_mem fun d _ => hcomponent p hp d
  · intro p hp
    change liFiniteJetPolynomialMap W m x p = 0
    rw [← liPresentedJetMap_mk W m x I hI]
    have hmk : FiniteJet.presentedJetMk (R := ℂ) m I p = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hp
    rw [hmk, map_zero]

/-- Bigraded specialization of componentwise exactness for the natural Li/conformal degree on
jet variables. -/
theorem liFiniteJetPolynomialMap_kernel_eq_of_bidegreeComponents_mem
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (baseWeight : σ → ℕ)
    (hcomponent : ∀ p ∈ RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom,
      ∀ d : ℕ × ℕ,
        MvPolynomial.weightedHomogeneousComponent
            (FiniteJet.jetLiBidegree baseWeight m) d p ∈
          FiniteJet.jetIdeal (R := ℂ) m I) :
    RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom =
      FiniteJet.jetIdeal (R := ℂ) m I :=
  liFiniteJetPolynomialMap_kernel_eq_of_weightedComponents_mem
    W m x I hI (FiniteJet.jetLiBidegree baseWeight m) hcomponent

/-! ## Fixed-bidegree Hilbert squeeze -/

/-- Restrict the presented finite-jet map to polynomial representatives of exact
Li/conformal bidegree `(p,N)`, then project its value to the matching homogeneous Li layer.

This definition does not assume that the full evaluation is homogeneous.  That preservation
statement is kept as a separate hypothesis below, so model-specific carrier arguments can use
the smallest interface they actually prove. -/
noncomputable def liPresentedJetBidegreeMap
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (baseWeight : σ → ℕ) (p N : ℕ) :
    FiniteJet.PresentedJetLiBidegreeImage baseWeight m p N I →ₗ[ℂ]
      liWeightLayer W p N :=
  (DirectSum.component ℂ (ℕ × ℕ)
      (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (p, N)).comp
    ((liPresentedJetMap W m x I hI).toLinearMap.comp
      (Submodule.subtype
        (FiniteJet.PresentedJetLiBidegreeImage baseWeight m p N I)))

/-- The finite-dimensional Hilbert squeeze on one exact jet/Li bidegree.  Surjectivity is the
generator-word statement; the displayed dimension inequality is the normal-form, carrier, or
character input. -/
theorem liPresentedJetBidegreeMap_injective_of_surjective_of_finrank_le
    [Finite σ]
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (baseWeight : σ → ℕ) (hpositive : ∀ i, 0 < baseWeight i) (p N : ℕ)
    (hsurj : Function.Surjective
      (liPresentedJetBidegreeMap W m x I hI baseWeight p N))
    (hle : Module.finrank ℂ
        (FiniteJet.PresentedJetLiBidegreeImage baseWeight m p N I) ≤
      Module.finrank ℂ (liWeightLayer W p N)) :
    Function.Injective
      (liPresentedJetBidegreeMap W m x I hI baseWeight p N) := by
  letI : FiniteDimensional ℂ
      (FiniteJet.PresentedJetLiBidegreeImage baseWeight m p N I) :=
    FiniteJet.finiteDimensional_presentedJetLiBidegreeImage
      baseWeight hpositive m p N I
  letI : FiniteDimensional ℂ (liWeightLayer W p N) :=
    liAssociatedGraded_component_finiteDimensional W p N
  exact FiniteHilbertSqueeze.injective_of_surjective_of_finrank_le
    (liPresentedJetBidegreeMap W m x I hI baseWeight p N) hsurj hle

/-- Injectivity of the projected map on one bidegree detects membership in the finite jet
relation ideal for every homogeneous polynomial in that bidegree. -/
theorem mem_jetIdeal_of_bidegree_of_liPresentedJetBidegreeMap_injective
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (baseWeight : σ → ℕ) (p N : ℕ)
    (hinj : Function.Injective
      (liPresentedJetBidegreeMap W m x I hI baseWeight p N))
    {f : FiniteJet.JetPoly ℂ σ m}
    (hf : f.IsWeightedHomogeneous
      (FiniteJet.jetLiBidegree baseWeight m) (p, N))
    (hzero : liFiniteJetPolynomialMap W m x f = 0) :
    f ∈ FiniteJet.jetIdeal (R := ℂ) m I := by
  let z : FiniteJet.PresentedJetLiBidegreeImage baseWeight m p N I :=
    ⟨FiniteJet.presentedJetMk (R := ℂ) m I f, ⟨⟨f, hf⟩, rfl⟩⟩
  have hz : liPresentedJetBidegreeMap W m x I hI baseWeight p N z = 0 := by
    change DirectSum.component ℂ (ℕ × ℕ)
        (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (p, N)
        (liFiniteJetPolynomialMap W m x f) = 0
    rw [hzero, map_zero]
  have hz0 : z = 0 := hinj hz
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  exact congrArg Subtype.val hz0

/-- **Componentwise Hilbert-squeeze criterion for an exact finite Li kernel.**  Besides the
surjective equal-dimension comparison in every bidegree, one needs only the explicit statement
that taking a polynomial's weighted-homogeneous component preserves the Li-evaluation kernel.
This last clause is precisely the bidegree-preservation bridge and is intentionally exposed.
-/
theorem liFiniteJetPolynomialMap_kernel_eq_of_bidegree_hilbert_squeeze
    [Finite σ]
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (baseWeight : σ → ℕ) (hpositive : ∀ i, 0 < baseWeight i)
    (hkernelComponent :
      ∀ f ∈ RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom,
        ∀ d : ℕ × ℕ,
          MvPolynomial.weightedHomogeneousComponent
              (FiniteJet.jetLiBidegree baseWeight m) d f ∈
            RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom)
    (hsurj : ∀ p N, Function.Surjective
      (liPresentedJetBidegreeMap W m x I hI baseWeight p N))
    (hle : ∀ p N,
      Module.finrank ℂ
          (FiniteJet.PresentedJetLiBidegreeImage baseWeight m p N I) ≤
        Module.finrank ℂ (liWeightLayer W p N)) :
    RingHom.ker (liFiniteJetPolynomialMap W m x).toRingHom =
      FiniteJet.jetIdeal (R := ℂ) m I := by
  apply liFiniteJetPolynomialMap_kernel_eq_of_bidegreeComponents_mem
    W m x I hI baseWeight
  intro f hf d
  rcases d with ⟨p, N⟩
  apply mem_jetIdeal_of_bidegree_of_liPresentedJetBidegreeMap_injective
    W m x I hI baseWeight p N
  · exact liPresentedJetBidegreeMap_injective_of_surjective_of_finrank_le
      W m x I hI baseWeight hpositive p N (hsurj p N) (hle p N)
  · exact MvPolynomial.weightedHomogeneousComponent_isWeightedHomogeneous
      (w := FiniteJet.jetLiBidegree baseWeight m) (n := (p, N)) (φ := f)
  · exact RingHom.mem_ker.mp (hkernelComponent f hf (p, N))

/-- A precise surjectivity interface: it is enough to hit every homogeneous Li layer.  The
substantive model-specific input is the hypothesis `hhom`, i.e. generation of every Li class by
the chosen translated degree-zero classes. -/
theorem liPresentedJetMap_surjective_of_homogeneous_classes
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    (hhom : ∀ p N (z : liWeightLayer W p N),
      ∃ y : FiniteJet.PresentedJet (R := ℂ) m I,
        liPresentedJetMap W m x I hI y =
          DirectSum.of (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (p, N) z) :
    Function.Surjective (liPresentedJetMap W m x I hI) := by
  intro a
  induction a using DirectSum.induction_on with
  | zero =>
      exact ⟨0, map_zero _⟩
  | of d z =>
      rcases d with ⟨p, N⟩
      exact hhom p N z
  | add a b ha hb =>
      obtain ⟨a', ha'⟩ := ha
      obtain ⟨b', hb'⟩ := hb
      refine ⟨a' + b', ?_⟩
      rw [map_add, ha', hb']

/-! ## Filtered ordered-word criterion for homogeneous generation -/

/-- The ordered generator span at level `p` is contained in the Li filtration at level `p`.
This is the easy direction complementary to the substantive straightening theorem `master`. -/
theorem ordSpanAll_adjoint_le_liFiltration (W : VertexOperatorAlgebra V)
    {g : ℕ} (gen : Fin g → V) (wt : Fin g → ℕ)
    (hgen : ∀ i, gen i ∈ W.grading (wt i : ℤ)) (p : ℕ) :
    ordSpanAll (adjointWeakModule W) ({W.vacuum} : Set V) gen wt p ≤ liFiltration W p := by
  rw [ordSpanAll, Submodule.span_le]
  rintro u ⟨l, w, _hl, hp, hw, rfl⟩
  have hw' : w = W.vacuum := Set.mem_singleton_iff.mp hw
  subst w
  exact genWord_mem_Gfil (adjointWeakModule W) ({W.vacuum} : Set V) hgen l
    (Set.mem_singleton W.vacuum) (by exact_mod_cast hp)

/-- A linear map out of a span lands in another linear map's range once this holds on the
spanning set.  Keeping this bookkeeping lemma independent of Li-filtration proof terms makes the
filtered normal-form argument below both reusable and inexpensive to elaborate. -/
theorem linearMap_mem_range_of_mem_span
    {E : Type uE} {A : Type uA} {B : Type uB} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup A] [Module ℂ A] [AddCommGroup B] [Module ℂ B]
    (s : Set E) (f : A →ₗ[ℂ] B) (q : Submodule.span ℂ s →ₗ[ℂ] B)
    (hgen : ∀ (a : E) (ha : a ∈ s),
      q ⟨a, Submodule.subset_span ha⟩ ∈ LinearMap.range f)
    (a : E) (ha : a ∈ Submodule.span ℂ s) :
    q ⟨a, ha⟩ ∈ LinearMap.range f := by
  refine Submodule.span_induction
    (p := fun a ha => q ⟨a, ha⟩ ∈ LinearMap.range f) hgen ?_ ?_ ?_ ha
  · change q (0 : Submodule.span ℂ s) ∈ LinearMap.range f
    rw [map_zero]
    exact (LinearMap.range f).zero_mem
  · intro a b ha hb hqa hqb
    change q ((⟨a, ha⟩ : Submodule.span ℂ s) + ⟨b, hb⟩) ∈ LinearMap.range f
    rw [map_add]
    exact (LinearMap.range f).add_mem hqa hqb
  · intro c a ha hqa
    change q (c • (⟨a, ha⟩ : Submodule.span ℂ s)) ∈ LinearMap.range f
    rw [map_smul]
    exact (LinearMap.range f).smul_mem c hqa

/-! ### The exact state-level divided-translation bridge -/

/-- The state-side divided translate `T^r a / r!` matching the Hasse--Schmidt normalization of
the jet variable of order `r`. -/
noncomputable def dividedTranslateState (W : VertexOperatorAlgebra V) (r : ℕ) (a : V) : V :=
  ((r.factorial : ℂ)⁻¹) • ((W.toPreVertexAlgebra.T ^ r) a)

/-- A negative creation mode is exactly `(-1)`-multiplication by the divided translate:
`(T^r a / r!)_{(-1)} b = a_{(-r-1)} b`. -/
theorem smul_dividedTranslateState_neg_one (W : VertexOperatorAlgebra V)
    (a b : V) (r : ℕ) :
    W.smul (dividedTranslateState W r a) (-1) b =
      W.smul a (-(r : ℤ) - 1) b := by
  rw [dividedTranslateState, PreVertexAlgebra.smul_smul_left,
    VertexOperatorAlgebra.smul_Tpow_neg_one]
  rw [← Int.cast_smul_eq_zsmul ℂ (r.factorial : ℤ), smul_smul]
  have hfac : ((r.factorial : ℤ) : ℂ) = (r.factorial : ℂ) := by norm_num
  rw [hfac, inv_mul_cancel₀]
  · exact one_smul ℂ _
  · exact_mod_cast Nat.factorial_ne_zero r

/-- The iterated `(-1)`-product of state-side divided translates. -/
noncomputable def dividedTranslatedWord (W : VertexOperatorAlgebra V)
    {g : ℕ} (gen : Fin g → V) : List (Fin g × ℕ) → V
  | [] => W.vacuum
  | q :: t => W.smul (dividedTranslateState W q.2 (gen q.1)) (-1)
      (dividedTranslatedWord W gen t)

/-- **Exact normal-form bridge at state level.**  A generator word in arbitrary negative modes
is literally the iterated `(-1)`-product of the matching divided translates.  No quotient,
filtration, ordering, or spanning assumption is used. -/
theorem dividedTranslatedWord_eq_wordAct (W : VertexOperatorAlgebra V)
    {g : ℕ} (gen : Fin g → V) (wt : Fin g → ℕ) :
    ∀ l : List (Fin g × ℕ),
      dividedTranslatedWord W gen l =
        wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum := by
  intro l
  induction l with
  | nil => rfl
  | cons q t ih =>
      rw [dividedTranslatedWord, genWord_cons, wordAct_cons, ih,
        smul_dividedTranslateState_neg_one]
      rfl

-- The ordered-span eliminator expands several nested finite sums; give elaboration room locally.
set_option maxHeartbeats 800000 in
/-- **Finite homogeneous-generation criterion.**  Suppose positive-weight homogeneous states
`gen` span `V` modulo the vacuum and `C₂(V)`.  The filtered straightening theorem then reduces
surjectivity onto the exact bidegree `(p,N)` to one explicit state-level statement: every sorted
generator word of *exact* Li level `p` and conformal weight `N` has a preimage under the chosen
finite-jet map.

Words of level greater than `p` vanish in the exact quotient, while words of the wrong conformal
weight vanish after weight projection.  Thus `hword` is the only remaining normal-form bridge;
in applications it is supplied by the identity
`(T^r a)_{(-1)}b = r! a_{(-r-1)}b` together with the definition of divided jet evaluation. -/
theorem liPresentedJetMap_hits_homogeneous_class_of_ordered_words
    (W : VertexOperatorAlgebra V) (m : ℕ)
    (x : σ → liAssociatedGraded W) (I : Ideal (MvPolynomial σ ℂ))
    (hI : I ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom)
    {g : ℕ} (gen : Fin g → V) (wt : Fin g → ℕ)
    (hgen : ∀ i, gen i ∈ W.grading (wt i : ℤ))
    (hdec : (⊤ : Submodule ℂ V) =
      Submodule.span ℂ (Set.range gen ∪ {W.vacuum}) ⊔ O₂ W)
    (p N : ℕ)
    (hword : ∀ (l : List (Fin g × ℕ)) (_hl : OrdPairs l)
      (hlevel : pairsLevel l = p) (hdegree : wordDeg (genWord gen wt l) = N),
      ∃ y : FiniteJet.PresentedJet (R := ℂ) m I,
        liPresentedJetMap W m x I hI y =
          liHomogeneousClass W p N
              ⟨wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum,
              ⟨genWord_mem_Gfil (adjointWeakModule W) ({W.vacuum} : Set V) hgen l
                  (Set.mem_singleton W.vacuum) (by exact_mod_cast hlevel.ge),
                by
                  have hvac : W.vacuum ∈ (adjointModule W).weight 0 := by
                    change W.vacuum ∈ adjWeight W 0
                    have hzero : (0 : ℂ) = ((0 : ℤ) : ℂ) := by norm_num
                    rw [hzero, adjWeight_cast W 0]
                    exact W.vacuum_mem_grading_zero
                  have hu := wordAct_mem_weight (adjointModule W)
                    (genWord_ok hgen l) hvac
                  have hcast : ((wordDeg (genWord gen wt l) : ℕ) : ℂ) =
                      ((N : ℤ) : ℂ) := by exact_mod_cast hdegree
                  change wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum ∈
                    adjWeight W ((0 : ℂ) + (wordDeg (genWord gen wt l) : ℂ)) at hu
                  rw [zero_add, hcast, adjWeight_cast W N] at hu
                  exact hu⟩⟩) :
    ∀ z : liWeightLayer W p N,
      ∃ y : FiniteJet.PresentedJet (R := ℂ) m I,
        liPresentedJetMap W m x I hI y =
          DirectSum.of (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (p, N) z := by
  intro z
  refine Submodule.Quotient.induction_on _ z fun zrep => ?_
  let P : Module.End ℂ V := wProj (adjointModule W) (N : ℂ)
  have hvacWeight : W.vacuum ∈ (adjointModule W).weight 0 := by
    change W.vacuum ∈ adjWeight W 0
    have hzero : (0 : ℂ) = ((0 : ℤ) : ℂ) := by norm_num
    rw [hzero, adjWeight_cast W 0]
    exact W.vacuum_mem_grading_zero
  have hbottom : ∀ w ∈ ({W.vacuum} : Set V),
      ∃ d₀ : ℕ, w ∈ (adjointModule W).weight ((0 : ℂ) + d₀) := by
    intro w hw
    have hw' : w = W.vacuum := Set.mem_singleton_iff.mp hw
    subst w
    exact ⟨0, by simpa using hvacWeight⟩
  have hprojGrade (a : V) : P a ∈ W.grading (N : ℤ) := by
    have ha := wProj_apply_mem (adjointModule W) (N : ℂ) a
    change P a ∈ adjWeight W (N : ℂ) at ha
    have hcast : (N : ℂ) = ((N : ℤ) : ℂ) := by norm_num
    rw [hcast, adjWeight_cast W N] at ha
    exact ha
  have hordLe := ordSpanAll_adjoint_le_liFiltration W gen wt hgen p
  have hprojFiltration (a : V)
      (ha : a ∈ ordSpanAll (adjointWeakModule W) ({W.vacuum} : Set V) gen wt p) :
      P a ∈ liFiltration W p := by
    apply hordLe
    exact wProj_mem_ordSpanAll (adjointModule W) ({W.vacuum} : Set V) 0 hbottom hgen
      (N : ℂ) ha
  let G : Set V :=
    {u | ∃ (l : List (Fin g × ℕ)) (w : V), OrdPairs l ∧ p ≤ pairsLevel l ∧
      w ∈ ({W.vacuum} : Set V) ∧
      u = wordAct (adjointWeakModule W) (genWord gen wt l) w}
  let toPiece : Submodule.span ℂ G →ₗ[ℂ] liWeightPiece W p N :=
    { toFun := fun a => ⟨P a.1, hprojFiltration a.1 a.2, hprojGrade a.1⟩
      map_add' := fun a b => by
        apply Subtype.ext
        exact map_add P a.1 b.1
      map_smul' := fun c a => by
        apply Subtype.ext
        exact map_smul P c a.1 }
  let Q : Submodule.span ℂ G →ₗ[ℂ] liAssociatedGraded W :=
    (liHomogeneousClassLinear W p N).comp toPiece
  let jetLinear : FiniteJet.PresentedJet (R := ℂ) m I →ₗ[ℂ] liAssociatedGraded W :=
    (liPresentedJetMap W m x I hI).toLinearMap
  have hitsGenerator : ∀ (u : V) (hu : u ∈ G),
      Q ⟨u, Submodule.subset_span hu⟩ ∈ LinearMap.range jetLinear := by
    rintro u ⟨l, w, hl, hp, hw, rfl⟩
    have hw' : w = W.vacuum := Set.mem_singleton_iff.mp hw
    subst w
    have huWeight := wordAct_mem_weight (adjointModule W)
      (genWord_ok hgen l) hvacWeight
    by_cases hlevel : pairsLevel l = p
    · by_cases hdegree : wordDeg (genWord gen wt l) = N
      · have hproj : P (wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum) =
            wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum := by
          apply wProj_of_mem (adjointModule W)
          change wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum ∈
            adjWeight W ((0 : ℂ) + (wordDeg (genWord gen wt l) : ℂ)) at huWeight
          have hcast : ((0 : ℂ) + (wordDeg (genWord gen wt l) : ℂ)) = (N : ℂ) := by
            rw [zero_add, hdegree]
          rwa [hcast] at huWeight
        obtain ⟨y, hy⟩ := hword l hl hlevel hdegree
        refine ⟨y, ?_⟩
        change liPresentedJetMap W m x I hI y = _
        rw [hy]
        change liHomogeneousClass W p N _ = liHomogeneousClass W p N _
        apply congrArg (liHomogeneousClass W p N)
        exact Subtype.ext hproj.symm
      · have hproj : P (wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum) = 0 := by
          apply wProj_of_mem_ne (adjointModule W) huWeight
          intro heq
          have hnat : N = 0 + wordDeg (genWord gen wt l) := by exact_mod_cast heq
          exact hdegree (by omega)
        refine ⟨0, ?_⟩
        rw [map_zero]
        change 0 = liHomogeneousClass W p N _
        rw [← liHomogeneousClass_zero W p N]
        apply congrArg (liHomogeneousClass W p N)
        exact Subtype.ext hproj.symm
    · have hstrict : p < pairsLevel l := lt_of_le_of_ne hp (Ne.symm hlevel)
      have huNext : wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum ∈
          liFiltration W (p + 1) := by
        exact genWord_mem_Gfil (adjointWeakModule W) ({W.vacuum} : Set V) hgen l
          (Set.mem_singleton W.vacuum) (by exact_mod_cast hstrict)
      have hprojNext : P (wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum) ∈
          liFiltration W (p + 1) := by
        exact wProj_mem_Gfil (adjointModule W) ({W.vacuum} : Set V) 0 hbottom
          (N : ℂ) huNext
      refine ⟨0, ?_⟩
      rw [map_zero]
      change 0 = liHomogeneousClass W p N _
      have hq :
          ((liWeightPiece W (p + 1) N).comap (liWeightPiece W p N).subtype).mkQ
              ⟨P (wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum),
                hprojFiltration _ (Submodule.subset_span ⟨l, W.vacuum, hl, hp,
                  Set.mem_singleton W.vacuum, rfl⟩), hprojGrade _⟩ = 0 := by
        apply (Submodule.Quotient.mk_eq_zero _).mpr
        exact ⟨hprojNext, hprojGrade _⟩
      change 0 = liHomogeneousClass W p N
        ⟨P (wordAct (adjointWeakModule W) (genWord gen wt l) W.vacuum),
          hprojFiltration _ (Submodule.subset_span ⟨l, W.vacuum, hl, hp,
            Set.mem_singleton W.vacuum, rfl⟩), hprojGrade _⟩
      change 0 = DirectSum.of (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (p, N) _
      rw [hq, map_zero]
  have hitsOrdered : ∀ (a : V)
      (ha : a ∈ ordSpanAll (adjointWeakModule W) ({W.vacuum} : Set V) gen wt p),
      Q ⟨a, ha⟩ ∈ LinearMap.range jetLinear := by
    intro a ha
    have haG : a ∈ Submodule.span ℂ G := ha
    have h := linearMap_mem_range_of_mem_span
      (E := V) (A := FiniteJet.PresentedJet (R := ℂ) m I)
      (B := liAssociatedGraded W) G jetLinear Q hitsGenerator a haG
    exact h
  have hzFiltration : (zrep : V) ∈ liFiltration W p := zrep.property.1
  have hmaster := master (adjointWeakModule W) ({W.vacuum} : Set V)
    (lwGenerated_adjoint W) hgen hdec p hzFiltration
  rw [Submodule.mem_sup] at hmaster
  obtain ⟨a, ha, b, hb, hab⟩ := hmaster
  have hzWeight : (zrep : V) ∈ (adjointModule W).weight (N : ℂ) := by
    change (zrep : V) ∈ adjWeight W (N : ℂ)
    have hcast : (N : ℂ) = ((N : ℤ) : ℂ) := by norm_num
    rw [hcast, adjWeight_cast W N]
    exact zrep.property.2
  have hprojZ : P (zrep : V) = zrep := wProj_of_mem (adjointModule W) hzWeight
  have hdecomp : (zrep : V) = P a + P b := by
    calc
      (zrep : V) = P (zrep : V) := hprojZ.symm
      _ = P (a + b) := congrArg P hab.symm
      _ = P a + P b := map_add P a b
  have hprojBNext : P b ∈ liFiltration W (p + 1) := by
    exact wProj_mem_Gfil (adjointModule W) ({W.vacuum} : Set V) 0 hbottom
      (N : ℂ) hb
  obtain ⟨y, hy⟩ := hitsOrdered a ha
  change liPresentedJetMap W m x I hI y = Q ⟨a, ha⟩ at hy
  refine ⟨y, ?_⟩
  rw [hy]
  change liHomogeneousClass W p N
      ⟨P a, hprojFiltration a ha, hprojGrade a⟩ =
    liHomogeneousClass W p N zrep
  have hprojB : P b ∈ liFiltration W p :=
    (liWeightPiece_antitone W N (Nat.le_succ p) ⟨hprojBNext, hprojGrade b⟩).1
  have hsubtype : zrep =
      (⟨P a, hprojFiltration a ha, hprojGrade a⟩ : liWeightPiece W p N) +
        ⟨P b, hprojB, hprojGrade b⟩ := by
    exact Subtype.ext hdecomp
  have hzero :
      ((liWeightPiece W (p + 1) N).comap (liWeightPiece W p N).subtype).mkQ
          (⟨P b, hprojB, hprojGrade b⟩ : liWeightPiece W p N) = 0 := by
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    exact ⟨hprojBNext, hprojGrade b⟩
  have hbClass : liHomogeneousClass W p N
      (⟨P b, hprojB, hprojGrade b⟩ : liWeightPiece W p N) = 0 := by
    change DirectSum.of (fun d : ℕ × ℕ => liWeightLayer W d.1 d.2) (p, N) _ = 0
    rw [hzero, map_zero]
  rw [hsubtype, liHomogeneousClass_add, hbClass, add_zero]

end LiJetMap

end VOA

