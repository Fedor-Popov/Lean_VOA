import VOA.Huang.ZhuSemisimple
import VOA.Modules.ZhuVermaAnArchHL0

/-! # The rational descent step in Li's converse

A completely reducible graded module generated by its bottom has no nonzero
submodule disjoint from that bottom. Applying this to the actual Dong–Jiang
module proves that `pPhiBar P : M(P(0)) → P` is bijective under admissible
rationality. The bottom projection datum remains explicit; no project PBW
witness is invoked. This is the descent step, not the construction of an
intertwiner on the induced modules (Li, math/9909007, Theorem 4.14 and
Corollary 4.17).
-/
namespace VOA.Huang.LiFusion
open VOA GradedLWWeakModule VHat VHat.DLM3
universe u v
variable {V : Type u} [AddCommGroup V] [Module ℂ V]
  {W : VertexOperatorAlgebra V}

/-- A split submodule disjoint from the generating bottom is zero. -/
theorem submodule_eq_bot_of_bottom_disjoint
    {E : Type v} [AddCommGroup E] [Module ℂ E] {h : ℂ}
    (N : GradedLWWeakModule W E h) (hgen : GeneratedByBottom N)
    (K Q : WeakModule.Submodule' N.toWeakModule)
    (hcompl : IsCompl K.carrier Q.carrier)
    (hK : K.carrier ⊓ N.weight h = ⊥) : K.carrier = ⊥ := by
  letI := DirectSum.IsInternal.chooseDecomposition N.weight N.isInternal
  have hQ : Q.carrier = ⊤ := hgen Q (by
    intro x hx
    have hmem : x ∈ K.carrier ⊔ Q.carrier := by rw [hcompl.sup_eq_top]; trivial
    obtain ⟨k, hk, q, hq, he⟩ := Submodule.mem_sup.mp hmem
    have hk0 : ((DirectSum.decompose N.weight k h : N.weight h) : E) = 0 := by
      have hm : ((DirectSum.decompose N.weight k h : N.weight h) : E)
          ∈ K.carrier ⊓ N.weight h :=
        ⟨N.component_mem_of_graded K (N.submodule_isGraded K) hk h,
          (DirectSum.decompose N.weight k h).property⟩
      simpa only [hK, Submodule.mem_bot] using hm
    have he0 := congrArg (fun z => ((DirectSum.decompose N.weight z h : N.weight h) : E)) he
    dsimp only at he0
    rw [DirectSum.decompose_add, DirectSum.add_apply, AddMemClass.coe_add,
      DirectSum.decompose_of_mem_same N.weight hx, hk0, zero_add] at he0
    exact he0 ▸ N.component_mem_of_graded Q (N.submodule_isGraded Q) hq h)
  have hd := hcompl.inf_eq_bot
  simpa only [hQ, inf_top_eq] using hd

/-- Complete reducibility removes the maximal bottom-trivial submodule. -/
theorem maxJ_eq_bot_of_completelyReducible
    {E : Type v} [AddCommGroup E] [Module ℂ E] {h : ℂ}
    (N : GradedLWWeakModule W E h) (hgen : GeneratedByBottom N)
    (hred : ∀ K : WeakModule.Submodule' N.toWeakModule,
      ∃ Q : WeakModule.Submodule' N.toWeakModule, IsCompl K.carrier Q.carrier) :
    (maxJ N).carrier = ⊥ := by
  obtain ⟨Q, hQ⟩ := hred (maxJ N)
  exact submodule_eq_bot_of_bottom_disjoint N hgen (maxJ N) Q hQ
    (maxJ_bottom_disjoint N)

/-- Rationality makes the canonical induced-module map injective. This uses
the bottom recovery datum explicitly and proves no intertwiner existence. -/
theorem pPhiBar_injective_of_admissiblyRational
    (Pr : BottomProjection (parabolicRepOfAMod W (regularAMod W)))
    (hrat : AdmissiblyRational W) (P : LWModule W) :
    Function.Injective (pPhiBar P) := by
  let hU : Nontrivial (pBotAmMod P).carrier :=
    Submodule.nontrivial_iff_ne_bot.mpr P.realized
  let N := djGradedLW_of_pbwDatum Pr (pBotAmMod P) hU P.h (pHL0 P)
  obtain ⟨Q, hQ⟩ := hrat (ZhuSemisimple.djAdmissible (pBotAmMod P)) (pPhiBarKer P)
  apply LinearMap.ker_eq_bot.mp
  exact submodule_eq_bot_of_bottom_disjoint N
    (djGeneratedByBottom Pr (pBotAmMod P) hU P.h (pHL0 P))
    (pPhiBarKer P) Q hQ (by
      rw [show N.weight P.h = DJCarrier.deg W (pBotAmMod P) 0 from
        djCWeight_zero (pBotAmMod P) P.h]
      exact pPhiBar_bottom_trivial P Pr)

/-- The actual generalized Verma module on the bottom of an irreducible
ordinary module is that module, under admissible rationality. -/
theorem pPhiBar_bijective_of_admissiblyRational
    (Pr : BottomProjection (parabolicRepOfAMod W (regularAMod W)))
    (hrat : AdmissiblyRational W) (P : LWModule W) (hP : P.IsIrreducibleLW) :
    Function.Bijective (pPhiBar P) :=
  ⟨pPhiBar_injective_of_admissiblyRational Pr hrat P, pPhiBar_surjective P hP⟩

end VOA.Huang.LiFusion
