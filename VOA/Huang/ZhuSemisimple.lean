import VOA.Huang.BottomRecovery
import VOA.Modules.ZhuVermaAnArchLU
import VOA.Modules.AdmissibleRationality

/-!
# Zhu's semisimplicity theorem: rational ⟹ `A(V)` semisimple

Dong–Li–Mason, *Twisted representations of vertex operator algebras*, Math. Ann. 310 (1998)
571–600, Thm 8.1(a) at `g = 1` (cf. Zhu 1996, Thm 2.2.3, for a stronger notion of "rational"; the
`A_n(V)` generalisation is Dong–Li–Mason, J. Algebra 206 (1998) 67–96, Thm 4.10(a)): if every
admissible `V`-module is completely reducible, Zhu's algebra `A(V)` is semisimple.

## Proof

Let `U = A(V)` (the regular module) and `M = M(U)` Dong–Jiang's generalized Verma module, an
admissible module (`djAdmissible`) whose level `0` is `U` (`djCarrierWeak_bottom_equiv`, using the
PBW datum `Pr`). For a left ideal `T`, let `P` be the weak submodule generated by `T ⊆ M(0)`; by
bottom recovery (`Huang/BottomRecovery.lean`) `P` is graded and `P ∩ M(0) = T`. Rationality gives a
weak complement `Q`. Then

  `T' = {u | ∃ q ∈ Q, π₀ q = u ∧ q − u ∈ P}`

is a left ideal complementary to `T` (zero modes commute with `π₀`).

## Main results

* `djAdmissible` — `M(U)` as an `AdmissibleModule` (no hypotheses);
* `isSemisimpleRing_A_of_admissiblyRational` — `Pr` + `AdmissiblyRational W` ⟹
  `IsSemisimpleRing (A W)`;
* `zhuAdmissibleSemisimple_of_Pr` — the library predicate `ZhuAdmissibleSemisimple W`.

`#print axioms`: Lean's three; `Pr` is an explicit hypothesis (supplied by `VOA.pbw`).
-/

namespace VOA.Huang.ZhuSemisimple

open VOA VOA.VHat VOA.VHat.DLM3 VOA.Huang.BottomRecovery

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}

/-! ## §1 `M(U)` is admissible -/

section Admissible

variable (U : AmMod W 0)

/-- The `ℤ`-indexed levels of `M(U)`. -/
noncomputable def djLev (k : ℤ) : Submodule ℂ (DJCarrier W U) :=
  if 0 ≤ k then DJCarrier.deg W U k.toNat else ⊥

theorem djLev_nat (n : ℕ) : djLev U (n : ℤ) = DJCarrier.deg W U n := by
  simp [djLev]

theorem djLev_zero : djLev U 0 = DJCarrier.deg W U 0 := djLev_nat U 0

theorem djLev_isInternal : DirectSum.IsInternal (djLev U) := by
  rw [DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top]
  have hdeg := (DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top _).1
    (DJCarrier.isInternal_deg W U)
  constructor
  · refine iSupIndep_def.mpr (fun k => ?_)
    by_cases hk : 0 ≤ k
    · have hle : (⨆ (j : ℤ) (_ : j ≠ k), djLev U j)
          ≤ ⨆ (n : ℕ) (_ : n ≠ k.toNat), DJCarrier.deg W U n := by
        refine iSup₂_le (fun j hj => ?_)
        unfold djLev
        split_ifs with hj0
        · refine le_iSup₂_of_le j.toNat (fun h => hj ?_) le_rfl
          omega
        · exact bot_le
      have hd := iSupIndep_def.mp hdeg.1 k.toNat
      unfold djLev at hd ⊢
      rw [if_pos hk]
      exact hd.mono_right hle
    · unfold djLev
      rw [if_neg hk]
      exact disjoint_bot_left
  · rw [eq_top_iff, ← hdeg.2]
    refine iSup_le (fun n => ?_)
    rw [← djLev_nat]
    exact le_iSup (djLev U) (n : ℤ)

/-- **Dong–Jiang's `M(U)` is an admissible module**, unconditionally. -/
noncomputable def djAdmissible : AdmissibleModule W (DJCarrier W U) where
  toWeakModule := djCarrierWeak W U
  lev := djLev U
  lev_eq_bot_of_neg k hk := by unfold djLev; rw [if_neg (by omega)]
  isInternal := djLev_isInternal U
  act_lev := by
    intro w p k a ha x hx
    unfold djLev at hx
    split_ifs at hx with hk
    · have hx' : x ∈ DJCarrier.deg W U k.toNat := hx
      by_cases ht : 0 ≤ k + (w - p - 1)
      · have hN : muTargetLevel w p k.toNat = ((k + (w - p - 1)).toNat : ℤ) := by
          simp only [muTargetLevel]; omega
        have := djCarrierWeak_act_deg_mem U ha hN hx'
        unfold djLev
        rw [if_pos ht]
        exact this
      · have hneg : muTargetLevel w p k.toNat < 0 := by
          simp only [muTargetLevel]; omega
        have := djCarrierWeak_act_deg_eq_zero U ha hneg hx'
        change (djCarrierWeak W U).act a p x ∈ _
        rw [this]
        exact Submodule.zero_mem _
    · rw [Submodule.mem_bot] at hx
      subst hx
      change (djCarrierWeak W U).act a p 0 ∈ _
      rw [act_zero_right]
      exact Submodule.zero_mem _

@[simp] theorem djAdmissible_lev : (djAdmissible U).lev = djLev U := rfl

@[simp] theorem djAdmissible_act (a : 𝒱) (p : ℤ) (x : DJCarrier W U) :
    (djAdmissible U).toWeakModule.act a p x = (djCarrierWeak W U).act a p x := rfl

end Admissible

/-! ## §2 Projections commute with level-preserving operators -/

theorem levProj_comm {M : Type*} [AddCommGroup M] [Module ℂ M] (N : AdmissibleModule W M)
    (T : M →ₗ[ℂ] M) (hT : ∀ k, ∀ x ∈ N.lev k, T x ∈ N.lev k) (k : ℤ) (x : M) :
    levProj N k (T x) = T (levProj N k x) := by
  have htop : x ∈ ⨆ j, N.lev j := by
    rw [N.isInternal.submodule_iSup_eq_top]; exact Submodule.mem_top
  refine Submodule.iSup_induction _ (motive := fun x => levProj N k (T x) = T (levProj N k x))
    htop ?_ ?_ ?_
  · intro j y hy
    by_cases hjk : k = j
    · subst hjk; rw [levProj_of_mem N hy, levProj_of_mem N (hT k y hy)]
    · rw [levProj_of_mem_ne N hy hjk, levProj_of_mem_ne N (hT j y hy) hjk, map_zero]
  · simp only [map_zero]
  · intro y z hy hz
    simp only [map_add, hy, hz]

/-- A zero mode preserves every level. -/
theorem zeroMode_lev {M : Type*} [AddCommGroup M] [Module ℂ M] (N : AdmissibleModule W M)
    {a : 𝒱} {w : ℤ} (ha : a ∈ W.grading w) (k : ℤ) (x : M) (hx : x ∈ N.lev k) :
    N.toWeakModule.act a (w - 1) x ∈ N.lev k := by
  have := act_lev' N (p := w - 1) ha hx
  rwa [show k + (w - (w - 1) - 1) = k by ring] at this

/-- The zero mode as a linear map. -/
noncomputable def zeroModeLin {M : Type*} [AddCommGroup M] [Module ℂ M] (N : AdmissibleModule W M)
    (a : 𝒱) (p : ℤ) : M →ₗ[ℂ] M := mode (N.YM a) p

/-! ## §3 Semisimplicity -/

section Semisimple

variable (Pr : BottomProjection (parabolicRepOfAMod W (regularAMod W)))

/-- The bottom embedding `A(V) ≅ M(0) ⊆ M(A(V))`. -/
noncomputable def botIncl : A W →ₗ[ℂ] DJCarrier W (regularAMod W).toAmModZero :=
  (DJCarrier.deg W (regularAMod W).toAmModZero 0).subtype.comp
    (djCarrierWeak_bottom_equiv Pr (regularAMod W).toAmModZero).symm.toLinearMap

theorem botIncl_mem (u : A W) :
    botIncl Pr u ∈ (djAdmissible (regularAMod W).toAmModZero).lev 0 := by
  rw [djAdmissible_lev, djLev_zero]
  exact Submodule.coe_mem _

theorem botIncl_injective : Function.Injective (botIncl Pr) := by
  intro u v h
  have := Subtype.ext h
  exact (djCarrierWeak_bottom_equiv Pr (regularAMod W).toAmModZero).symm.injective this

theorem exists_botIncl {x : DJCarrier W (regularAMod W).toAmModZero}
    (hx : x ∈ (djAdmissible (regularAMod W).toAmModZero).lev 0) : ∃ u, botIncl Pr u = x := by
  rw [djAdmissible_lev, djLev_zero] at hx
  refine ⟨djCarrierWeak_bottom_equiv Pr (regularAMod W).toAmModZero ⟨x, hx⟩, ?_⟩
  change (((djCarrierWeak_bottom_equiv Pr (regularAMod W).toAmModZero).symm
    (djCarrierWeak_bottom_equiv Pr (regularAMod W).toAmModZero ⟨x, hx⟩) : DJCarrier.deg W _ 0)
      : DJCarrier W _) = x
  rw [LinearEquiv.symm_apply_apply]

/-- Zero modes act on the bottom through left multiplication in `A(V)`. -/
theorem zeroMode_botIncl {a : 𝒱} {w : ℤ} (ha : a ∈ W.grading w) (u : A W) :
    (djAdmissible (regularAMod W).toAmModZero).toWeakModule.act a (w - 1) (botIncl Pr u)
      = botIncl Pr (letI := instRingA W; VOA.mk W a * u) := by
  set U := (regularAMod W).toAmModZero
  set e := djCarrierWeak_bottom_equiv Pr U
  have hmem : djModeZero W U (w - 1) a ((e.symm u : DJCarrier.deg W U 0) : DJCarrier W U)
      ∈ DJCarrier.deg W U 0 := by
    have := zeroMode_lev (djAdmissible U) ha 0 _ (botIncl_mem Pr u)
    rw [djAdmissible_lev, djLev_zero, djAdmissible_act, djCarrierWeak_act] at this
    exact this
  have hrho := djCarrierWeak_bottom_equiv_rho Pr U ha (e.symm u) hmem
  rw [LinearEquiv.apply_symm_apply] at hrho
  have h2 : (⟨djModeZero W U (w - 1) a ((e.symm u : DJCarrier.deg W U 0) : DJCarrier W U), hmem⟩
      : DJCarrier.deg W U 0) = e.symm (U.ρ (mkAnFull W 0 a) u) := by
    rw [← hrho, LinearEquiv.symm_apply_apply]
  rw [djAdmissible_act, djCarrierWeak_act]
  have h3 := congrArg Subtype.val h2
  simp only at h3
  rw [show botIncl Pr u = ((e.symm u : DJCarrier.deg W U 0) : DJCarrier W U) from rfl, h3]
  rfl

include Pr in
/-- **Zhu / Dong–Li–Mason: rationality implies `A(V)` is semisimple**, given the PBW
datum `Pr`. -/
theorem isSemisimpleRing_A_of_admissiblyRational (hrat : AdmissiblyRational W) :
    letI := instRingA W; IsSemisimpleRing (A W) := by
  letI := instRingA W
  letI := instAlgebraA W
  set U := (regularAMod W).toAmModZero
  set N := djAdmissible U
  set ι := botIncl Pr
  refine (isSemisimpleModule_iff (A W) (A W)).mpr ⟨fun T => ?_⟩
  -- the image of `T` in the bottom
  let S : Submodule ℂ (DJCarrier W U) := (T.restrictScalars ℂ).map ι
  have hS0 : S ≤ N.lev 0 := by
    rintro _ ⟨u, _, rfl⟩; exact botIncl_mem Pr u
  have hSo : ∀ ⦃a : 𝒱⦄ ⦃w : ℤ⦄, a ∈ W.grading w → ∀ ⦃x⦄, x ∈ S →
      N.toWeakModule.act a (w - 1) x ∈ S := by
    rintro a w ha _ ⟨u, hu, rfl⟩
    refine ⟨VOA.mk W a * u, ?_, (zeroMode_botIncl Pr ha u).symm⟩
    exact T.smul_mem (VOA.mk W a) hu
  have hιS : ∀ u, ι u ∈ S ↔ u ∈ T := by
    intro u
    constructor
    · rintro ⟨v, hv, hvu⟩
      rwa [← botIncl_injective Pr hvu]
    · intro hu; exact ⟨u, hu, rfl⟩
  let P := genSub (N := N) S
  obtain ⟨Q, hPQ⟩ := hrat N P
  have hzc : ∀ ⦃a : 𝒱⦄ ⦃w : ℤ⦄, a ∈ W.grading w → ∀ x,
      levProj N 0 (N.toWeakModule.act a (w - 1) x)
        = N.toWeakModule.act a (w - 1) (levProj N 0 x) := fun a w ha x =>
    levProj_comm N (zeroModeLin N a (w - 1)) (fun k y hy => zeroMode_lev N ha k y hy) 0 x
  -- the complement
  let T' : Submodule (A W) (A W) :=
    { carrier := {u | ∃ q ∈ Q.carrier, levProj N 0 q = ι u ∧ q - ι u ∈ P.carrier}
      add_mem' := by
        rintro u v ⟨q, hq, hq0, hqP⟩ ⟨r, hr, hr0, hrP⟩
        refine ⟨q + r, Q.carrier.add_mem hq hr, ?_, ?_⟩
        · rw [map_add, map_add, hq0, hr0]
        · rw [map_add, show q + r - (ι u + ι v) = (q - ι u) + (r - ι v) by abel]
          exact P.carrier.add_mem hqP hrP
      zero_mem' := ⟨0, Q.carrier.zero_mem, by simp, by simp⟩
      smul_mem' := by
        intro c u hu
        obtain ⟨v, rfl⟩ := VOA.mk_surjective W c
        have htop : v ∈ ⨆ w, W.grading w := by
          rw [W.isInternal.submodule_iSup_eq_top]; exact Submodule.mem_top
        refine Submodule.iSup_induction _ (motive := fun v => ∀ u, (∃ q ∈ Q.carrier,
            levProj N 0 q = ι u ∧ q - ι u ∈ P.carrier) → (∃ q ∈ Q.carrier,
            levProj N 0 q = ι (VOA.mk W v • u) ∧ q - ι (VOA.mk W v • u) ∈ P.carrier))
          htop ?_ ?_ ?_ u hu
        · intro w a ha u ⟨q, hq, hq0, hqP⟩
          refine ⟨N.toWeakModule.act a (w - 1) q, Q.act_mem a (w - 1) hq, ?_, ?_⟩
          · rw [hzc ha, hq0, smul_eq_mul, zeroMode_botIncl Pr ha]
          · rw [smul_eq_mul, ← zeroMode_botIncl Pr ha]
            convert P.act_mem a (w - 1) hqP using 1
            exact (map_sub (mode (N.YM a) (w - 1)) q (ι u)).symm
        · intro u _
          refine ⟨0, Q.carrier.zero_mem, ?_, ?_⟩ <;>
            simp [show VOA.mk W (0 : 𝒱) = 0 from map_zero _]
        · intro v₁ v₂ h₁ h₂ u hu
          obtain ⟨q₁, hq₁, hq₁0, hq₁P⟩ := h₁ u hu
          obtain ⟨q₂, hq₂, hq₂0, hq₂P⟩ := h₂ u hu
          refine ⟨q₁ + q₂, Q.carrier.add_mem hq₁ hq₂, ?_, ?_⟩
          · rw [map_add, hq₁0, hq₂0, map_add, add_smul, map_add]
          · rw [map_add, add_smul, map_add,
              show q₁ + q₂ - (ι (VOA.mk W v₁ • u) + ι (VOA.mk W v₂ • u))
                = (q₁ - ι (VOA.mk W v₁ • u)) + (q₂ - ι (VOA.mk W v₂ • u)) by abel]
            exact P.carrier.add_mem hq₁P hq₂P }
  refine ⟨T', ?_, ?_⟩
  · -- disjoint
    rw [Submodule.disjoint_def]
    rintro u hu ⟨q, hq, hq0, hqP⟩
    have hιu : ι u ∈ P.carrier := le_genSub S ((hιS u).2 hu)
    have hqP' : q ∈ P.carrier := by
      have := P.carrier.add_mem hqP hιu
      rwa [sub_add_cancel] at this
    have hq0' : q = 0 := by
      have := hPQ.1
      rw [Submodule.disjoint_def] at this
      exact this q hqP' hq
    rw [hq0', map_zero] at hq0
    exact botIncl_injective Pr (by rw [← hq0, map_zero])
  · -- codisjoint
    rw [codisjoint_iff, eq_top_iff]
    intro u _
    have hu : ι u ∈ P.carrier ⊔ Q.carrier := by rw [hPQ.2.eq_top]; exact Submodule.mem_top
    obtain ⟨p, hp, q, hq, hpq⟩ := Submodule.mem_sup.mp hu
    obtain ⟨u', hu'⟩ := exists_botIncl Pr (levProj_mem N 0 q)
    have hιu0 : levProj N 0 (ι u) = ι u := levProj_of_mem N (botIncl_mem Pr u)
    have hu'T' : u' ∈ T' := by
      refine ⟨q, hq, hu'.symm, ?_⟩
      have hq' : q = ι u - p := by rw [← hpq]; abel
      rw [hu', hq', map_sub, hιu0,
        show ι u - p - (ι u - levProj N 0 p) = levProj N 0 p - p by abel]
      exact P.carrier.sub_mem (levProj_mem_genSub S hS0 0 hp) hp
    have huT : u - u' ∈ T := by
      rw [← hιS, map_sub, hu']
      have hq' : q = ι u - p := by rw [← hpq]; abel
      rw [hq', map_sub, hιu0, sub_sub_cancel]
      exact genSub_le_bottom S hS0 hSo (levProj_mem_genSub S hS0 0 hp) (levProj_mem N 0 p)
    have : u = (u - u') + u' := by abel
    rw [this]
    exact Submodule.add_mem_sup huT hu'T'

include Pr in
/-- The library predicate `ZhuAdmissibleSemisimple`, given the PBW datum. -/
theorem zhuAdmissibleSemisimple_of_Pr : ZhuAdmissibleSemisimple W :=
  fun hrat => isSemisimpleRing_A_of_admissiblyRational Pr hrat

end Semisimple

end VOA.Huang.ZhuSemisimple
