import VOA.Huang.LiRegularShift
import VOA.Modules.ZhuVermaAnArchUnivMap

/-! # Admissible level structure on the submodule generated by lowest-weight vectors

For a weak module `A` on `E` and a set `S` of lowest-weight vectors (`aₙ s = 0` whenever
`deg aₙ = wt a − n − 1 < 0`), the subspaces

  `lev k = span { a¹_{n₁} ⋯ aʳ_{n_r} s : s ∈ S, Σ deg aⁱ_{nᵢ} = k }`

form an admissible level structure (`AdmLev`): modes shift levels by their degree, and every
word of negative total degree kills `S` (`lev_neg_eq_bot`; Li, math/9909007, Lemma 3.14;
Dong–Li–Mason).  This is the input of the Dong–Jiang universal property `oLevUnivMap`.

No `sorry`, no axioms beyond Lean's.
-/

namespace VOA.Huang.LiRegular

open VOA
open scoped BigOperators

universe u

variable {V : Type u} [AddCommGroup V] [Module ℂ V] {W : VertexOperatorAlgebra V}
  {E : Type u} [AddCommGroup E] [Module ℂ E]

/-- A homogeneous mode `aₙ`, `a ∈ V_k`. -/
structure Letter (W : VertexOperatorAlgebra V) where
  k : ℤ
  a : V
  ha : a ∈ W.grading k
  n : ℤ

namespace Letter

/-- The degree `wt a − n − 1` of a mode. -/
def deg (l : Letter W) : ℤ := l.k - l.n - 1

/-- The action of a letter. -/
noncomputable def act (A : WeakModule W E) (l : Letter W) : Module.End ℂ E := mode (A.YM l.a) l.n

end Letter

/-- The action and total degree of a word. -/
noncomputable def wordAct (A : WeakModule W E) : List (Letter W) → Module.End ℂ E
  | [] => 1
  | l :: w => l.act A * wordAct A w

def wordDeg : List (Letter W) → ℤ
  | [] => 0
  | l :: w => l.deg + wordDeg w

variable (A : WeakModule W E) (S : Set E)

/-- `S` consists of lowest-weight vectors. -/
def LowestSet : Prop :=
  ∀ s ∈ S, ∀ (k : ℤ) (a : V), a ∈ W.grading k → ∀ n : ℤ, k ≤ n → mode (A.YM a) n s = 0

/-- Words of length `≤ m` and degree `e`, applied to `S`. -/
def wspan (m : ℕ) (e : ℤ) : Submodule ℂ E :=
  Submodule.span ℂ {x | ∃ w : List (Letter W), w.length ≤ m ∧ wordDeg w = e ∧
    ∃ s ∈ S, x = wordAct A w s}

theorem wspan_mono {m m' : ℕ} (h : m ≤ m') (e : ℤ) : wspan A S m e ≤ wspan A S m' e :=
  Submodule.span_mono fun _ ⟨w, hw, hd, s, hs, hx⟩ => ⟨w, le_trans hw h, hd, s, hs, hx⟩

/-- Prepending a letter. -/
theorem act_wspan (l : Letter W) {m : ℕ} {e : ℤ} {x : E} (hx : x ∈ wspan A S m e) :
    l.act A x ∈ wspan A S (m + 1) (e + l.deg) := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, hw, hd, s, hs, rfl⟩ := hy
    exact Submodule.subset_span ⟨l :: w, by simp; omega, by simp [wordDeg, hd]; ring, s, hs,
      by simp [wordAct]⟩
  | zero => simp
  | add y y' _ _ hy hy' => rw [map_add]; exact Submodule.add_mem _ hy hy'
  | smul c y _ hy => rw [map_smul]; exact Submodule.smul_mem _ c hy

theorem finsum_mem_submodule' {ι : Type*} (P : Submodule ℂ E) (f : ι → E)
    (hf : ∀ i, f i ∈ P) : ∑ᶠ i, f i ∈ P := by
  by_cases h : (Function.support f).Finite
  · rw [finsum_eq_sum_of_support_subset f (s := h.toFinset) (by simp)]
    exact Submodule.sum_mem _ fun i _ => hf i
  · rw [finsum_of_infinite_support h]; exact Submodule.zero_mem _

variable {A S}

/-- A negative-degree letter preserves the word length. -/
theorem neg_act_wspan (hS : LowestSet A S) (l : Letter W) (hl : l.deg < 0) :
    ∀ (m : ℕ) (e : ℤ) {x : E}, x ∈ wspan A S m e → l.act A x ∈ wspan A S m (e + l.deg) := by
  intro m
  induction m with
  | zero =>
    intro e x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨w, hw, hd, s, hs, rfl⟩ := hy
      obtain rfl : w = [] := List.length_eq_zero_iff.1 (by omega)
      simp only [wordAct, Module.End.one_apply]
      rw [Letter.act, hS s hs l.k l.a l.ha l.n (by unfold Letter.deg at hl; omega)]
      exact Submodule.zero_mem _
    | zero => simp
    | add y y' _ _ hy hy' => rw [map_add]; exact Submodule.add_mem _ hy hy'
    | smul c y _ hy => rw [map_smul]; exact Submodule.smul_mem _ c hy
  | succ m ih =>
    intro e x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨w, hw, hd, s, hs, rfl⟩ := hy
      rcases w with _ | ⟨r, w⟩
      · simp only [wordAct, Module.End.one_apply]
        rw [Letter.act, hS s hs l.k l.a l.ha l.n (by unfold Letter.deg at hl; omega)]
        exact Submodule.zero_mem _
      · simp only [List.length_cons] at hw
        simp only [wordDeg] at hd
        have hws : wordAct A w s ∈ wspan A S m (wordDeg w) :=
          Submodule.subset_span ⟨w, by omega, rfl, s, hs, rfl⟩
        simp only [wordAct, Module.End.mul_apply]
        -- `l (r y) = r (l y) + [l, r] y`
        have hcomm := module_commutator A l.a r.a l.n r.n (wordAct A w s)
        change mode (A.YM l.a) l.n (mode (A.YM r.a) r.n (wordAct A w s)) ∈ _
        rw [eq_add_of_sub_eq hcomm]
        refine Submodule.add_mem _ ?_ ?_
        swap
        · have h1 := ih _ hws
          have h2 := act_wspan A S r h1
          rw [show wordDeg w + l.deg + r.deg = e + l.deg by rw [← hd]; ring] at h2
          exact h2
        · refine finsum_mem_submodule' _ _ fun i => ?_
          rcases lt_or_ge i 0 with hi | hi
          · rw [cbz_apply_neg _ hi, zero_smul]; exact Submodule.zero_mem _
          refine Submodule.smul_mem _ _ ?_
          let l' : Letter W := ⟨l.k + r.k - i - 1, W.smul l.a i r.a,
            W.smul_mem_grading l.ha r.ha i, l.n + r.n - i⟩
          have h2 := act_wspan A S l' hws
          have hdeg : wordDeg w + l'.deg = e + l.deg := by
            rw [← hd]; simp only [l', Letter.deg]; ring
          rw [hdeg] at h2
          exact h2
    | zero => simp
    | add y y' _ _ hy hy' => rw [map_add]; exact Submodule.add_mem _ hy hy'
    | smul c y _ hy => rw [map_smul]; exact Submodule.smul_mem _ c hy

/-- **Words of negative degree kill lowest-weight vectors.** -/
theorem wspan_neg_eq_bot (hS : LowestSet A S) :
    ∀ (m : ℕ) {e : ℤ}, e < 0 → wspan A S m e = ⊥ := by
  intro m
  induction m with
  | zero =>
    intro e he
    rw [eq_bot_iff]
    refine Submodule.span_le.2 fun y hy => ?_
    obtain ⟨w, hw, hd, s, hs, rfl⟩ := hy
    obtain rfl : w = [] := List.length_eq_zero_iff.1 (by omega)
    simp [wordDeg] at hd; omega
  | succ m ih =>
    intro e he
    rw [eq_bot_iff]
    refine Submodule.span_le.2 fun y hy => ?_
    obtain ⟨w, hw, hd, s, hs, rfl⟩ := hy
    rcases w with _ | ⟨l, w⟩
    · simp [wordDeg] at hd; omega
    · simp only [List.length_cons] at hw
      simp only [wordDeg] at hd
      have hws : wordAct A w s ∈ wspan A S m (wordDeg w) :=
        Submodule.subset_span ⟨w, by omega, rfl, s, hs, rfl⟩
      simp only [wordAct, Module.End.mul_apply, SetLike.mem_coe, Submodule.mem_bot]
      rcases lt_or_ge (wordDeg w) 0 with hneg | hpos
      · rw [ih hneg] at hws
        rw [(Submodule.mem_bot ℂ).1 hws, map_zero]
      · have := neg_act_wspan hS l (by omega) m _ hws
        rw [show wordDeg w + l.deg = e by omega, ih he] at this
        exact (Submodule.mem_bot ℂ).1 this

variable (A S)

/-- The levels of the submodule generated by `S`. -/
def genLev (k : ℤ) : Submodule ℂ E :=
  Submodule.span ℂ {x | ∃ w : List (Letter W), wordDeg w = k ∧ ∃ s ∈ S, x = wordAct A w s}

/-- **The admissible level structure generated by lowest-weight vectors.** -/
noncomputable def genAdmLev (hS : LowestSet A S) : AdmLev W A where
  lev := genLev A S
  lev_neg k hk := by
    rw [eq_bot_iff]
    refine Submodule.span_le.2 fun y hy => ?_
    obtain ⟨w, hd, s, hs, rfl⟩ := hy
    have h : wordAct A w s ∈ wspan A S w.length k :=
      Submodule.subset_span ⟨w, le_rfl, hd, s, hs, rfl⟩
    rw [wspan_neg_eq_bot hS _ hk] at h
    exact h
  act_lev w p k a ha x hx := by
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨wd, hd, s, hs, rfl⟩ := hy
      refine Submodule.subset_span ⟨⟨w, a, ha, p⟩ :: wd, ?_, s, hs, ?_⟩
      · simp [wordDeg, Letter.deg, hd]; ring
      · simp [wordAct, Letter.act, WeakModule.act_def]
    | zero => simp
    | add y y' _ _ hy hy' => rw [WeakModule.act_add_right]; exact Submodule.add_mem _ hy hy'
    | smul c y _ hy => rw [WeakModule.act_smul_right]; exact Submodule.smul_mem _ c hy

theorem mem_genAdmLev_zero (hS : LowestSet A S) {s : E} (hs : s ∈ S) :
    s ∈ (genAdmLev A S hS).lev 0 :=
  Submodule.subset_span ⟨[], rfl, s, hs, by simp [wordAct]⟩

end VOA.Huang.LiRegular
