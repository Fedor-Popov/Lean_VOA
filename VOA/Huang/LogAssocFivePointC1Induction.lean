import VOA.Huang.LogAssocFivePointSepMoves

/-!
# The five-slot filtration induction and the inner regular equation

Huang's Prop. 1.1/2.1 + Lemma 2.2 for products of three intertwining operators, in the
total-level normalization (the level is attached to the innermost point `z₃`):

* `normalizedSeries_mem` — under graded `C₁`-cofiniteness of the four external
  vectors' modules and of the contragredient of the output module, every normalized series
  lies in the `sepRing`-module generated by the series of bounded external levels. All five
  moves (`normalizedSeries_first/second/third/terminal/dual`) have coefficients in
  `sepRing = ℂ[x, y, (1-x)⁻¹, (1-y)⁻¹, (1-xy)⁻¹]` and strictly lower the total level.
* `normalizedSeries_Lm1_third` — `L₋₁` on the innermost insertion is the Euler operator
  `thetaY` (no extra factor: this is why the inner equation is regular).
* `innerRegular_normalizedSeries` — the coefficient array of every normalized series
  satisfies a monic Euler equation in the INNER variable `y = z₃/z₂` whose coefficients lie
  in `sepRing`, hence are holomorphic on the open unit bidisc (`InnerRegular`).

The outer variable is NOT claimed to satisfy such an equation: for a total-level
normalization attached to a single point, `L₋₁` on the outer insertions produces the factors
`(xy)⁻¹`, `y⁻¹`.
-/

set_option maxSynthPendingDepth 3
noncomputable section
namespace VOA.Huang.LogAssocFivePointGraded
open VOA VOA.C2Rigid PowerSeries
open VOA.Huang.LogHuangODEProduct
open VOA.Huang.LogHuangODEProduct VOA.Huang.LogHuangODEModes
open VOA.Huang.FivePointSep
open scoped BigOperators
universe u
variable {V : Type u} [AddCommGroup V] [Module ℂ V] {W : VertexOperatorAlgebra V}
variable {M₀ M₁ M₂ M₃ M₄ M₅ M₆ : Type u}
  [AddCommGroup M₀] [Module ℂ M₀] [AddCommGroup M₁] [Module ℂ M₁]
  [AddCommGroup M₂] [Module ℂ M₂] [AddCommGroup M₃] [Module ℂ M₃]
  [AddCommGroup M₄] [Module ℂ M₄] [AddCommGroup M₅] [Module ℂ M₅]
  [AddCommGroup M₆] [Module ℂ M₆]
variable {A₀ : C2Rigid.GWModule W M₀} {A₁ : C2Rigid.GWModule W M₁}
  {A₂ : C2Rigid.GWModule W M₂} {A₃ : C2Rigid.GWModule W M₃} {A₄ : C2Rigid.GWModule W M₄}
  {A₅ : C2Rigid.GWModule W M₅} {A₆ : C2Rigid.GWModule W M₆}
variable {Y₁ : IntertwiningModes M₁ M₆ M₀} {Y₂ : IntertwiningModes M₂ M₅ M₆}
  {Y₃ : IntertwiningModes M₃ M₄ M₅}

section Linear
variable (c ν μ : ℂ) (N₀ s : ℕ)

theorem ns_add_f (f f' : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ (f + f') w₁ w₂ w₃ w₄ N₀ s =
      normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s +
        normalizedSeries Y₁ Y₂ Y₃ c ν μ f' w₁ w₂ w₃ w₄ N₀ s :=
  (normalizedLinearFunctional Y₁ Y₂ Y₃ c ν μ N₀ s w₁ w₂ w₃ w₄).map_add f f'

theorem ns_smul_f (a : ℂ) (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ (a • f) w₁ w₂ w₃ w₄ N₀ s =
      a • normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s :=
  (normalizedLinearFunctional Y₁ Y₂ Y₃ c ν μ N₀ s w₁ w₂ w₃ w₄).map_smul a f

theorem ns_zero_f (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ (0 : M₀ →ₗ[ℂ] ℂ) w₁ w₂ w₃ w₄ N₀ s = 0 :=
  (normalizedLinearFunctional Y₁ Y₂ Y₃ c ν μ N₀ s w₁ w₂ w₃ w₄).map_zero

theorem ns_add_w₁ (f : M₀ →ₗ[ℂ] ℂ) (w₁ w₁' : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f (w₁ + w₁') w₂ w₃ w₄ N₀ s =
      normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s +
        normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁' w₂ w₃ w₄ N₀ s :=
  (normalizedLinearFirst Y₁ Y₂ Y₃ c ν μ N₀ s f w₂ w₃ w₄).map_add w₁ w₁'

theorem ns_smul_w₁ (a : ℂ) (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f (a • w₁) w₂ w₃ w₄ N₀ s =
      a • normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s :=
  (normalizedLinearFirst Y₁ Y₂ Y₃ c ν μ N₀ s f w₂ w₃ w₄).map_smul a w₁

theorem ns_zero_w₁ (f : M₀ →ₗ[ℂ] ℂ) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f (0 : M₁) w₂ w₃ w₄ N₀ s = 0 :=
  (normalizedLinearFirst Y₁ Y₂ Y₃ c ν μ N₀ s f w₂ w₃ w₄).map_zero

theorem ns_add_w₂ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ w₂' : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ (w₂ + w₂') w₃ w₄ N₀ s =
      normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s +
        normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂' w₃ w₄ N₀ s :=
  (normalizedLinearSecond Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₃ w₄).map_add w₂ w₂'

theorem ns_smul_w₂ (a : ℂ) (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ (a • w₂) w₃ w₄ N₀ s =
      a • normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s :=
  (normalizedLinearSecond Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₃ w₄).map_smul a w₂

theorem ns_zero_w₂ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ (0 : M₂) w₃ w₄ N₀ s = 0 :=
  (normalizedLinearSecond Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₃ w₄).map_zero

theorem ns_add_w₃ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ w₃' : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ (w₃ + w₃') w₄ N₀ s =
      normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s +
        normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃' w₄ N₀ s :=
  (normalizedLinearThird Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₂ w₄).map_add w₃ w₃'

theorem ns_smul_w₃ (a : ℂ) (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ (a • w₃) w₄ N₀ s =
      a • normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s :=
  (normalizedLinearThird Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₂ w₄).map_smul a w₃

theorem ns_zero_w₃ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ (0 : M₃) w₄ N₀ s = 0 :=
  (normalizedLinearThird Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₂ w₄).map_zero

theorem ns_add_w₄ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ w₄' : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ (w₄ + w₄') N₀ s =
      normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s +
        normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄' N₀ s :=
  (normalizedLinearTerminal Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₂ w₃).map_add w₄ w₄'

theorem ns_smul_w₄ (a : ℂ) (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ (a • w₄) N₀ s =
      a • normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ w₄ N₀ s :=
  (normalizedLinearTerminal Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₂ w₃).map_smul a w₄

theorem ns_zero_w₄ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) :
    normalizedSeries Y₁ Y₂ Y₃ c ν μ f w₁ w₂ w₃ (0 : M₄) N₀ s = 0 :=
  (normalizedLinearTerminal Y₁ Y₂ Y₃ c ν μ N₀ s f w₁ w₂ w₃).map_zero

end Linear

/-- Only the output functional on the selected weight matters (series form). -/
theorem normalizedSeries_congr_f
    (hY₁ : LogHuangODEProduct.IsGradedJacobiFamily A₁ A₆ A₀ Y₁)
    (hY₂ : LogHuangODEProduct.IsGradedJacobiFamily A₂ A₅ A₆ Y₂)
    (hY₃ : LogHuangODEProduct.IsGradedJacobiFamily A₃ A₄ A₅ Y₃)
    {h₀ h₁ h₂ h₃ h₄ ν μ : ℂ} {N₀ N₁ N₂ N₃ N₄ : ℕ}
    {w₁ : M₁} {w₂ : M₂} {w₃ : M₃} {w₄ : M₄}
    (hw₁ : w₁ ∈ A₁.weight (h₁ + N₁)) (hw₂ : w₂ ∈ A₂.weight (h₂ + N₂))
    (hw₃ : w₃ ∈ A₃.weight (h₃ + N₃)) (hw₄ : w₄ ∈ A₄.weight (h₄ + N₄))
    {f g : M₀ →ₗ[ℂ] ℂ} (hf : f.domRestrict (A₀.weight (h₀ + N₀)) =
      g.domRestrict (A₀.weight (h₀ + N₀))) :
    normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ f w₁ w₂ w₃ w₄
      N₀ (N₀ + N₁ + N₂ + N₃ + N₄) =
    normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ g w₁ w₂ w₃ w₄
      N₀ (N₀ + N₁ + N₂ + N₃ + N₄) := by
  refine PS2.ext fun m n => ?_
  rw [c2_normalizedSeries, c2_normalizedSeries]
  exact normalizedCoeff_congr_functional hY₁ hY₂ hY₃ hw₁ hw₂ hw₃ hw₄ hf m n

section Induction

variable {h₀ h₁ h₂ h₃ h₄ ν μ : ℂ} {B₀ B₁ B₂ B₃ B₄ : ℕ}

/-- **Huang's Prop. 1.1 with regularity, three intertwiners (five slots).** -/
theorem normalizedSeries_mem
    (hY₁ : LogHuangODEProduct.IsGradedJacobiFamily A₁ A₆ A₀ Y₁)
    (hY₂ : LogHuangODEProduct.IsGradedJacobiFamily A₂ A₅ A₆ Y₂)
    (hY₃ : LogHuangODEProduct.IsGradedJacobiFamily A₃ A₄ A₅ Y₃)
    (hl₀ : LogHuangODEProduct.CosetBase A₀ h₀) (hl₁ : LogHuangODEProduct.CosetBase A₁ h₁)
    (hl₂ : LogHuangODEProduct.CosetBase A₂ h₂) (hl₃ : LogHuangODEProduct.CosetBase A₃ h₃) (hl₄ : LogHuangODEProduct.CosetBase A₄ h₄)
    (hB : UniformTwoBase A₂ A₃ A₄ Y₂ Y₃ h₂ h₃ h₄ ν μ)
    (hD₀ : DualC1Graded A₀ h₀ B₀) (hC₁ : C1Graded A₁ h₁ B₁) (hC₂ : C1Graded A₂ h₂ B₂)
    (hC₃ : C1Graded A₃ h₃ B₃) (hC₄ : C1Graded A₄ h₄ B₄)
    (NN : Submodule sepRing PS2)
    (hbase : ∀ (N₀ N₁ N₂ N₃ N₄ : ℕ), N₀ ≤ B₀ → N₁ ≤ B₁ → N₂ ≤ B₂ → N₃ ≤ B₃ → N₄ ≤ B₄ →
      ∀ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄),
        w₁ ∈ A₁.weight (h₁ + N₁) → w₂ ∈ A₂.weight (h₂ + N₂) →
        w₃ ∈ A₃.weight (h₃ + N₃) → w₄ ∈ A₄.weight (h₄ + N₄) →
        normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
          f w₁ w₂ w₃ w₄ N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN) :
    ∀ (s N₀ N₁ N₂ N₃ N₄ : ℕ), N₀ + N₁ + N₂ + N₃ + N₄ = s →
      ∀ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄),
        w₁ ∈ A₁.weight (h₁ + N₁) → w₂ ∈ A₂.weight (h₂ + N₂) →
        w₃ ∈ A₃.weight (h₃ + N₃) → w₄ ∈ A₄.weight (h₄ + N₄) →
        normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
          f w₁ w₂ w₃ w₄ N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN := by
  intro s
  induction s using Nat.strong_induction_on with
  | _ s IH =>
  intro N₀ N₁ N₂ N₃ N₄ hs f w₁ w₂ w₃ w₄ hw₁ hw₂ hw₃ hw₄
  have IH' : ∀ (N₀ N₁ N₂ N₃ N₄ : ℕ), N₀ + N₁ + N₂ + N₃ + N₄ < s →
      ∀ (f : M₀ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (w₄ : M₄),
        w₁ ∈ A₁.weight (h₁ + N₁) → w₂ ∈ A₂.weight (h₂ + N₂) →
        w₃ ∈ A₃.weight (h₃ + N₃) → w₄ ∈ A₄.weight (h₄ + N₄) →
        normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
          f w₁ w₂ w₃ w₄ N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN :=
    fun N₀ N₁ N₂ N₃ N₄ hlt f w₁ w₂ w₃ w₄ h1 h2 h3 h4 =>
      IH _ hlt N₀ N₁ N₂ N₃ N₄ rfl f w₁ w₂ w₃ w₄ h1 h2 h3 h4
  subst hs
  -- first insertion
  by_cases c1 : B₁ < N₁
  · refine Submodule.span_induction
      (p := fun x _ => normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
        f x w₂ w₃ w₄ N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hC₁ N₁ c1 w₁ hw₁)
    · rintro x ⟨d, u, w', hd1, hdN, hu, hw', rfl⟩
      rw [show N₀ + N₁ + N₂ + N₃ + N₄ = N₀ + ((N₁ - d) + d) + N₂ + N₃ + N₄ by omega,
        normalizedSeries_first hY₁ hY₂ hY₃ hl₀ hl₂ hl₃ hl₄ hB hu f hw' hw₂ hw₃ hw₄]
      refine NN.add_mem (NN.add_mem (NN.add_mem ?_ ?_) ?_) ?_
      · refine NN.sum_mem fun i hi => mul_mem_of_sepRing NN (monomial_mem _ _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw' hw₂ hw₃ hw₄
      · refine NN.sum_mem fun i hi => mul_mem_of_sepRing NN (monomial_mem _ _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw' hw₂ hw₃ (mode_mem_weight_nat hu hw₄ hi)
      · refine NN.sum_mem fun k hk => mul_mem_of_sepRing NN (ιxy_binom_mem k) ?_
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw' hw₂ (mode_mem_weight_nat hu hw₃ hk) hw₄
      · refine NN.sum_mem fun k hk => mul_mem_of_sepRing NN (ιx_binom_mem k)
          (mul_mem_of_sepRing NN (monomial_mem _ _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw' (mode_mem_weight_nat hu hw₂ hk) hw₃ hw₄
    · simp only []; rw [ns_zero_w₁]; exact NN.zero_mem
    · intro x y _ _ hx hy; rw [ns_add_w₁]; exact NN.add_mem hx hy
    · intro a x _ hx; rw [ns_smul_w₁]; exact smul_mem_of_sepRing NN a hx
  -- second insertion
  by_cases c2' : B₂ < N₂
  · refine Submodule.span_induction
      (p := fun x _ => normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
        f w₁ x w₃ w₄ N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hC₂ N₂ c2' w₂ hw₂)
    · rintro x ⟨d, u, w', hd1, hdN, hu, hw', rfl⟩
      rw [show N₀ + N₁ + N₂ + N₃ + N₄ = N₀ + N₁ + ((N₂ - d) + d) + N₃ + N₄ by omega,
        normalizedSeries_second hY₁ hY₂ hY₃ hl₀ hl₁ hl₃ hl₄ hB hu f hw₁ hw' hw₃ hw₄]
      refine NN.add_mem (NN.add_mem (NN.sub_mem ?_ ?_) ?_) ?_
      · refine NN.sum_mem fun i hi => mul_mem_of_sepRing NN (monomial_mem _ _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw' hw₃ hw₄
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (ιx_binom_mem k) (mul_mem_of_sepRing NN (monomial_mem _ _) ?_))
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ (mode_mem_weight_nat hu hw₁ hk) hw' hw₃ hw₄
      · refine NN.sum_mem fun i hi => mul_mem_of_sepRing NN (monomial_mem _ _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw' hw₃ (mode_mem_weight_nat hu hw₄ hi)
      · refine NN.sum_mem fun k hk => mul_mem_of_sepRing NN (ιy_binom_mem k) ?_
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw' (mode_mem_weight_nat hu hw₃ hk) hw₄
    · simp only []; rw [ns_zero_w₂]; exact NN.zero_mem
    · intro x y _ _ hx hy; rw [ns_add_w₂]; exact NN.add_mem hx hy
    · intro a x _ hx; rw [ns_smul_w₂]; exact smul_mem_of_sepRing NN a hx
  -- third insertion
  by_cases c3 : B₃ < N₃
  · refine Submodule.span_induction
      (p := fun x _ => normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
        f w₁ w₂ x w₄ N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hC₃ N₃ c3 w₃ hw₃)
    · rintro x ⟨d, u, w', hd1, hdN, hu, hw', rfl⟩
      rw [show N₀ + N₁ + N₂ + N₃ + N₄ = N₀ + N₁ + N₂ + ((N₃ - d) + d) + N₄ by omega,
        normalizedSeries_third hY₁ hY₂ hY₃ hl₀ hl₁ hl₂ hl₄ hB hu f hw₁ hw₂ hw' hw₄]
      refine NN.add_mem (NN.sub_mem (NN.sub_mem ?_ ?_) ?_) ?_
      · refine NN.sum_mem fun i hi => mul_mem_of_sepRing NN (monomial_mem _ _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw₂ hw' hw₄
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (ιxy_binom_mem k) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ (mode_mem_weight_nat hu hw₁ hk) hw₂ hw' hw₄
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (ιy_binom_mem k) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ (mode_mem_weight_nat hu hw₂ hk) hw' hw₄
      · refine NN.sum_mem fun i hi => ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw₂ hw' (mode_mem_weight_nat hu hw₄ hi)
    · simp only []; rw [ns_zero_w₃]; exact NN.zero_mem
    · intro x y _ _ hx hy; rw [ns_add_w₃]; exact NN.add_mem hx hy
    · intro a x _ hx; rw [ns_smul_w₃]; exact smul_mem_of_sepRing NN a hx
  -- terminal vector
  by_cases c4 : B₄ < N₄
  · refine Submodule.span_induction
      (p := fun x _ => normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
        f w₁ w₂ w₃ x N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hC₄ N₄ c4 w₄ hw₄)
    · rintro x ⟨d, u, w', hd1, hdN, hu, hw', rfl⟩
      rw [show N₀ + N₁ + N₂ + N₃ + N₄ = N₀ + N₁ + N₂ + N₃ + ((N₄ - d) + d) by omega,
        normalizedSeries_terminal hY₁ hY₂ hY₃ hl₀ hl₁ hl₂ hl₃ hB hu f hw₁ hw₂ hw₃ hw']
      refine NN.sub_mem (NN.sub_mem (NN.sub_mem ?_ ?_) ?_) ?_
      · split_ifs with hd
        · exact mul_mem_of_sepRing NN (monomial_mem _ _)
            (IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw₂ hw₃ hw')
        · exact NN.zero_mem
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (monomial_mem _ _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ (mode_mem_weight_nat hu hw₁ hk) hw₂ hw₃ hw'
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (monomial_mem _ _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ (mode_mem_weight_nat hu hw₂ hk) hw₃ hw'
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _ ?_
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw₂ (mode_mem_weight_nat hu hw₃ hk) hw'
    · simp only []; rw [ns_zero_w₄]; exact NN.zero_mem
    · intro x y _ _ hx hy; rw [ns_add_w₄]; exact NN.add_mem hx hy
    · intro a x _ hx; rw [ns_smul_w₄]; exact smul_mem_of_sepRing NN a hx
  -- output functional
  by_cases c0 : B₀ < N₀
  · refine Submodule.span_induction
      (p := fun φ _ => ∀ f' : M₀ →ₗ[ℂ] ℂ, f'.domRestrict (A₀.weight (h₀ + N₀)) = φ →
        normalizedSeries Y₁ Y₂ Y₃ (h₁ + h₂ + h₃ + h₄ - h₀ - 3) ν μ
          f' w₁ w₂ w₃ w₄ N₀ (N₀ + N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hD₀ N₀ c0 f) f rfl
    · rintro φ ⟨d, m, u, g, hd1, hm, hmN, hu, rfl⟩ f' hf'
      rw [normalizedSeries_congr_f hY₁ hY₂ hY₃ hw₁ hw₂ hw₃ hw₄ hf']
      obtain ⟨j, rfl⟩ : ∃ j, m = 2 * d - 1 + j := ⟨m - (2 * d - 1), by omega⟩
      obtain ⟨r, rfl⟩ : ∃ r, N₀ = r + d + j := ⟨N₀ - (d + j), by omega⟩
      have hmz : (((2 * d - 1 + j : ℕ) : ℤ)) = 2 * (d : ℤ) - 1 + j := by
        rw [Nat.cast_add, Nat.cast_sub (by omega)]; push_cast; ring
      rw [hmz, normalizedSeries_dual hY₁ hY₂ hY₃ hl₁ hl₂ hl₃ hl₄ hB hd1 hu g j hw₁ hw₂ hw₃ hw₄]
      refine NN.add_mem (NN.add_mem (NN.add_mem ?_ ?_) ?_) ?_
      · split_ifs with h4
        · refine mul_mem_of_sepRing NN (monomial_mem _ _)
            (IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw₂ hw₃ ?_)
          have hm4 := C2Rigid.mode_mem_weight A₄ hu hw₄ (2 * (d : ℤ) - 1 + j)
          convert hm4 using 2
          rw [Nat.cast_sub h4]; push_cast; ring
        · exact NN.zero_mem
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (monomial_mem _ _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ (mode_mem_weight_nat hu hw₁ hk) hw₂ hw₃ hw₄
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (monomial_mem _ _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ (mode_mem_weight_nat hu hw₂ hk) hw₃ hw₄
      · refine NN.sum_mem fun k hk => smul_mem_of_sepRing NN _
          (mul_mem_of_sepRing NN (monomial_mem _ _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ _ (by omega) _ _ _ _ _ hw₁ hw₂ (mode_mem_weight_nat hu hw₃ hk) hw₄
    · intro f' hf'
      rw [normalizedSeries_congr_f hY₁ hY₂ hY₃ hw₁ hw₂ hw₃ hw₄ (g := 0) (by rw [hf']; ext; simp),
        ns_zero_f]
      exact NN.zero_mem
    · intro φ₁ φ₂ _ _ h1 h2 f' hf'
      obtain ⟨g₁, hg₁⟩ := LinearMap.exists_extend φ₁
      have hsplit : f' = g₁ + (f' - g₁) := by abel
      rw [hsplit, ns_add_f]
      refine NN.add_mem (h1 g₁ hg₁) (h2 _ ?_)
      ext x
      have hx := LinearMap.congr_fun hf' x
      have hx1 := LinearMap.congr_fun hg₁ x
      simp only [LinearMap.domRestrict_apply, LinearMap.add_apply, LinearMap.sub_apply,
        LinearMap.comp_apply, Submodule.subtype_apply] at hx hx1 ⊢
      rw [hx, hx1]; ring
    · intro a φ _ h1 f' hf'
      obtain ⟨g₁, hg₁⟩ := LinearMap.exists_extend φ
      rw [normalizedSeries_congr_f hY₁ hY₂ hY₃ hw₁ hw₂ hw₃ hw₄ (g := a • g₁) (by
        rw [hf']; ext x
        have hx1 := LinearMap.congr_fun hg₁ x
        simp only [LinearMap.domRestrict_apply, LinearMap.smul_apply, LinearMap.comp_apply,
          Submodule.subtype_apply] at hx1 ⊢
        rw [hx1]), ns_smul_f]
      exact smul_mem_of_sepRing NN a (h1 g₁ hg₁)
  exact hbase N₀ N₁ N₂ N₃ N₄ (by omega) (by omega) (by omega) (by omega) (by omega)
    f w₁ w₂ w₃ w₄ hw₁ hw₂ hw₃ hw₄

end Induction


