import VOA.Huang.BuhlSpanningNormal

/-!
# Buhl's spanning theorem for modules, layer 4: finite lowest-weight generation

The normal words on the bottom level split as (strictly negative modes) · (non-negative modes),
and the non-negative inner parts with all modes `< Bm` and every letter repeated `< Q` times form a
**finite** set of lists (`innerSet_finite`).  Hence:

* `exists_finite_lwGenerated_of_admissible` — an admissible module over a `C₂`-cofinite `𝒱`,
  generated by a finite-dimensional bottom level, is `LWGenerated` by a finite set (Buhl,
  J. Algebra 254 (2002), Main Theorem, in the form needed for `C₂`-cofiniteness);
* `buhlFiniteLWGenInput_holds : BuhlFiniteLWGenInput` — the named input is a theorem;
* `moduleC2Cofinite_of_irreducibleLW` and `moduleC2Input_holds : ModuleC2Input` —
  **irreducible lowest-weight modules of a `C₂`-cofinite VOA are `C₂`-cofinite** (Abe–Buhl–Dong
  2004), with `C₂`-cofiniteness of `𝒱` the only hypothesis on `𝒱`.

No `sorry`, no axioms beyond Lean's three, no `Pr`/`VOA.pbw`.
-/

namespace VOA.Huang.BuhlSpanning

open VOA VOA.Huang.FusionC2 VOA.Huang.ModuleC2 VOA.Huang.LWBottomRecovery
open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
variable {M : Type u} [AddCommGroup M] [Module ℂ M]

/-- The inner (non-negative-mode) normal lists: modes in `[0, Bm)`, letters repeated `< Q`
times. -/
def InnerSet (D : GenData W) (Q Bm : ℕ) : Set (List (Ltr D)) :=
  {m | (∀ e ∈ m, 0 ≤ e.2 ∧ e.2 < (Bm : ℤ)) ∧ ∀ a, m.count a < Q}

/-- **There are finitely many inner lists.** -/
theorem innerSet_finite (D : GenData W) (Q Bm : ℕ) : (InnerSet D Q Bm).Finite := by
  classical
  set Al : Finset (Ltr D) := Finset.univ ×ˢ Finset.Ico (0 : ℤ) Bm with hAl
  set L := Al.card * Q
  have hsub : InnerSet D Q Bm ⊆ {m | m.length ≤ L ∧ ∀ e ∈ m, e ∈ Al} := by
    intro m ⟨hmodes, hcount⟩
    have hAlm : ∀ e ∈ m, e ∈ Al := by
      intro e he
      simp only [hAl, Finset.mem_product, Finset.mem_univ, Finset.mem_Ico, true_and]
      exact hmodes e he
    refine ⟨?_, hAlm⟩
    rw [← List.sum_map_count_dedup_eq_length]
    have h1 : (m.dedup.map fun x => m.count x).sum ≤ m.dedup.length • Q := by
      have := List.sum_le_card_nsmul (m.dedup.map fun x => m.count x) Q (fun y hy => by
        obtain ⟨x, _, rfl⟩ := List.mem_map.mp hy
        exact le_of_lt (hcount x))
      simpa using this
    have h2 : m.dedup.length ≤ Al.card := by
      rw [← List.toFinset_card_of_nodup (List.nodup_dedup m)]
      refine Finset.card_le_card ?_
      intro e he
      rw [List.mem_toFinset, List.mem_dedup] at he
      exact hAlm e he
    have h3 : (m.dedup.map fun x => m.count x).sum ≤ Al.card * Q :=
      le_trans (by simpa using h1) (Nat.mul_le_mul_right Q h2)
    convert h3 using 4
    congr 1
    apply lawful_beq_subsingleton
  refine Set.Finite.subset ?_ hsub
  have hfin := (List.finite_length_le (↥Al) L).image (List.map Subtype.val)
  refine hfin.subset ?_
  rintro m ⟨hlen, hmem⟩
  refine ⟨m.pmap (fun e he => (⟨e, he⟩ : ↥Al)) hmem, ?_, ?_⟩
  · simpa [Set.mem_setOf_eq, List.length_pmap] using hlen
  · simp [List.map_pmap]

/-- **Finite lowest-weight generation of admissible modules** over a `C₂`-cofinite VOA
(Buhl's spanning theorem, finiteness form). -/
theorem exists_finite_lwGenerated_of_admissible (N : AdmissibleModule W M) (hC2 : C2Cofinite W)
    (hfd : FiniteDimensional ℂ (N.lev 0))
    (hgen : ∀ S : WeakModule.Submodule' N.toWeakModule, N.lev 0 ≤ S.carrier → S.carrier = ⊤) :
    ∃ B : Set M, B.Finite ∧ LWGenerated N.toWeakModule B := by
  classical
  obtain ⟨D⟩ := exists_genData hC2
  obtain ⟨N₀, hN₀⟩ := exists_grading_le_O₂ W hC2
  set A := N.toWeakModule
  set Q := N₀ + 1 with hQ
  set Bm := Finset.univ.sup D.wt
  have hBm : ∀ i, D.wt i ≤ Bm := fun i => Finset.le_sup (Finset.mem_univ i)
  obtain ⟨T, hT⟩ := (Submodule.fg_iff_finiteDimensional (N.lev 0)).mpr hfd
  set B : Set M := (fun p : List (Ltr D) × M => wordL D A p.1 p.2) ''
    (InnerSet D Q Bm ×ˢ (T : Set M)) with hB
  have hBfin : B.Finite := ((innerSet_finite D Q Bm).prod T.finite_toSet).image _
  refine ⟨B, hBfin, ?_⟩
  -- inner words on the bottom level lie in `Gfil B 0`
  have hinner : ∀ m ∈ InnerSet D Q Bm, ∀ b ∈ N.lev 0, wordL D A m b ∈ Gfil A B 0 := by
    intro m hm b hb
    rw [← hT] at hb
    induction hb using Submodule.span_induction with
    | mem t ht => exact mem_Gfil_of_mem_B A B ⟨(m, t), ⟨hm, ht⟩, rfl⟩ le_rfl
    | zero => simp
    | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
    | smul c x _ hx => rw [map_smul]; exact Submodule.smul_mem _ c hx
  -- normal words on the bottom level lie in `Gfil B 0`
  have hnormal : ∀ l : List (Ltr D), Normal D Q l → ∀ b ∈ N.lev 0,
      wordL D A l b ∈ Gfil A B 0 := by
    intro l
    induction l with
    | nil =>
        intro _ b hb
        exact hinner [] ⟨by simp, fun a => by simp [hQ]⟩ b hb
    | cons a l ih =>
        intro hn b hb
        by_cases ha : a.2 < 0
        · rw [wordL_cons]
          refine neg_mode_mem_Gfil_zero A B _ ha (ih ⟨hn.1.of_cons, fun x => ?_⟩ b hb)
          exact lt_of_le_of_lt ((List.sublist_cons_self a l).count_le x) (hn.2 x)
        · by_cases hbig : ∃ e ∈ a :: l, (Bm : ℤ) ≤ e.2
          · rw [wordL_eq_zero_of_big D N hBm _ hn.1 hbig b hb]; exact Submodule.zero_mem _
          · push Not at hbig
            refine hinner (a :: l) ⟨fun e he => ⟨?_, hbig e he⟩, hn.2⟩ b hb
            rcases List.mem_cons.mp he with rfl | he'
            · omega
            · have := List.rel_of_pairwise_cons hn.1 he'
              simp only [modeLE] at this
              omega
  rw [LWGenerated, eq_top_iff, ← iSup_E_eq_top (D := D) (A := A) (B₀ := N.lev 0) hgen]
  refine iSup_le (fun G => le_trans (E_le_NS hN₀ hBm G) ?_)
  rw [NS, Submodule.span_le]
  rintro _ ⟨l, b, hl, hb, rfl⟩
  exact hnormal l hl b hb

/-- **Irreducible lowest-weight modules are finitely lowest-weight generated** over a
`C₂`-cofinite VOA. -/
theorem exists_finite_lwGenerated_of_irreducibleLW (hC2 : C2Cofinite W) (P : LWModule W)
    (hP : P.IsIrreducibleLW) :
    ∃ B : Set P.carrier, B.Finite ∧ LWGenerated P.isMod.toWeakModule B := by
  have hfd : FiniteDimensional ℂ ((lwAdmissible P).lev 0) := by
    rw [lwAdmissible_lev, lwLev_zero]; exact P.isMod.finrank _
  refine exists_finite_lwGenerated_of_admissible (lwAdmissible P) hC2 hfd ?_
  intro S hS
  rcases hP.2 S with h | h
  · exfalso
    apply P.realized
    rw [lwAdmissible_lev, lwLev_zero, h] at hS
    exact le_bot_iff.mp hS
  · exact h

/-- **Irreducible lowest-weight modules of a `C₂`-cofinite VOA are `C₂`-cofinite**
(Buhl 2002; Abe–Buhl–Dong 2004). -/
theorem moduleC2Cofinite_of_irreducibleLW (hC2 : C2Cofinite W) (P : LWModule W)
    (hP : P.IsIrreducibleLW) : ModuleC2Cofinite P.isMod.toWeakModule := by
  obtain ⟨B, hB, hLW⟩ := exists_finite_lwGenerated_of_irreducibleLW hC2 P hP
  exact moduleC2Cofinite_of_LWGenerated _ hC2 hB hLW

/-- **`BuhlFiniteLWGenInput` is a theorem.** -/
theorem buhlFiniteLWGenInput_holds : BuhlFiniteLWGenInput.{u} :=
  fun _ _ _ _ hV P hP =>
    exists_finite_lwGenerated_of_irreducibleLW hV.toStronglyFinite.c2Cofinite P hP

/-- **`ModuleC2Input` is a theorem**: irreducible modules of a strongly rational VOA are
`C₂`-cofinite. -/
theorem moduleC2Input_holds : ModuleC2Input.{u} :=
  moduleC2Input_of_buhlFiniteLWGen buhlFiniteLWGenInput_holds

end VOA.Huang.BuhlSpanning
