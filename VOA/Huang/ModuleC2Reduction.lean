import VOA.Huang.FusionC2
import VOA.Modularity.LiFiltration
import VOA.Modularity.C2Extraction
import VOA.Modules.Translation

/-!
# `C₂`-cofiniteness of modules from finite lowest-weight generation

Let `𝒱` be `C₂`-cofinite and `M` a weak `𝒱`-module.  Write `C₂(M) = span{a₍₋₂₎m}` (`C2M`).
If `M` is **lowest-weight generated by a finite set** `B` — i.e. spanned by words in strictly
negative modes applied to `B` (`LWGenerated A B`, Li's filtration at level `0`) — then `M/C₂(M)`
is finite-dimensional.  Strict decrease of the mode indices (Gaberdiel–Neitzke) is **not** needed:

* `mode_le_neg_two_mem_C2M` — modes `a₍ₙ₎`, `n ≤ −2`, land in `C₂(M)` (translation covariance
  `(L₋₁a)₍ₙ₎ = −n a₍ₙ₋₁₎`);
* `negOne_mem_C2M` — `a₍₋₁₎` preserves `C₂(M)` (commutator formula);
* `O₂_negOne_mem_C2M` — `c ∈ C₂(𝒱) ⟹ c₍₋₁₎M ⊆ C₂(M)` (iterate formula);
* `negOne_negOne_sub_mem_C2M` — `a₍₋₁₎b₍₋₁₎x ≡ (a₍₋₁₎b)₍₋₁₎x mod C₂(M)` (iterate formula);
* `moduleC2Cofinite_of_LWGenerated` — hence `M/C₂(M)` is spanned by the finitely many
  `u₍₋₁₎b` (`u` from a finite set spanning `𝒱` mod `C₂(𝒱)`, `b ∈ B`).

The remaining content of Buhl's theorem is then exactly the finiteness of a generating bottom
family.  We name it and prove the implications:

* `BuhlFiniteLWGenInput` — every irreducible lowest-weight module of a strongly rational `𝒱` is
  `LWGenerated` by a finite set (Buhl 2002, Main Theorem; Miyamoto 2004, Thm. 2.7);
* `moduleC2Input_of_buhlFiniteLWGen : BuhlFiniteLWGenInput → ModuleC2Input`;
* `act_mem_Gfil_zero_of_baseClosed` — the commutator word induction: if every non-negative mode
  of every `b ∈ B` lands in the negative-mode span `Gfil A B 0`, then `Gfil A B 0` is closed under
  **all** modes;
* `BuhlBaseClosedInput` — the "base closure" form of the input, and
  `buhlFiniteLWGenInput_iff_baseClosed` (the two named inputs are **equivalent**, so the base form
  is a faithful, not a weakened, restatement).

⚠ `LWGenerated` with `B = M_h` (the bottom alone) is FALSE in general (Ising `L(1/2,1/16)`: level 1
is spanned by `L₋₁v = ω₍₀₎v`, while `𝒱₁ = 0`; see `Modularity.BuhlSpanningData`).  The inputs
here quantify over an arbitrary finite `B`, which Buhl's theorem supplies (bounded-mode,
bounded-repetition inner monomials).

## Status
No `sorry`, no new axioms, no `Pr`/`VOA.pbw`.
-/

namespace VOA.Huang.ModuleC2

open VOA VOA.Huang.FusionC2
open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
variable {M : Type u} [AddCommGroup M] [Module ℂ M]

/-! ## Elementary membership facts for `C₂(M)` -/

/-- `a₍₋ₖ₋₂₎x ∈ C₂(M)` for every `k ∈ ℕ`. -/
theorem mode_neg_mem_C2M (A : WeakModule W M) (x : M) :
    ∀ (k : ℕ) (a : 𝒱), mode (A.YM a) (-(k : ℤ) - 2) x ∈ C2M A := by
  intro k
  induction k with
  | zero =>
      intro a
      exact Submodule.subset_span ⟨a, x, by simp⟩
  | succ k ih =>
      intro a
      have hcov := act_T_covariance A a (-(k : ℤ) - 2) x
      simp only [WeakModule.act_def] at hcov
      have hne : (-(((-(k : ℤ) - 2 : ℤ)) : ℂ)) ≠ 0 := by
        push_cast
        have : ((k : ℂ) + 2) ≠ 0 := by exact_mod_cast (by omega : (k : ℕ) + 2 ≠ 0)
        intro h; apply this; linear_combination h
      have hx : mode (A.YM a) (-((k + 1 : ℕ) : ℤ) - 2) x
          = (-(((-(k : ℤ) - 2 : ℤ)) : ℂ))⁻¹ • mode (A.YM (W.L (-1) a)) (-(k : ℤ) - 2) x := by
        rw [hcov, smul_smul, inv_mul_cancel₀ hne, one_smul,
          show (-((k + 1 : ℕ) : ℤ) - 2) = -(k : ℤ) - 2 - 1 by push_cast; ring]
      rw [hx]
      exact Submodule.smul_mem _ _ (ih _)

/-- Modes of index `≤ −2` land in `C₂(M)`. -/
theorem mode_le_neg_two_mem_C2M (A : WeakModule W M) (a : 𝒱) (x : M) {n : ℤ} (hn : n ≤ -2) :
    mode (A.YM a) n x ∈ C2M A := by
  have h := mode_neg_mem_C2M A x (-n - 2).toNat a
  rwa [show (-(((-n - 2).toNat : ℕ) : ℤ) - 2) = n by omega] at h

/-- `a₍₋₁₎` preserves `C₂(M)` (commutator formula). -/
theorem negOne_mem_C2M (A : WeakModule W M) (a : 𝒱) {y : M} (hy : y ∈ C2M A) :
    mode (A.YM a) (-1) y ∈ C2M A := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨b, m, rfl⟩ := hz
      have hcomm := VOA.mode_commutator A a b m (-1) (-2)
      have hsplit : mode (A.YM a) (-1) (mode (A.YM b) (-2) m)
          = mode (A.YM b) (-2) (mode (A.YM a) (-1) m)
            + ∑ᶠ i : ℤ, cbz (-1) i • mode (A.YM (W.smul a i b)) (-1 + -2 - i) m := by
        rw [← hcomm]; abel
      rw [hsplit]
      refine Submodule.add_mem _ (Submodule.subset_span ⟨b, _, rfl⟩) ?_
      refine finsum_mem_submodule_lf _ _ (fun i => ?_)
      rcases lt_or_ge i 0 with hi | hi
      · rw [cbz_apply_neg _ hi, zero_smul]; exact Submodule.zero_mem _
      · exact Submodule.smul_mem _ _ (mode_le_neg_two_mem_C2M A _ _ (by omega))
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [map_smul]; exact Submodule.smul_mem _ c hx

/-- The `𝒱`-argument of a fixed mode on a fixed vector is linear. -/
theorem mode_YM_add (A : WeakModule W M) (a b : 𝒱) (n : ℤ) (x : M) :
    mode (A.YM (a + b)) n x = mode (A.YM a) n x + mode (A.YM b) n x := by
  simp only [map_add, mode_add, LinearMap.add_apply]

theorem mode_YM_smul (A : WeakModule W M) (c : ℂ) (a : 𝒱) (n : ℤ) (x : M) :
    mode (A.YM (c • a)) n x = c • mode (A.YM a) n x := by
  simp only [map_smul, mode_smul, LinearMap.smul_apply]

/-- `c ∈ C₂(𝒱) ⟹ c₍₋₁₎x ∈ C₂(M)` (iterate formula). -/
theorem O₂_negOne_mem_C2M (A : WeakModule W M) (x : M) {c : 𝒱} (hc : c ∈ O₂ W) :
    mode (A.YM c) (-1) x ∈ C2M A := by
  induction hc using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨a, b, rfl⟩ := hz
      rw [module_iterate0 A a b x (-2) (-1)]
      refine finsum_mem_submodule_lf _ _ (fun i => ?_)
      rcases lt_or_ge i 0 with hi | hi
      · rw [cbz_apply_neg _ hi, mul_zero, zero_smul]; exact Submodule.zero_mem _
      · refine Submodule.smul_mem _ _ (Submodule.sub_mem _ ?_ (Submodule.smul_mem _ _ ?_))
        · exact mode_le_neg_two_mem_C2M A _ _ (by omega)
        · exact mode_le_neg_two_mem_C2M A _ _ (by omega)
  | zero => simp
  | add a b _ _ ha hb => rw [mode_YM_add]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [mode_YM_smul]; exact Submodule.smul_mem _ r ha

/-- The iterate-formula summand has finite support. -/
theorem iterate_support_finite (A : WeakModule W M) (u v : 𝒱) (x : M) (ℓ n : ℤ) :
    (Function.support (fun i : ℤ => (negOnePow i * cbz ℓ i) •
        (mode (A.YM u) (ℓ - i) (mode (A.YM v) (n + i) x)
          - negOnePow ℓ • mode (A.YM v) (ℓ + n - i) (mode (A.YM u) i x)))).Finite := by
  obtain ⟨N₁, hN₁⟩ := A.truncation v x
  obtain ⟨N₂, hN₂⟩ := A.truncation u x
  refine (Finset.Icc (0 : ℤ) (max (N₁ - n) N₂)).finite_toSet.subset ?_
  intro i hi
  simp only [Function.mem_support] at hi
  simp only [Finset.coe_Icc, Set.mem_Icc]
  by_contra hcon
  apply hi
  rcases lt_or_ge i 0 with h0 | h0
  · rw [cbz_apply_neg _ h0, mul_zero, zero_smul]
  · have hbig : max (N₁ - n) N₂ < i := by
      by_contra h; exact hcon ⟨h0, by omega⟩
    rw [hN₁ (n + i) (by omega), hN₂ i (by omega)]
    simp

/-- `a₍₋₁₎b₍₋₁₎x ≡ (a₍₋₁₎b)₍₋₁₎x mod C₂(M)` (iterate formula at `ℓ = n = −1`). -/
theorem negOne_negOne_sub_mem_C2M (A : WeakModule W M) (a b : 𝒱) (x : M) :
    mode (A.YM (W.smul a (-1) b)) (-1) x - mode (A.YM a) (-1) (mode (A.YM b) (-1) x)
      ∈ C2M A := by
  classical
  set F : ℤ → M := fun i => (negOnePow i * cbz (-1) i) •
      (mode (A.YM a) (-1 - i) (mode (A.YM b) (-1 + i) x)
        - negOnePow (-1) • mode (A.YM b) (-1 + -1 - i) (mode (A.YM a) i x)) with hF
  have hfin : (Function.support F).Finite := iterate_support_finite A a b x (-1) (-1)
  set s : Finset ℤ := insert 0 hfin.toFinset with hs
  have hsub : Function.support F ⊆ (s : Set ℤ) := by
    intro i hi; rw [hs, Finset.coe_insert]; exact Set.mem_insert_of_mem _ (hfin.mem_toFinset.mpr hi)
  have h0s : (0 : ℤ) ∈ s := Finset.mem_insert_self _ _
  rw [module_iterate0 A a b x (-1) (-1)]
  change (∑ᶠ i, F i) - _ ∈ _
  rw [finsum_eq_sum_of_support_subset F hsub, ← Finset.add_sum_erase s F h0s]
  have hF0 : F 0 = mode (A.YM a) (-1) (mode (A.YM b) (-1) x)
      + mode (A.YM b) (-2) (mode (A.YM a) 0 x) := by
    simp only [hF, cbz_apply_nonneg (-1) (le_refl (0 : ℤ)), Int.toNat_zero, gBinom_zero,
      negOnePow, Even.zero, if_true, mul_one, sub_zero, add_zero]
    have hodd : ¬ Even (-1 : ℤ) := by decide
    rw [if_neg hodd, show (-1 + -1 : ℤ) = -2 by norm_num, one_smul]
    simp [sub_eq_add_neg]
  rw [hF0]
  have hrest : ∑ i ∈ s.erase 0, F i ∈ C2M A := by
    refine Submodule.sum_mem _ (fun i hi => ?_)
    have hi0 : i ≠ 0 := Finset.ne_of_mem_erase hi
    rcases lt_or_ge i 0 with hlt | hge
    · simp only [hF, cbz_apply_neg _ hlt, mul_zero, zero_smul]; exact Submodule.zero_mem _
    · refine Submodule.smul_mem _ _ (Submodule.sub_mem _ ?_ (Submodule.smul_mem _ _ ?_))
      · exact mode_le_neg_two_mem_C2M A _ _ (by omega)
      · exact mode_le_neg_two_mem_C2M A _ _ (by omega)
  have h2 : mode (A.YM b) (-2) (mode (A.YM a) 0 x) ∈ C2M A :=
    mode_le_neg_two_mem_C2M A _ _ le_rfl
  have := Submodule.add_mem _ h2 hrest
  convert this using 1
  abel

/-! ## Stage A: finite lowest-weight generation ⟹ `C₂`-cofinite -/

/-- **Finite lowest-weight generation gives `C₂`-cofiniteness.**  If `𝒱` is `C₂`-cofinite
and the weak module `M` is spanned by strictly-negative-mode words on a finite set `B`, then
`M/C₂(M)` is finite-dimensional: it is spanned by the images of the finitely many `u₍₋₁₎b`. -/
theorem moduleC2Cofinite_of_LWGenerated (A : WeakModule W M) (hC2 : C2Cofinite W)
    {B : Set M} (hB : B.Finite) (hLW : LWGenerated A B) : ModuleC2Cofinite A := by
  classical
  obtain ⟨g, gen, wt, -, -, hdec⟩ := exists_homog_gen_of_C2Cofinite W hC2
  set U : Set 𝒱 := Set.range gen ∪ {W.vacuum} with hU
  have hUfin : U.Finite := (Set.finite_range gen).union (Set.finite_singleton _)
  set T : Set M := (fun p : 𝒱 × M => mode (A.YM p.1) (-1) p.2) '' (U ×ˢ B) with hT
  have hTfin : T.Finite := (hUfin.prod hB).image _
  set S : Submodule ℂ M := Submodule.span ℂ T ⊔ C2M A with hS
  have hC2S : C2M A ≤ S := le_sup_right
  -- every `v₍₋₁₎b` (`b ∈ B`) lies in `S`
  have hvB : ∀ b ∈ B, ∀ v : 𝒱, mode (A.YM v) (-1) b ∈ S := by
    intro b hb v
    have hv : v ∈ Submodule.span ℂ U ⊔ O₂ W := by rw [← hdec]; trivial
    obtain ⟨s, hs, o, ho, rfl⟩ := Submodule.mem_sup.mp hv
    rw [mode_YM_add]
    refine S.add_mem ?_ (hC2S (O₂_negOne_mem_C2M A b ho))
    clear hv
    induction hs using Submodule.span_induction with
    | mem z hz => exact Submodule.mem_sup_left (Submodule.subset_span ⟨(z, b), ⟨hz, hb⟩, rfl⟩)
    | zero => simp
    | add x y _ _ hx hy => rw [mode_YM_add]; exact S.add_mem hx hy
    | smul c x _ hx => rw [mode_YM_smul]; exact S.smul_mem c hx
  -- `c₍₋₁₎` preserves `S`
  have hstab : ∀ (c : 𝒱) (y : M), y ∈ S → mode (A.YM c) (-1) y ∈ S := by
    intro c y hy
    have hle : S ≤ S.comap (mode (A.YM c) (-1)) := by
      refine sup_le ?_ ?_
      · rw [Submodule.span_le]
        rintro _ ⟨⟨u, b⟩, ⟨_, hb⟩, rfl⟩
        change mode (A.YM c) (-1) (mode (A.YM u) (-1) b) ∈ S
        have hd := negOne_negOne_sub_mem_C2M A c u b
        have h1 := hvB b hb (W.smul c (-1) u)
        have := S.sub_mem h1 (hC2S hd)
        rwa [sub_sub_cancel] at this
      · intro z hz
        exact hC2S (negOne_mem_C2M A c hz)
    exact hle hy
  -- every negative-mode word on `B` lies in `S`
  have hword : ∀ (l : List (Letter 𝒱)) (w : M), w ∈ B → wordAct A l w ∈ S := by
    intro l w hw
    induction l with
    | nil =>
        have hvac : mode (A.YM W.vacuum) (-1) w = w := by
          have := A.act_vacuum (-1) w
          simpa using this
        rw [wordAct_nil, ← hvac]
        exact hvB w hw W.vacuum
    | cons p t ih =>
        rw [wordAct_cons]
        rcases Nat.eq_zero_or_pos p.2.2 with h0 | hpos
        · rw [h0, show (-((0 : ℕ) : ℤ) - 1) = -1 by norm_num]
          exact hstab _ _ ih
        · exact hC2S (mode_le_neg_two_mem_C2M A _ _ (by omega))
  have htop : (⊤ : Submodule ℂ M) ≤ S := by
    rw [← hLW, Gfil, Submodule.span_le]
    rintro _ ⟨l, w, _, hw, _, rfl⟩
    exact hword l w hw
  -- the finite-dimensional `span T` surjects onto `M/C₂(M)`
  haveI : FiniteDimensional ℂ (Submodule.span ℂ T) := FiniteDimensional.span_of_finite ℂ hTfin
  set K := C2M A
  have hsurj : Function.Surjective (K.mkQ.comp (Submodule.span ℂ T).subtype) := by
    intro q
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective K q
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (htop (Submodule.mem_top (x := x)))
    refine ⟨⟨y, hy⟩, ?_⟩
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.coe_subtype,
      Submodule.mkQ_apply]
    rw [Submodule.Quotient.eq, ← hyz]
    simpa using K.neg_mem hz
  exact Module.Finite.of_surjective _ hsurj

/-! ## Stage B: the named Buhl input -/

/-- **Buhl's finite lowest-weight generation.**  Every irreducible lowest-weight module of a
strongly rational `𝒱` is spanned by words in strictly negative modes applied to some **finite**
set of vectors.

*Source.* G. Buhl, *A spanning set for VOA modules*, J. Algebra 254 (2002) 125–151, Main Theorem:
for `C₂`-cofinite `𝒱` (with `𝒱₀ = ℂ𝟙`, `𝒱_{<0} = 0`) a weak module generated by `w` is spanned by
`x¹₍₋n₁₎⋯x^k₍₋n_k₎w`, `n₁ ≥ ⋯ ≥ n_k > −L`, each index repeated `< Q` times; the inner monomials
with `n_j ≤ 0` are bounded in mode **and** length, hence finitely many, and form `B`.  Also
M. Miyamoto, Duke Math. J. 122 (2004), Thm. 2.7.  An irreducible module is generated by any nonzero
vector.

*Not vacuous / not false.* `B` ranges over arbitrary finite sets (not just the bottom, for which
the statement fails — Ising), and `LWGenerated` is the honest span statement `Gfil A B 0 = ⊤`. -/
def BuhlFiniteLWGenInput : Prop :=
  ∀ (𝒱 : Type u) [AddCommGroup 𝒱] [Module ℂ 𝒱] (W : VertexOperatorAlgebra 𝒱),
    StronglyRational W → ∀ P : LWModule W, P.IsIrreducibleLW →
      ∃ B : Set P.carrier, B.Finite ∧ LWGenerated P.isMod.toWeakModule B

/-- **`ModuleC2Input` from Buhl's finite generation.** -/
theorem moduleC2Input_of_buhlFiniteLWGen (h : BuhlFiniteLWGenInput.{u}) : ModuleC2Input.{u} := by
  intro 𝒱 _ _ W hV P hP
  obtain ⟨B, hB, hLW⟩ := h 𝒱 W hV P hP
  exact moduleC2Cofinite_of_LWGenerated _ hV.toStronglyFinite.c2Cofinite hB hLW

/-! ## Stage C: closure of the negative-mode span from a base condition -/

/-- **Base closure** of `B`: every non-negative mode of every `b ∈ B` lands in the
negative-mode span `Gfil A B 0`. -/
def BaseClosed (A : WeakModule W M) (B : Set M) : Prop :=
  ∀ b ∈ B, ∀ (u : 𝒱) (k : ℤ), 0 ≤ k → mode (A.YM u) k b ∈ Gfil A B 0

/-- `Gfil A B 0` is closed under every **negative** mode. -/
theorem neg_mode_mem_Gfil_zero (A : WeakModule W M) (B : Set M) (u : 𝒱) {k : ℤ} (hk : k < 0)
    {x : M} (hx : x ∈ Gfil A B 0) : mode (A.YM u) k x ∈ Gfil A B 0 := by
  refine induction_grading (W := W)
    (motive := fun u => mode (A.YM u) k x ∈ Gfil A B 0) u (by simp)
    (fun a b ha hb => by
      change mode (A.YM (a + b)) k x ∈ Gfil A B 0
      rw [mode_YM_add]; exact Submodule.add_mem _ ha hb) (fun p a ha => ?_)
  rcases lt_or_ge p 0 with hp | hp
  · rw [W.positivity p hp, Submodule.mem_bot] at ha
    subst ha; simp
  · have ha' : a ∈ W.grading ((p.toNat : ℕ) : ℤ) := by rwa [Int.toNat_of_nonneg hp]
    have h := Gfil_prepend A B (c := a) (b := p.toNat) (n := (-k - 1).toNat) ha' hx
    rw [show (-(((-k - 1).toNat : ℕ) : ℤ) - 1) = k by omega] at h
    exact (Gfil_antitone A B (by omega)) h

/-- **The commutator word induction.**  Under `BaseClosed A B`, every mode of every vector maps
a negative-mode word on `B` into `Gfil A B 0`. -/
theorem wordAct_act_mem_Gfil_zero (A : WeakModule W M) (B : Set M) (hcl : BaseClosed A B)
    (l : List (Letter 𝒱)) {w : M} (hw : w ∈ B) (hl : WordOK W l) :
    ∀ (u : 𝒱) (k : ℤ), mode (A.YM u) k (wordAct A l w) ∈ Gfil A B 0 := by
  induction l with
  | nil =>
      intro u k
      rw [wordAct_nil]
      rcases le_or_gt 0 k with hk | hk
      · exact hcl w hw u k hk
      · exact neg_mode_mem_Gfil_zero A B u hk (mem_Gfil_of_mem_B A B hw le_rfl)
  | cons pc t ih =>
      intro u k
      obtain ⟨hpc, ht⟩ := WordOK_of_cons hl
      have hcomm := VOA.mode_commutator A u pc.1 (wordAct A t w) k (-(pc.2.2 : ℤ) - 1)
      have hsplit : mode (A.YM u) k (wordAct A (pc :: t) w)
          = mode (A.YM pc.1) (-(pc.2.2 : ℤ) - 1) (mode (A.YM u) k (wordAct A t w))
            + ∑ᶠ j : ℤ, cbz k j •
                mode (A.YM (W.smul u j pc.1)) (k + (-(pc.2.2 : ℤ) - 1) - j) (wordAct A t w) := by
        rw [wordAct_cons, ← hcomm]
        abel
      rw [hsplit]
      refine Submodule.add_mem _ ?_ ?_
      · exact neg_mode_mem_Gfil_zero A B _ (by omega) (ih ht u k)
      · exact finsum_mem_submodule_lf _ _ (fun j => Submodule.smul_mem _ _ (ih ht _ _))

/-- Under `BaseClosed A B`, `Gfil A B 0` is closed under **all** modes. -/
theorem act_mem_Gfil_zero_of_baseClosed (A : WeakModule W M) (B : Set M) (hcl : BaseClosed A B)
    (u : 𝒱) (k : ℤ) {x : M} (hx : x ∈ Gfil A B 0) : mode (A.YM u) k x ∈ Gfil A B 0 := by
  refine Submodule.span_induction
    (p := fun x _ => mode (A.YM u) k x ∈ Gfil A B 0) ?_ ?_ ?_ ?_ hx
  · rintro y ⟨l, w, hl, hw, _, rfl⟩
    exact wordAct_act_mem_Gfil_zero A B hcl l hw hl u k
  · simp
  · intro x y _ _ hx hy; rw [map_add]; exact Submodule.add_mem _ hx hy
  · intro c x _ hx; rw [map_smul]; exact Submodule.smul_mem _ c hx

/-- `Gfil A B 0` as a weak submodule, under base closure. -/
def gfilSub (A : WeakModule W M) (B : Set M) (hcl : BaseClosed A B) :
    WeakModule.Submodule' A where
  carrier := Gfil A B 0
  act_mem := fun u n _ hx => act_mem_Gfil_zero_of_baseClosed A B hcl u n hx

/-- **Base closure + a nonzero vector ⟹ lowest-weight generation**, on an irreducible
module. -/
theorem lwGenerated_of_baseClosed {N : OrdVModule W M} (hirr : N.IsIrreducible) {B : Set M}
    (hcl : BaseClosed N.toWeakModule B) {b : M} (hb : b ∈ B) (hb0 : b ≠ 0) :
    LWGenerated N.toWeakModule B := by
  rcases hirr.2 (gfilSub N.toWeakModule B hcl) with h | h
  · exfalso
    have hmem : b ∈ Gfil N.toWeakModule B 0 := mem_Gfil_of_mem_B _ B hb le_rfl
    change Gfil N.toWeakModule B 0 = ⊥ at h
    rw [h, Submodule.mem_bot] at hmem
    exact hb0 hmem
  · exact h

/-- Every word on the zero vector is zero. -/
theorem wordAct_zero (A : WeakModule W M) : ∀ l : List (Letter 𝒱), wordAct A l 0 = 0
  | [] => rfl
  | p :: t => by rw [wordAct_cons, wordAct_zero A t, map_zero]

/-- On a nontrivial module, a lowest-weight generating set contains a nonzero vector. -/
theorem exists_ne_zero_of_lwGenerated (A : WeakModule W M) [Nontrivial M] {B : Set M}
    (hLW : LWGenerated A B) : ∃ b ∈ B, b ≠ 0 := by
  by_contra hcon
  push Not at hcon
  have hle : Gfil A B 0 ≤ ⊥ := by
    rw [Gfil, Submodule.span_le]
    rintro _ ⟨l, w, _, hw, _, rfl⟩
    rw [hcon w hw, wordAct_zero]; exact Submodule.zero_mem _
  rw [hLW] at hle
  obtain ⟨x, hx⟩ := exists_ne (0 : M)
  exact hx ((Submodule.mem_bot ℂ).mp (hle Submodule.mem_top))

/-- **The base-closure form of Buhl's input**: a finite set containing a nonzero vector whose
non-negative modes land in its negative-mode span. -/
def BuhlBaseClosedInput : Prop :=
  ∀ (𝒱 : Type u) [AddCommGroup 𝒱] [Module ℂ 𝒱] (W : VertexOperatorAlgebra 𝒱),
    StronglyRational W → ∀ P : LWModule W, P.IsIrreducibleLW →
      ∃ B : Set P.carrier, B.Finite ∧ (∃ b ∈ B, b ≠ 0) ∧ BaseClosed P.isMod.toWeakModule B

/-- **The two named inputs are equivalent** (so `BuhlBaseClosedInput` is a faithful
restatement, not a weakening). -/
theorem buhlFiniteLWGenInput_iff_baseClosed :
    BuhlFiniteLWGenInput.{u} ↔ BuhlBaseClosedInput.{u} := by
  constructor
  · intro h 𝒱 _ _ W hV P hP
    obtain ⟨B, hB, hLW⟩ := h 𝒱 W hV P hP
    haveI : Nontrivial P.carrier := hP.1
    refine ⟨B, hB, exists_ne_zero_of_lwGenerated _ hLW, ?_⟩
    intro b _ u k _
    rw [hLW]; exact Submodule.mem_top
  · intro h 𝒱 _ _ W hV P hP
    obtain ⟨B, hB, ⟨b, hb, hb0⟩, hcl⟩ := h 𝒱 W hV P hP
    exact ⟨B, hB, lwGenerated_of_baseClosed hP hcl hb hb0⟩

/-- `ModuleC2Input` from the base-closure input. -/
theorem moduleC2Input_of_buhlBaseClosed (h : BuhlBaseClosedInput.{u}) : ModuleC2Input.{u} :=
  moduleC2Input_of_buhlFiniteLWGen (buhlFiniteLWGenInput_iff_baseClosed.mpr h)

end VOA.Huang.ModuleC2
