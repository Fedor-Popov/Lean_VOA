import VOA.Modules.AdmissibleModule
import VOA.Modules.Character
import VOA.Modularity.ZhuRecursionProof

/-!
# Bottom recovery in admissible modules (part 1)

Let `N` be an admissible `V`-module (levels `N(k)`, `N(k) = 0` for `k < 0`) and `S ⊆ N(0)` a
subspace stable under every zero mode `o(a) = a₍wt a − 1₎`. Then the weak submodule generated by
`S` is graded and meets `N(0)` exactly in `S`.

This is the "bottom recovery" that the library isolates as `BottomRecovers`
(`Modules/ZhuVermaAnArchLeaf3`) and treats as keystone-caliber; it is elementary. A word of
homogeneous modes is built one letter at a time (`WS`). If the last letter lowers the level of a
vector `y` that came from `S` by `j` letters, the commutator formula moves it to the right
(`act_WS_mem`), where it kills `S ⊆ N(0)`; the commutator terms are words of length `j`, so
induction on `j` closes (`WS_lev_zero_mem`).

## Main results

* `act_WS_mem` — `a₍ₚ₎ (WS X j) ⊆ span WS (a₍ₚ₎ X) j ⊔ span WS X j` (commutator step);
* `WS_lev_zero_mem` — a word from `S` that lands in `N(0)` lands in `S`;
* `genSub` — the weak submodule generated by `S`, with `genSub_le_bottom` (`genSub ∩ N(0) ⊆ S`),
  `levProj_mem_genSub` (it is graded) and `le_genSub` (it contains `S`).

`#print axioms`: Lean's three.
-/

namespace VOA.Huang.BottomRecovery

open VOA

universe u v

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
variable {M : Type v} [AddCommGroup M] [Module ℂ M]

/-! ## §1 Generic helpers -/

theorem finsum_mem_submodule {ι : Type*} (S : Submodule ℂ M) (f : ι → M)
    (h : ∀ i, f i ∈ S) : ∑ᶠ i, f i ∈ S := by
  classical
  rw [finsum_def]
  split_ifs with hfin
  · exact Submodule.sum_mem _ (fun i _ => h i)
  · exact S.zero_mem

theorem act_add_left (A : WeakModule W M) (u v : 𝒱) (n : ℤ) (x : M) :
    A.act (u + v) n x = A.act u n x + A.act v n x := by
  simp only [WeakModule.act_def, map_add, mode_add, LinearMap.add_apply]

theorem act_zero_left (A : WeakModule W M) (n : ℤ) (x : M) : A.act 0 n x = 0 := by
  simp only [WeakModule.act_def, map_zero, mode_zero, LinearMap.zero_apply]

theorem act_zero_right (A : WeakModule W M) (u : 𝒱) (n : ℤ) : A.act u n 0 = 0 :=
  map_zero (mode (A.YM u) n)

theorem act_smul_right (A : WeakModule W M) (u : 𝒱) (n : ℤ) (c : ℂ) (x : M) :
    A.act u n (c • x) = c • A.act u n x :=
  map_smul (mode (A.YM u) n) c x

/-- The commutator formula in the `act` API. -/
theorem act_commutator (A : WeakModule W M) (u v : 𝒱) (x : M) (m n : ℤ) :
    A.act u m (A.act v n x) = A.act v n (A.act u m x)
      + ∑ᶠ i : ℤ, cbz m i • A.act (W.smul u i v) (m + n - i) x := by
  have h := mode_commutator A u v x m n
  simp only [WeakModule.act_def]
  rw [← h]
  abel

/-- `act u n` maps a span into a span. -/
theorem act_mem_span {A : WeakModule W M} {X Y : Set M} (u : 𝒱) (n : ℤ)
    (hXY : ∀ x ∈ X, A.act u n x ∈ Submodule.span ℂ Y) {y : M}
    (hy : y ∈ Submodule.span ℂ X) : A.act u n y ∈ Submodule.span ℂ Y := by
  induction hy using Submodule.span_induction with
  | mem x hx => exact hXY x hx
  | zero => rw [act_zero_right]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [WeakModule.act_add_right]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [act_smul_right]; exact Submodule.smul_mem _ c hx

/-! ## §2 Words of homogeneous modes -/

/-- `WS A X j`: vectors obtained from `X` by `j` homogeneous modes. -/
def WS (A : WeakModule W M) (X : Set M) : ℕ → Set M
  | 0 => X
  | j + 1 => {z | ∃ (a : 𝒱) (w p : ℤ) (y : M), a ∈ W.grading w ∧ y ∈ WS A X j ∧ z = A.act a p y}

theorem WS_succ_mem {A : WeakModule W M} {X : Set M} {j : ℕ} {a : 𝒱} {w : ℤ}
    (ha : a ∈ W.grading w) (p : ℤ) {y : M} (hy : y ∈ WS A X j) : A.act a p y ∈ WS A X (j + 1) :=
  ⟨a, w, p, y, ha, hy, rfl⟩

theorem act_span_WS {A : WeakModule W M} {X : Set M} {j : ℕ} {a : 𝒱} {w : ℤ}
    (ha : a ∈ W.grading w) (p : ℤ) {y : M} (hy : y ∈ Submodule.span ℂ (WS A X j)) :
    A.act a p y ∈ Submodule.span ℂ (WS A X (j + 1)) :=
  act_mem_span a p (fun _ hx => Submodule.subset_span (WS_succ_mem ha p hx)) hy

theorem WS_subset_zero {A : WeakModule W M} {X : Set M} (hX : X ⊆ {0}) :
    ∀ j, WS A X j ⊆ {0}
  | 0 => hX
  | j + 1 => by
    rintro z ⟨a, w, p, y, _, hy, rfl⟩
    have : y = 0 := WS_subset_zero hX j hy
    rw [this, act_zero_right]; rfl

/-- **The commutator step.** Applying a homogeneous mode `c = a₍ₚ₎` to a word of length `j` on `X`
gives a word of length `j` on `c X` plus words of length `j` on `X`. -/
theorem act_WS_mem (A : WeakModule W M) {a : 𝒱} {w : ℤ} (ha : a ∈ W.grading w) (p : ℤ) :
    ∀ (j : ℕ) (X : Set M) {y : M}, y ∈ WS A X j →
      A.act a p y ∈ Submodule.span ℂ (WS A (A.act a p '' X) j) ⊔ Submodule.span ℂ (WS A X j)
  | 0, X, y, hy => Submodule.mem_sup_left (Submodule.subset_span ⟨y, hy, rfl⟩)
  | j + 1, X, y, hy => by
    obtain ⟨b, wb, q, z, hb, hz, rfl⟩ := hy
    rw [act_commutator]
    refine Submodule.add_mem _ ?_ ?_
    · obtain ⟨s, hs, t, ht, hst⟩ := Submodule.mem_sup.mp (act_WS_mem A ha p j X hz)
      rw [← hst, WeakModule.act_add_right]
      exact Submodule.add_mem_sup (act_span_WS hb q hs) (act_span_WS hb q ht)
    · refine Submodule.mem_sup_right (finsum_mem_submodule _ _ (fun i => ?_))
      refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
      exact WS_succ_mem (W.toPreVertexAlgebra.smul_mem_grading ha hb i) _ hz

/-! ## §3 Admissible modules: levels and projections -/

section Admissible

variable (N : AdmissibleModule W M)

/-- The projection onto level `k`, as an endomorphism of `M`. -/
noncomputable def levProj (k : ℤ) : M →ₗ[ℂ] M :=
  letI := DirectSum.IsInternal.chooseDecomposition N.lev N.isInternal
  (N.lev k).subtype.comp ((DirectSum.component ℂ ℤ (fun j => N.lev j) k).comp
    (DirectSum.decomposeLinearEquiv N.lev).toLinearMap)

theorem levProj_mem (k : ℤ) (x : M) : levProj N k x ∈ N.lev k := by
  unfold levProj
  exact Submodule.coe_mem _

theorem levProj_of_mem {k : ℤ} {x : M} (hx : x ∈ N.lev k) : levProj N k x = x := by
  classical
  letI := DirectSum.IsInternal.chooseDecomposition N.lev N.isInternal
  change ((DirectSum.component ℂ ℤ (fun j => N.lev j) k)
      (DirectSum.decomposeLinearEquiv N.lev x) : M) = x
  rw [show (DirectSum.decomposeLinearEquiv N.lev x) = DirectSum.decompose N.lev x from rfl,
    ← DirectSum.apply_eq_component, DirectSum.decompose_of_mem_same N.lev hx]

theorem levProj_of_mem_ne {k k' : ℤ} {x : M} (hx : x ∈ N.lev k') (hne : k ≠ k') :
    levProj N k x = 0 := by
  classical
  letI := DirectSum.IsInternal.chooseDecomposition N.lev N.isInternal
  have hdec := DirectSum.decompose_of_mem_ne N.lev hx (Ne.symm hne)
  change ((DirectSum.component ℂ ℤ (fun j => N.lev j) k)
      (DirectSum.decomposeLinearEquiv N.lev x) : M) = 0
  rw [show (DirectSum.decomposeLinearEquiv N.lev x) = DirectSum.decompose N.lev x from rfl,
    ← DirectSum.apply_eq_component, hdec]

theorem eq_zero_of_mem_lev_ne {k k' : ℤ} {x : M} (hx : x ∈ N.lev k) (hx' : x ∈ N.lev k')
    (hne : k ≠ k') : x = 0 := by
  have h1 := levProj_of_mem N hx
  rw [levProj_of_mem_ne N hx' hne] at h1
  exact h1.symm

theorem act_lev' {w p k : ℤ} {a : 𝒱} (ha : a ∈ W.grading w) {x : M} (hx : x ∈ N.lev k) :
    N.toWeakModule.act a p x ∈ N.lev (k + (w - p - 1)) := N.act_lev ha hx

/-- Words on a set of homogeneous vectors are homogeneous. -/
theorem WS_homog {X : Set M} (hX : ∀ x ∈ X, ∃ k, x ∈ N.lev k) :
    ∀ j, ∀ z ∈ WS N.toWeakModule X j, ∃ k, z ∈ N.lev k
  | 0 => hX
  | j + 1 => by
    rintro z ⟨a, w, p, y, ha, hy, rfl⟩
    obtain ⟨k, hk⟩ := WS_homog hX j y hy
    exact ⟨_, act_lev' N ha hk⟩

/-! ## §4 Bottom recovery -/

variable {N}
variable (S : Submodule ℂ M) (hS0 : S ≤ N.lev 0)
  (hSo : ∀ ⦃a : 𝒱⦄ ⦃w : ℤ⦄, a ∈ W.grading w → ∀ ⦃x : M⦄, x ∈ S →
    N.toWeakModule.act a (w - 1) x ∈ S)

include hS0 in
theorem S_homog : ∀ x ∈ (S : Set M), ∃ k, x ∈ N.lev k := fun _ hx => ⟨0, hS0 hx⟩

include hS0 in
/-- A spanned combination of words, each landing in `S` when it lands in level `0`, has its
level-`0` projection in `S`. -/
theorem levProj_zero_mem_of_span {j : ℕ}
    (hj : ∀ z ∈ WS N.toWeakModule (S : Set M) j, z ∈ N.lev 0 → z ∈ S) {y : M}
    (hy : y ∈ Submodule.span ℂ (WS N.toWeakModule (S : Set M) j)) : levProj N 0 y ∈ S := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨k, hk⟩ := WS_homog N (S_homog S hS0) j z hz
    by_cases hk0 : k = 0
    · subst hk0; rw [levProj_of_mem N hk]; exact hj z hz hk
    · rw [levProj_of_mem_ne N hk (Ne.symm hk0)]; exact S.zero_mem
  | zero => rw [map_zero]; exact S.zero_mem
  | add x y _ _ hx hy => rw [map_add]; exact S.add_mem hx hy
  | smul c x _ hx => rw [map_smul]; exact S.smul_mem c hx

include hS0 hSo in
/-- **Bottom recovery.** A word of homogeneous modes applied to `S` that lands in level `0`
lands in `S`. -/
theorem WS_lev_zero_mem : ∀ j, ∀ z ∈ WS N.toWeakModule (S : Set M) j, z ∈ N.lev 0 → z ∈ S
  | 0 => fun z hz _ => hz
  | j + 1 => by
    rintro z ⟨a, w, p, y, ha, hy, rfl⟩ hz0
    have IH := WS_lev_zero_mem j
    obtain ⟨k, hk⟩ := WS_homog N (S_homog S hS0) j y hy
    have hzk := act_lev' N (p := p) ha hk
    by_cases hz : N.toWeakModule.act a p y = 0
    · rw [hz]; exact S.zero_mem
    have hlev : k + (w - p - 1) = 0 := by
      by_contra hne
      exact hz (eq_zero_of_mem_lev_ne N hzk hz0 hne)
    rcases lt_trichotomy k 0 with hneg | hk0 | hpos
    · rw [N.lev_eq_bot_of_neg k hneg, Submodule.mem_bot] at hk
      rw [hk, act_zero_right]; exact S.zero_mem
    · subst hk0
      have hp : p = w - 1 := by omega
      subst hp
      exact hSo ha (IH y hy hk)
    · -- a lowering mode: commute it to the right, where it kills `S`.
      have hkill : N.toWeakModule.act a p '' (S : Set M) ⊆ {0} := by
        rintro _ ⟨s, hs, rfl⟩
        have hs' := act_lev' N (p := p) ha (hS0 hs)
        rw [N.lev_eq_bot_of_neg _ (by omega), Submodule.mem_bot] at hs'
        exact hs'
      have hmem := act_WS_mem N.toWeakModule ha p j (S : Set M) hy
      have hbot : Submodule.span ℂ (WS N.toWeakModule (N.toWeakModule.act a p '' (S : Set M)) j)
          = ⊥ := by
        rw [Submodule.span_eq_bot]
        intro x hx
        exact WS_subset_zero hkill j hx
      rw [hbot, bot_sup_eq] at hmem
      have := levProj_zero_mem_of_span S hS0 IH hmem
      rwa [levProj_of_mem N hz0] at this

/-! ## §5 The generated weak submodule -/

/-- The span of all words on `S`. -/
def genCarrier : Submodule ℂ M :=
  Submodule.span ℂ (⋃ j, WS N.toWeakModule (S : Set M) j)

theorem act_genCarrier (u : 𝒱) (n : ℤ) {x : M} (hx : x ∈ genCarrier (N := N) S) :
    N.toWeakModule.act u n x ∈ genCarrier (N := N) S := by
  have htop : u ∈ ⨆ w, W.grading w := by
    rw [W.isInternal.submodule_iSup_eq_top]; exact Submodule.mem_top
  refine Submodule.iSup_induction _ (motive := fun u => N.toWeakModule.act u n x ∈ genCarrier S)
    htop ?_ ?_ ?_
  · intro w a ha
    refine act_mem_span a n (fun z hz => ?_) hx
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hz
    exact Submodule.subset_span (Set.mem_iUnion.mpr ⟨j + 1, WS_succ_mem ha n hj⟩)
  · change N.toWeakModule.act 0 n x ∈ genCarrier S
    rw [act_zero_left]; exact Submodule.zero_mem _
  · intro a b ha hb
    change N.toWeakModule.act (a + b) n x ∈ genCarrier S
    rw [act_add_left]; exact Submodule.add_mem _ ha hb

/-- The weak submodule generated by `S`. -/
def genSub : WeakModule.Submodule' N.toWeakModule where
  carrier := genCarrier (N := N) S
  act_mem u n _ hx := act_genCarrier S u n hx

theorem le_genSub : S ≤ (genSub (N := N) S).carrier := fun _ hx =>
  Submodule.subset_span (Set.mem_iUnion.mpr ⟨0, hx⟩)

include hS0 hSo in
/-- **The generated submodule meets level `0` exactly in `S`.** -/
theorem levProj_zero_genSub {y : M} (hy : y ∈ (genSub (N := N) S).carrier) :
    levProj N 0 y ∈ S := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hz
    exact levProj_zero_mem_of_span S hS0 (WS_lev_zero_mem S hS0 hSo j)
      (Submodule.subset_span hj)
  | zero => rw [map_zero]; exact S.zero_mem
  | add x y _ _ hx hy => rw [map_add]; exact S.add_mem hx hy
  | smul c x _ hx => rw [map_smul]; exact S.smul_mem c hx

include hS0 hSo in
theorem genSub_le_bottom {y : M} (hy : y ∈ (genSub (N := N) S).carrier) (hy0 : y ∈ N.lev 0) :
    y ∈ S := by
  have := levProj_zero_genSub S hS0 hSo hy
  rwa [levProj_of_mem N hy0] at this

include hS0 in
/-- The generated submodule is graded. -/
theorem levProj_mem_genSub (k : ℤ) {y : M} (hy : y ∈ (genSub (N := N) S).carrier) :
    levProj N k y ∈ (genSub (N := N) S).carrier := by
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hz
    obtain ⟨m, hm⟩ := WS_homog N (S_homog S hS0) j z hj
    by_cases hkm : k = m
    · subst hkm; rw [levProj_of_mem N hm]; exact Submodule.subset_span hz
    · rw [levProj_of_mem_ne N hm hkm]; exact Submodule.zero_mem _
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [map_smul]; exact Submodule.smul_mem _ c hx

end Admissible

end VOA.Huang.BottomRecovery
