import VOA.Huang.AssocConverseReduction
import Mathlib.LinearAlgebra.TensorProduct.Basis
import VOA.Modularity.CharIndependenceAMod

/-!
# Simultaneous spanning by intertwining coefficients

Spanning by each nonzero intertwiner separately does not suffice to separate
tensor sums. The simultaneous statement below uses Schur's lemma and a
complement in a finite sum of simple modules over the mode algebra.
-/

namespace VOA.Huang.AssocConverse

open VOA VOA.Huang.PzTensorSemisimple VOA.Huang.FusionUnit
open scoped BigOperators TensorProduct

universe u v
variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
  {W : VertexOperatorAlgebra 𝒱}
variable {P₂ P₃ Q : LWModule W} {ι : Type v}

/-- The simultaneous vector of coefficients, retaining multiplicity indices. -/
def coefficientVector
    (B : ι → IntertwiningOperator P₂.isMod P₃.isMod Q.isMod)
    (n : ℂ) (x : P₂.carrier) (y : P₃.carrier) : ι → Q.carrier :=
  fun i => (B i).val n x y

noncomputable def coefficientSpan
    (B : ι → IntertwiningOperator P₂.isMod P₃.isMod Q.isMod) :
    Submodule ℂ (ι → Q.carrier) :=
  Submodule.span ℂ {z | ∃ n x y, z = coefficientVector B n x y}

theorem coefficientVector_mem
    (B : ι → IntertwiningOperator P₂.isMod P₃.isMod Q.isMod)
    (n : ℂ) (x : P₂.carrier) (y : P₃.carrier) :
    coefficientVector B n x y ∈ coefficientSpan B :=
  Submodule.subset_span ⟨n, x, y, rfl⟩

theorem coefficientSpan_mode_stable
    (B : ι → IntertwiningOperator P₂.isMod P₃.isMod Q.isMod)
    (a : 𝒱) (m : ℤ) {z : ι → Q.carrier} (hz : z ∈ coefficientSpan B) :
    (fun i => mode (Q.isMod.YM a) m (z i)) ∈ coefficientSpan B := by
  classical
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨n, x, y, rfl⟩ := hz
    have he : (fun j => mode (Q.isMod.YM a) m (coefficientVector B n x y j)) =
        coefficientVector B n x (mode (P₃.isMod.YM a) m y) +
          ∑ᶠ k : ℤ, cbz m k •
            coefficientVector B (m + n - k) (mode (P₂.isMod.YM a) k x) y := by
      obtain ⟨N, hN⟩ := P₂.isMod.truncation a x
      have hs : (Function.support fun k : ℤ => cbz m k •
          coefficientVector B (m + n - k) (mode (P₂.isMod.YM a) k x) y).Finite := by
        apply (Set.finite_Ico 0 N).subset
        intro k hk
        by_contra h
        have he : cbz m k •
            coefficientVector B (m + n - k) (mode (P₂.isMod.YM a) k x) y = 0 := by
          by_cases hk0 : k < 0
          · simp [cbz_apply_neg m hk0]
          · have hkN : N ≤ k := by simp only [Set.mem_Ico] at h; omega
            rw [hN k hkN]
            have hz : coefficientVector B (m + n - k) 0 y = 0 := by
              funext j
              exact congrArg (fun g : P₃.carrier →ₗ[ℂ] Q.carrier => g y)
                ((B j).val (m + n - k)).map_zero
            rw [hz, smul_zero]
        exact hk he
      funext j
      have hj := (B j).property.commutator a x y m n
      have hm := map_finsum (LinearMap.proj j : (ι → Q.carrier) →ₗ[ℂ] Q.carrier) hs
      simp only [Pi.add_apply]
      rw [show (∑ᶠ k : ℤ, cbz m k •
          coefficientVector B (m + n - k) (mode (P₂.isMod.YM a) k x) y) j =
          ∑ᶠ k : ℤ, cbz m k • (B j).val (m + n - k)
            (mode (P₂.isMod.YM a) k x) y from hm]
      exact (sub_eq_iff_eq_add.mp hj).trans (add_comm _ _)
    rw [he]
    exact (coefficientSpan B).add_mem (coefficientVector_mem B _ _ _)
      (VOA.Huang.BottomRecovery.finsum_mem_submodule _ _ fun k =>
        (coefficientSpan B).smul_mem _ (coefficientVector_mem B _ _ _))
  | zero => simpa only [Pi.zero_apply, map_zero] using (coefficientSpan B).zero_mem
  | add x y _ _ hx hy => simpa using (coefficientSpan B).add_mem hx hy
  | smul c x _ hx => simpa using (coefficientSpan B).smul_mem c hx

/-- Irreducibility is simplicity for the algebra generated by all modes. -/
theorem isSimpleModule_modeAlg (iQ : Q.IsIrreducibleLW) :
    IsSimpleModule (modeAlg Q.isMod.toWeakModule) Q.carrier := by
  letI := iQ.1
  refine { eq_bot_or_eq_top := fun S => ?_ }
  rcases iQ.2 (ofSub Q.isMod.toWeakModule S) with h | h
  · left; ext x; exact SetLike.ext_iff.mp h x
  · right; ext x; exact SetLike.ext_iff.mp h x

theorem coefficientSpan_modeAlg_stable
    (B : ι → IntertwiningOperator P₂.isMod P₃.isMod Q.isMod)
    (a : modeAlg Q.isMod.toWeakModule) {z : ι → Q.carrier}
    (hz : z ∈ coefficientSpan B) : a • z ∈ coefficientSpan B := by
  obtain ⟨a, ha⟩ := a
  change (fun i => a (z i)) ∈ coefficientSpan B
  induction ha using Algebra.adjoin_induction generalizing z with
  | mem a ha =>
    obtain ⟨⟨a, m⟩, rfl⟩ := ha
    exact coefficientSpan_mode_stable B a m hz
  | algebraMap c => simpa using (coefficientSpan B).smul_mem c hz
  | add a b _ _ ha hb => exact (coefficientSpan B).add_mem (ha hz) (hb hz)
  | mul a b _ _ ha hb => exact ha (hb hz)

theorem isSemisimpleModule_finite_pi {A : Type*} [Ring A]
    {E : Type*} [AddCommGroup E] [Module A E] [IsSimpleModule A E]
    [Finite ι] : IsSemisimpleModule A (ι → E) := by
  classical
  letI := Fintype.ofFinite ι
  refine IsSemisimpleModule.of_sSup_simples_eq_top (top_unique ?_)
  intro x _
  rw [← Finset.univ_sum_single x]
  apply Submodule.sum_mem
  intro j _
  let f := LinearMap.single A (fun _ : ι => E) j
  have hf : Function.Injective f := fun x y h => by
    have := congrFun h j
    simpa [f] using this
  have hi : IsSimpleModule A (LinearMap.range f) :=
    IsSimpleModule.congr (LinearEquiv.ofInjective f hf).symm
  exact le_sSup (show LinearMap.range f ∈
    {N : Submodule A (ι → E) | IsSimpleModule A N} from hi) ⟨x j, rfl⟩

/-- Independent intertwiners span all copies of the intermediate module
simultaneously. No rationality or distinctness of conformal weights is used. -/
theorem coefficientSpan_eq_top [Finite ι] (iQ : Q.IsIrreducibleLW)
    (B : ι → IntertwiningOperator P₂.isMod P₃.isMod Q.isMod)
    (hB : LinearIndependent ℂ B) : coefficientSpan B = ⊤ := by
  classical
  letI := Fintype.ofFinite ι
  letI := iQ.1
  letI := isSimpleModule_modeAlg iQ
  letI : IsSemisimpleModule (modeAlg Q.isMod.toWeakModule) (ι → Q.carrier) :=
    isSemisimpleModule_finite_pi
  let S : Submodule (modeAlg Q.isMod.toWeakModule) (ι → Q.carrier) :=
    { carrier := coefficientSpan B
      zero_mem' := (coefficientSpan B).zero_mem
      add_mem' := (coefficientSpan B).add_mem
      smul_mem' := fun a z hz => coefficientSpan_modeAlg_stable B a hz }
  obtain ⟨T, hT⟩ := exists_isCompl S
  let p := T.projection S hT.symm
  have hp : p = 0 := by
    apply LinearMap.ext
    intro z
    funext j
    let f (k : ι) : Q.carrier →ₗ[ℂ] Q.carrier :=
      (LinearMap.proj j : (ι → Q.carrier) →ₗ[ℂ] Q.carrier).comp
        ((p.restrictScalars ℂ).comp (LinearMap.single ℂ (fun _ : ι => Q.carrier) k))
    have hf (k : ι) : f k ∈ homSpace Q.isMod Q.isMod := by
      intro a m x
      have he : Pi.single k (mode (Q.isMod.YM a) m x) =
          modeElt Q.isMod.toWeakModule a m • (Pi.single k x : ι → Q.carrier) := by
        ext l
        by_cases hl : l = k
        · subst l; simp; rfl
        · simp [Pi.single_eq_of_ne hl]
      change p (Pi.single k (mode (Q.isMod.YM a) m x)) j = _
      rw [he, p.map_smul]
      rfl
    have hid : (LinearMap.id : Q.carrier →ₗ[ℂ] Q.carrier) ∈ homSpace Q.isMod Q.isMod :=
      fun _ _ _ => rfl
    obtain ⟨c, hc⟩ : ∃ c : ι → ℂ, ∀ k, c k • LinearMap.id = f k :=
      Classical.axiomOfChoice fun k => exists_smul_eq_of_hom iQ iQ (hf k) hid
        (by
          intro h
          obtain ⟨x, hx⟩ := exists_ne (0 : Q.carrier)
          exact hx (LinearMap.congr_fun h x))
    have hsum (z : ι → Q.carrier) : p z j = ∑ k, c k • z k := by
      conv_lhs => rw [← Finset.univ_sum_single z]
      rw [map_sum, Finset.sum_apply]
      apply Finset.sum_congr rfl
      intro k _
      exact (congrArg (fun g : Q.carrier →ₗ[ℂ] Q.carrier => g (z k)) (hc k)).symm
    have hrel : ∑ k, c k • B k = 0 := by
      apply Subtype.ext
      funext n
      ext x y
      have hzero : p (coefficientVector B n x y) = 0 :=
        Submodule.projection_apply_of_mem_right hT.symm (coefficientVector_mem B n x y)
      have hh := congrFun hzero j
      rw [hsum] at hh
      simpa [coefficientVector] using hh
    have hc0 : ∀ k, c k = 0 := (Fintype.linearIndependent_iff.mp hB) c hrel
    simp [hsum, hc0]
  apply top_unique
  intro z _
  have hz : p z = 0 := by rw [hp]; rfl
  exact (Submodule.projection_apply_eq_zero_iff hT.symm).mp hz

end VOA.Huang.AssocConverse
