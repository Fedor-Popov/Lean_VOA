import VOA.Huang.UniformConvGeometric
import VOA.Huang.GenusTwoPointGrowth
import VOA.Huang.TensorCatJointGrowth

/-!
# The uniform estimates in the consumers' forms, from separate equations

Named inputs in Huang's form (separate monic equations, one per variable, coefficients
holomorphic on a polydisc in the relevant sewing chart) for the three stalled
consumers, and the proved implications:

* `ProductSeparateFuchsian → ProductModeGrowth` (genus-one product channel, (G1));
* `IterateSeparateFuchsian → IterateModeGrowth` (genus-one local iterate channel, (G2));
* `FivePointSeparateFuchsian F → FivePointCoefficientGrowth F` (genus-zero three
  intertwiners, (Z3) / pentagon).

The inputs are NOT proved here. They are what Huang's theorems supply (genus zero:
math/0206206, Thms 1.6 and 2.5; genus one: math/0303049, the `z`- and `τ`-equations
with coefficients in the ring generated by Eisenstein series and Weierstrass functions).
Unlike the earlier sufficient criteria `RadialFuchsian` / `RadialEulerControl`, no
radial (total-degree) equation is required: the two equations may be in different
Euler operators, e.g. eigenvalues `λ+n` (`q∂_q`) and `μ+n-k` (`x₁∂_{x₁}`) in the
genus-one product chart.
-/

noncomputable section
namespace VOA.Huang.UniformConv
open VOA VOA.Huang.HuangODEThree
universe u

/-- Two monic equations in Euler operators with integer linear eigenvalue forms of
nonzero determinant, and polydisc coefficient bounds, form a `SeparateSystem`. -/
theorem separateSystem_of_linear {c : ℕ → ℕ → ℂ} {R₁ R₂ G : ℝ} (lam mu : ℂ)
    (a₁ b₁ a₂ b₂ : ℤ) (hdet : a₁ * b₂ - a₂ * b₁ ≠ 0) {s₁ s₂ : ℕ} (hs₁ : 1 ≤ s₁)
    (hs₂ : 1 ≤ s₂) {g₁ g₂ : ℕ → ℕ → ℕ → ℂ}
    (hg₁ : ∀ k < s₁, ∀ i j, ‖g₁ k i j‖ ≤ G * R₁ ^ i * R₂ ^ j)
    (hg₂ : ∀ k < s₂, ∀ i j, ‖g₂ k i j‖ ≤ G * R₁ ^ i * R₂ ^ j)
    (heq₁ : DiagonalFuchsian (fun m n => lam + ((a₁ * m + b₁ * n : ℤ) : ℂ)) s₁ g₁ c)
    (heq₂ : DiagonalFuchsian (fun m n => mu + ((a₂ * m + b₂ * n : ℤ) : ℂ)) s₂ g₂ c) :
    Nonempty (SeparateSystem c R₁ R₂) := by
  obtain ⟨κ, D, hκ, hdom⟩ := dominance_of_linear lam mu a₁ b₁ a₂ b₂ hdet
  obtain ⟨B₁, hB₁, he₁⟩ := growth_of_linear lam a₁ b₁
  obtain ⟨B₂, hB₂, he₂⟩ := growth_of_linear mu a₂ b₂
  have hB : 1 ≤ max B₁ B₂ := le_trans hB₁ (le_max_left _ _)
  have hmono : ∀ (B' : ℝ), B' ≤ max B₁ B₂ → ∀ i j : ℕ,
      B' * (1 + ((i + j : ℕ) : ℝ)) ≤ max B₁ B₂ * (1 + ((i + j : ℕ) : ℝ)) := by
    intro B' hB' i j
    exact mul_le_mul_of_nonneg_right hB' (by positivity)
  exact ⟨SeparateSystem.mk _ _ s₁ s₂ g₁ g₂ G (max B₁ B₂) κ D hs₁ hs₂ hB hκ
    (fun i j => le_trans (he₁ i j) (hmono B₁ (le_max_left _ _) i j))
    (fun i j => le_trans (he₂ i j) (hmono B₂ (le_max_right _ _) i j))
    hdom hg₁ hg₂ heq₁ heq₂⟩

/-- A geometric bound at every rate `a > 1`, specialised to equal rates `√a`. -/
theorem twoLevel_of_sqrt {c : ℕ → ℕ → ℂ} {a R₂ : ℝ} (ha : 1 < a) (hR₂ : 0 < R₂)
    (S : SeparateSystem c (Real.sqrt a) R₂) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ n k, ‖c n k‖ ≤ K * a ^ n * (Real.sqrt a * R₂) ^ k := by
  have hr : 1 < Real.sqrt a := by
    rw [show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_lt_sqrt zero_le_one ha
  obtain ⟨K, hK0, hK⟩ := S.geometric_bound (by linarith) hR₂ (Real.sqrt a) hr
  refine ⟨K, hK0, fun n k => ?_⟩
  have h := hK n k
  rwa [Real.mul_self_sqrt (by linarith)] at h

section GenusOne
open VOA.Huang.GenusTwoPoint
variable {V : Type u} [AddCommGroup V] [Module ℂ V] {W : VertexOperatorAlgebra V}
  {P₁ P₂ N Q : LWModule W}

/-- **Huang's genus-one equations in the product chart.** In the variables
`x = q z₁/z₂` (traced level `n`) and `y = z₂/z₁` (intermediate level `k`), the product
array satisfies two separate monic equations (from the `τ`- and `z₁`-equations) whose
coefficients are holomorphic on the open unit bidisc; for every rate `R > 1` the
coefficient series are bounded by `G_R R^(i+j)`. Intended true for strongly rational
`W`, irreducible modules and homogeneous insertions. NOT proved here. -/
def ProductSeparateFuchsian (Y₁ : IntertwiningOperator P₁.isMod Q.isMod N.isMod)
    (Y₂ : IntertwiningOperator P₂.isMod N.isMod Q.isMod)
    (w₁ : P₁.carrier) (w₂ : P₂.carrier) (α₁ α₂ : ℂ) : Prop :=
  ∀ R : ℝ, 1 < R → Nonempty (SeparateSystem (productLevelCoeff Y₁ Y₂ w₁ w₂ α₁ α₂) R R)

/-- (G1) **Separate genus-one equations give `ProductModeGrowth`.** -/
theorem productModeGrowth_of_separate
    (Y₁ : IntertwiningOperator P₁.isMod Q.isMod N.isMod)
    (Y₂ : IntertwiningOperator P₂.isMod N.isMod Q.isMod)
    (w₁ : P₁.carrier) (w₂ : P₂.carrier) (α₁ α₂ : ℂ)
    (h : ProductSeparateFuchsian Y₁ Y₂ w₁ w₂ α₁ α₂) :
    ProductModeGrowth Y₁ Y₂ w₁ w₂ α₁ α₂ := by
  intro a ha
  have hr : 1 < Real.sqrt a := by
    rw [show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_lt_sqrt zero_le_one ha
  obtain ⟨S⟩ := h (Real.sqrt a) hr
  obtain ⟨K, hK0, hK⟩ := twoLevel_of_sqrt ha (by linarith) S
  refine ⟨K, hK0, fun n k => ?_⟩
  have h := hK n k
  rwa [Real.mul_self_sqrt (by linarith)] at h

/-- (G1) Consequence: product sewing summability in Huang's region. -/
theorem productSummable_of_separate
    (Y₁ : IntertwiningOperator P₁.isMod Q.isMod N.isMod)
    (Y₂ : IntertwiningOperator P₂.isMod N.isMod Q.isMod)
    (w₁ : P₁.carrier) (w₂ : P₂.carrier) (α₁ α₂ : ℂ)
    (h : ProductSeparateFuchsian Y₁ Y₂ w₁ w₂ α₁ α₂)
    {z₁ z₂ : ℂ} (hz₁ : ‖z₁‖ < 1) (hz : ‖z₂‖ < ‖z₁‖)
    (τ : UpperHalfPlane) (hq : ‖qParam τ‖ < ‖z₂‖) :
    ProductSewingSummable Y₁ Y₂ w₁ w₂ α₁ α₂ z₁ z₂ τ ∧
      ProductQSummable Y₁ Y₂ w₁ w₂ α₁ α₂ z₁ z₂ τ :=
  productSummable_in_sewingRegion_of_modeGrowth Y₁ Y₂ w₁ w₂ α₁ α₂
    (productModeGrowth_of_separate Y₁ Y₂ w₁ w₂ α₁ α₂ h) hz₁ hz τ hq

/-- **Huang's genus-one equations in the local iterate chart.** For the traced level
`n` (variable `q`) and the intermediate level `k` (variable `z₀`, the insertion
difference), two separate monic equations with coefficients holomorphic on
`{|q| < 1/R} × {|z₀| < 1/R₂(R)}`; the `z₀`-radius may shrink as the `q`-radius grows.
Intended true (regular singularity at `z₀ = 0`). NOT proved here. -/
def IterateSeparateFuchsian (Y₃ : IntertwiningOperator Q.isMod N.isMod N.isMod)
    (Y₄ : IntertwiningOperator P₁.isMod P₂.isMod Q.isMod)
    (w₁ : P₁.carrier) (w₂ : P₂.carrier) (α₁ α₂ : ℂ) : Prop :=
  ∀ R : ℝ, 1 < R → ∃ R₂ : ℝ, 0 < R₂ ∧
    Nonempty (SeparateSystem (iterateLevelCoeff Y₃ Y₄ w₁ w₂ α₁ α₂) R R₂)

/-- (G2) **Separate local equations give `IterateModeGrowth`.** -/
theorem iterateModeGrowth_of_separate
    (Y₃ : IntertwiningOperator Q.isMod N.isMod N.isMod)
    (Y₄ : IntertwiningOperator P₁.isMod P₂.isMod Q.isMod)
    (w₁ : P₁.carrier) (w₂ : P₂.carrier) (α₁ α₂ : ℂ)
    (h : IterateSeparateFuchsian Y₃ Y₄ w₁ w₂ α₁ α₂) :
    IterateModeGrowth Y₃ Y₄ w₁ w₂ α₁ α₂ := by
  intro a ha
  have hr : 1 < Real.sqrt a := by
    rw [show (1 : ℝ) = Real.sqrt 1 by simp]
    exact Real.sqrt_lt_sqrt zero_le_one ha
  obtain ⟨R₂, hR₂, ⟨S⟩⟩ := h (Real.sqrt a) hr
  obtain ⟨K, hK0, hK⟩ := twoLevel_of_sqrt ha hR₂ S
  exact ⟨K, Real.sqrt a * R₂, hK0, by positivity, hK⟩

/-- (G2) Consequence: a positive local iterate sewing radius. -/
theorem exists_iterateSewingRadius_of_separate
    (Y₃ : IntertwiningOperator Q.isMod N.isMod N.isMod)
    (Y₄ : IntertwiningOperator P₁.isMod P₂.isMod Q.isMod)
    (w₁ : P₁.carrier) (w₂ : P₂.carrier) (α₁ α₂ : ℂ)
    (h : IterateSeparateFuchsian Y₃ Y₄ w₁ w₂ α₁ α₂) (τ : UpperHalfPlane) :
    ∃ δ : ℝ, 0 < δ ∧ δ ≤ 1 ∧ ∀ (z₀ z₂ : ℂ), z₀ ≠ 0 → z₂ ≠ 0 →
      ‖z₀ / z₂‖ < δ → IterateSewingSummable Y₃ Y₄ w₁ w₂ α₁ α₂ z₀ z₂ τ :=
  exists_iterateSewingRadius_of_modeGrowth Y₃ Y₄ w₁ w₂ α₁ α₂
    (iterateModeGrowth_of_separate Y₃ Y₄ w₁ w₂ α₁ α₂ h) τ

end GenusOne

section GenusZero
open VOA.Huang.TensorCat VOA.Huang.FusionUnit VOA.Huang.FusionProduct CategoryTheory
variable {V : Type u} [AddCommGroup V] [Module ℂ V] {W : VertexOperatorAlgebra V}
variable (F : FusionChoice W)

/-- **Huang's genus-zero equations (Thms 1.6, 2.5) in each pentagon chart.** Every actual
five-point array, after removing the chart's coordinate powers, satisfies two separate
monic Euler-type equations with coefficients holomorphic on a polydisc containing the
chart point. Intended true for strongly rational `W`. NOT proved here. -/
def FivePointSeparateFuchsian : Prop :=
  ∀ (X Y Z T U : Ordinary W) (b : FiveTree) (k : fiveObj F X Y Z T b ⟶ U)
    (d : FivePointTest X Y Z T U) (h h' : ℂ),
    LocalSeparateSolution (fun m n => fivePointTerm F b k d (h + m, h' + n))

/-- (Z3) **Separate genus-zero equations give `FivePointCoefficientGrowth`.** -/
theorem fivePointCoefficientGrowth_of_separate (hs : FivePointSeparateFuchsian F) :
    FivePointCoefficientGrowth F :=
  fun X Y Z T U b k d h h' => (hs X Y Z T U b k d h h').localJointGrowth

/-- (Z3) Consequence: the five-point norm growth required by the pentagon assembly. -/
theorem fivePointNormGrowth_of_separate_pbw (hV : StronglyRational W)
    (hs : FivePointSeparateFuchsian F) : FivePointNormGrowth F :=
  fivePointNormGrowth_of_coefficientGrowth_pbw F hV (fivePointCoefficientGrowth_of_separate F hs)

end GenusZero

end VOA.Huang.UniformConv
