import VOA.Huang.HuangODEModes

/-!
# Huang's equation for products of intertwining operators (products)

Huang, *Differential equations and intertwining operators*, CCM 7 (2005), Thms 1.4 and 2.3 (at the
singular point `z₂ = 0`, which the paper leaves as "similar") and the degree-0 reduction, in a
**direct one-variable form**: no module `T/J` over `ℂ[z₁^{±1}, z₂^{±1}, (z₁−z₂)^{−1}]` is built;
the relations `φ(𝒜) = φ(ℬ) = φ(𝒞) = φ(𝒟) = 0` are proved directly as identities of power series in
`x = z₂/z₁` with coefficients in `ℂ[x, (1 − x)⁻¹]` (`ratRing 1`).

## The normalization (where the regularity comes from)

For a tuple `(f, w₁, w₂, w₃)` with `wᵢ` of level `Nᵢ` above the lowest weight `hᵢ` and `f` read on
the weight space `h₄ + N₄`, total level `s = N₁ + N₂ + N₃ + N₄`, put
`QT = Σₙ f(𝒴₁(w₁)₍c−ν−2N₄+n₎ 𝒴₂(w₂)₍ν+s−n₎ w₃) xⁿ` (`c = h₁+h₂+h₃−h₄−2`, `ν` a uniform base).
Dividing by `x^{s}` is Huang's `z₂^{σ+S}` of Lemma 2.2 (his `F^{(z₂=0)}` filtration counts the pole
order in `z₂` plus the total weight): with it, **every** generator relation has coefficients
`xᵉ` (`e ≥ 0`), `x · Σᵢ C(i,k) xⁱ = x^{k+1}(1−x)^{−k−1}` or constants — never `x⁻¹`.
A naive normalization by `N₂ + N₃` only (the weights at `z₂`) produces `x^{i+1−d}` in the `𝒜`-move.

## Main results
* `moveA`, `moveB`, `moveC`, `moveD` — the four regular relations (Huang's `𝒜, ℬ, 𝒞, 𝒟`;
  `𝒟` in the form `f = g ∘ u₍ₘ₎`, `m ≥ 2 wt u − 1`, the shape of the contragredient `u₋₁`).
* `qt_mem` — Huang's Prop. 1.1/2.1: every `QT` lies in the `ratRing 1`-module generated by the
  tuples of bounded levels, under `C1Graded` (`W₁, W₂, W₃`) and `DualC1Graded` (`W₄`).
* `exists_finite_span` — at fixed levels finitely many tuples suffice (bases of weight spaces).
* `QT_Lm1` — `L₋₁` on `w₂` is the twisted Euler operator `θ`; `exists_unifBase` (`M₅` bounded below).
* `ratFuchsian_prodSeries_of_C1` — **the coset series of a product satisfies a monic
  `θ_λ`-equation with coefficients in `ℂ[x, (1−x)⁻¹]`** (any `M₅`, any `f`, any `λ`).
* `huangProductODE_of_moduleC1Data` — `ModuleC1Data W → HuangProductODE W`.

## Status
No `sorry`, no new axioms.  Conditional only on the graded `C₁`-data `ModuleC1Data` (TRUE for
strongly rational `V`; reduced further in `Huang/HuangODEC1.lean`).
-/

namespace VOA.Huang.HuangODEProduct

open VOA PowerSeries VOA.Huang.FuchsianODE VOA.Huang.Convergence VOA.Huang.HuangODEAlgebra
  VOA.Huang.HuangODEModes VOA.Huang.MatrixCoeff
open scoped BigOperators

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}

/-! ## Finite sums -/

/-- Trimming a `Finset.range` sum whose terms vanish from `J` on. -/
theorem sum_range_trim {X : Type*} [AddCommMonoid X] {g : ℕ → X} {J I : ℕ} (hJI : J ≤ I)
    (h : ∀ i, J ≤ i → g i = 0) : ∑ i ∈ Finset.range I, g i = ∑ i ∈ Finset.range J, g i := by
  symm
  apply Finset.sum_subset (Finset.range_subset_range.mpr hJI)
  intro i _ hni
  simp only [Finset.mem_range, not_lt] at hni
  exact h i hni

/-! ## Weights below the lowest weight -/

section Lowest

variable {M : Type u} [AddCommGroup M] [Module ℂ M] {A : OrdVModule W M} {h : ℂ}

/-- A vector whose weight lies strictly below the lowest weight vanishes. -/
theorem eq_zero_of_mem_weight_neg (hl : IsLowestWeight A h) {x : M} {β : ℂ}
    (hx : x ∈ A.weight β) {j : ℤ} (hβ : β = h + j) (hj : j < 0) : x = 0 := by
  by_contra hne
  have hbot : A.weight β ≠ ⊥ := fun hb => hne (by
    rw [hb] at hx; exact (Submodule.mem_bot ℂ).mp hx)
  obtain ⟨n, hn⟩ := hl β hbot
  rw [hβ] at hn
  have h1 : ((j : ℤ) : ℂ) = ((n : ℤ) : ℂ) := by push_cast; linear_combination hn
  have h2 : j = (n : ℤ) := by exact_mod_cast h1
  omega

/-- Modes of a weight-`d` vector that would land below the lowest weight vanish. -/
theorem mode_eq_zero_of_le (hl : IsLowestWeight A h) {d N : ℕ} {u : 𝒱}
    (hu : u ∈ W.grading (d : ℤ)) {w : M} (hw : w ∈ A.weight (h + N)) {k : ℤ}
    (hk : (N : ℤ) + d ≤ k) : mode (A.YM u) k w = 0 :=
  eq_zero_of_mem_weight_neg hl (mode_mem_weight A hu hw k) (j := N + d - k - 1)
    (by push_cast; ring) (by omega)

/-- The weight of `u₍ₖ₎ w` as a natural level above the lowest weight. -/
theorem mode_mem_weight_nat {d N : ℕ} {u : 𝒱} (hu : u ∈ W.grading (d : ℤ)) {w : M}
    (hw : w ∈ A.weight (h + N)) {k : ℕ} (hk : k < N + d) :
    mode (A.YM u) (k : ℤ) w ∈ A.weight (h + ((N + d - (k + 1) : ℕ) : ℂ)) := by
  have hm := mode_mem_weight A hu hw (k : ℤ)
  have e : h + (N : ℂ) + ((d : ℤ) : ℂ) - ((k : ℤ) : ℂ) - 1
      = h + ((N + d - (k + 1) : ℕ) : ℂ) := by
    rw [Nat.cast_sub (by omega)]; push_cast; ring
  rw [e] at hm
  exact hm

/-- The weight of `u₋₁ w`. -/
theorem mode_neg_one_mem_weight {d N : ℕ} {u : 𝒱} (hu : u ∈ W.grading (d : ℤ)) {w : M}
    (hw : w ∈ A.weight (h + N)) :
    mode (A.YM u) (-1) w ∈ A.weight (h + ((N + d : ℕ) : ℂ)) := by
  have hm := mode_mem_weight A hu hw (-1)
  have e : h + (N : ℂ) + ((d : ℤ) : ℂ) - ((-1 : ℤ) : ℂ) - 1 = h + ((N + d : ℕ) : ℂ) := by
    push_cast; ring
  rw [e] at hm
  exact hm

end Lowest

/-! ## The normalized series of a product -/

section Product

variable {M₁ M₂ M₃ M₄ M₅ : Type u}
  [AddCommGroup M₁] [Module ℂ M₁] [AddCommGroup M₂] [Module ℂ M₂]
  [AddCommGroup M₃] [Module ℂ M₃] [AddCommGroup M₄] [Module ℂ M₄]
  [AddCommGroup M₅] [Module ℂ M₅]
  {A₁ : OrdVModule W M₁} {A₂ : OrdVModule W M₂} {A₃ : OrdVModule W M₃}
  {A₄ : OrdVModule W M₄} {A₅ : OrdVModule W M₅}
  {Y₁ : IntertwiningModes M₁ M₅ M₄} {Y₂ : IntertwiningModes M₂ M₃ M₅}

/-- `Σ_n f(𝒴₁(w₁)₍ₐ₊ₙ₎ 𝒴₂(w₂)₍ᵦ₋ₙ₎ w₃) xⁿ`. -/
noncomputable def prodQ (Y₁ : IntertwiningModes M₁ M₅ M₄) (Y₂ : IntertwiningModes M₂ M₃ M₅)
    (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (a b : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun n => f (Y₁ (a + n) w₁ (Y₂ (b - n) w₂ w₃))

theorem coeff_prodQ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (a b : ℂ) (n : ℕ) :
    coeff n (prodQ Y₁ Y₂ f w₁ w₂ w₃ a b) = f (Y₁ (a + n) w₁ (Y₂ (b - n) w₂ w₃)) :=
  coeff_mk _ _

/-- Coefficients of `xᵉ · prodQ`, given a base at `b`. -/
theorem coeff_X_pow_mul_prodQ {f : M₄ →ₗ[ℂ] ℂ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃} {a b : ℂ}
    (hb : IsBase Y₂ w₂ w₃ b) (e n : ℕ) :
    coeff n (X ^ e * prodQ Y₁ Y₂ f w₁ w₂ w₃ a b)
      = f (Y₁ (a + n - e) w₁ (Y₂ (b - n + e) w₂ w₃)) := by
  rw [coeff_X_pow_mul']
  split_ifs with h
  · rw [coeff_prodQ]
    have e1 : a + ((n - e : ℕ) : ℂ) = a + n - e := by rw [Nat.cast_sub h]; ring
    have e2 : b - ((n - e : ℕ) : ℂ) = b - n + e := by rw [Nat.cast_sub h]; ring
    rw [e1, e2]
  · have e3 : b - n + e = b + (((e - n - 1 : ℕ) : ℂ) + 1) := by
      rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega)]; push_cast; ring
    rw [e3, hb, map_zero, map_zero]

/-- Coefficients of `x · (Σ_i C(i,k) xⁱ) · prodQ` as a finite sum, given a base at `b`. -/
theorem coeff_X_mul_binom_mul_prodQ {f : M₄ →ₗ[ℂ] ℂ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃} {a b : ℂ}
    (hb : IsBase Y₂ w₂ w₃ b) (k n I : ℕ) (hI : n < I) :
    coeff n (X * HuangODEAlgebra.binomSeries 1 k * prodQ Y₁ Y₂ f w₁ w₂ w₃ a b)
      = ∑ i ∈ Finset.range I, (i.choose k : ℂ) *
          f (Y₁ (a + n - 1 - i) w₁ (Y₂ (b - n + 1 + i) w₂ w₃)) := by
  have e : X * HuangODEAlgebra.binomSeries 1 k * prodQ Y₁ Y₂ f w₁ w₂ w₃ a b
      = HuangODEAlgebra.binomSeries 1 k * X ^ 1 * prodQ Y₁ Y₂ f w₁ w₂ w₃ a b := by ring
  rw [e, HuangODEAlgebra.binomSeries, coeff_conv _ _ _ hI]
  refine Finset.sum_congr rfl fun i _ => ?_
  split_ifs with h
  · rw [one_pow, mul_one, coeff_prodQ]
    have e1 : a + ((n - 1 - i : ℕ) : ℂ) = a + n - 1 - i := by
      rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega)]; push_cast; ring
    have e2 : b - ((n - 1 - i : ℕ) : ℂ) = b - n + 1 + i := by
      rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega)]; push_cast; ring
    rw [e1, e2]
  · have e3 : b - n + 1 + i = b + (((i - n : ℕ) : ℂ) + 1) := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e3, hb, map_zero, map_zero, mul_zero]

theorem prodQ_congr {f : M₄ →ₗ[ℂ] ℂ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃} {p p' q q' : ℂ}
    (hp : p = p') (hq : q = q') :
    f (Y₁ p w₁ (Y₂ q w₂ w₃)) = f (Y₁ p' w₁ (Y₂ q' w₂ w₃)) := by
  rw [hp, hq]

/-- The vector of a product lies on one weight. -/
theorem prod_mem_weight (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) {α₁ α₂ α₃ : ℂ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃}
    (h₁ : w₁ ∈ A₁.weight α₁) (h₂ : w₂ ∈ A₂.weight α₂) (h₃ : w₃ ∈ A₃.weight α₃) (p q : ℂ) :
    Y₁ p w₁ (Y₂ q w₂ w₃) ∈ A₄.weight (α₁ + α₂ + α₃ - p - q - 2) := by
  have hin := VOA.Huang.FusionTop.mem_weight hY₂ h₂ h₃ q
  have hout := VOA.Huang.FusionTop.mem_weight hY₁ h₁ hin p
  have e : α₁ + (α₂ + α₃ - q - 1) - p - 1 = α₁ + α₂ + α₃ - p - q - 2 := by ring
  rw [e] at hout
  exact hout

/-- **Uniform base**: `ν + N₂ + N₃` is a base of `𝒴₂` at every pair of homogeneous vectors of
levels `N₂, N₃` (holds for `Re ν ≫ 0` since `M₅` is bounded below: `exists_unifBase`). -/
def UnifBase (A₂ : OrdVModule W M₂) (A₃ : OrdVModule W M₃) (Y₂ : IntertwiningModes M₂ M₃ M₅)
    (h₂ h₃ ν : ℂ) : Prop :=
  ∀ (N₂ N₃ : ℕ) (w₂ : M₂) (w₃ : M₃), w₂ ∈ A₂.weight (h₂ + N₂) → w₃ ∈ A₃.weight (h₃ + N₃) →
    IsBase Y₂ w₂ w₃ (ν + N₂ + N₃)

theorem UnifBase.base {h₂ h₃ ν : ℂ} (hUB : UnifBase A₂ A₃ Y₂ h₂ h₃ ν) {N₂ N₃ : ℕ} {w₂ : M₂}
    {w₃ : M₃} (hw₂ : w₂ ∈ A₂.weight (h₂ + N₂)) (hw₃ : w₃ ∈ A₃.weight (h₃ + N₃)) {s : ℕ}
    (hs : N₂ + N₃ ≤ s) : IsBase Y₂ w₂ w₃ (ν + s) := by
  have hb := (hUB N₂ N₃ w₂ w₃ hw₂ hw₃).add_nat (s - (N₂ + N₃))
  have e : ν + (N₂ : ℂ) + N₃ + ((s - (N₂ + N₃) : ℕ) : ℂ) = ν + s := by
    rw [Nat.cast_sub hs]; push_cast; ring
  rwa [e] at hb

/-- The normalized series of the tuple `(f, w₁, w₂, w₃)` at levels `(N₁, N₂, N₃, N₄)`, total level
`s = N₁ + N₂ + N₃ + N₄`: `Σ_n f(𝒴₁(w₁)₍c−ν−2N₄+n₎ 𝒴₂(w₂)₍ν+s−n₎ w₃) xⁿ`
(`c = h₁ + h₂ + h₃ − h₄ − 2`).  It is `x^{s+K}` times the coset series `prodSeries`. -/
noncomputable def QT (Y₁ : IntertwiningModes M₁ M₅ M₄) (Y₂ : IntertwiningModes M₂ M₃ M₅)
    (c ν : ℂ) (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (N₄ s : ℕ) : PowerSeries ℂ :=
  prodQ Y₁ Y₂ f w₁ w₂ w₃ (c - ν - 2 * N₄) (ν + s)

section Moves

variable {h₁ h₂ h₃ h₄ ν : ℂ}

/-- **Move `𝒜`** (outer vector `u₋₁w₁`, Huang's `𝒜`): a regular relation. -/
theorem moveA (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (hl₂ : IsLowestWeight A₂ h₂)
    (hl₃ : IsLowestWeight A₃ h₃) (hl₄ : IsLowestWeight A₄ h₄)
    (hUB : UnifBase A₂ A₃ Y₂ h₂ h₃ ν) {d : ℕ} {u : 𝒱} (hu : u ∈ W.grading (d : ℤ))
    (f : M₄ →ₗ[ℂ] ℂ) {N₁ N₂ N₃ N₄ : ℕ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃}
    (hw₁ : w₁ ∈ A₁.weight (h₁ + N₁)) (hw₂ : w₂ ∈ A₂.weight (h₂ + N₂))
    (hw₃ : w₃ ∈ A₃.weight (h₃ + N₃)) :
    QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f (mode (A₁.YM u) (-1) w₁) w₂ w₃ N₄
        (N₁ + d + N₂ + N₃ + N₄)
      = ∑ i ∈ Finset.range (N₄ + 1 - d), X ^ (2 * d + i) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν (f ∘ₗ mode (A₄.YM u) (-1 - (i : ℤ))) w₁ w₂ w₃
            (N₄ - (d + i)) (N₁ + N₂ + N₃ + (N₄ - (d + i)))
        + ∑ i ∈ Finset.range (N₃ + d), X ^ (i + 1) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ (mode (A₃.YM u) (i : ℤ) w₃) N₄
            (N₁ + N₂ + (N₃ + d - (i + 1)) + N₄)
        + ∑ k ∈ Finset.range (N₂ + d), X * HuangODEAlgebra.binomSeries 1 k *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ (mode (A₂.YM u) (k : ℤ) w₂) w₃ N₄
            (N₁ + (N₂ + d - (k + 1)) + N₃ + N₄) := by
  ext n
  rw [map_add, map_add, map_sum, map_sum, map_sum, QT, coeff_prodQ]
  obtain ⟨T₁, hT₁⟩ := hY₁.truncation w₁
    (Y₂ (ν + ((N₁ + d + N₂ + N₃ + N₄ : ℕ) : ℂ) - n) w₂ w₃)
    (h₁ + h₂ + h₃ - h₄ - 2 - ν - 2 * N₄ + n)
  obtain ⟨T₂, hT₂⟩ := A₅.truncation u (Y₂ (ν + ((N₁ + d + N₂ + N₃ + N₄ : ℕ) : ℂ) - n) w₂ w₃)
  have hT₁' := Int.self_le_toNat T₁
  have hT₂' := Int.self_le_toNat T₂
  rw [prod_slot1 hY₁ hY₂ u f w₁ w₂ w₃ _ _ (N₂ + d) (T₁.toNat + T₂.toNat + n + N₄ + N₃ + d + 1)
    (fun k hk => mode_eq_zero_of_le hl₂ hu hw₂ (by push_cast at hk ⊢; omega))
    (fun i hi => ⟨hT₁ i (by push_cast at hi; omega), hT₂ i (by push_cast at hi; omega)⟩)]
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
  refine congrArg₂ (· + ·) (congrArg₂ (· + ·) ?_ ?_) ?_
  · rw [sum_range_trim (J := N₄ + 1 - d) (by omega) (fun i hi => by
      rw [eq_zero_of_mem_weight_neg hl₄ (prod_mem_weight hY₁ hY₂ hw₁ hw₂ hw₃ _ _)
        (j := (N₄ : ℤ) - d - i) (by push_cast; ring) (by omega), map_zero, map_zero])]
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [Finset.mem_range] at hi
    rw [QT, coeff_X_pow_mul_prodQ (hUB.base hw₂ hw₃ (by omega)), LinearMap.comp_apply]
    obtain ⟨r, rfl⟩ : ∃ r, N₄ = d + i + r := ⟨N₄ - (d + i), by omega⟩
    have e : d + i + r - (d + i) = r := by omega
    rw [e]
    congr 3 <;> push_cast <;> ring
  · rw [sum_range_trim (J := N₃ + d) (by omega) (fun i hi => by
      rw [mode_eq_zero_of_le hl₃ hu hw₃ (by omega), map_zero, map_zero, map_zero])]
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [Finset.mem_range] at hi
    rw [QT, coeff_X_pow_mul_prodQ (hUB.base hw₂ (mode_mem_weight_nat hu hw₃ hi) (by omega))]
    obtain ⟨r, hr⟩ : ∃ r, N₃ + d = i + 1 + r := ⟨N₃ + d - (i + 1), by omega⟩
    have e : N₃ + d - (i + 1) = r := by omega
    rw [e]
    have hr' : (N₃ : ℂ) + d = i + 1 + r := by exact_mod_cast hr
    exact prodQ_congr (by push_cast; ring) (by push_cast; linear_combination hr')
  · rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    rw [QT, coeff_X_mul_binom_mul_prodQ (hUB.base (mode_mem_weight_nat hu hw₂ hk) hw₃
      (by omega)) k n (T₁.toNat + T₂.toNat + n + N₄ + N₃ + d + 1) (by omega)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [cbz_nat]
    obtain ⟨r, hr⟩ : ∃ r, N₂ + d = k + 1 + r := ⟨N₂ + d - (k + 1), by omega⟩
    have e : N₂ + d - (k + 1) = r := by omega
    rw [e]
    have hr' : (N₂ : ℂ) + d = k + 1 + r := by exact_mod_cast hr
    exact congrArg _ (prodQ_congr (by push_cast; ring) (by push_cast; linear_combination hr'))

/-- **Move `ℬ`** (inner vector `u₋₁w₂`, Huang's `ℬ`): a regular relation. -/
theorem moveB (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (hl₁ : IsLowestWeight A₁ h₁)
    (hl₃ : IsLowestWeight A₃ h₃) (hl₄ : IsLowestWeight A₄ h₄)
    (hUB : UnifBase A₂ A₃ Y₂ h₂ h₃ ν) {d : ℕ} {u : 𝒱} (hu : u ∈ W.grading (d : ℤ))
    (f : M₄ →ₗ[ℂ] ℂ) {N₁ N₂ N₃ N₄ : ℕ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃}
    (hw₁ : w₁ ∈ A₁.weight (h₁ + N₁)) (hw₂ : w₂ ∈ A₂.weight (h₂ + N₂))
    (hw₃ : w₃ ∈ A₃.weight (h₃ + N₃)) :
    QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ (mode (A₂.YM u) (-1) w₂) w₃ N₄
        (N₁ + N₂ + d + N₃ + N₄)
      = ∑ i ∈ Finset.range (N₄ + 1 - d), X ^ (2 * d + 2 * i) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν (f ∘ₗ mode (A₄.YM u) (-1 - (i : ℤ))) w₁ w₂ w₃
            (N₄ - (d + i)) (N₁ + N₂ + N₃ + (N₄ - (d + i)))
        - ∑ k ∈ Finset.range (N₁ + d), ((-1 : ℂ) ^ k) • (X * HuangODEAlgebra.binomSeries 1 k *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f (mode (A₁.YM u) (k : ℤ) w₁) w₂ w₃ N₄
            (N₁ + d - (k + 1) + N₂ + N₃ + N₄))
        + ∑ i ∈ Finset.range (N₃ + d),
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ (mode (A₃.YM u) (i : ℤ) w₃) N₄
            (N₁ + N₂ + (N₃ + d - (i + 1)) + N₄) := by
  ext n
  rw [map_add, map_sub, map_sum, map_sum, map_sum, QT, coeff_prodQ]
  obtain ⟨T, hT⟩ := hY₂.truncation w₂ w₃ (ν + ((N₁ + N₂ + d + N₃ + N₄ : ℕ) : ℂ) - n)
  have hT' := Int.self_le_toNat T
  rw [prod_slot2 hY₁ hY₂ u f w₁ w₂ w₃ _ _ (N₁ + d) (T.toNat + n + N₄ + N₃ + d + 1)
    (fun k hk => mode_eq_zero_of_le hl₁ hu hw₁ (by push_cast at hk ⊢; omega))
    (fun i hi => ⟨hT i (by push_cast at hi; omega),
      mode_eq_zero_of_le hl₃ hu hw₃ (by push_cast at hi ⊢; omega)⟩)]
  rw [Finset.sum_add_distrib, Finset.sum_sub_distrib]
  refine congrArg₂ (· + ·) (congrArg₂ (· - ·) ?_ ?_) ?_
  · rw [sum_range_trim (J := N₄ + 1 - d) (by omega) (fun i hi => by
      rw [eq_zero_of_mem_weight_neg hl₄ (prod_mem_weight hY₁ hY₂ hw₁ hw₂ hw₃ _ _)
        (j := (N₄ : ℤ) - d - i) (by push_cast; ring) (by omega), map_zero, map_zero])]
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [Finset.mem_range] at hi
    rw [QT, coeff_X_pow_mul_prodQ (hUB.base hw₂ hw₃ (by omega)), LinearMap.comp_apply]
    obtain ⟨r, rfl⟩ : ∃ r, N₄ = d + i + r := ⟨N₄ - (d + i), by omega⟩
    have e : d + i + r - (d + i) = r := by omega
    rw [e]
    congr 3 <;> push_cast <;> ring
  · rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    rw [map_smul, QT, coeff_X_mul_binom_mul_prodQ (hUB.base hw₂ hw₃ (by omega)) k n
      (k + (T.toNat + n + N₄ + N₃ + d + 1)) (by omega),
      Finset.sum_range_add _ k (T.toNat + n + N₄ + N₃ + d + 1)]
    rw [Finset.sum_eq_zero (s := Finset.range k) (fun j hj => by
      simp only [Finset.mem_range] at hj
      rw [Nat.choose_eq_zero_of_lt hj, Nat.cast_zero, zero_mul]), zero_add, smul_eq_mul,
      Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [cbz_neg_one_sub, add_comm k i, mul_assoc]
    obtain ⟨r, hr⟩ : ∃ r, N₁ + d = k + 1 + r := ⟨N₁ + d - (k + 1), by omega⟩
    have e : N₁ + d - (k + 1) = r := by omega
    rw [e]
    have hr' : (N₁ : ℂ) + d = k + 1 + r := by exact_mod_cast hr
    exact congrArg _ (congrArg _ (prodQ_congr (by push_cast; ring)
      (by push_cast; linear_combination hr')))
  · rw [sum_range_trim (J := N₃ + d) (by omega) (fun i hi => by
      rw [mode_eq_zero_of_le hl₃ hu hw₃ (by omega), map_zero, map_zero, map_zero])]
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [Finset.mem_range] at hi
    rw [QT, coeff_prodQ]
    obtain ⟨r, hr⟩ : ∃ r, N₃ + d = i + 1 + r := ⟨N₃ + d - (i + 1), by omega⟩
    have e : N₃ + d - (i + 1) = r := by omega
    rw [e]
    have hr' : (N₃ : ℂ) + d = i + 1 + r := by exact_mod_cast hr
    exact prodQ_congr (by push_cast; ring) (by push_cast; linear_combination hr')

theorem cbz_neg_one_nat (k : ℕ) : cbz (-1) (k : ℤ) = (-1 : ℂ) ^ k := by
  have h := cbz_neg_one_sub 0 k
  simpa using h

/-- **Move `𝒞`** (innermost vector `u₋₁w₃`, Huang's `𝒞`): a regular relation. -/
theorem moveC (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (hl₁ : IsLowestWeight A₁ h₁)
    (hl₂ : IsLowestWeight A₂ h₂) (hl₄ : IsLowestWeight A₄ h₄)
    (hUB : UnifBase A₂ A₃ Y₂ h₂ h₃ ν) {d : ℕ} {u : 𝒱} (hu : u ∈ W.grading (d : ℤ))
    (f : M₄ →ₗ[ℂ] ℂ) {N₁ N₂ N₃ N₄ : ℕ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃}
    (hw₁ : w₁ ∈ A₁.weight (h₁ + N₁)) (hw₂ : w₂ ∈ A₂.weight (h₂ + N₂))
    (hw₃ : w₃ ∈ A₃.weight (h₃ + N₃)) :
    QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ (mode (A₃.YM u) (-1) w₃) N₄
        (N₁ + N₂ + N₃ + d + N₄)
      = (if d ≤ N₄ then X ^ (2 * d) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν (f ∘ₗ mode (A₄.YM u) (-1)) w₁ w₂ w₃
            (N₄ - d) (N₁ + N₂ + N₃ + (N₄ - d)) else 0)
        - ∑ k ∈ Finset.range (N₁ + d), ((-1 : ℂ) ^ k) • (X ^ (k + 1) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f (mode (A₁.YM u) (k : ℤ) w₁) w₂ w₃ N₄
            (N₁ + d - (k + 1) + N₂ + N₃ + N₄))
        - ∑ k ∈ Finset.range (N₂ + d), ((-1 : ℂ) ^ k) •
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ (mode (A₂.YM u) (k : ℤ) w₂) w₃ N₄
            (N₁ + (N₂ + d - (k + 1)) + N₃ + N₄) := by
  ext n
  rw [map_sub, map_sub, map_sum, map_sum, QT, coeff_prodQ]
  rw [prod_slot3 hY₁ hY₂ u f w₁ w₂ w₃ _ _ (N₁ + N₂ + d)
    (fun k hk => mode_eq_zero_of_le hl₁ hu hw₁ (by push_cast at hk ⊢; omega))
    (fun k hk => mode_eq_zero_of_le hl₂ hu hw₂ (by push_cast at hk ⊢; omega))]
  refine congrArg₂ (· - ·) (congrArg₂ (· - ·) ?_ ?_) ?_
  · split_ifs with hd
    · rw [QT, coeff_X_pow_mul_prodQ (hUB.base hw₂ hw₃ (by omega)), LinearMap.comp_apply]
      obtain ⟨r, rfl⟩ : ∃ r, N₄ = d + r := ⟨N₄ - d, by omega⟩
      have e : d + r - d = r := by omega
      rw [e]
      congr 3 <;> push_cast <;> ring
    · rw [map_zero, eq_zero_of_mem_weight_neg hl₄ (prod_mem_weight hY₁ hY₂ hw₁ hw₂ hw₃ _ _)
        (j := (N₄ : ℤ) - d) (by push_cast; ring) (by omega), map_zero, map_zero]
  · rw [sum_range_trim (J := N₁ + d) (by omega) (fun k hk => by
      rw [mode_eq_zero_of_le hl₁ hu hw₁ (by omega), map_zero, LinearMap.zero_apply,
        map_zero, mul_zero])]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    rw [map_smul, QT, coeff_X_pow_mul_prodQ (hUB.base hw₂ hw₃ (by omega)), cbz_neg_one_nat,
      smul_eq_mul]
    obtain ⟨r, hr⟩ : ∃ r, N₁ + d = k + 1 + r := ⟨N₁ + d - (k + 1), by omega⟩
    have e : N₁ + d - (k + 1) = r := by omega
    rw [e]
    have hr' : (N₁ : ℂ) + d = k + 1 + r := by exact_mod_cast hr
    exact congrArg _ (prodQ_congr (by push_cast; ring) (by push_cast; linear_combination hr'))
  · rw [sum_range_trim (J := N₂ + d) (by omega) (fun k hk => by
      rw [mode_eq_zero_of_le hl₂ hu hw₂ (by omega), map_zero, LinearMap.zero_apply,
        map_zero, map_zero, mul_zero])]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    rw [map_smul, QT, coeff_prodQ, cbz_neg_one_nat, smul_eq_mul]
    obtain ⟨r, hr⟩ : ∃ r, N₂ + d = k + 1 + r := ⟨N₂ + d - (k + 1), by omega⟩
    have e : N₂ + d - (k + 1) = r := by omega
    rw [e]
    have hr' : (N₂ : ℂ) + d = k + 1 + r := by exact_mod_cast hr
    exact congrArg _ (prodQ_congr (by push_cast; ring) (by push_cast; linear_combination hr'))

/-- The mode identity behind Huang's `𝒟`: a mode `u₍ₘ₎` on the functional moves through both
operators (two commutator formulas). -/
theorem prod_slot0 (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (u : 𝒱) (g : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂)
    (w₃ : M₃) (p q : ℂ) (m : ℤ) (K : ℕ) (hK₁ : ∀ k : ℤ, (K : ℤ) ≤ k → mode (A₁.YM u) k w₁ = 0)
    (hK₂ : ∀ k : ℤ, (K : ℤ) ≤ k → mode (A₂.YM u) k w₂ = 0) :
    g (mode (A₄.YM u) m (Y₁ p w₁ (Y₂ q w₂ w₃)))
      = g (Y₁ p w₁ (Y₂ q w₂ (mode (A₃.YM u) m w₃)))
        + ∑ k ∈ Finset.range K, cbz m k * g (Y₁ p w₁ (Y₂ (m + q - k) (mode (A₂.YM u) k w₂) w₃))
        + ∑ k ∈ Finset.range K, cbz m k * g (Y₁ (m + p - k) (mode (A₁.YM u) k w₁)
            (Y₂ q w₂ w₃)) := by
  have h1 := comm_range hY₁ u w₁ (Y₂ q w₂ w₃) m p K hK₁
  have h2 := comm_range hY₂ u w₂ w₃ m q K hK₂
  have h1' : mode (A₄.YM u) m (Y₁ p w₁ (Y₂ q w₂ w₃))
      = Y₁ p w₁ (mode (A₅.YM u) m (Y₂ q w₂ w₃))
        + ∑ k ∈ Finset.range K, cbz m k • Y₁ (m + p - k) (mode (A₁.YM u) k w₁) (Y₂ q w₂ w₃) := by
    rw [h1]; abel
  have h2' : mode (A₅.YM u) m (Y₂ q w₂ w₃)
      = Y₂ q w₂ (mode (A₃.YM u) m w₃)
        + ∑ k ∈ Finset.range K, cbz m k • Y₂ (m + q - k) (mode (A₂.YM u) k w₂) w₃ := by
    rw [h2]; abel
  rw [h1', h2']
  simp only [map_add, map_sum, map_smul, smul_eq_mul]

/-- **Move `𝒟`** (the functional is `g ∘ u₍ₘ₎` with `m ≥ 2 wt u − 1`, the shape of the
contragredient `u₋₁`, Huang's `𝒟`): a regular relation. -/
theorem moveD (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (hl₁ : IsLowestWeight A₁ h₁)
    (hl₂ : IsLowestWeight A₂ h₂) (hl₃ : IsLowestWeight A₃ h₃)
    (hUB : UnifBase A₂ A₃ Y₂ h₂ h₃ ν) {d m : ℕ} (hm : 2 * d ≤ m + 1) {u : 𝒱}
    (hu : u ∈ W.grading (d : ℤ)) (g : M₄ →ₗ[ℂ] ℂ) {N₁ N₂ N₃ N₄ : ℕ} {w₁ : M₁} {w₂ : M₂}
    {w₃ : M₃} (hw₁ : w₁ ∈ A₁.weight (h₁ + N₁)) (hw₂ : w₂ ∈ A₂.weight (h₂ + N₂))
    (hw₃ : w₃ ∈ A₃.weight (h₃ + N₃)) :
    QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν (g ∘ₗ mode (A₄.YM u) (m : ℤ)) w₁ w₂ w₃
        (N₄ + (m + 1 - d)) (N₁ + N₂ + N₃ + N₄ + (m + 1 - d))
      = (if m + 1 - d ≤ N₃ then X ^ (2 * (m + 1 - d)) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν g w₁ w₂ (mode (A₃.YM u) (m : ℤ) w₃) N₄
            (N₁ + N₂ + (N₃ - (m + 1 - d)) + N₄) else 0)
        + ∑ j ∈ Finset.range (N₂ + d), ((m.choose j : ℂ)) • (X ^ (2 * (m + 1 - d)) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν g w₁ (mode (A₂.YM u) (j : ℤ) w₂) w₃ N₄
            (N₁ + (N₂ + d - (j + 1)) + N₃ + N₄))
        + ∑ j ∈ Finset.range (N₁ + d), ((m.choose j : ℂ)) • (X ^ (m + 2 + j - 2 * d) *
          QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν g (mode (A₁.YM u) (j : ℤ) w₁) w₂ w₃ N₄
            (N₁ + d - (j + 1) + N₂ + N₃ + N₄)) := by
  ext n
  rw [map_add, map_add, map_sum, map_sum, QT, coeff_prodQ, LinearMap.comp_apply]
  rw [prod_slot0 hY₁ hY₂ u g w₁ w₂ w₃ _ _ (m : ℤ) (N₁ + N₂ + d)
    (fun k hk => mode_eq_zero_of_le hl₁ hu hw₁ (by push_cast at hk ⊢; omega))
    (fun k hk => mode_eq_zero_of_le hl₂ hu hw₂ (by push_cast at hk ⊢; omega))]
  obtain ⟨e₀, he₀⟩ : ∃ e₀, m + 1 = d + e₀ := ⟨m + 1 - d, by omega⟩
  have hme : m + 1 - d = e₀ := by omega
  have he₀' : (m : ℂ) + 1 = d + e₀ := by exact_mod_cast he₀
  simp only [hme]
  refine congrArg₂ (· + ·) (congrArg₂ (· + ·) ?_ ?_) ?_
  · split_ifs with h3
    · rw [QT, coeff_X_pow_mul_prodQ (hUB.base hw₂
        (by
          have hm3 := mode_mem_weight A₃ hu hw₃ (m : ℤ)
          have e : h₃ + (N₃ : ℂ) + ((d : ℤ) : ℂ) - ((m : ℤ) : ℂ) - 1
              = h₃ + ((N₃ - e₀ : ℕ) : ℂ) := by
            rw [Nat.cast_sub h3]; push_cast; linear_combination -he₀'
          rw [e] at hm3
          exact hm3) (by omega))]
      obtain ⟨r, rfl⟩ : ∃ r, N₃ = e₀ + r := ⟨N₃ - e₀, by omega⟩
      have e : e₀ + r - e₀ = r := by omega
      rw [e]
      exact prodQ_congr (by push_cast; ring) (by push_cast; ring)
    · rw [map_zero, mode_eq_zero_of_le hl₃ hu hw₃ (by push_cast; omega), map_zero, map_zero,
        map_zero]
  · rw [sum_range_trim (J := N₂ + d) (by omega) (fun k hk => by
      rw [mode_eq_zero_of_le hl₂ hu hw₂ (by omega), map_zero, LinearMap.zero_apply,
        map_zero, map_zero, mul_zero])]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    rw [map_smul, QT, coeff_X_pow_mul_prodQ (hUB.base (mode_mem_weight_nat hu hw₂ hk) hw₃
      (by omega)), cbz_nat, smul_eq_mul]
    obtain ⟨r, hr⟩ : ∃ r, N₂ + d = k + 1 + r := ⟨N₂ + d - (k + 1), by omega⟩
    have e : N₂ + d - (k + 1) = r := by omega
    rw [e]
    have hr' : (N₂ : ℂ) + d = k + 1 + r := by exact_mod_cast hr
    exact congrArg _ (prodQ_congr (by push_cast; ring)
      (by push_cast; linear_combination hr' + he₀'))
  · rw [sum_range_trim (J := N₁ + d) (by omega) (fun k hk => by
      rw [mode_eq_zero_of_le hl₁ hu hw₁ (by omega), map_zero, LinearMap.zero_apply,
        map_zero, mul_zero])]
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    rw [map_smul, QT, coeff_X_pow_mul_prodQ (hUB.base hw₂ hw₃ (by omega)), cbz_nat,
      smul_eq_mul]
    obtain ⟨r, hr⟩ : ∃ r, N₁ + d = k + 1 + r := ⟨N₁ + d - (k + 1), by omega⟩
    have e : N₁ + d - (k + 1) = r := by omega
    obtain ⟨t, ht⟩ : ∃ t, m + 2 + k = 2 * d + t := ⟨m + 2 + k - 2 * d, by omega⟩
    have e' : m + 2 + k - 2 * d = t := by omega
    rw [e, e']
    have hr' : (N₁ : ℂ) + d = k + 1 + r := by exact_mod_cast hr
    have ht' : (m : ℂ) + 2 + k = 2 * d + t := by exact_mod_cast ht
    exact congrArg _ (prodQ_congr (by push_cast; linear_combination -ht' + 2 * he₀')
      (by push_cast; linear_combination hr' + ht' - he₀'))

end Moves

/-! ## Linearity of the normalized series -/

section Linear

variable (c ν : ℂ) (N₄ s : ℕ)

theorem QT_add_f (f f' : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν (f + f') w₁ w₂ w₃ N₄ s = QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
      + QT Y₁ Y₂ c ν f' w₁ w₂ w₃ N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_smul_f (a : ℂ) (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν (a • f) w₁ w₂ w₃ N₄ s = a • QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_zero_f (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν (0 : M₄ →ₗ[ℂ] ℂ) w₁ w₂ w₃ N₄ s = 0 := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_add_w₁ (f : M₄ →ₗ[ℂ] ℂ) (w₁ w₁' : M₁) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν f (w₁ + w₁') w₂ w₃ N₄ s = QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
      + QT Y₁ Y₂ c ν f w₁' w₂ w₃ N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_smul_w₁ (a : ℂ) (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν f (a • w₁) w₂ w₃ N₄ s = a • QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_zero_w₁ (f : M₄ →ₗ[ℂ] ℂ) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν f (0 : M₁) w₂ w₃ N₄ s = 0 := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_add_w₂ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ w₂' : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν f w₁ (w₂ + w₂') w₃ N₄ s = QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
      + QT Y₁ Y₂ c ν f w₁ w₂' w₃ N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_smul_w₂ (a : ℂ) (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν f w₁ (a • w₂) w₃ N₄ s = a • QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_zero_w₂ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₃ : M₃) :
    QT Y₁ Y₂ c ν f w₁ (0 : M₂) w₃ N₄ s = 0 := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_add_w₃ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ w₃' : M₃) :
    QT Y₁ Y₂ c ν f w₁ w₂ (w₃ + w₃') N₄ s = QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
      + QT Y₁ Y₂ c ν f w₁ w₂ w₃' N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_smul_w₃ (a : ℂ) (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) :
    QT Y₁ Y₂ c ν f w₁ w₂ (a • w₃) N₄ s = a • QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s := by
  ext n; simp [QT, coeff_prodQ]

theorem QT_zero_w₃ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) :
    QT Y₁ Y₂ c ν f w₁ w₂ (0 : M₃) N₄ s = 0 := by
  ext n; simp [QT, coeff_prodQ]

end Linear

/-- `QT` only sees the functional on the weight space `h₄ + N₄`. -/
theorem QT_congr_f {h₁ h₂ h₃ h₄ ν : ℂ} (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) {N₁ N₂ N₃ N₄ : ℕ} {w₁ : M₁} {w₂ : M₂}
    {w₃ : M₃} (hw₁ : w₁ ∈ A₁.weight (h₁ + N₁)) (hw₂ : w₂ ∈ A₂.weight (h₂ + N₂))
    (hw₃ : w₃ ∈ A₃.weight (h₃ + N₃)) {f f' : M₄ →ₗ[ℂ] ℂ}
    (hff : f.domRestrict (A₄.weight (h₄ + N₄)) = f'.domRestrict (A₄.weight (h₄ + N₄))) :
    QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄)
      = QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f' w₁ w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄) := by
  ext n
  rw [QT, QT, coeff_prodQ, coeff_prodQ]
  have hx := prod_mem_weight hY₁ hY₂ hw₁ hw₂ hw₃
    (h₁ + h₂ + h₃ - h₄ - 2 - ν - 2 * N₄ + n) (ν + ((N₁ + N₂ + N₃ + N₄ : ℕ) : ℂ) - n)
  have e : h₁ + N₁ + (h₂ + N₂) + (h₃ + N₃) - (h₁ + h₂ + h₃ - h₄ - 2 - ν - 2 * N₄ + n)
      - (ν + ((N₁ + N₂ + N₃ + N₄ : ℕ) : ℂ) - n) - 2 = h₄ + N₄ := by push_cast; ring
  rw [e] at hx
  exact LinearMap.congr_fun hff ⟨_, hx⟩

/-! ## The induction (Huang's Prop. 1.1, with regularity built in) -/

/-- **`C₁`-cofiniteness, graded form**: above level `B`, every homogeneous vector is a sum of
`u₋₁ w'` with `u` homogeneous of positive weight (`dim W/C₁(W) < ∞`, Huang §1). -/
def C1Graded {M : Type u} [AddCommGroup M] [Module ℂ M] (A : OrdVModule W M) (h : ℂ)
    (B : ℕ) : Prop :=
  ∀ N : ℕ, B < N → ∀ w ∈ A.weight (h + N), w ∈ Submodule.span ℂ
    {x | ∃ (d : ℕ) (u : 𝒱) (w' : M), 1 ≤ d ∧ d ≤ N ∧ u ∈ W.grading (d : ℤ) ∧
      w' ∈ A.weight (h + ((N - d : ℕ) : ℂ)) ∧ x = mode (A.YM u) (-1) w'}

/-- **`C₁`-cofiniteness of the contragredient, graded form**: above level `B`, every functional
on the weight space `h + N` is a sum of restrictions of `g ∘ u₍ₘ₎` with `u` of weight `d ≥ 1` and
`m ≥ 2d − 1` (the contragredient `u₋₁` is `Σⱼ ± (L₁ʲu/j!)₍₂wt−j−1₎`, FHL (5.2.4)). -/
def DualC1Graded {M : Type u} [AddCommGroup M] [Module ℂ M] (A : OrdVModule W M) (h : ℂ)
    (B : ℕ) : Prop :=
  ∀ N : ℕ, B < N → ∀ f : M →ₗ[ℂ] ℂ, f.domRestrict (A.weight (h + N)) ∈ Submodule.span ℂ
    {φ | ∃ (d m : ℕ) (u : 𝒱) (g : M →ₗ[ℂ] ℂ), 1 ≤ d ∧ 2 * d ≤ m + 1 ∧ m + 1 - d ≤ N ∧
      u ∈ W.grading (d : ℤ) ∧ φ = (g ∘ₗ mode (A.YM u) (m : ℤ)).domRestrict (A.weight (h + N))}

theorem mul_mem_of_ratRing {a : ℂ} (NN : Submodule (ratRing a) (PowerSeries ℂ))
    {r q : PowerSeries ℂ} (hr : r ∈ ratRing a) (hq : q ∈ NN) : r * q ∈ NN := by
  have h := NN.smul_mem ⟨r, hr⟩ hq
  rwa [Subalgebra.smul_def] at h

theorem smul_mem_of_ratRing {b : ℂ} (NN : Submodule (ratRing b) (PowerSeries ℂ)) (a : ℂ)
    {q : PowerSeries ℂ} (hq : q ∈ NN) : a • q ∈ NN := by
  rw [PowerSeries.smul_eq_C_mul]
  refine mul_mem_of_ratRing NN ?_ hq
  have := (ratRing b).algebraMap_mem a
  exact this

theorem X_mul_binom_mem' (a : ℂ) (k : ℕ) :
    (X : PowerSeries ℂ) * HuangODEAlgebra.binomSeries a k ∈ ratRing a :=
  Subalgebra.mul_mem _ (X_mem_ratRing a) (binomSeries_mem a k)

theorem X_mul_binom_mem (k : ℕ) :
    (X : PowerSeries ℂ) * HuangODEAlgebra.binomSeries 1 k ∈ ratRing 1 :=
  X_mul_binom_mem' 1 k

section Induction

variable {h₁ h₂ h₃ h₄ ν : ℂ} {B₁ B₂ B₃ B₄ : ℕ}

/-- **Huang's Prop. 1.1 with regularity (products, one variable).**  Under graded
`C₁`-cofiniteness of `W₁, W₂, W₃` and of the contragredient of `W₄`, every normalized series
`QT` lies in the `ℂ[x, (1 − x)⁻¹]`-module generated by the series of the tuples of bounded
levels.  Each move (`moveA` … `moveD`) strictly lowers the total level and only uses
coefficients in `ℂ[x, (1 − x)⁻¹]` — no `x⁻¹`: this is the regularity at `z₂ = 0`. -/
theorem qt_mem (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (hl₁ : IsLowestWeight A₁ h₁)
    (hl₂ : IsLowestWeight A₂ h₂) (hl₃ : IsLowestWeight A₃ h₃) (hl₄ : IsLowestWeight A₄ h₄)
    (hUB : UnifBase A₂ A₃ Y₂ h₂ h₃ ν) (hC₁ : C1Graded A₁ h₁ B₁) (hC₂ : C1Graded A₂ h₂ B₂)
    (hC₃ : C1Graded A₃ h₃ B₃) (hD₄ : DualC1Graded A₄ h₄ B₄)
    (NN : Submodule (ratRing 1) (PowerSeries ℂ))
    (hbase : ∀ (N₁ N₂ N₃ N₄ : ℕ), N₁ ≤ B₁ → N₂ ≤ B₂ → N₃ ≤ B₃ → N₄ ≤ B₄ →
      ∀ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃), w₁ ∈ A₁.weight (h₁ + N₁) →
        w₂ ∈ A₂.weight (h₂ + N₂) → w₃ ∈ A₃.weight (h₃ + N₃) →
        QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄) ∈ NN) :
    ∀ (s N₁ N₂ N₃ N₄ : ℕ), N₁ + N₂ + N₃ + N₄ = s →
      ∀ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃), w₁ ∈ A₁.weight (h₁ + N₁) →
        w₂ ∈ A₂.weight (h₂ + N₂) → w₃ ∈ A₃.weight (h₃ + N₃) →
        QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ w₃ N₄ s ∈ NN := by
  intro s
  induction s using Nat.strong_induction_on with
  | _ s IH =>
  intro N₁ N₂ N₃ N₄ hs f w₁ w₂ w₃ hw₁ hw₂ hw₃
  have IH' : ∀ (N₁ N₂ N₃ N₄ : ℕ), N₁ + N₂ + N₃ + N₄ < s →
      ∀ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃), w₁ ∈ A₁.weight (h₁ + N₁) →
        w₂ ∈ A₂.weight (h₂ + N₂) → w₃ ∈ A₃.weight (h₃ + N₃) →
        QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄) ∈ NN :=
    fun N₁ N₂ N₃ N₄ hlt f w₁ w₂ w₃ h1 h2 h3 => IH _ hlt N₁ N₂ N₃ N₄ rfl f w₁ w₂ w₃ h1 h2 h3
  subst hs
  by_cases c1 : B₁ < N₁
  · refine Submodule.span_induction
      (p := fun x _ => QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f x w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hC₁ N₁ c1 w₁ hw₁)
    · rintro x ⟨d, u, w', hd1, hdN, hu, hw', rfl⟩
      rw [show N₁ + N₂ + N₃ + N₄ = (N₁ - d) + d + N₂ + N₃ + N₄ by omega,
        moveA hY₁ hY₂ hl₂ hl₃ hl₄ hUB hu f hw' hw₂ hw₃]
      refine NN.add_mem (NN.add_mem ?_ ?_) ?_
      · refine NN.sum_mem fun i hi => mul_mem_of_ratRing NN (X_pow_mem 1 _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ (by omega) _ _ _ _ hw' hw₂ hw₃
      · refine NN.sum_mem fun i hi => mul_mem_of_ratRing NN (X_pow_mem 1 _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ (by omega) _ _ _ _ hw' hw₂ (mode_mem_weight_nat hu hw₃ hi)
      · refine NN.sum_mem fun k hk => mul_mem_of_ratRing NN (X_mul_binom_mem k) ?_
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ (by omega) _ _ _ _ hw' (mode_mem_weight_nat hu hw₂ hk) hw₃
    · simp only []; rw [QT_zero_w₁]; exact NN.zero_mem
    · intro x y _ _ hx hy; rw [QT_add_w₁]; exact NN.add_mem hx hy
    · intro a x _ hx; rw [QT_smul_w₁]; exact smul_mem_of_ratRing NN a hx
  by_cases c2 : B₂ < N₂
  · refine Submodule.span_induction
      (p := fun x _ => QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ x w₃ N₄ (N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hC₂ N₂ c2 w₂ hw₂)
    · rintro x ⟨d, u, w', hd1, hdN, hu, hw', rfl⟩
      rw [show N₁ + N₂ + N₃ + N₄ = N₁ + (N₂ - d) + d + N₃ + N₄ by omega,
        moveB hY₁ hY₂ hl₁ hl₃ hl₄ hUB hu f hw₁ hw' hw₃]
      refine NN.add_mem (NN.sub_mem ?_ ?_) ?_
      · refine NN.sum_mem fun i hi => mul_mem_of_ratRing NN (X_pow_mem 1 _) ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ (by omega) _ _ _ _ hw₁ hw' hw₃
      · refine NN.sum_mem fun k hk => smul_mem_of_ratRing NN _
          (mul_mem_of_ratRing NN (X_mul_binom_mem k) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ (by omega) _ _ _ _ (mode_mem_weight_nat hu hw₁ hk) hw' hw₃
      · refine NN.sum_mem fun i hi => ?_
        simp only [Finset.mem_range] at hi
        exact IH' _ _ _ _ (by omega) _ _ _ _ hw₁ hw' (mode_mem_weight_nat hu hw₃ hi)
    · simp only []; rw [QT_zero_w₂]; exact NN.zero_mem
    · intro x y _ _ hx hy; rw [QT_add_w₂]; exact NN.add_mem hx hy
    · intro a x _ hx; rw [QT_smul_w₂]; exact smul_mem_of_ratRing NN a hx
  by_cases c3 : B₃ < N₃
  · refine Submodule.span_induction
      (p := fun x _ => QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ x N₄ (N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hC₃ N₃ c3 w₃ hw₃)
    · rintro x ⟨d, u, w', hd1, hdN, hu, hw', rfl⟩
      rw [show N₁ + N₂ + N₃ + N₄ = N₁ + N₂ + (N₃ - d) + d + N₄ by omega,
        moveC hY₁ hY₂ hl₁ hl₂ hl₄ hUB hu f hw₁ hw₂ hw']
      refine NN.sub_mem (NN.sub_mem ?_ ?_) ?_
      · split_ifs with hd
        · exact mul_mem_of_ratRing NN (X_pow_mem 1 _)
            (IH' _ _ _ _ (by omega) _ _ _ _ hw₁ hw₂ hw')
        · exact NN.zero_mem
      · refine NN.sum_mem fun k hk => smul_mem_of_ratRing NN _
          (mul_mem_of_ratRing NN (X_pow_mem 1 _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ (by omega) _ _ _ _ (mode_mem_weight_nat hu hw₁ hk) hw₂ hw'
      · refine NN.sum_mem fun k hk => smul_mem_of_ratRing NN _ ?_
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ (by omega) _ _ _ _ hw₁ (mode_mem_weight_nat hu hw₂ hk) hw'
    · simp only []; rw [QT_zero_w₃]; exact NN.zero_mem
    · intro x y _ _ hx hy; rw [QT_add_w₃]; exact NN.add_mem hx hy
    · intro a x _ hx; rw [QT_smul_w₃]; exact smul_mem_of_ratRing NN a hx
  by_cases c4 : B₄ < N₄
  · refine Submodule.span_induction
      (p := fun φ _ => ∀ f' : M₄ →ₗ[ℂ] ℂ, f'.domRestrict (A₄.weight (h₄ + N₄)) = φ →
        QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f' w₁ w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄) ∈ NN)
      ?_ ?_ ?_ ?_ (hD₄ N₄ c4 f) f rfl
    · rintro φ ⟨d, m, u, g, hd1, hm, hmN, hu, rfl⟩ f' hf'
      rw [QT_congr_f hY₁ hY₂ hw₁ hw₂ hw₃ hf']
      obtain ⟨r, rfl⟩ : ∃ r, N₄ = r + (m + 1 - d) := ⟨N₄ - (m + 1 - d), by omega⟩
      rw [show N₁ + N₂ + N₃ + (r + (m + 1 - d)) = N₁ + N₂ + N₃ + r + (m + 1 - d) by ring,
        moveD hY₁ hY₂ hl₁ hl₂ hl₃ hUB hm hu g hw₁ hw₂ hw₃]
      refine NN.add_mem (NN.add_mem ?_ ?_) ?_
      · split_ifs with h3
        · refine mul_mem_of_ratRing NN (X_pow_mem 1 _) (IH' _ _ _ _ (by omega) _ _ _ _ hw₁ hw₂ ?_)
          have hm3 := mode_mem_weight A₃ hu hw₃ (m : ℤ)
          have e : h₃ + (N₃ : ℂ) + ((d : ℤ) : ℂ) - ((m : ℤ) : ℂ) - 1
              = h₃ + ((N₃ - (m + 1 - d) : ℕ) : ℂ) := by
            rw [Nat.cast_sub h3, Nat.cast_sub (by omega)]; push_cast; ring
          rw [e] at hm3
          exact hm3
        · exact NN.zero_mem
      · refine NN.sum_mem fun k hk => smul_mem_of_ratRing NN _
          (mul_mem_of_ratRing NN (X_pow_mem 1 _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ (by omega) _ _ _ _ hw₁ (mode_mem_weight_nat hu hw₂ hk) hw₃
      · refine NN.sum_mem fun k hk => smul_mem_of_ratRing NN _
          (mul_mem_of_ratRing NN (X_pow_mem 1 _) ?_)
        simp only [Finset.mem_range] at hk
        exact IH' _ _ _ _ (by omega) _ _ _ _ (mode_mem_weight_nat hu hw₁ hk) hw₂ hw₃
    · intro f' hf'
      rw [QT_congr_f hY₁ hY₂ hw₁ hw₂ hw₃ (f' := 0) (by rw [hf']; ext; simp), QT_zero_f]
      exact NN.zero_mem
    · intro φ₁ φ₂ _ _ h1 h2 f' hf'
      obtain ⟨g₁, hg₁⟩ := LinearMap.exists_extend φ₁
      have hsplit : f' = g₁ + (f' - g₁) := by abel
      rw [hsplit, QT_add_f]
      refine NN.add_mem (h1 g₁ hg₁) (h2 _ ?_)
      ext x
      have hx := LinearMap.congr_fun hf' x
      have hx1 := LinearMap.congr_fun hg₁ x
      simp only [LinearMap.domRestrict_apply, LinearMap.add_apply, LinearMap.sub_apply,
        LinearMap.comp_apply, Submodule.subtype_apply] at hx hx1 ⊢
      rw [hx, hx1]; ring
    · intro a φ _ h1 f' hf'
      obtain ⟨g₁, hg₁⟩ := LinearMap.exists_extend φ
      rw [QT_congr_f hY₁ hY₂ hw₁ hw₂ hw₃ (f' := a • g₁) (by
        rw [hf']; ext x
        have hx1 := LinearMap.congr_fun hg₁ x
        simp only [LinearMap.domRestrict_apply, LinearMap.smul_apply, LinearMap.comp_apply,
          Submodule.subtype_apply] at hx1 ⊢
        rw [hx1]), QT_smul_f]
      exact smul_mem_of_ratRing NN a (h1 g₁ hg₁)
  exact hbase N₁ N₂ N₃ N₄ (by omega) (by omega) (by omega) (by omega) f w₁ w₂ w₃ hw₁ hw₂ hw₃

end Induction

/-! ## Finite generation of the base module -/

section Finite

variable (c ν : ℂ) (N₄ s : ℕ)

/-- `QT` as a linear map in the functional. -/
noncomputable def QTf (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) : (M₄ →ₗ[ℂ] ℂ) →ₗ[ℂ] PowerSeries ℂ where
  toFun f := QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
  map_add' f f' := QT_add_f c ν N₄ s f f' w₁ w₂ w₃
  map_smul' a f := QT_smul_f c ν N₄ s a f w₁ w₂ w₃

/-- `QT` as a linear map in `w₁`. -/
noncomputable def QT₁ (f : M₄ →ₗ[ℂ] ℂ) (w₂ : M₂) (w₃ : M₃) : M₁ →ₗ[ℂ] PowerSeries ℂ where
  toFun w₁ := QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
  map_add' x y := QT_add_w₁ c ν N₄ s f x y w₂ w₃
  map_smul' a x := QT_smul_w₁ c ν N₄ s a f x w₂ w₃

/-- `QT` as a linear map in `w₂`. -/
noncomputable def QT₂ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₃ : M₃) : M₂ →ₗ[ℂ] PowerSeries ℂ where
  toFun w₂ := QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
  map_add' x y := QT_add_w₂ c ν N₄ s f w₁ x y w₃
  map_smul' a x := QT_smul_w₂ c ν N₄ s a f w₁ x w₃

/-- `QT` as a linear map in `w₃`. -/
noncomputable def QT₃ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) : M₃ →ₗ[ℂ] PowerSeries ℂ where
  toFun w₃ := QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s
  map_add' x y := QT_add_w₃ c ν N₄ s f w₁ w₂ x y
  map_smul' a x := QT_smul_w₃ c ν N₄ s a f w₁ w₂ x

end Finite

/-- A linear map applied to a vector of a finite-dimensional subspace lands in the span of the
images of a basis. -/
theorem map_mem_span_basis {E P : Type*} [AddCommGroup E] [Module ℂ E] [AddCommGroup P]
    [Module ℂ P] (V : Submodule ℂ E) [FiniteDimensional ℂ V] (g : E →ₗ[ℂ] P) {x : E}
    (hx : x ∈ V) (T : Set P)
    (hT : ∀ i, g ((Module.finBasis ℂ V i : V) : E) ∈ Submodule.span ℂ T) :
    g x ∈ Submodule.span ℂ T := by
  have h := (Module.finBasis ℂ V).sum_repr ⟨x, hx⟩
  have h' : x = ∑ i, (Module.finBasis ℂ V).repr ⟨x, hx⟩ i • ((Module.finBasis ℂ V i : V) : E) := by
    have := congrArg Subtype.val h
    simp only [Submodule.coe_sum, Submodule.coe_smul] at this
    exact this.symm
  rw [h', map_sum]
  exact Submodule.sum_mem _ fun i _ => by
    rw [map_smul]; exact Submodule.smul_mem _ _ (hT i)

/-- **Finitely many tuples suffice at fixed levels**: all `QT` of a fixed level vector lie in the
`ℂ`-span of a finite set (bases of the four finite-dimensional weight spaces). -/
theorem exists_finite_span {h₁ h₂ h₃ h₄ ν : ℂ} (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁)
    (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (N₁ N₂ N₃ N₄ : ℕ) :
    ∃ T : Set (PowerSeries ℂ), T.Finite ∧ ∀ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃),
      w₁ ∈ A₁.weight (h₁ + N₁) → w₂ ∈ A₂.weight (h₂ + N₂) → w₃ ∈ A₃.weight (h₃ + N₃) →
      QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄)
        ∈ Submodule.span ℂ T := by
  classical
  haveI := A₁.finrank (h₁ + N₁)
  haveI := A₂.finrank (h₂ + N₂)
  haveI := A₃.finrank (h₃ + N₃)
  haveI := A₄.finrank (h₄ + N₄)
  set E₄ := A₄.weight (h₄ + N₄)
  obtain ⟨E', hE'⟩ := Submodule.exists_isCompl E₄
  set π := Submodule.projectionOnto E₄ E' hE'
  set b₁ := Module.finBasis ℂ (A₁.weight (h₁ + N₁))
  set b₂ := Module.finBasis ℂ (A₂.weight (h₂ + N₂))
  set b₃ := Module.finBasis ℂ (A₃.weight (h₃ + N₃))
  set b₄ := Module.finBasis ℂ (Module.Dual ℂ E₄)
  set c := h₁ + h₂ + h₃ - h₄ - 2
  set s := N₁ + N₂ + N₃ + N₄
  refine ⟨Set.range fun q : _ × _ × _ × _ =>
    QT Y₁ Y₂ c ν ((b₄ q.1).comp π) (b₁ q.2.1 : M₁) (b₂ q.2.2.1 : M₂) (b₃ q.2.2.2 : M₃) N₄ s,
    Set.finite_range _, ?_⟩
  intro f w₁ w₂ w₃ hw₁ hw₂ hw₃
  -- the functional only matters on `E₄`
  have hres : f.domRestrict E₄ = ((f.domRestrict E₄).comp π).domRestrict E₄ := by
    ext x
    simp [π, Submodule.projectionOnto_apply_left]
  rw [QT_congr_f hY₁ hY₂ hw₁ hw₂ hw₃ hres]
  have hψ := b₄.sum_repr (f.domRestrict E₄)
  have hcomp : (f.domRestrict E₄).comp π
      = ∑ a, b₄.repr (f.domRestrict E₄) a • (b₄ a).comp π := by
    ext x
    rw [LinearMap.comp_apply]
    conv_lhs => rw [← hψ]
    simp only [LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.comp_apply]
  change QTf (Y₁ := Y₁) (Y₂ := Y₂) c ν N₄ s w₁ w₂ w₃ ((f.domRestrict E₄).comp π) ∈ _
  rw [hcomp, map_sum]
  refine Submodule.sum_mem _ fun a _ => ?_
  rw [map_smul]
  refine Submodule.smul_mem _ _ ?_
  change QT₁ (Y₁ := Y₁) (Y₂ := Y₂) c ν N₄ s ((b₄ a).comp π) w₂ w₃ w₁ ∈ _
  refine map_mem_span_basis _ _ hw₁ _ fun i => ?_
  change QT₂ (Y₁ := Y₁) (Y₂ := Y₂) c ν N₄ s ((b₄ a).comp π) (b₁ i : M₁) w₃ w₂ ∈ _
  refine map_mem_span_basis _ _ hw₂ _ fun j => ?_
  change QT₃ (Y₁ := Y₁) (Y₂ := Y₂) c ν N₄ s ((b₄ a).comp π) (b₁ i : M₁) (b₂ j : M₂) w₃ ∈ _
  refine map_mem_span_basis _ _ hw₃ _ fun k => ?_
  exact Submodule.subset_span ⟨(a, i, j, k), rfl⟩

/-! ## The Euler operator, the uniform base, and the assembly -/

/-- `L₋₁` on the middle vector is the twisted Euler operator on the normalized series. -/
theorem QT_Lm1 (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (c ν : ℂ) (f : M₄ →ₗ[ℂ] ℂ)
    (w₁ : M₁) (w₂ : M₂) (w₃ : M₃) (N₄ s : ℕ) :
    QT Y₁ Y₂ c ν f w₁ (A₂.Lm1 w₂) w₃ N₄ (s + 1)
      = thetaShift (-(ν + s + 1)) (QT Y₁ Y₂ c ν f w₁ w₂ w₃ N₄ s) := by
  ext n
  rw [coeff_thetaShift, QT, QT, coeff_prodQ, coeff_prodQ, hY₂.L_neg_one, LinearMap.smul_apply,
    map_smul, map_smul, smul_eq_mul]
  have e : ν + ((s + 1 : ℕ) : ℂ) - n - 1 = ν + s - n := by push_cast; ring
  rw [e]
  push_cast
  ring

theorem Lm1_mem_weight {M : Type u} [AddCommGroup M] [Module ℂ M] {A : OrdVModule W M}
    {h : ℂ} {N : ℕ} {w : M} (hw : w ∈ A.weight (h + N)) :
    A.Lm1 w ∈ A.weight (h + ((N + 1 : ℕ) : ℂ)) := by
  have hm := mode_mem_weight A W.conformalVector_mem_grading_two hw (0 : ℤ)
  have e : h + (N : ℂ) + ((2 : ℤ) : ℂ) - ((0 : ℤ) : ℂ) - 1 = h + ((N + 1 : ℕ) : ℂ) := by
    push_cast; ring
  rw [e] at hm
  exact hm

theorem Lm1_iterate_mem_weight {M : Type u} [AddCommGroup M] [Module ℂ M]
    {A : OrdVModule W M} {h : ℂ} {N : ℕ} {w : M} (hw : w ∈ A.weight (h + N)) (j : ℕ) :
    (⇑A.Lm1)^[j] w ∈ A.weight (h + ((N + j : ℕ) : ℂ)) := by
  induction j with
  | zero => simpa using hw
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    exact Lm1_mem_weight ih

/-- A chain of series, each the Euler operator of the previous one, all in a `ratRing`-module:
then all `θ_μ`-iterates of the first lie in it. -/
theorem theta_iter_mem {a : ℂ} (NN : Submodule (ratRing a) (PowerSeries ℂ))
    (Q : ℕ → PowerSeries ℂ)
    (lam : ℕ → ℂ) (hQ : ∀ j, Q (j + 1) = thetaShift (lam j) (Q j)) (hmem : ∀ j, Q j ∈ NN)
    (μ : ℂ) : ∀ i j, (thetaShift μ)^[i] (Q j) ∈ NN := by
  intro i
  induction i with
  | zero => intro j; simpa using hmem j
  | succ i ih =>
    intro j
    rw [Function.iterate_succ_apply]
    have e : thetaShift μ (Q j) = Q (j + 1) + (μ - lam j) • Q j := by
      rw [hQ, ← thetaShift_add, add_sub_cancel]
    rw [e, thetaShift_iterate_add, thetaShift_iterate_smul]
    exact NN.add_mem (ih (j + 1)) (smul_mem_of_ratRing NN _ (ih j))

/-- **A uniform base exists** (`M₅` is bounded below): `ν₀ − s + K` works for `K ≫ 0`. -/
theorem exists_unifBase (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂) (h₂ h₃ ν₀ : ℂ) (s : ℕ) :
    ∃ K : ℕ, UnifBase A₂ A₃ Y₂ h₂ h₃ (ν₀ - s + K) := by
  obtain ⟨B, hB⟩ := A₅.boundedBelow
  refine ⟨Nat.ceil ((h₂ + h₃ - ν₀).re + s - B) + 1, ?_⟩
  intro N₂ N₃ w₂ w₃ hw₂ hw₃ j
  set K : ℕ := Nat.ceil ((h₂ + h₃ - ν₀).re + s - B) + 1 with hK
  have hv := VOA.Huang.FusionTop.mem_weight hY₂ hw₂ hw₃
    (ν₀ - s + K + N₂ + N₃ + ((j : ℂ) + 1))
  by_cases hβ : A₅.weight (h₂ + N₂ + (h₃ + N₃) - (ν₀ - s + K + N₂ + N₃ + ((j : ℂ) + 1)) - 1) = ⊥
  · rw [hβ] at hv; exact (Submodule.mem_bot ℂ).mp hv
  · exfalso
    have h1 := hB _ hβ
    have h2 : (h₂ + N₂ + (h₃ + N₃) - (ν₀ - s + K + N₂ + N₃ + ((j : ℂ) + 1)) - 1).re
        = (h₂ + h₃ - ν₀).re + s - K - j - 2 := by
      simp only [Complex.sub_re, Complex.add_re, Complex.natCast_re, Complex.one_re]
      ring
    have h3 : (h₂ + h₃ - ν₀).re + s - B ≤ (Nat.ceil ((h₂ + h₃ - ν₀).re + s - B) : ℝ) :=
      Nat.le_ceil _
    have h4 : ((K : ℕ) : ℝ) = (Nat.ceil ((h₂ + h₃ - ν₀).re + s - B) : ℝ) + 1 := by
      rw [hK]; push_cast; ring
    have h5 : (0 : ℝ) ≤ j := Nat.cast_nonneg j
    rw [h2] at h1
    linarith

theorem ratFuchsian_zero (a lam : ℂ) : RatFuchsian a lam 0 :=
  ⟨0, 0, fun _ => 0, fun _ => 0, fun _ h => absurd h (Nat.not_lt_zero _), by
    simp [FuchsianEq]⟩

/-- The normalized series of the target tuple is `x^K` times the coset series. -/
theorem QT_eq_X_pow_mul_prodSeries {h₁ h₂ h₃ h₄ ν₀ : ℂ} {N₁ N₂ N₃ N₄ K : ℕ}
    {f : M₄ →ₗ[ℂ] ℂ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃} (hb : IsBase Y₂ w₂ w₃ ν₀) :
    QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) (ν₀ - ((N₁ + N₂ + N₃ + N₄ : ℕ) : ℂ) + K) f w₁ w₂ w₃ N₄
        (N₁ + N₂ + N₃ + N₄)
      = X ^ K * prodSeries Y₁ Y₂ f w₁ w₂ w₃
          ((h₁ + N₁) + (h₂ + N₂) + (h₃ + N₃) - (h₄ + N₄) - 2) ν₀ := by
  ext n
  rw [coeff_X_pow_mul', QT, coeff_prodQ]
  split_ifs with h
  · rw [coeff_prodSeries, prodCoeff]
    apply prodQ_congr
    · rw [Nat.cast_sub h]; push_cast; ring
    · rw [Nat.cast_sub h]; push_cast; ring
  · have e : ν₀ - ((N₁ + N₂ + N₃ + N₄ : ℕ) : ℂ) + K + ((N₁ + N₂ + N₃ + N₄ : ℕ) : ℂ) - n
        = ν₀ + (((K - n - 1 : ℕ) : ℂ) + 1) := by
      rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, hb, map_zero, map_zero]

/-- **Huang's regular equation for products (one-variable form), from graded
`C₁`-cofiniteness.**  For FHL intertwiners `𝒴₁ : (W₄ / W₁ M₅)`, `𝒴₂ : (M₅ / W₂ W₃)` (any
intermediate module `M₅`), lowest-weight modules `W₁ … W₄` with `W₁, W₂, W₃` and the contragredient
of `W₄` graded-`C₁`-cofinite, homogeneous `w₁, w₂, w₃`, **any** functional `f` and any weight `h₄'`
(the weight read off in `W₄`), and a base `ν₀` of the coset: the coset series satisfies a monic
`θ_λ`-equation with coefficients in `ℂ[x, (1 − x)⁻¹]` — Huang's Thms 1.4 + 2.3 (at `z₂ = 0`) after
the degree-0 reduction. -/
theorem ratFuchsian_prodSeries_of_C1 {h₁ h₂ h₃ h₄ : ℂ} {B₁ B₂ B₃ B₄ : ℕ}
    (hY₁ : IsIntertwiningOperator A₁ A₅ A₄ Y₁) (hY₂ : IsIntertwiningOperator A₂ A₃ A₅ Y₂)
    (hl₁ : IsLowestWeight A₁ h₁) (hl₂ : IsLowestWeight A₂ h₂) (hl₃ : IsLowestWeight A₃ h₃)
    (hl₄ : IsLowestWeight A₄ h₄) (hC₁ : C1Graded A₁ h₁ B₁) (hC₂ : C1Graded A₂ h₂ B₂)
    (hC₃ : C1Graded A₃ h₃ B₃) (hD₄ : DualC1Graded A₄ h₄ B₄)
    {α₁ α₂ α₃ h₄' : ℂ} {w₁ : M₁} {w₂ : M₂} {w₃ : M₃} (f : M₄ →ₗ[ℂ] ℂ)
    (hw₁ : w₁ ∈ A₁.weight α₁) (hw₂ : w₂ ∈ A₂.weight α₂) (hw₃ : w₃ ∈ A₃.weight α₃)
    {ν₀ : ℂ} (hb : IsBase Y₂ w₂ w₃ ν₀) (lam : ℂ) :
    RatFuchsian 1 lam (prodSeries Y₁ Y₂ f w₁ w₂ w₃ (α₁ + α₂ + α₃ - h₄' - 2) ν₀) := by
  classical
  -- degenerate weights give the zero series
  by_cases z₁ : A₁.weight α₁ = ⊥
  · have : w₁ = 0 := by rw [z₁] at hw₁; exact (Submodule.mem_bot ℂ).mp hw₁
    subst this
    convert ratFuchsian_zero 1 lam using 1
    ext k; simp [coeff_prodSeries, prodCoeff]
  by_cases z₂ : A₂.weight α₂ = ⊥
  · have : w₂ = 0 := by rw [z₂] at hw₂; exact (Submodule.mem_bot ℂ).mp hw₂
    subst this
    convert ratFuchsian_zero 1 lam using 1
    ext k; simp [coeff_prodSeries, prodCoeff]
  by_cases z₃ : A₃.weight α₃ = ⊥
  · have : w₃ = 0 := by rw [z₃] at hw₃; exact (Submodule.mem_bot ℂ).mp hw₃
    subst this
    convert ratFuchsian_zero 1 lam using 1
    ext k; simp [coeff_prodSeries, prodCoeff]
  by_cases z₄ : A₄.weight h₄' = ⊥
  · convert ratFuchsian_zero 1 lam using 1
    ext k
    rw [coeff_prodSeries, prodCoeff, map_zero]
    have hx := prod_mem_weight hY₁ hY₂ hw₁ hw₂ hw₃
      (α₁ + α₂ + α₃ - h₄' - 2 - ν₀ + k) (ν₀ - k)
    have e : α₁ + α₂ + α₃ - (α₁ + α₂ + α₃ - h₄' - 2 - ν₀ + k) - (ν₀ - k) - 2 = h₄' := by ring
    rw [e, z₄] at hx
    rw [(Submodule.mem_bot ℂ).mp hx, map_zero]
  obtain ⟨N₁, rfl⟩ := hl₁ α₁ z₁
  obtain ⟨N₂, rfl⟩ := hl₂ α₂ z₂
  obtain ⟨N₃, rfl⟩ := hl₃ α₃ z₃
  obtain ⟨N₄, rfl⟩ := hl₄ h₄' z₄
  obtain ⟨K, hUB⟩ := exists_unifBase hY₂ h₂ h₃ ν₀ (N₁ + N₂ + N₃ + N₄)
  set ν := ν₀ - ((N₁ + N₂ + N₃ + N₄ : ℕ) : ℂ) + K with hν
  choose T hTfin hT using fun q : Fin (B₁ + 1) × Fin (B₂ + 1) × Fin (B₃ + 1) × Fin (B₄ + 1) =>
    exists_finite_span (h₁ := h₁) (h₂ := h₂) (h₃ := h₃) (h₄ := h₄) (ν := ν) hY₁ hY₂
      q.1 q.2.1 q.2.2.1 q.2.2.2
  set NN : Submodule (ratRing 1) (PowerSeries ℂ) := Submodule.span (ratRing 1) (⋃ q, T q)
  have hFG : NN.FG := Submodule.fg_span (Set.finite_iUnion hTfin)
  have hbase : ∀ (N₁ N₂ N₃ N₄ : ℕ), N₁ ≤ B₁ → N₂ ≤ B₂ → N₃ ≤ B₃ → N₄ ≤ B₄ →
      ∀ (f : M₄ →ₗ[ℂ] ℂ) (w₁ : M₁) (w₂ : M₂) (w₃ : M₃), w₁ ∈ A₁.weight (h₁ + N₁) →
        w₂ ∈ A₂.weight (h₂ + N₂) → w₃ ∈ A₃.weight (h₃ + N₃) →
        QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ w₂ w₃ N₄ (N₁ + N₂ + N₃ + N₄) ∈ NN := by
    intro N₁ N₂ N₃ N₄ b₁ b₂ b₃ b₄ f w₁ w₂ w₃ hw₁ hw₂ hw₃
    have hq := hT (⟨N₁, by omega⟩, ⟨N₂, by omega⟩, ⟨N₃, by omega⟩, ⟨N₄, by omega⟩) f w₁ w₂ w₃
      hw₁ hw₂ hw₃
    have hle : Submodule.span ℂ (T (⟨N₁, by omega⟩, ⟨N₂, by omega⟩, ⟨N₃, by omega⟩,
        ⟨N₄, by omega⟩)) ≤ NN.restrictScalars ℂ :=
      (Submodule.span_mono (Set.subset_iUnion T _)).trans
        (Submodule.span_le_restrictScalars ℂ (ratRing 1) _)
    exact hle hq
  have hall := qt_mem hY₁ hY₂ hl₁ hl₂ hl₃ hl₄ hUB hC₁ hC₂ hC₃ hD₄ NN hbase
  -- the `L₋₁`-chain on the middle vector
  set Q : ℕ → PowerSeries ℂ := fun j =>
    QT Y₁ Y₂ (h₁ + h₂ + h₃ - h₄ - 2) ν f w₁ ((⇑A₂.Lm1)^[j] w₂) w₃ N₄
      (N₁ + N₂ + N₃ + N₄ + j) with hQdef
  have hQmem : ∀ j, Q j ∈ NN := fun j =>
    hall _ N₁ (N₂ + j) N₃ N₄ (by omega) f w₁ _ w₃ hw₁ (Lm1_iterate_mem_weight hw₂ j) hw₃
  have hQ : ∀ j, Q (j + 1) = thetaShift (-(ν + ((N₁ + N₂ + N₃ + N₄ + j : ℕ) : ℂ) + 1)) (Q j) := by
    intro j
    simp only [hQdef]
    rw [Function.iterate_succ_apply', show N₁ + N₂ + N₃ + N₄ + (j + 1)
      = N₁ + N₂ + N₃ + N₄ + j + 1 from rfl, QT_Lm1 hY₂]
  have hθ := theta_iter_mem NN Q _ hQ hQmem 0
  have hQ0 : Q 0 = X ^ K * prodSeries Y₁ Y₂ f w₁ w₂ w₃
      ((h₁ + N₁) + (h₂ + N₂) + (h₃ + N₃) - (h₄ + N₄) - 2) ν₀ := by
    simp only [hQdef, Function.iterate_zero, id, add_zero]
    exact QT_eq_X_pow_mul_prodSeries hb
  exact ratFuchsian_of_fg NN hFG (K := K) (μ := 0) (fun j => by
    have := hθ j 0; rwa [hQ0] at this) lam

end Product

/-! ## The named input `HuangProductODE` -/

/-- **Graded `C₁`-data of the irreducible modules** of `W`: each irreducible lowest-weight module
is graded-`C₁`-cofinite (`C1Graded`), and so is its contragredient (`DualC1Graded`).

TRUE for strongly rational `W`: irreducible modules and their contragredients (again irreducible,
FHL) are `C₂`-cofinite (Abe–Buhl–Dong 2004; the library's `ModuleC2Input`), `C₂(M) ⊆ C₁(M)`
(`a₋₂m = (L₋₁a)₋₁m`), and `C₁(M)` is a graded subspace; for the contragredient, FHL (5.2.4) writes
`u₋₁` on `M'` as `Σⱼ ±(L₁ʲu/j!)₍₂wt u−j−1₎ᵀ`, whose terms have the shape required by
`DualC1Graded` (the `V₀ = ℂ1` terms vanish by CFT type). -/
def ModuleC1Data (W : VertexOperatorAlgebra 𝒱) : Prop :=
  ∀ P : LWModule W, P.IsIrreducibleLW →
    (∃ B, C1Graded P.isMod P.h B) ∧ ∃ B, DualC1Graded P.isMod P.h B

/-- **`HuangProductODE` from the graded `C₁`-data.**  (In fact no irreducibility, no
`SupportedAt` and nothing about `M₅` beyond being a graded module is used.) -/
theorem huangProductODE_of_moduleC1Data (hC : ModuleC1Data W) : HuangProductODE W := by
  intro P₁ P₂ P₃ P₄ i₁ i₂ i₃ i₄ M₅ _ _ A₅ Y₁ Y₂ hY₁ hY₂ α₁ α₂ α₃ h₄ w₁ w₂ w₃ f h₁ h₂ h₃ _ ν₀ hb
  obtain ⟨⟨B₁, c₁⟩, -⟩ := hC P₁ i₁
  obtain ⟨⟨B₂, c₂⟩, -⟩ := hC P₂ i₂
  obtain ⟨⟨B₃, c₃⟩, -⟩ := hC P₃ i₃
  obtain ⟨-, ⟨B₄, d₄⟩⟩ := hC P₄ i₄
  exact ratFuchsian_prodSeries_of_C1 hY₁ hY₂ P₁.isLow P₂.isLow P₃.isLow P₄.isLow c₁ c₂ c₃ d₄ f
    h₁ h₂ h₃ hb _

end VOA.Huang.HuangODEProduct
