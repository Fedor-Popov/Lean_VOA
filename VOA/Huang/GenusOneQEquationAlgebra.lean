import VOA.Huang.GenusTwoPointCoinvariants
import Mathlib.RingTheory.Adjoin.FG
import Mathlib.Analysis.Analytic.Constructions

/-!
# Algebraic relations for the two-insertion q-equation

The four-generator coefficient algebra models the algebra generated by
G₄, G₆, wp₂ and wp₃. The generators remain parameters: their identification
with elliptic functions, and the trace Ward identities, are not proved here.
C₂-cofiniteness gives relations independent of the trace map. Analyticity of
the four generators at q = 0 implies analyticity of every coefficient.
The q-operators may depend on the iteration index, as in Huang's Lemma 3.8.
-/
namespace VOA.Huang.GenusTwoPoint.QEquation
open VOA VOA.Huang.FusionC2
open scoped BigOperators

/-- The algebra generated by four specified coefficient functions or elements. -/
def coefficientAlgebra {K : Type*} [CommRing K] [Algebra ℂ K]
    (g : Fin 4 → K) : Subalgebra ℂ K := Algebra.adjoin ℂ (Set.range g)

instance coefficientAlgebra_noetherian {K : Type*} [CommRing K] [Algebra ℂ K]
    (g : Fin 4 → K) : IsNoetherianRing (coefficientAlgebra g) :=
  isNoetherianRing_of_fg
    (Subalgebra.fg_def.mpr ⟨Set.range g, Set.finite_range g, rfl⟩)

/-- Regularity of the generators propagates to all algebraic coefficients.
This does not assert regularity of actual Eisenstein or Weierstrass functions. -/
theorem coefficient_analyticAt_zero (g : Fin 4 → ℂ → ℂ)
    (hg : ∀ i, AnalyticAt ℂ (g i) 0) (c : coefficientAlgebra g) :
    AnalyticAt ℂ c.val 0 := by
  rcases c with ⟨c, hc⟩
  induction hc using Algebra.adjoin_induction with
  | mem f hf => obtain ⟨i, rfl⟩ := hf; exact hg i
  | algebraMap z => exact analyticAt_const
  | add f h hf hh hfa hha => exact hfa.add hha
  | mul f h hf hh hfa hha => exact hfa.mul hha

universe u
variable {V M₁ M₂ : Type u} [AddCommGroup V] [Module ℂ V]
  [AddCommGroup M₁] [Module ℂ M₁] [AddCommGroup M₂] [Module ℂ M₂]
  {W : VertexOperatorAlgebra V}
  {R : Type*} [CommRing R] [Algebra ℂ R]

/-- The missing genus-one Ward identity, stated as descent through the
explicit two-insertion relation module. -/
def TraceDescent (A : WeakModule W M₁) (B : WeakModule W M₂) (c : Kernels R)
    {F : Type*} [AddCommGroup F] [Module R F] (φ : Tensor R M₁ M₂ →ₗ[R] F) : Prop :=
  relations A B c ≤ LinearMap.ker φ

/-- Iterated, possibly weight-dependent q/coordinate operators. -/
def qIterate {F : Type*} (D : ℕ → F → F) (f : F) : ℕ → F
  | 0 => f
  | n + 1 => D n (qIterate D f n)

/-- The missing differential Ward identity for a chosen tensor sequence. -/
def QOrbitCompatibility {F : Type*} [AddCommGroup F] [Module R F]
    (φ : Tensor R M₁ M₂ →ₗ[R] F) (t : ℕ → Tensor R M₁ M₂)
    (D : ℕ → F → F) : Prop := ∀ n, φ (t (n + 1)) = D n (φ (t n))

theorem map_eq_qIterate {F : Type*} [AddCommGroup F] [Module R F]
    (φ : Tensor R M₁ M₂ →ₗ[R] F) (t : ℕ → Tensor R M₁ M₂)
    (D : ℕ → F → F) (hD : QOrbitCompatibility φ t D) (n : ℕ) :
    φ (t n) = qIterate D (φ (t 0)) n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [hD, qIterate, ih]

/-- A relation in the explicit quotient, chosen before any trace functional.
The relation has positive order; its differential interpretation still needs Ward identities. -/
theorem exists_uniform_relation [IsNoetherianRing R]
    (A : AdmissibleModule W M₁) (B : AdmissibleModule W M₂)
    (hA : ModuleC2Cofinite A.toWeakModule) (hB : ModuleC2Cofinite B.toWeakModule)
    (c : Kernels R) (t : ℕ → Tensor R M₁ M₂) :
    ∃ (m : ℕ) (a : ℕ → R), 0 < m ∧
      t m - ∑ k ∈ Finset.range m, a k • t k ∈ relations A.toWeakModule B.toWeakModule c := by
  let J := relations A.toWeakModule B.toWeakModule c
  letI := finite_coinvariants A B hA hB c
  obtain ⟨m, a, ha⟩ := MatrixCoeffODE.exists_monic_relation (R := R)
    (fun k => J.mkQ (t (k + 1)))
  let b : ℕ → R := fun k => if k = 0 then 0 else a (k - 1)
  have hb : (∑ k ∈ Finset.range (m + 1), b k • J.mkQ (t k)) =
      ∑ k ∈ Finset.range m, a k • J.mkQ (t (k + 1)) := by
    rw [Finset.sum_range_succ']
    simp [b]
  refine ⟨m + 1, b, by omega, (Submodule.Quotient.mk_eq_zero J).mp ?_⟩
  change J.mkQ _ = 0
  simp only [map_sub, map_sum, map_smul]
  exact sub_eq_zero.mpr (ha.trans hb.symm)

/-- Conditional q-equation transfer. The coefficients are uniform in every
trace map satisfying descent and the differential Ward identity. -/
theorem exists_uniform_qEquation [IsNoetherianRing R]
    (A : AdmissibleModule W M₁) (B : AdmissibleModule W M₂)
    (hA : ModuleC2Cofinite A.toWeakModule) (hB : ModuleC2Cofinite B.toWeakModule)
    (c : Kernels R) (t : ℕ → Tensor R M₁ M₂) :
    ∃ (m : ℕ) (a : ℕ → R), 0 < m ∧ ∀ {F : Type*} [AddCommGroup F] [Module R F]
      (φ : Tensor R M₁ M₂ →ₗ[R] F), TraceDescent A.toWeakModule B.toWeakModule c φ →
      ∀ D : ℕ → F → F, QOrbitCompatibility φ t D →
        qIterate D (φ (t 0)) m =
          ∑ k ∈ Finset.range m, a k • qIterate D (φ (t 0)) k := by
  obtain ⟨m, a, hm, ha⟩ := exists_uniform_relation A B hA hB c t
  refine ⟨m, a, hm, fun {F} _ _ φ hφ D hD => ?_⟩
  have he := hφ ha
  rw [LinearMap.mem_ker, map_sub, map_sum] at he
  simp only [map_smul] at he
  simpa only [← map_eq_qIterate φ t D hD] using sub_eq_zero.mp he

/-- The algebraic relation has coefficients regular at q = 0 whenever the
four specified generators are regular there. No division of coefficients is used. -/
theorem exists_regular_uniform_relation (g : Fin 4 → ℂ → ℂ)
    (hg : ∀ i, AnalyticAt ℂ (g i) 0)
    (A : AdmissibleModule W M₁) (B : AdmissibleModule W M₂)
    (hA : ModuleC2Cofinite A.toWeakModule) (hB : ModuleC2Cofinite B.toWeakModule)
    (c : Kernels (coefficientAlgebra g)) (t : ℕ → Tensor (coefficientAlgebra g) M₁ M₂) :
    ∃ (m : ℕ) (a : ℕ → coefficientAlgebra g), 0 < m ∧
      (∀ k, AnalyticAt ℂ (a k).val 0) ∧
      t m - ∑ k ∈ Finset.range m, a k • t k ∈ relations A.toWeakModule B.toWeakModule c := by
  obtain ⟨m, a, hm, ha⟩ := exists_uniform_relation A B hA hB c t
  exact ⟨m, a, hm, fun k => coefficient_analyticAt_zero g hg (a k), ha⟩

end VOA.Huang.GenusTwoPoint.QEquation
