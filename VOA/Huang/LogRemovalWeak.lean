import VOA.Huang.LogRemovalWeightBound

/-!
# Log removal from a weak module of coefficient functions (assembly)

Combining the abstract log removal of `LogRemovalAdmissible` with the **proved** uniform log bound
(`LogRemovalBound.coeffLogBounded_holds`), log removal at the iterate point needs exactly one more
datum: a module structure on a space of functions of homogeneous pairs containing `B_{n,0}`,
whose `L(0)` is the transpose operator `L'(0)` (`L0T`).

* With an **admissible** structure (`CoeffAdmissibleInput`):
  `coeffL0Semisimple_of_admissibleInput : StronglyRational W → CoeffAdmissibleInput W →
  CoeffL0Semisimple W` — the log bound is not a hypothesis.
* With a **weak** structure (`CoeffWeakInput`, the direct output of the Huang–Lepowsky `P(1)`
  construction) plus the Abe–Buhl–Dong theorem "weak ⟹ admissible for
  `C₂`-cofinite `V`" (`ABDWeakIsAdmissible`, a named citation in
  `Modules/RationalityLattice.lean`): `coeffL0Semisimple_of_weakInput`.

## Why a separate weak version
The lower truncation of the `P(1)`-action on the coefficient functionals is available
(`LogRemovalWeightBound.coefFun_eq_zero_of_re_lt`), but only **per outside datum**: it does not
bound the weights of the whole module generated by one functional from below (the outside data
drift under the action).  So the natural output of the construction is a *weak* module, and
`ℕ`-gradability is a separate input — exactly ABD Prop. 5.7.

## Status
No `sorry`, no new axioms.
-/

namespace VOA.Huang.LogRemovalWeak

open VOA VOA.Huang.MatrixCoeff VOA.Huang.FusionTop VOA.Huang.AssocTarget
open VOA.Huang.LogRemovalSemisimple VOA.Huang.LogRemovalAdmissible VOA.Huang.LogRemovalBound

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}

/-- **A weak module of functions through `B_{n,0}` with `L(0) = L'(0)`** (named; TRUE for
strongly rational `W`, by the same argument as `CoeffAdmissibleInput`: the image of the
contragredients of the intermediate modules under `μ ↦ ⟨μ, 𝒴₄(·)·⟩`).  This is the output of
the Huang–Lepowsky stages HL3 (Jacobi identity of the `P(1)`-action) and HL4 (stability of the
span of the coefficient functionals, lower truncation). -/
def CoeffWeakInput (W : VertexOperatorAlgebra 𝒱) : Prop :=
  ∀ (P₁ P₂ P₃ P₄ Q : LWModule W), P₁.IsIrreducibleLW → P₂.IsIrreducibleLW →
    P₃.IsIrreducibleLW → P₄.IsIrreducibleLW → Q.IsIrreducibleLW →
  ∀ (Y₁ : IntertwiningModes P₁.carrier Q.carrier P₄.carrier)
    (Y₂ : IntertwiningModes P₂.carrier P₃.carrier Q.carrier),
    IsIntertwiningOperator P₁.isMod Q.isMod P₄.isMod Y₁ →
    IsIntertwiningOperator P₂.isMod P₃.isMod Q.isMod Y₂ →
  ∀ (α₃ h₄ : ℂ) (w₃ : P₃.carrier) (f : P₄.carrier →ₗ[ℂ] ℂ),
    w₃ ∈ P₃.isMod.weight α₃ → SupportedAt P₄.isMod f h₄ →
  ∀ n : ℂ, ∃ (M : Submodule ℂ (HomPair P₁ P₂ → ℂ)) (A : WeakModule W M),
    (∀ G : M, ((L0 A G : M) : HomPair P₁ P₂ → ℂ) = L0T P₁ P₂ (G : HomPair P₁ P₂ → ℂ))
    ∧ coefFun Y₁ Y₂ f w₃ α₃ h₄ n 0 ∈ M

/-- An admissible structure is in particular a weak one. -/
theorem coeffWeakInput_of_admissible (h : CoeffAdmissibleInput W) : CoeffWeakInput W := by
  intro P₁ P₂ P₃ P₄ Q i₁ i₂ i₃ i₄ iQ Y₁ Y₂ hY₁ hY₂ α₃ h₄ w₃ f h₃ hf n
  obtain ⟨M, A, hL, hm⟩ := h P₁ P₂ P₃ P₄ Q i₁ i₂ i₃ i₄ iQ Y₁ Y₂ hY₁ hY₂ α₃ h₄ w₃ f h₃ hf n
  exact ⟨M, A.toWeakModule, hL, hm⟩

/-- Abe–Buhl–Dong upgrades a weak structure to an admissible one (`C₂`-cofinite `V`). -/
theorem coeffAdmissibleInput_of_weak (hV : StronglyRational W) (hABD : ABDWeakIsAdmissible W)
    (h : CoeffWeakInput W) : CoeffAdmissibleInput W := by
  intro P₁ P₂ P₃ P₄ Q i₁ i₂ i₃ i₄ iQ Y₁ Y₂ hY₁ hY₂ α₃ h₄ w₃ f h₃ hf n
  obtain ⟨M, A, hL, hm⟩ := h P₁ P₂ P₃ P₄ Q i₁ i₂ i₃ i₄ iQ Y₁ Y₂ hY₁ hY₂ α₃ h₄ w₃ f h₃ hf n
  obtain ⟨N, hN⟩ := hABD hV.c2Cofinite A
  exact ⟨M, N, fun G => by rw [hN]; exact hL G, hm⟩

/-- **Log removal from an admissible module of coefficient functions** (the log bound is
proved). -/
theorem coeffL0Semisimple_of_admissibleInput (hV : StronglyRational W)
    (hM : CoeffAdmissibleInput W) : CoeffL0Semisimple W :=
  coeffL0Semisimple_of_admissible hV (coeffLogBounded_holds hV) hM

/-- **Log removal from a weak module of coefficient functions**, given ABD. -/
theorem coeffL0Semisimple_of_weakInput (hV : StronglyRational W) (hABD : ABDWeakIsAdmissible W)
    (hM : CoeffWeakInput W) : CoeffL0Semisimple W :=
  coeffL0Semisimple_of_admissibleInput hV (coeffAdmissibleInput_of_weak hV hABD hM)

/-- **`AssociativityInput` from the remaining named inputs.** -/
theorem associativityInput_of_weakInput (hV : StronglyRational W)
    (hABD : ABDWeakIsAdmissible W) (hM : CoeffWeakInput W) (hZ : AssocCoeffIdentityZero W) :
    AssociativityInput W :=
  associativityInput_of_split hV (coeffL0Semisimple_of_weakInput hV hABD hM) hZ

end VOA.Huang.LogRemovalWeak
