import VOA.Huang.SchurWeylDLM
import VOA.Moonshine.SigmaExistGeneric
import VOA.Core.DeformationLiftedModes

/-!
# Dong–Li–Mason Schur–Weyl duality, part 1: density and the averaging argument

For a simple VOA `W` on `𝒱` and a finite group `G ≤ Aut W`:

* `modeAlgebra W` — the associative subalgebra of `End ℂ 𝒱` generated by all modes `u₍ₙ₎`;
* `isSimpleModule_modeAlgebra` — `𝒱` is a simple `modeAlgebra W`-module (this *is* `W.IsSimple`);
* `modeAlgebra_end_scalar` — **Schur's lemma**: every `modeAlgebra`-linear endomorphism of `𝒱` is a
  scalar (it preserves `ker L₀ = ℂ𝟙`, and `g u = g(u₍₋₁₎𝟙) = u₍₋₁₎ g 𝟙`);
* `exists_modeAlgebra_eq` — the **Jacobson density theorem** for the mode algebra: any linear
  map agrees on any finite set with an element of the mode algebra (Mathlib `jacobson_density`);
* `homModule W E` — for finite-dimensional `E`, `Hom(E, 𝒱)` is a weak `W`-module by
  post-composition (`φ ↦ u₍ₙ₎ ∘ φ`);
* `comp_mem_modeSpan` — with Li's single-mode spanning lemma (`SigmaExist.act_mem_modeSpan`),
  `f ∘ φ ∈ span{u₍ₙ₎ ∘ φ}` for every `f` in the mode algebra;
* `avgHom` and `mem_invSpan_of_comp` — the **averaging argument**: if `f ∘ χ` is `G`-equivariant
  for `G`-equivariant `χ`'s, then `f ∘ χ` lies in the span of the `W^G`-modes applied to the `χ`'s.

No `sorry`, no new axioms.
-/

set_option linter.style.longLine false

noncomputable section

namespace VOA.Huang.SchurWeyl

open VOA Module

universe u

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}

/-! ## The mode algebra and its simple module `𝒱` -/

variable (W) in
/-- The **mode algebra**: the subalgebra of `End ℂ 𝒱` generated by all modes `u₍ₙ₎`. -/
def modeAlgebra : Subalgebra ℂ (Module.End ℂ 𝒱) :=
  Algebra.adjoin ℂ {f | ∃ (u : 𝒱) (n : ℤ), f = modeOp W u n}

theorem modeOp_mem_modeAlgebra (u : 𝒱) (n : ℤ) : modeOp W u n ∈ modeAlgebra W :=
  Algebra.subset_adjoin ⟨u, n, rfl⟩

theorem modeAlgebra_smul_def (f : modeAlgebra W) (v : 𝒱) : f • v = (f : Module.End ℂ 𝒱) v := rfl

/-- Ideals are stable under the mode algebra. -/
theorem modeAlgebra_preserves {I : Submodule ℂ 𝒱} (hI : W.IsIdeal I) {f : Module.End ℂ 𝒱}
    (hf : f ∈ modeAlgebra W) : ∀ x ∈ I, f x ∈ I := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    obtain ⟨u, n, rfl⟩ := hf
    intro x hx
    exact hI u x n hx
  | algebraMap c =>
    intro x hx
    rw [Module.algebraMap_end_apply]
    exact I.smul_mem c hx
  | add f g _ _ hf hg => intro x hx; exact I.add_mem (hf x hx) (hg x hx)
  | mul f g _ _ hf hg => intro x hx; exact hf _ (hg x hx)

/-- **`𝒱` is a simple module over the mode algebra** — a reformulation of `W.IsSimple`. -/
theorem isSimpleModule_modeAlgebra (hW : W.IsSimple) : IsSimpleModule (modeAlgebra W) 𝒱 := by
  haveI : Nontrivial 𝒱 := by
    rw [← Submodule.nontrivial_iff ℂ]
    exact nontrivial_of_ne _ _ hW.1
  refine { toNontrivial := inferInstance, eq_bot_or_eq_top := fun N => ?_ }
  have hI : W.IsIdeal (N.restrictScalars ℂ) := fun u v n hv =>
    N.smul_mem ⟨modeOp W u n, modeOp_mem_modeAlgebra u n⟩ hv
  rcases hW.2 _ hI with h | h
  · left
    rw [← Submodule.restrictScalars_eq_bot_iff ℂ]
    exact h
  · right
    rw [← Submodule.restrictScalars_eq_top_iff ℂ]
    exact h

/-- **Schur's lemma for a simple VOA**: a linear map commuting with all modes is a scalar. -/
theorem modeAlgebra_end_scalar (g : 𝒱 →ₗ[modeAlgebra W] 𝒱) :
    ∃ c : ℂ, ∀ v, g v = c • v := by
  have hcomm : ∀ (u : 𝒱) (n : ℤ) (v : 𝒱), g (W.smul u n v) = W.smul u n (g v) := fun u n v =>
    g.map_smul ⟨modeOp W u n, modeOp_mem_modeAlgebra u n⟩ v
  have hL : W.L 0 (g W.vacuum) = (0 : ℂ) • g W.vacuum := by
    have h0 := W.L0_grading W.vacuum W.vacuum_mem
    rw [VertexOperatorAlgebra.L_def, zero_add]
    have h1 := hcomm W.conformalVector 1 W.vacuum
    simp only [PreVertexAlgebra.smul_def] at h1
    rw [← h1, h0]
    simp
  have hmem : g W.vacuum ∈ W.grading 0 := by
    rw [VOA.Deform.grading_eq_L_zero_eigenspace, Module.End.mem_eigenspace_iff]
    exact_mod_cast hL
  rw [W.vacuum_grade, Submodule.mem_span_singleton] at hmem
  obtain ⟨c, hc⟩ := hmem
  refine ⟨c, fun v => ?_⟩
  have h1 : W.smul v (-1) W.vacuum = v := (W.creation v).1
  conv_lhs => rw [← h1]
  rw [hcomm, ← hc, PreVertexAlgebra.smul_smul_right, h1]

/-- **Jacobson density for the mode algebra of a simple VOA**: every `ℂ`-linear map agrees, on any
finite set, with an element of the mode algebra. -/
theorem exists_modeAlgebra_eq (hW : W.IsSimple) (F : 𝒱 →ₗ[ℂ] 𝒱) (s : Finset 𝒱) :
    ∃ f ∈ modeAlgebra W, ∀ m ∈ s, f m = F m := by
  haveI := isSimpleModule_modeAlgebra hW
  let F' : Module.End (Module.End (modeAlgebra W) 𝒱) 𝒱 :=
    { toFun := F
      map_add' := F.map_add
      map_smul' := fun g v => by
        obtain ⟨c, hc⟩ := modeAlgebra_end_scalar g
        simp only [RingHom.id_apply, Module.End.smul_def]
        rw [hc v, hc (F v), F.map_smul] }
  obtain ⟨r, hr⟩ := jacobson_density F' s
  exact ⟨r.1, r.2, fun m hm => (hr m hm).symm⟩

/-- Density, injective form: if `φ : E → 𝒱` is injective (`E` finite-dimensional), every
`ψ : E → 𝒱` is `f ∘ φ` for some `f` in the mode algebra. -/
theorem exists_modeAlgebra_comp_eq (hW : W.IsSimple) {E : Type*} [AddCommGroup E] [Module ℂ E]
    [FiniteDimensional ℂ E] {φ : E →ₗ[ℂ] 𝒱} (hφ : Function.Injective φ) (ψ : E →ₗ[ℂ] 𝒱) :
    ∃ f ∈ modeAlgebra W, f.comp φ = ψ := by
  classical
  obtain ⟨r, hr⟩ := φ.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr hφ)
  let b := Module.finBasis ℂ E
  obtain ⟨f, hf, hfF⟩ := exists_modeAlgebra_eq hW (ψ.comp r) (Finset.univ.image fun i => φ (b i))
  refine ⟨f, hf, b.ext fun i => ?_⟩
  rw [LinearMap.comp_apply, hfF _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)),
    LinearMap.comp_apply, ← LinearMap.comp_apply r φ, hr, LinearMap.id_apply]

/-! ## `Hom(E, 𝒱)` as a weak `W`-module -/

variable (W) in
/-- The state–field map of `Hom(E, 𝒱)`: `Y(u, z) ∘ –`. -/
def homYM (E : Type*) [AddCommGroup E] [Module ℂ E] :
    𝒱 →ₗ[ℂ] FormalDist (Module.End ℂ (E →ₗ[ℂ] 𝒱)) where
  toFun u := fun k => LinearMap.llcomp ℂ E 𝒱 𝒱 (W.Y u k)
  map_add' u v := by
    funext k
    apply LinearMap.ext; intro φ
    apply LinearMap.ext; intro e
    change W.Y (u + v) k (φ e) = W.Y u k (φ e) + W.Y v k (φ e)
    rw [map_add]; rfl
  map_smul' c u := by
    funext k
    apply LinearMap.ext; intro φ
    apply LinearMap.ext; intro e
    change W.Y (c • u) k (φ e) = c • W.Y u k (φ e)
    rw [map_smul]; rfl

theorem mode_homYM_apply {E : Type*} [AddCommGroup E] [Module ℂ E] (u : 𝒱) (n : ℤ)
    (φ : E →ₗ[ℂ] 𝒱) : mode (homYM W E u) n φ = (modeOp W u n).comp φ := rfl

/-- Uniform truncation on a finite-dimensional source. -/
theorem hom_truncation {E : Type*} [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E]
    (u : 𝒱) (φ : E →ₗ[ℂ] 𝒱) : ∃ N : ℤ, ∀ n : ℤ, N ≤ n → (modeOp W u n).comp φ = 0 := by
  classical
  let b := Module.finBasis ℂ E
  choose N hN using fun i => W.regularity u (φ (b i))
  refine ⟨∑ i, |N i|, fun n hn => b.ext fun i => ?_⟩
  simp only [LinearMap.comp_apply, LinearMap.zero_apply]
  refine hN i n (le_trans (le_abs_self _) (le_trans ?_ hn))
  exact Finset.single_le_sum (f := fun j => |N j|) (fun j _ => abs_nonneg (N j)) (Finset.mem_univ i)

variable (W) in
/-- **`Hom(E, 𝒱)` is a weak `W`-module** (finite-dimensional `E`), acting by post-composition. -/
def homModule (E : Type*) [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E] :
    WeakModule W (E →ₗ[ℂ] 𝒱) where
  YM := homYM W E
  vacuum_YM := by
    funext k
    apply LinearMap.ext; intro φ
    apply LinearMap.ext; intro e
    change W.Y W.vacuum k (φ e) = ((1 : FormalDist (Module.End ℂ (E →ₗ[ℂ] 𝒱))) k) φ e
    rw [W.vacuum_Y, FormalDist.one_apply, FormalDist.one_apply]
    split_ifs <;> rfl
  truncation u φ := hom_truncation u φ
  jacobi u v φ ℓ m n := by
    obtain ⟨Nv, hNv⟩ := hom_truncation (W := W) v φ
    obtain ⟨Nu, hNu⟩ := hom_truncation (W := W) u φ
    obtain ⟨R, hR⟩ := W.regularity u v
    have hL : (Function.support fun i : ℤ => (negOnePow i * cbz ℓ i) •
        (mode (homYM W E u) (ℓ + m - i) (mode (homYM W E v) (n + i) φ)
          - negOnePow ℓ • mode (homYM W E v) (ℓ + n - i) (mode (homYM W E u) (m + i) φ))).Finite := by
      refine VOA.Moonshine.SigmaExist.support_finite_of_vanish _ (max (Nv - n) (Nu - m))
        (fun i hi => by rw [cbz_apply_neg _ hi]; simp) ?_
      intro i hi
      rw [mode_homYM_apply v (n + i), hNv (n + i) (by omega), mode_homYM_apply u (m + i),
        hNu (m + i) (by omega)]
      simp
    have hR' : (Function.support fun i : ℤ =>
        cbz m i • mode (homYM W E (W.smul u (ℓ + i) v)) (m + n - i) φ).Finite := by
      refine VOA.Moonshine.SigmaExist.support_finite_of_vanish _ (max (R - ℓ) 0)
        (fun i hi => by rw [cbz_apply_neg _ hi]; simp) ?_
      intro i hi
      rw [show W.smul u (ℓ + i) v = 0 from hR (ℓ + i) (by omega), map_zero]
      simp only [smul_eq_zero]
      exact Or.inr rfl
    apply LinearMap.ext; intro e
    let ev : (E →ₗ[ℂ] 𝒱) →+ 𝒱 := (LinearMap.applyₗ (R := ℂ) e).toAddMonoidHom
    have h1 := ev.map_finsum hL
    have h2 := ev.map_finsum hR'
    simp only [ev, LinearMap.toAddMonoidHom_coe, LinearMap.applyₗ_apply_apply] at h1 h2
    rw [h1, h2]
    exact W.jacobi u v (φ e) ℓ m n

@[simp] theorem homModule_act {E : Type*} [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E]
    (u : 𝒱) (n : ℤ) (φ : E →ₗ[ℂ] 𝒱) : (homModule W E).act u n φ = (modeOp W u n).comp φ := rfl

/-- **Li's lemma, operator form**: for every `f` in the mode algebra and every `ψ` in the
single-mode span of `U ⊆ Hom(E, 𝒱)`, `f ∘ ψ` stays in that span. -/
theorem comp_mem_modeSpan {E : Type*} [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E]
    (U : Set (E →ₗ[ℂ] 𝒱)) {f : Module.End ℂ 𝒱} (hf : f ∈ modeAlgebra W) :
    ∀ ψ ∈ VOA.Moonshine.SigmaExist.modeSpan (homModule W E) U,
      f.comp ψ ∈ VOA.Moonshine.SigmaExist.modeSpan (homModule W E) U := by
  induction hf using Algebra.adjoin_induction with
  | mem f hf =>
    obtain ⟨u, n, rfl⟩ := hf
    intro ψ hψ
    exact VOA.Moonshine.SigmaExist.act_mem_modeSpan (homModule W E) U u n hψ
  | algebraMap c =>
    intro ψ hψ
    have : (algebraMap ℂ (Module.End ℂ 𝒱) c).comp ψ = c • ψ := by
      apply LinearMap.ext; intro e
      simp [Module.algebraMap_end_apply]
    rw [this]
    exact Submodule.smul_mem _ c hψ
  | add f g _ _ hf hg =>
    intro ψ hψ
    rw [LinearMap.add_comp]
    exact Submodule.add_mem _ (hf ψ hψ) (hg ψ hψ)
  | mul f g _ _ hf hg =>
    intro ψ hψ
    rw [Module.End.mul_eq_comp, LinearMap.comp_assoc]
    exact hf _ (hg ψ hψ)

/-! ## The averaging operator -/

/-- The mode `u ↦ u₍ₙ₎ v` as a linear function of `u`. -/
def smulLeft (W : VertexOperatorAlgebra 𝒱) (n : ℤ) (v : 𝒱) : 𝒱 →ₗ[ℂ] 𝒱 where
  toFun u := W.smul u n v
  map_add' a b := PreVertexAlgebra.smul_add_left _ a b n v
  map_smul' c a := PreVertexAlgebra.smul_smul_left _ c a n v

@[simp] theorem smulLeft_apply (n : ℤ) (v u : 𝒱) : smulLeft W n v u = W.smul u n v := rfl

variable (G : Subgroup (Aut W)) [Fintype G]

/-- The **Reynolds projection** `u ↦ |G|⁻¹ Σ_g g u` onto `W^G`. -/
def reynolds (u : 𝒱) : 𝒱 := (Fintype.card G : ℂ)⁻¹ • ∑ g : G, (g : Aut W) u

theorem reynolds_mem (u : 𝒱) : reynolds G u ∈ (orbifold G).carrier := by
  intro h hh
  have hsum : (h : Aut W) (∑ g : G, (g : Aut W) u) = ∑ g : G, (g : Aut W) u := by
    rw [← Aut.coe_toLinearEquiv, map_sum]
    exact Fintype.sum_equiv (Equiv.mulLeft ⟨h, hh⟩) _ _ (fun g => rfl)
  change h.toLinearEquiv ((Fintype.card G : ℂ)⁻¹ • ∑ g : G, (g : Aut W) u) = _
  rw [map_smul, Aut.coe_toLinearEquiv, hsum]
  rfl

/-- The **averaging operator** `χ ↦ |G|⁻¹ Σ_g g ∘ χ ∘ σ(g)⁻¹` on `Hom(E, 𝒱)`. -/
def avgHom {E : Type*} [AddCommGroup E] [Module ℂ E] (σ : Representation ℂ G E) :
    (E →ₗ[ℂ] 𝒱) →ₗ[ℂ] (E →ₗ[ℂ] 𝒱) :=
  (Fintype.card G : ℂ)⁻¹ • ∑ g : G,
    (LinearMap.llcomp ℂ E 𝒱 𝒱 (autRep G g)) ∘ₗ (LinearMap.lcomp ℂ 𝒱 (σ g⁻¹))

theorem avgHom_apply {E : Type*} [AddCommGroup E] [Module ℂ E] (σ : Representation ℂ G E)
    (χ : E →ₗ[ℂ] 𝒱) (e : E) :
    avgHom G σ χ e = (Fintype.card G : ℂ)⁻¹ • ∑ g : G, (g : Aut W) (χ (σ g⁻¹ e)) := by
  simp [avgHom, LinearMap.sum_apply]

/-- The average of a `G`-equivariant map is itself. -/
theorem avgHom_of_mem {E : Type*} [AddCommGroup E] [Module ℂ E] (σ : Representation ℂ G E)
    {χ : E →ₗ[ℂ] 𝒱} (hχ : χ ∈ multSpace G σ) : avgHom G σ χ = χ := by
  apply LinearMap.ext; intro e
  rw [avgHom_apply]
  have : ∀ g : G, (g : Aut W) (χ (σ g⁻¹ e)) = χ e := by
    intro g
    rw [hχ g, ← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
  simp only [this, Finset.sum_const, Finset.card_univ]
  rw [← Nat.cast_smul_eq_nsmul ℂ, smul_smul, inv_mul_cancel₀ (by exact_mod_cast Fintype.card_ne_zero),
    one_smul]

/-- The average of `u₍ₙ₎ ∘ χ` for `G`-equivariant `χ` is `(Ru)₍ₙ₎ ∘ χ`, `R` the Reynolds operator. -/
theorem avgHom_modeOp_comp {E : Type*} [AddCommGroup E] [Module ℂ E] (σ : Representation ℂ G E)
    {χ : E →ₗ[ℂ] 𝒱} (hχ : χ ∈ multSpace G σ) (u : 𝒱) (n : ℤ) :
    avgHom G σ ((modeOp W u n).comp χ) = (modeOp W (reynolds G u) n).comp χ := by
  apply LinearMap.ext; intro e
  rw [avgHom_apply]
  have : ∀ g : G, (g : Aut W) (((modeOp W u n).comp χ) (σ g⁻¹ e)) = smulLeft W n (χ e) ((g : Aut W) u) := by
    intro g
    simp only [LinearMap.comp_apply, modeOp_apply, smulLeft_apply]
    rw [Aut.map_smul, hχ g, ← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one,
      Module.End.one_apply]
  simp only [this]
  rw [← map_sum, ← map_smul]
  rfl

/-- The span of the `W^G`-modes applied to a set `U` of maps `E → 𝒱`. -/
def invSpan {E : Type*} [AddCommGroup E] [Module ℂ E] (U : Set (E →ₗ[ℂ] 𝒱)) :
    Submodule ℂ (E →ₗ[ℂ] 𝒱) :=
  Submodule.span ℂ {y | ∃ u ∈ (orbifold G).carrier, ∃ n : ℤ, ∃ χ ∈ U, y = (modeOp W u n).comp χ}

omit [Fintype G] in
/-- A `W^G`-mode-stable subspace containing `U` contains `invSpan U`. -/
theorem invSpan_le {E : Type*} [AddCommGroup E] [Module ℂ E] {U : Set (E →ₗ[ℂ] 𝒱)}
    {P : Submodule ℂ (E →ₗ[ℂ] 𝒱)} (hU : U ⊆ P) (hP : ModeStable G P) : invSpan G U ≤ P := by
  rw [invSpan, Submodule.span_le]
  rintro _ ⟨u, hu, n, χ, hχ, rfl⟩
  exact hP u hu n χ (hU hχ)

omit [Fintype G] in
theorem modeOp_comp_mem_invSpan {E : Type*} [AddCommGroup E] [Module ℂ E] {U : Set (E →ₗ[ℂ] 𝒱)}
    {u : 𝒱} (hu : u ∈ (orbifold G).carrier) (n : ℤ) {χ : E →ₗ[ℂ] 𝒱} (hχ : χ ∈ U) :
    (modeOp W u n).comp χ ∈ invSpan G U :=
  Submodule.subset_span ⟨u, hu, n, χ, hχ, rfl⟩

/-- The averaging operator maps the single-mode span of a set of equivariant maps into `invSpan`. -/
theorem avgHom_mem_invSpan {E : Type*} [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E]
    (σ : Representation ℂ G E) {U : Set (E →ₗ[ℂ] 𝒱)} (hU : U ⊆ multSpace G σ) {ξ : E →ₗ[ℂ] 𝒱}
    (hξ : ξ ∈ VOA.Moonshine.SigmaExist.modeSpan (homModule W E) U) :
    avgHom G σ ξ ∈ invSpan G U := by
  induction hξ using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨a, q, χ, hχ, rfl⟩ := hz
    rw [homModule_act, avgHom_modeOp_comp G σ (hU hχ)]
    exact modeOp_comp_mem_invSpan G (reynolds_mem G a) q hχ
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha

/-- **The averaging argument (DLM).**  If `χ`'s in `U` are `G`-equivariant, `f`'s lie in the mode
algebra, and `Σ fᵢ ∘ χᵢ` is again `G`-equivariant, then it lies in the span of the `W^G`-modes
applied to the `χ`'s. -/
theorem mem_invSpan_of_modeSpan {E : Type*} [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E]
    (σ : Representation ℂ G E) {U : Set (E →ₗ[ℂ] 𝒱)} (hU : U ⊆ multSpace G σ) {ξ : E →ₗ[ℂ] 𝒱}
    (hξ : ξ ∈ VOA.Moonshine.SigmaExist.modeSpan (homModule W E) U) (hξG : ξ ∈ multSpace G σ) :
    ξ ∈ invSpan G U := by
  rw [← avgHom_of_mem G σ hξG]
  exact avgHom_mem_invSpan G σ hU hξ

/-- Single-generator form: `f ∘ χ` equivariant (`f` in the mode algebra, `χ` equivariant) lies in
`invSpan {χ}`. -/
theorem mem_invSpan_of_comp {E : Type*} [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E]
    (σ : Representation ℂ G E) {χ : E →ₗ[ℂ] 𝒱} (hχ : χ ∈ multSpace G σ) {f : Module.End ℂ 𝒱}
    (hf : f ∈ modeAlgebra W) (hfχ : f.comp χ ∈ multSpace G σ) : f.comp χ ∈ invSpan G {χ} := by
  refine mem_invSpan_of_modeSpan G σ (Set.singleton_subset_iff.mpr hχ) ?_ hfχ
  exact comp_mem_modeSpan {χ} hf χ
    (VOA.Moonshine.SigmaExist.subset_modeSpan (homModule W E) {χ} rfl)

end VOA.Huang.SchurWeyl
