import VOA.Modules.WeakModule
import Mathlib.RingTheory.SimpleModule.Basic

/-!
# Completely reducible weak modules as semisimple modules over the mode algebra

For a weak `V`-module `A` on `M`, the **mode algebra** `modeAlg A ⊆ End_ℂ M` is the subalgebra
generated by all modes `u₍ₙ₎`.  Weak submodules of `A` are exactly the `modeAlg A`-submodules of
`M` (`toSub`, `ofSub`), so "every weak submodule has a weak complement" is exactly Mathlib's
`IsSemisimpleModule (modeAlg A) M` (`isSemisimpleModule_of_compl`).  This imports the whole of
Mathlib's semisimple-module theory (atomicity, independent families of simple submodules) into
the VOA setting without any new Zorn argument.

* `restrict` — the weak module structure on a mode-stable subspace (`Stable`);
* `isSemisimpleModule_of_compl`;
* `irreducible_restrict_of_simple` — a simple `modeAlg A`-submodule is an irreducible weak
  module;
* `exists_finite_decomp` — if, in addition, every independent family of simple submodules
  is finite, `M` is a **finite** internal direct sum of simple submodules, with mode-equivariant
  projections `π j` and `Σ_j π j = id`.

Pure algebra; no VOA-specific input beyond the definition of a weak module.

## Status
No `sorry`, no new axioms.
-/

namespace VOA.Huang.PzTensorSemisimple

open VOA
open Module (End)
open scoped BigOperators

universe u v

variable {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱] {W : VertexOperatorAlgebra 𝒱}
variable {M : Type v} [AddCommGroup M] [Module ℂ M]

/-! ## Finite sums through a submodule -/

/-- Coercion commutes with `finsum` out of a submodule (finite support or not). -/
theorem coe_finsum_submodule {ι : Type*} {N : Submodule ℂ M} (f : ι → N) :
    ((∑ᶠ i, f i : N) : M) = ∑ᶠ i, (f i : M) := by
  have hs : (Function.support fun i => (f i : M)) = Function.support f := by
    ext i; simp only [Function.mem_support, ne_eq, ZeroMemClass.coe_eq_zero]
  by_cases h : (Function.support f).Finite
  · have := map_finsum N.subtype h
    simpa using this
  · rw [finsum_of_infinite_support h, finsum_of_infinite_support (by rwa [hs])]
    rfl

/-! ## Restriction to a mode-stable subspace -/

variable (A : WeakModule W M)

/-- A subspace stable under all modes. -/
def Stable (N : Submodule ℂ M) : Prop :=
  ∀ (u : 𝒱) (n : ℤ) ⦃x : M⦄, x ∈ N → mode (A.YM u) n x ∈ N

theorem stable_coeff {N : Submodule ℂ M} (hN : Stable A N) (u : 𝒱) (p : ℤ) ⦃x : M⦄
    (hx : x ∈ N) : A.YM u p x ∈ N := by
  have := hN u (-p - 1) hx
  rwa [mode_apply, show -(-p - 1) - 1 = p by ring] at this

/-- The field map restricted to a stable subspace. -/
noncomputable def restrictYM (N : Submodule ℂ M) (hN : Stable A N) :
    𝒱 →ₗ[ℂ] (End ℂ N)⟦z^±⟧ where
  toFun u := fun p => (A.YM u p).restrict (fun _ hx => stable_coeff A hN u p hx)
  map_add' u v := by
    refine FormalDist.ext fun p => ?_
    ext x
    change (A.YM (u + v) p) x = (A.YM u p) x + (A.YM v p) x
    rw [map_add]; rfl
  map_smul' c u := by
    refine FormalDist.ext fun p => ?_
    ext x
    change (A.YM (c • u) p) x = c • (A.YM u p) x
    rw [map_smul]; rfl

@[simp] theorem restrictYM_coe (N : Submodule ℂ M) (hN : Stable A N) (u : 𝒱) (n : ℤ) (x : N) :
    ((mode (restrictYM A N hN u) n x : N) : M) = mode (A.YM u) n x := rfl

/-- **The weak module on a mode-stable subspace.** -/
noncomputable def restrict (N : Submodule ℂ M) (hN : Stable A N) : WeakModule W N where
  YM := restrictYM A N hN
  vacuum_YM := by
    refine FormalDist.ext fun p => ?_
    ext x
    change (A.YM W.vacuum p) x = ((1 : (End ℂ N)⟦z^±⟧) p x : M)
    rw [A.vacuum_YM]
    by_cases hp : p = 0
    · subst hp
      have h1 : ((1 : (End ℂ M)⟦z^±⟧) 0) = 1 := by
        simp
      have h2 : ((1 : (End ℂ N)⟦z^±⟧) 0) = 1 := by
        simp
      rw [h1, h2]; rfl
    · have h1 : ((1 : (End ℂ M)⟦z^±⟧) p) = 0 := by
        have := mode_one (𝒲 := End ℂ M) (-p - 1)
        rw [mode_apply, show -(-p - 1) - 1 = p by ring, if_neg (by omega)] at this
        exact this
      have h2 : ((1 : (End ℂ N)⟦z^±⟧) p) = 0 := by
        have := mode_one (𝒲 := End ℂ N) (-p - 1)
        rw [mode_apply, show -(-p - 1) - 1 = p by ring, if_neg (by omega)] at this
        exact this
      rw [h1, h2]; rfl
  truncation u x := by
    obtain ⟨K, hK⟩ := A.truncation u x
    exact ⟨K, fun n hn => Subtype.ext (by rw [restrictYM_coe]; exact hK n hn)⟩
  jacobi u v x ell m n := by
    apply Subtype.ext
    rw [coe_finsum_submodule, coe_finsum_submodule]
    have h := A.jacobi u v x ell m n
    simp only [Submodule.coe_smul, Submodule.coe_sub, restrictYM_coe]
    exact h

@[simp] theorem restrict_mode_coe (N : Submodule ℂ M) (hN : Stable A N) (u : 𝒱) (n : ℤ)
    (x : N) : ((mode ((restrict A N hN).YM u) n x : N) : M) = mode (A.YM u) n x := rfl

/-! ## The mode algebra -/

/-- The **mode algebra**: the subalgebra of `End_ℂ M` generated by all modes. -/
noncomputable def modeAlg : Subalgebra ℂ (End ℂ M) :=
  Algebra.adjoin ℂ (Set.range fun p : 𝒱 × ℤ => mode (A.YM p.1) p.2)

theorem mode_mem_modeAlg (u : 𝒱) (n : ℤ) : mode (A.YM u) n ∈ modeAlg A :=
  Algebra.subset_adjoin ⟨(u, n), rfl⟩

/-- The mode as an element of the mode algebra. -/
noncomputable def modeElt (u : 𝒱) (n : ℤ) : modeAlg A := ⟨mode (A.YM u) n, mode_mem_modeAlg A u n⟩

theorem modeElt_smul (u : 𝒱) (n : ℤ) (x : M) : modeElt A u n • x = mode (A.YM u) n x := rfl

/-- A mode-stable subspace is stable under the whole mode algebra. -/
theorem stable_modeAlg {N : Submodule ℂ M} (hN : Stable A N) (r : modeAlg A) {x : M}
    (hx : x ∈ N) : (r : End ℂ M) x ∈ N := by
  obtain ⟨r, hr⟩ := r
  induction hr using Algebra.adjoin_induction generalizing x with
  | mem a ha =>
      obtain ⟨⟨u, n⟩, rfl⟩ := ha
      exact hN u n hx
  | algebraMap c =>
      rw [Module.algebraMap_end_apply]
      exact N.smul_mem c hx
  | add a b _ _ ha hb =>
      rw [LinearMap.add_apply]
      exact N.add_mem (ha hx) (hb hx)
  | mul a b _ _ ha hb =>
      rw [Module.End.mul_apply]
      exact ha (hb hx)

/-- A weak submodule as a `modeAlg`-submodule. -/
noncomputable def toSub (P : WeakModule.Submodule' A) : Submodule (modeAlg A) M where
  carrier := P.carrier
  add_mem' := P.carrier.add_mem
  zero_mem' := P.carrier.zero_mem
  smul_mem' r _ hx := stable_modeAlg A (fun u n _ hy => P.act_mem u n hy) r hx

/-- A `modeAlg`-submodule as a weak submodule. -/
noncomputable def ofSub (N : Submodule (modeAlg A) M) : WeakModule.Submodule' A where
  carrier := N.restrictScalars ℂ
  act_mem u n _ hx := N.smul_mem (modeElt A u n) hx

@[simp] theorem mem_toSub (P : WeakModule.Submodule' A) (x : M) : x ∈ toSub A P ↔ x ∈ P.carrier :=
  Iff.rfl

@[simp] theorem mem_ofSub (N : Submodule (modeAlg A) M) (x : M) : x ∈ (ofSub A N).carrier ↔ x ∈ N :=
  Iff.rfl

theorem toSub_ofSub (N : Submodule (modeAlg A) M) : toSub A (ofSub A N) = N := by
  ext x; rfl

/-- `modeAlg`-submodules are stable. -/
theorem stable_of_sub (N : Submodule (modeAlg A) M) : Stable A (N.restrictScalars ℂ) :=
  fun u n _ hx => N.smul_mem (modeElt A u n) hx

/-- **Complete reducibility is semisimplicity over the mode algebra.** -/
theorem isSemisimpleModule_of_compl
    (hCR : ∀ P : WeakModule.Submodule' A, ∃ Q : WeakModule.Submodule' A,
      IsCompl P.carrier Q.carrier) :
    IsSemisimpleModule (modeAlg A) M := by
  refine { exists_isCompl := fun N => ?_ }
  obtain ⟨Q, hQ⟩ := hCR (ofSub A N)
  refine ⟨toSub A Q, ?_, ?_⟩
  · rw [disjoint_iff, eq_bot_iff]
    intro x hx
    have hx' : x ∈ (ofSub A N).carrier ⊓ Q.carrier := hx
    rw [hQ.inf_eq_bot] at hx'
    exact hx'
  · rw [codisjoint_iff, eq_top_iff]
    intro x _
    have hx : x ∈ (ofSub A N).carrier ⊔ Q.carrier := by rw [hQ.sup_eq_top]; trivial
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
    exact Submodule.mem_sup.mpr ⟨y, hy, z, hz, rfl⟩

/-! ## Simple submodules are irreducible weak modules -/

/-- A stable subspace as a `modeAlg`-submodule. -/
noncomputable def liftSub (N : Submodule ℂ M) (hN : Stable A N) : Submodule (modeAlg A) M where
  carrier := N
  add_mem' := N.add_mem
  zero_mem' := N.zero_mem
  smul_mem' r _ hx := stable_modeAlg A hN r hx

/-- An atom of the `modeAlg`-submodule lattice carries an irreducible weak module. -/
theorem irreducible_restrict_of_atom (N : Submodule (modeAlg A) M) (hN : IsAtom N) :
    Nontrivial (N.restrictScalars ℂ) ∧ ∀ P : WeakModule.Submodule'
      (restrict A (N.restrictScalars ℂ) (stable_of_sub A N)), P.carrier = ⊥ ∨ P.carrier = ⊤ := by
  refine ⟨?_, fun P => ?_⟩
  · obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hN.1
    exact ⟨⟨⟨x, hx⟩, 0, fun h => hx0 (congrArg Subtype.val h)⟩⟩
  set K := Submodule.map (N.restrictScalars ℂ).subtype P.carrier with hK
  have hst : Stable A K := by
    intro u n y hy
    obtain ⟨y', hy', rfl⟩ := hy
    exact ⟨mode ((restrict A (N.restrictScalars ℂ) (stable_of_sub A N)).YM u) n y',
      P.act_mem u n hy', rfl⟩
  have hle : liftSub A K hst ≤ N := by
    intro y hy
    obtain ⟨y', _, rfl⟩ := hy
    exact y'.2
  rcases hle.lt_or_eq with hlt | heq
  · left
    have hb := hN.2 _ hlt
    rw [eq_bot_iff]
    intro x hx
    have : (x : M) ∈ liftSub A K hst := ⟨x, hx, rfl⟩
    rw [hb] at this
    exact (Submodule.mem_bot ℂ).mpr (Subtype.ext ((Submodule.mem_bot _).mp this))
  · right
    rw [eq_top_iff]
    intro x _
    have : (x : M) ∈ liftSub A K hst := by rw [heq]; exact x.2
    obtain ⟨y, hy, hyx⟩ := this
    have : y = x := Subtype.ext hyx
    rw [← this]; exact hy

/-! ## Finite decomposition -/

/-- **Finite decomposition into simple summands.**  If `M` is semisimple over the mode
algebra and every independent family of simple submodules is finite, then `M` is a finite internal
direct sum of simple (atomic) submodules `S j`, with mode-equivariant `ℂ`-linear projections
`π j : M → S j ⊆ M` and `Σ_j π j = id`. -/
theorem exists_finite_decomp [IsSemisimpleModule (modeAlg A) M]
    (hfin : ∀ s : Set (Submodule (modeAlg A) M), sSupIndep s → (∀ m ∈ s, IsAtom m) → s.Finite) :
    ∃ (r : ℕ) (S : Fin r → Submodule (modeAlg A) M) (π : Fin r → M →ₗ[ℂ] M),
      (∀ j, IsAtom (S j)) ∧ iSupIndep S ∧ (∀ j x, π j x ∈ S j) ∧
      (∀ j (u : 𝒱) (n : ℤ) (x : M), π j (mode (A.YM u) n x) = mode (A.YM u) n (π j x)) ∧
      ∀ x : M, ∑ j, π j x = x := by
  classical
  obtain ⟨s, hind, htop, hsimp⟩ :=
    IsSemisimpleModule.exists_sSupIndep_sSup_simples_eq_top (modeAlg A) M
  have hatom : ∀ m ∈ s, IsAtom m := fun m hm => (isSimpleModule_iff_isAtom).mp (hsimp m hm)
  have hs := hfin s hind hatom
  haveI := hs.to_subtype
  let e := Finite.equivFin s
  let S : Fin (Nat.card s) → Submodule (modeAlg A) M := fun j => (e.symm j).1
  have hindS : iSupIndep S := by
    have h1 : iSupIndep (fun m : s => m.1) := (sSupIndep_iff s).mp hind
    exact h1.comp e.symm.injective
  have htopS : iSup S = ⊤ := by
    rw [← htop, sSup_eq_iSup']
    exact (e.symm.iSup_comp (g := fun m : s => m.1))
  have hint : DirectSum.IsInternal S :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hindS htopS
  let E := LinearEquiv.ofBijective (DirectSum.coeLinearMap S) hint
  let πR : Fin (Nat.card s) → M →ₗ[modeAlg A] M := fun j =>
    (S j).subtype ∘ₗ (DirectSum.component (modeAlg A) _ _ j) ∘ₗ E.symm.toLinearMap
  refine ⟨Nat.card s, S, fun j => (πR j).restrictScalars ℂ, fun j => hatom _ (e.symm j).2, hindS,
    fun j x => ?_, fun j u n x => ?_, fun x => ?_⟩
  · exact Submodule.coe_mem _
  · exact (πR j).map_smul (modeElt A u n) x
  · have hx : DirectSum.coeLinearMap S (E.symm x) = x := E.apply_symm_apply x
    conv_rhs => rw [← hx]
    rw [DirectSum.coeLinearMap_eq_dfinsuppSum, DFinsupp.sum_eq_sum_fintype _ (fun _ => rfl)]
    rfl

end VOA.Huang.PzTensorSemisimple
