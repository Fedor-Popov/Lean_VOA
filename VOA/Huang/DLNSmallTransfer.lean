import VOA.Huang.DLNSchurSix

/-!
# Homology-free transfer criteria for the Schur condition

For a central extension `π : E ↠ Q` and a Schur-trivial subgroup `H ≤ Q` of finite index,
every element of `[E,E] ∩ ker π` has order dividing `[Q : H]`. This is the homology-free
form of "the restriction `H₂(Q) → H₂(H)` composed with corestriction is multiplication by
the index". It is proved with Mathlib's transfer `MonoidHom.transfer`.

Consequences proved here:

* two Schur-trivial subgroups of coprime index make `Q` Schur-trivial;
* cyclic groups are Schur-trivial;
* a quaternion-type two-generator criterion.
-/

namespace VOA.Huang.DLNSchur

open VOA.Huang.DLNBeyl
open scoped commutatorElement

/-- **Transfer bound.** In a central extension of `Q`, every element of the derived
subgroup lying in the kernel is killed by the index of any Schur-trivial subgroup. -/
theorem pow_index_eq_one_of_schurTrivial_subgroup {Q E : Type} [Group Q] [Group E]
    (H : Subgroup Q) [H.FiniteIndex] (hH : SchurTrivial H)
    (π : E →* Q) (hs : Function.Surjective π) (hc : π.ker ≤ Subgroup.center E)
    (x : E) (hx : x ∈ commutator E) (hπx : π x = 1) : x ^ H.index = 1 := by
  set EH : Subgroup E := H.comap π with hEH
  have hidx : EH.index = H.index := Subgroup.index_comap_of_surjective H hs
  haveI : EH.FiniteIndex := ⟨by rw [hidx]; exact Subgroup.FiniteIndex.index_ne_zero⟩
  have hxc : x ∈ Subgroup.center E := hc hπx
  have hxmem : x ^ EH.index ∈ EH := by
    change π (x ^ EH.index) ∈ H
    rw [map_pow, hπx, one_pow]
    exact H.one_mem
  let φ : EH →* Abelianization EH := Abelianization.of
  have hV : φ.transfer x = 1 :=
    Abelianization.commutator_subset_ker (φ.transfer) hx
  have hpow : φ.transfer x = φ ⟨x ^ EH.index, hxmem⟩ := by
    rw [MonoidHom.transfer_eq_pow]
    intro k g₀ _
    have hk : x ^ k ∈ Subgroup.center E := Subgroup.pow_mem _ hxc k
    rw [mul_assoc, ← Subgroup.mem_center_iff.mp hk g₀]
    group
  rw [hpow] at hV
  have hcomm : (⟨x ^ EH.index, hxmem⟩ : EH) ∈ commutator EH := by
    rw [← Abelianization.ker_of]; exact hV
  -- Apply the Schur condition to the restricted extension `EH ↠ H`.
  have hcrit := (schurTrivial_iff_centralDerivedInjective H).mp hH
  let πH : EH →* H := π.subgroupComap H
  have hsH : Function.Surjective πH := π.subgroupComap_surjective_of_surjective H hs
  have hcH : πH.ker ≤ Subgroup.center EH := by
    intro y hy
    rw [Subgroup.mem_center_iff]
    intro w
    have hy' : (y : E) ∈ Subgroup.center E :=
      hc (show π y = 1 from congrArg Subtype.val (MonoidHom.mem_ker.mp hy))
    exact Subtype.ext (Subgroup.mem_center_iff.mp hy' w)
  have h1 := hcrit EH πH hsH hcH _ hcomm (by
    apply Subtype.ext
    change π (x ^ EH.index) = 1
    rw [map_pow, hπx, one_pow])
  have := congrArg Subtype.val h1
  simpa [hidx] using this

/-- **Coprime-index criterion.** Two Schur-trivial subgroups of coprime finite index make the
ambient group Schur-trivial. -/
theorem schurTrivial_of_coprime_index {Q : Type} [Group Q] (H K : Subgroup Q)
    [H.FiniteIndex] [K.FiniteIndex] (hH : SchurTrivial H) (hK : SchurTrivial K)
    (hcop : Nat.Coprime H.index K.index) : SchurTrivial Q := by
  apply (schurTrivial_iff_centralDerivedInjective Q).mpr
  intro E _ π hs hc x hx hπx
  have h1 := pow_index_eq_one_of_schurTrivial_subgroup H hH π hs hc x hx hπx
  have h2 := pow_index_eq_one_of_schurTrivial_subgroup K hK π hs hc x hx hπx
  have := (pow_gcd_eq_one (a := x)).mpr ⟨h1, h2⟩
  rwa [hcop.gcd_eq_one, pow_one] at this

/-- A central extension of a cyclic group is abelian, so cyclic groups are Schur-trivial. -/
theorem schurTrivial_of_isCyclic (Q : Type) [Group Q] [IsCyclic Q] : SchurTrivial Q := by
  apply (schurTrivial_iff_centralDerivedInjective Q).mpr
  intro E _ π hs hc x hx _
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Q)
  obtain ⟨a, ha⟩ := hs g
  have hcomm : ∀ e d : E, Commute e d := by
    have hform : ∀ e : E, ∃ z ∈ Subgroup.center E, ∃ n : ℤ, e = z * a ^ n := by
      intro e
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hg (π e))
      refine ⟨e * (a ^ n)⁻¹, hc ?_, n, by group⟩
      simp [MonoidHom.mem_ker, ha, hn]
    intro e d
    obtain ⟨z, hz, n, rfl⟩ := hform e
    obtain ⟨w, hw, m, rfl⟩ := hform d
    have hzc : ∀ y, Commute z y := fun y => (Subgroup.mem_center_iff.mp hz y).symm
    have hwc : ∀ y, Commute y w := fun y => Subgroup.mem_center_iff.mp hw y
    exact (hzc _).mul_left ((hwc _).mul_right ((Commute.refl a).zpow_zpow n m))
  have : commutator E = ⊥ := by
    rw [commutator_eq_closure, Subgroup.closure_eq_bot_iff]
    rintro _ ⟨e, d, rfl⟩
    exact (hcomm e d).commutator_eq
  rw [this] at hx
  exact hx

/-- If every element is central times `a^i b^j` and `c = ⁅a,b⁆` is central, then the derived
subgroup is contained in the cyclic group generated by `c`. -/
theorem commutator_le_zpowers_of_normal_forms {E : Type*} [Group E] (a b : E)
    (hcz : ⁅a, b⁆ ∈ Subgroup.center E)
    (hnf : ∀ e : E, ∃ z ∈ Subgroup.center E, ∃ i j : ℕ, e = z * (a ^ i * b ^ j)) :
    commutator E ≤ Subgroup.zpowers ⁅a, b⁆ := by
  set c := ⁅a, b⁆ with hc
  let K := Subgroup.zpowers c
  haveI : K.Normal := by
    constructor
    intro n hn g
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hn
    have hcm : c ^ m ∈ Subgroup.center E := Subgroup.zpow_mem _ hcz m
    rw [Subgroup.mem_center_iff.mp hcm g, mul_inv_cancel_right]
    exact Subgroup.zpow_mem_zpowers c m
  let f : E →* E ⧸ K := QuotientGroup.mk' K
  have hfab : Commute (f a) (f b) := by
    have h1 : f c = 1 := (QuotientGroup.eq_one_iff c).mpr (Subgroup.mem_zpowers c)
    rw [hc, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm] at h1
    exact h1
  have hfz : ∀ z ∈ Subgroup.center E, ∀ y : E ⧸ K, Commute (f z) y := by
    intro z hz y
    obtain ⟨e, rfl⟩ := QuotientGroup.mk'_surjective K y
    exact ((show Commute z e from (Subgroup.mem_center_iff.mp hz e).symm).map f)
  have hfcomm : ∀ e d : E, Commute (f e) (f d) := by
    intro e d
    obtain ⟨z, hz, i, j, rfl⟩ := hnf e
    obtain ⟨w, hw, k, l, rfl⟩ := hnf d
    simp only [map_mul, map_pow]
    refine Commute.mul_left (hfz z hz _) (Commute.mul_right ((hfz w hw _).symm) ?_)
    exact Commute.mul_left (Commute.mul_right ((Commute.refl _).pow_pow i k)
        (hfab.pow_pow i l))
      (Commute.mul_right (hfab.symm.pow_pow j k) ((Commute.refl _).pow_pow j l))
  rw [commutator_eq_closure, Subgroup.closure_le]
  rintro _ ⟨e, d, rfl⟩
  apply (QuotientGroup.eq_one_iff _).mp
  change f ⁅e, d⁆ = 1
  rw [map_commutatorElement]
  exact (hfcomm e d).commutator_eq

/-- **Quaternion criterion.** If `Q` has elements `s,t` with `s² = t²`, `t s t⁻¹ = s⁻¹`,
`s² ≠ 1`, and every element is `s^i t^j`, then `Q` is Schur-trivial. -/
theorem schurTrivial_of_quaternion_normal_forms {Q : Type} [Group Q] (s t : Q)
    (hst : s ^ 2 = t ^ 2) (hconj : t * s * t⁻¹ = s⁻¹) (hs2 : s ^ 2 ≠ 1)
    (hnf : ∀ q : Q, ∃ i j : ℕ, q = s ^ i * t ^ j) : SchurTrivial Q := by
  apply (schurTrivial_iff_centralDerivedInjective Q).mpr
  intro E _ π hπ hc x hx hxπ
  obtain ⟨a, ha⟩ := hπ s
  obtain ⟨b, hb⟩ := hπ t
  have hnfa : ∀ e : E, ∃ z ∈ Subgroup.center E, ∃ i j : ℕ, e = z * (a ^ i * b ^ j) := by
    intro e
    obtain ⟨i, j, hij⟩ := hnf (π e)
    refine ⟨e * (a ^ i * b ^ j)⁻¹, hc ?_, i, j, by group⟩
    simp [MonoidHom.mem_ker, ha, hb, hij]
  have hcen : ∀ y : E, (∀ e : E, Commute y e) → y ∈ Subgroup.center E := by
    intro y hy
    exact Subgroup.mem_center_iff.mpr (fun e => (hy e).symm)
  -- `a²` is central.
  have hz0 : a ^ 2 * (b ^ 2)⁻¹ ∈ Subgroup.center E := hc (by
    simp [MonoidHom.mem_ker, ha, hb, hst])
  have ha2b : Commute (a ^ 2) b := by
    have : a ^ 2 = (a ^ 2 * (b ^ 2)⁻¹) * b ^ 2 := by group
    rw [this]
    exact Commute.mul_left (Subgroup.mem_center_iff.mp hz0 b).symm
      ((Commute.refl b).pow_left 2)
  have ha2 : a ^ 2 ∈ Subgroup.center E := by
    apply hcen
    intro e
    obtain ⟨z, hz, i, j, rfl⟩ := hnfa e
    exact Commute.mul_right (Subgroup.mem_center_iff.mp hz _)
      (Commute.mul_right ((Commute.refl a).pow_pow 2 i) (ha2b.pow_right j))
  -- `w = b a b⁻¹ a` is central.
  have hw : b * a * b⁻¹ * a ∈ Subgroup.center E := hc (by
    simp [MonoidHom.mem_ker, ha, hb, hconj])
  set w := b * a * b⁻¹ * a with hwdef
  have hcomm_eq : ⁅a, b⁆ = a ^ 2 * w⁻¹ := by
    simp only [commutatorElement_def, hwdef]; group
  have hcz : ⁅a, b⁆ ∈ Subgroup.center E := by
    rw [hcomm_eq]; exact mul_mem ha2 (inv_mem hw)
  have hbab : b * a * b⁻¹ = w * a⁻¹ := by simp only [hwdef]; group
  have ha4 : a ^ 4 = w ^ 2 := by
    have h1 : b * a ^ 2 * b⁻¹ = a ^ 2 := by
      rw [← ha2b.eq]; group
    have h2 : b * a ^ 2 * b⁻¹ = (w * a⁻¹) ^ 2 := by
      rw [← hbab, pow_two, pow_two]; group
    have hwa : Commute w a⁻¹ := (Subgroup.mem_center_iff.mp hw a⁻¹).symm
    rw [h2, hwa.mul_pow] at h1
    calc a ^ 4 = a ^ 2 * a ^ 2 := by group
      _ = a ^ 2 * (w ^ 2 * a⁻¹ ^ 2) := by rw [h1]
      _ = w ^ 2 := by
        rw [← mul_assoc, ((Subgroup.mem_center_iff.mp ha2 (w ^ 2))).symm]; group
  have hc2 : ⁅a, b⁆ ^ 2 = 1 := by
    rw [hcomm_eq]
    have hwa2 : Commute (a ^ 2) w⁻¹ := (Subgroup.mem_center_iff.mp ha2 w⁻¹).symm
    rw [hwa2.mul_pow, ← pow_mul, show 2 * 2 = 4 from rfl, ha4]; group
  have hπc : π ⁅a, b⁆ = s ^ 2 := by
    rw [map_commutatorElement, ha, hb, commutatorElement_def]
    have : t * s⁻¹ * t⁻¹ = s := by
      have := congrArg (·⁻¹) hconj; simpa [mul_assoc] using this
    calc s * t * s⁻¹ * t⁻¹ = s * (t * s⁻¹ * t⁻¹) := by group
      _ = s ^ 2 := by rw [this, pow_two]
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp
    (commutator_le_zpowers_of_normal_forms a b hcz hnfa hx)
  have hc2' : ⁅a, b⁆ ^ (2 : ℤ) = 1 := by exact_mod_cast hc2
  rcases Int.emod_two_eq_zero_or_one n with h | h
  · rw [← Int.emod_add_mul_ediv n 2, h, zero_add, zpow_mul, hc2', one_zpow]
  · exfalso
    apply hs2
    have hx1 : ⁅a, b⁆ ^ n = ⁅a, b⁆ := by
      rw [← Int.emod_add_mul_ediv n 2, h, zpow_add, zpow_mul, hc2', one_zpow, mul_one,
        zpow_one]
    rw [hx1, hπc] at hxπ
    exact hxπ

end VOA.Huang.DLNSchur
