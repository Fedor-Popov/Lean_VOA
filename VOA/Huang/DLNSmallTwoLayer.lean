import VOA.Huang.DLNSmallTwoCover
import VOA.Huang.DLNSmallThreeGen

/-!
# Matrix facts for the two-adic layer `SL₂(ℤ/2^{a+1}) → SL₂(ℤ/2^a)`

`a ≥ 1`, `R = ℤ/2^{a+1}`, `q = 2^a` (so `q² = 0`, `2q = 0`).

* the layer `N` is `{1 + q W}`, of exponent 2, generated by `x(q)`, `y(q)` and the central
  scalar `ε = diag(1+q, 1+q)`;
* the level-one kernel `K₁ = ker(R → ℤ/2)` is generated by `x(2)`, `y(2)`, `-1`, and commutes
  with `N`;
* the conjugation average over `C₃ = {g ∈ SL₂(ℤ/2) | g³ = 1}` sends `N` into `{1, ε}`.
-/

namespace VOA.Huang.DLNSchur

open VOA.Huang.DLNBeyl

section TwoElements

variable (a : ℕ)

/-- The unit `1 + 2^a` of `ℤ/2^{a+1}`. -/
noncomputable def epsU : (ZMod (2 ^ (a + 1)))ˣ :=
  ZMod.unitOfCoprime (1 + 2 * 2 ^ (a - 1)) (by
    apply Nat.Coprime.pow_right
    exact Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).mpr (by omega)))

/-- The unit `-1`. -/
noncomputable def negOneU : (ZMod (2 ^ (a + 1)))ˣ := -1

/-- `x(2^a)`. -/
abbrev nE2 : SLT a := upperRoot ((2 : ZMod (2 ^ (a + 1))) ^ a)
/-- `y(2^a)`. -/
abbrev nF2 : SLT a := lowerRoot ((2 : ZMod (2 ^ (a + 1))) ^ a)
/-- `ε = diag(1 + 2^a, (1 + 2^a)⁻¹)`. -/
noncomputable abbrev eps2 : SLT a := torus (epsU a)
/-- `x(2)`. -/
abbrev x2 : SLT a := upperRoot 2
/-- `y(2)`. -/
abbrev y2 : SLT a := lowerRoot 2
/-- `-1`. -/
noncomputable abbrev mI2 : SLT a := torus (negOneU a)

/-- The level-one kernel `ker(SL₂(ℤ/2^{a+1}) → SL₂(ℤ/2))`. -/
noncomputable abbrev levelOneTwo : Subgroup (SLT a) := (rhoTwoOne a).ker

variable {a}

theorem epsU_val (ha : 1 ≤ a) :
    ((epsU a : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1))) = 1 + 2 ^ a := by
  simp only [epsU, ZMod.coe_unitOfCoprime]
  push_cast
  rw [← pow_succ']; congr 2; omega

theorem epsU_inv_val (ha : 1 ≤ a) :
    (((epsU a)⁻¹ : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1))) = 1 + 2 ^ a := by
  rw [inv_val_of_sq_zero _ (two_pow_mul_self ha) _ (epsU_val ha)]
  linear_combination -(two_mul_two_pow a)

theorem mem_levelOneTwo_iff (g : SLT a) :
    g ∈ levelOneTwo a ↔ ∃ V : Matrix (Fin 2) (Fin 2) (ZMod (2 ^ (a + 1))),
      (g : Matrix (Fin 2) (Fin 2) (ZMod (2 ^ (a + 1)))) = 1 + (2 : ZMod (2 ^ (a + 1))) • V := by
  rw [mem_ker_reductionMod_iff]
  push_cast
  rfl

theorem layerTwo_le_levelOne (ha : 1 ≤ a) : (rhoTwo a).ker ≤ levelOneTwo a := by
  intro n hn
  obtain ⟨W, hW⟩ := (mem_ker_rhoTwo_iff n).mp hn
  refine (mem_levelOneTwo_iff n).mpr ⟨(2 : ZMod (2 ^ (a + 1))) ^ (a - 1) • W, ?_⟩
  rw [hW, smul_smul, ← pow_succ']
  congr 3; omega

theorem layerTwo_sq (ha : 1 ≤ a) {n : SLT a} (hn : n ∈ (rhoTwo a).ker) : n ^ 2 = 1 := by
  obtain ⟨W, hW⟩ := (mem_ker_rhoTwo_iff n).mp hn
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_pow, hW, Matrix.SpecialLinearGroup.coe_one, pow_two,
    one_add_smul_mul_one_add_smul, two_pow_mul_self ha, zero_smul, add_zero, add_assoc,
    ← smul_add, ← two_smul (ZMod (2 ^ (a + 1))) W, smul_smul,
    show (2 : ZMod (2 ^ (a + 1))) ^ a * 2 = 0 by rw [mul_comm]; exact two_mul_two_pow a,
    zero_smul, add_zero]

theorem levelOneTwo_commute_layer {g n : SLT a} (hg : g ∈ levelOneTwo a)
    (hn : n ∈ (rhoTwo a).ker) : Commute g n := by
  obtain ⟨V, hV⟩ := (mem_levelOneTwo_iff g).mp hg
  obtain ⟨W, hW⟩ := (mem_ker_rhoTwo_iff n).mp hn
  apply Subtype.ext
  change (g : Matrix (Fin 2) (Fin 2) (ZMod (2 ^ (a + 1)))) * n = n * g
  rw [hV, hW, one_add_smul_mul_one_add_smul, one_add_smul_mul_one_add_smul,
    two_mul_two_pow, show (2 : ZMod (2 ^ (a + 1))) ^ a * 2 = 0 by
      rw [mul_comm]; exact two_mul_two_pow a, zero_smul, zero_smul]
  abel

/-! ### Membership -/

theorem upperRoot_two_mul_mem (w : ZMod (2 ^ (a + 1))) : upperRoot (2 * w) ∈ levelOneTwo a := by
  rw [mem_levelOneTwo_iff]
  refine ⟨!![0, w; 0, 0], ?_⟩
  ext i j; fin_cases i <;> fin_cases j <;> simp [upperRoot]

theorem lowerRoot_two_mul_mem (w : ZMod (2 ^ (a + 1))) : lowerRoot (2 * w) ∈ levelOneTwo a := by
  rw [mem_levelOneTwo_iff]
  refine ⟨!![0, 0; w, 0], ?_⟩
  ext i j; fin_cases i <;> fin_cases j <;> simp [lowerRoot]

theorem x2_mem : x2 a ∈ levelOneTwo a := by simpa using upperRoot_two_mul_mem (a := a) 1

theorem y2_mem : y2 a ∈ levelOneTwo a := by simpa using lowerRoot_two_mul_mem (a := a) 1

theorem mI2_mem : mI2 a ∈ levelOneTwo a := by
  rw [mem_levelOneTwo_iff]
  refine ⟨!![-1, 0; 0, -1], ?_⟩
  ext i j; fin_cases i <;> fin_cases j <;> simp [torus, negOneU] <;> ring

theorem nE2_mem : nE2 a ∈ (rhoTwo a).ker := by
  rw [mem_ker_rhoTwo_iff]
  refine ⟨!![0, 1; 0, 0], ?_⟩
  ext i j; fin_cases i <;> fin_cases j <;> simp [upperRoot]

theorem nF2_mem : nF2 a ∈ (rhoTwo a).ker := by
  rw [mem_ker_rhoTwo_iff]
  refine ⟨!![0, 0; 1, 0], ?_⟩
  ext i j; fin_cases i <;> fin_cases j <;> simp [lowerRoot]

theorem eps2_coe (ha : 1 ≤ a) : ((eps2 a : SLT a) : Matrix (Fin 2) (Fin 2) (ZMod (2 ^ (a + 1)))) =
    1 + (2 : ZMod (2 ^ (a + 1))) ^ a • (1 : Matrix (Fin 2) (Fin 2) (ZMod (2 ^ (a + 1)))) := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [torus, epsU_inv_val ha, epsU_val ha]

theorem eps2_mem (ha : 1 ≤ a) : eps2 a ∈ (rhoTwo a).ker :=
  (mem_ker_rhoTwo_iff _).mpr ⟨1, eps2_coe ha⟩

theorem eps2_central (ha : 1 ≤ a) (g : SLT a) : Commute (eps2 a) g := by
  apply Subtype.ext
  change ((eps2 a : SLT a) : Matrix (Fin 2) (Fin 2) (ZMod (2 ^ (a + 1)))) * g = g * eps2 a
  rw [eps2_coe ha, add_mul, mul_add, one_mul, mul_one, Matrix.smul_mul, Matrix.mul_smul,
    one_mul, mul_one]

theorem mI2_central (g : SLT a) : Commute (mI2 a) g := by
  have : (mI2 a : SLT a) = -1 := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [torus, negOneU]
  rw [this]
  exact (Commute.one_left g).neg_left

theorem mI2_sq : mI2 a ^ 2 = 1 := by
  rw [torus_pow]
  have : negOneU a ^ 2 = 1 := by simp [negOneU]
  rw [this, torus_one]

/-! ### Generators -/

theorem layerTwo_le_closure (ha : 1 ≤ a) :
    (rhoTwo a).ker ≤ Subgroup.closure {nE2 a, nF2 a, eps2 a} := by
  intro n hn
  set C := Subgroup.closure {nE2 a, nF2 a, eps2 a}
  obtain ⟨W, hW⟩ := (mem_ker_rhoTwo_iff n).mp hn
  set q : ZMod (2 ^ (a + 1)) := 2 ^ a with hqdef
  have hq : q * q = 0 := two_pow_mul_self ha
  have e00 : n 0 0 = 1 + q * W 0 0 := by
    have := congrFun (congrFun hW 0) 0; simpa using this
  have e01 : n 0 1 = q * W 0 1 := by
    have := congrFun (congrFun hW 0) 1; simpa using this
  have e10 : n 1 0 = q * W 1 0 := by
    have := congrFun (congrFun hW 1) 0; simpa using this
  let u0 : (ZMod (2 ^ (a + 1)))ˣ :=
    ⟨1 + q * W 0 0, 1 - q * W 0 0, by linear_combination (-(W 0 0) ^ 2) * hq,
      by linear_combination (-(W 0 0) ^ 2) * hq⟩
  have hu0 : n 0 0 = (u0 : ZMod (2 ^ (a + 1))) := e00
  have hu0inv : ((u0⁻¹ : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1))) = 1 - q * W 0 0 := rfl
  have hnE : nE2 a ∈ C := Subgroup.subset_closure (by simp)
  have hnF : nF2 a ∈ C := Subgroup.subset_closure (by simp)
  have heps : eps2 a ∈ C := Subgroup.subset_closure (by simp)
  rw [gauss_of_unit_top_left n u0 hu0]
  refine C.mul_mem (C.mul_mem ?_ ?_) ?_
  · have : n 1 0 * ((u0⁻¹ : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1))) =
        ((W 1 0).val : ZMod (2 ^ (a + 1))) * q := by
      rw [ZMod.natCast_zmod_val, e10, hu0inv]
      linear_combination (-(W 1 0 * W 0 0)) * hq
    rw [this, ← lowerRoot_pow]
    exact C.pow_mem hnF _
  · have : u0 = epsU a ^ (W 0 0).val := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, epsU_val ha, one_add_pow_of_mul_self_eq_zero _ hq,
        ZMod.natCast_zmod_val]
      change 1 + q * W 0 0 = 1 + W 0 0 * q
      ring
    rw [this, ← torus_pow]
    exact C.pow_mem heps _
  · have : n 0 1 * ((u0⁻¹ : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1))) =
        ((W 0 1).val : ZMod (2 ^ (a + 1))) * q := by
      rw [ZMod.natCast_zmod_val, e01, hu0inv]
      linear_combination (-(W 0 1 * W 0 0)) * hq
    rw [this, ← upperRoot_pow]
    exact C.pow_mem hnE _

theorem neg_one_pow_four (m : ℕ) : ∃ k : ZMod (2 ^ (a + 1)),
    (((negOneU a) ^ m : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1))) =
      1 + 2 * (m : ZMod (2 ^ (a + 1))) + 4 * k := by
  induction m with
  | zero => exact ⟨0, by simp⟩
  | succ m ih =>
    obtain ⟨k, hk⟩ := ih
    refine ⟨-1 - (m : ZMod (2 ^ (a + 1))) - k, ?_⟩
    rw [pow_succ (negOneU a) m, Units.val_mul, hk]
    simp only [negOneU, Units.val_neg, Units.val_one]
    push_cast; ring

theorem levelOneTwo_le_closure (ha : 1 ≤ a) :
    levelOneTwo a ≤ Subgroup.closure {x2 a, y2 a, mI2 a} := by
  intro g hg
  set C := Subgroup.closure {x2 a, y2 a, mI2 a}
  obtain ⟨V, hV⟩ := (mem_levelOneTwo_iff g).mp hg
  have e00 : g 0 0 = 1 + 2 * V 0 0 := by
    have := congrFun (congrFun hV 0) 0; simpa using this
  have e01 : g 0 1 = 2 * V 0 1 := by
    have := congrFun (congrFun hV 0) 1; simpa using this
  have e10 : g 1 0 = 2 * V 1 0 := by
    have := congrFun (congrFun hV 1) 0; simpa using this
  have hnil : IsNilpotent (2 * V 0 0 : ZMod (2 ^ (a + 1))) :=
    ⟨a + 1, by rw [mul_pow, two_pow_succ_eq_zero, zero_mul]⟩
  obtain ⟨u0, hu0'⟩ := hnil.isUnit_one_add
  have hu0 : g 0 0 = (u0 : ZMod (2 ^ (a + 1))) := by rw [hu0', e00]
  have hx : x2 a ∈ C := Subgroup.subset_closure (by simp)
  have hy : y2 a ∈ C := Subgroup.subset_closure (by simp)
  have hm : mI2 a ∈ C := Subgroup.subset_closure (by simp)
  have hup : ∀ w : ZMod (2 ^ (a + 1)), upperRoot (2 * w) ∈ C := by
    intro w
    have : upperRoot (2 * w) = x2 a ^ w.val := by
      rw [upperRoot_pow, ZMod.natCast_zmod_val, mul_comm]
    rw [this]; exact C.pow_mem hx _
  have hlow : ∀ w : ZMod (2 ^ (a + 1)), lowerRoot (2 * w) ∈ C := by
    intro w
    have : lowerRoot (2 * w) = y2 a ^ w.val := by
      rw [lowerRoot_pow, ZMod.natCast_zmod_val, mul_comm]
    rw [this]; exact C.pow_mem hy _
  rw [gauss_of_unit_top_left g u0 hu0]
  refine C.mul_mem (C.mul_mem ?_ ?_) ?_
  · rw [e10, mul_assoc]; exact hlow _
  · set m := (V 0 0).val
    set b : (ZMod (2 ^ (a + 1)))ˣ := u0 * (negOneU a) ^ m with hb
    have hn2 : negOneU a * negOneU a = 1 := by simp [negOneU]
    have hsplit : u0 = (negOneU a) ^ m * b := by
      rw [hb, mul_left_comm, ← mul_pow, hn2, one_pow, mul_one]
    obtain ⟨k, hk⟩ := neg_one_pow_four (a := a) m
    have hbval : (b : ZMod (2 ^ (a + 1))) =
        1 + 2 * (2 * (V 0 0 + k + V 0 0 ^ 2 + 2 * V 0 0 * k)) := by
      rw [hb, Units.val_mul, hk, ← hu0, e00, ZMod.natCast_zmod_val]
      ring
    rw [hsplit, torus_mul, ← torus_pow]
    refine C.mul_mem (C.pow_mem hm _) ?_
    rw [torus_eq_four_roots b 2 _ hbval]
    refine C.mul_mem (C.mul_mem (C.mul_mem ?_ ?_) ?_) ?_
    · simpa using hup 1
    · exact hlow _
    · rw [show -2 * ((b⁻¹ : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1))) =
        2 * (-((b⁻¹ : (ZMod (2 ^ (a + 1)))ˣ) : ZMod (2 ^ (a + 1)))) by ring]
      exact hup _
    · rw [show -(2 * (V 0 0 + k + V 0 0 ^ 2 + 2 * V 0 0 * k)) * (b : ZMod (2 ^ (a + 1))) =
        2 * (-(V 0 0 + k + V 0 0 ^ 2 + 2 * V 0 0 * k) * (b : ZMod (2 ^ (a + 1)))) by ring]
      exact hlow _
  · rw [e01, mul_assoc]; exact hup _

/-! ### Conjugation identities -/

theorem u_conj_nF2 (ha : 1 ≤ a) :
    upperRoot 1 * nF2 a * (upperRoot 1)⁻¹ = (nE2 a)⁻¹ * nF2 a * eps2 a :=
  layer_conj_upper_lower _ (two_pow_mul_self ha) _ (epsU_val ha)

theorem v_conj_nE2 (ha : 1 ≤ a) :
    lowerRoot 1 * nE2 a * (lowerRoot 1)⁻¹ = nE2 a * (nF2 a)⁻¹ * (eps2 a)⁻¹ :=
  layer_conj_lower_upper _ (two_pow_mul_self ha) _ (epsU_val ha)

theorem w_conj_x2 : weyl (1 : (ZMod (2 ^ (a + 1)))ˣ) * x2 a * (weyl 1)⁻¹ = (y2 a)⁻¹ := by
  rw [weyl_upper_conj, ← lowerRoot_neg]; congr 1; simp

theorem w_conj_nF2 : weyl (1 : (ZMod (2 ^ (a + 1)))ˣ) * nF2 a * (weyl 1)⁻¹ = nE2 a := by
  rw [weyl_lower_conj]; congr 1
  have h := two_mul_two_pow a
  simp only [Units.val_one, one_pow, one_mul]
  linear_combination -h

/-! ### The `C₃`-average -/

/-- The elements of order dividing 3 in `SL₂(ℤ/2)`. -/
def c3Finset : Finset (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) :=
  Finset.univ.filter (fun g => g ^ 3 = 1)

theorem c3Finset_card : c3Finset.card = 3 := by decide +kernel

theorem c3Finset_conj (s q : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) (hq : q ∈ c3Finset) :
    s⁻¹ * q * s ∈ c3Finset := by
  simp only [c3Finset, Finset.mem_filter, Finset.mem_univ, true_and] at hq ⊢
  have : s⁻¹ * q * s = MulAut.conj s⁻¹ q := by simp
  rw [this, ← map_pow, hq, map_one]

theorem c3_average_aux : ∀ W : Matrix (Fin 2) (Fin 2) (ZMod 2), W.trace = 0 →
    (∑ q ∈ c3Finset, (q : Matrix (Fin 2) (Fin 2) (ZMod 2)) * W *
      ((q⁻¹ : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) : Matrix (Fin 2) (Fin 2) (ZMod 2))) = 0 ∨
    (∑ q ∈ c3Finset, (q : Matrix (Fin 2) (Fin 2) (ZMod 2)) * W *
      ((q⁻¹ : Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) : Matrix (Fin 2) (Fin 2) (ZMod 2))) = 1 := by
  decide +kernel

end TwoElements

end VOA.Huang.DLNSchur
