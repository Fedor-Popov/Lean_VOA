import VOA.Huang.HKLRationalOrdinary
import VOA.Classification.COne.ABDWeakAdmissibleComplete
import VOA.Huang.LogRemovalAdmissible

/-!
# HKL rationality, part 3: admissible `W`-modules are generated by ordinary ones

* `exists_eigenvector_of_ne_bot` — over a `C₂`-cofinite VOA, every nonzero weak submodule contains
  an `L₀`-eigenvector (`weakL0LocallyFinite`);
* `eigenSum_eq_top` — for strongly rational `V`, **`L₀` is semisimple on every weak
  `V`-module** (`eigenSum = ⊤`): the eigen-submodule has a complement (ABD Prop 5.7 +
  rationality), which contains no eigenvector, hence is zero;
* `admissible_weakCompletelyReducible_of_ordinary` — for a `C₂`-cofinite `W` whose weak
  modules are `L₀`-semisimple, if every ordinary `W`-module is completely reducible then so is
  every weak `W`-module: the cyclic submodule of an `L₀`-eigenvector is ordinary
  (`eigen_cyclic_isOrdinary`) and these span.

No `sorry`, no new axioms.
-/

set_option linter.style.longLine false
set_option linter.unusedSectionVars false
set_option maxSynthPendingDepth 3

noncomputable section

namespace VOA.Huang.HKLRational

open CategoryTheory Module
open VOA VOA.Classification.COne VOA.Classification.COne.ABDWeakAdmissible
  VOA.Huang.LogRemovalAdmissible

universe u

variable {𝒲 : Type u} [AddCommGroup 𝒲] [Module ℂ 𝒲] {W : VertexOperatorAlgebra 𝒲}
  {M : Type u} [AddCommGroup M] [Module ℂ M]

/-- Over a `C₂`-cofinite VOA, a nonzero weak submodule contains an `L₀`-eigenvector. -/
theorem exists_eigenvector_of_ne_bot (hC2 : C2Cofinite W) (A : WeakModule W M)
    (Q : WeakModule.Submodule' A) (hQ : Q.carrier ≠ ⊥) :
    ∃ v ∈ Q.carrier, v ≠ 0 ∧ ∃ α : ℂ, L0 A v = α • v := by
  obtain ⟨x, hxQ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQ
  obtain ⟨S, hSfin, hxS, hSL⟩ := weakL0LocallyFinite hC2 A x
  let S' := S ⊓ Q.carrier
  have hS'L : ∀ y ∈ S', L0 A y ∈ S' := fun y hy =>
    ⟨hSL y hy.1, Q.act_mem W.conformalVector 1 hy.2⟩
  haveI : FiniteDimensional ℂ S' := Submodule.finiteDimensional_inf_left S Q.carrier
  haveI : Nontrivial S' := ⟨⟨⟨x, hxS, hxQ⟩, 0, fun h => hx0 (congrArg Subtype.val h)⟩⟩
  let T : Module.End ℂ S' := (L0 A).restrict hS'L
  obtain ⟨α, hα⟩ := Module.End.exists_eigenvalue T
  obtain ⟨v, hv⟩ := hα.exists_hasEigenvector
  refine ⟨v, (v.2 : (v : M) ∈ S').2, fun h => hv.2 (Subtype.ext h), α, ?_⟩
  have := congrArg Subtype.val hv.apply_eq_smul
  simpa [T] using this

/-- **`L₀` is semisimple on every weak module of a strongly rational VOA.** -/
theorem eigenSum_eq_top {𝒱 : Type u} [AddCommGroup 𝒱] [Module ℂ 𝒱]
    {V : VertexOperatorAlgebra 𝒱} (hV : StronglyRational V) (B : WeakModule V M) :
    eigenSum B = ⊤ := by
  obtain ⟨NA, hNA⟩ := abdWeakIsAdmissible hV.c2Cofinite B
  have hcr : ∀ P : WeakModule.Submodule' NA.toWeakModule,
      ∃ Q : WeakModule.Submodule' NA.toWeakModule, IsCompl P.carrier Q.carrier := hV.rational NA
  rw [hNA] at hcr
  obtain ⟨Q, hQ⟩ := hcr (eigenSubmodule B)
  by_cases hQb : Q.carrier = ⊥
  · rw [hQb] at hQ
    have h := hQ.sup_eq_top
    rwa [sup_bot_eq] at h
  · exfalso
    obtain ⟨v, hvQ, hv0, α, hα⟩ := exists_eigenvector_of_ne_bot hV.c2Cofinite B Q hQb
    have hvE : v ∈ eigenSum B := eigenspace_le_eigenSum B α (Module.End.mem_eigenspace_iff.mpr hα)
    have : v ∈ (eigenSubmodule B).carrier ⊓ Q.carrier := ⟨hvE, hvQ⟩
    rw [hQ.inf_eq_bot, Submodule.mem_bot] at this
    exact hv0 this

/-- **From ordinary to weak complete reducibility**: over a `C₂`-cofinite VOA, a weak module
on which `L₀` is semisimple is completely reducible as soon as every ordinary module is. -/
theorem weakCompletelyReducible_of_ordinary (hC2 : C2Cofinite W) (A : WeakModule W M)
    (hE : eigenSum A = ⊤)
    (hord : ∀ (M' : Type u) [AddCommGroup M'] [Module ℂ M'] (O : OrdVModule W M'),
      WeakCompletelyReducible O.toWeakModule) :
    WeakCompletelyReducible A := by
  let ι := {p : M × ℂ // L0 A p.1 = p.2 • p.1}
  have key : ∀ i : ι, ∃ O : OrdVModule W (ofR A (PlusRational.cyclic A i.1.1)).carrier,
      O.toWeakModule = WeakModule.submodule A (ofR A (PlusRational.cyclic A i.1.1)) := by
    intro i
    let P := ofR A (PlusRational.cyclic A i.1.1)
    let B := WeakModule.submodule A P
    let z : P.carrier := ⟨i.1.1, Submodule.mem_span_singleton_self i.1.1⟩
    have hz : L0 B z = i.1.2 • z := by
      apply Subtype.ext
      rw [Submodule.coe_smul]
      exact (WeakModule.submoduleYM_mode_coe A P W.conformalVector 1 z).trans i.2
    obtain ⟨O, hO, -, -⟩ := eigen_cyclic_isOrdinary hC2 B z i.1.2 hz
      (cyclic_restriction_eq_top A i.1.1)
    exact ⟨O, hO⟩
  choose O hO using key
  have hφ : ∀ i : ι, IsModeHom A (O i).toWeakModule
      (ofR A (PlusRational.cyclic A i.1.1)).carrier.subtype := by
    intro i a k y
    change ((mode ((O i).toWeakModule.YM a) k y : _) : M) = _
    rw [hO i]
    exact WeakModule.submoduleYM_mode_coe A _ a k y
  have hsup : ⨆ i : ι, LinearMap.range (ofR A (PlusRational.cyclic A i.1.1)).carrier.subtype
      = ⊤ := by
    rw [eq_top_iff, ← hE]
    refine iSup_le fun α x hx => ?_
    have hx' : L0 A x = α • x := Module.End.mem_eigenspace_iff.mp hx
    refine Submodule.mem_iSup_of_mem (⟨(x, α), hx'⟩ : ι) ?_
    exact ⟨⟨x, Submodule.mem_span_singleton_self x⟩, rfl⟩
  exact completelyReducible_of_iSup A _ (fun i => (O i).toWeakModule) _ hφ
    (fun i => hord _ (O i)) hsup

end VOA.Huang.HKLRational
